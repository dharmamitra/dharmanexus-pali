[
{"segs": ["PA_tha-ap_327:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:0.2"], "en": "Umāpupphiyavagga 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:0.3"], "en": "The Apadāna of the Elder Nimittasaññaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:1.1"], "en": "“On the bank of the Candabhāgā River,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:1.2"], "en": "I dwell in a hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:1.3"], "en": "there I saw a golden deer.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:1.4"], "en": "As I was wandering in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:2.1"], "en": "having inspired confidence in my heart toward the deer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:2.2"], "en": "I recollected the Eldest One in the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:2.3"], "en": "With that serene confidence in my heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:2.4"], "en": "I recollected other Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:3.1"], "en": "both those who have passed away and those yet to come.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:3.2"], "en": "The present and the future—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:3.3", "PA_tha-ap_327:3.4"], "en": "just so do these three shine forth, like the king of beasts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:4.1"], "en": "In the ninety-fourth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:4.2"], "en": "when I attained that perception,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:4.3"], "en": "I do not recall ever being born in an unhappy state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:4.4"], "en": "This is the fruit of the perception of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:5.1"], "en": "Twenty-seven eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:5.2"], "en": "I was once a lord of the earth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:5.3"], "en": "By name Araññasatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:5.4"], "en": "he was a wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:6.1"], "en": "He possessed the four analytical knowledges (paṭisambhidā).", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:7.1"], "en": "Thus indeed did the Venerable Elder Nimittasaññaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_327:8.1"], "en": "The legend of the Elder Nimittasaññaka is the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
