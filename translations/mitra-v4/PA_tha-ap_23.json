[
{"segs": ["PA_tha-ap_23:0.1", "PA_tha-ap_23:0.2"], "en": "The Therāpadāna, Subhūti Chapter: 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:0.3"], "en": "The Apadāna of the Elder Subhūti", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:1.1", "PA_tha-ap_23:1.2"], "en": "\"Not far from the Himavat stands a mountain named Nisabha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:1.3"], "en": "there my well-constructed hermitage is located.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:1.4"], "en": "The leaf-hut was well-constructed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:2.1", "PA_tha-ap_23:2.2"], "en": "There was a matted-hair ascetic named Kosiya, who practiced rigorous austerities.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:2.3"], "en": "Then, alone and without a companion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:2.4"], "en": "I dwelt as a bull-leader;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:3.1"], "en": "[I lived on] fruit, roots, and leaves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:3.2"], "en": "I did not eat at that time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:3.3", "PA_tha-ap_23:3.4"], "en": "I lived for as long as I subsisted on what was already available.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:4.1"], "en": "I do not harm my livelihood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:4.2"], "en": "even while giving up my life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:4.3"], "en": "I satisfy my own mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:4.4"], "en": "I avoid wrong means of livelihood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:5.1", "PA_tha-ap_23:5.2"], "en": "Whenever a mind associated with lust arises in me, I turn away from it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:5.3"], "en": "I myself shall reflect upon this;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:5.4"], "en": "with one-pointed mind, I shall tame it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:6.1"], "en": "\"If you are impassioned by things that provoke passion...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:6.2"], "en": "You feel aversion toward what is loathsome,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:6.3"], "en": "yet you are deluded by what causes delusion; therefore,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:6.4"], "en": "you must depart from this forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:7.1"], "en": "This is the dwelling place for those who are purified,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:7.2"], "en": "stainless, and ascetic;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:7.3"], "en": "do not defile that which is pure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:7.4"], "en": "Depart from the forest, my son;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:8.1"], "en": "having become a householder,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:8.2"], "en": "when you have obtained a son, [then return].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:8.3"], "en": "Do not offend either of us;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:8.4"], "en": "depart from this forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:9.1"], "en": "Like a piece of wood from a funeral pyre, [you are no longer fit to remain].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:9.2"], "en": "It performs no action anywhere;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:9.3"], "en": "neither in the village nor in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:9.4"], "en": "for it is not considered to be wood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:10.1"], "en": "You are like a chaff-fire,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:10.2"], "en": "neither a householder nor one who is restrained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:10.3"], "en": "today you are liberated from both.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:10.4"], "en": "Depart from the forest!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:11.1"], "en": "This might indeed be yours;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:11.2"], "en": "who knows this for you?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:11.3"], "en": "\"You carry the burden of faith for me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:11.4"], "en": "even though you are full of indolence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:12.1"], "en": "wise people will look upon you with contempt.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:12.2"], "en": "Just as a city dweller [handles] filth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:12.3"], "en": "so will the seers, having dragged you out,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:12.4"], "en": "constantly reproach you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:13.1", "PA_tha-ap_23:13.2"], "en": "The wise will censure him for having transgressed the teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:13.3"], "en": "for he will find no companionship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:13.4"], "en": "\"How will you live?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:14.1", "PA_tha-ap_23:14.2"], "en": "[There is] the elephant, a sixty-year-old Mātaṅga, split open in three places.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:14.3"], "en": "The powerful elephant, having approached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:14.4"], "en": "draws the tusker out from the herd;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:15.1"], "en": "once he has emerged from the herd, [he stands firm].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:15.2"], "en": "He finds neither ease nor pleasure;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:15.3"], "en": "afflicted and dejected,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:15.4"], "en": "he broods and trembles.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:16.1", "PA_tha-ap_23:16.2"], "en": "In the same way, those matted-hair ascetics will drive that fool out as well;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:16.3"], "en": "once you have escaped from them, being free, [you shall dwell at ease].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:16.4", "PA_tha-ap_23:17.1", "PA_tha-ap_23:17.2"], "en": "Whether by day or by night, pierced by the arrow of sorrow, you shall find neither ease nor comfort.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:17.3"], "en": "You burn with feverish passion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:17.4"], "en": "like an elephant strayed from its herd;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:18.1"], "en": "you are like a counterfeit piece of gold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:18.2"], "en": "He does not meditate anywhere;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:18.3", "PA_tha-ap_23:18.4"], "en": "likewise, you who are devoid of virtue will not meditate anywhere.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:19.1"], "en": "Even while living in a house,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:19.2"], "en": "how will you sustain yourself—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:19.3"], "en": "neither from your father’s wealth nor from your mother’s?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:19.4"], "en": "You have no wealth stored away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:20.1"], "en": "Having performed the work yourself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:20.2"], "en": "you shed sweat from your limbs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:20.3"], "en": "\"In this way you shall live at home;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:20.4"], "en": "it would be well for you if that did not displease you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:21.1"], "en": "Thus do I dissuade you from that.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:21.2"], "en": "When my mind had fallen into defilement,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:21.3", "PA_tha-ap_23:21.4"], "en": "I spoke on various teachings and restrained that evil thought.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:22.1"], "en": "As I dwelt thus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:22.2"], "en": "abiding in heedfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:22.3"], "en": "thirty thousand years passed by.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:22.4"], "en": "They passed through my forest grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:23.1", "PA_tha-ap_23:23.2"], "en": "seeing one who delights in heedfulness and seeks the supreme goal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:23.3", "PA_tha-ap_23:23.4"], "en": "The Perfectly Enlightened One Padumuttara came into my presence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:24.1"], "en": "radiant with the hue of a timbaru fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:24.2"], "en": "Immeasurable and incomparable,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:24.3"], "en": "the Buddha, peerless in form,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:24.4"], "en": "was then walking in the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:25.1"], "en": "Like a blossoming king of sāl trees,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:25.2"], "en": "like lightning amidst thick clouds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:25.3"], "en": "the Buddha is peerless in his wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:25.4"], "en": "Then he walked back and forth in the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:26.1", "PA_tha-ap_23:26.2"], "en": "as fearless as a lion king and as proud as a lordly elephant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:26.3"], "en": "Then, like a lion king who has been lured out,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:26.4"], "en": "he walked back and forth in the air,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:27.1"], "en": "radiant with the hue of molten gold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:27.2"], "en": "Resembling glowing embers of acacia wood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:27.3"], "en": "like a wish-fulfilling jewel,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:27.4"], "en": "he then walked through the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:28.1"], "en": "Resembling a pure white lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:28.2"], "en": "like the moon on a full-moon night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:28.3"], "en": "and like the sun at midday;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:28.4"], "en": "At that time, he was walking back and forth in the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:29.1"], "en": "Seeing him walking in the heavens,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:29.2"], "en": "I then thought thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:29.3", "PA_tha-ap_23:29.4"], "en": "\"Is this now a being, or is this a human?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:30.1"], "en": "I have neither heard of nor seen such a one.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:30.2"], "en": "“On this earth there is such a man;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:30.3"], "en": "even a verse of a mantra exists—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:30.4"], "en": "this one shall be the Teacher.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:31.1"], "en": "Having reflected thus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:31.2"], "en": "I gladdened my own mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:31.3"], "en": "with various flowers and perfumes, I offered them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:31.4"], "en": "Then, at that assembly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:32.1", "PA_tha-ap_23:32.2"], "en": "having prepared a beautiful and delightful flower-seat for one of virtuous mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:32.3"], "en": "To Narasārathin, the foremost,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:32.4"], "en": "I spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:33.1"], "en": "“O Hero, here is my seat.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:33.2", "PA_tha-ap_23:33.3", "PA_tha-ap_23:33.4"], "en": "\"Sit upon this seat of flowers, which is prepared as befits you, bringing joy to my heart.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:34.1"], "en": "There the Blessed One sat down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:34.2"], "en": "like an unafraid lion;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:34.3"], "en": "for seven days and nights, the Buddha remained there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:34.4"], "en": "On an excellent seat of flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:35.1", "PA_tha-ap_23:35.2"], "en": "I stood paying homage for seven days and nights.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:35.3"], "en": "Having emerged from concentration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:35.4"], "en": "the Teacher, unsurpassed in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:35.5"], "en": "proclaimed my deed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:35.6"], "en": "He spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:36.1"], "en": "“Cultivate the recollection of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:36.2"], "en": "the unsurpassed among all meditations.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:36.3"], "en": "Having cultivated this mindfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:36.4", "PA_tha-ap_23:37.1"], "en": "you will fulfill your heart's desire for thirty thousand eons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:37.2"], "en": "You will delight in the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:37.3", "PA_tha-ap_23:37.4"], "en": "eighty times you will exercise divine sovereignty as a lord of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:37.5", "PA_tha-ap_23:37.6"], "en": "A thousand times you will be a wheel-turning monarch over the realm;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:38.1"], "en": "you will possess extensive sovereignty over various districts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:38.2"], "en": "It is beyond counting;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:38.3"], "en": "you shall experience all of that,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:38.4"], "en": "the fruit of the recollection of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:39.1"], "en": "As you wander through various states of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:39.2"], "en": "you will obtain great wealth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:39.3"], "en": "there shall be no deficiency in your riches.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:39.4"], "en": "The fruit of the recollection of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:40.1", "PA_tha-ap_23:40.2"], "en": "In a hundred thousand eons, one will be born into the family of the Okkākas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:40.3", "PA_tha-ap_23:40.4"], "en": "One named Gotama by clan will become a teacher in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:41.1"], "en": "having renounced eighty koṭis, he will go forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:41.2"], "en": "Having many servants and laborers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:41.3", "PA_tha-ap_23:41.4"], "en": "you shall go forth in the teaching of the Blessed One Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:42.1"], "en": "Having propitiated the Fully Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:42.2"], "en": "Gotama, the bull of the Sakyas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:42.3"], "en": "he who was known by the name Subhūti—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:42.4"], "en": "He will become a disciple of the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:43.1"], "en": "Seated within the community of monks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:43.2"], "en": "he will [be established] in the quality of being worthy of offerings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:43.3"], "en": "\"And likewise in the forest-dwelling,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:43.4"], "en": "he will place [me] at the two foremost positions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:44.1"], "en": "Having said this, the Sambuddha—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:44.2", "PA_tha-ap_23:44.3", "PA_tha-ap_23:44.4"], "en": "The hero named Jalajuttama rose up into the sky like a king of swans in the air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:45.1"], "en": "Instructed by the Lord of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:45.2"], "en": "having paid homage to the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:45.3"], "en": "I always cultivate [this] with joy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:45.4"], "en": "The supreme recollection of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:46.1", "PA_tha-ap_23:46.2"], "en": "By that well-performed deed and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:46.3"], "en": "Having cast off my human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:46.4"], "en": "I went to the Tāvatiṃsa heaven;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:47.1"], "en": "eighty times I was the lord of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:47.2"], "en": "I exercised the sovereignty of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:47.3", "PA_tha-ap_23:47.4"], "en": "and a thousand times I was a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:48.1"], "en": "I enjoy a vast regional sovereignty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:48.2"], "en": "beyond counting and immeasurable,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:48.3"], "en": "together with excellent prosperity.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:48.4"], "en": "The fruit of the recollection of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:49.1"], "en": "wandering through various states of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:49.2"], "en": "I obtained great wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:49.3"], "en": "There is no deficiency in my enjoyments;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:49.4"], "en": "this is the fruit of recollecting the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:50.1"], "en": "One hundred thousand aeons ago—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:50.2"], "en": "Whatever deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:50.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:50.4"], "en": "this is the fruit of recollecting the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:51.1"], "en": "The four analytical knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:51.2"], "en": "these eight liberations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:51.3"], "en": "and the six direct knowledges have been realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:51.4"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:52.1"], "en": "In this way, it is said, the venerable elder Subhūti spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_23:53.1"], "en": "This is the first legend of the elder Subhūti.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
