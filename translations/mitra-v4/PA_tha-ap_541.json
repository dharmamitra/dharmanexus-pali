[
{"segs": ["PA_tha-ap_541:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:0.2"], "en": "Kaccāyanavagga 9.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:0.3"], "en": "The Apadāna of the Elder Rādha", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:1.2"], "en": "the Sage who knows all the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:1.3"], "en": "[appeared] one hundred thousand aeons hence.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:1.4"], "en": "In that eon, the Visionary One appeared.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:2.1"], "en": "He was the advisor, the instructor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:2.2"], "en": "and the deliverer of all living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:2.3"], "en": "The Buddha, skilled in teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:2.4"], "en": "has delivered many people;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:3.1"], "en": "he is compassionate and merciful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:3.2"], "en": "Seeking the welfare of all living beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:3.3", "PA_tha-ap_541:3.4"], "en": "he established all the ascetics who arrived there in the five precepts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:4.1", "PA_tha-ap_541:4.2"], "en": "Thus it was free from confusion and empty of non-Buddhist sectarians,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:4.3"], "en": "yet variegated with Arahants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:4.4", "PA_tha-ap_541:5.1", "PA_tha-ap_541:5.2"], "en": "By those who have attained mastery and reached the state of the \"Tādi,\" that Great Sage has arisen, possessing eighty-four thousand qualities of the Jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:5.3"], "en": "Resembling a priceless golden ornament,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:5.4"], "en": "endowed with the thirty-two excellent marks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:6.1"], "en": "for one hundred thousand years—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:6.2", "PA_tha-ap_541:6.3"], "en": "As long as his life remained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:6.4"], "en": "for that long he stayed and delivered many people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:7.1"], "en": "At that time, in Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:7.2"], "en": "I was a brahmin who had mastered the mantras;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:7.3"], "en": "having approached that best of men, I said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:7.4", "PA_tha-ap_541:8.1"], "en": "I heard the teaching of the Dhamma from the Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:8.2"], "en": "who is skilled and confident amidst the assemblies.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:8.3"], "en": "The eloquent monk,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:8.4"], "en": "the leader foremost among those so ranked—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:9.1"], "en": "having performed service for him at that time, I...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:9.2"], "en": "To the Leader of the World together with his Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:9.3", "PA_tha-ap_541:9.4"], "en": "I bowed my head at his feet and aspired for that state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:10.1"], "en": "Then the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:10.2"], "en": "whose radiance was like refined gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:10.3"], "en": "spoke to me with a voice that was deeply pleasing:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:10.4"], "en": "By those who have removed the stains of defilement:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:11.1"], "en": "“May you be happy and long-lived;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:11.2"], "en": "may your aspiration be fulfilled.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:11.3", "PA_tha-ap_541:11.4"], "en": "A service of exceeding vastness has been performed by you for me and the Saṅgha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:12.1"], "en": "in a hundred thousand aeons [it will bear fruit].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:12.2"], "en": "Born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:12.3", "PA_tha-ap_541:12.4"], "en": "he will be a teacher in the world known by the family name Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:13.1"], "en": "His heir in the Dhammas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:13.2"], "en": "his own legitimate son, fashioned by the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:13.3"], "en": "was named Rādha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:13.4"], "en": "He will become a disciple of the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:14.1"], "en": "Delighted by those qualities of cause,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:14.2"], "en": "the Son of the Sakyas, that bull among men, [will acknowledge him].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:14.3", "PA_tha-ap_541:14.4"], "en": "“The Leader will proclaim the foremost among those worthy of eloquence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:15.1"], "en": "Having heard this, he became joyful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:15.2"], "en": "For as long as life lasted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:15.3"], "en": "I then served the Jina with a mind of loving-kindness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:15.4"], "en": "mindful, wise, and concentrated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:16.1"], "en": "By that well-performed kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:16.2"], "en": "and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:16.3"], "en": "having abandoned this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:16.4"], "en": "I went to the realm of the Thirty-three;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:17.1", "PA_tha-ap_541:17.2"], "en": "three hundred times I exercised sovereignty over the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:17.3", "PA_tha-ap_541:17.4"], "en": "Sixty-five times I was a wheel-turning monarch,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:18.1"], "en": "and I held extensive sovereignty over various regions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:18.2"], "en": "Incalculable by calculation;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:18.3", "PA_tha-ap_541:18.4"], "en": "I was happy in every respect through the power of that kamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:19.1"], "en": "When his final existence had arrived,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:19.2"], "en": "in the supreme city of Giribbaja,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:19.3"], "en": "he was born into a poor brahmin family.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:19.4"], "en": "With a broken cover and seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:20.1", "PA_tha-ap_541:20.2"], "en": "I gave a ladleful of alms-food to Sāriputta, the Tādi.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:20.3"], "en": "When I was old and aged,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:20.4"], "en": "I went to that monastery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:21.1"], "en": "yet no one allowed me to go forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:21.2"], "en": "My strength was worn out and feeble;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:21.3"], "en": "because of that, my body was haggard and discolored,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:21.4"], "en": "and I was filled with grief at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:22.1", "PA_tha-ap_541:22.2"], "en": "Having seen me, the Great Sage, the One of Great Compassion, said to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:22.3"], "en": "\"For what purpose are you afflicted by grief for your son?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:22.4"], "en": "\"Tell me of the pain born of your heart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:23.1", "PA_tha-ap_541:23.2"], "en": "\"O Hero, I do not obtain the going-forth in your well-proclaimed teaching.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:23.3"], "en": "“I am distressed by that grief;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:23.4"], "en": "be my refuge, O Leader!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:24.1"], "en": "Then, having gathered the monks together, [he said:]", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:24.2"], "en": "The Supreme Sage asked:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:24.3", "PA_tha-ap_541:24.4"], "en": "\"Let those who remember his past duties speak.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:25.1"], "en": "Then Sāriputta said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:25.2"], "en": "“I remember his deed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:25.3"], "en": "he had alms-food served with a ladle.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:25.4"], "en": "\"As I wander for alms, [I think]:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:26.1", "PA_tha-ap_541:26.2"], "en": "'Excellent, excellent! You are grateful, Sāriputta.'\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:26.3"], "en": "“Ordain this aged brahmin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:26.4"], "en": "he shall become one of noble birth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:27.1"], "en": "Thereupon, I received the going-forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:27.2"], "en": "Through the formal act of ordination,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:27.3"], "en": "in no long time at all,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:27.4"], "en": "I attained the destruction of the taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:28.1", "PA_tha-ap_541:28.2"], "en": "Since I listen joyfully and attentively to the words of the Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:28.3"], "en": "I am the foremost among those who possess ready eloquence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:28.4"], "en": "Then the Victor established me [in the fruit].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:29.1"], "en": "My defilements have been incinerated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:29.2"], "en": "…pe…", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:29.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:30.1", "PA_tha-ap_541:30.2"], "en": "Welcome indeed has come to me... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:30.3"], "en": "The Buddha’s teaching has been proclaimed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:31.1", "PA_tha-ap_541:31.2"], "en": "the four analytical knowledges, and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:31.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:32.1"], "en": "Thus indeed did the venerable elder Rādha speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_541:33.1"], "en": "The legend of the elder Rādha is the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
