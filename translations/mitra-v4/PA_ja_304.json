[
{"segs": ["PA_ja_304:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:0.2", "PA_ja_304:0.3"], "en": "Catukkanipāta, Kāliṅgavagga (The Chapter on Kāliṅga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:0.4"], "en": "4. The Daddara Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:1.1", "PA_ja_304:1.2"], "en": "“O Daddara, these harsh words spoken by people in the human world distress me.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:1.3"], "en": "“Eating frogs and dwelling by the water’s edge,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:1.4"], "en": "they hiss at me like venomous snakes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:2.1"], "en": "“Exiled from my own kingdom,” he said.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:2.2"], "en": "Having gone to another country,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:2.3", "PA_ja_304:2.4"], "en": "one should build a large granary in order to store up the harsh words [received].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:3.1", "PA_ja_304:3.2"], "en": "Where people do not know a person by birth or by training,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:3.3"], "en": "there one should not take pride.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:3.4"], "en": "Toward people who are not one's own kin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:4.1"], "en": "even when living in a foreign land,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:4.2"], "en": "one should behave as if toward a blazing fire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:4.3", "PA_ja_304:4.4"], "en": "\"A wise person should forgive even a servant who has been rebuked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_304:5.1"], "en": "The Fourth Jātaka, the Daddara Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
