[
{"segs": ["PA_tha-ap_20:0.1"], "en": "The *Therāpadāna*:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:0.2"], "en": "The Chapter on the Lion Throne (Sīhāsaniya-vagga) 8.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:0.3"], "en": "The *Apadāna* of the Elder Raṭṭhapāla", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:1.1"], "en": "“To the Blessed One Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:1.2"], "en": "the World’s Elder, the Neutral One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:1.3"], "en": "a noble elephant was given by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:1.4"], "en": "With tusks like ivory, possessing broad thighs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:2.1"], "en": "adorned with a white parasol, equipped with a howdah,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:2.2"], "en": "and accompanied by a hand-groom;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:2.3"], "en": "Having had all of that appraised,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:2.4"], "en": "I caused a monastic park to be built;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:3.1"], "en": "[it cost] fifty-four thousand [pieces of gold].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:3.2"], "en": "I had a palace built;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:3.3"], "en": "having performed a great flood of giving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:3.4"], "en": "I dedicated it to the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:4.1", "PA_tha-ap_20:4.2"], "en": "The Great Hero, the Self-Existent One, the Supreme Person, expressed his appreciation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:4.3"], "en": "making all people rejoice.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:4.4"], "en": "He taught the deathless state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:5.1", "PA_tha-ap_20:5.2"], "en": "The Buddha named Jalajuttara gave me this explanation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:5.3"], "en": "Sitting amidst the community of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:5.4"], "en": "he spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:6.1"], "en": "“Fifty-four thousand [years]...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:6.2"], "en": "This person had palaces built;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:6.3"], "en": "I shall describe the result—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:6.4"], "en": "listen to me as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:7.1", "PA_tha-ap_20:7.2"], "en": "There will be eighteen thousand gabled houses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:7.3"], "en": "produced in the highest heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:7.4"], "en": "And they shall be made entirely of gold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:8.1", "PA_tha-ap_20:8.2"], "en": "Fifty times the Lord of Devas will exercise sovereignty over the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:8.3", "PA_tha-ap_20:8.4"], "en": "And fifty-eight times he will become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:9.1"], "en": "Within a hundred thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:9.2"], "en": "Born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:9.3", "PA_tha-ap_20:9.4"], "en": "he will be a teacher in the world known by the family name Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:10.1"], "en": "Having passed away from the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:10.2"], "en": "impelled by the root of his wholesome merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:10.3"], "en": "he was reborn into a wealthy family of great possessions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:10.4"], "en": "He will be reborn at that very time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:11.1"], "en": "Later, having gone forth into homelessness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:11.2"], "en": "urged on by the root of his wholesome merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:11.3"], "en": "By the name Raṭṭhapāla,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:11.4"], "en": "he will become a disciple of the Teacher;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:12.1"], "en": "he will be one whose self is intent upon striving.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:12.2"], "en": "Peaceful and free from acquisitions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:12.3"], "en": "having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:12.4"], "en": "he will attain Nibbāna, being without taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:13.1"], "en": "Having risen and gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:13.2"], "en": "having abandoned the abundance of wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:13.3"], "en": "one regards wealth as a globule of spittle.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:13.4"], "en": "In me there is no passion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:14.1"], "en": "My energy is the yoke-bearer that carries the burden,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:14.2"], "en": "bringing about the security from bondage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:14.3", "PA_tha-ap_20:14.4"], "en": "I bear my final body in the teaching of the Perfectly Enlightened One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:15.1"], "en": "the four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:15.2", "PA_tha-ap_20:15.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:15.4"], "en": "the Buddha’s teaching has been fulfilled.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:16.1"], "en": "Thus indeed the venerable elder Raṭṭhapāla spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_20:17.1"], "en": "This is the eighth legend of the elder Raṭṭhapāla.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
