[
{"segs": ["PA_tha-ap_481:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:0.2"], "en": "Naḷamāli-vagga, 9.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:0.3"], "en": "The Apadāna of the Elder Pānadhidāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:1.1"], "en": "“The Blessed One Anomadassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:1.2"], "en": "the eldest in the world, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:1.3"], "en": "having emerged from his midday rest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:1.4"], "en": "The Visionary first mounted [the chariot];", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:2.1"], "en": "taking up his well-crafted sandals,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:2.2"], "en": "he set out upon the journey.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:2.3"], "en": "There I saw the Perfectly Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:2.4"], "en": "walking on foot, beautiful to behold;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:3.1"], "en": "having gladdened my own heart, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:3.2", "PA_tha-ap_481:3.3"], "en": "Having taken off my sandals and placed them at his feet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:3.4"], "en": "I spoke these words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:4.1"], "en": "“Ascend, O Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:4.2"], "en": "Lord of Sugatas, Guide!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:4.3"], "en": "From this I shall obtain the fruit.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:4.4", "PA_tha-ap_481:5.1"], "en": "“May my purpose be fulfilled! Thus spoke the Blessed One Anomadassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:5.2"], "en": "the Eldest in the World, the Bull among Men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:5.3"], "en": "Having stepped upon his sandal,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:5.4"], "en": "he spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:6.1"], "en": "“He who gave me this sandal— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:6.2"], "en": "With confident and sincere hands,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:6.3"], "en": "I shall praise him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:6.4"], "en": "listen as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:7.1"], "en": "Having understood the Buddha’s speech,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:7.2", "PA_tha-ap_481:7.3"], "en": "all the devas assembled; with uplifted hearts and joyful minds, they gathered together.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:7.4"], "en": "With palms joined in reverence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:8.1"], "en": "she who was born of the Vedas said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:8.2"], "en": "\"By giving him water, he will become happy.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:8.3", "PA_tha-ap_481:8.4"], "en": "And fifty-five times he will exercise sovereignty over the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:9.1"], "en": "and a thousand times he will be a king.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:9.2"], "en": "He will become a wheel-turning monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:9.3", "PA_tha-ap_481:9.4"], "en": "his regional sovereignty will be vast and beyond counting.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:10.1"], "en": "In an immeasurable eon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:10.2"], "en": "one born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:10.3"], "en": "known by the family name Gotama, will appear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:10.4"], "en": "The Teacher shall appear in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:11.1"], "en": "His heir in the Dhammas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:11.2"], "en": "his own legitimate son, fashioned from the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:11.3"], "en": "Having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:11.4"], "en": "one will attain Nibbāna, free from taints—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:12.1"], "en": "whether in the world of the gods or among humans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:12.2"], "en": "One who possesses merit will be reborn;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:12.3", "PA_tha-ap_481:12.4"], "en": "he shall obtain a vehicle resembling the Devayāna.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:13.1"], "en": "Palaces, palanquins, and chariots,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:13.2"], "en": "elephants fully adorned,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:13.3"], "en": "and chariots yoked with noble steeds—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:13.4"], "en": "They were always manifest to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:14.1"], "en": "Even when going forth from the home,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:14.2"], "en": "I departed by means of a chariot.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:14.3", "PA_tha-ap_481:14.4"], "en": "While my hair was being cut off, I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:15.1"], "en": "It is a gain for me; it is well-acquired by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:15.2", "PA_tha-ap_481:15.3"], "en": "Having well-applied my trade and given away a single sandal,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:15.4"], "en": "I have attained the immovable state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:16.1"], "en": "In an immeasurable eon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:16.2"], "en": "because I gave a drink of water,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:16.3"], "en": "I do not know any state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:16.4"], "en": "This is the fruit of my drinking water:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:17.1", "PA_tha-ap_481:17.2"], "en": "the defilements have been incinerated by me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:17.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:18.1", "PA_tha-ap_481:18.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:18.3"], "en": "This is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:19.1", "PA_tha-ap_481:19.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:19.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:20.1"], "en": "It was in this way that the venerable elder Pānadhidāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_481:21.1"], "en": "This is the ninth legend of the elder Pānadhidāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
