[
{"segs": ["PA_thig_13.5:0.1", "PA_thig_13.5:0.2"], "en": "Therīgāthā 13.5: The Chapter of Twenty (Vīsatinipāta),", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:0.3"], "en": "The Verses of the Elder Nun Subhā Kammāradhītā (Subhā, the Daughter of the Blacksmith)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:1.1", "PA_thig_13.5:1.2"], "en": "“When I was young and dressed in pure white garments, I heard the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:1.3"], "en": "being heedful in that state, for me— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:1.4"], "en": "The realization of the Truths occurred.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:2.1", "PA_thig_13.5:2.2"], "en": "Thereafter, I experienced intense revulsion toward all sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:2.3"], "en": "Seeing fear in personal existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:2.4"], "en": "I longed only for renunciation;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:3.1"], "en": "having abandoned my circle of kinsmen, I went forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:3.2"], "en": "And slaves and laborers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:3.3"], "en": "villages and fertile fields,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:3.4"], "en": "delightful and full of joy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:4.1", "PA_thig_13.5:4.2", "PA_thig_13.5:4.3"], "en": "Having abandoned considerable wealth, I went forth into homelessness out of such faith.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:4.4"], "en": "When the true Dhamma is well-proclaimed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:5.1", "PA_thig_13.5:5.2"], "en": "it would not be fitting for him to aspire to the state of nothingness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:5.3", "PA_thig_13.5:5.4", "PA_thig_13.5:6.1"], "en": "He who, having discarded gold and silver, returns again for silver or gold—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:6.2"], "en": "Neither for awakening nor for peace;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:6.3"], "en": "this is not befitting a recluse,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:6.4"], "en": "nor is it the wealth of the Noble Ones.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:7.1"], "en": "This is alluring, intoxicating,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:7.2"], "en": "and deluding; it increases passion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:7.3"], "en": "is fraught with danger, and involves much exertion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:7.4"], "en": "And herein there is no lasting stability.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:8.1", "PA_thig_13.5:8.2"], "en": "Men who are attached and heedless here, with minds defiled—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:8.3"], "en": "Hostile toward one another,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:8.4"], "en": "they create widespread strife;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:9.1"], "en": "there is killing, imprisonment, and affliction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:9.2"], "en": "Know that there is sorrow and lamentation;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:9.3"], "en": "for those who are deeply immersed in sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:9.4"], "en": "much ruin is seen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:10.1"], "en": "My kinsmen treat me like an enemy;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:10.2"], "en": "why do you entice me with sensual pleasures?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:10.3"], "en": "Know that I have gone forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:10.4"], "en": "Seeing danger in sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:11.1", "PA_thig_13.5:11.2"], "en": "The taints are not exhausted by means of gold and silver.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:11.3"], "en": "Sensual desires are enemies and murderers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:11.4", "PA_thig_13.5:12.1"], "en": "they are adversaries and bonds of arrows. To me, those relatives are like enemies.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:12.2"], "en": "Why do you devote yourselves to sensual pleasures?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:12.3"], "en": "Know me as one who has gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:12.4"], "en": "shaven-headed and clad in the outer robe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:13.1"], "en": "Alms gathered by standing, gleaned food,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:13.2"], "en": "and a robe made of rags from a dust heap—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:13.3"], "en": "this indeed is befitting for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:13.4"], "en": "The support for the homeless life:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:14.1", "PA_thig_13.5:14.2"], "en": "Sensual pleasures, both celestial and human, have been vomited out by the great seers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:14.3"], "en": "They are liberated in the state of peace;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:14.4"], "en": "they have attained unshakable happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:15.1"], "en": "May I not be entangled with sensual desires.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:15.2"], "en": "In whom no refuge is found;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:15.3"], "en": "sensual desires are enemies and murderers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:15.4"], "en": "painful and comparable to a mass of fire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:16.1"], "en": "This is an obstacle, a danger,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:16.2"], "en": "fraught with distress and thorns;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:16.3"], "en": "this greed is exceedingly treacherous.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:16.4"], "en": "Greed is a great gateway to delusion;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:17.1"], "en": "its affliction is of terrifying form,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:17.2"], "en": "for sensual desires are like the heads of serpents.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:17.3"], "en": "Those fools who take delight in it,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:17.4"], "en": "the blind worldlings—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:18.1"], "en": "beings indeed mired in the mud of sensual desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:18.2"], "en": "Many in the world are ignorant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:18.3", "PA_thig_13.5:18.4"], "en": "they do not know the limit of birth and death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:19.1", "PA_thig_13.5:19.2", "PA_thig_13.5:19.3"], "en": "Many people indeed tread the path leading to a state of misery, caused by sensual desires.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:19.4"], "en": "Bringing disease upon oneself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:20.1"], "en": "Thus, they produce enmity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:20.2"], "en": "cause torment, and lead to defilement.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:20.3"], "en": "The worldly objects of sense-pleasure are binding;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:20.4"], "en": "sensual desires are the bond of death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:21.1"], "en": "They cause madness and lead to delusion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:21.2"], "en": "Sensual desires madden the mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:21.3"], "en": "they lead to the defilement of beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:21.4"], "en": "swiftly cast forth by Māra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:22.1"], "en": "Sensual pleasures have endless disadvantages,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:22.2"], "en": "much suffering, and great poison;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:22.3"], "en": "they offer little gratification and provoke conflict.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:22.4"], "en": "Drying up the bright fortnight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:23.1", "PA_thig_13.5:23.2"], "en": "Having committed such a calamity caused by sensual desire, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:23.3"], "en": "I shall not return to that [world],", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:23.4"], "en": "always delighting in Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:24.1"], "en": "having made an end of the strife of sensual desires.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:24.2"], "en": "Longing for the state of coolness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:24.3", "PA_thig_13.5:24.4"], "en": "I shall dwell heedfully for the sake of the destruction of all fetters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:25.1", "PA_thig_13.5:25.2", "PA_thig_13.5:25.3"], "en": "I follow that path which is sorrowless, stainless, secure, noble, eightfold, and straight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:25.4", "PA_thig_13.5:26.1", "PA_thig_13.5:26.2"], "en": "\"Behold this Subhā, the smith’s daughter, established in the Dhamma, by whom the great seers have crossed over.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:26.3"], "en": "Having attained the unshakable,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:26.4"], "en": "she meditates at the foot of a tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:27.1"], "en": "today is the eighth day since she went forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:27.2"], "en": "Faith is the ornament of the true Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:27.3"], "en": "it is the lotus-colored one who is well-disciplined,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:27.4"], "en": "the possessor of the three knowledges, and the destroyer of death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:28.1"], "en": "In the evening, free and debtless,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:28.2"], "en": "a bhikkhunī with developed faculties,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:28.3"], "en": "liberated from all bonds—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:28.4"], "en": "\"Having done what was to be done, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:29.1", "PA_thig_13.5:29.2"], "en": "Approaching him by means of his psychic power, Sakka, together with the host of devas, [spoke thus].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:29.3"], "en": "The Lord of Beings paid homage to Subhā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:29.4"], "en": "the daughter of the smith. … Subhā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:30.1"], "en": "the daughter of the smith, was an elder nun (therī).", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.5:31.1"], "en": "The Book of the Twenties is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
