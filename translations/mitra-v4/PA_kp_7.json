[
{"segs": ["PA_kp_7:0.1"], "en": "Khuddakapāṭha 7:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:0.2", "PA_kp_7:1.1"], "en": "Tirokuṭṭasutta They stand beyond the walls;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:1.2"], "en": "And at the junctions and crossroads;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:1.3"], "en": "they stand at the doorposts,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:1.4"], "en": "having come back to their own homes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:2.1"], "en": "When abundant food and drink,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:2.2"], "en": "various kinds of snacks and meals, are set before them,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:2.3"], "en": "no one remembers them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:2.4"], "en": "This is due to the kamma-condition of beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:3.1", "PA_kp_7:3.2"], "en": "Thus do those who are compassionate give to their relatives.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:3.3"], "en": "Pure, excellent, timely,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:3.4"], "en": "and permissible food and drink—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:4.1"], "en": "may this be for you, your kinsmen.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:4.2"], "en": "May my relatives be happy;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:4.3", "PA_kp_7:4.4"], "en": "may those departed relatives, having gathered there, be assembled together.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:5.1"], "en": "When there is an abundance of food and drink,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:5.2"], "en": "they offer their sincere thanks:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:5.3"], "en": "\"May our kinsmen live long!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:5.4"], "en": "For whose sake we receive [this],", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:6.1"], "en": "and for whom this worship has been performed—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:6.2"], "en": "may both the donors and we ourselves not be without fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:6.3"], "en": "For there is no plowing there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:6.4"], "en": "nor is cattle-rearing found there;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:7.1"], "en": "such trade as that does not exist.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:7.2"], "en": "Buying and selling with gold;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:7.3"], "en": "by what is given from here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:7.4"], "en": "the deceased spirits there subsist.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:8.1", "PA_kp_7:8.2", "PA_kp_7:8.3"], "en": "Just as water that has rained down flows along whatever is low-lying, even so does what is given from here [flow to those who have cultivated the path].", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:8.4"], "en": "it is of benefit to the departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:9.1", "PA_kp_7:9.2"], "en": "Just as rivers full of water fill the ocean;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:9.3", "PA_kp_7:9.4"], "en": "In the same way, what is given from here benefits the departed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:10.1"], "en": "\"He gave to me, he did for me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:10.2"], "en": "To my kinsmen, friends, and companions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:10.3"], "en": "one should give an offering for the deceased,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:10.4"], "en": "recollecting what was done in the past.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:11.1"], "en": "For neither weeping nor grief,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:11.2"], "en": "nor any other lamentation,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:11.3"], "en": "brings any benefit to the departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:11.4"], "en": "Thus do kinsmen stand by.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:12.1", "PA_kp_7:12.2"], "en": "And this gift that has been given is well-established in the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:12.3"], "en": "It conduces to his welfare for a long time;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:12.4"], "en": "it is immediately beneficial.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:13.1"], "en": "Thus has this duty toward kinsmen been demonstrated.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:13.2"], "en": "Great worship was performed for the departed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:13.3"], "en": "and strength was bestowed upon the monks; by you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:13.4"], "en": "abundant merit has been accumulated in no small measure.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_7:14.1"], "en": "The Discourse on the Wall-Breaker.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"}
]
