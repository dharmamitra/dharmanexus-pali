[
{"segs": ["PA_tha-ap_321:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:0.2"], "en": "Ārakkhadāyaka-vagga 9,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:0.3"], "en": "The Apadāna of the Elder Kandalipupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:1.1", "PA_tha-ap_321:1.2"], "en": "“At that time, on the bank of the river Sindhū, I was a farmer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:1.3"], "en": "engaged in working for others.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:1.4"], "en": "Without having seen another teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:2.1"], "en": "while wandering along the Indus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:2.2"], "en": "I beheld the Conqueror Siddhattha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:2.3"], "en": "Seated as if in samādhi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:2.4"], "en": "like a hundred-petaled flower in full bloom—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:3.1"], "en": "seven kandalī flowers [were offered].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:3.2"], "en": "Having then cut it from the stalk,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:3.3"], "en": "I placed it upon the head of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:3.4"], "en": "the Kinsman of the Sun.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:4.1"], "en": "The golden-colored Sambuddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:4.2"], "en": "concentrated and composed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:4.3"], "en": "like a noble elephant that has split its temple in three ways.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:4.4"], "en": "Like an elephant difficult to approach—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:5.1", "PA_tha-ap_321:5.2"], "en": "having approached him who is prudent and has cultivated his faculties;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:5.3"], "en": "Raising my hands in añjali,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:5.4"], "en": "I paid homage to the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:6.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:6.2"], "en": "The flower that I offered—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:6.3", "PA_tha-ap_321:6.4"], "en": "of this worship of the Buddha, I do not know a state of woe as its fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:7.1", "PA_tha-ap_321:7.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:7.3"], "en": "[and so forth] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:8.1"], "en": "Thus indeed the venerable elder Kandalipupphiya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_321:9.1"], "en": "This is the ninth legend of the elder Kandalipupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
