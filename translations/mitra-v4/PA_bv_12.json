[
{"segs": ["PA_bv_12:0.1"], "en": "Buddhavamsa 12.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:0.2"], "en": "The Lineage of Padumuttara Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:1.1"], "en": "\"After Nārada...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:1.2"], "en": "The Fully Awakened One, supreme among bipeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:1.3"], "en": "the Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:1.4"], "en": "is unshakable like the ocean.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:2.1", "PA_bv_12:2.2"], "en": "The world was like a golden age when the Buddha was born;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:2.3"], "en": "the people were abundant in wholesome deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:2.4", "PA_bv_12:3.1", "PA_bv_12:3.2"], "en": "In that eon, during the first teaching of the Dhamma by the Blessed One Padumuttara, he was born.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:3.3", "PA_bv_12:3.4"], "en": "There was the realization of the Dhamma by one hundred thousand times ten million;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:4.1"], "en": "even as it rained thereafter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:4.2"], "en": "And while they were making offerings to Pāṇinī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:4.3", "PA_bv_12:4.4"], "en": "there occurred the second realization for seven million three hundred thousand beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:5.1", "PA_bv_12:5.2"], "en": "At that time, when the Great Hero approached Ānanda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:5.3"], "en": "having gone into the presence of his father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:5.4"], "en": "He beat the drum of the Deathless.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:6.1"], "en": "When the drum of the Deathless was beaten,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:6.2"], "en": "the rain of the Dhamma poured down.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:6.3", "PA_bv_12:6.4"], "en": "There was a third realization for fifty hundred thousand [beings].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:7.1"], "en": "He was the instructor and the one who made it known.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:7.2", "PA_bv_12:7.3"], "en": "The Buddha, the deliverer of all living beings, skilled in teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:7.4"], "en": "has ferried across the multitude of people.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:8.1", "PA_bv_12:8.2"], "en": "There were three assemblies of the Teacher Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:8.3"], "en": "consisting of one hundred thousand koṭis each.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:8.4"], "en": "This was the first meeting,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:9.1"], "en": "when the Buddha, the peerless one,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:9.2"], "en": "dwelt upon Mount Vebhāra.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:9.3", "PA_bv_12:9.4"], "en": "A second assembly of ninety thousand koṭis took place when he had set out on his wandering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:10.1"], "en": "When he had departed on his journey,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:10.2"], "en": "From villages, market towns,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:10.3", "PA_bv_12:10.4"], "en": "and kingdoms, there was a third assembly of eighty thousand crores.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:11.1"], "en": "At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:11.2"], "en": "I was a royal counselor named Jaṭila;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:11.3"], "en": "[I served] the Saṅgha headed by the Fully Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:11.4"], "en": "I gave him a robe along with a bowl.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:12.1", "PA_bv_12:12.2"], "en": "Sitting in the midst of the Saṅgha, that Buddha also made this prediction concerning me:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:12.3"], "en": "“In a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:12.4"], "en": "this one will become a Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:13.1"], "en": "Having exerted himself in striving...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:13.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:13.3"], "en": "\"We shall be present before him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:14.1"], "en": "Having heard her words as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:14.2"], "en": "I resolved upon a further vow;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:14.3", "PA_bv_12:14.4"], "en": "I exercised fierce and firm fortitude for the fulfillment of the ten perfections.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:15.1", "PA_bv_12:15.2"], "en": "All the sectarian teachers were then frustrated and dejected;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:15.3"], "en": "no one attended upon them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:15.4"], "en": "They were expelled from the kingdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:16.1"], "en": "Having all gathered together there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:16.2"], "en": "they approached the presence of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:16.3"], "en": "You are our protector, O Great Hero;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:16.4"], "en": "be our refuge, O Visionary One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:17.1"], "en": "Compassionate and merciful, you are our lord.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:17.2"], "en": "Seeking the welfare of all living beings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:17.3", "PA_bv_12:17.4"], "en": "he established all the ascetics who arrived there in the five precepts.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:18.1"], "en": "Thus it was free from confusion,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:18.2"], "en": "empty of those belonging to other sects,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:18.3"], "en": "and variegated with Arahants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:18.4"], "en": "By those who have attained mastery and are such-like,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:19.1"], "en": "[was ruled] the city named Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:19.2"], "en": "where the kshatriya named Ānanda [reigned].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:19.3", "PA_bv_12:19.4"], "en": "The mother of the Teacher Padumuttara was named Sujātā;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:20.1"], "en": "for ten thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:20.2"], "en": "He lived as a householder;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:20.3"], "en": "Naravāhana was glorious, a master of his own will,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:20.4"], "en": "possessing three supreme palaces.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:21.1", "PA_bv_12:21.2"], "en": "Forty-four thousand women were beautifully adorned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:21.3"], "en": "there was a woman named Vasudattā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:21.4"], "en": "The son born to Atraja was named Uttama.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:22.1"], "en": "Having seen four omens,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:22.2"], "en": "he went forth from the palace.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:22.3", "PA_bv_12:22.4"], "en": "For seven days the Supreme Person practiced ascetic exertion,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:23.1"], "en": "even though he was entreated by Brahmā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:23.2"], "en": "The Guide Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:23.3", "PA_bv_12:23.4"], "en": "the Great Hero, turned the Wheel of Dhamma in the most excellent Mithila Garden.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:24.1", "PA_bv_12:24.2"], "en": "Devala and Sujāta were his chief disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:24.3"], "en": "the attendant was named Sumana.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:24.4"], "en": "Of the Great Seer Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:25.1", "PA_bv_12:25.2"], "en": "there were two chief female disciples who were immeasurable and peerless.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:25.3", "PA_bv_12:25.4"], "en": "The Bodhi tree of that Blessed One is called Salala.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:26.1"], "en": "Vitinna and Tissa—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:26.2", "PA_bv_12:26.3"], "en": "They were the foremost attendants; joyful and adorned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:26.4"], "en": "they were the foremost attendants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:27.1", "PA_bv_12:27.2"], "en": "The Great Sage, eighty cubits in height,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:27.3"], "en": "shines like a priceless golden ornament.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:27.4"], "en": "Possessing the thirty-two excellent marks.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:28.1"], "en": "Walls, door-panels, and enclosures,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:28.2"], "en": "as well as trees and mountain crags;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:28.3", "PA_bv_12:28.4", "PA_bv_12:29.1"], "en": "There is no obstruction for him within twelve yojanas all around for a hundred thousand years.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:29.2"], "en": "As long as life remained,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:29.3", "PA_bv_12:29.4"], "en": "for that long he stayed and delivered many people.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:30.1", "PA_bv_12:30.2"], "en": "Having ferried across many people and severed all doubt,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:30.3"], "en": "like a blazing mass of fire, he has gone out.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:30.4"], "en": "He has attained Nibbāna along with his disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:31.1"], "en": "The Victor, the Buddha Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:31.2"], "en": "attained Nibbāna in the Nanda Monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:31.3"], "en": "Right there his excellent stupa stands,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:31.4"], "en": "twelve yojanas in height.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_12:32.1"], "en": "Thus ends the tenth lineage of the Blessed One Padumuttara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
