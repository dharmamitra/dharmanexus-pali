[
{"segs": ["PA_thag_1.100:0.1", "PA_thag_1.100:0.2", "PA_thag_1.100:0.3"], "en": "Theragāthā 1.100 Ekakanipāta Dasamavagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.100:0.4"], "en": "(Dutiya) Devasabha Thera’s Verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.100:1.1", "PA_thag_1.100:1.2"], "en": "“Endowed with right exertion, having the foundations of mindfulness as his domain;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.100:1.3"], "en": "“Covered with the flowers of liberation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.100:1.4"], "en": "free from taints, he will attain final nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.100:1.5"], "en": "… Thus spoke the elder Devasabha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.100:1.6"], "en": "The tenth chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.100:2.0"], "en": "Its summary:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.100:2.1"], "en": "Paripuṇṇaka and Vijaya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.100:2.2"], "en": "The sage Mettajī Eraka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.100:2.3"], "en": "Cakkhupāla, Khaṇḍasumana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.100:2.4"], "en": "Tissa, and likewise Abhaya;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.100:2.5"], "en": "And Uttiya of great wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.100:2.6"], "en": "and the elder Devasabha as well.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
