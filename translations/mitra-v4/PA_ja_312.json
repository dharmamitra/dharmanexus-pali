[
{"segs": ["PA_ja_312:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:0.2", "PA_ja_312:0.3"], "en": "Catukkanipāta, Pucimandavagga (The Chapter on the Nimba Tree)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:0.4"], "en": "2. The Kassapamandiyajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:1.1", "PA_ja_312:1.2"], "en": "“Even for the sake of a trifle, O Kassapa, a youth may swear an oath or strike another.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:1.3"], "en": "The wise person forgives all that;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:1.4"], "en": "the learned one endures it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:2.1"], "en": "Even if the virtuous should quarrel, [he remains steadfast].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:2.2"], "en": "They are quickly reconciled again;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:2.3"], "en": "fools break apart as soon as they have met,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:2.4"], "en": "for they have not attained peace.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:3.1"], "en": "These come together even more closely,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:3.2"], "en": "and their bond does not decay—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:3.3"], "en": "for one who knows what has been undertaken.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:3.4"], "en": "But he who understands the teaching—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:4.1"], "en": "verily he is superior,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:4.2"], "en": "the bearer of the burden, the one who carries the yoke.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:4.3", "PA_ja_312:4.4"], "en": "“He who is himself worthy to reconcile those others who are embroiled in strife.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_312:5.1"], "en": "Thus ends the second Jātaka, the Kassapamandīya Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
