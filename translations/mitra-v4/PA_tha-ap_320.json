[
{"segs": ["PA_tha-ap_320:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:0.2"], "en": "The Chapter on the Giver of Protection (Ārakkhadāyakavagga), Number 8:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:0.3"], "en": "The Apadāna of the Elder Tiraṁsiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:1.1"], "en": "Like a noble lion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:1.2"], "en": "like a mass of fire upon a mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:1.3"], "en": "illuminating all directions—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:1.4"], "en": "Within the mountain range,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:2.1", "PA_tha-ap_320:2.2"], "en": "he saw the light of the sun and likewise the light of the moon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:2.3"], "en": "And having seen the light of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:2.4"], "en": "a sense of well-being arose within me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:3.1"], "en": "having seen these three lights, I felt inspired.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:3.2"], "en": "To the perfectly awakened one, the supreme disciple,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:3.3", "PA_tha-ap_320:3.4"], "en": "I placed my deerskin mantle over one shoulder and praised the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:4.1", "PA_tha-ap_320:4.2"], "en": "For there are three light-makers in the world who dispel the darkness of the world:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:4.3"], "en": "the moon, the sun, and also—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:4.4"], "en": "And the Buddha, the leader of the world—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:5.1", "PA_tha-ap_320:5.2"], "en": "the Great Sage has been praised by me after presenting this simile.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:5.3"], "en": "Having praised the Buddha’s excellence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:5.4"], "en": "I rejoiced in heaven for an eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:6.1"], "en": "Ninety-four eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:6.2"], "en": "Because I praised the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:6.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:6.4"], "en": "this is the fruit of that praise.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:7.1"], "en": "In the sixty-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:7.2"], "en": "there was one who possessed true knowledge;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:7.3"], "en": "he was endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:7.4"], "en": "A wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:8.1", "PA_tha-ap_320:8.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:8.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:9.1"], "en": "In this way, it is said, the Venerable Elder Tiraṃsiya recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_320:10.1"], "en": "This is the eighth legend of the Elder Tiraṃsiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
