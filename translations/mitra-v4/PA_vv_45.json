[
{"segs": ["PA_vv_45:0.1"], "en": "Vimānavatthu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:0.2", "PA_vv_45:0.3"], "en": "The Chapter on the Mañjiṭṭhaka Mansion in the Section on Female Vimānas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:0.4", "PA_vv_45:1.1", "PA_vv_45:1.2"], "en": "7. Caturitthivimānavatthu “With a most excellent complexion, … [as before] …”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:1.3"], "en": "\"And your complexion shines in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:2.1", "PA_vv_45:2.2"], "en": "That deity, with a joyful mind... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:2.3"], "en": "This is the fruit of that deed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:3.1", "PA_vv_45:3.2"], "en": "\"I gave a handful of blue lotuses to a bhikkhu who was wandering for alms.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:3.3", "PA_vv_45:3.4"], "en": "On the high ramparts of that delightful, preeminent city, which was strewn with leaves; because of that,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:4.1"], "en": "my complexion became such as this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:4.2", "PA_vv_45:4.3"], "en": "\"...and my complexion shines in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:5.1"], "en": "\"With such a magnificent complexion...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:5.2", "PA_vv_45:5.3"], "en": "\"...and your radiance illuminates all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:6.1"], "en": "That deity was uplifted in mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:6.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:6.3"], "en": "the fruit of which action is this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:7.1"], "en": "\"I gave a handful of blue lotuses.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:7.2"], "en": "As a bhikkhu was walking for alms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:7.3"], "en": "he came upon that most excellent city, Pāṇaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:7.4"], "en": "which was delightful and filled with tall flagstaffs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:8.1", "PA_vv_45:8.2"], "en": "\"Because of that, my complexion is such as this...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:8.3"], "en": "and my complexion shines forth in all directions.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:9.1"], "en": "“With your exquisite complexion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:9.2", "PA_vv_45:9.3"], "en": "…pe… your complexion illuminates all directions.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:10.1", "PA_vv_45:10.2"], "en": "That deity was uplifted in mind...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:10.3"], "en": "[as before] ...this is the fruit of that karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:11.1"], "en": "“I gave a white-rooted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:11.2", "PA_vv_45:11.3"], "en": "green-leaved plant growing in the water of a lake to a bhikkhu wandering for alms.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:11.4", "PA_vv_45:11.5"], "en": "Upon the high turrets of that delightful city, Paṇṇakata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:12.1"], "en": "my complexion has become such as this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:12.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:12.3"], "en": "\"And my complexion shines in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:13.1"], "en": "\"With such a radiant complexion...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:13.2", "PA_vv_45:13.3"], "en": "\"...and your radiance shines in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:14.1"], "en": "That deity was uplifted in mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:14.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:14.3"], "en": "the fruit of which action is this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:15.1"], "en": "\"I, Sumanā, [gave] jasmine flowers to Sumanas.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:15.2", "PA_vv_45:15.3", "PA_vv_45:15.4"], "en": "I gave ivory-colored [robes] to a bhikkhu who was wandering for alms on a high mound of pillars.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:15.5"], "en": "In the delightful city of Paṇṇakata, the best of cities;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:16.1"], "en": "because of that, my complexion is such as this...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:16.2"], "en": "[etc.]", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:16.3"], "en": "\"And my radiance shines in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_45:17.1"], "en": "Thus ends the seventh Vimāna, that of the Four Women.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"}
]
