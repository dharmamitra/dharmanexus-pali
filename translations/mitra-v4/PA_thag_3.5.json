[
{"segs": ["PA_thag_3.5:0.1", "PA_thag_3.5:0.2"], "en": "Theragāthā 3.5 Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:0.4"], "en": "The Verses of the Elder Mātaṅgaputta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:1.1"], "en": "“It was too cold, it was too hot,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:1.2"], "en": "and this evening was too late;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:1.3", "PA_thag_3.5:1.4"], "en": "Thus, for the youth who has neglected their duties, the moments pass by;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:2.1"], "en": "yet he who [endures] both cold and heat...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:2.2"], "en": "He does not think more highly of himself than a blade of grass;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:2.3"], "en": "performing his human duties,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:2.4"], "en": "he is not separated from happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:3.1"], "en": "With darbha grass, kuśa grass, poṭakila,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:3.2"], "en": "uśīra root, muñja grass, and pabbaja grass,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:3.3"], "en": "I shall push him away with my chest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:3.4"], "en": "“Cultivating discernment,” said the Elder Mātaṅgaputta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.5:3.5"], "en": "… The Elder Mātaṅgaputta … [said].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
