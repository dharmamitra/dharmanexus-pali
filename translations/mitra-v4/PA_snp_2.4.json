[
{"segs": ["PA_snp_2.4:0.1", "PA_snp_2.4:0.2", "PA_snp_2.4:1.1"], "en": "Sutta Nipāta 2.4 Maṅgalasutta Thus have I heard:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:1.2"], "en": "On one occasion the Blessed One was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:1.3"], "en": "Then a certain deity, in the deep of night, having illuminated the entirety of Jeta’s Grove with a magnificent radiance, approached the Blessed One. Having approached and paid homage to the Blessed One, he stood to one side.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:1.4"], "en": "Standing to one side, that deity addressed the Blessed One in verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:2.1", "PA_snp_2.4:2.2"], "en": "“Many gods and humans have pondered upon blessings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:2.3"], "en": "desiring safety and well-being.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:2.4"], "en": "\"Tell me the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:3.1"], "en": "\"Not associating with fools,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:3.2"], "en": "but associating with the wise;\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:3.3"], "en": "And honoring those worthy of honor—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:3.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:4.1"], "en": "And dwelling in a suitable locality—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:4.2"], "en": "Having performed merit in the past,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:4.3"], "en": "and right resolve for oneself—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:4.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:5.1"], "en": "Great learning and craft,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:5.2"], "en": "well-trained discipline,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:5.3"], "en": "and speech that is well-spoken—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:5.4"], "en": "This is the supreme blessing:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:6.1"], "en": "attending to one’s mother and father,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:6.2"], "en": "and providing for one’s wife and children.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:6.3"], "en": "And unconfused occupations—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:6.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:7.1"], "en": "Giving and righteous conduct...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:7.2", "PA_snp_2.4:7.3"], "en": "Supporting one's relatives and performing blameless deeds—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:7.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:8.1"], "en": "Abstaining from evil, refraining from it,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:8.2"], "en": "restraint from the drinking of intoxicants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:8.3"], "en": "and heedfulness regarding all phenomena—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:8.4"], "en": "This is the supreme blessing:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:9.1"], "en": "reverence, humility,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:9.2"], "en": "contentment, and gratitude.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:9.3"], "en": "Listening to the Dhamma at the proper time—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:9.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:10.1"], "en": "So too are patience and being easy to speak to.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:10.2", "PA_snp_2.4:10.3"], "en": "Beholding ascetics and engaging in discussion on the Dhamma at the proper time—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:10.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:11.1"], "en": "Austerity and the holy life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:11.2"], "en": "the vision of the noble truths,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:11.3"], "en": "and the realization of Nibbāna—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:11.4"], "en": "This is the supreme blessing:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:12.1", "PA_snp_2.4:12.2"], "en": "that the mind of one who is touched by the worldly conditions does not waver.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:12.3"], "en": "Sorrowless, stainless, and secure—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:12.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:13.1"], "en": "Having performed such deeds as these,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:13.2"], "en": "Unconquered everywhere,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:13.3"], "en": "they go everywhere in safety;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:13.4"], "en": "that is their supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.4:13.5"], "en": "The Maṅgala Sutta is the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
