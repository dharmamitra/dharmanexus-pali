[
{"segs": ["PA_ja_294:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_294:0.2", "PA_ja_294:0.3"], "en": "The Section of Threes, Chapter on the Water-Jar (Kumbhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_294:0.4", "PA_ja_294:1.1"], "en": "4. The Jātaka of Jambukhādaka “Who is this one with such a lovely, gurgling sound,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_294:1.2"], "en": "the most excellent among those who possess voices?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_294:1.3", "PA_ja_294:1.4"], "en": "“Like a peacock’s cry from the branch of a jambu tree, he utters his call.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_294:2.1"], "en": "“Only one of noble birth knows this,” [he said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_294:2.2"], "en": "To praise this son of noble family:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_294:2.3", "PA_ja_294:2.4"], "en": "\"O you with the color of a tiger’s skin, eat, my dear; I give it to you.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_294:3.1"], "en": "“After a long time, indeed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_294:3.2"], "en": "I see assembled those who speak falsehoods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_294:3.3"], "en": "those who eat what has been vomited, and those who eat carrion.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_294:3.4"], "en": "“Praising one another.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_294:4.1"], "en": "Thus ends the fourth Jātaka, the Jambukhādaka Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
