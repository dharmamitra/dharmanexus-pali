[
{"segs": ["PA_tha-ap_415:0.1", "PA_tha-ap_415:0.2", "PA_tha-ap_415:0.3"], "en": "The Apadāna of the Elder Tiṇasūlakachādaniya, from the Bhaddāli-vagga of the Therāpadāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:1.1", "PA_tha-ap_415:1.2", "PA_tha-ap_415:1.3"], "en": "“Then, having gone forth all alone, I reflected upon birth, old age, and death.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:1.4"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:2.1"], "en": "Wandering by stages,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:2.2"], "en": "I arrived at the bank of the Ganges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:2.3", "PA_tha-ap_415:2.4"], "en": "There I saw the earth rising high on the bank of the Ganges;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:3.1"], "en": "having established a hermitage there, I dwelt.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:3.2"], "en": "I dwell in this hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:3.3"], "en": "my walkway is well-prepared,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:3.4"], "en": "frequented by various flocks of birds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:4.1"], "en": "They trust me and call out with enchanting cries;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:4.2", "PA_tha-ap_415:4.3"], "en": "delighting together with them, I dwell there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:4.4"], "en": "I dwell in this hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:5.1", "PA_tha-ap_415:5.2"], "en": "Near my hermitage is the king of beasts, who moves with a fourfold gait.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:5.3"], "en": "Having emerged from his lair,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:5.4"], "en": "he roared like a thunderbolt;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:6.1"], "en": "and when the king of beasts roared, too, [the earth shook].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:6.2"], "en": "Joy arose within me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:6.3"], "en": "seeking the king of deer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:6.4"], "en": "I beheld the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:7.1"], "en": "Having seen the God of Gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:7.2"], "en": "Tissa, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:7.3"], "en": "I was thrilled with a joyful heart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:7.4"], "en": "I worshipped the nāgakesara flower—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:8.1"], "en": "like the rising sun,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:8.2"], "en": "like a king of sāla trees in full bloom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:8.3", "PA_tha-ap_415:8.4"], "en": "I praised the Leader of the World, who shines like a medicinal herb:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:9.1"], "en": "“O All-Knowing One, by your wisdom, [you have overcome all darkness].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:9.2"], "en": "May they liberate this world together with its devas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:9.3"], "en": "having propitiated you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:9.4"], "en": "may they be completely freed from birth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:10.1"], "en": "By not seeing the All-Knowing Ones,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:10.2"], "en": "the Buddhas who see all,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:10.3"], "en": "they fall into the Vīci hell.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:10.4"], "en": "Overwhelmed by passion and hatred,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:11.1"], "en": "they have come to see you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:11.2"], "en": "O All-Knowing One, Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:11.3"], "en": "All states of existence are cleansed away,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:11.4"], "en": "and they touch the deathless state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:12.1"], "en": "when the Buddhas, the possessors of vision, appear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:12.2"], "en": "They arise as light-makers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:12.3"], "en": "having consumed the defilements,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:12.4"], "en": "they reveal the light.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:13.1"], "en": "Having praised the Fully Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:13.2"], "en": "Tissa, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:13.3"], "en": "he was joyful with a joyful heart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:13.4"], "en": "I did not worship the grass-stake.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:14.1"], "en": "Knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:14.2"], "en": "Tissa, the Leader of the World, [acted].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:14.3"], "en": "Having sat down on his own seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:14.4"], "en": "he spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:15.1"], "en": "“He who covered me with flowers...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:15.2"], "en": "With serene and wholesome hands,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:15.3"], "en": "I shall praise him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:15.4"], "en": "listen as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:16.1", "PA_tha-ap_415:16.2"], "en": "Twenty-five times he will exercise sovereignty over the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:16.3"], "en": "and seventy-five times—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:16.4"], "en": "He will become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:17.1"], "en": "His regional sovereignty will be vast,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:17.2"], "en": "beyond all calculation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:17.3", "PA_tha-ap_415:17.4"], "en": "By the natural result of that deed and by his worship with flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:18.1"], "en": "this person has bathed his head.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:18.2"], "en": "If one desires flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:18.3", "PA_tha-ap_415:18.4"], "en": "they will appear before one, provided they are connected with meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:19.1"], "en": "Whatever one desires through sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:19.2"], "en": "that very thing will manifest;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:19.3"], "en": "having fulfilled one’s intention, one shall attain it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:19.4", "PA_tha-ap_415:20.1"], "en": "‘He will attain Nibbāna, free from taints. The eighteenth recitation section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:21.1"], "en": "Having incinerated the defilements,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:21.2"], "en": "Mindful and clearly comprehending,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:21.3"], "en": "sitting in a single seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:21.4"], "en": "I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:22.1", "PA_tha-ap_415:22.2"], "en": "Whether walking, lying down, sitting, or standing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:22.3"], "en": "having recollected the Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:22.4"], "en": "I always dwell [thus]:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:23.1"], "en": "regarding robes, almsfood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:23.2"], "en": "requisites, and lodgings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:23.3"], "en": "In this there is no deficiency for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:23.4"], "en": "this is the fruit of worshiping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:24.1"], "en": "Now he has attained the Deathless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:24.2"], "en": "The peaceful, unsurpassed state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:24.3"], "en": "having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:24.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:25.1"], "en": "In the ninety-two aeons since then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:25.2"], "en": "because I offered that flower in worship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:25.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:25.4"], "en": "This is the fruit of worshipping the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:26.1", "PA_tha-ap_415:26.2"], "en": "the defilements have been burnt away by me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:26.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:27.1", "PA_tha-ap_415:27.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:27.3"], "en": "The Buddha’s teaching has been proclaimed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:28.1", "PA_tha-ap_415:28.2"], "en": "the four analytical knowledges, …pe… [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:28.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:29.1"], "en": "Thus indeed did the venerable elder Tiṇasūlakachādaniya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_415:30.1"], "en": "This is the third legend of the elder Tiṇasūlakachādaniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
