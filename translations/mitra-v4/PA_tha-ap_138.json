[
{"segs": ["PA_tha-ap_138:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:0.2"], "en": "Sobhitavagga 6.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:0.3"], "en": "The Apadāna of the Elder Campakapupphiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:1.1", "PA_tha-ap_138:1.2"], "en": "“Seated amidst the mountains, shining like a blooming kaṇikāra flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:1.3"], "en": "illuminating all directions— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:1.4"], "en": "Like a star in the healing herb.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:2.1"], "en": "There were three young brahmins,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:2.2"], "en": "well-trained in their own craft.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:2.3"], "en": "Taking a khāri-load,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:2.4"], "en": "they follow behind me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:3.1"], "en": "in their baskets are seven flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:3.2", "PA_tha-ap_138:3.3"], "en": "Having taken those [relics] deposited by the ascetic,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:3.4"], "en": "I enshrined them within my knowledge for Vessabhu.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:4.1"], "en": "In the thirty-first aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:4.2"], "en": "because I offered that flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:4.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:4.4"], "en": "This is the fruit of the offering of knowledge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:5.1"], "en": "In the twenty-ninth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:5.2"], "en": "one named Vipulābha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:5.3"], "en": "Endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:5.4"], "en": "a wheel-turning monarch of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:6.1"], "en": "the four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:7.1"], "en": "Thus indeed did the Venerable Elder Campakapupphiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_138:8.1"], "en": "The legend of the Elder Campakapupphiya is the sixth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
