{"segs": ["PA_thag_1.44:0.2", "PA_thag_1.44:0.3"], "en": "Pañcamavagga (The Fifth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.44:0.4"], "en": "The Verses of the Elder Sānu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.44:1.1"], "en": "“O Mother, they weep for one who is dead,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
