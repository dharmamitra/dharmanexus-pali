[
{"segs": ["PA_ja_409:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:0.2"], "en": "The Section of Sevens,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:0.3"], "en": "Chapter on Gandhāra", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:0.4", "PA_ja_409:1.1", "PA_ja_409:1.2"], "en": "4. The Daḷhadhamma Jātaka: “If I, while flowing, had not pleased Daḷhadhamma;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:1.3"], "en": "Dharanti bore the spear in her breast,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:1.4"], "en": "moving with heroic prowess in battle;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:2.1"], "en": "surely the king did not know this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:2.2"], "en": "My prowess and manliness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:2.3", "PA_ja_409:2.4"], "en": "my well-performed deeds in battle, and the messengers dispatched by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:3.1"], "en": "Surely I shall die now,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:3.2"], "en": "friendless and without refuge;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:3.3"], "en": "for then, of the potter—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:3.4"], "en": "The dung-collector has been given away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:4.1"], "en": "As long as a person exists,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:4.2"], "en": "for that very long they prattle on.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:4.3", "PA_ja_409:4.4", "PA_ja_409:5.1"], "en": "Those who have performed wholesome deeds in the past abandon him when misfortune strikes, just as a nobleman abandons a boil on his thumb.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:5.2", "PA_ja_409:5.3", "PA_ja_409:5.4"], "en": "One who does not understand the meaning of what has been done finds that the goals he had aspired to fall away from him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:6.1", "PA_ja_409:6.2"], "en": "He who has previously done what is wholesome and awakens to his purpose,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:6.3"], "en": "his true welfare increases.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:6.4"], "en": "Whatever aspirations you may have,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:7.1"], "en": "I declare that to you, O venerable ones,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:7.2"], "en": "as many as are gathered here.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:7.3", "PA_ja_409:7.4"], "en": "“Be grateful to all, and you shall long remain in heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_409:8.1"], "en": "The Daḷhadhamma Jātaka, the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
