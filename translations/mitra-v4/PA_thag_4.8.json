[
{"segs": ["PA_thag_4.8:0.1", "PA_thag_4.8:0.2", "PA_thag_4.8:0.3"], "en": "Theragāthā 4.8 Catukkanipāta Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:0.4"], "en": "The Verses of the Elder Rāhula:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:1.1", "PA_thag_4.8:1.2"], "en": "“‘Rāhula the Fortunate,’ so am I known by the wise, as one perfected in both.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:1.3"], "en": "That I am the son of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:1.4"], "en": "that I am one who has eyes regarding the teachings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:2.1"], "en": "and that my taints are exhausted—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:2.2"], "en": "And for whom there is no further becoming:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:2.3"], "en": "I am an arahant worthy of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:2.4"], "en": "a possessor of the three knowledges, a seer of the Deathless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:3.1"], "en": "Blinded and covered by a net,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:3.2"], "en": "shrouded by the concealment of craving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:3.3"], "en": "they are bound by their kinsman, the heedless one.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:3.4"], "en": "Like a small fish at the mouth of a trap,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:4.1", "PA_thag_4.8:4.2"], "en": "I have abandoned that sensual desire and severed Māra’s bond.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:4.3"], "en": "“Having uprooted craving together with its root,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:4.4"], "en": "I have become cool and attained Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.8:4.5"], "en": "… Thus spoke the Elder Rāhula.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
