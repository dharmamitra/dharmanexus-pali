[
{"segs": ["PA_ja_443:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:0.2"], "en": "The Ten-Verse Section,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:0.3"], "en": "Chapter on the Four Gates", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:0.4"], "en": "5. The Cūḷabodhi Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:1.1", "PA_ja_443:1.2"], "en": "“O you who have large eyes, he who [takes] this beloved woman of yours, who speaks so kindly;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:1.3"], "en": "“If one were to take it and go away by force,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:1.4"], "en": "what indeed would you do, O Brahmin?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:2.1"], "en": "“It would arise in me and not be released.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:2.2"], "en": "\"Let him not escape while I am alive;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:2.3"], "en": "like a vast rain upon a king,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:2.4"], "en": "I shall quickly bring him to a halt.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:3.1"], "en": "“Since you were previously so boastful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:3.2"], "en": "relying as if on strength,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:3.3"], "en": "why are you now silent?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:3.4"], "en": "\"You wish to sew a robe.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:4.1"], "en": "\"It arose for me, yet it was not released;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:4.2"], "en": "it was not released from me while I lived.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:4.3", "PA_ja_443:4.4"], "en": "Like a vast torrential rain upon a king, I quickly brought it to an end.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:5.1"], "en": "\"What arose for you? Was it not released?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:5.2"], "en": "Why was it that you were not released while still alive?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:5.3"], "en": "Like a vast rain upon a king,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:5.4"], "en": "what was it that you sought to ward off?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:6.1"], "en": "“He who, when born, does not see,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:6.2"], "en": "but sees clearly when unborn—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:6.3"], "en": "he has arisen for me, he has not passed away.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:6.4"], "en": "Anger is the domain of the foolish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:7.1", "PA_ja_443:7.2"], "en": "By its arising, those enemies who seek suffering rejoice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:7.3"], "en": "Thus there arose in me, not to be suppressed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:7.4"], "en": "anger whose range is the foolish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:8.1"], "en": "And while it was arising, [I thought:]", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:8.2"], "en": "He does not understand his own true welfare;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:8.3", "PA_ja_443:8.4"], "en": "that anger, the domain of the foolish, arose in me but was not released.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:9.1", "PA_ja_443:9.2"], "en": "He by whom one is overcome abandons what is wholesome and fails to strive even for great benefit;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:9.3"], "en": "he is like a powerful, crushing Bhimasena.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:9.4"], "en": "\"Anger, O Great King, does not leave me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:10.1"], "en": "When wood is being rubbed together,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:10.2"], "en": "that which is called fire is born.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:10.3", "PA_ja_443:10.4"], "en": "It burns that very wood from which the fire was born;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:11.1"], "en": "even so it is with the dull-witted person.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:11.2"], "en": "In the fool who lacks understanding,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:11.3"], "en": "anger arises from provocation,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:11.4"], "en": "and he is consumed by that very same anger.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:12.1"], "en": "Like a fire upon grass and wood,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:12.2"], "en": "for one in whom anger increases,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:12.3"], "en": "their fame diminishes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:12.4"], "en": "Like the moon in the dark fortnight,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:13.1"], "en": "like a smokeless comet—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:13.2"], "en": "such is the person whose anger has been stilled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:13.3"], "en": "“His fame increases,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:13.4"], "en": "like the moon in the bright fortnight.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_443:14.1"], "en": "The Cūḷabodhi Jātaka, the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
