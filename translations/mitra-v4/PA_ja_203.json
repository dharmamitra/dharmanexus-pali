[
{"segs": ["PA_ja_203:0.1", "PA_ja_203:0.2", "PA_ja_203:0.3"], "en": "Jātaka: The Second Book of Birth Stories (Dukanipāta), Chapter on the Nataṁdaḷha Group (Nataṁdaḷhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:0.4", "PA_ja_203:1.1"], "en": "3. The Khaṇḍa Jātaka “I have loving-kindness for the Virūpakkhas;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:1.2"], "en": "I have loving-kindness for the Erāpathas.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:1.3"], "en": "I have loving-kindness for the Chabyāputtas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:1.4"], "en": "and loving-kindness for the Kaṇhāgotamakas;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:2.1"], "en": "I have loving-kindness for those without feet.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:2.2"], "en": "May there be loving-kindness toward my two-legged beings;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:2.3"], "en": "may there be loving-kindness toward my four-legged beings;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:2.4"], "en": "may there be loving-kindness toward my many-legged beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:3.1"], "en": "May no footless creature harm me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:3.2"], "en": "may no two-footed creature harm me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:3.3"], "en": "may no four-footed creature harm me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:3.4"], "en": "May no many-footed creature harm me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:4.1"], "en": "All beings, all living things,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:4.2"], "en": "and all creatures without exception—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:4.3"], "en": "May all behold auspicious things;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:4.4"], "en": "may no evil come to anyone.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:5.1"], "en": "Boundless is the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:5.2"], "en": "The Dharma is immeasurable;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:5.3"], "en": "the Saṅgha is immeasurable;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:5.4"], "en": "reptiles are limited in size.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:5.5"], "en": "Against snakes, scorpions, centipedes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:5.6"], "en": "spiders, crabs, and rats—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:6.1"], "en": "protection has been made for me, a safeguard has been made for me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:6.2"], "en": "May the spirits depart!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:6.3"], "en": "I pay homage to the Blessed One;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:6.4"], "en": "homage to the seven Perfectly Enlightened Ones.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_203:7.1"], "en": "The Third Khaṇḍa Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
