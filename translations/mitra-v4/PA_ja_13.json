{"segs": ["PA_ja_13:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_13:0.2", "PA_ja_13:0.3"], "en": "Ekakanipāta, Sīlavagga (The Chapter on Virtue)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_13:0.4"], "en": "3. The Kaṇḍijaṭaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_13:1.1", "PA_ja_13:1.2"], "en": "“Fie on the arrow-wound, fie on the man who shoots with deadly aim!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_13:1.3", "PA_ja_13:1.4"], "en": "Woe to that country where women are the leaders;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_13:1.5"], "en": "and woe to those beings as well!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_13:1.6"], "en": "“Those who have fallen under the power of women.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_13:2.1"], "en": "Thus ends the third Jātaka, the Kaṇḍi-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
