[
{"segs": ["PA_tha-ap_291:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:0.2", "PA_tha-ap_291:0.3"], "en": "The Chapter on the Giver of Leaves (Paṇṇadāyakavagga), Number Nine: The Apadāna of the Elder Buddhupaṭṭhāyika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:1.1", "PA_tha-ap_291:1.2"], "en": "“Veṭambhinī” was my name then, the name given by my father;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:1.3"], "en": "having taken hold of my hand, [he said:]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:1.4"], "en": "He brought the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:2.1", "PA_tha-ap_291:2.2"], "en": "These Buddhas, the leaders of the world, will point this out.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:2.3"], "en": "I attended upon him with devotion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:2.4"], "en": "full of faith, with my own hands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:3.1"], "en": "Thirty-one eons ago from now...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:3.2"], "en": "I then attended upon the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:3.3"], "en": "I do not know a state of misery—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:3.4"], "en": "this is the fruit of that attendance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:4.1"], "en": "In the twenty-third aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:4.2", "PA_tha-ap_291:4.3"], "en": "there were four kshatriyas known as the Samaṇupaṭṭhākās.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:4.4"], "en": "Universal monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:5.1", "PA_tha-ap_291:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:5.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:6.1"], "en": "Thus indeed did the venerable elder Buddhupaṭṭhāyika speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_291:7.1"], "en": "This is the ninth legend of the elder Buddhupaṭṭhāyika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
