[
{"segs": ["PA_ja_281:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_281:0.2", "PA_ja_281:0.3"], "en": "The Collection of Threes, Chapter on the Inner Circle (Abbhantaravagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_281:0.4"], "en": "1. The Jātaka of the Inner Tree:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_281:1.1", "PA_ja_281:1.2"], "en": "“There is a tree named ‘The Inner One,’ from which comes this divine fruit.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_281:1.3"], "en": "Having been a woman with pregnancy longings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_281:1.4"], "en": "she gives birth to a Wheel-turning Monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_281:2.1"], "en": "You too, O lady, are the chief queen.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_281:2.2"], "en": "\"And she too is dear to her husband;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_281:2.3", "PA_ja_281:2.4"], "en": "the king will bring this fruit from within for you.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_281:3.1"], "en": "“The hero who strives for the sake of his master,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_281:3.2", "PA_ja_281:3.3"], "en": "who reaches that state, being one who sacrifices himself— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_281:3.4"], "en": "“May you obtain it, O Lord!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_281:4.1"], "en": "Thus ends the first Jātaka, the *Abbhantara-jātaka*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
