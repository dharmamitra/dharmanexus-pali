[
{"segs": ["PA_thi-ap_25:0.1"], "en": "The Therī-apadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:0.2"], "en": "Kuṇḍalakesīvagga 5:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:0.3"], "en": "The Apadāna of Nandā Therī", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:1.2"], "en": "who has gone beyond all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:1.3"], "en": "[lived] one hundred thousand aeons ago from now.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:1.4"], "en": "In that eon, the Leader appeared—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:2.1"], "en": "the instructor, the enlightener,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:2.2"], "en": "the savior of all living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:2.3"], "en": "The Buddha, skilled in teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:2.4"], "en": "has delivered many people;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:3.1"], "en": "he is compassionate and merciful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:3.2"], "en": "Seeking the welfare of all living beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:3.3", "PA_thi-ap_25:3.4"], "en": "he established all the ascetics who arrived there in the five precepts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:4.1", "PA_thi-ap_25:4.2"], "en": "Thus it was free from confusion and empty of non-Buddhist sectarians,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:4.3"], "en": "yet variegated with Arahants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:4.4"], "en": "By those who have attained mastery and become \"such-like\" (tādin),", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:5.1", "PA_thi-ap_25:5.2"], "en": "the Great Sage, as if risen up, [proclaimed] the eighty-four thousand treasures of the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:5.3"], "en": "Resembling a priceless golden ornament,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:5.4"], "en": "endowed with the thirty-two excellent marks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:6.1"], "en": "for one hundred thousand years—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:6.2"], "en": "As long as life lasted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:6.3", "PA_thi-ap_25:6.4"], "en": "he remained for that long and delivered many people across.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:7.1", "PA_thi-ap_25:7.2"], "en": "At that time, I was born in Haṃsavatī, in a family of merchants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:7.3"], "en": "amidst the radiance of various jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:7.4"], "en": "Endowed with great bliss,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:8.1"], "en": "having approached that Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:8.2"], "en": "I heard his teaching of the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:8.3"], "en": "The Deathless, the supreme relish,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:8.4"], "en": "the revealer of the ultimate goal—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:9.1"], "en": "having then invited [him],...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:9.2", "PA_thi-ap_25:9.3"], "en": "Having given a great gift to that Leader of the World together with the Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:9.4"], "en": "they were filled with serene confidence by their own hands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:10.1", "PA_thi-ap_25:10.2"], "en": "I aspired to the foremost place among the meditating bhikkhunīs;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:10.3"], "en": "bowing my head to the Wise One, I paid homage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:10.4"], "en": "To the Leader of the World together with his Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:11.1"], "en": "At that time, the Subduer of the unsubdued,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:11.2"], "en": "the Lord who is the refuge of the three worlds;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:11.3"], "en": "The Charioteer of Men declared:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:11.4", "PA_thi-ap_25:12.1"], "en": "\"In a hundred thousand aeons from now, you shall attain that which was so well-striven for.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:12.2"], "en": "Born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:12.3", "PA_thi-ap_25:12.4"], "en": "he will be a teacher in the world named Gotama by lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:13.1"], "en": "His heirs in the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:13.2"], "en": "his own children born of the Dhamma—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:13.3"], "en": "Nanda by name.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:13.4"], "en": "“...she will become a female disciple of the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:14.1"], "en": "Having heard this, she became joyful and,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:14.2"], "en": "for as long as life lasted, [served] the Conqueror then;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:14.3"], "en": "With a mind of loving-kindness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:14.4"], "en": "I served the Guide with the necessary requisites.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:15.1"], "en": "By that well-performed kamma, [I have attained this fruit].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:15.2"], "en": "And through my volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:15.3"], "en": "having cast off this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:15.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:16.1"], "en": "Passing away from there, I went to the Yāma realm;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:16.2"], "en": "from there, I went to Tusita;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:16.3"], "en": "and from there, to Nimmānarati.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:16.4"], "en": "Then [I reached] Vasavattipura.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:17.1"], "en": "Wherever I was reborn,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:17.2"], "en": "by the force of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:17.3"], "en": "In each and every instance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:17.4"], "en": "I served as the chief queen to kings; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:18.1"], "en": "passing away from that human state, I was reborn among humans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:18.2", "PA_thi-ap_25:18.3"], "en": "I served as queen to universal monarchs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:18.4"], "en": "and to regional kings as well.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:19.1", "PA_thi-ap_25:19.2"], "en": "Having experienced prosperity among both gods and humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:19.3"], "en": "and having been happy everywhere,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:19.4"], "en": "I wandered through many eons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:20.1"], "en": "When my final existence was reached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:20.2"], "en": "in the most delightful city called Kapilavatthu;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:20.3"], "en": "I was the blameless daughter of King Suddhodana;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:20.4", "PA_thi-ap_25:21.1"], "en": "seeing me, beautiful in form and endowed with splendor, [he took me as his wife].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:21.2"], "en": "That family was made joyful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:21.3"], "en": "therefore my name was Nanda,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:21.4"], "en": "beautiful and excellent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:22.1"], "en": "And among all the young women,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:22.2", "PA_thi-ap_25:22.3"], "en": "she was renowned as \"the beautiful one\" in that delightful city.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:22.4"], "en": "Except for that Yasodharā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:23.1"], "en": "the eldest brother was the foremost in the three worlds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:23.2"], "en": "and likewise the youngest was an Arhat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:23.3"], "en": "\"I am a householder living alone,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:23.4"], "en": "urged on by my mother:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:24.1"], "en": "'Born into the Sakyan clan,...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:24.2"], "en": "You are a son born after the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:24.3"], "en": "even separated from Nanda,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:24.4"], "en": "why indeed do you remain at home?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:25.1"], "en": "Youth ends in old age;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:25.2"], "en": "beauty is considered impure;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:25.3"], "en": "and even health ends in disease.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:25.4"], "en": "Life ends in death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:26.1"], "en": "This beautiful form of yours,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:26.2"], "en": "so lovely and captivating—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:26.3"], "en": "An ornament among ornaments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:26.4"], "en": "resembling a cluster of *śirīṣa* flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:27.1"], "en": "like a heaped-up essence of the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:27.2"], "en": "An elixir for the eyes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:27.3"], "en": "a generator of merit and fame,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:27.4"], "en": "and a delight to the clan of the Ukkākas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:28.1"], "en": "Before long, O Compassionate One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:28.2"], "en": "old age will overcome you;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:28.3"], "en": "having left the home life, you shall remain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:28.4"], "en": "\"Practice the Dhamma, O blameless one.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:29.1"], "en": "Having heard my mother’s words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:29.2"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:29.3"], "en": "Not by the body, but by the mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:29.4"], "en": "are beauty, youth, and charm [preserved],", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:30.1"], "en": "even with great effort.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:30.2", "PA_thi-ap_25:30.3"], "en": "\"Beyond meditation is my goal,\" said my mother, \"and she tells me to strive for it,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:30.4"], "en": "yet I have no zeal for that.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:31.1"], "en": "Then the Greatly Compassionate One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:31.2"], "en": "seeing me craving for sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:31.3"], "en": "[spoke] for the sake of my disenchantment with form.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:31.4"], "en": "Within the range of my vision, the Jina,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:32.1"], "en": "by his own supernatural power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:32.2"], "en": "conjured up a beautiful woman.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:32.3"], "en": "Beautiful to behold and radiant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:32.4"], "en": "even more lovely than myself—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:33.1"], "en": "seeing her, I was struck with wonder.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:33.2", "PA_thi-ap_25:33.3"], "en": "To her, whose body was filled with great wonder, I thought:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:33.4"], "en": "\"My human gain of eyes has been made fruitful.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:34.1"], "en": "\"Come to me, O fortunate one;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:34.2"], "en": "tell me what you need.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:34.3"], "en": "[Tell me] your family, your name, and your clan.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:34.4"], "en": "Tell me, if it is dear to you:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:35.1"], "en": "this is no time for deception, O fortunate one;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:35.2"], "en": "let me rest upon your lap.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:35.3"], "en": "“My limbs seem to fail me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:35.4", "PA_thi-ap_25:36.1"], "en": "rest for a moment. Then she [pressed] her head against my limbs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:36.2"], "en": "Having done so, the beautiful-eyed woman lay down;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:36.3"], "en": "it fell upon her forehead,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:36.4"], "en": "fierce and most dreadful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:37.1"], "en": "With her falling down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:37.2"], "en": "a carbuncle arose;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:37.3"], "en": "it burst and flowed with pus.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:37.4"], "en": "A corpse with pus and blood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:38.1"], "en": "its mouth split open,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:38.2"], "en": "a putrid-smelling carcass.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:38.3"], "en": "The bloated, the livid,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:38.4"], "en": "and the festering body—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:39.1"], "en": "she has had all her limbs proclaimed [upon them].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:39.2"], "en": "Sighing again and again,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:39.3"], "en": "experiencing her own suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:39.4"], "en": "she lamented piteously.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:40.1"], "en": "“I am afflicted by suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:40.2"], "en": "and painful sensations touch me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:40.3"], "en": "I am submerged in great misery.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:40.4"], "en": "\"Be my refuge, my friend!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:41.1"], "en": "Where is the beauty of your face?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:41.2"], "en": "Where is your high nose?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:41.3", "PA_thi-ap_25:41.4"], "en": "Where has your face gone, with its lips like the finest copper?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:42.1"], "en": "Where has your complexion, resembling the moon, gone?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:42.2"], "en": "Where has that conch-like neck gone?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:42.3"], "en": "Those ears, once swaying like a swing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:42.4"], "en": "have now turned pale.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:43.1"], "en": "Shaped like a cluster of mango blossoms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:43.2"], "en": "with buds for breasts;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:43.3"], "en": "burst open, they are putrid corpses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:43.4"], "en": "She has become foul-smelling;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:44.1"], "en": "with beautiful hips like the middle of a sacrificial altar,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:44.2"], "en": "she is like a slaughterhouse from which the sin has been removed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:44.3"], "en": "Born filled with impurities— oh,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:44.4"], "en": "how transient is this form!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:45.1"], "en": "Everything produced from the body [is likewise].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:45.2"], "en": "Foul-smelling and terrifying,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:45.3"], "en": "as loathsome as a charnel ground—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:45.4"], "en": "yet therein fools take their delight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:46.1", "PA_thi-ap_25:46.2"], "en": "Then my brother, the Greatly Compassionate One, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:46.3"], "en": "seeing that my mind was filled with agitation, said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:46.4"], "en": "He spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:47.1", "PA_thi-ap_25:47.2"], "en": "“Behold, Nandā, this body— a mass of suffering, putrid, and foul.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:47.3"], "en": "Develop the mind through the meditation on the foul,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:47.4", "PA_thi-ap_25:48.1"], "en": "one-pointed and well-concentrated; as this is, so is that.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:48.2"], "en": "As it is so, so is this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:48.3"], "en": "it smells foul and putrid,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:48.4"], "en": "yet it is relished by fools.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:49.1"], "en": "Thus observing this,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:49.2"], "en": "untiring by day and night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:49.3"], "en": "through one's own wisdom, one [should proceed].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:49.4"], "en": "“Having turned away from the world, you will see.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:50.1", "PA_thi-ap_25:50.2"], "en": "Then, having heard these well-spoken verses, I was deeply moved.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:50.3", "PA_thi-ap_25:50.4"], "en": "Established therein, I attained peace and reached arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:51.1"], "en": "Wherever I sat, I remained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:51.2"], "en": "Always devoted to meditation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:51.3", "PA_thi-ap_25:51.4"], "en": "the Victor was pleased with that quality and placed me at the foremost rank.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:52.1"], "en": "The defilements have been incinerated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:52.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:52.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:53.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:53.2", "PA_thi-ap_25:53.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:54.1", "PA_thi-ap_25:54.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:54.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:55.1"], "en": "Thus indeed did the bhikkhunī Nandā, the most beautiful woman in the land, speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_25:56.1"], "en": "This is the fifth legend of the Elder Nun Nandā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
