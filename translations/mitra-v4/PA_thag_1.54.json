[
{"segs": ["PA_thag_1.54:0.1", "PA_thag_1.54:0.2", "PA_thag_1.54:0.3"], "en": "Theragāthā 1.54 Ekakanipāta Chaṭṭhavagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.54:0.4"], "en": "The Verses of the Elder Uttiya:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.54:1.1"], "en": "“The rain-god falls as if to a well-sung song;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.54:1.2"], "en": "my little hut is thatched, pleasant, and sheltered from the wind.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.54:1.3"], "en": "I dwell therein alone;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.54:1.4"], "en": "so, O Deva, rain down if you so desire!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.54:1.5"], "en": "… Thus spoke the Elder Uttiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
