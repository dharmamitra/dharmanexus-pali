{"segs": ["PA_thag_1.95:0.1", "PA_thag_1.95:0.2", "PA_thag_1.95:0.3"], "en": "Theragāthā 1.95 Ekakanipāta Dasamavagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.95:0.4"], "en": "The Verses of the Elder Cakkhupāla:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.95:1.1"], "en": "“I am blind, my eyes destroyed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.95:1.2"], "en": "I have plunged into the middle of a desert wilderness.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.95:1.3"], "en": "“Even alone I shall go;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.95:1.4"], "en": "not with a wicked companion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.95:1.5"], "en": "… Thus spoke the Elder Cakkhupāla.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
