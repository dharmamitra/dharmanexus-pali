[
{"segs": ["PA_mil_3.4.7:0.1"], "en": "The Questions of King Milinda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.4.7:0.2"], "en": "Chapter on Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.4.7:0.3"], "en": "Section 7: The Question on the Sustaining of the Earth", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.4.7:1.1"], "en": "The King said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.4.7:1.2"], "en": "\"Venerable Nāgasena, you say:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.4.7:1.3"], "en": "'This great earth is established upon water; the water is established upon wind; the wind is established upon space. I do not believe this statement either.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.4.7:1.4"], "en": "The Elder, having taken up water in a water-vessel, made this known to King Milinda:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.4.7:1.5"], "en": "\"Just as, Great King, this vessel is supported by the air, so too that water is supported by the air.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.4.7:2.1"], "en": "\"Excellent, venerable Nāgasena!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.4.7:3.1"], "en": "The seventh question: On the Sustaining of the Earth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
