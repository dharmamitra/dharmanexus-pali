[
{"segs": ["PA_tha-ap_332:0.1", "PA_tha-ap_332:0.2", "PA_tha-ap_332:0.3"], "en": "The Apadāna of the Elder Saparivārachattadāyaka, from the Umāpupphiya Chapter, Number Ten.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:1.1"], "en": "“Padumuttara, the Knower of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:1.2"], "en": "the recipient of offerings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:1.3"], "en": "like a shower of water falling from the sky, [he rained down blessings].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:1.4"], "en": "It rains with the rain of Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:2.1", "PA_tha-ap_332:2.2"], "en": "I beheld that Fully Enlightened One as he was teaching the deathless state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:2.3"], "en": "Having gladdened my own heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:2.4"], "en": "I went to my own home,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:3.1"], "en": "taking with me a decorated parasol.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:3.2"], "en": "I approached the Supreme among Men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:3.3"], "en": "joyful with a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:3.4"], "en": "I tossed [the flowers] into the air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:4.1", "PA_tha-ap_332:4.2"], "en": "Like a well-guided vehicle, like a tamed steed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:4.3"], "en": "the supreme disciple approached the Fully Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:4.4"], "en": "He descended and alighted upon his head.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:5.1"], "en": "Compassionate and merciful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:5.2"], "en": "the Buddha, the leader supreme in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:5.3"], "en": "Sitting amidst the community of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:5.4"], "en": "he spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:6.1"], "en": "“By whom this parasol was given— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:6.2"], "en": "Adorned and delightful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:6.3"], "en": "by that clarity of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:6.4"], "en": "he does not go to an evil destination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:7.1", "PA_tha-ap_332:7.2"], "en": "Seven times he will exercise sovereignty among the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:7.3"], "en": "and thirty-two times he will be a king.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:7.4"], "en": "He will become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:8.1"], "en": "In a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:8.2"], "en": "born in the lineage of Okkāka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:8.3", "PA_tha-ap_332:8.4"], "en": "One named Gotama by clan will become a teacher in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:9.1"], "en": "he will be an heir to his teachings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:9.2"], "en": "Born from the heart, fashioned by the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:9.3"], "en": "having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:9.4"], "en": "he shall pass away, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:10.1"], "en": "Having understood the Buddha’s speech,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:10.2"], "en": "uttered with the voice of a bull,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:10.3"], "en": "he was clear-minded and joyful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:10.4"], "en": "I produced even greater joy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:11.1"], "en": "Having abandoned the human womb,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:11.2"], "en": "I attained a divine womb.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:11.3"], "en": "My supreme celestial mansion has risen up,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:11.4"], "en": "enchanting to the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:12.1"], "en": "As I am departing from that mansion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:12.2"], "en": "A white parasol was held over me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:12.3"], "en": "at that time I regained consciousness—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:12.4"], "en": "this is the fruit of my former karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:13.1"], "en": "Having passed away from the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:13.2"], "en": "I came to human birth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:13.3"], "en": "thirty-six times I was a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:13.4"], "en": "After seven hundred eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:14.1"], "en": "having passed away from that body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:14.2"], "en": "I came to the city of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:14.3"], "en": "Having wandered through the cycle of existence in succession,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:14.4"], "en": "I returned once more to the human state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:15.1"], "en": "As I entered my mother’s womb, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:15.2"], "en": "They held up a white parasol;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:15.3"], "en": "at the age of seven,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:15.4"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:16.1"], "en": "A brahmin named Sunanda by name,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:16.2"], "en": "who had mastered the mantras,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:16.3"], "en": "took up a crystal parasol.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:16.4", "PA_tha-ap_332:17.1"], "en": "Then the Great Hero rejoiced in the excellence of his disciple;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:17.2"], "en": "Sāriputta was a great orator.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:17.3"], "en": "Having heard his expression of appreciation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:17.4"], "en": "I recollected my former deed; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:18.1"], "en": "raising my hands in reverent salutation, I said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:18.2"], "en": "I gladdened my own mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:18.3"], "en": "by recollecting my former deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:18.4"], "en": "I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:19.1"], "en": "Rising from that seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:19.2"], "en": "placing his hands together in reverence upon his head,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:19.3"], "en": "he paid homage to the Fully Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:19.4"], "en": "I uttered these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:20.1"], "en": "\"In a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:20.2"], "en": "there shall be a Buddha, unsurpassed in the world.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:20.3"], "en": "Padumuttara, the knower of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:20.4"], "en": "the recipient of offerings—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:21.1"], "en": "unto him a parasol was given by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:21.2"], "en": "Variegated and well-adorned,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:21.3", "PA_tha-ap_332:21.4"], "en": "the Self-Existent One, the Supreme Person, took it up with both hands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:22.1"], "en": "O wonderful are the Buddhas, O wonderful are the Dhammas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:22.2"], "en": "O wonderful is our accomplishment of a Teacher!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:22.3"], "en": "Through the gift of a single parasol, [all have attained the same state].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:22.4"], "en": "I did not fall into an evil rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:23.1"], "en": "My defilements have been incinerated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:23.2"], "en": "all states of existence have been uprooted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:23.3"], "en": "Having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:23.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:24.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:24.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:24.3"], "en": "the Buddha’s teaching has been fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:25.1"], "en": "Thus indeed did the Venerable Elder Chatradāyaka with his retinue speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:26.1"], "en": "The legend of the Elder Saparivārachattadāyaka is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:27.1"], "en": "The thirty-third chapter, the Umāpupphiya-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:28.1"], "en": "Its summary (uddāna) is as follows:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:29.1"], "en": "Umā flower and sand,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:29.2"], "en": "laughter, sacrifice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:29.3"], "en": "a sign-maker; a saṁsāvaka and nigguṇḍī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:29.4"], "en": "The *Sumana-pupphachattaka*,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:29.5"], "en": "the *Saparivāra-chatta*,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_332:29.6"], "en": "and the verses numbering one hundred and seven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
