[
{"segs": ["PA_tha-ap_163:0.1", "PA_tha-ap_163:0.2", "PA_tha-ap_163:0.3"], "en": "The Apadāna of the Elder Supāricariya Supāricariyavagga 1. Supāricariyattheraapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:1.1", "PA_tha-ap_163:1.2"], "en": "“The Lord of bipeds, the Bull among men, named Paduma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:1.3"], "en": "having gone forth from the forest,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:1.4"], "en": "The Visionary teaches the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:2.1"], "en": "It was the time of the yakkhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:2.2"], "en": "not far from the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:2.3"], "en": "Having accomplished whatever task was required,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:2.4"], "en": "they waited for a moment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:3.1"], "en": "having understood the Buddha’s speech.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:3.2"], "en": "And the teaching on the Deathless;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:3.3"], "en": "with a clear mind and joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:3.4"], "en": "I stood nearby, clapping my hands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:4.1"], "en": "Behold the fruit of what was well-performed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:4.2", "PA_tha-ap_163:4.3"], "en": "the service rendered to the Teacher throughout thirty thousand aeons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:4.4"], "en": "I did not fall into an evil rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:5.1"], "en": "In the twenty-fifth hundredth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:5.2"], "en": "one named Samalaṅkata;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:5.3"], "en": "Endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:5.4"], "en": "a wheel-turning monarch of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:6.1"], "en": "[I possess] the four analytical knowledges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:6.2", "PA_tha-ap_163:6.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:6.4"], "en": "the Buddha’s teaching has been accomplished.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:7.1"], "en": "Thus indeed the venerable elder Supāricariya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_163:8.1"], "en": "This is the first legend of the elder Supāricariya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
