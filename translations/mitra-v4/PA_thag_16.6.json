[
{"segs": ["PA_thag_16.6:0.1", "PA_thag_16.6:0.2", "PA_thag_16.6:0.3"], "en": "Theragāthā 16.6 Vīsatinipāta Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:0.4"], "en": "From the Theragāthā of Sela:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:1.1"], "en": "“With a perfect body, radiant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:1.2"], "en": "well-born, and beautiful to behold;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:1.3"], "en": "The Blessed One is golden-hued,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:1.4"], "en": "with very white teeth and great vigor;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:2.1"], "en": "for such is one who is well-born.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:2.2", "PA_thag_16.6:2.3"], "en": "All those marks that exist as signs are present upon your body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:2.4"], "en": "O Great Man.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:3.1"], "en": "With serene eyes and a pleasant face, tall,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:3.2"], "en": "upright, and majestic,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:3.3"], "en": "he stood in the midst of the community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:3.4"], "en": "Like the sun you shine forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:4.1"], "en": "O monk of auspicious appearance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:4.2"], "en": "your skin is like gold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:4.3"], "en": "\"What use is this ascetic life to you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:4.4"], "en": "who possess such a supreme complexion?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:5.1"], "en": "You ought to be a king.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:5.2"], "en": "A wheel-turning monarch, a bull among charioteers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:5.3"], "en": "victorious over the four quarters,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:5.4"], "en": "the lord of the Jambusaṇḍa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:6.1", "PA_thag_16.6:6.2"], "en": "Kṣatriyas, wealthy men, and kings become their followers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:6.3"], "en": "they are kings among kings, lords of men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:6.4"], "en": "\"Exercise sovereignty, Gotama!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:7.1", "PA_thag_16.6:7.2"], "en": "\"I am a king, Sela,\" [said the Blessed One]. (Sela, said the Blessed One.)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:7.3"], "en": "I am the unsurpassed King of Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:7.4"], "en": "by means of the Dhamma I turn the wheel,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:7.5"], "en": "a wheel that cannot be turned back.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:8.1", "PA_thag_16.6:8.2"], "en": "“You claim to be a perfectly awakened one,” said the brahmin Sela,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:8.3"], "en": "“a supreme King of Dharma.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:8.4"], "en": "\"I turn the wheel in accordance with the Dhamma\"—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:8.5", "PA_thag_16.6:9.1"], "en": "thus you say, Gotama. Who, then, is your general?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:9.2", "PA_thag_16.6:9.3"], "en": "A disciple following in the Teacher’s footsteps—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:9.4"], "en": "who is it that turns the Wheel of Dhamma set in motion by you?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:10.1"], "en": "“The wheel has been set in motion by me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:10.2"], "en": "O Sela,” said the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:10.3"], "en": "“the unsurpassed Wheel of Dhamma.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:10.4", "PA_thag_16.6:10.5"], "en": "Sāriputta follows in accordance with the Tathāgata, having been born after him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:11.1"], "en": "he has directly known that which is to be directly known.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:11.2"], "en": "What was to be developed has been developed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:11.3"], "en": "what was to be abandoned has been abandoned by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:11.4"], "en": "Therefore, O Brahmin, I am a Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:12.1"], "en": "Dispel your doubt regarding me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:12.2"], "en": "O brahmin, and have full conviction;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:12.3"], "en": "for a sight such as this is difficult to obtain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:12.4"], "en": "Of the perfectly awakened Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:13.1", "PA_thag_16.6:13.2"], "en": "whose manifestation in the world is indeed rare and does not occur frequently.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:13.3"], "en": "Therefore, O brahmin, I am the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:13.4"], "en": "the unsurpassed surgeon;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:14.1"], "en": "I have become the Brahman, the peerless one.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:14.2"], "en": "The crusher of Māra’s army;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:14.3"], "en": "having brought all enemies under my control,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:14.4"], "en": "I rejoice, free from fear from any quarter.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:15.1", "PA_thag_16.6:15.2"], "en": "“Listen, sirs, to this as the One with Vision speaks:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:15.3"], "en": "the Great Hero, the Surgeon.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:15.4"], "en": "Like a lion roaring in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:16.1"], "en": "he is become Brahman, incomparable,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:16.2"], "en": "the crusher of Māra’s army.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:16.3", "PA_thag_16.6:16.4"], "en": "Who, even if born of a dark lineage, would not feel confidence upon seeing me?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:17.1"], "en": "Let whoever desires me follow after me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:17.2"], "en": "Or whoever wishes may go;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:17.3", "PA_thag_16.6:17.4"], "en": "here I shall go forth into homelessness in the presence of the one of supreme wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:18.1", "PA_thag_16.6:18.2"], "en": "“If this teaching of the Perfectly Enlightened One is pleasing to you, sir,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:18.3"], "en": "we too shall go forth.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:18.4"], "en": "\"In the presence of the one of excellent wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:19.1"], "en": "\"These three hundred brahmins,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:19.2"], "en": "with palms joined in reverence, are making this request:\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:19.3"], "en": "“We shall lead the holy life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:19.4"], "en": "Blessed One, in your presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:20.1"], "en": "“The holy life is well-proclaimed;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:20.2"], "en": "(The Blessed One said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:20.3"], "en": "\"It is visible here and now, not subject to time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:20.4"], "en": "therein renunciation is never in vain.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:20.5"], "en": "\"For one who trains with diligence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:21.1"], "en": "\"That refuge to which we have come,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:21.2"], "en": "O Eyeful One, eight years ago from now;\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:21.3", "PA_thag_16.6:21.4"], "en": "In seven nights, O Blessed One, we have been tamed under your teaching.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:22.1"], "en": "You are the Buddha; you are the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:22.2"], "en": "You are the Sage, the conqueror of Māra;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:22.3"], "en": "having severed the underlying tendencies,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:22.4"], "en": "you have crossed over and are now able to ferry this generation across.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:23.1"], "en": "The acquisitions have been transcended by you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:23.2"], "en": "the taints have been shattered by you;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:23.3"], "en": "like a lion, you are free from clinging.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:23.4", "PA_thag_16.6:24.1"], "en": "These three hundred bhikkhus, having abandoned fear and terror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:24.2"], "en": "stand with their hands joined in reverent salutation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:24.3"], "en": "“O Hero, stretch out your feet;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:24.4"], "en": "let the Nāgas pay homage to the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_16.6:24.5"], "en": "… [Thus spoke] the Elder Sela.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
