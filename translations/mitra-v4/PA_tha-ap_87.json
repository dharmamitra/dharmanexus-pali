[
{"segs": ["PA_tha-ap_87:0.1", "PA_tha-ap_87:0.2"], "en": "The Apadāna of the Elder Raṁsisaññaka Timiravagga 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:0.3"], "en": "The Apadāna of the Elder Raṁsisaññaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:1.1", "PA_tha-ap_87:1.2"], "en": "“In the past, I made my dwelling on the Himavat mountain;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:1.3"], "en": "I was one who wore deerskins as upper garments.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:1.4"], "en": "I dwell within the mountains.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:2.1", "PA_tha-ap_87:2.2"], "en": "I see the Sambuddha, golden-hued like the thousand-rayed sun.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:2.3", "PA_tha-ap_87:2.4"], "en": "Seeing him entered into the forest like a blossoming king of sal trees,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:3.1"], "en": "she delighted her heart and inspired confidence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:3.2"], "en": "To Vipassi, the Great Seer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:3.3"], "en": "I joined my palms in reverence and worshipped him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:3.4"], "en": "prostrating with my head upon the ground.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:4.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:4.2"], "en": "because of the deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:4.3"], "en": "I do not know a state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:4.4"], "en": "This is the fruit of the perception of radiance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:5.1", "PA_tha-ap_87:5.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:5.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:6.1"], "en": "Thus indeed did the venerable elder Raṁsisaññaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_87:7.1"], "en": "This is the fifth legend of the elder Raṁsisaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
