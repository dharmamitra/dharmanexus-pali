[
{"segs": ["PA_thi-ap_37:0.1", "PA_thi-ap_37:0.2"], "en": "The Therī-apadāna, Chapter on the Kṣatriyas, No. 7:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:0.3"], "en": "The Apadāna of the Elder Nun Aḍḍhakāsī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:1.1"], "en": "“In this auspicious eon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:1.2"], "en": "a kinsman of Brahmā of great renown,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:1.3"], "en": "Kassapa by clan— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:1.4"], "en": "The best among those who speak arose.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:2.1", "PA_thi-ap_37:2.2"], "en": "Then, having gone forth in the teaching of that Buddha, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:2.3", "PA_thi-ap_37:2.4"], "en": "Restrained in the Pātimokkha and in the five sense faculties,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:3.1"], "en": "and knowing the proper measure in eating,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:3.2"], "en": "And being devoted to wakefulness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:3.3"], "en": "I dwell engaged in yoga,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:3.4"], "en": "[honoring] the nun who is free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:4.1"], "en": "With a wicked mind, I reviled her,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:4.2"], "en": "calling her a courtesan at that time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:4.3"], "en": "by that evil deed, I am now tormented.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:4.4"], "en": "In hell, I suffered the torments of the cauldron.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:5.1"], "en": "By the remainder of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:5.2"], "en": "I was born into a family of courtesans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:5.3", "PA_thi-ap_37:5.4"], "en": "In my final birth, I was largely dependent on others;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:6.1"], "en": "born into a merchant family in Kāsī, I was of noble lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:6.2"], "en": "By the power of my practice of celibacy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:6.3", "PA_thi-ap_37:6.4"], "en": "I possessed a perfection of form like that of the goddesses among the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:7.1"], "en": "Having seen me, so worthy of being beheld,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:7.2"], "en": "in that most excellent city of Giribbaja,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:7.3"], "en": "they established me in the profession of a courtesan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:7.4"], "en": "By the power of my rebuking him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:8.1", "PA_thi-ap_37:8.2"], "en": "I, having heard the true Dhamma taught by the Best of Buddhas, [attained realization].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:8.3"], "en": "Endowed with the impressions of former lives,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:8.4", "PA_thi-ap_37:9.1"], "en": "I went forth into the homeless state for the sake of attaining that very goal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:9.2"], "en": "Going into the presence of the Victor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:9.3"], "en": "and hearing that rogues were stationed on the road,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:9.4"], "en": "I received the higher ordination as a messenger.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:10.1"], "en": "All karma is completely exhausted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:10.2"], "en": "both merit and likewise evil;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:10.3"], "en": "they have crossed over the entire cycle of existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:10.4"], "en": "And my status as a courtesan was cast aside.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:11.1"], "en": "I have mastery over the supernormal powers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:11.2"], "en": "and with the divine ear-element;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:11.3", "PA_thi-ap_37:11.4"], "en": "O Great Sage, I have mastery over the knowledge of the minds of others;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:12.1"], "en": "I know my former births.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:12.2"], "en": "The divine eye has been purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:12.3"], "en": "all taints are utterly exhausted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:12.4"], "en": "there is now no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:13.1", "PA_thi-ap_37:13.2", "PA_thi-ap_37:13.3"], "en": "O Great Hero, my knowledge regarding the meanings, the phenomena, the etymologies, and likewise regarding inspired eloquence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:13.4"], "en": "Has arisen in your presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:14.1"], "en": "The defilements have been incinerated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:14.2"], "en": "…pe…", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:14.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:15.1", "PA_thi-ap_37:15.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:15.3"], "en": "Such is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:16.1", "PA_thi-ap_37:16.2"], "en": "the four analytical knowledges, and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:16.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:17.1"], "en": "Thus indeed did the bhikkhunī Aḍḍhakāsī speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_37:18.1"], "en": "This is the seventh legend of the elder nun Aḍḍhakāsī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
