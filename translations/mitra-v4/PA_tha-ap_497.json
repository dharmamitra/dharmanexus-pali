[
{"segs": ["PA_tha-ap_497:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:0.2"], "en": "The Chapter on the Kiṅkaṇī Flower, 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:0.3"], "en": "The Apadāna of the Elder Upaḍḍhadussadāyaka (The Giver of Half a Robe)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:1.1"], "en": "“Under the Blessed One Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:1.2"], "en": "there was a disciple named Sujāta;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:1.3"], "en": "while searching for a rag-robe, he— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:1.4", "PA_tha-ap_497:2.1"], "en": "At that time, I was wandering through the refuse heaps in the city of Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:2.2"], "en": "a hired servant for others.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:2.3"], "en": "Having given half a garment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:2.4"], "en": "I paid homage with my head.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:3.1"], "en": "By that well-performed deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:3.2"], "en": "And through my volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:3.3"], "en": "having cast off this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:3.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:4.1", "PA_tha-ap_497:4.2"], "en": "Thirty-three times I exercised the sovereignty of the gods as Lord of Devas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:4.3"], "en": "and seventy-seven times—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:4.4"], "en": "I was a universal monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:5.1"], "en": "My regional sovereignty was vast,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:5.2"], "en": "beyond all calculation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:5.3"], "en": "By the gift of half a cloth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:5.4"], "en": "I rejoice, free from fear from any quarter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:6.1"], "en": "Even if I so desired today, [I would not wish for more].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:6.2"], "en": "Together with its forests and mountains;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:6.3"], "en": "I would cover it with linen cloths—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:6.4"], "en": "this is the fruit of that half-cloth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:7.1"], "en": "In a hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:7.2"], "en": "because of the gift I gave then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:7.3"], "en": "I have never known a miserable rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:7.4"], "en": "This is the fruit of half a cloth:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:8.1", "PA_tha-ap_497:8.2"], "en": "my defilements have been burnt away... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:8.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:9.1", "PA_tha-ap_497:9.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:9.3"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:10.1", "PA_tha-ap_497:10.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:10.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:11.1"], "en": "Thus indeed did the venerable elder Upaḍḍhadussadāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_497:12.1"], "en": "This is the fifth legend of the elder Upaḍḍhadussadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
