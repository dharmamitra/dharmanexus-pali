[
{"segs": ["PA_ja_194:0.1", "PA_ja_194:0.2"], "en": "Jātaka: The Second Book of Birth Stories (Dukanipāta),", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_194:0.3"], "en": "Chapter on Ruhaka (Ruhakavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_194:0.4"], "en": "4. The Maṇicora Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_194:1.1"], "en": "“The gods do not exist; they have surely departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_194:1.2"], "en": "Indeed, the guardians of the world do not exist here.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_194:1.3"], "en": "\"For those who act impulsively and are unrestrained,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_194:1.4"], "en": "surely there are no restrainers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_194:2.1"], "en": "\"It rains for him at the wrong time,\" [he said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_194:2.2"], "en": "It does not rain for him at the proper time;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_194:2.3"], "en": "he falls from his place in heaven—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_194:2.4"], "en": "has he not been ruined by that much?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_194:3.1"], "en": "The Maṇicora Jātaka, the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
