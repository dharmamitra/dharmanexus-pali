[
{"segs": ["PA_ja_306:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:0.2", "PA_ja_306:0.3"], "en": "Catukkanipāta, Kāliṅgavagga (The Chapter on Kāliṅga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:0.4", "PA_ja_306:1.1"], "en": "6. The Sujātājātaka “O King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:1.2"], "en": "what are these beans placed here in the bronze bowl?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:1.3"], "en": "“Slightly reddish and lovely;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:1.4"], "en": "tell me that, when asked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:2.1"], "en": "“Those which you formerly [had], O Queen...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:2.2"], "en": "Bhaṇḍu was clothed in rags;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:2.3"], "en": "with hands held out,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:2.4"], "en": "you gathered for him the kola fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:3.1"], "en": "He flies away and finds no delight;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:3.2"], "en": "wealth abandons him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:3.3"], "en": "Right there you should lead him back.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:3.4"], "en": "\"Where she will cook the jujube fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:4.1"], "en": "\"These things, O Great King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:4.2"], "en": "happen to a woman who has attained supernormal power.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:4.3"], "en": "\"Forgive me, O god, for Sujātā;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:4.4"], "en": "do not be angry with her, O bull among charioteers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_306:5.1"], "en": "The Sujātā Jātaka, the sixth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
