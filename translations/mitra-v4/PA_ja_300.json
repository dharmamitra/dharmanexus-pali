[
{"segs": ["PA_ja_300:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:0.2"], "en": "Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:0.3"], "en": "Kumbhavagga", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:0.4"], "en": "10. The Vakajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:1.1", "PA_ja_300:1.2"], "en": "“Living by the deprivation of the lives of others, feeding on flesh and blood;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:1.3"], "en": "Vaka, having undertaken the vow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:1.4"], "en": "was reborn on the Uposatha day.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:2.1"], "en": "Sakka, knowing his vow, [honored him].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:2.2", "PA_ja_300:2.3"], "en": "He approached in the form of an old man; having transcended asceticism and attained the inner state,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:2.4"], "en": "he broke the asceticism of the blood-drinker.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:3.1"], "en": "In the same way,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:3.2", "PA_ja_300:3.3"], "en": "some here who are weak in their undertaking make light of themselves.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:3.4"], "en": "“Vaka spoke without cause.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:4.1"], "en": "Thus ends the tenth Jātaka, the Vaka-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:4.2"], "en": "This is the fifth chapter, the Kumbha-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:5.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:6.1"], "en": "Varakumbha, Supatta, Sirivhayana,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:6.2"], "en": "Sucisammata, Bindusara, and Cusabha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:6.3"], "en": "And by Saritampati, Caṇḍī, Jarākapinā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:6.4", "PA_ja_300:7.1"], "en": "then by Makkaṭiyā and Vakaka— ten [cases]. Now, the summary of the sections (vagguddāna):", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:8.1", "PA_ja_300:8.2"], "en": "The lotus, the well, and thirdly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:8.3"], "en": "the interior; the breaking of the jar.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_300:8.4", "PA_ja_300:9.1"], "en": "The section compiled from the Tika-nipāta is finished. The Tika-nipāta is completed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
