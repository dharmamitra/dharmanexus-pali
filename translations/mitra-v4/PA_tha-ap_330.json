[
{"segs": ["PA_tha-ap_330:0.1"], "en": "The Elder’s Apadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:0.2"], "en": "The Chapter on the Umā Flower, No.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:0.3"], "en": "8: The Apadāna of the Elder Sumanāveḷiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:1.1"], "en": "“Of the Blessed One Vessabhu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:1.2"], "en": "the World’s Best, the Neutral One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:1.3"], "en": "all people having gathered together,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:1.4"], "en": "They perform a great worship:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:2.1", "PA_tha-ap_330:2.2"], "en": "having fashioned a ball of white plaster and a garland of jasmine flowers, they offer it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:2.3", "PA_tha-ap_330:2.4"], "en": "I then placed it before the lion throne;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:3.1"], "en": "all the people having gathered together,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:3.2"], "en": "They behold the most excellent flower;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:3.3", "PA_tha-ap_330:3.4"], "en": "by whom was this flower offered in worship to the Buddha, the Best, the Tathāgata?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:4.1"], "en": "Through that clarity of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:4.2"], "en": "I was reborn in a celestial realm;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:4.3"], "en": "I experience my own karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:4.4"], "en": "Whatever birth I take on—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:5.1", "PA_tha-ap_330:5.2"], "en": "whether among the gods or as a human— it is due to my own well-performed deeds in the past.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:5.3"], "en": "I am beloved by all;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:5.4"], "en": "this is the fruit of my flower-offering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:6.1"], "en": "I do not recall ever having [acted] with the body...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:6.2"], "en": "With words and with a mind full of malice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:6.3", "PA_tha-ap_330:6.4"], "en": "I have reviled those who are self-restrained and devoted to asceticism.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:7.1", "PA_tha-ap_330:7.2"], "en": "By that well-performed conduct and by my aspirations of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:7.3"], "en": "may I be honored by all.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:7.4"], "en": "This is the fruit of verbal abuse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:8.1"], "en": "eleven aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:8.2"], "en": "you were a kshatriya king named Sahassa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:8.3"], "en": "Endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:8.4"], "en": "a wheel-turning monarch of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:9.1"], "en": "the four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:9.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:9.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:10.1"], "en": "Thus indeed did the Elder Thera Sumanāveḷiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_330:11.1"], "en": "The legend of the Elder Sumanāveḷiya is the eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
