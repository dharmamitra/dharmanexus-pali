[
{"segs": ["PA_thag_1.93:0.1", "PA_thag_1.93:0.2", "PA_thag_1.93:0.3"], "en": "Theragāthā 1.93 Ekakanipāta Dasamavagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.93:0.4"], "en": "The Verses of the Elder Eraka:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.93:1.1"], "en": "“Sensual pleasures are suffering, Eraka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.93:1.2"], "en": "sensual pleasures are not happiness, Eraka.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.93:1.3"], "en": "He who desires sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.93:1.4"], "en": "Eraka, he desires suffering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.93:1.5"], "en": "he who does not desire sensual pleasures—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.93:1.6"], "en": "“He does not desire suffering, like an *eraka* grass.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.93:1.7"], "en": "… [Thus spoke] the Elder Eraka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
