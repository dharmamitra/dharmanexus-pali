[
{"segs": ["PA_ja_407:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:0.2"], "en": "The Section of Sevens,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:0.3"], "en": "Chapter on Gandhāra", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:0.4"], "en": "2. The Mahākapi Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:1.1", "PA_ja_407:1.2"], "en": "“He who, making himself a bridge, safely carried others across;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:1.3", "PA_ja_407:1.4"], "en": "\"What do you have to do with them, and what do they have to do with you, O great monkey?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:2.1"], "en": "\"I am their king and their lord.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:2.2"], "en": "He was the protector of the herd;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:2.3", "PA_ja_407:2.4"], "en": "O subduer of enemies, he [was there] for them who were overcome by grief and terrified.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:3.1"], "en": "Having leaped over himself,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:3.2", "PA_ja_407:3.3"], "en": "with his bow cast aside, he then [leaped] over another hundred paces.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:3.4"], "en": "A strong binding of creepers and vines—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:4.1"], "en": "driven by the wind like a cloud torn asunder—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:4.2"], "en": "I approached the tree.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:4.3"], "en": "Then, being of little strength there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:4.4"], "en": "I grasped a branch with my hands;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:5.1"], "en": "while I was thus stretched out, [he spoke].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:5.2"], "en": "To the branches and to the creepers;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:5.3"], "en": "as they moved along on foot,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:5.4"], "en": "the deer went safely to the branches.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:6.1"], "en": "That bond does not burn me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:6.2", "PA_ja_407:6.3"], "en": "once dead, it will not burn me; for them, it is well-earned happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:6.4"], "en": "\"Under whose rule I exercised sovereignty—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:7.1"], "en": "this is the simile for you, O King;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:7.2"], "en": "listen to it, O subduer of enemies.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:7.3"], "en": "A king should seek the welfare of the kingdom,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:7.4"], "en": "the army, and the towns;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:7.5"], "en": "indeed, he should desire the happiness of all.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:7.6"], "en": "“By a wise kshatriya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_407:8.1"], "en": "Thus ends the second Jātaka, the Mahākapi-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
