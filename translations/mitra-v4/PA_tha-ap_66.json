[
{"segs": ["PA_tha-ap_66:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:0.2", "PA_tha-ap_66:0.3"], "en": "The Section on Those Who Contemplated Themselves (Sakacintaniyavagga) 4. The Apadāna of the Elder Parappasādaka (He Who Inspires Faith in Others)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:1.1"], "en": "“The bull, the preeminent one, the hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:1.2"], "en": "the great seer who has conquered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:1.3"], "en": "the golden-hued, perfectly awakened one.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:1.4"], "en": "Who, having seen this, would not have faith?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:2.1", "PA_tha-ap_66:2.2"], "en": "It is as immeasurable as the Himalayas and as difficult to cross as the ocean.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:2.3", "PA_tha-ap_66:2.4"], "en": "In the same way, who that has seen the meditation of the Buddha would not have faith?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:3.1"], "en": "Just as the earth is immeasurable, so too is his wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:3.2"], "en": "The mind is the forest garland of the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:3.3", "PA_tha-ap_66:3.4"], "en": "likewise, who would not have faith upon seeing his virtue?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:4.1"], "en": "Unperturbed by the force of the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:4.2"], "en": "as space is incalculable,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:4.3"], "en": "so too is the knowledge of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:4.4"], "en": "Who, having seen these, would not have faith?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:5.1"], "en": "By means of these four verses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:5.2"], "en": "the brahmin named Sena—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:5.3"], "en": "Having praised the Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:5.4"], "en": "Siddhattha, the Unconquered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:6.1"], "en": "for ninety-four eons—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:6.2"], "en": "You did not fall into an evil rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:6.3", "PA_tha-ap_66:6.4"], "en": "you experienced a happy destination and abundant, great success.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:7.1", "PA_tha-ap_66:7.2"], "en": "Having established the Leader of the World ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:7.3"], "en": "I have not known a state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:7.4"], "en": "This is the fruit of praising [the Buddha].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:8.1"], "en": "In the fourteenth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:8.2"], "en": "there were four who had risen high.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:8.3"], "en": "Possessing the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:8.4"], "en": "they are wheel-turning monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:9.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:9.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:9.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:10.1"], "en": "Thus indeed did the Venerable Elder Parappasādaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_66:11.1"], "en": "The legend of the Elder Parappasādaka is the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
