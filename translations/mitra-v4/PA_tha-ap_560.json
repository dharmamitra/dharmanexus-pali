[
{"segs": ["PA_tha-ap_560:0.1", "PA_tha-ap_560:0.2", "PA_tha-ap_560:0.3"], "en": "The Apadāna of the Elder Bhaddajita Yasavagga 8. Bhaddajittheraapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:1.1", "PA_tha-ap_560:1.2"], "en": "Having plunged into a lotus pond frequented by various elephants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:1.3"], "en": "I pull up a lotus root from there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:1.4", "PA_tha-ap_560:2.1"], "en": "At that time, for the sake of grass, the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:2.2"], "en": "known by the name Padumuttara, was there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:2.3", "PA_tha-ap_560:2.4"], "en": "Clad in saffron robes, the Buddha walks with the swiftness of the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:3.1"], "en": "shaking off the dust from his rag-robe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:3.2"], "en": "I heard that sound at that time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:3.3"], "en": "looking upwards,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:3.4"], "en": "I saw the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:4.1"], "en": "Standing right there, being peaceful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:4.2"], "en": "I entreated the Leader of the World:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:4.3"], "en": "\"Honey together with lotus roots— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:4.4"], "en": "“Milk, ghee, and lotus roots—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:5.1", "PA_tha-ap_560:5.2"], "en": "may the Buddha, the One with Vision, accept them from me out of compassion.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:5.3"], "en": "Then the compassionate Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:5.4"], "en": "of great renown, having descended,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:6.1"], "en": "accepted my alms-food.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:6.2"], "en": "Out of compassion, the Visionary One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:6.3"], "en": "the Fully Awakened One, having accepted [the offering],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:6.4"], "en": "bestowed upon me a blessing of appreciation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:7.1"], "en": "\"May you be happy, O one of great merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:7.2"], "en": "may your destiny be fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:7.3"], "en": "by this gift of a lotus root,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:7.4"], "en": "\"May you obtain abundant happiness!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:8.1"], "en": "Having said this, the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:8.2"], "en": "whose name is the Supreme among those with lotus-like eyes;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:8.3"], "en": "Having taken alms, the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:8.4"], "en": "the Victor, came through the air; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:9.1"], "en": "having taken the lotus root, he departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:9.2"], "en": "I came to my hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:9.3"], "en": "having hung the lotus root upon a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:9.4"], "en": "I recollected my gift.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:10.1"], "en": "A great wind having arisen,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:10.2"], "en": "it then shook the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:10.3"], "en": "the sky resounded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:10.4"], "en": "Then there was thunder and lightning.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:11.1", "PA_tha-ap_560:11.2"], "en": "Thereupon, a stroke of lightning fell upon my head.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:11.3"], "en": "While sitting there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:11.4", "PA_tha-ap_560:12.1"], "en": "I passed away; bound by my meritorious deed, I was reborn.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:12.2"], "en": "I was reborn in Tusita;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:12.3"], "en": "my physical body having fallen away,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:12.4"], "en": "I delight in the world of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:13.1"], "en": "Sixty-four thousand women,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:13.2"], "en": "beautifully adorned,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:13.3"], "en": "attend upon him morning and evening.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:13.4"], "en": "This is the fruit of giving medicine:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:14.1"], "en": "having come to a human birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:14.2"], "en": "I was then happy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:14.3"], "en": "My enjoyments are not deficient;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:14.4"], "en": "this is the fruit of giving lotus roots.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:15.1"], "en": "I have been shown compassion by him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:15.2"], "en": "By the God of Gods, the Tathāgata;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:15.3"], "en": "all taints are utterly exhausted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:15.4"], "en": "and now there is no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:16.1"], "en": "In a hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:16.2"], "en": "because I gave that lotus root at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:16.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:16.4"], "en": "This is the fruit of giving medicine.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:17.1", "PA_tha-ap_560:17.2"], "en": "The defilements have been incinerated by me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:17.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:18.1", "PA_tha-ap_560:18.2"], "en": "Welcome indeed has come to me... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:18.3"], "en": "The Buddha’s teaching has been proclaimed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:19.1", "PA_tha-ap_560:19.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:19.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:20.1"], "en": "Thus indeed did the Venerable Elder Bhaddajita speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_560:21.1"], "en": "This is the eighth legend of the Elder Bhaddajita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
