[
{"segs": ["PA_cp_4:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:0.2"], "en": "Akittivagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:0.3"], "en": "Dānapāramī 4", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:0.4"], "en": "The Life Story of Mahāsudassana:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:1.1", "PA_cp_4:1.2"], "en": "“When I was the lord of the earth in the city of Kusāvatī;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:1.3", "PA_cp_4:1.4"], "en": "There was a wheel-turning monarch named Mahāsudassana, possessed of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:2.1"], "en": "There, I would [go] three times each day—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:2.2"], "en": "I had proclamations made here and there:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:2.3"], "en": "\"Who desires what? What does each one long for?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:2.4"], "en": "To whom shall wealth be given?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:3.1"], "en": "Who is hungry? Who is thirsty?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:3.2"], "en": "Who desires garlands? Who desires ointments?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:3.3"], "en": "[Who desires] garments of various colors?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:3.4"], "en": "Who will clothe the naked?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:4.1"], "en": "Who takes an umbrella on the road?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:4.2"], "en": "Who has soft, beautiful sandals?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:4.3"], "en": "Thus, evening and morning,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:4.4"], "en": "I have had it proclaimed here and there:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:5.1"], "en": "\"In ten respects, he is not [a true monk].\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:5.2"], "en": "Nor in hundreds of places;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:5.3"], "en": "in many hundreds of locations,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:5.4"], "en": "wealth was prepared for the sake of supplicants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:6.1"], "en": "Whether by day or by night,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:6.2"], "en": "if a mendicant comes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:6.3"], "en": "having obtained whatever wealth he desires,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:6.4"], "en": "He went along with his hands full of offerings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:7.1", "PA_cp_4:7.2"], "en": "Such a great gift as this I gave for as long as I lived.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:7.3"], "en": "I do not give wealth that should be given away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:7.4"], "en": "nor is there any store of it with me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:8.1"], "en": "just as one who is called \"afflicted,\"...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:8.2"], "en": "For the sake of liberation from disease:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:8.3"], "en": "by satisfying a physician with wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:8.4"], "en": "one is liberated from disease.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:9.1"], "en": "In the same way, knowing this,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:9.2"], "en": "in order to fulfill it without remainder,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:9.3"], "en": "and to complete what was deficient—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:9.4"], "en": "I gave half as alms to the mendicants;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:9.5"], "en": "free from attachment and without expectation,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:9.6"], "en": "I have attained full enlightenment.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_4:10.1"], "en": "The Fourth: The Life Story of Mahāsudassana.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
