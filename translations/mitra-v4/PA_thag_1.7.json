[
{"segs": ["PA_thag_1.7:0.1", "PA_thag_1.7:0.2", "PA_thag_1.7:0.3"], "en": "Theragāthā 1.7 Ekakanipāta Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.7:0.4"], "en": "The Verse of the Elder Bhalliya:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.7:1.1"], "en": "“He who has driven back the army of the King of Death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.7:1.2"], "en": "as a great flood sweeps away a frail reed-bridge;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.7:1.3"], "en": "“Vijitāvī, free from fear,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.7:1.4"], "en": "tamed, he has attained final nibbāna, established in himself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.7:1.5"], "en": "Thus indeed did the venerable elder Bhalliya speak this verse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
