[
{"segs": ["PA_ja_473:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:0.2"], "en": "The Twelfth Chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:0.3"], "en": "The Minor Section on Kuṇāla.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:0.4", "PA_ja_473:1.1"], "en": "10. The Mittāmitta Jātaka “What kinds of deeds should one perform,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:1.2"], "en": "and how should a wise person exert himself?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:1.3", "PA_ja_473:1.4"], "en": "\"A wise person should recognize an enemy by seeing and hearing him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:2.1"], "en": "for a learned one does not smile upon seeing him.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:2.2"], "en": "Nor does he greet him in return;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:2.3", "PA_ja_473:2.4"], "en": "he does not give him his attention and behaves with hostility toward him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:3.1", "PA_ja_473:3.2"], "en": "He associates with his enemies and does not serve his friends;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:3.3"], "en": "he restrains those who wish him well.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:3.4"], "en": "He praises one who reviles him;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:4.1"], "en": "he does not disclose his secrets,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:4.2"], "en": "nor does he conceal the other's secrets.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:4.3", "PA_ja_473:4.4"], "en": "Kamma does not commend him; he does not praise wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:5.1"], "en": "He delights in non-existence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:5.2"], "en": "He does not delight in existence;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:5.3"], "en": "even upon obtaining exquisite food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:5.4"], "en": "no craving arises in him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:5.5"], "en": "Therefore, one feels compassion for them,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:5.6"], "en": "thinking, \"Oh, may they too obtain this!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:6.1"], "en": "Thus are these sixteen aspects.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:6.2"], "en": "They are established among enemies;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:6.3", "PA_ja_473:6.4"], "en": "by these signs, a wise person should recognize an enemy, both upon seeing and hearing them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:7.1"], "en": "“What deeds should one perform,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:7.2"], "en": "and how should a wise person exert themselves?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:7.3"], "en": "How should an intelligent person recognize a friend?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:7.4"], "en": "Having seen and heard it,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:8.1", "PA_ja_473:8.2"], "en": "the wise person remembers what was sent away and rejoices upon its arrival.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:8.3", "PA_ja_473:8.4"], "en": "Then he becomes cherished and responds with words;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:9.1"], "en": "he associates only with those who are his friends.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:9.2"], "en": "He does not associate with those who are his enemies;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:9.3"], "en": "he restrains those who revile him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:9.4"], "en": "and he praises those who desire his welfare.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:10.1"], "en": "He reveals his secrets to him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:10.2"], "en": "and he keeps his secrets hidden;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:10.3"], "en": "he praises his deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:10.4"], "en": "One praises his wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:11.1"], "en": "He delights in existence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:11.2"], "en": "yet he does not delight in non-existence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:11.3"], "en": "Having obtained a wonderful meal,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:11.4"], "en": "mindfulness arises in him;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:11.5"], "en": "thereafter, he feels compassion for it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:11.6"], "en": "\"O, may he too obtain this!\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:12.1", "PA_ja_473:12.2"], "en": "thus these sixteen aspects are well-established in a friend.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:12.3", "PA_ja_473:12.4"], "en": "\"By seeing and by hearing, the wise man should thus recognize his friends.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:13.1"], "en": "The *Mittāmitta-jātaka*, the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:14.1"], "en": "The Twelfth Chapter is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:15.1"], "en": "Its summary verse is:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:16.1"], "en": "Lahucitta, Sasāla, Kasanti, and again...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:16.2"], "en": "Then the excellent Kāma-daśaka-vyākaraṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:16.3"], "en": "then the excellent Kaṇha-sukosiya-meṇḍa;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_473:16.4"], "en": "and again the excellent Mittavinda-daśaka—thus [there are] ten.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
