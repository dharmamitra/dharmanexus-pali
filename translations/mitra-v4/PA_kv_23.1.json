[
{"segs": ["PA_kv_23.1:0.1"], "en": "Points of Controversy (Kathāvatthu),", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:0.2"], "en": "Minor Section (Khuddakaaḍḍhapaṇṇāsaka),", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:0.3"], "en": "Twenty-third Chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:0.4"], "en": "Discourse on a Single Intention:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.1", "PA_kv_23.1:1.2"], "en": "Is sexual intercourse to be practiced with a single intention? Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.3"], "en": "\"Is it the case that by a single intention one must be a non-recluse, one must be a non-monk, one must be one whose roots are cut, and one must be one who has committed a *pārājika* offense?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.4"], "en": "One should not say so...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.5"], "en": "[and so on] ...is it the case that by a single intention one may engage in sexual intercourse?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.6"], "en": "\"Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.7", "PA_kv_23.1:1.8"], "en": "\"Is a living being to be killed and what is not given to be taken with a single intention?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.9"], "en": "Falsehood should be spoken;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.10"], "en": "slander should be spoken;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.11"], "en": "harsh speech should be spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.12"], "en": "Idle chatter should be indulged in,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.13"], "en": "a breach should be made,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.14"], "en": "and plunder should be carried off.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.15"], "en": "One should act as a solitary householder,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.16"], "en": "stand at the crossroads,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.17"], "en": "and go to another's wife.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.18"], "en": "\"Should a village-destroyer be appointed?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.19"], "en": "Should a town-destroyer be appointed?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.20"], "en": "One should not say so... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.1:1.21"], "en": "The Discussion on a Single Intention is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"}
]
