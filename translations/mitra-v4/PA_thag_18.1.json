[
{"segs": ["PA_thag_18.1:0.1"], "en": "Theragāthā 18.1,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:0.2"], "en": "Cattālīsanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:0.3"], "en": "First Chapter (Paṭhamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:0.4"], "en": "The Verses of the Elder Mahākassapa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:1.1"], "en": "\"One should not wander about attended by a crowd;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:1.2"], "en": "one who is distracted finds concentration difficult to attain.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:1.3"], "en": "The gathering of various people is suffering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:1.4"], "en": "seeing this, one should not delight in a group.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:2.1"], "en": "A sage should not frequent households.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:2.2"], "en": "Concentration is difficult to attain; he who,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:2.3"], "en": "being eager and greedy for flavors,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:2.4"], "en": "neglects that goal which brings happiness, is deprived of it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:3.1"], "en": "For they have known this as a mire:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:3.2"], "en": "that which is the salutation and worship among families;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:3.3"], "en": "it is a subtle dart, difficult to extract.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:3.4"], "en": "Honors are difficult for a base man to abandon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:4.1"], "en": "Having descended from my lodging,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:4.2"], "en": "I entered the city for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:4.3"], "en": "I attended carefully upon a leper as he was eating;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:4.4", "PA_thag_18.1:5.1"], "en": "with his hand covered in festering sores, he gave it to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:5.2"], "en": "He offered him a morsel of food;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:5.3"], "en": "while he was putting it into his mouth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:5.4"], "en": "a finger was cut off there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:6.1"], "en": "Relying on the base of a wall,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:6.2"], "en": "I ate that morsel of food;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:6.3"], "en": "whether while he was eating or when he had finished eating, I remained there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:6.4"], "en": "I have no sense of disgust.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:7.1"], "en": "My food is alms gathered after rising,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:7.2"], "en": "and my medicine is fermented urine.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:7.3"], "en": "The foot of a tree for a dwelling,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:7.4"], "en": "and a robe made of discarded rags;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:7.5"], "en": "for whomsoever these have been fully mastered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:7.6"], "en": "That man indeed is one who looks in all four directions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:8.1", "PA_thag_18.1:8.2"], "en": "whereas others, when climbing a mountain peak, become distressed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:8.3"], "en": "An heir of that Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:8.4"], "en": "clearly comprehending and mindful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:8.5"], "en": "supported by the power of supernormal success,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:8.6"], "en": "Kassapa ascends [the mountain].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:9.1"], "en": "Having returned from his almsround,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:9.2"], "en": "Kassapa has climbed up to the rock.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:9.3"], "en": "He meditates without clinging,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:9.4"], "en": "having abandoned fear and terror;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:10.1"], "en": "having returned from his alms round, he sits down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:10.2"], "en": "Having ascended the mountain peak,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:10.3"], "en": "Kassapa meditates without clinging,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:10.4"], "en": "extinguished while others are burning.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:11.1"], "en": "Having returned from his almsround,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:11.2", "PA_thag_18.1:11.3"], "en": "Kassapa ascended the mountain and meditates without clinging.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:11.4"], "en": "Having accomplished his task and free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:12.1", "PA_thag_18.1:12.2"], "en": "[he beholds] delightful stretches of ground overspread with carpets and garlands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:12.3"], "en": "Delightful with elephants roaming about,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:12.4"], "en": "those mountains bring me joy;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:13.1"], "en": "they are beautiful, with the hue of dark clouds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:13.2"], "en": "With cool waters and beautiful peaks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:13.3"], "en": "covered by indragopaka insects,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:13.4"], "en": "those mountains delight me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:14.1"], "en": "Resembling the peaks of blue clouds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:14.2"], "en": "resembling the form of excellent gabled houses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:14.3"], "en": "delightful with their elephant-like [elephant-]riders, and beautiful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:14.4"], "en": "Those mountains delight me—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:15.1"], "en": "those peaks with lovely slopes, frequented by seers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:15.2"], "en": "even when drenched by rain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:15.3"], "en": "Resounding with peacocks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:15.4"], "en": "those mountains delight me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:16.1"], "en": "they are sufficient for one who desires to meditate.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:16.2"], "en": "For me who am resolute;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:16.3", "PA_thag_18.1:16.4"], "en": "it is enough for me, a bhikkhu who desires the goal and is resolute.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:17.1", "PA_thag_18.1:17.2"], "en": "Enough for me, a bhikkhu who desires comfort and is resolute;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:17.3"], "en": "enough for me, who desires yoga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:17.4"], "en": "For the one who is self-exerted and poised,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:18.1"], "en": "[the world] is like an *umā* flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:18.2"], "en": "covered by clouds in the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:18.3", "PA_thag_18.1:18.4"], "en": "Those mountains, though crowded with various groups of people, delight me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:19.1"], "en": "they are not crowded with householders.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:19.2", "PA_thag_18.1:19.3"], "en": "Frequented by herds of deer and crowded with various flocks of birds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:19.4"], "en": "those mountains delight me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:20.1"], "en": "With clear waters and many rocks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:20.2"], "en": "frequented by oxen, monkeys,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:20.3"], "en": "and deer, and covered with water-moss.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:20.4"], "en": "Those rocks delight me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:21.1", "PA_thag_18.1:21.2"], "en": "I do not find such pleasure even with a fivefold musical ensemble.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:21.3"], "en": "Just as for one whose mind is one-pointed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:21.4"], "en": "who clearly sees the Dhamma with insight,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:22.1"], "en": "one should not perform much work.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:22.2"], "en": "One should avoid such people and not strive after them;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:22.3", "PA_thag_18.1:22.4"], "en": "for he who is eager and greedy for flavors neglects the goal that brings true happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:23.1"], "en": "One should not perform much work;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:23.2"], "en": "this is what one should avoid for one's own sake.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:23.3"], "en": "The body suffers and becomes exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:23.4"], "en": "Afflicted, he finds no tranquility.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:24.1"], "en": "By merely slapping his lips,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:24.2"], "en": "he does not even see himself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:24.3"], "en": "He walks with his neck held high,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:24.4"], "en": "thinking \"I am superior.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:25.1"], "en": "Though not superior, he considers himself superior.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:25.2"], "en": "The fool fancies himself [wise],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:25.3", "PA_thag_18.1:25.4"], "en": "but the wise do not praise that man whose mind is arrogant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:26.1", "PA_thag_18.1:26.2", "PA_thag_18.1:26.3"], "en": "And whoever thinks, \"I am superior,\" or \"I am not superior,\" or \"I am inferior, equal, or similar\"—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:26.4"], "en": "He does not waver amidst various conditions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:27.1"], "en": "Thus, one who possesses wisdom, who is such,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:27.2"], "en": "and who is well-composed in the precepts—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:27.3", "PA_thag_18.1:27.4", "PA_thag_18.1:28.1"], "en": "If a wise person praises that unsurpassed tranquility of mind which one possesses toward one's fellow celibates—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:28.2"], "en": "Veneration is not found;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:28.3"], "en": "one is far from the true Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:28.4"], "en": "as the earth is from the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:29.1", "PA_thag_18.1:29.2"], "en": "And those in whom moral shame and fear of wrongdoing are always rightly established,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:29.3"], "en": "they have caused their holy life to flourish.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:29.4"], "en": "For them, rebirth is exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:30.1"], "en": "A monk who is agitated and fickle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:30.2"], "en": "though clothed in rag-robes;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:30.3"], "en": "Like a monkey in a lion’s skin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:30.4"], "en": "he does not shine because of it;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:31.1"], "en": "being undisturbed and unflustered, [he truly shines].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:31.2", "PA_thag_18.1:31.3"], "en": "The wise one with restrained faculties shines in his rag-robe,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:31.4"], "en": "like a lion in the mountain cave.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:32.1"], "en": "These many gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:32.2"], "en": "possessed of psychic power and renown—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:32.3"], "en": "ten thousand gods in all.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:32.4"], "en": "They were all members of the Brahma-host.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:33.1"], "en": "To the Hero, the General of the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:33.2"], "en": "the great meditator absorbed in concentration—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:33.3"], "en": "Paying homage to Sāriputta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:33.4"], "en": "they stand with palms joined in reverence:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:34.1"], "en": "\"Homage to you, O noble steed among men!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:34.2"], "en": "Homage to you, O Supreme among Men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:34.3", "PA_thag_18.1:34.4"], "en": "we do not fully understand that upon which you rely when you meditate.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:35.1", "PA_thag_18.1:35.2"], "en": "\"How wonderful, indeed, is the Buddhas' own domain; it is profound,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:35.3"], "en": "such that we do not comprehend it.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:35.4"], "en": "“...assembled like those who pierce a hair-tip.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:36.1"], "en": "Thus was he, worthy of worship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:36.2"], "en": "honored by the hosts of devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:36.3"], "en": "Seeing Sāriputta then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:36.4"], "en": "Kappina was moved to a smile.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:37.1"], "en": "As far as the Buddha-field extends,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:37.2"], "en": "Setting aside the Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:37.3"], "en": "I am distinguished in the ascetic qualities (dhutaguṇa);", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:37.4"], "en": "there is no one equal to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:38.1"], "en": "The Teacher has been served by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:38.2"], "en": "the Buddha’s instruction has been fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:38.3"], "en": "the heavy burden has been laid down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:38.4"], "en": "Now there is no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:39.1", "PA_thag_18.1:39.2"], "en": "He is not stained by robes, bedding, or food.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:39.3"], "en": "Gotama is immeasurable,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:39.4"], "en": "like a stainless muḷāla flower;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:39.5"], "en": "inclined toward renunciation, he is like water.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:39.6"], "en": "Escaped from the three worlds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:40.1"], "en": "with the foundations of mindfulness as his neck,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:40.2"], "en": "faith as his hand, that great sage—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:40.3"], "en": "“The great wise one, whose head is wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:40.4"], "en": "always dwells extinguished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:40.5"], "en": "… Thus spoke the Elder Mahākassapa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:40.6"], "en": "The Section of Forty is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:41.0", "PA_thag_18.1:41.1"], "en": "Therein, the summary verse for the Section of Forty is as follows: [Cattālīsanipātamhi...]", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_18.1:41.2", "PA_thag_18.1:41.3", "PA_thag_18.1:41.4"], "en": "The one elder named Mahākassapa [recited] forty-two verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
