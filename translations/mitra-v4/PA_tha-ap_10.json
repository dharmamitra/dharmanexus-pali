[
{"segs": ["PA_tha-ap_10:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:0.2"], "en": "Buddhavagga 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:0.3"], "en": "The Apadāna of the Elder Piṇḍolabhāradvāja", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:1.2"], "en": "the Self-Existent One, the Supreme Person,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:1.3"], "en": "was to the east of the Himalayas.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:1.4"], "en": "I was then dwelling on Cittakūṭa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:2.1", "PA_tha-ap_10:2.2"], "en": "there as the fearless king of beasts, possessing four tusks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:2.3"], "en": "Having heard his sound,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:2.4"], "en": "many people are struck with awe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:3.1"], "en": "they gather full-blown lotuses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:3.2"], "en": "I approached the bull among men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:3.3", "PA_tha-ap_10:3.4"], "en": "as the Buddha had arisen from his meditative absorption, I offered [the gift] to him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:4.1", "PA_tha-ap_10:4.2"], "en": "Having paid homage to the Best of Buddhas, the Supreme among Men, in the four directions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:4.3"], "en": "and having gladdened one's own mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:4.4"], "en": "I let out a lion’s roar:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:5.1"], "en": "\"Padumuttara, the Knower of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:5.2"], "en": "the Recipient of Offerings;...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:5.3"], "en": "Having sat down on his own seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:5.4"], "en": "he spoke these verses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:6.1"], "en": "having understood the Buddha’s speech:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:6.2"], "en": "All the gods have assembled, thinking:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:6.3"], "en": "\"The Best of Speakers has arrived;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:6.4"], "en": "we shall hear the Dhamma from him.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:7.1"], "en": "While they were overcome with laughter,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:7.2", "PA_tha-ap_10:7.3"], "en": "the Leader of the World proclaimed my name before them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:7.4"], "en": "The great sage of far-reaching vision,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:8.1", "PA_tha-ap_10:8.2"], "en": "by whom this lotus was given and the lion’s roar was uttered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:8.3"], "en": "I shall proclaim his praise;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:8.4"], "en": "listen as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:9.1"], "en": "In the eighth aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:9.2"], "en": "He will become a wheel-turning monarch,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:9.3"], "en": "endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:9.4"], "en": "the lord of the four continents.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:10.1", "PA_tha-ap_10:10.2"], "en": "He will exercise sovereignty over sixty-four great lands;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:10.3"], "en": "he shall be known by the name Paduma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:10.4"], "en": "A wheel-turning monarch of great power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:11.1", "PA_tha-ap_10:11.2"], "en": "born of the Okkāka clan, after one hundred thousand eons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:11.3", "PA_tha-ap_10:11.4"], "en": "One named Gotama by clan will become a teacher in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:12.1"], "en": "when his teaching has been proclaimed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:12.2"], "en": "He will become a mere kinsman of Brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:12.3"], "en": "having renounced the life of a Brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:12.4"], "en": "he will immediately go forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:13.1"], "en": "Dedicated to striving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:13.2"], "en": "serene and free from acquisitions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:13.3"], "en": "having fully understood all taints—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:13.4", "PA_tha-ap_10:14.1"], "en": "He, free from taints, will attain Nibbāna in a secluded dwelling at the edge of the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:14.2"], "en": "teeming with wild beasts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:14.3"], "en": "Having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:14.4"], "en": "he will attain Nibbāna, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:15.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:15.2", "PA_tha-ap_10:15.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:15.4"], "en": "the Buddha’s teaching has been accomplished.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:16.1"], "en": "Thus indeed did the venerable elder Piṇḍolabhāradvāja speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_10:17.1"], "en": "This is the eighth legend of the elder Piṇḍolabhāradvāja.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
