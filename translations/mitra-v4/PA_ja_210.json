[
{"segs": ["PA_ja_210:0.1", "PA_ja_210:0.2", "PA_ja_210:0.3"], "en": "Jātaka: The Second Book of Birth Stories (Dukanipāta), Chapter on the Nataṁdaḷha Group (Nataṁdaḷhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:0.4"], "en": "10. The Kandagalaka Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:1.1", "PA_ja_210:1.2"], "en": "\"O friend, what indeed is this tree, with its withered leaves and thorns?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:1.3", "PA_ja_210:1.4"], "en": "“Wherein his head was split in a single stroke.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:2.1"], "en": "“Truly he wandered through the forests, piercing them.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:2.2"], "en": "“Among the heartwood-less trees of the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:2.3"], "en": "he then saw a khadira tree that had produced heartwood,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:2.4"], "en": "whereupon the garuḷa tore it apart with his beak.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:3.1"], "en": "The Kandagalaka Jātaka is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:3.2"], "en": "The sixth chapter, Nataṃdaḷha-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:4.1"], "en": "Its summary (uddāna) is as follows:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:5.1"], "en": "Daḷhabandhana and Haṃsavara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:5.2"], "en": "Virūpakkha and Saviṭṭhaka, Macchavara;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:5.3"], "en": "Sakuruṅga, Saassaka, and Ambavara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_210:5.4"], "en": "Again, Kukkuṭaka was bitten by Garuḍa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
