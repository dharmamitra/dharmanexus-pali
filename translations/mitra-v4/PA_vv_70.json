[
{"segs": ["PA_vv_70:0.1", "PA_vv_70:0.2"], "en": "Vimānavatthu: The Mansion of the Man,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:0.3"], "en": "Chapter on Pāyāsi", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:0.4", "PA_vv_70:1.1"], "en": "6. The Mansion of the Almsgiver “High indeed is this celestial mansion with its jeweled pillars,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:1.2"], "en": "extending twelve yojanas in every direction.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:1.3"], "en": "Seven hundred lofty gabled chambers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:1.4"], "en": "beautiful with pillars of beryl and adorned with silver, exist for you;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:2.1"], "en": "you have attained divine power and great majesty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:2.2"], "en": "\"What merit did you perform while being a human being?", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:2.3"], "en": "By what means have you come to possess such blazing majesty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:2.4"], "en": "and why does your complexion illuminate all directions?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:3.1", "PA_vv_70:3.2"], "en": "Thus the young deva was delighted...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:3.3"], "en": "[as before] ...the fruit of which karma this is.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:4.1"], "en": "“Having become a human among humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:4.2"], "en": "upon seeing a bhikkhu who was thirsty and weary,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:4.3"], "en": "I offered him almsfood for one day.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:4.4"], "en": "At that time, I offered him a meal;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:5.1", "PA_vv_70:5.2"], "en": "because of that, my complexion became such as this... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:5.3"], "en": "\"And my radiance shines in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_70:6.1"], "en": "Thus ends the sixth *vimāna*, the Mansion of the Almsgiver.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"}
]
