[
{"segs": ["PA_tha-ap_463:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:0.2"], "en": "Chapter on the Sālakusumiya Group 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:0.3"], "en": "The Apadāna of the Elder Sālakusumiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:1.1", "PA_tha-ap_463:1.2"], "en": "When the Blessed One named Jalajuttama had attained final nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:1.3"], "en": "and he was placed upon the funeral pyre,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:1.4"], "en": "I worshipped with a *sāla* flower.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:2.1"], "en": "In a hundred thousand aeons from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:2.2"], "en": "because I offered that flower, [the fruit will ripen].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:2.3"], "en": "I do not know a miserable rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:2.4"], "en": "this is the fruit of worshiping the funeral pyre.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:3.1"], "en": "The defilements have been burnt away by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:3.2"], "en": "All states of existence have been utterly eradicated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:3.3"], "en": "like a snake that has severed its bonds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:3.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:4.1"], "en": "Welcome indeed has come to me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:4.2"], "en": "being in the presence of the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:4.3"], "en": "the three knowledges have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:4.4"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:5.1", "PA_tha-ap_463:5.2"], "en": "the four analytical knowledges and these eight liberations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:5.3"], "en": "\"The six higher knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:5.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:6.1"], "en": "Thus indeed did the venerable elder Sālakusumiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_463:7.1"], "en": "The legend of the Elder Sālakusumiya is the first.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
