[
{"segs": ["PA_snp_2.10:0.1", "PA_snp_2.10:0.2"], "en": "Sutta Nipāta 2.10 Uṭṭhānasutta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:1.1"], "en": "Arise! Sit up!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:1.2"], "en": "What is the use of your sleeping?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:1.3"], "en": "For what sleep can there be for those who are afflicted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:1.4"], "en": "who are tormented as if pierced by arrows?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:2.1"], "en": "Arise and sit up;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:2.2"], "en": "train yourselves firmly in peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:2.3"], "en": "Let not the wise ones, having perceived you, find you negligent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:2.4"], "en": "King Death deluded those who follow their desires,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:3.1"], "en": "by which gods and humans remain bound,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:3.2"], "en": "longing for existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:3.3"], "en": "Cross over this attachment;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:3.4"], "en": "let not the opportune moment pass you by.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:3.5"], "en": "For those who have let the moment pass grieve, saying:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:3.6"], "en": "They are cast into hell.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:4.1", "PA_snp_2.10:4.2"], "en": "Heedlessness is dust; heedlessness brings forth dust; one who is overcome by heedlessness is covered in dust.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:4.3"], "en": "\"By heedfulness and true knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:4.4"], "en": "one may extract the arrow from oneself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.10:4.5"], "en": "Thus ends the tenth sutta, \"On Exertion.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
