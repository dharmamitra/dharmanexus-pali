[
{"segs": ["PA_bv_24:0.1"], "en": "Buddhavamsa 24.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:0.2"], "en": "The Lineage of Buddha Kakusandha:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:1.1"], "en": "\"After Vessabhu...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:1.2"], "en": "The Fully Awakened One, supreme among bipeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:1.3"], "en": "named Kakusandha by name,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:1.4"], "en": "was immeasurable and difficult to approach.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:2.1", "PA_bv_24:2.2"], "en": "Having burst open all states of existence and reached the perfection of conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:2.3"], "en": "he is like a lion that has broken through its cage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:2.4"], "en": "He attained supreme enlightenment while Kakusandha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:3.1", "PA_bv_24:3.2"], "en": "the leader of the world, was setting in motion the Wheel of Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:3.3", "PA_bv_24:3.4", "PA_bv_24:4.1"], "en": "There was a realization of the Dhamma by forty-four thousand [beings] in the midst of the sky, in the air.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:4.2", "PA_bv_24:4.3"], "en": "Having performed miraculous transformations by way of the twin miracle,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:4.4"], "en": "he awakened thirty thousand koṭis of gods and humans.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:5.1"], "en": "For the yakkha Naradeva,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:5.2", "PA_bv_24:5.3"], "en": "upon the proclamation of the Four Noble Truths, there was the realization of the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:5.4"], "en": "In number, they were incalculable.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:6.1"], "en": "For the Blessed One Kakusandha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:6.2"], "en": "there was one assembly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:6.3"], "en": "Of those whose taints were exhausted, stainless,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:6.4"], "en": "with peaceful minds and poised equanimity—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:7.1"], "en": "of forty thousand [such as these].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:7.2", "PA_bv_24:7.3"], "en": "Then there was a meeting for those who had reached the Land of the Tamed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:7.4"], "en": "through the destruction of the host of the enemies that are the taints.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:8.1"], "en": "At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:8.2"], "en": "I was a kshatriya named Khema;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:8.3"], "en": "[I served] the Tathagatas and the sons of the Conquerors.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:8.4"], "en": "Having given no small gift—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:9.1"], "en": "having given a bowl and a robe,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:9.2"], "en": "as well as ointment and honeyed sugar-cane sticks;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:9.3"], "en": "All this that was desired,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:9.4"], "en": "I prepare, one boon after another.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:10.1"], "en": "That Buddha also made a prediction concerning me:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:10.2"], "en": "Kakusandha, the Leader:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:10.3"], "en": "“In this auspicious aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:10.4"], "en": "he will become a Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:11.1", "PA_bv_24:11.2"], "en": "\"The delightful city called Kapila...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:11.3"], "en": "we shall stand face-to-face with him.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:12.1"], "en": "Having heard her words as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:12.2"], "en": "my heart became even more serene;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:12.3"], "en": "I resolved upon a further ascetic practice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:12.4"], "en": "Upon fulfilling the ten perfections,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:13.1"], "en": "there was a city named Khemāvatī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:13.2"], "en": "and at that time I was named Khema.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:13.3"], "en": "Seeking omniscience,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:13.4"], "en": "I went forth into homelessness in his presence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:14.1"], "en": "And the brahmin Aggidatta—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:14.2"], "en": "He was the father of that Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:14.3", "PA_bv_24:14.4"], "en": "the mother of the Teacher Kakusandha was named Visākhā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:15.1"], "en": "There, in the city of Khema,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:15.2"], "en": "dwelt the great family of the Sambuddha—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:15.3"], "en": "the most excellent and supreme among men.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:15.4"], "en": "Of noble birth and great renown,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:16.1", "PA_bv_24:16.2"], "en": "he dwelt in the household for four thousand years.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:16.3", "PA_bv_24:16.4"], "en": "There were three supreme palaces named Kāma, Kāmavaṇṇa, and Kāmasuddhi;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:17.1"], "en": "they numbered thirty-two thousand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:17.2"], "en": "The women were beautifully adorned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:17.3"], "en": "that woman was named Rocinī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:17.4"], "en": "and her son was named Uttara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:18.1"], "en": "Having seen the four signs,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:18.2"], "en": "he went out in a chariot; for no less than eight months,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:18.3"], "en": "he remained [in the womb].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:18.4"], "en": "The Conqueror strove with earnest effort.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:19.1", "PA_bv_24:19.2"], "en": "Being entreated by Brahmā, the Leader Kakusandha, being virtuous, [arose].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:19.3", "PA_bv_24:19.4"], "en": "The Great Hero, the Supreme among Men, set the wheel rolling in the Deer Park.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:20.1"], "en": "Vidhura and Sañjīva—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:20.2"], "en": "They were the chief disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:20.3", "PA_bv_24:20.4"], "en": "the attendant of the Teacher Kakusandha was named Buddhija.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:21.1", "PA_bv_24:21.2"], "en": "Sāmā and Campā by name were his two chief female disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:21.3"], "en": "such was the Bodhi tree of that Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:21.4"], "en": "He is called Sirīsa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:22.1", "PA_bv_24:22.2"], "en": "Accuta and Sumana were his chief attendants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:22.3", "PA_bv_24:22.4"], "en": "Nandā and Sunandā were his chief attendants;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:23.1"], "en": "there were forty jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:23.2"], "en": "The Great Sage has risen high;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:23.3"], "en": "a golden radiance streams forth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:23.4"], "en": "extending ten yojanas in every direction.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:24.1", "PA_bv_24:24.2"], "en": "The lifespan of that Great Sage was forty thousand years;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:24.3"], "en": "remaining for that long, he—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:24.4"], "en": "You ferry across many people;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:25.1"], "en": "having opened the marketplace of the Dhamma for men and women,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:25.2"], "en": "together with the devas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:25.3"], "en": "Having roared like a lion’s roar,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:25.4"], "en": "he has attained Nibbāna together with his disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:26.1"], "en": "he was perfected in the speech of the Eightfold Path.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:26.2"], "en": "Without gaps and continuous;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:26.3"], "en": "all that has vanished within,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:26.4"], "en": "for are not all conditioned things empty?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:27.1"], "en": "Kakusandha, the supreme Victor,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:27.2"], "en": "attained Parinibbāna at Khemārāma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:27.3"], "en": "right there stands his preeminent stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:27.4"], "en": "\"He rose a gāvuta into the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_24:28.1"], "en": "This is the twenty-second lineage of the Blessed One Kakusandha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
