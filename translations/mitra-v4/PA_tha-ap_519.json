[
{"segs": ["PA_tha-ap_519:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:0.2"], "en": "Phaladāyakavagga 7.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:0.3"], "en": "The Apadāna of the Elder Kuṭajapupphiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:1.1"], "en": "Not far from the Himālaya mountains,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:1.2"], "en": "there is a mountain named Vasala;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:1.3"], "en": "there dwells a Buddha named Sudassana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:1.4"], "en": "Dwelling within the mountain range,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:2.1", "PA_tha-ap_519:2.2"], "en": "I gathered Hemavanta flowers and went through the air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:2.3"], "en": "There I saw the Perfectly Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:2.4"], "en": "who had crossed the flood and was free from taints;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:3.1"], "en": "taking a *kuṭaja* flower, I approached him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:3.2"], "en": "Having made an añjali,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:3.3"], "en": "I offered it to the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:3.4"], "en": "the Self-Existent One, the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:4.1"], "en": "In the thirty-first aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:4.2"], "en": "because I offered that flower in worship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:4.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:4.4"], "en": "This is the fruit of worshiping the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:5.1", "PA_tha-ap_519:5.2"], "en": "my defilements have been incinerated... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:5.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:6.1", "PA_tha-ap_519:6.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:6.3"], "en": "Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:7.1", "PA_tha-ap_519:7.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:7.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:8.1"], "en": "In this way, it is said, the venerable elder Kuṭajapupphiya recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_519:9.1"], "en": "This is the seventh legend of the elder Kuṭajapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
