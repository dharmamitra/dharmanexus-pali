[
{"segs": ["PA_thi-ap_27:0.1"], "en": "The Therī-Apadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:0.2"], "en": "Kuṇḍalakesīvagga 7.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:0.3"], "en": "The Apadāna of the Elder Nun Bhaddākāpilānī", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:1.2"], "en": "who had gone beyond all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:1.3"], "en": "[lived] one hundred thousand aeons ago from here.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:1.4"], "en": "The Leader appeared in that eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:2.1"], "en": "At that time, in Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:2.2"], "en": "there was one known by the name Videha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:2.3", "PA_thi-ap_27:2.4"], "en": "I was the wife of a merchant who possessed abundant wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:3.1"], "en": "Once, that sun among men—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:3.2", "PA_thi-ap_27:3.3"], "en": "Together with his retinue, he approached and heard the Dhamma from the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:3.4"], "en": "which brings about the abandonment of all suffering and fear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:4.1", "PA_thi-ap_27:4.2"], "en": "The Leader proclaimed his disciple as the foremost of those who advocate ascetic practices (dhuta),", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:4.3"], "en": "having heard of his seven-day gift.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:4.4"], "en": "Having given [this] to the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:5.1", "PA_thi-ap_27:5.2"], "en": "the Tathāgata, I prostrated with my head at his feet and aspired for that state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:5.3", "PA_thi-ap_27:5.4", "PA_thi-ap_27:6.1"], "en": "Then that bull among men, out of compassion for the merchant, made the assembly laugh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:6.2"], "en": "He spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:6.3"], "en": "“You shall attain the state you have desired;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:6.4"], "en": "be at peace, my son.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:7.1"], "en": "In a hundred thousand aeons hence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:7.2"], "en": "one born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:7.3"], "en": "known by the family name Gotama, will appear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:7.4"], "en": "The Teacher shall appear in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:8.1"], "en": "His heir in the Dhammas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:8.2"], "en": "his own legitimate son, fashioned by the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:8.3"], "en": "“Named Kassapa by clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:8.4"], "en": "he will be a disciple of the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:9.1"], "en": "Having heard this, he became joyful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:9.2", "PA_thi-ap_27:9.3"], "en": "Then, with a mind of loving-kindness, he served the Jina, the Guide, for as long as he lived,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:9.4"], "en": "providing him with all requisites.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:10.1", "PA_thi-ap_27:10.2"], "en": "Having illuminated the Dispensation and crushed the false teachers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:10.3"], "en": "and having disciplined those who were ready to be trained, he—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:10.4", "PA_thi-ap_27:11.1"], "en": "He has attained Nibbāna together with his disciples. Now that the Foremost One in the World has attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:11.2"], "en": "for the sake of honoring the Teacher:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:11.3"], "en": "Having gathered his kinsmen and friends,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:11.4", "PA_thi-ap_27:12.1"], "en": "together with them he caused a stūpa seven yojanas in height to be built.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:12.2"], "en": "A towering structure made of jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:12.3"], "en": "blazing like the sun with its rays,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:12.4"], "en": "like a king of sal trees in full bloom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:13.1", "PA_thi-ap_27:13.2"], "en": "There he had seven hundred thousand bowls made,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:13.3"], "en": "which shone like the flame of a reed-fire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:13.4"], "en": "With seven precious gems,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:14.1"], "en": "having filled it with fragrant oil,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:14.2"], "en": "he lit lamps there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:14.3", "PA_thi-ap_27:14.4", "PA_thi-ap_27:15.1"], "en": "Seven hundred thousand [beings] for the sake of worshipping the Great Sage, who has compassion for all living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:15.2"], "en": "He had full water-pots made,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:15.3", "PA_thi-ap_27:15.4"], "en": "filled with jewels for the purpose of worshipping the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:16.1"], "en": "In the midst of the eight sets of eight jars,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:16.2"], "en": "golden vases were raised up;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:16.3"], "en": "they shine forth with their color.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:16.4"], "en": "Like the sun in autumn,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:17.1", "PA_thi-ap_27:17.2"], "en": "the gateways made of jewels shine at the four doors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:17.3", "PA_thi-ap_27:17.4", "PA_thi-ap_27:18.1"], "en": "The lofty, delightful planks made of jewels shine; they gleam, beautifully encircled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:18.2"], "en": "The earrings were well-fashioned;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:18.3", "PA_thi-ap_27:18.4"], "en": "the raised banners and jewels shone brilliantly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:19.1"], "en": "The well-fashioned mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:19.2"], "en": "like a shrine made of jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:19.3"], "en": "shines forth with its own radiance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:19.4"], "en": "Like the sun at dawn,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:20.1", "PA_thi-ap_27:20.2"], "en": "he filled the three terraces of the stupa with yellow orpiment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:20.3"], "en": "One with emerald, one with sapphire,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:20.4"], "en": "and one with collyrium—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:21.1"], "en": "such was the delightful offering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:21.2"], "en": "Having had it constructed, he, a speaker of excellent words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:21.3", "PA_thi-ap_27:21.4"], "en": "gave alms to the Saṅgha for as long as he lived, according to his ability.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:22.1", "PA_thi-ap_27:22.2", "PA_thi-ap_27:22.3"], "en": "Having performed all those meritorious deeds throughout his entire life by means of that merchant Sahāva,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:22.4"], "en": "They went to a happy destination by their very nature;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:23.1", "PA_thi-ap_27:23.2"], "en": "having experienced prosperity among both gods and humans, they attained [liberation].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:23.3"], "en": "Like a shadow with the body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:23.4", "PA_thi-ap_27:24.1"], "en": "I wandered together with him through ninety-one eons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:24.2"], "en": "A leader named Vipassī arose,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:24.3"], "en": "beautiful to behold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:24.4"], "en": "possessing insight into all phenomena.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:25.1"], "en": "At that time, in Bandhumatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:25.2"], "en": "there was a brahmin esteemed as virtuous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:25.3"], "en": "who was wealthy and also endowed with merit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:25.4"], "en": "And he was very poor in wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:26.1", "PA_thi-ap_27:26.2"], "en": "Even then, I was his wife, O brahmin, with an even mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:26.3", "PA_thi-ap_27:26.4", "PA_thi-ap_27:27.1"], "en": "Once that noble brahmin met the great sage as he sat amidst a multitude of people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:27.2"], "en": "Proclaiming the deathless state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:27.3", "PA_thi-ap_27:27.4"], "en": "having heard the Dhamma, he was delighted and gave him a single robe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:28.1"], "en": "Having gone home with only a single garment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:28.2"], "en": "he returned and said this to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:28.3"], "en": "\"Rejoice in this great merit!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:28.4"], "en": "“A garment was given to the Buddha. Then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:29.1"], "en": "with palms joined in reverence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:29.2"], "en": "I rejoiced with great joy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:29.3"], "en": "“Master, this is Sudinna’s garment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:29.4"], "en": "for the Best of Buddhas, the Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:30.1"], "en": "Having become joyful and prepared, he—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:30.2"], "en": "Wandering through various states of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:30.3", "PA_thi-ap_27:30.4"], "en": "he was a king, a lord of the earth, in the delightful city of Bārāṇasī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:31.1", "PA_thi-ap_27:31.2", "PA_thi-ap_27:31.3"], "en": "At that time, I was the chief queen among his harem of women, his most beloved.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:31.4"], "en": "Out of former affection for their husband,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:32.1", "PA_thi-ap_27:32.2"], "en": "those eight individual leaders wandered about for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:32.3", "PA_thi-ap_27:32.4"], "en": "Having seen him, he became joyful and gave him a most precious alms-offering; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:33.1"], "en": "having invited him again, he said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:33.2"], "en": "Having constructed a jeweled pavilion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:33.3", "PA_thi-ap_27:33.4"], "en": "he offered a golden bowl of that very size, fashioned by smiths.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:34.1"], "en": "Having gathered them all together,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:34.2", "PA_thi-ap_27:34.3"], "en": "he gave them alms as they sat upon golden seats.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:34.4"], "en": "With my own hands, full of faith,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:35.1", "PA_thi-ap_27:35.2"], "en": "I myself gave that gift to the King of Kāsi at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:35.3", "PA_thi-ap_27:35.4"], "en": "Again, I was born in Bārāṇasī, in a village of Kāsika;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:36.1"], "en": "in a prosperous family of householders.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:36.2"], "en": "He was happy together with his brother;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:36.3", "PA_thi-ap_27:36.4"], "en": "I was a devoted wife to my eldest brother.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:37.1"], "en": "Having seen the Paccekabuddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:37.2", "PA_thi-ap_27:37.3"], "en": "I gave a portion of food to my younger husband.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:37.4"], "en": "When he had arrived, I spoke to him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:38.1"], "en": "yet he did not welcome the gift,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:38.2"], "en": "and so I gave it to him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:38.3"], "en": "Having brought that food in a pot,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:38.4"], "en": "he gave it back to him once again.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:39.1"], "en": "Having discarded that food, [he departed].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:39.2"], "en": "Being angry at the Buddha then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:39.3", "PA_thi-ap_27:39.4"], "en": "I gave that alms-bowl filled with mud to that Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:40.1"], "en": "In giving and in receiving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:40.2", "PA_thi-ap_27:40.3"], "en": "in the pure and even in the impure; having seen the face of one with an even mind—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:40.4"], "en": "Then I was deeply moved.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:41.1", "PA_thi-ap_27:41.2"], "en": "Taking the bowl again and having cleansed it with fragrance;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:41.3"], "en": "With a mind full of faith, having filled it,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:41.4"], "en": "I gave it with ghee and sugar.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:42.1"], "en": "Wherever I am reborn,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:42.2"], "en": "I became beautiful through giving;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:42.3", "PA_thi-ap_27:42.4"], "en": "I became foul-smelling through harming the Buddha and through my speech.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:43.1", "PA_thi-ap_27:43.2"], "en": "Again, when the stupa of the Hero Kassapa was being enshrined,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:43.3"], "en": "[he offered] an excellent golden brick.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:43.4"], "en": "I gave with joy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:44.1", "PA_thi-ap_27:44.2"], "en": "Having piled up that firewood with a fourfold mixture of scents;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:44.3"], "en": "Free from the fault of foul odor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:44.4"], "en": "with all her limbs perfectly proportioned;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:45.1"], "en": "seven thousand pāṭisās were [given].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:45.2"], "en": "With seven precious gems,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:45.3", "PA_thi-ap_27:45.4"], "en": "he had thousands of lamps and wicks fashioned.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:46.1"], "en": "Having placed them there and lit them,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:46.2", "PA_thi-ap_27:46.3"], "en": "I set up seven rows for the sake of worshipping the Lord of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:46.4"], "en": "With a serene mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:47.1", "PA_thi-ap_27:47.2"], "en": "Even then, I was especially a partaker in that merit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:47.3"], "en": "Again, I was born in Kāsī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:47.4"], "en": "known by the name Sumitta;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:48.1"], "en": "I was his wife.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:48.2"], "en": "Happy and adorned was my beloved;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:48.3", "PA_thi-ap_27:48.4"], "en": "at that time, I gave a thick turban to the Paccekabuddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:49.1"], "en": "I was also her sister,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:49.2"], "en": "and having rejoiced in that supreme gift,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:49.3"], "en": "once again in the kingdom of Kāsi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:49.4"], "en": "He was born into the Koliya clan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:50.1", "PA_thi-ap_27:50.2"], "en": "At that time, together with five hundred sons of the Koliyas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:50.3", "PA_thi-ap_27:50.4"], "en": "He attended upon five hundred paccekabuddhas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:51.1"], "en": "having satisfied them for three months,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:51.2"], "en": "And she gave him the triple robe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:51.3"], "en": "at that time, I was his wife,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:51.4"], "en": "following after the path of meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:52.1", "PA_thi-ap_27:52.2"], "en": "Passing away from there, I became a king named Nanda of great renown;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:52.3"], "en": "I was also his chief queen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:52.4"], "en": "Accomplishing all desires.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:53.1", "PA_thi-ap_27:53.2"], "en": "At that time, having become King Brahmadatta, the lord of the earth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:53.3", "PA_thi-ap_27:53.4", "PA_thi-ap_27:54.1"], "en": "Then there were no fewer than five hundred sons of Padumavatī, who were paccekabuddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:54.2"], "en": "I attended upon him for as long as I lived;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:54.3"], "en": "having established him in the royal garden,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:54.4"], "en": "I honored his extinguished remains.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:55.1", "PA_thi-ap_27:55.2"], "en": "Having both caused cetiyas to be built and gone forth into homelessness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:55.3"], "en": "we have cultivated the immeasurables.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:55.4"], "en": "You went to the Brahma-world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:56.1"], "en": "Passing away from there at Mahātittha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:56.2"], "en": "you were well-born as Pipphalāyana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:56.3"], "en": "My mother was Queen Sumanadevī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:56.4"], "en": "and my father was a brahmin of the Kosi lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:57.1"], "en": "I was born in the Madra country.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:57.2", "PA_thi-ap_27:57.3", "PA_thi-ap_27:57.4"], "en": "I was the daughter of the brahmin Kappila, the mother of Sākalā, for that most excellent city. My mind was pure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:58.1"], "en": "Having fashioned me from a mold of solid gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:58.2", "PA_thi-ap_27:58.3"], "en": "my father gave me to the steadfast Kassapa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:58.4"], "en": "Free from sensual desires,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:59.1", "PA_thi-ap_27:59.2"], "en": "that compassionate one would sometimes go to observe the workers at their labors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:59.3", "PA_thi-ap_27:59.4"], "en": "Seeing living beings being devoured by crows and other scavengers, I was filled with dread. Then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:60.1"], "en": "while I was at home, sesame seeds were produced.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:60.2", "PA_thi-ap_27:60.3"], "en": "Seeing them being scorched by the heat of the sun and being devoured by worms and crows,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:60.4"], "en": "I then experienced a sense of spiritual urgency.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:61.1"], "en": "Then that wise one went forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:61.2"], "en": "and I followed him in going forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:61.3"], "en": "I lived there for five years.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:61.4", "PA_thi-ap_27:62.1", "PA_thi-ap_27:62.2"], "en": "I am a wanderer. When Gotamī, the nourisher of the Victor, had gone forth, she was a wanderer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:62.3"], "en": "Then, having approached him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:62.4"], "en": "I was instructed by the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:63.1"], "en": "before long, in a short time...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:63.2"], "en": "I attained arhatship;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:63.3", "PA_thi-ap_27:63.4"], "en": "oh, the excellence of the friendship with the illustrious Kassapa!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:64.1"], "en": "The son of the Buddha’s heir,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:64.2"], "en": "Kassapa, well-composed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:64.3"], "en": "who knows his former abodes—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:64.4"], "en": "He sees both heaven and the states of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:65.1"], "en": "moreover, having reached the destruction of birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:65.2"], "en": "the sage is perfected through direct knowledge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:65.3"], "en": "By means of these three knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:65.4"], "en": "a brahmin becomes one possessed of the threefold knowledge (tevijja).", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:66.1"], "en": "And so too was Bhaddā Kāpilānī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:66.2"], "en": "Possessing the threefold knowledge, she has abandoned death;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:66.3", "PA_thi-ap_27:66.4"], "en": "having conquered Māra along with his mount, she bears her final body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:67.1"], "en": "Having seen the peril in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:67.2"], "en": "we both have gone forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:67.3"], "en": "we are now tamed ones whose taints are exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:67.4"], "en": "We have become cooled and extinguished;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:68.1"], "en": "my defilements have been incinerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:68.2"], "en": "…pe…", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:68.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:69.1", "PA_thi-ap_27:69.2"], "en": "Welcome indeed has come to me... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:69.3"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:70.1", "PA_thi-ap_27:70.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:70.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:71.1"], "en": "Thus indeed did the bhikkhunī Bhaddā Kāpilānī speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_27:72.1"], "en": "This is the seventh legend of the elder bhikkhunī Bhaddā Kāpilānī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
