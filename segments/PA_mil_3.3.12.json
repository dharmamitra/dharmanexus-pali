    },
    {
        "segmentnr": "PA_mil_3.3.12:1.1",
        "original": "“Bhante nāgasena, kiṁlakkhaṇaṁ viññāṇan”ti?",
        "analyzed": "bhante nāgasena kilakkhaṇam viññāṇan ti ",
        "folio": "1",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#1.1"
    },
    {
        "segmentnr": "PA_mil_3.3.12:1.2",
        "original": "“Vijānanalakkhaṇaṁ, mahārāja, viññāṇan”ti.",
        "analyzed": "vijānana lakkhaṇa mahā rāja viññāṇanti ",
        "folio": "1",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#1.2"
    },
    {
        "segmentnr": "PA_mil_3.3.12:2.1",
        "original": "“Opammaṁ karohī”ti.",
        "analyzed": "opammam karohi iti ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#2.1"
    },
    {
        "segmentnr": "PA_mil_3.3.12:2.2_0",
        "original": "“Yathā, mahārāja, nagaraguttiko majjhe nagarasiṅghāṭake nisinno passeyya puratthimadisato",
        "analyzed": "yathā mahā rāja nagara guttikaḥ majjhe nagara siṅghāṭake nisinnaḥ passeyya puratthima disataḥ ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#2.2_0"
    },
    {
        "segmentnr": "PA_mil_3.3.12:2.2_1",
        "original": "purisaṁ āgacchantaṁ, passeyya dakkhiṇadisato purisaṁ āgacchantaṁ, passeyya pacchimadisato",
        "analyzed": "purisam āgacchanta passeyya dakkhiṇa disatas purisam āgacchanta passeyya pacchima disatas ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#2.2_1"
    },
    {
        "segmentnr": "PA_mil_3.3.12:2.2_2",
        "original": "purisaṁ āgacchantaṁ, passeyya uttaradisato purisaṁ āgacchantaṁ;",
        "analyzed": "purisam āgacchanta passeyya uttara disatas purisam āgacchanta ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#2.2_2"
    },
    {
        "segmentnr": "PA_mil_3.3.12:2.3",
        "original": "evameva kho, mahārāja, yañca puriso cakkhunā rūpaṁ passati, taṁ viññāṇena vijānāti.",
        "analyzed": "evam eva kho mahā rāja yat ca puriso cakkhunā rūpam passati tam viññāṇena vijānāti ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#2.3"
    },
    {
        "segmentnr": "PA_mil_3.3.12:2.4",
        "original": "Yañca sotena saddaṁ suṇāti, taṁ viññāṇena vijānāti.",
        "analyzed": "yam ca sotena saddam suṇāti tam viññāṇena vijānāti ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#2.4"
    },
    {
        "segmentnr": "PA_mil_3.3.12:2.5",
        "original": "Yañca ghānena gandhaṁ ghāyati, taṁ viññāṇena vijānāti.",
        "analyzed": "yam ca ghānena gandham ghāyati tam viññāṇena vijānāti ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#2.5"
    },
    {
        "segmentnr": "PA_mil_3.3.12:2.6",
        "original": "Yañca jivhāya rasaṁ sāyati, taṁ viññāṇena vijānāti.",
        "analyzed": "yam ca jivhāya rasam sāyati tam viññāṇena vijānāti ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#2.6"
    },
    {
        "segmentnr": "PA_mil_3.3.12:2.7",
        "original": "Yañca kāyena phoṭṭhabbaṁ phusati, taṁ viññāṇena vijānāti, yañca manasā dhammaṁ vijānāti, taṁ viññāṇena vijānāti.",
        "analyzed": "yam ca kāyena phoṭṭhabbam phusati tam viññāṇena vijānāti yam ca manasā dhammam vijānāti tam viññāṇena vijānāti ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#2.7"
    },
    {
        "segmentnr": "PA_mil_3.3.12:2.8",
        "original": "Evaṁ kho, mahārāja, vijānanalakkhaṇaṁ viññāṇan”ti.",
        "analyzed": "evam kho mahā rāja vijānana lakkhaṇam viññāṇan ti ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#2.8"
    },
    {
        "segmentnr": "PA_mil_3.3.12:3.1",
        "original": "“Kallosi, bhante nāgasenā”ti.",
        "analyzed": "kallosi bhante nāgasena ati ",
        "folio": "3",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#3.1"
    },
    {
        "segmentnr": "PA_mil_3.3.12:4.1",
        "original": "Viññāṇalakkhaṇapañho dvādasamo.",
        "analyzed": "viññāṇa lakkhaṇa pañhaḥ dvādasamaḥ ",
        "folio": "4",
        "suttacentral_link": "https://suttacentral.net/mil3.3.12/pli/ms#4.1"
    }
