[
{"segs": ["PA_ja_200:0.1", "PA_ja_200:0.2"], "en": "Jātaka: The Second Book of Birth Stories (Dukanipāta),", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:0.3"], "en": "Chapter on Ruhaka (Ruhakavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:0.4", "PA_ja_200:1.1"], "en": "10. The Birth Story of Sādhusīla “The body grows old, wealth grows old, and noble birth grows old;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:1.2"], "en": "but virtuous conduct does not grow old.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:1.3"], "en": "“Brahmin, we ask you this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:1.4"], "en": "whom among them do we honor?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:2.1"], "en": "“There is a purpose within the body.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:2.2"], "en": "\"I pay homage to you, Venerable One;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:2.3"], "en": "there is a purpose in one of noble birth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:2.4"], "en": "for we find pleasure in virtuous conduct.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:3.1"], "en": "The Sādhusīla Jātaka, the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:3.2"], "en": "The fifth chapter, the Ruhaka Vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:4.1"], "en": "Its summary verse (uddāna):", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:5.1"], "en": "Apiruhaka, Rūpavatī, Musala,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:5.2"], "en": "Pavasanti, and the fifth, Pokkharaṇī flow forth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:5.3"], "en": "then Muttimā and Avāṇija laugh aloud.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_200:5.4"], "en": "\"Long has it been since this body was brought here.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
