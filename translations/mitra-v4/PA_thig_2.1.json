[
{"segs": ["PA_thig_2.1:0.1", "PA_thig_2.1:0.2"], "en": "Therīgāthā 2.1, Dukanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.1:0.3"], "en": "The Verses of the Elder Nun Abhirūpanandā", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.1:1.1", "PA_thig_2.1:1.2"], "en": "“Behold, Nanda, this body: afflicted, impure, and putrid.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.1:1.3"], "en": "Develop your mind in the perception of foulness.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.1:1.4"], "en": "One-pointed and well-concentrated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.1:2.1", "PA_thig_2.1:2.2"], "en": "cultivate the signless and abandon the underlying tendency to conceit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.1:2.3"], "en": "\"Then, through the realization of conceit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.1:2.4"], "en": "you shall live in peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.1:3.1"], "en": "Thus indeed did the elder nun Abhirūpanandā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
