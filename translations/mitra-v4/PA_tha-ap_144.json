[
{"segs": ["PA_tha-ap_144:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:0.2", "PA_tha-ap_144:0.3"], "en": "Chapter on the Umbrella (Chattavagga), 2. The Apadāna of the Elder Thambhāropaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:1.1", "PA_tha-ap_144:1.2"], "en": "When Dhammadassi, the bull among men, the Protector of the World, had entered Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:1.3"], "en": "I raised up a victory pillar.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:1.4", "PA_tha-ap_144:2.1"], "en": "Having constructed a ladder at the stupa of the Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:2.2"], "en": "I ascended that most excellent of monuments.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:2.3", "PA_tha-ap_144:2.4"], "en": "Having taken a jasmine flower, I offered it at the stupa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:3.1"], "en": "\"O Buddha! O Dhamma!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:3.2"], "en": "Oh, the excellence of our Teacher!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:3.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:3.4"], "en": "this is the fruit of worshipping the stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:4.1"], "en": "In the ninety-fourth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:4.2", "PA_tha-ap_144:4.3"], "en": "there were sixteen kings named Thūpasīkha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:4.4"], "en": "Universal monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:5.1", "PA_tha-ap_144:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:6.1"], "en": "In this way, indeed, the venerable elder Thambhāropaka recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_144:7.1"], "en": "This is the second legend of the elder Thambhāropaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
