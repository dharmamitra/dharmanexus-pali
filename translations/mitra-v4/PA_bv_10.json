[
{"segs": ["PA_bv_10:0.1"], "en": "Buddhavamsa 10.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:0.2"], "en": "The Lineage of Paduma Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:1.1"], "en": "\"After Anomadassi...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:1.2"], "en": "The Fully Awakened One, supreme among bipeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:1.3"], "en": "named Paduma by name,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:1.4"], "en": "peerless and without rival.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:2.1"], "en": "His virtue is unequaled,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:2.2"], "en": "his concentration is infinite,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:2.3"], "en": "and his supreme knowledge is incalculable.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:2.4"], "en": "Even his liberation is beyond compare.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:3.1"], "en": "When he, of incomparable splendor,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:3.2"], "en": "set in motion the Wheel of Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:3.3", "PA_bv_10:3.4"], "en": "There were three realizations that dispelled great darkness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:4.1"], "en": "At the first realization, he was a Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:4.2"], "en": "He awakened one hundred koṭis;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:4.3", "PA_bv_10:4.4"], "en": "at the second realization, the Wise One awakened ninety koṭis.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:5.1", "PA_bv_10:5.2"], "en": "And when the Buddha Paduma exhorted his own son,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:5.3"], "en": "there were then eighty koṭis—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:5.4"], "en": "The third realization occurred.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:6.1", "PA_bv_10:6.2"], "en": "There were three assemblies for the Great Seer Paduma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:6.3", "PA_bv_10:6.4", "PA_bv_10:7.1"], "en": "There was a first gathering of one hundred thousand koṭis at the time of the spreading of the Kathina cloth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:7.2"], "en": "When the kaṭhina robe-material had been produced,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:7.3", "PA_bv_10:7.4"], "en": "the monks sewed the robe for the sake of the General of the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:8.1"], "en": "Then those stainless bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:8.2"], "en": "possessing the sixfold direct knowledge and great psychic power,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:8.3"], "en": "numbered three hundred thousand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:8.4"], "en": "They were victorious and unconquered.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:9.1", "PA_bv_10:9.2"], "en": "Furthermore, that bull among men went to dwell in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:9.3", "PA_bv_10:9.4"], "en": "At that time, there was a gathering of two hundred thousand; I,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:10.1"], "en": "at that period, [was among them].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:10.2"], "en": "I was a lion, the lord of beasts;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:10.3", "PA_bv_10:10.4"], "en": "in the forest, I saw the Conqueror cultivating solitude.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:11.1", "PA_bv_10:11.2"], "en": "Having bowed his head at his feet and performed a circumambulation three times,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:11.3"], "en": "he uttered a cry of joy.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:11.4"], "en": "I attended upon the Victor for seven days.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:12.1", "PA_bv_10:12.2"], "en": "After emerging from a sublime meditative attainment, the Tathāgata—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:12.3"], "en": "Having reflected with his mind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:12.4"], "en": "he summoned ten million bhikkhus;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:13.1"], "en": "even then, that Great Hero—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:13.2"], "en": "In their midst he made this declaration:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:13.3"], "en": "\"In immeasurable aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:13.4"], "en": "this one shall become a Buddha.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:14.1"], "en": "Having exerted ourselves in striving,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:14.2", "PA_bv_10:14.3"], "en": "…pe… we shall stand face-to-face with him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:15.1"], "en": "Having heard her words as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:15.2"], "en": "my mind became even more serene;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:15.3"], "en": "I resolved upon a further vow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:15.4"], "en": "For the fulfillment of the ten perfections:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:16.1"], "en": "there was a city named Campaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:16.2"], "en": "and a kshatriya named Asama.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:16.3", "PA_bv_10:16.4"], "en": "The mother of the Great Seer Paduma was named Asamā;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:17.1"], "en": "for ten thousand years, she...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:17.2"], "en": "He dwelt in a house;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:17.3", "PA_bv_10:17.4"], "en": "there were three supreme palaces: Nanda, Vasu, and Yasuttara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:18.1"], "en": "And thirty-three thousand women,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:18.2"], "en": "beautifully adorned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:18.3"], "en": "that woman named Uttarā—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:18.4"], "en": "You were named Rama, the son of Atri.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:19.1"], "en": "Having seen four omens,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:19.2"], "en": "you went forth by means of a chariot.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:19.3"], "en": "For eight months less one,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:19.4"], "en": "the Conqueror exerted himself in striving;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:20.1"], "en": "being entreated by Brahmā, he [arose].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:20.2"], "en": "Paduma, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:20.3", "PA_bv_10:20.4"], "en": "the Great Hero, set the Wheel in motion at the supreme Dhanañjaya Grove.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:21.1", "PA_bv_10:21.2"], "en": "Sāla and Upasāla were his chief disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:21.3"], "en": "he whose name was Varuṇa was his attendant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:21.4"], "en": "Of Paduma, the Great Seer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:22.1", "PA_bv_10:22.2"], "en": "Rādhā and Surādhā were the two chief female disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:22.3", "PA_bv_10:22.4"], "en": "The enlightenment of that Blessed One is called Mahāsoṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:23.1"], "en": "it is indeed superior and peerless.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:23.2", "PA_bv_10:23.3", "PA_bv_10:23.4"], "en": "Ruci and Nandarāmā were their chief female attendants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:24.1", "PA_bv_10:24.2"], "en": "The Great Sage has risen eighty cubits high;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:24.3"], "en": "his radiance streams forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:24.4"], "en": "All directions are entirely incomparable:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:25.1"], "en": "the radiance of the moon, the radiance of the sun,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:25.2"], "en": "and the radiance of the crest-jewels of the foremost gems.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:25.3", "PA_bv_10:25.4"], "en": "They all were destroyed upon reaching the supreme state enjoyed by the Conqueror.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:26.1"], "en": "For a hundred thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:26.2"], "en": "As long as life remained,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:26.3", "PA_bv_10:26.4"], "en": "for that long he stayed and delivered many people.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:27.1", "PA_bv_10:27.2"], "en": "Having fully awakened those beings whose minds were mature,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:27.3"], "en": "and having instructed those who remained;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:27.4"], "en": "He has attained Nibbāna along with his disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:28.1"], "en": "like a snake shedding its worn-out skin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:28.2"], "en": "or like a tree that has shed its old leaves.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:28.3"], "en": "Having abandoned all conditioned things,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:28.4"], "en": "he is extinguished like a flame; the Victorious One,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:29.1"], "en": "the Teacher, is like a lotus.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:29.2"], "en": "He attained Nibbāna in the Garden of Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:29.3", "PA_bv_10:29.4"], "en": "his relics were distributed throughout various regions.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_10:30.1"], "en": "The eighth chapter is the lineage of the Blessed One Paduma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
