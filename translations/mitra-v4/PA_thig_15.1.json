[
{"segs": ["PA_thig_15.1:0.1", "PA_thig_15.1:0.2"], "en": "Therīgāthā 15.1: The Chapter of Forty (Cattālīsanipāta),", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:0.3"], "en": "The Verses of the Elder Nun Isidāsī (Isidāsītherīgāthā)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:1.1"], "en": "In the city named Kusuma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:1.2"], "en": "the ornament of the earth, Pāṭaliputta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:1.3"], "en": "those born of the noble Śākya clan—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:1.4"], "en": "For there were two virtuous bhikkhunīs:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:2.1"], "en": "one among them was Isidāsī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:2.2"], "en": "and the second was Bodhī, both endowed with moral discipline.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:2.3"], "en": "Delighting in meditation and reflection,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:2.4"], "en": "highly learned, and having shaken off the defilements—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:3.1"], "en": "having wandered for alms, they...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:3.2"], "en": "Having performed their meal duties and washed their bowls,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:3.3", "PA_thig_15.1:3.4"], "en": "they sat down comfortably in a secluded place and uttered these words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:4.1"], "en": "“Noble lady, you are serene;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:4.2"], "en": "Isidāsi, your youth has not faded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:4.3"], "en": "What have you seen that causes this agitation?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:4.4"], "en": "Then she was devoted to renunciation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:5.1", "PA_thig_15.1:5.2"], "en": "Thus devoted, she, skilled in teaching the Dhamma in secluded places, remained there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:5.3"], "en": "Isidāsī spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:5.4"], "en": "“Listen, Bodhi, to how I went forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:6.1"], "en": "“In the excellent city of Ujjain,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:6.2"], "en": "My father was a merchant restrained by virtue;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:6.3"], "en": "I am his only daughter,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:6.4"], "en": "beloved, pleasing, and dear to him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:7.1", "PA_thig_15.1:7.2"], "en": "Then, from Sāketa, excellent men of supreme lineage arrived at my place:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:7.3"], "en": "a guild-president possessing abundant wealth and jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:7.4"], "en": "My father gave that daughter-in-law to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:8.1", "PA_thig_15.1:8.2"], "en": "Approaching her every evening and morning, she paid homage to her mother-in-law and father-in-law.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:8.3"], "en": "I place my head at his feet;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:8.4"], "en": "I pay homage as I have been instructed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:9.1"], "en": "This [instruction] which belongs to my husband—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:9.2"], "en": "Whether they were sisters or the brother's attendants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:9.3"], "en": "upon seeing even a single one of them,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:9.4"], "en": "we would become anxious and offer them a seat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:10.1"], "en": "With food and drink,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:10.2"], "en": "with snacks and whatever else is stored there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:10.3"], "en": "I cover [the needs] and provide them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:10.4"], "en": "And whatever was appropriate for him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:11.1"], "en": "having attended at the proper time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:11.2"], "en": "I approached his house at the threshold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:11.3"], "en": "Washing my hands and feet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:11.4"], "en": "with palms joined together, I approached my husband.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:12.1"], "en": "[I brought] a stool, a footstool, and a mirror.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:12.2"], "en": "Taking up a mirror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:12.3"], "en": "like a woman performing her toilet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:12.4"], "en": "I myself adorn my husband.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:13.1"], "en": "I prepare the rice myself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:13.2"], "en": "and I wash the vessel myself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:13.3"], "en": "just as a mother does for her only son.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:13.4"], "en": "In that same way, I serve my husband.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:14.1"], "en": "Thus, toward me— who am full of devotion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:14.2"], "en": "affectionate, diligent, and humble— [he acts].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:14.3", "PA_thig_15.1:14.4"], "en": "A husband finds fault with his wife who is industrious, untiring, and virtuous;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:15.1"], "en": "he [neglects] both mother and father.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:15.2"], "en": "He said: \"I shall depart after taking my leave;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:15.3", "PA_thig_15.1:15.4"], "en": "I will not dwell together with Isidāsī, nor will I live under one roof with her.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:16.1"], "en": "\"Do not speak thus, my son;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:16.2"], "en": "Isidāsī is wise and discerning,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:16.3"], "en": "industrious and untiring.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:16.4", "PA_thig_15.1:17.1"], "en": "“What is it that does not please you, my son? “Nothing at all harms me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:17.2"], "en": "nor do I desire to consort with the seer’s daughter.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:17.3"], "en": "“Enough for me, enough for me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:17.4"], "en": "Having taken my leave, I shall go.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:18.1"], "en": "Having heard his words, [the king said:]", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:18.2"], "en": "My mother-in-law and father-in-law questioned me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:18.3"], "en": "\"What wrong have you done?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:18.4"], "en": "Speak freely and truthfully.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:19.1"], "en": "“I have committed no offense here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:19.2", "PA_thig_15.1:19.3"], "en": "nor do I harm anyone, nor do I speak harsh words; what can you do to me?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:19.4", "PA_thig_15.1:20.1"], "en": "\"Since my husband will despise me,\" they led me back to my father's house,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:20.2"], "en": "dejected and overcome by grief.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:20.3", "PA_thig_15.1:20.4", "PA_thig_15.1:21.1"], "en": "Protecting me, my father gave me to him, saying, \"We have won this beautiful Lakṣmī.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:21.2"], "en": "In the house of a wealthy second-rank merchant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:21.3", "PA_thig_15.1:21.4"], "en": "therefore, O merchant, acquire me for half that price.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:22.1"], "en": "I lived for a month in his house,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:22.2"], "en": "and he received me with hospitality;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:22.3"], "en": "I served him like a maidservant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:22.4"], "en": "My father speaks of one who is blameless,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:23.1"], "en": "perfected in virtue, wandering for alms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:23.2"], "en": "a tamer who is himself tamed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:23.3"], "en": "“You shall be my son-in-law;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:23.4"], "en": "set aside the slate and the tally-stick.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:24.1"], "en": "He too, having stayed for a fortnight, departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:24.2"], "en": "Then he said to his father: “Give me my bowl;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:24.3", "PA_thig_15.1:24.4"], "en": "give me a water-pot and a begging-bowl, for I shall go out once more to wander for alms.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:25.1"], "en": "Then his father said to him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:25.2", "PA_thig_15.1:25.3"], "en": "\"Mother, and all my circle of kinsmen: 'What is it that you do not gain here?'\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:25.4"], "en": "\"Speak quickly, and we shall do it for you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:26.1"], "en": "Being addressed thus, he says:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:26.2"], "en": "\"If my self is able, that is enough for me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:26.3"], "en": "\"I shall not dwell with Isidāsī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:26.4", "PA_thig_15.1:27.1"], "en": "nor shall I live under one roof with her. Having been dismissed, he departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:27.2"], "en": "I too am reflecting all alone:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:27.3"], "en": "\"Having taken my leave, I shall go—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:27.4"], "en": "either to die or to enter the homeless life.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:28.1"], "en": "Then the noble lady Jinadattā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:28.2", "PA_thig_15.1:28.3"], "en": "a bearer of the Vinaya, came to her father’s family home while wandering for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:28.4"], "en": "She was learned and endowed with virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:29.1", "PA_thig_15.1:29.2"], "en": "Seeing her, I rose from my seat and prepared a seat for her.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:29.3", "PA_thig_15.1:29.4"], "en": "And having bowed at the feet of her who was seated, I gave her food;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:30.1"], "en": "with both food and drink, I served her.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:30.2", "PA_thig_15.1:30.3"], "en": "Having satisfied her with solid food and whatever else was stored there, I said,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:30.4"], "en": "\"Noble lady, I wish to go forth.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:31.1"], "en": "Then my father said to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:31.2"], "en": "\"My son, practice the Dhamma right here;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:31.3"], "en": "[provide] with food and drink,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:31.4"], "en": "“Satisfy the ascetics and the twice-born.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:32.1", "PA_thig_15.1:32.2"], "en": "Then, weeping and extending my joined palms in reverence, I spoke to my father:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:32.3"], "en": "‘Evil indeed has been done by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:32.4"], "en": "I shall exhaust that kamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:33.1"], "en": "Then my father said to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:33.2"], "en": "\"May you attain enlightenment and the supreme Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:33.3"], "en": "may you obtain Nirvana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:33.4"], "en": "which the Best of Bipeds has realized.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:34.1"], "en": "Having paid homage to her mother and father,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:34.2"], "en": "and to the entire assembly of her kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:34.3"], "en": "she went forth into homelessness for seven days.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:34.4"], "en": "I have realized the threefold knowledge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:35.1"], "en": "I know my own seven births,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:35.2"], "en": "the fruit and result of which is this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:35.3"], "en": "I shall declare that to you;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:35.4"], "en": "listen with a single-minded focus.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:36.1"], "en": "In the city of Erakaccha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:36.2"], "en": "I was a goldsmith of great wealth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:36.3"], "en": "intoxicated by the pride of youth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:36.4"], "en": "I consorted with another's wife.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:37.1"], "en": "Thus, having passed away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:37.2"], "en": "I was cooked for a long time in the fires of hell;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:37.3"], "en": "then, having emerged from that, I arose.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:37.4"], "en": "I entered the womb of a female monkey.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:38.1"], "en": "When I was seven days old,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:38.2"], "en": "the Great Monkey, the leader of the troop, stripped me naked.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:38.3"], "en": "This is the fruit of that deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:38.4"], "en": "just as for one who has gone to another's wife.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:39.1"], "en": "Having passed away from there, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:39.2"], "en": "Having passed away in the Sindhava forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:39.3", "PA_thig_15.1:39.4"], "en": "I entered the womb of a female goat that was both one-eyed and lame.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:40.1"], "en": "For twelve years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:40.2"], "en": "having carried children while being shaven-headed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:40.3"], "en": "I was encircled by worms and unfit [for work].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:40.4"], "en": "Just as one who, having gone to another's wife,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:41.1", "PA_thig_15.1:41.2"], "en": "falls from that state and is reborn as the calf of a cow belonging to a cattle-herder;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:41.3"], "en": "Vaccha was copper-red with lac,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:41.4"], "en": "and Nillacchita for twelve months;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:42.1"], "en": "having harnessed the plough, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:42.2"], "en": "And I carry a cart; blind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:42.3"], "en": "encumbered, and infirm,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:42.4"], "en": "just like one who has gone to another's wife.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:43.1"], "en": "Having passed away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:43.2"], "en": "I was born in the house of a street slave-girl;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:43.3"], "en": "I was neither woman nor man.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:43.4"], "en": "Just as one who, having gone to another's wife,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:44.1"], "en": "died at the age of thirty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:44.2"], "en": "was reborn as a girl in a family of cartwrights;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:44.3"], "en": "In that place which was miserable and destitute,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:44.4"], "en": "where creditors were constantly pressing for payment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:45.1"], "en": "the caravan leader [rescued] me from there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:45.2"], "en": "Having torn her away from her family home,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:45.3"], "en": "he drags off the one who laments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:45.4"], "en": "despite her abundant and vast prosperity.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:46.1"], "en": "Then, in my sixteenth year,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:46.2"], "en": "having seen me reached the bloom of youth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:46.3"], "en": "the son of Oruṇḍhati—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:46.4"], "en": "He was named Giridāsa by name.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:47.1"], "en": "He also had another wife,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:47.2"], "en": "who was virtuous, endowed with good qualities, and renowned.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_15.1:47.3"], "en": "She was devoted to her husband,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_15.1:47.4"], "en": "yet I caused her to be reviled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_15.1:48.1"], "en": "this is the fruit of that deed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_15.1:48.2"], "en": "\"Even that which they go away having cast me out,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_15.1:48.3"], "en": "while I was serving like a slave—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_15.1:48.4"], "en": "that too has been included within my [reckoning].\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_15.1:49.1", "PA_thig_15.1:50.1"], "en": "… The Elder Nun Isidāsī … The Forty-Fourth Chapter is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"}
]
