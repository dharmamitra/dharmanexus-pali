[
{"segs": ["PA_tha-ap_462:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:0.2"], "en": "The Chapter on the Giver of the Earth (Jagatidāyakavagga), Number 10:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:0.3"], "en": "The Apadāna of the Elder Gandhapūjaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:1.1", "PA_tha-ap_462:1.2"], "en": "While the funeral pyres were being prepared and various fragrances were being gathered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:1.3"], "en": "with a clear mind and a joyful heart, he said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:1.4"], "en": "I offered a handful of fragrant powder.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:2.1"], "en": "One hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:2.2"], "en": "I honored a funeral pyre.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:2.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:2.4"], "en": "this is the fruit of worshiping the reliquary.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:3.1"], "en": "The defilements have been incinerated by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:3.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:3.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:4.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:4.2", "PA_tha-ap_462:4.3"], "en": "... [and so on] ... the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:5.1"], "en": "The four analytical knowledges (paṭisambhidā) have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:5.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:5.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:6.1"], "en": "Thus indeed did the venerable elder Gandhapūjaka recite these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:7.1"], "en": "The legend of the Elder Gandhapūjaka is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:8.1", "PA_tha-ap_462:9.1"], "en": "The forty-sixth chapter is the Jagatidāyaka-vagga. Its summary (uddāna) is as follows:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:10.1"], "en": "Jagatī, Morahatthī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:10.2"], "en": "Āsanī, Ukkadhāraka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:10.3"], "en": "he stepped upon Vanakoraṇḍī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:10.4"], "en": "Chattada, Jātipūjaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:11.1"], "en": "the elder Paṭṭipupphī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:11.2"], "en": "and the tenth, Gandhapūjaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_462:11.3", "PA_tha-ap_462:11.4"], "en": "And sixty-seven verses have been counted by those who possess discernment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
