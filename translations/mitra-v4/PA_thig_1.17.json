[
{"segs": ["PA_thig_1.17:0.1", "PA_thig_1.17:0.2"], "en": "Therīgāthā 1.17 Ekakanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.17:0.3"], "en": "Dhammā Therīgāthā", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.17:1.1"], "en": "Having wandered for alms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.17:1.2"], "en": "leaning on a staff, weak,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.17:1.3"], "en": "with limbs trembling, [he went home].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.17:1.4"], "en": "I fell right there upon the ground;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.17:1.5"], "en": "having seen the peril in the body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.17:1.6"], "en": "my mind was then liberated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.17:2.1"], "en": "… The Elder Nun Dhammā …", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
