[
{"segs": ["PA_thag_1.40:0.1", "PA_thag_1.40:0.2", "PA_thag_1.40:0.3"], "en": "Theragāthā 1.40 Ekakanipāta Catutthavagga (The Fourth Chapter of the Single Verses)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:0.4"], "en": "The Verses of the Elder Vaḍḍhamāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:1.1"], "en": "“As if struck by a spear,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:1.2"], "en": "as if my head were on fire;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:1.3"], "en": "“For the abandoning of lust for existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:1.4"], "en": "let a bhikkhu wander mindfully.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:1.5"], "en": "… Elder Vaḍḍhamāna …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:1.6"], "en": "The fourth chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:2.0"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:2.1"], "en": "Gahvaratīriya, Suppiya, ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:2.2"], "en": "Sopāka and Posiya;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:2.3"], "en": "Sāmaññakāni and Kumāputta;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:2.4"], "en": "and Kumāputta’s companion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:2.5"], "en": "Gavampati, the Elder Tissa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.40:2.6"], "en": "increasing in stature and great in fame.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
