[
{"segs": ["PA_ja_439:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:0.2"], "en": "The Collection of Ten,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:0.3"], "en": "Chapter on the Four Gates (Catudvāravagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:0.4"], "en": "1. The Catudvāra Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:1.1", "PA_ja_439:1.2"], "en": "“This city has four gates, with iron walls and strong ramparts;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:1.3"], "en": "\"I am besieged and obstructed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:1.4"], "en": "what evil deed have I committed?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:2.1"], "en": "\"All the doors are closed.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:2.2"], "en": "\"I am trapped like a bird;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:2.3"], "en": "for what reason, O Yakkha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:2.4"], "en": "have I been struck by this wheel?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:3.1", "PA_ja_439:3.2", "PA_ja_439:3.3"], "en": "Having received more than two hundred thousand [pieces of gold] from my compassionate kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:3.4"], "en": "He did not do as he was told.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:4.1"], "en": "He leapt into the ocean,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:4.2"], "en": "the sea that yields few rewards.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:4.3"], "en": "From four he attained eight,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:4.4", "PA_ja_439:5.1"], "en": "and from eight, sixteen; and from sixteen, thirty-two.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:5.2"], "en": "One who encounters the wheel does so against their will;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:5.3"], "en": "for a person overcome by desire,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:5.4"], "en": "the wheel whirls upon the head.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:6.1"], "en": "Vast above, difficult to fill,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:6.2"], "en": "desire spreads far and wide;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:6.3"], "en": "and those who greedily pursue it—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:6.4", "PA_ja_439:7.1"], "en": "They become holders of the wheel. Having abandoned their many possessions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:7.2"], "en": "they do not examine the path.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:7.3", "PA_ja_439:7.4"], "en": "Those for whom this is unconditioned are the bearers of the wheel;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:8.1"], "en": "they examine their karma and their abundant wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:8.2"], "en": "One should not pursue a desire that leads to harm;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:8.3"], "en": "one should act according to the words of those who are compassionate,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:8.4"], "en": "and one should not overstep such a person’s guidance.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:9.1"], "en": "“How long, O Yakkha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:9.2"], "en": "will the wheel remain upon my head?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:9.3"], "en": "For how many thousands of years?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:9.4"], "en": "\"Tell me that when you are asked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:10.1"], "en": "\"Atisara and Paccasara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:10.2"], "en": "O Mittavinda, listen to me:\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:10.3"], "en": "“The wheel has struck your head;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:10.4"], "en": "you shall not escape with your life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_439:11.1"], "en": "The First Jātaka: The Four-Gated City.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
