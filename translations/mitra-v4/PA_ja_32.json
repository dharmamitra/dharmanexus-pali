[
{"segs": ["PA_ja_32:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_32:0.2", "PA_ja_32:0.3"], "en": "Ekakanipāta, Kulāvakavagga (The Chapter on the Bird’s Nest)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_32:0.4"], "en": "2. The Nacca Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_32:1.1", "PA_ja_32:1.2"], "en": "“The weeping was charming, the back was beautiful, and the neck had the hue of beryl.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_32:1.3"], "en": "\"And since your feathers are only a span in length,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_32:1.4"], "en": "I will not give my daughter to you on account of your dancing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_32:2.1"], "en": "Thus ends the second Jātaka, the Nacca-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
