[
{"segs": ["PA_thag_6.1:0.1", "PA_thag_6.1:0.2"], "en": "Theragāthā 6.1 Chakkanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:0.3"], "en": "First Chapter (Paṭhamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:0.4"], "en": "The Verses of the Elder Uruvelakassapa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:1.1", "PA_thag_6.1:1.2"], "en": "“Having seen the miracles of the illustrious Gotama,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:1.3"], "en": "I did not yet prostrate myself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:1.4"], "en": "deceived by the pride of lordship;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:2.1"], "en": "[only] after he understood my intention—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:2.2"], "en": "\"You have been made a charioteer of men\";", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:2.3"], "en": "then there arose in me a sense of urgency,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:2.4"], "en": "extraordinary and hair-raising.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:3.1", "PA_thag_6.1:3.2", "PA_thag_6.1:3.3"], "en": "Having then cast aside that limited supernatural power which I possessed while formerly being a matted-hair ascetic, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:3.4"], "en": "I went forth in the teaching of the Victor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:4.1"], "en": "Previously satisfied with sacrifice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:4.2"], "en": "I was preoccupied with the realm of desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:4.3"], "en": "Afterward, I uprooted lust, hatred,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:4.4"], "en": "and delusion as well;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:5.1"], "en": "I know my former births.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:5.2"], "en": "The divine eye was purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:5.3"], "en": "possessing supernormal power and knowing the minds of others,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:5.4"], "en": "I attained the divine ear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:6.1", "PA_thag_6.1:6.2"], "en": "That purpose for which I went forth from the home life into homelessness—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:6.3"], "en": "that goal has been attained by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:6.4"], "en": "“The destruction of all fetters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.1:6.5"], "en": "… The Elder Uruvelakassapa … [said this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
