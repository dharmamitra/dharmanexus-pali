[
{"segs": ["PA_tha-ap_311:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:0.2"], "en": "The Chapter on the Lotus-Filaments (Padumakesaravagga), Number Nine:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:0.3"], "en": "The Apadāna of the Elder Buddhasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:1.1"], "en": "Like the rising sun with its hundred rays,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:1.2"], "en": "like the sun with its golden beams—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:1.3"], "en": "tranquil and dwelling within the forest depths.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:1.4"], "en": "The eldest in the world, the bull among men—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:2.1", "PA_tha-ap_311:2.2"], "en": "Siddhattha, the Leader of the World— I saw him in a dream.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:2.3"], "en": "Having inspired confidence in my mind there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:2.4"], "en": "I was reborn in a happy destination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:3.1"], "en": "Ninety-four aeons ago...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:3.2"], "en": "The perception I attained at that time—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:3.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:3.4"], "en": "this is the fruit of the perception of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:4.1", "PA_tha-ap_311:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:4.3"], "en": "[and so forth] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:5.1"], "en": "Thus indeed the venerable elder Buddhasaññaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_311:6.1"], "en": "This is the ninth legend of the elder Buddhasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
