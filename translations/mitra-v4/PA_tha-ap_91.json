[
{"segs": ["PA_tha-ap_91:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:0.2"], "en": "Timiravagga 9.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:0.3"], "en": "The Apadāna of the Elder Bodhisiñcaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:1.1"], "en": "“For the Blessed One Vipassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:1.2"], "en": "there was a great festival for the Bodhi tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:1.3"], "en": "having become one who has gone forth, he remained there.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:1.4"], "en": "I approached at that time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:2.1"], "en": "taking water with flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:2.2"], "en": "I sprinkled it upon the Bodhi tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:2.3"], "en": "He will liberate us, being himself liberated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:2.4"], "en": "he will extinguish us, being himself extinguished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:3.1"], "en": "Ninety-one aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:3.2"], "en": "I consecrated the Bodhi tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:3.3"], "en": "I do not know a state of misery—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:3.4"], "en": "this is the fruit of the Bodhi-consecration.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:4.1"], "en": "In the thirty-third eon that was passing away,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:4.2", "PA_tha-ap_91:4.3"], "en": "there were lords of men known as the Udakasecanas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:4.4"], "en": "These eight are wheel-turning monarchs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:5.1", "PA_tha-ap_91:5.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:6.1"], "en": "Thus indeed did the venerable elder Bodhisiñcaka recite these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_91:7.1"], "en": "This is the ninth legend of the elder Bodhisiñcaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
