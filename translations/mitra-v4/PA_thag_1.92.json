{"segs": ["PA_thag_1.92:0.2", "PA_thag_1.92:0.3"], "en": "Dasamavagga (The Tenth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.92:0.4"], "en": "The Verse of the Elder Vijaya:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.92:1.1"], "en": "“He whose taints are utterly destroyed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.92:1.2"], "en": "who is independent of nutriment;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.92:1.3", "PA_thag_1.92:1.4"], "en": "For whom the sphere of experience is the void and the signless liberation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.92:1.5"], "en": "like birds in the sky—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.92:1.6"], "en": "“His path is difficult to follow. ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.92:1.7"], "en": "Thus spoke the Elder Vijaya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
