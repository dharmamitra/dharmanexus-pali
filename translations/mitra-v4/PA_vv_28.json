[
{"segs": ["PA_vv_28:0.1"], "en": "Vimānavatthu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:0.2", "PA_vv_28:0.3"], "en": "The Chapter on the Cittalatā Grove, from the Itthivimāna (The Female Vimānas)", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:0.4"], "en": "11. The Second Mansion of the Almsgiver of Food “O deity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:1.1", "PA_vv_28:1.2"], "en": "you who stand there with such exquisite beauty;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:1.3", "PA_vv_28:1.4"], "en": "Illuminating all directions like a star among the herbs—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:2.1"], "en": "by what cause is your complexion such as this?", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:2.2", "PA_vv_28:2.3"], "en": "\"...and your radiance illuminates all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:3.1"], "en": "That deity was uplifted in mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:3.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:3.3"], "en": "the fruit of which action is this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:4.1"], "en": "\"When I was among humans, having become a human...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:4.2"], "en": "In a previous birth in the human world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:5.1"], "en": "I saw a stainless monk,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:5.2"], "en": "serene and undisturbed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:5.3"], "en": "To him I gave almsfood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:5.4"], "en": "with my own hands, full of faith.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:6.1"], "en": "Because of that, such is my complexion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:6.2", "PA_vv_28:6.3"], "en": "\"...and my radiance shines in all directions. Thus ends the eleventh *Vimānavatthu*,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:7.1"], "en": "the Second Story of the Almsgiver of Food.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:8.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:9.1"], "en": "The female slave, and Lakhumā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:9.2"], "en": "and then the giver of rinsing water;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:9.3"], "en": "Caṇḍālī and Bhadditthī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:9.4"], "en": "Soṇadinnā and Uposathā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:9.5"], "en": "Niddā and Suniddā—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:9.6"], "en": "And two [goddesses] who gave almsfood;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:9.7", "PA_vv_28:10.1"], "en": "by this, the chapter is called the Second Chapter in the *Itthivimāna*.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_28:11.1"], "en": "The first recitation section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"}
]
