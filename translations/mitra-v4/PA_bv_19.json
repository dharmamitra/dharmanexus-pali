[
{"segs": ["PA_bv_19:0.1"], "en": "Buddhavamsa 19.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:0.2"], "en": "The Lineage of Tissa Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:1.1"], "en": "\"After Siddhattha...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:1.2"], "en": "Peerless and without rival,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:1.3"], "en": "of infinite majesty and immeasurable fame,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:1.4"], "en": "Tissa is the leader supreme in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:2.1", "PA_bv_19:2.2"], "en": "Having dispelled that darkness and illuminated the world with its devas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:2.3"], "en": "the compassionate Great Hero—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:2.4"], "en": "The One with Vision arose in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:3.1"], "en": "His too was incomparable psychic power,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:3.2"], "en": "and his virtue and concentration were incomparable.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:3.3"], "en": "Having reached perfection in all respects,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:3.4"], "en": "he set the Wheel of Dhamma in motion.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:4.1"], "en": "That Buddha [reigned] over the ten-thousandfold world system.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:4.2"], "en": "He made his pure speech understood;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:4.3", "PA_bv_19:4.4"], "en": "one hundred koṭis attained realization during that first teaching of the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:5.1"], "en": "The second [assembly] was ninety million,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:5.2"], "en": "the third sixty million;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:5.3"], "en": "he liberated them from their bonds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:5.4"], "en": "At that time, there were beings among humans and gods;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:6.1", "PA_bv_19:6.2"], "en": "there were three assemblies under Tissa, the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:6.3"], "en": "Of those whose taints are destroyed, who are stainless,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:6.4"], "en": "whose minds are peaceful, and who are steadfast—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:7.1"], "en": "of those hundreds of thousands with taints destroyed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:7.2"], "en": "The first assembly was held;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:7.3", "PA_bv_19:7.4"], "en": "the second assembly consisted of nine million.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:8.1", "PA_bv_19:8.2", "PA_bv_19:8.3"], "en": "There was a third assembly of one hundred and eighty thousand who were stainless and whose taints were destroyed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:8.4", "PA_bv_19:9.1"], "en": "Of those who have blossomed through liberation. At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:9.2"], "en": "I was a kshatriya named Sujāta;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:9.3"], "en": "Having abandoned great wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:9.4"], "en": "I went forth into the ascetic life of a seer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:10.1"], "en": "While I was thus gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:10.2"], "en": "The Leader of the World arose;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:10.3", "PA_bv_19:10.4"], "en": "hearing the word \"Buddha,\" joy arose within me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:11.1", "PA_bv_19:11.2", "PA_bv_19:11.3"], "en": "Taking up with both hands the celestial mandārava flower, the paduma, and the pārichattaka;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:11.4"], "en": "Shaking [the dust], I approached Tissa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:12.1", "PA_bv_19:12.2"], "en": "the leader of the world, who was surrounded by a retinue of four castes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:12.3"], "en": "Taking that flower,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:12.4"], "en": "I held it over the head of the Jina.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:13.1"], "en": "That Buddha, too, gave me this prediction:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:13.2"], "en": "Sitting in the midst of the people, he declared:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:13.3"], "en": "“In ninety-two aeons from now,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:13.4"], "en": "this one shall become a Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:14.1", "PA_bv_19:14.2"], "en": "Having exerted ourselves in striving, ...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:14.3"], "en": "we shall stand face-to-face with him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:15.1"], "en": "Having heard her words as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:15.2"], "en": "my heart became even more serene;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:15.3"], "en": "I resolved upon an even higher vow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:15.4"], "en": "For the fulfillment of the ten perfections.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:16.1"], "en": "There was a city named Khemaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:16.2"], "en": "and a kshatriya named Janasandha;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:16.3", "PA_bv_19:16.4"], "en": "The mother of the Great Seer Tissa was named Padumā;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:17.1"], "en": "for seven thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:17.2"], "en": "He dwelt in a house;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:17.3", "PA_bv_19:17.4"], "en": "there were three supreme palaces: one made of caves, one of stone, and one of women.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:18.1", "PA_bv_19:18.2"], "en": "Thirty thousand women, beautifully adorned, [were there],", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:18.3"], "en": "and the woman named Subhaddā—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:18.4"], "en": "His biological son was named Ānanda.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:19.1"], "en": "Having seen four omens,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:19.2"], "en": "he went forth on horseback.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:19.3"], "en": "For seven months and seven days less eight,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:19.4"], "en": "the Victor exerted himself in striving;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:20.1"], "en": "being entreated by Brahmā, he [arose].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:20.2"], "en": "The Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:20.3", "PA_bv_19:20.4"], "en": "the Great Hero, turned the Wheel in the most excellent city of Yasavatī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:21.1", "PA_bv_19:21.2"], "en": "Brahmadeva and Udaya were his chief disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:21.3"], "en": "his attendant was named Samaṅga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:21.4"], "en": "And for Tissa the Great Seer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:22.1", "PA_bv_19:22.2"], "en": "Phussā and Sudattā were the two chief female disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:22.3", "PA_bv_19:22.4"], "en": "The seat of that Blessed One is called Bodhi;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:23.1"], "en": "it is both glorious and auspicious.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:23.2", "PA_bv_19:23.3", "PA_bv_19:23.4"], "en": "Kisāgotamī and Upasenā were their chief attendants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:24.1"], "en": "Thus the Buddha, the Victor,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:24.2"], "en": "was sixty ratanas in height;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:24.3"], "en": "he was peerless and without equal.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:24.4"], "en": "He appeared like the Himavat mountain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:25.1"], "en": "And for that one of incomparable splendor,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:25.2"], "en": "there was unsurpassed longevity.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:25.3"], "en": "For one hundred thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:25.4"], "en": "the Visionary One remained in the world—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:26.1"], "en": "supreme, excellent, and most sublime.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:26.2", "PA_bv_19:26.3"], "en": "Having experienced great glory and having blazed like a mass of fire,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:26.4"], "en": "he has attained Nibbāna together with his disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:27.1"], "en": "Like a cloud by the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:27.2"], "en": "like a festival by the sun,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:27.3"], "en": "like darkness by a lamp—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:27.4"], "en": "He has attained Nibbāna along with his disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:28.1"], "en": "The Buddha, the most excellent Conqueror Tissa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:28.2"], "en": "attained Nibbāna at Nandārāma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:28.3"], "en": "Right there his Jina-stupa rises three yojanas high.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:28.4"], "en": "Thus ends the seventeenth chapter:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_19:29.1"], "en": "the lineage of the Blessed One Tissa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
