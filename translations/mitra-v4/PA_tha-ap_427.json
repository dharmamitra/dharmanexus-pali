[
{"segs": ["PA_tha-ap_427:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:0.2"], "en": "Chapter on Those Who Swept Once (Sakiṃsammajjakavagga) 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:0.3"], "en": "The Apadāna of the Elder Koraṇḍapupphiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:1.1"], "en": "“In the past I was a forester;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:1.2"], "en": "having lost my father and mother,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:1.3"], "en": "I lived by the slaughter of animals.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:1.4"], "en": "\"No merit exists for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:2.1", "PA_tha-ap_427:2.2"], "en": "Near my dwelling, the Leader of the World, the Three [Jewels], [resided].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:2.3", "PA_tha-ap_427:2.4"], "en": "Out of compassion, the One with Vision showed him three footprints;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:3.1"], "en": "and having seen the footprint that had been stepped upon, he [followed].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:3.2"], "en": "To the Teacher named Tissa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:3.3"], "en": "with a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:3.4"], "en": "I gladdened my mind in his words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:4.1", "PA_tha-ap_427:4.2"], "en": "Having seen a *koraṇḍa* tree in full bloom growing from the earth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:4.3"], "en": "he took it along with its pot.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:4.4"], "en": "I worshipped the Best of Men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:5.1"], "en": "By that well-performed deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:5.2"], "en": "and by my intention and aspiration;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:5.3"], "en": "Having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:5.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:6.1"], "en": "Whichever womb I was reborn into, I...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:6.2"], "en": "Whether in the state of a god or a human,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:6.3", "PA_tha-ap_427:6.4"], "en": "may I become exceedingly radiant, with a complexion like that of the koraṇḍava flower.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:7.1"], "en": "In the ninety-two aeons since then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:7.2"], "en": "because of the deed I performed back then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:7.3"], "en": "I do not recall ever being born in a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:7.4"], "en": "This is the fruit of worshipping the feet:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:8.1", "PA_tha-ap_427:8.2"], "en": "my defilements have been incinerated... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:8.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:9.1", "PA_tha-ap_427:9.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:9.3"], "en": "The Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:10.1", "PA_tha-ap_427:10.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:10.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:11.1"], "en": "Thus indeed did the venerable elder Koraṇḍapupphiya recite these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_427:12.1"], "en": "This is the fifth legend of the elder Koraṇḍapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
