[
{"segs": ["PA_thig_5.4:0.1", "PA_thig_5.4:0.2"], "en": "Therīgāthā 5.4 Pañcakanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:0.3"], "en": "The Verses of the Elder Nun Sundarīnandā", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:1.1", "PA_thig_5.4:1.2"], "en": "“Behold, Nanda, this body as ailing, impure, and putrid;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:1.3"], "en": "develop your mind upon the foul.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:1.4", "PA_thig_5.4:2.1", "PA_thig_5.4:2.2"], "en": "One-pointed and well-concentrated: as this is, so is that; as that is, so is this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:2.3"], "en": "It smells foul and putrid,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:2.4"], "en": "yet it is what fools delight in.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:3.1"], "en": "Thus one should contemplate this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:3.2"], "en": "Unwearied by day and night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:3.3"], "en": "I then, through my own wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:3.4"], "en": "saw with clear insight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:4.1", "PA_thig_5.4:4.2"], "en": "“As I was thus diligent and investigating with proper discernment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:4.3"], "en": "this body as it really is— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:4.4"], "en": "Having seen both the internal and the external,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:5.1", "PA_thig_5.4:5.2"], "en": "I then became disenchanted with the body and grew detached from within.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:5.3"], "en": "“Diligent, disengaged,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:5.4"], "en": "I am calmed and extinguished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_5.4:6.1"], "en": "… Thus spoke the elder nun Sundarīnandā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
