[
{"segs": ["PA_tha-ap_269:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:0.2"], "en": "The Section on the Throwing of the Lotus (Padumukkhipavagga) 7.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:0.3"], "en": "The Apadāna of the Elder Javahaṃsaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:1.1"], "en": "“On the bank of the Candabhāgā River,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:1.2"], "en": "I was then a forest-dweller;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:1.3"], "en": "I saw the Buddha Siddhattha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:1.4"], "en": "As he went along the path of the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:2.1", "PA_tha-ap_269:2.2"], "en": "raising his joined palms and gazing up at the Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:2.3"], "en": "Having gladdened my own mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:2.4"], "en": "I paid homage to the Leader.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:3.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:3.2", "PA_tha-ap_269:3.3", "PA_tha-ap_269:3.4"], "en": "I do not know a state of woe, for this is the fruit of worshipping the Bull among Men, whom Yama himself honors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:4.1", "PA_tha-ap_269:4.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:5.1"], "en": "Thus indeed did the venerable elder Javahaṃsaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_269:6.1"], "en": "This is the seventh legend of the elder Javahaṃsaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
