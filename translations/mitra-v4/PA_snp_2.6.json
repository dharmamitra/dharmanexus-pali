[
{"segs": ["PA_snp_2.6:0.1", "PA_snp_2.6:0.2", "PA_snp_2.6:1.1"], "en": "Sutta Nipāta 2.6 Kapilasutta (Dhammacariyasutta) The practice of Dhamma, the holy life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:1.2"], "en": "This they call the supreme treasure:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:1.3", "PA_snp_2.6:1.4"], "en": "even if one has gone forth from the home to the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:2.1"], "en": "If one is by nature talkative,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:2.2"], "en": "a fool who delights in harming others,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:2.3"], "en": "his life is worse [than death].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:2.4", "PA_snp_2.6:3.1", "PA_snp_2.6:3.2"], "en": "The monk who delights in quarreling and is shrouded by the nature of delusion increases his own enmity.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:3.3"], "en": "Even when it is explained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:3.4"], "en": "he does not understand the Dhamma taught by the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:4.1"], "en": "he brings harm to those whose minds are cultivated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:4.2"], "en": "Led by ignorance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:4.3"], "en": "one does not know defilement,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:4.4"], "en": "nor the path leading to hell.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:5.1"], "en": "Having fallen into a state of ruin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:5.2"], "en": "passing from womb to womb, from darkness to darkness—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:5.3"], "en": "such indeed is that monk.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:5.4"], "en": "Having passed away, he encounters suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:6.1", "PA_snp_2.6:6.2"], "en": "like a cesspit full for many years.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:6.3"], "en": "And whoever should be such as this,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:6.4"], "en": "he is indeed difficult to purify because of his blemishes.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:7.1"], "en": "Know him to be such as this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:7.2"], "en": "O monks, [avoid] one who is dependent on the household life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:7.3"], "en": "who has evil desires, evil intentions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:7.4"], "en": "and evil conduct and associations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:8.1"], "en": "Having all become united,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:8.2", "PA_snp_2.6:8.3"], "en": "drive him out; expel the kāraṇḍava weed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:8.4"], "en": "Cast out the dregs;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:9.1"], "en": "then drive away the chaff—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:9.2"], "en": "the non-recluses who pride themselves on being recluses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:9.3"], "en": "Having expelled those of evil desires,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:9.4"], "en": "who are of evil conduct and resort,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:10.1"], "en": "let the pure ones dwell in association with the pure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:10.2"], "en": "Live together in harmony, being mindful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:10.3"], "en": "then, being united and prudent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:10.4"], "en": "you will make an end of suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_2.6:10.5"], "en": "The Sixth Discourse: On Practicing the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
