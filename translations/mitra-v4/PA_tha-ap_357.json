[
{"segs": ["PA_tha-ap_357:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:0.2"], "en": "The Chapter on Those Who Perceived Sounds (Saddasaññaka-vagga), Number 5:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:0.3"], "en": "The Apadāna of the Elder Daṇḍadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:1.1", "PA_tha-ap_357:1.2"], "en": "“Having entered the forest grove and cut down a bamboo cane at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:1.3"], "en": "I made it my support.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:1.4"], "en": "I gave it to the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:2.1"], "en": "With that serene state of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:2.2"], "en": "having paid homage to the virtuous ones;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:2.3"], "en": "Having given even this object of focus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:2.4"], "en": "I departed facing north.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:3.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:3.2"], "en": "Because I did not give a blow back then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:3.3"], "en": "I do not know what an evil rebirth is;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:3.4"], "en": "this is the fruit of giving no blow.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:4.1", "PA_tha-ap_357:4.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:5.1"], "en": "Thus indeed the venerable elder Daṇḍadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_357:6.1"], "en": "This is the fifth legend of the elder Daṇḍadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
