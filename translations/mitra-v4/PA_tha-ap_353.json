[
{"segs": ["PA_tha-ap_353:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:0.2"], "en": "Chapter on Those Named after Sounds (Saddasaññakavagga), 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:0.3"], "en": "The Apadāna of the Elder Saddasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:1.1", "PA_tha-ap_353:1.2"], "en": "“In the past, I was a deer-hunter in the forest wilderness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:1.3"], "en": "there I saw the Perfectly Awakened One.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:1.4"], "en": "Honored by the assembly of gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:2.1"], "en": "proclaiming the Four Noble Truths,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:2.2"], "en": "and uplifting the great masses of people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:2.3"], "en": "I heard a sweet voice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:2.4"], "en": "resembling the cry of the karavīka bird,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:3.1"], "en": "the voice of the Sage with the Brahmā-like tone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:3.2", "PA_tha-ap_353:3.3"], "en": "Having gladdened my mind with the voice of Sikhin, the Kinsman of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:3.4"], "en": "I have attained the destruction of the taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:4.1"], "en": "In the thirty-first aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:4.2"], "en": "because of the deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:4.3"], "en": "I do not know a state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:4.4"], "en": "This is the fruit of serene confidence:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:5.1", "PA_tha-ap_353:5.2"], "en": "the four analytical knowledges and these eight liberations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:5.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:5.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:6.1"], "en": "Thus indeed did the venerable elder Saddasaññaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_353:7.1"], "en": "The legend of the Elder Saddasaññaka is the first.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
