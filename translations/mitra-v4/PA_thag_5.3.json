[
{"segs": ["PA_thag_5.3:0.1", "PA_thag_5.3:0.2", "PA_thag_5.3:0.3"], "en": "Theragāthā 5.3 Pañcaka-nipāta First Chapter (Paṭhama-vagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:0.4"], "en": "The Verses of the Elder Girimānanda:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:1.1"], "en": "“The god rains as if to a well-sung song;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:1.2"], "en": "my little hut is thatched, pleasant, and sheltered from the wind.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:1.3"], "en": "I dwell there, completely stilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:1.4", "PA_thag_5.3:2.1"], "en": "so, O Deva, rain if you wish. The Deva rains according to the well-sung song.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:2.2"], "en": "My little hut is thatched, pleasant, and sheltered from the wind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:2.3"], "en": "there I dwell with a peaceful mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:2.4"], "en": "So, if you wish, rain down, O god.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:3.1", "PA_thag_5.3:3.2"], "en": "The rain falls...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:3.3"], "en": "[and so on] ...I dwell there free from passion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:3.4", "PA_thag_5.3:4.1", "PA_thag_5.3:4.2"], "en": "… and so on … the rain-god rains, … and so on …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:4.3"], "en": "I dwell there free from hatred...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:4.4", "PA_thag_5.3:5.1"], "en": "[and so on] ... while the rain-god pours down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:5.2", "PA_thag_5.3:5.3"], "en": "… [and so on] … I dwell therein free from delusion;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:5.4"], "en": "therefore, O Deva, rain down if you so desire.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.3:5.5"], "en": "… the elder Girimānanda …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
