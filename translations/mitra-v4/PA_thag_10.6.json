[
{"segs": ["PA_thag_10.6:0.1", "PA_thag_10.6:0.2", "PA_thag_10.6:0.3"], "en": "Theragāthā 10.6 Dasaka-nipāta Paṭhama-vagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:0.4"], "en": "The Verses of the Elder Upasena Vaṅgantaputta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:1.1"], "en": "“Secluded, free from noise,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:1.2"], "en": "frequented by wild beasts;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:1.3", "PA_thag_10.6:1.4"], "en": "A bhikkhu frequents his lodging for the sake of seclusion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:2.1"], "en": "having brought away heaps of refuse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:2.2"], "en": "From cemeteries and from roadways,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:2.3"], "en": "having fashioned them into a patched robe,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:2.4"], "en": "one should wear that coarse garment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:3.1"], "en": "Having made his mind humble,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:3.2", "PA_thag_10.6:3.3"], "en": "a bhikkhu should wander for alms from family to family in regular succession.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:3.4"], "en": "With the doors of the senses well-guarded and well-restrained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:4.1"], "en": "one should be content even with what is coarse,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:4.2"], "en": "and not long for other abundant flavors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:4.3", "PA_thag_10.6:4.4"], "en": "The mind of one who is greedily attached to flavors does not delight in meditation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:5.1"], "en": "But one who has few desires and is content—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:5.2"], "en": "Let the sage dwell in seclusion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:5.3", "PA_thag_10.6:5.4"], "en": "unassociated with both householders and those who have gone forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:6.1", "PA_thag_10.6:6.2"], "en": "Just as one who is dull or mute would show himself, so should he conduct himself;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:6.3"], "en": "he should not converse excessively.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:6.4", "PA_thag_10.6:7.1"], "en": "The wise one in the midst of the Saṅgha does not revile anyone;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:7.2"], "en": "he avoids causing harm.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:7.3"], "en": "Restrained by the Pātimokkha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:7.4"], "en": "moderate in eating,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:8.1"], "en": "and having well-grasped the signs—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:8.2"], "en": "Skilled in the arising of the mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:8.3"], "en": "one should devote oneself to serenity and,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:8.4"], "en": "at the proper time, to insight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:9.1"], "en": "Endowed with energy and persistence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:9.2"], "en": "one should always be devoted to yoga;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:9.3"], "en": "and without reaching the end of suffering, [one should not cease].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:9.4"], "en": "A wise person should place their trust [in this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:10.1", "PA_thag_10.6:10.2"], "en": "For a bhikkhu who lives in this way and desires purity, [there is no fear].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:10.3"], "en": "“All taints are exhausted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:10.4"], "en": "and one attains Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.6:10.5"], "en": "… Thus spoke the Elder Upasena Vaṅgantaputta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
