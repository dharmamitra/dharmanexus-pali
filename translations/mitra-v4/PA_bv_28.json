[
{"segs": ["PA_bv_28:0.1"], "en": "Buddhavamsa 28.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:0.2"], "en": "The Chapter on Miscellaneous Matters Concerning the Buddhas:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:1.1"], "en": "From an incalculable eon ago...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:1.2"], "en": "There were four Leaders:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:1.3"], "en": "Taṇhaṅkara, Medhaṅkara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:1.4"], "en": "and also Saraṇaṅkara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:1.5"], "en": "And the Fully Enlightened One Dīpaṅkara—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:1.6"], "en": "these Victors were in one and the same eon.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:2.1"], "en": "After Dīpaṅkara, [there was...]", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:2.2"], "en": "The Leader named Koṇḍañña,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:2.3"], "en": "alone in a single eon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:2.4"], "en": "delivered many people across.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:3.1", "PA_bv_28:3.2", "PA_bv_28:3.3"], "en": "Between the Blessed One Dīpaṅkara and the Teacher Koṇḍañña, there were aeons—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:3.4"], "en": "Innumerable by calculation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:4.1"], "en": "After Koṇḍañña,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:4.2"], "en": "the Leader named Maṅgala;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:4.3", "PA_bv_28:4.4"], "en": "The intermediate aeons between them are also incalculable by number.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:5.1"], "en": "Maṅgala and Sumana...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:5.2"], "en": "Revata, Sobhita, and Muni—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:5.3", "PA_bv_28:5.4"], "en": "these three Buddhas in one eon were possessors of vision and makers of light.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:6.1"], "en": "After Sobhita,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:6.2"], "en": "the greatly renowned Anomadassi appeared;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:6.3"], "en": "and between those two, there were [many] eons.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:6.4"], "en": "In number, they are incalculable:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:7.1"], "en": "Anomadassī, Paduma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:7.2"], "en": "and Nārada the Leader.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:7.3"], "en": "The Buddhas of a single eon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:7.4"], "en": "those sages who bring about its end,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:8.1"], "en": "[and] after Nārada—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:8.2"], "en": "The Leader named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:8.3"], "en": "arisen in a single aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:8.4"], "en": "delivered many people across.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:9.1", "PA_bv_28:9.2"], "en": "Between the Blessed One Nārada and the Teacher Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:9.3"], "en": "there were also those intermediate aeons.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:9.4"], "en": "Incalculable by number;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:10.1"], "en": "in a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:10.2"], "en": "there was one Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:10.3"], "en": "Padumuttara, the knower of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:10.4"], "en": "the recipient of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:11.1"], "en": "appeared thirty thousand aeons ago.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:11.2"], "en": "There were two leaders,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:11.3"], "en": "Sumedha and Sujāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:11.4"], "en": "prior to Padumuttara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:12.1"], "en": "In eighteen hundred kappas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:12.2"], "en": "there were three Leaders:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:12.3"], "en": "Piyadassī and Atthadassī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:12.4"], "en": "And the Leader Dhammadassi—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:13.1", "PA_bv_28:13.2"], "en": "these Perfectly Enlightened Ones, supreme among bipeds, appeared before Sujata.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:13.3", "PA_bv_28:13.4"], "en": "In a single eon, those Buddhas were peerless individuals in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:14.1"], "en": "From ninety-four eons ago...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:14.2"], "en": "There was once a great sage,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:14.3"], "en": "Siddhattha, the knower of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:14.4"], "en": "the unsurpassed healer of the arrow of suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:15.1"], "en": "In the ninety-second aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:15.2"], "en": "there were two leaders:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:15.3"], "en": "the Perfectly Enlightened Ones Tissa and Phussa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:15.4"], "en": "Unequaled, without a peer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:16.1"], "en": "Ninety-one eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:16.2"], "en": "there was a leader named Vipassī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:16.3"], "en": "That Buddha too was compassionate;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:16.4"], "en": "he liberated beings from their bonds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:17.1"], "en": "Thirty-one eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:17.2"], "en": "There were two leaders:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:17.3"], "en": "Sikhī and Vessabhū,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:17.4"], "en": "peerless and without rival.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:18.1"], "en": "In this auspicious aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:18.2"], "en": "there were three leaders:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:18.3"], "en": "Kakusandha and Koṇāgamana.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:18.4"], "en": "And Kassapa was also a leader;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:19.1"], "en": "I am now the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:19.2"], "en": "and Metteyya shall also become one.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:19.3", "PA_bv_28:19.4"], "en": "These five Buddhas were wise and compassionate toward the world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:20.1"], "en": "Of these Kings of Dhamma—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:20.2", "PA_bv_28:20.3"], "en": "Having pointed out that path to many others numbering in the tens of millions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:20.4"], "en": "they have attained nibbāna together with their disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_28:21.1"], "en": "The Chapter on Miscellaneous Matters concerning the Buddha is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
