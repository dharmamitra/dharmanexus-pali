[
{"segs": ["PA_thi-ap_1:0.1"], "en": "The Therī-apadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:0.2"], "en": "Sumedhāvagga 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:0.3"], "en": "The Therī-apadāna of Sumedhā", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:1.1"], "en": "Homage to that Blessed One, the Worthy One, the Perfectly Self-Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:2.1"], "en": "Now listen to the legends of the Elder Nuns:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:3.1"], "en": "\"During the time of the Blessed One Koṇāgamana...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:3.2"], "en": "In a newly built monastery within the saṅghārāma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:3.3", "PA_thi-ap_1:3.4"], "en": "we three female friends gave a gift of a vihāra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:4.1"], "en": "Ten times, a hundred times, ten hundred times,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:4.2"], "en": "and a hundred times a hundred times,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:4.3"], "en": "we were reborn among the devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:4.4"], "en": "What need is there to speak of human existence?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:5.1"], "en": "We were gods of great psychic power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:5.2"], "en": "what need is there to speak of the human state?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:5.3", "PA_thi-ap_1:5.4"], "en": "I became the Great Queen of the Seven Jewels, the Woman-Jewel; here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:6.1"], "en": "having accumulated wholesome deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:6.2"], "en": "Susamiddha and Kulappajā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:6.3"], "en": "Dhanañjānī and Khemā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:6.4"], "en": "and I myself— these three people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:7.1"], "en": "Having constructed a well-made monastery,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:7.2"], "en": "adorned with all its constituent parts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:7.3"], "en": "for the Saṅgha headed by the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:7.4"], "en": "Having handed it over, they spoke together:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:8.1"], "en": "\"Wherever I am reborn,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:8.2"], "en": "by the power of that karma...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:8.3", "PA_thi-ap_1:8.4"], "en": "They attained preeminence among the gods and likewise among human beings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:9.1"], "en": "even in this very aeon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:9.2"], "en": "A kinsman of Brahmā of great renown,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:9.3"], "en": "named Kassapa by clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:9.4"], "en": "arose as the best among those who speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:10.1", "PA_thi-ap_1:10.2", "PA_thi-ap_1:10.3"], "en": "At that time, the lord of men, the King of Kāsi named Kikī, was the attendant of the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:10.4"], "en": "In the supreme city of Bārāṇasī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:11.1"], "en": "he had seven daughters,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:11.2"], "en": "princesses raised in luxury.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:11.3"], "en": "Delighting in attending upon the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:11.4"], "en": "they lived the holy life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:12.1"], "en": "having become their companions, [I too practiced].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:12.2"], "en": "Well-composed in the precepts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:12.3"], "en": "having given gifts with due care,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:12.4"], "en": "I indeed practiced the holy life while still at home.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:13.1"], "en": "By that well-performed kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:13.2"], "en": "and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:13.3"], "en": "having abandoned this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:13.4"], "en": "I went to the realm of the Thirty-three;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:14.1"], "en": "passing away from there, I went to Yāma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:14.2"], "en": "and from there I went to Tusita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:14.3"], "en": "And from there, to Nimmānarati,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:14.4"], "en": "and from there to Vasavatti’s city;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:15.1"], "en": "wherever I am reborn, [there I go].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:15.2"], "en": "Impelled by meritorious deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:15.3", "PA_thi-ap_1:15.4"], "en": "I served as the chief queen to various kings in those very places.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:16.1"], "en": "Then, passing away from the human state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:16.2"], "en": "they are born among universal monarchs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:16.3"], "en": "regional kings, and local rulers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:16.4"], "en": "I exercised great sovereignty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:17.1", "PA_thi-ap_1:17.2"], "en": "Having experienced prosperity among both gods and humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:17.3"], "en": "Having been happy in every respect,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:17.4"], "en": "I wandered through various births;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:18.1"], "en": "that was the cause, that was the origin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:18.2"], "en": "Its root is patience in the Teaching;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:18.3"], "en": "that is the first convergence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:18.4"], "en": "and for one who delights in the Dhamma, it is Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:19.1"], "en": "The defilements have been incinerated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:19.2"], "en": "all states of existence have been uprooted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:19.3"], "en": "like a nāga who has severed its bonds, I am free.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:19.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:20.1", "PA_thi-ap_1:20.2"], "en": "Welcome indeed has come to me in the presence of the Best of Buddhas!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:20.3"], "en": "The three true insights have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:20.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:21.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:21.2"], "en": "And these eight liberations have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:21.3"], "en": "the six direct knowledges have been realized—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:21.4"], "en": "the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:22.1"], "en": "Thus indeed did the bhikkhunī Sumedhā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_1:23.1"], "en": "This is the first legend of the elder nun Sumedhā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
