[
{"segs": ["PA_ja_316:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:0.2", "PA_ja_316:0.3"], "en": "Catukkanipāta, Pucimandavagga (The Chapter on the Nimba Tree)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:0.4", "PA_ja_316:1.1", "PA_ja_316:1.2"], "en": "6. The Jātaka of the Wise Hare “Seven red fish were taken by me from the water onto dry land.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:1.3"], "en": "“Brahmin, this I have;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:1.4"], "en": "having eaten this, dwell in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:2.1"], "en": "“I have no need for that of my field-guardian,” [he replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:2.2", "PA_ja_316:2.3"], "en": "A meal at night that was not brought [at the right time], two spits of meat,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:2.4"], "en": "one lizard, and one bowl of curd.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:2.5"], "en": "“Brahmin, I have this;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:2.6"], "en": "having eaten this, dwell in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:3.1"], "en": "“A mango fruit and cool water—”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:3.2"], "en": "The cool shade is delightful;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:3.3"], "en": "this, O Brahmin, is what I have.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:3.4"], "en": "Having partaken of this, dwell in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:4.1"], "en": "“In the hare there are no sesame seeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:4.2"], "en": "no mung beans, nor rice grains;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:4.3"], "en": "cooked by this fire— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:4.4"], "en": "\"Eat me and dwell in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_316:5.1"], "en": "This is the sixth Jātaka, the Story of the Wise Hare.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
