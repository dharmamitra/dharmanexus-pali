[
{"segs": ["PA_tha-ap_210:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:0.2"], "en": "The Section on the Kaṇikāra Flower, 8.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:0.3"], "en": "The Apadāna of the Elder Koraṇḍapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:1.1", "PA_tha-ap_210:1.2", "PA_tha-ap_210:1.3"], "en": "“Having seen the footprint that was adorned with the mark of the wheel, following step by step along that path, [he saw]...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:1.4", "PA_tha-ap_210:2.1", "PA_tha-ap_210:2.2"], "en": "Having seen the koraṇḍa flower in full bloom, I worshipped it together with its roots before the Great Seer Vipassi.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:2.3"], "en": "Joyful with a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:2.4"], "en": "I paid homage to the supreme state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:3.1"], "en": "Ninety-one eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:3.2"], "en": "The flower that I offered in worship—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:3.4"], "en": "this is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:4.1"], "en": "In the fifty-seventh aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:4.2"], "en": "I was one who was free from stain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:4.3"], "en": "endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:4.4"], "en": "A wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:5.1", "PA_tha-ap_210:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:6.1"], "en": "It was in this way that the venerable elder Koraṇḍapupphiya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_210:7.1"], "en": "This is the eighth *apadāna* of the elder Koraṇḍapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
