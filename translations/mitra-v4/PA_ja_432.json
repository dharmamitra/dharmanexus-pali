[
{"segs": ["PA_ja_432:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:0.2", "PA_ja_432:0.3"], "en": "The Ninth Chapter, The Section on Vultures (Gijjhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:0.4", "PA_ja_432:1.1", "PA_ja_432:1.2"], "en": "6. The Birth Story of the Young Brahmin Padakusala “The Ganges carries away the learned Pāṭali, who was skilled in speech.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:1.3"], "en": "“I am being carried away, O Blessed One;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:1.4"], "en": "give me a single verse.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:2.1"], "en": "“That with which they sprinkle the one who is suffering,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:2.2"], "en": "With which they sprinkle the afflicted one;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:2.3"], "en": "in the midst of that I shall die—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:2.4"], "en": "for there is fear born from taking refuge.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:3.1"], "en": "“Where seeds sprout,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:3.2"], "en": "where beings are established—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:3.3"], "en": "that [earth] presses down upon my head.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:3.4"], "en": "“Fear arises from what has been born.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:4.1"], "en": "“That by which meals are cooked,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:4.2"], "en": "and that by which one is afflicted by cold;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:4.3"], "en": "Thus it burns my limbs;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:4.4"], "en": "fear has arisen from that which was taken as refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:5.1"], "en": "“By whatever food they sustain themselves...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:5.2"], "en": "Many brahmins and kshatriyas; he,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:5.3"], "en": "having eaten me, seeks to harm me—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:5.4"], "en": "this is the fear born of taking refuge.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:6.1"], "en": "“In the last month of summer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:6.2"], "en": "the wise desire a breeze;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:6.3"], "en": "but that [heat] breaks my limbs.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:6.4"], "en": "“Fear has arisen from its very source.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:7.1"], "en": "“He who, depending on a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:7.2"], "en": "releases fire against it— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:7.3"], "en": "“O Vakkaṅga, resort to the directions;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:7.4"], "en": "fear arises from what has been born.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:8.1"], "en": "“The joy that I brought forth—”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:8.2"], "en": "Mālinī, who was once adorned with sandalwood paste—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:8.3"], "en": "she has now cast me out from my home;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:8.4"], "en": "fear has arisen from that which was once my refuge.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:9.1"], "en": "“He who, upon being born, would have brought me joy,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:9.2"], "en": "and for whom I desired existence—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:9.3"], "en": "he now casts me out from my home.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:9.4"], "en": "“Fear has arisen from taking refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:10.1", "PA_ja_432:10.2"], "en": "“Let the people of the countryside and the assembled townsfolk listen to me!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:10.3"], "en": "Where there is water, there it is ablaze;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:10.4"], "en": "where there is safety, there is danger.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:11.1"], "en": "A king plunders the kingdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:11.2"], "en": "And the brahmin chaplain said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:11.3"], "en": "\"Dwell with yourselves as your own protectors;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:11.4"], "en": "for from what has been born comes fear.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_432:12.1"], "en": "The Sixth Jātaka: The Story of the Boy Padakusala.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
