[
{"segs": ["PA_thi-ap_20:0.1", "PA_thi-ap_20:0.2"], "en": "The Therī-Apadāna Ekūposathika Vagga 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:0.3"], "en": "The Apadāna of the Elder Nun Paṭācārā", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:1.2"], "en": "who had gone beyond all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:1.3"], "en": "[lived] one hundred thousand aeons ago from here.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:1.4"], "en": "The Leader appeared in that eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:2.1"], "en": "At that time, I was born in Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:2.2"], "en": "having been born into a family of merchants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:2.3"], "en": "Blazing with various jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:2.4"], "en": "and endowed with great bliss,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:3.1"], "en": "they approached that Great Hero.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:3.2"], "en": "I heard the teaching of the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:3.3"], "en": "then, with faith born therein,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:3.4"], "en": "I went for refuge to the Victor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:4.1", "PA_thi-ap_20:4.2"], "en": "Then the Leader praised the foremost among those who uphold the Vinaya:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:4.3"], "en": "the modest nun, the one who is such-like.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:4.4"], "en": "Expert in what is allowable and what is not,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:5.1"], "en": "at that time, with a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:5.2"], "en": "I longed for that state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:5.3"], "en": "Having invited the One of Ten Powers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:5.4"], "en": "the Leader of the World together with the Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:6.1"], "en": "and having fed them for seven days,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:6.2"], "en": "Having given him the three robes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:6.3", "PA_thi-ap_20:6.4"], "en": "I bowed my head at his feet and spoke these words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:7.1", "PA_thi-ap_20:7.2"], "en": "“O Hero, that which was described by you as being eight steps from here—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:7.3"], "en": "I shall become just like that, O Sage.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:7.4"], "en": "“If it succeeds, O Leader,” [I thought].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:8.1"], "en": "Then the Teacher said to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:8.2"], "en": "“Bhadde, do not fear; take heart.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:8.3"], "en": "In a future time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:8.4"], "en": "you shall obtain that heart's desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:9.1"], "en": "In a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:9.2"], "en": "Born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:9.3", "PA_thi-ap_20:9.4"], "en": "he will be a teacher in the world named Gotama by lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:10.1"], "en": "His heirs in the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:10.2"], "en": "his own children born of the Dhamma—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:10.3"], "en": "she who was known by the name Paṭācārā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:10.4", "PA_thi-ap_20:11.1"], "en": "“...she will become a female disciple of the Teacher. Then, filled with joy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:11.2"], "en": "I [served] the Conqueror for as long as I lived.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:11.3"], "en": "With a mind of loving-kindness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:11.4"], "en": "I served the Leader of the World together with his Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:12.1"], "en": "By that well-performed deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:12.2"], "en": "And through my volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:12.3"], "en": "having cast off this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:12.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:13.1"], "en": "In this auspicious aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:13.2"], "en": "there was one of great renown, a kinsman of Brahmā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:13.3"], "en": "known by the clan name Kassapa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:13.4"], "en": "The best among disputants was born.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:14.1", "PA_thi-ap_20:14.2"], "en": "At that time, the lord of men was the attendant of the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:14.3", "PA_thi-ap_20:14.4"], "en": "In the supreme city of Bārāṇasī, there was a king of Kāsi named Kikī;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:15.1"], "en": "I was his third daughter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:15.2"], "en": "Known as Bhikkhunī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:15.3"], "en": "having heard the Dhamma from the Conqueror’s chief,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:15.4"], "en": "I resolved to go forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:16.1"], "en": "Our father did not grant us permission then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:16.2", "PA_thi-ap_20:16.3"], "en": "while we were still living as householders for twenty thousand years.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:16.4"], "en": "We have practiced without sloth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:17.1", "PA_thi-ap_20:17.2"], "en": "O princess raised in luxury, in the celibacy of maidenhood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:17.3", "PA_thi-ap_20:17.4"], "en": "The seven daughters were devoted to attending upon the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:18.1"], "en": "they were Samaṇī and Samaṇaguttā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:18.2"], "en": "The nun Bhikkhudāyikā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:18.3"], "en": "and both Dhammā and Sudhammā—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:18.4"], "en": "the seventh was Saṅghadāyikā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:19.1"], "en": "I, Uppalavaṇṇā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:19.2"], "en": "and the bhikkhunīs Khemā and Bhaddā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:19.3"], "en": "Kisāgotamī and Dhammadinnā—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:19.4"], "en": "Visākhā was the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:20.1", "PA_thi-ap_20:20.2"], "en": "By those well-performed deeds and by her intentions and aspirations, [she attained this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:20.3"], "en": "Having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:20.4"], "en": "I went to the realm of the Thirty-three;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:21.1"], "en": "and now, in my final existence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:21.2", "PA_thi-ap_20:21.3"], "en": "I was born into a family of merchants in the preeminent city of Sāvatthī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:21.4"], "en": "which was prosperous, flourishing, and possessed of great wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:22.1"], "en": "And when I was endowed with youth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:22.2"], "en": "under the sway of discursive thoughts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:22.3"], "en": "I saw a man who was my lover.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:22.4"], "en": "I went along with him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:23.1"], "en": "I was the mother of an only son,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:23.2"], "en": "and he was the second [child] in my womb.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:23.3", "PA_thi-ap_20:23.4", "PA_thi-ap_20:24.1"], "en": "Then, having firmly resolved, \"I shall renounce my parents,\" I did not inform my husband.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:24.2"], "en": "Then, while he had been sent away,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:24.3", "PA_thi-ap_20:24.4"], "en": "she went out from the house all alone to go to the supreme Sāvatthī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:25.1"], "en": "Then, my lord, having come from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:25.2"], "en": "you encountered me on the road;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:25.3"], "en": "at that time, wind-born pains arose within me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:25.4"], "en": "Extremely terrible pains arose;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:26.1", "PA_thi-ap_20:26.2"], "en": "and a great cloud rose at the time of my delivery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:26.3"], "en": "Having gone then for the sake of some object,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:26.4"], "en": "O Lord, he was killed by a snake; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:27.1"], "en": "due to the pain of childbirth, [she...]", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:27.2"], "en": "Helpless and wretched am I;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:27.3"], "en": "having seen the small river filled,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:27.4"], "en": "I was going toward my own home.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:28.1"], "en": "Taking my child, I crossed over,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:28.2"], "en": "leaving him alone on the far bank;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:28.3"], "en": "having laid my young son down to sleep, I departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:28.4"], "en": "The other was for me to cross over.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:29.1"], "en": "The horse Ukkaṃsa turned back,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:29.2"], "en": "wailing piteously for his young foal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:29.3"], "en": "Moreover, there was a great flood;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:29.4"], "en": "thus, overcome with grief,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:30.1"], "en": "I went to the city of Sāvatthī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:30.2"], "en": "I heard that my kinsman had died;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:30.3", "PA_thi-ap_20:30.4"], "en": "then, overcome by grief and overwhelmed by great sorrow, I spoke.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:31.1"], "en": "‘Both my sons have passed away,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:31.2"], "en": "and on the road my husband has died;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:31.3"], "en": "both my mother and father, and my brother as well— ’", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:31.4"], "en": "In that single funeral pyre,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:32.1"], "en": "she was then emaciated and pale,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:32.2"], "en": "helpless and dejected in spirit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:32.3"], "en": "As I was wandering here and there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:32.4"], "en": "I saw the Charioteer of Men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:33.1"], "en": "Then the Teacher spoke to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:33.2"], "en": "\"My son, do not grieve; take heart!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:33.3"], "en": "Seek out your own self;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:33.4"], "en": "why do you distress yourself in vain?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:34.1"], "en": "Sons are no refuge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:34.2"], "en": "nor are kinsmen or relatives,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:34.3"], "en": "for one who is seized by the End-maker.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:34.4"], "en": "“There is no refuge among kinsmen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:35.1"], "en": "Having heard those words of the Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:35.2"], "en": "I attained the first fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:35.3"], "en": "Not long after going forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:35.4"], "en": "I attained arahantship;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:36.1"], "en": "I became masterful in the supernormal powers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:36.2"], "en": "With the divine ear-element,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:36.3"], "en": "I know the minds of others,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:36.4"], "en": "carrying out the Teacher’s instruction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:37.1"], "en": "I know my former abodes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:37.2"], "en": "my divine eye is purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:37.3"], "en": "having exhausted all taints, I am free.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:37.4"], "en": "I was pure and stainless. Then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:38.1", "PA_thi-ap_20:38.2"], "en": "in the presence of the All-Seeing One, I [studied] the entire Vinaya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:38.3", "PA_thi-ap_20:38.4"], "en": "I mastered the entire detail and explained it exactly as it is.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:39.1"], "en": "The Victor was pleased with that quality.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:39.2"], "en": "He placed me in this foremost position:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:39.3", "PA_thi-ap_20:39.4"], "en": "“Paṭācārā alone is the foremost among those who uphold the Vinaya.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:40.1"], "en": "The Teacher has been served by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:40.2"], "en": "the Buddha’s instruction has been fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:40.3"], "en": "the heavy burden has been laid down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:40.4"], "en": "The conduit to existence has been uprooted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:41.1", "PA_thi-ap_20:41.2"], "en": "For the sake of which one has gone forth from the home life into homelessness— [that goal has been attained].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:41.3"], "en": "Thus has my purpose been attained:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:41.4"], "en": "the destruction of all fetters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:42.1"], "en": "My defilements have been consumed by fire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:42.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:42.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:43.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:43.2", "PA_thi-ap_20:43.3"], "en": "... [and so on] ... the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:44.1"], "en": "The four analytical knowledges (paṭisambhidā) have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:44.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:44.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:45.1"], "en": "Thus indeed did the bhikkhunī Paṭācārā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:46.1"], "en": "The legend of the Elder Nun Paṭācārā is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:47.1"], "en": "The second chapter, the Ekūposathika-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:48.1"], "en": "Its summary (uddāna) is as follows:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:49.1"], "en": "Ekūposathika,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:49.2"], "en": "Saḷala, and Modaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:49.3"], "en": "Ekāsana and Pañcadīpa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:49.4"], "en": "Naḷamālī and Gotamī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:50.1"], "en": "Khemā and Uppalavaṇṇā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:50.2"], "en": "and the bhikkhunī Paṭācārā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:50.3"], "en": "There are exactly five hundred verses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_20:50.4"], "en": "and nine more besides.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
