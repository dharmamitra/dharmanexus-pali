[
{"segs": ["PA_snp_5.15:0.1", "PA_snp_5.15:0.2", "PA_snp_5.15:1.1"], "en": "Sutta Nipāta 5.15 Posāla-māṇava-pucchā “He who points out the past, ... [the future], and the present, who knows all things as they truly are...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:1.2"], "en": "(Thus spoke the Venerable Posāla:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:1.3"], "en": "Unshaken, with doubts severed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:1.4"], "en": "he has gone beyond all phenomena.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:1.5"], "en": "I have come with a question:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:2.1", "PA_snp_5.15:2.2"], "en": "[Tell me] of one who has transcended the perception of form and has abandoned the entire body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:2.3", "PA_snp_5.15:2.4"], "en": "To one who sees that there is nothing whatsoever, both internally and externally—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:2.5"], "en": "I ask you, Sakka, about this knowledge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:2.6"], "en": "“How is such a person to be guided?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:3.1"], "en": "“All stations of consciousness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:3.2"], "en": "Posāla,” said the Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:3.3"], "en": "The Tathāgata, fully knowing this,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:3.4", "PA_snp_5.15:3.5"], "en": "recognizes one who remains [in training] as being liberated and having that as his final goal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:4.1", "PA_snp_5.15:4.2"], "en": "Having understood that the state of nothingness arises from the fetter of delight,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:4.3"], "en": "and having thus directly known this—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:4.4"], "en": "Then he sees with insight therein;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:4.5", "PA_snp_5.15:4.6"], "en": "this is the true knowledge of that brahmin who has lived the holy life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.15:4.7"], "en": "The Fourteenth: The Question of the Young Brahmin Posāla.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
