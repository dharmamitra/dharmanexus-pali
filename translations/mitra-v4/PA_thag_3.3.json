[
{"segs": ["PA_thag_3.3:0.1", "PA_thag_3.3:0.2"], "en": "Theragāthā 3.3 Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.3:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.3:0.4"], "en": "The Verses of the Elder Bākulatthera:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.3:1.1", "PA_thag_3.3:1.2"], "en": "“He who wishes to do later what ought to be done earlier;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.3:1.3", "PA_thag_3.3:1.4"], "en": "He falls from that state of happiness and later regrets it;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.3:2.1"], "en": "for one should speak only what one would do.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.3:2.2"], "en": "One should not speak of that which one would not do;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.3:2.3", "PA_thag_3.3:2.4"], "en": "the wise discern the one who speaks without acting.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.3:3.1"], "en": "How truly blissful is Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.3:3.2"], "en": "taught by the Fully Enlightened One—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.3:3.3"], "en": "sorrowless, stainless, and secure!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.3:3.4"], "en": "“Where suffering ceases,” said the Elder Bākula.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.3:3.5"], "en": "… The Elder Bākula …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
