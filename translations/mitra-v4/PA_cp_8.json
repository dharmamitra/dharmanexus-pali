[
{"segs": ["PA_cp_8:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:0.2"], "en": "Akittivagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:0.3"], "en": "Dānapāramī 8", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:0.4"], "en": "The Conduct of King Sivi:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:1.1"], "en": "“In the city named Ariṭṭha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:1.2"], "en": "there was a kshatriya named Sivi;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:1.3"], "en": "Sitting in that excellent palace,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:1.4"], "en": "I then reflected thus:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:2.1"], "en": "\"Whatever human gift there may be...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:2.2"], "en": "\"Nothing not given exists for me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:2.3"], "en": "even if someone were to ask me for my eye,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:2.4"], "en": "I would give it without wavering.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:3.1"], "en": "Knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:3.2"], "en": "Sakka, the lord of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:3.3"], "en": "sat amidst the assembly of deities.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:3.4"], "en": "He spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:4.1"], "en": "“Having sat down in the excellent palace,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:4.2"], "en": "the king of the Śivis, possessed of great psychic power;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:4.3", "PA_cp_8:4.4"], "en": "Contemplating various kinds of giving, he sees nothing that cannot be given.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:5.1"], "en": "This is indeed true; it is not false.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:5.2"], "en": "Come now, I shall examine you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:5.3", "PA_cp_8:5.4"], "en": "wait a moment while I ascertain your mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:6.1", "PA_cp_8:6.2"], "en": "Trembling, with gray hair, his body covered in wrinkles, afflicted by old age,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:6.3"], "en": "and having become like one who is blind—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:6.4"], "en": "He approached the king.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:7.1", "PA_cp_8:7.2"], "en": "Then, having raised his left and right arms, he—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:7.3"], "en": "Placing his palms together in reverence at his head,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:7.4"], "en": "he spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:8.1"], "en": "“I entreat you, O Great King.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:8.2"], "en": "O righteous one, increaser of the kingdom!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:8.3", "PA_cp_8:8.4"], "en": "Your fame for delighting in giving has risen high among both gods and humans.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:9.1"], "en": "Both my eyes, my two organs of sight,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:9.2"], "en": "are blind and impaired;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:9.3"], "en": "give me one eye.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:9.4"], "en": "\"You too should subsist on one [meal] a day.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:10.1"], "en": "Having heard her words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:10.2"], "en": "I was joyful and my mind was deeply moved.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:10.3"], "en": "With palms joined and moved by a sense of urgency,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:10.4"], "en": "I spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:11.1"], "en": "\"Having now reflected upon this...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:11.2"], "en": "Having come here from the palace,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:11.3", "PA_cp_8:11.4"], "en": "you have come to ask for my eye, having understood the thought in my mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:12.1"], "en": "\"Aho! My mind has attained success;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:12.2"], "en": "my intention is fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:12.3"], "en": "this supreme gift, never given before, [is now bestowed].\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:12.4"], "en": "\"Today I shall give to the supplicants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:13.1"], "en": "Come, Sīvaka, arise!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:13.2"], "en": "Do not delay, do not procrastinate!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:13.3"], "en": "\"Give both eyes as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:13.4"], "en": "having gouged them out and placed them in a bowl.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:14.1"], "en": "Thus was he urged by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:14.2"], "en": "Sivaka acted upon his word;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:14.3", "PA_cp_8:14.4"], "en": "having extracted it, he gave it to the beggar like the kernel of a palmyra fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:15.1"], "en": "While I am giving, while I am bestowing,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:15.2"], "en": "while I am possessed of the gift already given—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:15.3"], "en": "there is no alteration of my mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:15.4"], "en": "It is solely for the sake of enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:16.1"], "en": "Neither of my two eyes is to be given away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:16.2"], "en": "nor am I myself not to be given away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:16.3"], "en": "“Omniscience is dear to me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:16.4"], "en": "therefore, I gave you my eye.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_8:17.1"], "en": "Thus ends the eighth chapter, the Conduct of King Sivi.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
