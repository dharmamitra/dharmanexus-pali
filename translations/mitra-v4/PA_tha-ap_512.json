[
{"segs": ["PA_tha-ap_512:0.1", "PA_tha-ap_512:0.2", "PA_tha-ap_512:0.3"], "en": "The Apadāna of the Elder Nāḷikeraphaladāyaka, from the Kaṇikāra Chapter of the Therāpadāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:1.1"], "en": "“In the city of Bandhumatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:1.2"], "en": "I was then a monastery attendant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:1.3"], "en": "I saw the stainless Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:1.4"], "en": "As he was traveling at the speed of the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:2.1", "PA_tha-ap_512:2.2"], "en": "I took a coconut fruit and gave it to the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:2.3"], "en": "Standing poised in the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:2.4"], "en": "the one of great renown accepted [the offering],", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:3.1"], "en": "producing joy within me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:3.2"], "en": "Bringing happiness in this very life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:3.3", "PA_tha-ap_512:3.4"], "en": "having given a fruit to the Buddha with a mind full of serene confidence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:4.1", "PA_tha-ap_512:4.2"], "en": "Then I attained rapture and vast, supreme bliss;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:4.3"], "en": "indeed, a jewel arose.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:4.4"], "en": "Having been reborn here and there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:5.1"], "en": "for ninety-one eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:5.2"], "en": "I gave that fruit at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:5.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:5.4"], "en": "this is the fruit of giving fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:6.1"], "en": "My divine eye is purified.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:6.2"], "en": "I am skilled in concentration;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:6.3"], "en": "having reached the perfection of direct knowledge—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:6.4"], "en": "this is the fruit of giving fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:7.1", "PA_tha-ap_512:7.2"], "en": "The defilements have been incinerated by me; ... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:7.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:8.1"], "en": "\"Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:8.2", "PA_tha-ap_512:8.3"], "en": "[as before] ...the Buddha’s teaching has been accomplished.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:9.1", "PA_tha-ap_512:9.2"], "en": "The four analytical knowledges... [and so on]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:9.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:10.1"], "en": "Thus indeed the venerable elder Nāḷikeraphaladāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:11.1"], "en": "This is the tenth legend of the elder Nāḷikeraphaladāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:12.1"], "en": "The fiftieth-first chapter, the Kaṇikāra Chapter, is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:13.1", "PA_tha-ap_512:14.1"], "en": "Its summary verse: Kaṇikāra, ekapatta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:14.2"], "en": "kāsumārī, and likewise avaṭa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:14.3"], "en": "The pāda fruit, the mātuluṅga,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:14.4", "PA_tha-ap_512:15.1"], "en": "and likewise the ajelīmoda; the tāla as well as the nāḷikera.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:15.2"], "en": "The verses here have been counted:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:15.3"], "en": "there are one hundred verses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_512:15.4"], "en": "free from any deficiency or excess.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
