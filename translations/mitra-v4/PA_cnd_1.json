[
{"segs": ["PA_cnd_1:0.1"], "en": "Cūḷaniddesa:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:0.2"], "en": "Verses of the Pārāyaṇa Chapter 1.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:0.3"], "en": "The Introductory Verses (Vatthugāthā)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:0.4"], "en": "Homage to that Blessed One, the Worthy One, the Perfectly Self-Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:1.1"], "en": "From the delightful city of the Kosalans,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:1.2"], "en": "he went to the Southern Region.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:1.3", "PA_cnd_1:1.4"], "en": "A brahmin, a master of the mantras, longing for the state of nothingness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:2.1"], "en": "[dwelt] in the territory of Assaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:2.2"], "en": "In the vicinity of Maḷaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:2.3"], "en": "he dwelt on the bank of the Godhāvarī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:2.4"], "en": "subsisting on gleaned grains and fruits.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:3.1"], "en": "Relying upon that very [place],", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:3.2"], "en": "a vast village arose;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:3.3"], "en": "from the income produced there, [he provided for his parents].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:3.4"], "en": "He prepared a great sacrifice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:4.1"], "en": "Having performed that great sacrifice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:4.2"], "en": "he entered his hermitage once again.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:4.3"], "en": "While I had entered therein,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:4.4"], "en": "another brahmin arrived,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:5.1"], "en": "with blistered feet and parched with thirst.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:5.2"], "en": "With mud on his teeth and dust on his head,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:5.3", "PA_cnd_1:5.4"], "en": "he approached him and begged for five hundred [pieces].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:6.1"], "en": "Bāvarī, seeing him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:6.2", "PA_cnd_1:6.3"], "en": "invited him to a seat and asked after his well-being and welfare.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:6.4"], "en": "He spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:7.1"], "en": "\"Whatever gift I had to give,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:7.2"], "en": "all of it has been distributed by me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:7.3"], "en": "“Grant me [this], Brahmā;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:7.4"], "en": "I do not have five hundred.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:8.1"], "en": "“If, while I am entreating you...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:8.2"], "en": "If you do not show yourself,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:8.3", "PA_cnd_1:8.4"], "en": "on the seventh day your head shall split into seven pieces!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:9.1", "PA_cnd_1:9.2"], "en": "Having fabricated it, that deceiver proclaimed something terrifying;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:9.3"], "en": "having heard those words of his,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:9.4"], "en": "Bāvarī became distressed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:10.1"], "en": "without food, he withered away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:10.2"], "en": "pierced by the arrow of sorrow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:10.3", "PA_cnd_1:10.4", "PA_cnd_1:11.1"], "en": "Thus, even so, the mind does not delight in meditation when it sees [beings] terrified and suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:11.2"], "en": "The deity, desiring his welfare,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:11.3", "PA_cnd_1:11.4"], "en": "approached Bāvari and spoke these words.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:12.1"], "en": "“He does not understand the art of palmistry;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:12.2", "PA_cnd_1:12.3"], "en": "he is a fraud seeking wealth. Whether regarding the lines on the hand or the fall of the dice, ...he knows nothing at all.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:12.4"], "en": "“Knowledge does not exist for him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:13.1"], "en": "“Lady, you surely know;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:13.2"], "en": "tell that to me when asked.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:13.3"], "en": "“The head and the striking of the head—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:13.4"], "en": "let us hear those words of yours.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:14.1"], "en": "“I too do not know this,” [he replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:14.2"], "en": "No such knowledge exists here;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:14.3"], "en": "for regarding the heads and the striking of heads,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:14.4"], "en": "there is the vision of the Conquerors.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:15.1"], "en": "“Then who indeed knows,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:15.2"], "en": "upon this circle of the earth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:15.3"], "en": "[the extent of] the head and the blow to the head?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:15.4"], "en": "\"Tell me that, O deity. \"Long ago,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:16.1", "PA_cnd_1:16.2"], "en": "when the Leader of the World departed from Kapilavatthu,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:16.3"], "en": "The descendant of King Okkāka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:16.4"], "en": "the son of the Sakyas, the light-bringer;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:17.1"], "en": "for he, O Brahmin, is the Perfectly Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:17.2"], "en": "One who has gone to the further shore of all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:17.3"], "en": "who has attained the power of all direct knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:17.4"], "en": "and who possesses the eye regarding all phenomena.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:17.5"], "en": "Having reached the destruction of all kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:17.6"], "en": "liberated through the exhaustion of acquisitions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:18.1"], "en": "he is the Buddha, the Blessed One in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:18.2"], "en": "The Visionary One teaches the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:18.3"], "en": "go to him and ask,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:18.4"], "en": "and he will explain it to you.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:19.1", "PA_cnd_1:19.2"], "en": "Having heard the word \"Sambuddha,\" Bāvarī became overjoyed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:19.3"], "en": "his grief was diminished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:19.4"], "en": "And he obtained abundant rapture.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:20.1"], "en": "Bāvarī, joyful and elated,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:20.2"], "en": "having gained knowledge, questioned that deity.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:20.3"], "en": "“In which village or town,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:20.4"], "en": "or in which country, is the Lord of the World?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:20.5"], "en": "Having gone there, may we behold him.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:20.6"], "en": "The Fully Awakened One, the supreme among bipeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:21.1"], "en": "In Sāvatthī, in the Kosalan abode, the Victor dwells—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:21.2"], "en": "abundant in wisdom, possessed of excellent and vast intelligence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:21.3"], "en": "Thus the Sakyan son Vidhura, free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:21.4"], "en": "the wise bull among men, [spoke] regarding the falling of his head.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:22.1"], "en": "Then he addressed his disciples:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:22.2"], "en": "The brahmin, who had mastered the mantras, said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:22.3"], "en": "“Come, young men, I shall speak;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:22.4"], "en": "listen to my words.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:23.1", "PA_cnd_1:23.2"], "en": "He whose appearance in the world is so rare, yet occurs so frequently—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:23.3"], "en": "he has today arisen in this world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:23.4"], "en": "\"He is renowned as the Fully Awakened One;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:23.5"], "en": "having gone quickly to Sāvatthī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:23.6"], "en": "behold the Supreme among Bipeds.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:24.1"], "en": "“How indeed may we know,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:24.2"], "en": "O Brahmin, having seen that you are a Buddha?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:24.3"], "en": "Tell us who do not know.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:24.4"], "en": "\"So that we may know him as such.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:25.1", "PA_cnd_1:25.2"], "en": "\"For the marks of a Great Man are indeed found in the mantras;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:25.3"], "en": "And these thirty-two have been explained in their entirety,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:25.4"], "en": "in successive order.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:26.1"], "en": "He in whose limbs these exist—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:26.2"], "en": "These are the marks of a Great Man;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:26.3"], "en": "for him there are only two destinies,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:26.4"], "en": "for a third does not exist.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:27.1"], "en": "If he dwells at home,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:27.2", "PA_cnd_1:27.3"], "en": "he may conquer this earth without rod or sword.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:27.4"], "en": "He governs according to the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:28.1", "PA_cnd_1:28.2"], "en": "And if he goes forth from the home life into homelessness, [he does so] in accordance with the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:28.3"], "en": "The Perfectly Enlightened One, the remover of the veil,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:28.4"], "en": "is the unsurpassed Worthy One (Arahant).", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:29.1"], "en": "Birth, lineage, and physical marks—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:29.2"], "en": "Furthermore, O other disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:29.3", "PA_cnd_1:29.4"], "en": "ask with your minds alone about the head and the striking of the head.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:30.1", "PA_cnd_1:30.2"], "en": "If the Buddha, who sees without obstruction,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:30.3"], "en": "will answer the questions asked by the mind, [then I shall ask].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:30.4"], "en": "He will respond with his own voice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:31.1"], "en": "Having heard Bāvari’s words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:31.2"], "en": "the sixteen brahmin disciples—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:31.3"], "en": "Ajita, Tissa Metteyya,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:31.4"], "en": "Puṇṇaka, and then Mettagū;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:32.1"], "en": "Dhotaka and Upasīva.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:32.2"], "en": "And Nanda, as well as Hemaka;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:32.3"], "en": "both Todeyya and Kappa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:32.4"], "en": "and the wise Jatukannī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:33.1"], "en": "Bhadrāvudha and Udaya,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:33.2"], "en": "and the brahmin Posāla;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:33.3"], "en": "and the wise Mogharāja.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:33.4"], "en": "And Piṅgiya, the great seer—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:34.1"], "en": "all these leaders of independent groups,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:34.2"], "en": "renowned throughout the entire world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:34.3"], "en": "The wise ones, meditators who delight in jhāna,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:34.4"], "en": "perfumed by their former mental impressions—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:35.1"], "en": "having paid homage to Bāvarī, they departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:35.2"], "en": "Having circumambulated him clockwise,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:35.3", "PA_cnd_1:35.4"], "en": "all those wearing matted hair and deerskins departed facing north.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:36.1", "PA_cnd_1:36.2"], "en": "At that time, there will be the establishment of Maḷaka, the city of Āhissati,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:36.3"], "en": "as well as Ujjenī and Gonaddha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:36.4"], "en": "Vedisa, and that called Vanasa;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:37.1"], "en": "also Kosambi and Sāketa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:37.2"], "en": "and Sāvatthī, the supreme city.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:37.3"], "en": "Setavya and Kapilavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:37.4"], "en": "Kusinārā and Mandira,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:38.1"], "en": "Pāvā and Bhoganagara—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:38.2"], "en": "Vesālī, the city of Magadha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:38.3"], "en": "and the Pāsāṇaka Cetiya,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:38.4"], "en": "delightful and enchanting.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:39.1"], "en": "Like a thirsty man for cool water,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:39.2"], "en": "like a merchant for great gain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:39.3"], "en": "or like one scorched by heat for shade—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:39.4"], "en": "In haste, they climbed the mountain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:40.1", "PA_cnd_1:40.2"], "en": "At that time, the Blessed One was seated in the midst of the community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:40.3"], "en": "He teaches the Dhamma to the bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:40.4"], "en": "roaring like a lion in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:41.1"], "en": "Ajita saw the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:41.2"], "en": "Like the sun with its golden rays,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:41.3"], "en": "like the moon on the fifteenth day,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:41.4"], "en": "having reached its fullness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:42.1", "PA_cnd_1:42.2"], "en": "Then, seeing his limbs and his complete set of characteristics,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:42.3"], "en": "he stood to one side, joyful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:42.4"], "en": "Ask your question regarding the mind:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:43.1"], "en": "\"Tell us of his birth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:43.2"], "en": "tell us of his clan, and tell us of his defining characteristics.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:43.3"], "en": "\"Tell me the perfection in the mantras;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:43.4"], "en": "how many verses does the brahmin recite?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:44.1"], "en": "\"The lifespan is one hundred and twenty years.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:44.2"], "en": "He was Bāvarī by clan;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:44.3"], "en": "there were three marks upon his body,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:44.4"], "en": "and he had mastered the three Vedas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:45.1", "PA_cnd_1:45.2", "PA_cnd_1:45.3"], "en": "He recited five hundred [verses] on the characteristics [of great men], on history, and on the Nighaṇṭu and Keṭubha lexicons.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:45.4", "PA_cnd_1:46.1"], "en": "“O Supreme among Men, you have reached perfection in the True Dhamma. [I ask] you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:46.2"], "en": "Bāvari, for an analysis of the marks.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:46.3"], "en": "\"Severing craving, explain this;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:46.4"], "en": "let there be no doubt remaining for us.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:47.1"], "en": "\"He covers his mouth with his tongue,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:47.2"], "en": "Between the eyebrows of Uṇṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:47.3"], "en": "the male organ is sheathed—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:47.4"], "en": "know this thus, young man.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:48.1"], "en": "Not hearing anything at all asked,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:48.2"], "en": "but having heard the questions answered,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:48.3"], "en": "all the people reflect upon them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:48.4"], "en": "Born of the Vedas, with palms joined in reverence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:49.1"], "en": "he asked: \"Who indeed is this— whether a deva,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:49.2"], "en": "or Brahmā, or Indra, the lord of the Sujās?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:49.3"], "en": "“Regarding the question asked by the mind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:49.4"], "en": "what is it that provides the answer?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:50.1"], "en": "“The head and the striking of the head,” [he replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:50.2"], "en": "Bāvarī asks a question;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:50.3"], "en": "O Blessed One, explain that to us,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:50.4"], "en": "and dispel our doubt, O Seer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:51.1"], "en": "“Know that ignorance is the seal,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:51.2"], "en": "and true knowledge is what breaks the seal;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:51.3"], "en": "through faith, mindfulness, and concentration,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:51.4"], "en": "“Endowed with zeal and energy.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:52.1", "PA_cnd_1:52.2"], "en": "Then, having steadied himself with great resolve, the young man—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:52.3"], "en": "Arranging his deerskin garment over one shoulder,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:52.4"], "en": "he prostrated with his head at [the Buddha’s] feet:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:53.1"], "en": "“The brahmin Bāvarī, O Blessed One, [has sent me].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:53.2"], "en": "Together with his disciples, O Noble One,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:53.3"], "en": "with uplifted heart and joyful mind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:53.4"], "en": "he who possesses the eye pays homage at your feet.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:54.1", "PA_cnd_1:54.2"], "en": "“May the brahmin Bāvarī be happy, together with his disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:54.3"], "en": "and may you also be happy.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:54.4"], "en": "Live long, young man!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:55.1", "PA_cnd_1:55.2"], "en": "May all the doubts of both Bāvari and yourself, as well as those of everyone else, be completely resolved.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:55.3", "PA_cnd_1:55.4"], "en": "\"Permission has been granted; ask whatever you desire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:56.1"], "en": "Thus was permission granted by the Fully Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:56.2"], "en": "Having sat down with palms joined,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:56.3", "PA_cnd_1:56.4"], "en": "Ajita there asked the Tathāgata his first question.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_1:56.5"], "en": "The introductory verses are concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
