[
{"segs": ["PA_ja_445:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:0.2"], "en": "The Collection of Ten,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:0.3"], "en": "Chapter on the Four Gates (Catudvāravagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:0.4"], "en": "7. The Nigrodha Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:1.1", "PA_ja_445:1.2"], "en": "“I do not know this at all— who he is, or to whom he belongs.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:1.3", "PA_ja_445:1.4"], "en": "\"Just as Sākha conducts himself, so do you, Nigrodha; what do you think of this?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:2.1"], "en": "Then, with his neck hanging down...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:2.2"], "en": "Men carried me away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:2.3"], "en": "giving me blows on the face,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:2.4"], "en": "acting upon the words of Sākha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:3.1", "PA_ja_445:3.2", "PA_ja_445:3.3"], "en": "Such an ignoble deed was committed by the foolish Sākha, who was ungrateful and treacherous.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:3.4"], "en": "\"By your friend, O lord of men.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:4.1"], "en": "\"I do not know this,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:4.2"], "en": "nor does anyone tell it to me;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:4.3"], "en": "What you have told me, friend,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:4.4"], "en": "was done for the sake of a friend;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:5.1"], "en": "it is that which sustains the life of friends.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:5.2"], "en": "\"Both these things belong to my friend:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:5.3", "PA_ja_445:5.4"], "en": "you are the giver of sovereignty to us and of greatness among men.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:5.5"], "en": "The power of transformation has been obtained by me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:5.6"], "en": "of this I have no doubt.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:6.1"], "en": "Just as a seed in fire...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:6.2"], "en": "It burns but does not grow;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:6.3", "PA_ja_445:6.4"], "en": "likewise, what is done for a bad person perishes and does not grow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:7.1"], "en": "In a person who is grateful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:7.2"], "en": "virtuous, and of noble conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:7.3"], "en": "[offerings] are like seeds sown in a fertile field.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:7.4"], "en": "“Nothing said there is lost.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:8.1", "PA_ja_445:8.2"], "en": "[The Buddha said: “This rogue, this deceiver, who thinks like an ignoble person;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:8.3"], "en": "“Strike him with spears at the branches;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:8.4"], "en": "I do not wish for his life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:9.1"], "en": "“Forgive him, O Great King.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:9.2"], "en": "\"Living beings are not to be slain;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:9.3"], "en": "O King, forgive this wicked man,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:9.4"], "en": "for I do not desire his death.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:10.1"], "en": "“One should cultivate the banyan tree,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:10.2"], "en": "not dwell among the branches;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:10.3"], "en": "death in the banyan is better.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:10.4"], "en": "\"And even if one must live upon branches.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_445:11.1"], "en": "Thus ends the seventh Jātaka, the Nigrodha Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
