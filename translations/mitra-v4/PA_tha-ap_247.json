[
{"segs": ["PA_tha-ap_247:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_247:0.2"], "en": "The Section on the Giver of the Tuvara Fruit, 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_247:0.3"], "en": "The Apadāna of the Elder Kuṭidhūpaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_247:1.1", "PA_tha-ap_247:1.2"], "en": "“I was the hut-keeper for the Blessed One Siddhattha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_247:1.3"], "en": "from time to time, I offered incense.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_247:1.4"], "en": "With my own hands, full of faith;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_247:2.1", "PA_tha-ap_247:2.2"], "en": "that deed which I performed back then, ninety-four aeons ago—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_247:2.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_247:2.4"], "en": "this is the fruit of offering incense.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_247:3.1"], "en": "The four analytical knowledges (paṭisambhidā) [are mine].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_247:3.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_247:3.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_247:4.1"], "en": "Thus indeed did the Venerable Elder Kuṭidhūpaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_247:5.1"], "en": "The legend of the Elder Kuṭidhūpaka is the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
