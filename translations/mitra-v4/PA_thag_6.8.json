[
{"segs": ["PA_thag_6.8:0.1", "PA_thag_6.8:0.2"], "en": "Theragāthā 6.8 Chakkanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:0.3"], "en": "First Chapter (Paṭhamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:0.4"], "en": "The Verses of the Elder Migajāla:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:1.1"], "en": "“Well-expounded by the Visionary One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:1.2"], "en": "the Buddha, the Kinsman of the Sun;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:1.3"], "en": "He has transcended all fetters,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:1.4"], "en": "he is the destroyer of all cyclic existence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:2.1"], "en": "he is the one who leads out and brings across.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:2.2"], "en": "It destroys the root of craving;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:2.3", "PA_thag_6.8:2.4"], "en": "having cut off the slaughter-ground that is the root of enmity, it leads one to final peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:3.1"], "en": "For the destruction of the root of ignorance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:3.2"], "en": "for the shattering of the machinery of karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:3.3"], "en": "and for the full comprehension of consciousnesses—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:3.4"], "en": "The striker with the thunderbolt of knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:4.1"], "en": "the one who makes feelings known,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:4.2"], "en": "and the liberator from grasping.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:4.3", "PA_thag_6.8:4.4"], "en": "Observing with wisdom that existence is like a pit of glowing embers—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:5.1"], "en": "vast in its flavor and profoundly deep.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:5.2", "PA_thag_6.8:5.3"], "en": "The Noble Eightfold Path wards off old age and death;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:5.4"], "en": "it brings the cessation of suffering and is auspicious.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:6.1"], "en": "Having understood action as action,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:6.2"], "en": "and ripening as ripening,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:6.3"], "en": "of phenomena arisen through dependence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:6.4"], "en": "One who sees according to the light,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:6.5"], "en": "a peaceful one who goes to great security,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:6.6"], "en": "is auspicious in the end.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.8:6.7"], "en": "… the Elder Migajala …", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
