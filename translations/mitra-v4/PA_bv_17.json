[
{"segs": ["PA_bv_17:0.1"], "en": "Buddhavamsa 17:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:0.2", "PA_bv_17:1.1"], "en": "The Lineage of Buddha Dhammadassī “In that very same auspicious aeon (maṇḍakappa),” [it is said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:1.2"], "en": "Dhammadassī of great renown,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:1.3"], "en": "having dispelled that darkness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:1.4"], "en": "shines forth pre-eminently among gods and humans.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:2.1", "PA_bv_17:2.2"], "en": "At the turning of the Wheel of Dhamma by him of incomparable majesty,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:2.3"], "en": "there were [offerings] from one hundred thousand times ten million [beings].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:2.4"], "en": "This was my first clear realization,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:3.1", "PA_bv_17:3.2"], "en": "when the Buddha Dhammadassi disciplined the seer Sañjaya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:3.3", "PA_bv_17:3.4"], "en": "At that time, there was a second realization for ninety koṭis [of beings],", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:4.1"], "en": "when Sakka approached.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:4.2"], "en": "Together with his retinue,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:4.3"], "en": "he approached the Guide; at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:4.4"], "en": "there was a third realization for eighty koṭis.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:5.1"], "en": "For that God of Gods as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:5.2", "PA_bv_17:5.3"], "en": "there were three assemblies of those who had exhausted the taints and were stainless.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:5.4", "PA_bv_17:6.1"], "en": "When the Buddha Dhammadassi, whose mind was peaceful and who was equanimous,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:6.2"], "en": "entered the rains retreat at Saraṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:6.3", "PA_bv_17:6.4"], "en": "At that time, there was a first gathering of one hundred thousand times ten million [beings].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:7.1"], "en": "Furthermore, when the Buddha—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:7.2"], "en": "A deity approached a human being;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:7.3", "PA_bv_17:7.4"], "en": "even then, there was a second assembly of seven hundred million.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:8.1", "PA_bv_17:8.2"], "en": "Furthermore, when the Buddha proclaimed the virtues of ascetic purification (dhuta),", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:8.3"], "en": "at that time, of eighty koṭis—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:8.4"], "en": "This was the third assembly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:9.1"], "en": "At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:9.2"], "en": "I was Sakka, the first-giver (Purindada).", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:9.3"], "en": "With divine garlands and perfumes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:9.4"], "en": "and with music, I paid him honor.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:10.1"], "en": "That Buddha, too, gave me this prediction:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:10.2"], "en": "Having sat down in the midst of the gods, [the Buddha declared]:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:10.3"], "en": "“In eighteen hundred kalpas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:10.4"], "en": "this one shall become a Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:11.1"], "en": "Having exerted ourselves in striving,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:11.2", "PA_bv_17:11.3"], "en": "…pe… we shall stand face to face with this one.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:12.1"], "en": "Having heard her words as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:12.2"], "en": "my mind became even more serene;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:12.3"], "en": "I resolved upon a further vow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:12.4"], "en": "Through the fulfillment of the ten perfections.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:13.1"], "en": "There was a city named Saraṇa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:13.2"], "en": "and a kshatriya named Saraṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:13.3", "PA_bv_17:13.4"], "en": "The mother of the Teacher Dhammadassi was named Sunandā;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:14.1"], "en": "for eight thousand years—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:14.2"], "en": "He dwelt within the house;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:14.3"], "en": "stainless, free from dust, and beautiful to behold,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:14.4"], "en": "he possessed three supreme palaces.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:15.1", "PA_bv_17:15.2"], "en": "Thirty-four thousand women were beautifully adorned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:15.3"], "en": "there was a woman named Vicikoḷī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:15.4"], "en": "There was born a son who increased his merit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:16.1"], "en": "Having seen four omens,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:16.2"], "en": "he went forth from the palace.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:16.3", "PA_bv_17:16.4"], "en": "For seven days the Supreme Person practiced ascetic exertion,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:17.1"], "en": "even though he was entreated by Brahmā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:17.2"], "en": "Dhammadassi, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:17.3", "PA_bv_17:17.4"], "en": "the great hero, the supreme among humans, set the wheel in motion at Migadāya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:18.1", "PA_bv_17:18.2"], "en": "Paduma and Phussadeva were his chief disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:18.3"], "en": "he who was named Sunetta was the attendant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:18.4"], "en": "Of the Teacher Dhammadassi,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:19.1", "PA_bv_17:19.2"], "en": "Khemā and Saccā were the two chief female disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:19.3", "PA_bv_17:19.4"], "en": "The Bodhi tree of that Blessed One is called Bimbijāla.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:20.1"], "en": "Subhadda and Kaṭissaha—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:20.2", "PA_bv_17:20.3"], "en": "They were the foremost attendants;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:20.4"], "en": "Sāḷī and Kaḷī were the chief supporters.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:21.1"], "en": "He too was a Buddha, peerless and equal to none,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:21.2"], "en": "rising eighty cubits high;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:21.3"], "en": "he outshone all with his splendor.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:21.4"], "en": "Within the ten-thousandfold world system,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:22.1"], "en": "like a magnificent sal tree in full bloom,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:22.2"], "en": "or like lightning in the sky;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:22.3"], "en": "Like the sun at midday,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:22.4"], "en": "he shone thus; even of him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:23.1"], "en": "possessed of incomparable splendor, [the radiance was such].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:23.2"], "en": "His life was equal [to that of others];", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:23.3", "PA_bv_17:23.4"], "en": "the Visionary One remained in the world for one hundred thousand years.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:24.1", "PA_bv_17:24.2"], "en": "Having displayed his radiance and having purified the Teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:24.3"], "en": "he passed away like the moon from the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:24.4"], "en": "He has attained Nibbāna along with his disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:25.1", "PA_bv_17:25.2"], "en": "The Great Hero Dhammadassi attained Nibbāna in the Sal Grove.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:25.3"], "en": "Right there his excellent stupa rose three yojanas high.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:25.4"], "en": "Thus ends the fifteenth chapter:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_17:26.1"], "en": "the lineage of the Blessed One Dhammadassi.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
