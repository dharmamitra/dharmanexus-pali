[
{"segs": ["PA_pv_42:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:0.2"], "en": "Mahāvagga 7.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:0.3"], "en": "The Story of the Prince’s Ghost (Rājaputtapetavatthu)", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:1.1", "PA_pv_42:1.2"], "en": "The ripening of deeds performed in the past may shatter the mind regarding forms,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:1.3"], "en": "sounds, tastes, and smells.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:1.4"], "en": "And delightful tactile sensations;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:2.1", "PA_pv_42:2.2"], "en": "having experienced no small amount of dancing, singing, pleasure, and sport;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:2.3"], "en": "Having wandered about in the park,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:2.4"], "en": "as he was entering Giribbaja,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:3.1"], "en": "he saw the seer Sunetta.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:3.2"], "en": "One who has tamed themselves, is concentrated,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:3.3"], "en": "has few desires, is endowed with moral shame,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:3.4"], "en": "and delights in scraps gathered in their bowl.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:4.1"], "en": "Having descended from the back of the elephant,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:4.2"], "en": "he said, \"I have received it, venerable sir\"; then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:4.3"], "en": "taking his bowl, [he gave it to him].", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:4.4"], "en": "Raising it high,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:5.1", "PA_pv_42:5.2"], "en": "the kshatriya broke his bowl upon the bare ground and departed laughing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:5.3"], "en": "“I am the son of a gambling king;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:5.4"], "en": "what can you do to me, monk?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:6.1"], "en": "Because of that harsh deed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:6.2"], "en": "The ripening was bitter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:6.3", "PA_pv_42:6.4"], "en": "which the prince experienced when he was cast into hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:7.1", "PA_pv_42:7.2"], "en": "For ninety-four million and sixty thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:7.3"], "en": "you underwent intense suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:7.4", "PA_pv_42:8.1"], "en": "Having committed evil deeds, he was cooked in hell—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:8.2"], "en": "upside down, face up, and on his left and right sides.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:8.3"], "en": "Standing with his feet upwards,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:8.4"], "en": "the fool cooked for a long time—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:9.1"], "en": "for many thousands of years.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:9.2"], "en": "In multitudes and by the hundreds of millions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:9.3"], "en": "you experienced intense suffering in hell,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:9.4"], "en": "having committed evil deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:10.1", "PA_pv_42:10.2"], "en": "Such is the bitter ripening for one who harbors malice toward those who are without fault;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:10.3"], "en": "thus do evil deeds come to fruition.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:10.4"], "en": "Having assailed one who is virtuous,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:11.1", "PA_pv_42:11.2"], "en": "he experiences much suffering there for many years.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:11.3"], "en": "Afflicted by hunger and thirst,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:11.4"], "en": "he became a peta after passing away from there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:12.1"], "en": "Having understood this danger, [one should reflect].", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:12.2", "PA_pv_42:12.3"], "en": "Having abandoned the intoxication of lordship, one should follow the windless state,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:12.4"], "en": "free from the pride of lordship.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:13.1", "PA_pv_42:13.2"], "en": "Praiseworthy in this very life is he who has reverence for the Buddhas;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:13.3"], "en": "at the breaking up of the body, that wise one—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:13.4"], "en": "\"He is reborn in heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_42:14.1"], "en": "This is the seventh story of the Prince-Peta.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"}
]
