{"segs": ["PA_thag_1.56:0.1", "PA_thag_1.56:0.2", "PA_thag_1.56:0.3"], "en": "Theragāthā 1.56 Ekakanipāta Chaṭṭhavagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.56:0.4"], "en": "The Verses of the Elder Kuṭivihāri Thera:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.56:1.1"], "en": "“Who is the bhikkhu in his hut, in his hut,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.56:1.2"], "en": "who is free from passion and whose mind is well-composed?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.56:1.3"], "en": "\"Know this, friend:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.56:1.4"], "en": "your hut has not been built in vain. ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.56:1.5"], "en": "[Thus spoke] the Elder Kuṭivihārin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
