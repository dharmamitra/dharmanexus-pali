[
{"segs": ["PA_thag_1.34:0.1", "PA_thag_1.34:0.2", "PA_thag_1.34:0.3"], "en": "Theragāthā 1.34 Ekakanipāta Catutthavagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.34:0.4"], "en": "The Verses of the Elder Posiya:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.34:1.1", "PA_thag_1.34:1.2"], "en": "“These are not excellent for one who always possesses discernment;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.34:1.3"], "en": "Having come from the village to the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.34:1.4"], "en": "he then entered his home;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.34:1.5"], "en": "rising from there, he departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.34:1.6"], "en": "“Without having taken leave, one should support [the preceptor].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.34:1.7"], "en": "… The Elder Posiya …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
