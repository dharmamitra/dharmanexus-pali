[
{"segs": ["PA_tha-ap_140:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:0.2"], "en": "Sobhitavagga 8:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:0.3"], "en": "The Apadāna of the Elder Ekapasādaniya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:1.1"], "en": "“Nārada” is my name,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:1.2"], "en": "and I am known as Kesava;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:1.3"], "en": "I am one who knows the wholesome and the unwholesome.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:1.4"], "en": "He approached the presence of the Buddha—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:2.1", "PA_tha-ap_140:2.2"], "en": "the Great Sage, who is benevolent, compassionate, and a seer of the welfare of others.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:2.3"], "en": "Consoling beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:2.4"], "en": "the Visionary teaches the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:3.1"], "en": "having gladdened his own mind, he [teaches].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:3.2", "PA_tha-ap_140:3.3"], "en": "Having placed my hands together in añjali and paid homage to the Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:3.4"], "en": "I departed facing toward the east.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:4.1"], "en": "In the seventeenth century of eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:4.2"], "en": "there was a king, a lord of the earth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:4.3"], "en": "named Amitratāpana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:4.4"], "en": "A wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:5.1", "PA_tha-ap_140:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:5.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:6.1"], "en": "Thus indeed did the venerable elder Ekapasādaniya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_140:7.1"], "en": "This is the eighth legend of the elder Ekapasādaniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
