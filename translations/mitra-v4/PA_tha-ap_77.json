[
{"segs": ["PA_tha-ap_77:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:0.2"], "en": "Nāgasamāla Chapter 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:0.3"], "en": "The Apadāna of the Elder Ekasaññaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:1.1"], "en": "“By name you were Khaṇḍa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:1.2"], "en": "a disciple of Vipassī’s foremost [disciples];", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:1.3"], "en": "a single alms-offering was given by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:1.4"], "en": "O recipient of the world's offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:2.1", "PA_tha-ap_77:2.2"], "en": "O Lord of bipeds, O Bull among men, by that clarity of mind—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:2.3"], "en": "I do not recall being born in an evil state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:2.4"], "en": "this is the fruit of giving a single alms-offering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:3.1"], "en": "For forty eons, I have remained [in heaven].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:3.2"], "en": "A kshatriya named Varuṇa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:3.3", "PA_tha-ap_77:3.4"], "en": "a wheel-turning monarch of great power, endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:4.1", "PA_tha-ap_77:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:5.1"], "en": "Thus indeed did the venerable elder Ekasaññaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_77:6.1"], "en": "This is the fifth legend of the elder Ekasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
