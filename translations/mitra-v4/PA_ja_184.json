[
{"segs": ["PA_ja_184:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_184:0.2", "PA_ja_184:0.3"], "en": "The Second Book of Pairs (Dukanipāta), Chapter on the Peerless (Asadisavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_184:0.4"], "en": "4. The Giridatta Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_184:1.1", "PA_ja_184:1.2"], "en": "“The horse Paṇḍava, belonging to Sāma, was provoked by Giridatta.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_184:1.3"], "en": "Having abandoned his ancient nature,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_184:1.4"], "en": "he conforms to that very [new] one;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_184:2.1"], "en": "and if the person is born of that [nature], he follows it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_184:2.2"], "en": "Shaped like a peak;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_184:2.3", "PA_ja_184:2.4"], "en": "having grasped it at the mouth, one should rotate it within the mandala.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_184:2.5"], "en": "\"Having quickly abandoned [the former],", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_184:2.6"], "en": "one should conform to that very [new] one.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_184:3.1"], "en": "Thus ends the fourth Jātaka, the Giridatta Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
