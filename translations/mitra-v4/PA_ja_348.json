[
{"segs": ["PA_ja_348:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:0.2", "PA_ja_348:0.3"], "en": "Catukkanipāta, Cūḷakuṇālavagga (The Short Kuṇāla Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:0.4"], "en": "8. The Araññajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:1.1", "PA_ja_348:1.2"], "en": "“Having come from the forest to the village, what kind of virtue and what kind of conduct should I maintain?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:1.3", "PA_ja_348:1.4"], "en": "“O dear one, tell me when asked: what kind of man should I serve?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:2.1"], "en": "“He who would inspire confidence in you, my dear,” [the father replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:2.2"], "en": "And may you forgive his lack of trust;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:2.3"], "en": "being one who listens and is patient,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:2.4"], "en": "go from here and associate with him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:3.1", "PA_ja_348:3.2"], "en": "He for whom there is no ill-deed by body, speech, or mind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:3.3"], "en": "stands firm as if supported by his own chest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:3.4"], "en": "Go from here and associate with that person who has abandoned passion,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:4.1"], "en": "whose mind is like turmeric,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:4.2"], "en": "and who is free from lust.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:4.3"], "en": "“O dear one, do not associate with such a person,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:4.4"], "en": "even if they were a non-human being.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_348:5.1"], "en": "Thus ends the eighth Jātaka, the Arañña-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
