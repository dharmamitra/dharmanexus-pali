[
{"segs": ["PA_thag_12.1:0.1", "PA_thag_12.1:0.2", "PA_thag_12.1:0.3"], "en": "Theragāthā 12.1 Dvādasaka-nipāta Paṭhama-vagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:0.4"], "en": "The Verses of the Elder Sīlava:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:1.1"], "en": "“One should train here in virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:1.2"], "en": "well-trained in this world;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:1.3"], "en": "For virtue, when cultivated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:1.4"], "en": "brings all success;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:2.1"], "en": "a wise person should guard their virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:2.2"], "en": "Aspiring for three kinds of happiness:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:2.3"], "en": "praise, the acquisition of wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:2.4"], "en": "and rejoicing in heaven after death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:3.1", "PA_thag_12.1:3.2"], "en": "For one who is virtuous attains many friends through self-restraint,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:3.3"], "en": "whereas the immoral person [is abandoned] by friends.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:3.4"], "en": "The evil-doer falls away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:4.1", "PA_thag_12.1:4.2"], "en": "the immoral man gains disrepute and infamy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:4.3", "PA_thag_12.1:4.4"], "en": "One who is virtuous always obtains beauty, fame, and praise;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:5.1"], "en": "virtue is the beginning and the foundation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:5.2", "PA_thag_12.1:5.3"], "en": "It is the mother of all wholesome states and the foremost of all dharmas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:5.4"], "en": "therefore, one should purify one’s virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:6.1"], "en": "The time, restraint, virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:6.2"], "en": "the gladdening of the mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:6.3"], "en": "and the station of all Buddhas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:6.4"], "en": "Therefore, one should purify one’s virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:7.1"], "en": "Virtue is peerless strength;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:7.2"], "en": "virtue is the supreme weapon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:7.3"], "en": "Virtue is the most excellent ornament;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:7.4"], "en": "virtue is a wondrous armor;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:8.1"], "en": "virtue is a bridge of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:8.2"], "en": "Virtue is the unsurpassed fragrance;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:8.3"], "en": "virtue is the supreme ointment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:8.4"], "en": "by which one's scent wafts in every direction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:9.1"], "en": "Virtue is the supreme provision,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:9.2", "PA_thag_12.1:9.3"], "en": "virtue is the best travel rations; virtue is the finest vehicle.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:9.4"], "en": "Whichever direction one goes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:10.1"], "en": "one meets with blame right here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:10.2"], "en": "and after death, one is dejected in the states of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:10.3"], "en": "In every respect, the fool is dejected,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:10.4"], "en": "being unconcentrated in his moral virtues;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:11.1"], "en": "yet he gains fame even in this very world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:11.2"], "en": "And having passed away, he is joyful in heaven;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:11.3"], "en": "the wise one is joyful everywhere,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:11.4"], "en": "being well-composed in his virtues.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:12.1"], "en": "Virtue alone is supreme here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:12.2", "PA_thag_12.1:12.3"], "en": "but one possessed of wisdom is the highest among humans and gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:12.4"], "en": "“Victory through virtue and wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.1:12.5"], "en": "… Thus spoke the Elder Sīlava.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
