[
{"segs": ["PA_tha-ap_14:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:0.2"], "en": "The Chapter on the Lion-Throned One (Sīhāsaniyavagga), 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:0.3"], "en": "The Apadāna of the Elder Ekatthambhika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:1.1"], "en": "“For the Blessed One Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:1.2"], "en": "there was a great multitude of followers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:1.3"], "en": "they had gone for refuge to the Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:1.4"], "en": "They have faith in the Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:2.1"], "en": "Having all come together and consulted one another,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:2.2"], "en": "they build a pavilion for the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:2.3"], "en": "Not finding a single pillar,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:2.4"], "en": "they searched throughout the great forest;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:3.1"], "en": "having seen them there in the wilderness, [he said:]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:3.2", "PA_tha-ap_14:3.3"], "en": "Having then approached the assembly and raised my hands in reverent salutation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:3.4"], "en": "I questioned the assembly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:4.1"], "en": "Thus questioned by me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:4.2"], "en": "those virtuous lay followers replied:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:4.3"], "en": "\"We desire to have a gabled hall built.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:4.4"], "en": "\"A single pillar cannot be obtained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:5.1"], "en": "Give me a single pillar,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:5.2"], "en": "and I shall give one to the Teacher.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:5.3"], "en": "\"I shall take the pillar;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:5.4"], "en": "let them be free from anxiety.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:6.1"], "en": "They granted me the pillar.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:6.2"], "en": "Tranquil and joyful in mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:6.3", "PA_tha-ap_14:6.4"], "en": "they turned back from there and went to their own homes.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:7.1"], "en": "Not long after the assembly had departed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:7.2"], "en": "I then gave a pillar;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:7.3"], "en": "joyful with a joyful heart, I offered it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:7.4"], "en": "I offered my first [gift].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:8.1"], "en": "By that clarity of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:8.2"], "en": "I was reborn in a celestial mansion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:8.3", "PA_tha-ap_14:8.4"], "en": "My palace is lofty, rising seven stories high;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:9.1"], "en": "while the drums are being beaten,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:9.2"], "en": "I always served him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:9.3"], "en": "in the fifty-fifth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:9.4"], "en": "I was King Yasodhara.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:10.1", "PA_tha-ap_14:10.2"], "en": "There too, my palace rose up seven stories high,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:10.3"], "en": "adorned with the finest gabled chambers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:10.4"], "en": "A single-pillared, delightful [palace].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:11.1"], "en": "In the twenty-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:11.2"], "en": "there was a kshatriya named Udena;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:11.3", "PA_tha-ap_14:11.4"], "en": "There too, my dwelling was a seven-storied mansion rising high;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:12.1"], "en": "whichever womb I was reborn into, [there it would appear].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:12.2"], "en": "Whether in the realm of the gods or among humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:12.3"], "en": "I experience every happiness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:12.4"], "en": "this is the fruit of that single pillar.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:13.1", "PA_tha-ap_14:13.2"], "en": "For ninety-four eons since I gave that pillar at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:13.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:13.4"], "en": "This is the fruit of offering a single pillar:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:14.1", "PA_tha-ap_14:14.2"], "en": "the four analytical knowledges and these eight liberations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:14.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:14.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:15.1"], "en": "Thus indeed did the elder Thera Ekatthambhika speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_14:16.1"], "en": "The legend of the Elder Ekatthambhika is the second.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
