[
{"segs": ["PA_thi-ap_13:0.1"], "en": "Therīapadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:0.2"], "en": "Ekūposathika-vagga, 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:0.3"], "en": "The Apadāna of the Elder Nun Modakadāyikā", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:1.1"], "en": "“In the city of Bandhumatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:1.2"], "en": "I was a water-carrier slave girl;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:1.3"], "en": "having taken my portion, [I gave it to the Buddha].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:1.4"], "en": "While going to fetch water,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:2.1", "PA_thi-ap_13:2.2"], "en": "I saw on the path a śramaṇa whose mind was peaceful and composed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:2.3"], "en": "With a clear mind and joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:2.4"], "en": "I gave three sweetmeats.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:3.1"], "en": "By that well-performed deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:3.2"], "en": "And through my volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:3.3", "PA_thi-ap_13:3.4"], "en": "for ninety-one eons I did not go to a state of ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:4.1"], "en": "Having performed that deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:4.2"], "en": "I experienced all that prosperity;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:4.3"], "en": "having given three sweetmeats, I [attained this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:4.4"], "en": "I have attained the unshakable state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:5.1"], "en": "my defilements have been incinerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:5.2"], "en": "…pe…", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:5.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:6.1", "PA_thi-ap_13:6.2"], "en": "Welcome indeed has come to me... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:6.3"], "en": "The Buddha’s teaching has been proclaimed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:7.1", "PA_thi-ap_13:7.2"], "en": "the four analytical knowledges, and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:7.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:8.1"], "en": "In this way, it is said, the nun Modakadāyikā recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_13:9.1"], "en": "This is the third legend of the Elder Nun Modakadāyikā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
