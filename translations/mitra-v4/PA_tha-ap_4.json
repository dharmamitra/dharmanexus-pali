[
{"segs": ["PA_tha-ap_4:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:0.2"], "en": "Buddhavagga 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:0.3"], "en": "The Legend of the Elder Mahāmoggallāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:1.1"], "en": "“The Blessed One Anomadassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:1.2"], "en": "the eldest in the world, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:1.3"], "en": "dwelt in the Himalayas.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:1.4"], "en": "Honored by the assembly of gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:2.1", "PA_tha-ap_4:2.2"], "en": "I was then a king of the nāgas named Varuṇa by name.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:2.3"], "en": "I am able to transform myself at will,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:2.4"], "en": "dwelling in the great ocean;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:3.1"], "en": "having abandoned the company of the multitude, I live alone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:3.2"], "en": "I had musical instruments set forth; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:3.3"], "en": "surrounding the Perfectly Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:3.4"], "en": "the celestial nymphs played them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:4.1"], "en": "While the instruments were being played,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:4.2"], "en": "the gods played their own instruments;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:4.3"], "en": "having heard the sound of both, [the people]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:4.4"], "en": "The Buddha also fully awakened.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:5.1"], "en": "Having invited the Perfectly Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:5.2"], "en": "I returned to my own abode.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:5.3"], "en": "Having prepared a seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:5.4", "PA_tha-ap_4:6.1"], "en": "I announced the time; [I was there] with a thousand monks whose taints were destroyed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:6.2"], "en": "Surrounded by his retinue, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:6.3"], "en": "illuminating all directions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:6.4"], "en": "came to my abode.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:7.1"], "en": "I satisfied the Great Hero who had sat down—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:7.2"], "en": "the God of gods, the Bull among men—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:7.3"], "en": "along with the community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:7.4", "PA_tha-ap_4:8.1", "PA_tha-ap_4:8.2"], "en": "Then the Great Hero, the Self-Existent One, the Supreme Person, expressed his appreciation for my food and drink.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:8.3"], "en": "Having sat down in the community of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:8.4"], "en": "he spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:9.1"], "en": "\"He who honored the Saṅgha...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:9.2"], "en": "And the Buddha, the Leader of the World;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:9.3"], "en": "by that clarity of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:9.4"], "en": "he shall go to the world of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:10.1", "PA_tha-ap_4:10.2"], "en": "And seventy-seven times he will exercise sovereignty over the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:10.3"], "en": "a hundred and eight times he will rule over the earth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:10.4"], "en": "He will dwell upon the earth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:11.1", "PA_tha-ap_4:11.2"], "en": "And fifty-five times he will become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:11.3", "PA_tha-ap_4:11.4", "PA_tha-ap_4:12.1"], "en": "Incalculable enjoyments will arise for him for as long as that immeasurable eon from now.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:12.2"], "en": "Born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:12.3", "PA_tha-ap_4:12.4"], "en": "he will be a teacher in the world named Gotama by lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:13.1"], "en": "Having passed away from hell,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:13.2"], "en": "he will go to the human state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:13.3"], "en": "his name shall be Kolita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:13.4"], "en": "He will become a mere kinsman of Brahmins.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:14.1"], "en": "Later, having gone forth into homelessness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:14.2"], "en": "he will be impelled by the root of merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:14.3", "PA_tha-ap_4:14.4"], "en": "He will be the second disciple of the Blessed One Gotama—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:15.1"], "en": "aroused in energy and resolute in self-exertion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:15.2"], "en": "Having reached perfection in supernormal power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:15.3"], "en": "and having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:15.4"], "en": "he will attain Nibbāna, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:16.1"], "en": "Relying on evil friends,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:16.2"], "en": "fallen under the sway of sensual lust,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:16.3"], "en": "[he even killed] his mother and his father.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:16.4"], "en": "With a wicked mind, I caused them to be slain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:17.1"], "en": "Whichever womb I was reborn into—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:17.2"], "en": "whether in hell or among humans—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:17.3"], "en": "Possessing evil karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:17.4"], "en": "I am dying with my head split asunder;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:18.1"], "en": "this is my final existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:18.2"], "en": "The final existence proceeds;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:18.3", "PA_tha-ap_4:18.4"], "en": "here too, such will be my state at the time of death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:19.1"], "en": "Devoted to solitude,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:19.2"], "en": "delighting in the cultivation of concentration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:19.3"], "en": "and having fully understood all taints—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:19.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:20.1"], "en": "Even the earth, though very deep,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:20.2"], "en": "thick, and difficult to shake;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:20.3", "PA_tha-ap_4:20.4"], "en": "Having reached the perfection of psychic power, I could shake [the earth] with my left big toe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:21.1"], "en": "yet I do not perceive any conceit of \"I am.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:21.2"], "en": "Pride does not exist within me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:21.3"], "en": "toward even a novice monk,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:21.4"], "en": "I maintain a mind of reverence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:22.1"], "en": "In an immeasurable eon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:22.2", "PA_tha-ap_4:22.3"], "en": "the karma that I brought forth has led me to reach this ground.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:22.4"], "en": "I have attained the destruction of the taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:23.1", "PA_tha-ap_4:23.2"], "en": "The four analytical knowledges and these eight liberations—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:23.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:23.4"], "en": "the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:24.1"], "en": "Thus indeed did the Elder, the Venerable Mahāmoggallāna, speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_4:25.1"], "en": "The legend of the Elder Mahāmoggallāna is the second.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
