[
{"segs": ["PA_thi-ap_39:0.1", "PA_thi-ap_39:0.2"], "en": "The Therī-apadāna, Chapter on the Khattiyās, No. 9:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:0.3"], "en": "The Apadāna of the Elder Nun Ambapālī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:1.1"], "en": "“Raṁsiphusitāveḷa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:1.2"], "en": "the great sage named Phussa—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:1.3"], "en": "of him I was the sister.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:1.4"], "en": "I was born into a khattiya family.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:2.1"], "en": "Having heard his Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:2.2"], "en": "with a mind full of serene confidence, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:2.3"], "en": "Having given a great gift,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:2.4"], "en": "I prayed for perfection of form.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:3.1"], "en": "Thirty-one eons ago from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:3.2"], "en": "Sikhī, the leader of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:3.3"], "en": "has arisen as the lamp of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:3.4"], "en": "the Victor who is the refuge of the three worlds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:4.1"], "en": "Then, in the delightful city of Āruṇavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:4.2", "PA_thi-ap_39:4.3"], "en": "a woman born of a brahmin family became enraged at one whose mind was liberated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:4.4"], "en": "I cursed a bhikkhunī, saying:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:5.1"], "en": "\"She is a harlot of improper conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:5.2"], "en": "a defiler of the Victor’s teaching.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:5.3"], "en": "Having thus reviled him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:5.4"], "en": "by that evil deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:6.1"], "en": "he went to a terrible hell.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:6.2"], "en": "Afflicted by great suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:6.3", "PA_thi-ap_39:6.4"], "en": "she passed away from there and was reborn among humans as an ascetic woman.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:7.1"], "en": "For ten thousand births,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:7.2"], "en": "I practiced the profession of a courtesan;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:7.3"], "en": "from that evil, I shall not be released.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:7.4"], "en": "Having become like a malignant poison,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:8.1", "PA_thi-ap_39:8.2"], "en": "I shall practice the holy life under the teaching of the Conqueror Kassapa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:8.3"], "en": "By the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:8.4"], "en": "I was born in the city of the Thirty-three;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:9.1"], "en": "when my final existence arrived, I was reborn here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:9.2"], "en": "I was born spontaneously;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:9.3"], "en": "because I was born within the fork of a mango tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:9.4"], "en": "I am therefore called Ambapālī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:10.1"], "en": "Surrounded by millions of living beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:10.2"], "en": "I went forth in the Conqueror’s teaching;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:10.3"], "en": "I have attained the unshakable state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:10.4"], "en": "I am the Buddha’s own daughter;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:11.1", "PA_thi-ap_39:11.2"], "en": "through the purification of the faculty of hearing, I have attained mastery over the supernormal powers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:11.3", "PA_thi-ap_39:11.4"], "en": "I am a master of the knowledge of others' minds, O Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:12.1"], "en": "I know my former births.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:12.2"], "en": "The divine eye has been purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:12.3"], "en": "all taints are utterly destroyed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:12.4"], "en": "and now there is no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:13.1"], "en": "In the meanings, the phenomena, and the definitions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:13.2"], "en": "and likewise in inspired eloquence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:13.3"], "en": "my knowledge is stainless and pure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:13.4"], "en": "By the power of the Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:14.1", "PA_thi-ap_39:14.2"], "en": "my defilements have been incinerated... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:14.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:15.1", "PA_thi-ap_39:15.2"], "en": "Welcome indeed has come to me... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:15.3"], "en": "The Buddha’s teaching has been accomplished:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:16.1", "PA_thi-ap_39:16.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:16.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:17.1"], "en": "Thus indeed did the bhikkhunī Ambapālī speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_39:18.1"], "en": "This is the ninth legend of the elder nun Ambapālī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
