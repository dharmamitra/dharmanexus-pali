[
{"segs": ["PA_tha-ap_385:0.1", "PA_tha-ap_385:0.2"], "en": "The Therāpadāna, Avaṭaphalavagga: 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:0.3"], "en": "The Apadāna of the Elder Udumbaraphaladāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:1.1"], "en": "\"On the bank of the Vinatānadī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:1.2"], "en": "the Supreme Person dwelt;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:1.3"], "en": "there I saw the Buddha, free from all defilement.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:1.4"], "en": "One-pointed and well-concentrated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:2.1", "PA_tha-ap_385:2.2"], "en": "With a mind full of confidence toward that which washes away the stains of the defilements,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:2.3"], "en": "Having taken an udumbara fruit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:2.4"], "en": "I gave it to the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:3.1"], "en": "Ninety-one aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:3.2"], "en": "Since I gave that fruit back then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:3.3"], "en": "I have never known an evil rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:3.4"], "en": "this is the fruit of giving fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:4.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:4.2", "PA_tha-ap_385:4.3"], "en": "…pe… I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:5.1"], "en": "\"Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:5.2", "PA_tha-ap_385:5.3"], "en": "[and so forth] ...the Buddha’s teaching has been accomplished.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:6.1", "PA_tha-ap_385:6.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:7.1"], "en": "Thus indeed the venerable elder Udumbaraphaladāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_385:8.1"], "en": "This is the third legend of the elder Udumbaraphaladāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
