{"segs": ["PA_thag_1.66:0.2", "PA_thag_1.66:0.3"], "en": "Seventh Chapter (Sattamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.66:0.4"], "en": "The Verse of the Elder Meghiya:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.66:1.1", "PA_thag_1.66:1.2"], "en": "“The Great Hero, who has gone beyond all phenomena, gave me instruction.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.66:1.3"], "en": "Having heard his Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.66:1.4"], "en": "I dwelt in his presence with mindfulness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.66:1.5"], "en": "the threefold knowledge was attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.66:1.6"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.66:1.7"], "en": "… [said] the elder Meghiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
