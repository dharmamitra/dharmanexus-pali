[
{"segs": ["PA_ja_367:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:0.2"], "en": "The Fifth Book of Five,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:0.3"], "en": "Chapter on the Arising of Color (Vaṇṇārohavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:0.4"], "en": "7. The Sāḷiya Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:1.1", "PA_ja_367:1.2"], "en": "“He who, thinking ‘this is a young sāḷi tree,’ seized a black snake;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:1.3"], "en": "Bitten by that serpent,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:1.4", "PA_ja_367:2.1"], "en": "the evil instructor was slain; he who would not kill has been killed by the great one.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:2.2"], "en": "The man who desires to kill—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:2.3"], "en": "thus he lies slain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:2.4"], "en": "just as this person has been killed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:3.1", "PA_ja_367:3.2"], "en": "The man who desires to kill one who intends to kill him—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:3.3"], "en": "thus slain, he lies prostrate.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:3.4"], "en": "Just as this man has been struck;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:4.1", "PA_ja_367:4.2"], "en": "just as a man might throw a handful of dust against the wind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:4.3"], "en": "Just as that dust destroys itself,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:4.4", "PA_ja_367:5.1"], "en": "so too is this person destroyed who bears malice toward a man who is without malice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:5.2"], "en": "\"To a pure person who is free from blemish,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:5.3"], "en": "that very evil returns,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:5.4"], "en": "like fine dust thrown against the wind.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_367:6.1"], "en": "The Sāliya Jātaka, the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
