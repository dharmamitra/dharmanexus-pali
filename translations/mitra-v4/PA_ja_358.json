[
{"segs": ["PA_ja_358:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:0.2"], "en": "The Fifth Collection,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:0.3"], "en": "Chapter on the Jeweled Earrings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:0.4"], "en": "8. The Cūḷadhammapāla Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:1.1", "PA_ja_358:1.2"], "en": "“I alone am the one defiled and ruined by the king of great majesty.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:1.3"], "en": "\"Let him release this protector of the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:1.4"], "en": "O King, cut off my own hand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:2.1"], "en": "I alone am the one defiled and ruined.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:2.2"], "en": "O King Mahāpatāpa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:2.3"], "en": "let this Dhammapāla go free;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:2.4"], "en": "O Lord, cut off my feet instead.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:3.1", "PA_ja_358:3.2"], "en": "I alone am the one defiled and destroyed by the king of great majesty;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:3.3"], "en": "let him release this protector of Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:3.4"], "en": "\"O King, cut off my head.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:4.1", "PA_ja_358:4.2"], "en": "Surely this king has no friends or ministers who are well-disposed toward him.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:4.3"], "en": "Those who do not say to the king,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:4.4"], "en": "\"Do not kill your own son\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:5.1"], "en": "surely they have no regard for this king.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:5.2"], "en": "There exist kinsmen and friends who are well-wishers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:5.3"], "en": "who do not say to the king:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:5.4"], "en": "\"Do not kill your own son.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:6.1", "PA_ja_358:6.2"], "en": "Though his arms, anointed with the essence of sandalwood, were being cut off,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:6.3"], "en": "Dharmapāla remained the heir to the earth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:6.4"], "en": "“O King, my lives are being cut off.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_358:7.1"], "en": "Thus ends the eighth Jātaka, the Cūḷadhammapāla Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
