[
{"segs": ["PA_thag_20.1:0.1"], "en": "Theragāthā 20.1,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:0.2"], "en": "Saṭṭhinipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:0.3"], "en": "First Chapter", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:0.4"], "en": "The Verses of the Elder Mahāmoggallāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:1.1"], "en": "“Forest-dwellers, alms-gatherers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:1.2"], "en": "delighting in what comes into the bowl from gleanings;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:1.3"], "en": "Let us break the army of Death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:1.4"], "en": "being well-composed within;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:2.1"], "en": "we who dwell in the forest and subsist on alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:2.2"], "en": "Delighting in what has come to us by gleaning,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:2.3"], "en": "let us shake off the army of Death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:2.4"], "en": "as an elephant shakes a reed-hut.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:3.1"], "en": "Dwelling at the foot of trees, constant in practice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:3.2"], "en": "delighting in what comes into the alms-bowl—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:3.3"], "en": "may we shatter the army of Death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:3.4"], "en": "Well-composed within themselves,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:4.1"], "en": "dwelling at the foot of trees, constant in their practice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:4.2"], "en": "they delight in the alms-bowl brought by chance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:4.3"], "en": "We shall shake off the army of Death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:4.4"], "en": "as an elephant shakes off a reed-hut.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:5.1"], "en": "[Within] this skeleton hut...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:5.2"], "en": "Bound together with flesh and sinews—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:5.3"], "en": "fie upon you, who were formerly foul-smelling,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:5.4"], "en": "repulsive, and the object of my possessiveness!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:6.1", "PA_thag_20.1:6.2"], "en": "O you who eat excrement, covered in skin, you who are like a serpent, a tumor, or a piśāca;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:6.3"], "en": "there are nine streams in your body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:6.4"], "en": "Those which flow constantly—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:7.1"], "en": "your body, with its nine openings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:7.2"], "en": "is a foul-smelling, obstructed vessel.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:7.3"], "en": "A bhikkhu avoids that person,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:7.4"], "en": "just as one who desires cleanliness avoids filth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:8.1"], "en": "If people were to know this...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:8.2", "PA_thag_20.1:8.3"], "en": "Just as I know it, one should avoid it from afar,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:8.4"], "en": "like a dung-hill in the rain during the monsoon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:9.1"], "en": "“So it is, Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:9.2"], "en": "just as you, O ascetic, have spoken;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:9.3"], "en": "herein some indeed falter.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:9.4"], "en": "Like an old ox in the mud.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:10.1", "PA_thag_20.1:10.2"], "en": "\"One who might think to dye the sky with turmeric...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:10.3"], "en": "Or even with another color,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:10.4"], "en": "that [color] only gives rise to distress;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:11.1"], "en": "the mind is then like space.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:11.2"], "en": "With your mind well-composed within,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:11.3"], "en": "do not attack one whose heart is evil,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:11.4"], "en": "like a bird attacking a mass of fire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:12.1"], "en": "“Behold this puppet fashioned by the mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:12.2"], "en": "a heap of wounds piled together;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:12.3"], "en": "it is afflicted, full of many thoughts.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:12.4"], "en": "For that which has no lasting stability.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:13.1"], "en": "Behold this form fashioned by the mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:13.2"], "en": "with its jewel and its earring.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:13.3"], "en": "Bones covered with skin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:13.4"], "en": "it shines together with clothes;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:14.1"], "en": "the feet are dyed with red lac.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:14.2", "PA_thag_20.1:14.3"], "en": "A face smeared with powder is enough to delude a fool,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:14.4"], "en": "but not one who seeks the further shore.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:15.1"], "en": "Hair arranged in eight rows,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:15.2"], "en": "eyes smeared with collyrium—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:15.3"], "en": "these are enough to delude a fool.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:15.4"], "en": "And not seeking the further shore.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:16.1"], "en": "Like a fresh collyrium box,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:16.2"], "en": "this putrid body is adorned.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:16.3"], "en": "Enough for the delusion of the fool,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:16.4"], "en": "but not for one who seeks the further shore.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:17.1"], "en": "The hunter has set his snare;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:17.2"], "en": "The deer does not go toward the net;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:17.3"], "en": "having become aware of the bait,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:17.4"], "en": "we shall depart while the deer-trappers are still crying out.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:18.1"], "en": "The snare for the deer is cut;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:18.2"], "en": "the deer has not entered the trap.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:18.3"], "en": "Having eaten the bait, we shall depart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:18.4"], "en": "“While the deer-hunters were grieving.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:19.1"], "en": "“That was terrifying;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:19.2"], "en": "that was hair-raising.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:19.3", "PA_thag_20.1:19.4"], "en": "When Sāriputta, endowed with manifold qualities, has passed away—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:20.1"], "en": "impermanent indeed are all conditioned things.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:20.2"], "en": "Subject to arising and passing away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:20.3"], "en": "having arisen, they cease.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:20.4"], "en": "Their subsiding is blissful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:21.1", "PA_thag_20.1:21.2", "PA_thag_20.1:21.3"], "en": "Those who perceive the five aggregates penetrate them subtly, as one would pierce the tip of a hair with an arrow.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:21.4"], "en": "Neither as another nor as self.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:22.1", "PA_thag_20.1:22.2"], "en": "And those who see conditioned phenomena neither as another nor as self;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:22.3"], "en": "They pierced him through with precision,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:22.4"], "en": "like a hair-tip with an arrow;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:23.1"], "en": "he was struck down as if by a sword.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:23.2"], "en": "As if his head were on fire,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:23.3", "PA_thag_20.1:23.4"], "en": "let the mindful bhikkhu wander forth for the sake of abandoning sensual lust.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:24.1"], "en": "Struck as if by a sword,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:24.2"], "en": "burning as it were upon his head,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:24.3"], "en": "for the sake of abandoning craving for existence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:24.4"], "en": "A mindful bhikkhu should wander forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:25.1", "PA_thag_20.1:25.2"], "en": "urged on by one whose self is cultivated and who bears his final body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:25.3", "PA_thag_20.1:25.4"], "en": "I shook the Palace of Migāra’s Mother with my big toe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:26.1"], "en": "this was not done by undertaking anything lax.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:26.2"], "en": "This liberation from all fetters,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:26.3", "PA_thag_20.1:26.4"], "en": "Nibbāna, is not to be attained by one of little strength.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:27.1"], "en": "And this young bhikkhu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:27.2"], "en": "this supreme person,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:27.3"], "en": "bears his final body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:27.4"], "en": "Having conquered Māra and his host,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:28.1", "PA_thag_20.1:28.2"], "en": "lightning flashes illuminate the gap between Mount Vebhāra and Mount Paṇḍava.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:28.3"], "en": "Having entered the cave of the mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:28.4"], "en": "the son of the Peerless One, the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:29.1"], "en": "meditates— calm and restrained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:29.2"], "en": "A sage with few desires and simple requisites,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:29.3"], "en": "an heir of the Supreme Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:29.4"], "en": "he was saluted by Brahmā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:30.1", "PA_thag_20.1:30.2"], "en": "“The sage who is peaceful and restrained, dwelling in a remote lodging—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:30.3"], "en": "the heir of the Best of Buddhas— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:30.4"], "en": "Worship the brahmin Kassapa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:31.1", "PA_thag_20.1:31.2"], "en": "who would go through a hundred births among all the brahmin castes.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:31.3"], "en": "A learned man, perfected in the Vedas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:31.4"], "en": "among human beings again and again,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:32.1"], "en": "even if he should be a mere reciter—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:32.2", "PA_thag_20.1:32.3", "PA_thag_20.1:32.4"], "en": "One who has mastered the three Vedas is not worth even a sixteenth part of this person when it comes to paying homage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:33.1", "PA_thag_20.1:33.2", "PA_thag_20.1:33.3"], "en": "He who, before the meal, had attained the eight liberations in forward and reverse order—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:33.4"], "en": "Then he goes for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:34.1", "PA_thag_20.1:34.2"], "en": "O Brahmin, such a bhikkhu should be honored by you; do not dig up your own root.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:34.3", "PA_thag_20.1:34.4"], "en": "Inspire your mind with confidence toward the Arahant, the Stable One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:34.5"], "en": "quickly pay homage with palms joined.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:34.6"], "en": "“May your head not become entangled!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:35.1", "PA_thag_20.1:35.2"], "en": "[He replied: “This man, led by the cycle of existence, does not see the True Dhamma.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:35.3"], "en": "He runs along the downward path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:35.4"], "en": "the crooked way, the wrong road,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:36.1"], "en": "like a worm smeared with filth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:36.2", "PA_thag_20.1:36.3"], "en": "Infatuated with mental formations and submerged in gain and honor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:36.4"], "en": "the empty Poṭṭhila departs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:37.1", "PA_thag_20.1:37.2"], "en": "\"And behold this Sāriputta approaching, so beautiful to look upon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:37.3"], "en": "liberated in both ways.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:37.4"], "en": "Well-composed within,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:38.1"], "en": "free from the dart, with fetters destroyed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:38.2"], "en": "possessing the threefold knowledge, and having overcome death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:38.3", "PA_thag_20.1:38.4"], "en": "The supreme field of merit for humans, worthy of offerings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:39.1"], "en": "“These many devas...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:39.2"], "en": "Possessing psychic power and renown,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:39.3"], "en": "ten thousand gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:39.4"], "en": "all of them Brahmapurohitas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:39.5"], "en": "Paying homage to Moggallāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:39.6"], "en": "they stand with palms joined in reverence:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:40.1"], "en": "\"Homage to you, O noble steed among men!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:40.2"], "en": "Homage to you, O Supreme among Men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:40.3"], "en": "since your taints are exhausted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:40.4"], "en": "you are worthy of offerings, O Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:41.1"], "en": "Honored by the god among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:41.2"], "en": "he has arisen as the conqueror of death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:41.3"], "en": "like a white lotus [unsoiled] by water.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:41.4"], "en": "He is not defiled by mental formations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:42.1", "PA_thag_20.1:42.2"], "en": "He who, in a single moment, has directly known the world in its thousandfold aspects, together with the Brahma-world, is a master.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:42.3", "PA_thag_20.1:42.4"], "en": "That bhikkhu sees the powers of psychic potency, the passing away and rebirth [of beings], and the [right] time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:43.1"], "en": "he is indeed like Sāriputta in wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:43.2"], "en": "Through virtue and through peace;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:43.3", "PA_thag_20.1:43.4"], "en": "even a monk who has gone to the further shore would be at most only this much.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:44.1", "PA_thag_20.1:44.2"], "en": "In an instant, I can manifest a hundred thousand times ten million bodies;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:44.3"], "en": "I am skilled in such transformations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:44.4"], "en": "I have become a master of psychic power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:45.1"], "en": "Having reached mastery and perfection in concentration and true knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:45.2"], "en": "I am of the Moggallāna clan within the teaching of the Unattached One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:45.3"], "en": "The steadfast one, with faculties composed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:45.4"], "en": "has utterly severed his bonds like an elephant tearing away a rotting creeper.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:46.1"], "en": "The Teacher has been served by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:46.2"], "en": "The teaching of the Buddha has been fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:46.3"], "en": "the heavy burden has been laid down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:46.4"], "en": "and the conduit to existence has been uprooted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:47.1", "PA_thag_20.1:47.2"], "en": "That goal for the sake of which I went forth from the home life into homelessness—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:47.3"], "en": "that purpose of mine has been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:47.4"], "en": "The destruction of all fetters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:48.1", "PA_thag_20.1:48.2"], "en": "Of what kind was that hell where the immoral man was cooked?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:48.3", "PA_thag_20.1:48.4"], "en": "Having appointed the disciple Vidhura and the brahmin Kakusandha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:49.1"], "en": "there were hundred iron spikes for the virtuous.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:49.2"], "en": "All experience their own individual sensations;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:49.3", "PA_thag_20.1:49.4"], "en": "such was the hell where the immoral one was cooked.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:49.5", "PA_thag_20.1:49.6"], "en": "Having relied upon the disciple Vidhura and the brahmin Kakusandha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:50.1"], "en": "whoever thoroughly understands this—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:50.2"], "en": "A monk is a disciple of the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:50.3"], "en": "by assailing such a monk,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:50.4"], "en": "O Dark One, you shall undergo suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:51.1", "PA_thag_20.1:51.2"], "en": "In the middle of the lake stand celestial mansions that endure for an eon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:51.3"], "en": "radiant and the color of beryl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:51.4"], "en": "Radiant and luminous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:51.5", "PA_thag_20.1:51.6"], "en": "apsarases of many diverse forms dance there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:52.1"], "en": "He who fully understands this...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:52.2", "PA_thag_20.1:52.4"], "en": "[pe] ...O Dark One, you shall undergo suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:53.1", "PA_thag_20.1:53.2"], "en": "He who was exhorted by the Buddha while the Saṅgha of bhikkhus looked on,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:53.3"], "en": "[ascended] the Palace of Migāra’s Mother.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:53.4"], "en": "He shook it with his big toe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:54.1", "PA_thag_20.1:54.2"], "en": "Whoever understands this... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:54.4"], "en": "O Kaṇha, you shall undergo suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:55.1", "PA_thag_20.1:55.2"], "en": "you who indeed made the Vejayanta Palace tremble with your big toe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:55.3"], "en": "Supported by the power of psychic success,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:55.4"], "en": "he inspired awe in the deities;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:56.1"], "en": "he who fully understands this—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:56.2", "PA_thag_20.1:56.4"], "en": "... thus, O Kaṇha, you shall undergo suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:57.1"], "en": "[He who was] in the Vejayanta Palace...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:57.2"], "en": "He questions Sakka:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:57.3", "PA_thag_20.1:57.4"], "en": "\"Friend, do you know of the liberation through the destruction of craving?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:57.5", "PA_thag_20.1:57.6"], "en": "To him, being questioned, Sakka answered the question exactly as it is:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:58.1"], "en": "\"He who thoroughly understands this...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:58.2", "PA_thag_20.1:58.4"], "en": "... thus, O Kaṇha, you undergo suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:59.1"], "en": "He who questions Brahmā—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:59.2"], "en": "Standing in the Sudhamma assembly hall,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:59.3", "PA_thag_20.1:59.4"], "en": "even today, friend, that same view remains which you previously held.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:59.5"], "en": "\"You pass by, transcending [the world],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:59.6"], "en": "radiant in the Brahma-world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:60.1"], "en": "Brahmā gave him this explanation:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:60.2"], "en": "When asked a question, I have answered it as it truly is:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:60.3", "PA_thag_20.1:60.4"], "en": "\"My dear sir, that view which I previously held is no longer my view.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:61.1"], "en": "I see him shining brightly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:61.2"], "en": "having transcended into the Brahma-world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:61.3"], "en": "how could I speak ill of him today?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:61.4"], "en": "“I am permanent; I am eternal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:62.1", "PA_thag_20.1:62.2"], "en": "“Whoever fully understands this... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:62.4"], "en": "O Kaṇha, you shall undergo suffering—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:63.1", "PA_thag_20.1:63.2"], "en": "you who have failed to touch the peak of the Great Mountain with liberation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:63.3", "PA_thag_20.1:63.4"], "en": "The forest of the Pubbavideha people and those men who dwell upon the earth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:64.1"], "en": "he who thoroughly understands this,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:64.2"], "en": "A bhikkhu is a disciple of the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:64.3"], "en": "by assailing such a bhikkhu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:64.4"], "en": "O Kaṇha, you undergo suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:65.1"], "en": "The fire does not think,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:65.2"], "en": "\"I am burning the fool\";", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:65.3"], "en": "it is the fool who [approaches] the blazing fire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:65.4"], "en": "Having assailed him, it burns.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:66.1"], "en": "In the very same way, Māra,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:66.2"], "en": "having assailed the Tathāgata;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:66.3"], "en": "You will burn yourself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:66.4"], "en": "O fool, like one who touches fire;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:67.1"], "en": "Māra has produced demerit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:67.2"], "en": "Having assailed the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:67.3"], "en": "what do you think, O Evil One?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:67.4"], "en": "Does my evil not ripen upon me?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:68.1"], "en": "Evil is heaped up by you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:68.2"], "en": "O End-maker, for a long time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:68.3"], "en": "Mara, be weary of the Buddha!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:68.4"], "en": "“Do not harbor such thoughts toward the bhikkhus.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:69.1", "PA_thag_20.1:69.2"], "en": "Thus did the bhikkhu rebuke Māra in the Bhesakaḷā Grove.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:69.3", "PA_thag_20.1:69.4"], "en": "\"Then that dejected yakkha vanished right there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:69.5"], "en": "Thus indeed did the Elder Venerable Mahāmoggallāna speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:69.6"], "en": "The Saṭṭhinipāta is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:70.0", "PA_thag_20.1:70.1"], "en": "Herein is the summary verse for the Saṭṭhinipāta: In the Saṭṭhinipāta, there are sixty verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:70.2"], "en": "Moggallāna was of great psychic power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_20.1:70.3", "PA_thag_20.1:70.4"], "en": "there are sixty-eight verses of the Elder Moggallāna alone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
