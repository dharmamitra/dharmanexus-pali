[
{"segs": ["PA_ja_520:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:0.2", "PA_ja_520:0.3"], "en": "The Section of Thirty Birth Stories, Chapter on Kiṁchanda.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:0.4"], "en": "10. The Gandhatinduka Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:1.1"], "en": "“Diligence is the path to the deathless;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:1.2"], "en": "negligence is the path of death.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:1.3"], "en": "Those who are heedful do not die;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:1.4"], "en": "those who are heedless are as if dead.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:2.1"], "en": "From intoxication, negligence arises.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:2.2"], "en": "From negligence arises decay;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:2.3"], "en": "from decay arise corruptions;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:2.4"], "en": "do not be negligent, O bull among the Bharatas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:3.1"], "en": "For many kṣatriyas have perished,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:3.2"], "en": "being heedless of their own welfare and the kingdom;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:3.3"], "en": "and even those who go from village to village [have perished].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:3.4"], "en": "The homeless and the householders—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:4.1", "PA_ja_520:4.2"], "en": "of the heedless khattiya who increases the kingdom within the realm;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:4.3"], "en": "All enjoyments perish;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:4.4"], "en": "that, O King, is called a calamity for a monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:5.1"], "en": "This is not the Dhamma, Great King.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:5.2"], "en": "You are being excessively negligent;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:5.3", "PA_ja_520:5.4"], "en": "thieves will destroy this prosperous and flourishing country.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:6.1"], "en": "They will have no sons,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:6.2"], "en": "no gold, and no grain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:6.3"], "en": "while the kingdom is being plundered.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:6.4"], "en": "You are worn out by all enjoyments.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:7.1", "PA_ja_520:7.2"], "en": "Even a king or a kshatriya is worn out by all enjoyments.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:7.3", "PA_ja_520:7.4"], "en": "Relatives, friends, and well-wishers do not regard one as arrogant;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:8.1"], "en": "nor do the elephant-riders in the army.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:8.2"], "en": "Charioteers and infantrymen—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:8.3"], "en": "while subsisting in this way,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:8.4"], "en": "they do not consider themselves to be arrogant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:9.1", "PA_ja_520:9.2", "PA_ja_520:9.3"], "en": "Fortune deserts the foolish one of dull wit who has not prepared his work and is ill-advised by his counselor.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:9.4"], "en": "Like a snake casting off its worn-out skin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:10.1"], "en": "one who has well-performed their duties,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:10.2"], "en": "who rises at the proper time, and is untiring—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:10.3"], "en": "All enjoyments increase,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:10.4", "PA_ja_520:11.1"], "en": "O Great King, like cows with their calves when they hear [the sound of] lowing. Upassutiṁ.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:11.2"], "en": "Wander through the kingdom and the countryside;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:11.3"], "en": "having seen and heard there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:11.4"], "en": "you shall act accordingly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:12.1", "PA_ja_520:12.2"], "en": "“May Pañcāla feel thus in battle when struck by arrows,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:12.3"], "en": "as I feel today.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:12.4"], "en": "\"Pierced by a thorn.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:13.1"], "en": "\"You are old and your sight is weak;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:13.2"], "en": "you do not see forms clearly.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:13.3", "PA_ja_520:13.4"], "en": "\"What is there for Brahmadatta that he would seek like a thorn?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:14.1"], "en": "\"There is much there for Brahmadatta.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:14.2"], "en": "Thus I am on the path, O Brahmin;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:14.3"], "en": "the people of the countryside are unprotected,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:14.4"], "en": "struck down by the power of unrighteousness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:15.1"], "en": "For at night the thieves devour,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:15.2"], "en": "by day the Tuṇḍiya-birds devour,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:15.3"], "en": "within the kingdom of a king who acts with deceit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:15.4"], "en": "The people were largely unrighteous.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:16.1"], "en": "When such a danger had arisen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:16.2"], "en": "O dear one, the young men were struck with fear.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:16.3", "PA_ja_520:16.4"], "en": "“They make necklaces by gathering thorns from the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:17.1"], "en": "“When indeed will this king— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:17.2"], "en": "Brahmadatta will die,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:17.3", "PA_ja_520:17.4"], "en": "he in whose kingdom young maidens grow old without husbands.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:18.1"], "en": "“Indeed, you have spoken ill, O wretched woman,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:18.2"], "en": "skilled only in words of no profit!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:18.3"], "en": "Where is the king of maidens?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:18.4", "PA_ja_520:19.1"], "en": "“Brahmā, I have not spoken falsely;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:19.2"], "en": "I am skilled in the meaning of words.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:19.3"], "en": "The country folk are unprotected,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:19.4"], "en": "struck down by the power of unrighteousness;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:20.1"], "en": "for at night, thieves devour them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:20.2"], "en": "The Tuṇḍiya birds eat by day;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:20.3"], "en": "in the kingdom of the fraudulent king,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:20.4"], "en": "the people are largely unrighteous.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:20.5"], "en": "“When life is hard to lead and the wife is difficult to support,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:20.6", "PA_ja_520:21.1"], "en": "where is there food for young daughters? “Let Pañcāla lie thus.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:21.2"], "en": "Slain by a spear in battle,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:21.3"], "en": "he lies here like this poor man,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:21.4"], "en": "struck down by the ploughshare while harvesting rice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:22.1", "PA_ja_520:22.2"], "en": "“O wretch, it is by unrighteousness that you are angry with Brahmadatta;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:22.3"], "en": "you who swear an oath against the king.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:22.4"], "en": "\"Without having offended myself,\" [he said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:23.1", "PA_ja_520:23.2"], "en": "\"O Brahmin, I am angry with Brahmadatta for his violation of the Dhamma.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:23.3", "PA_ja_520:23.4"], "en": "The people of the countryside were unprotected and destroyed by the power of unrighteousness;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:24.1"], "en": "for at night, thieves devoured them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:24.2"], "en": "The Tuṇḍiya birds devour during the day;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:24.3"], "en": "in the kingdom of the fraudulent king,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:24.4"], "en": "the people are largely unrighteous.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:25.1"], "en": "Surely she has cooked again,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:25.2"], "en": "bringing food at the wrong time;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:25.3"], "en": "looking for the one who brings the meal, he—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:25.4"], "en": "\"The rice has been destroyed by the plow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:26.1"], "en": "\"In this same way, let Pañcāla be slain;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:26.2"], "en": "he was struck down by the sword in battle.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:26.3"], "en": "\"Just as I have been struck today,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:26.4"], "en": "my milk has begun to flow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:27.1"], "en": "\"The milk of an animal that one discards...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:27.2"], "en": "He harms the cattle-herder;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:27.3", "PA_ja_520:27.4"], "en": "what is it to Brahmadatta that you reproach us for this?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:28.1", "PA_ja_520:28.2"], "en": "“Brahmā, Pañcāla is to be censured for King Brahmadatta;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:28.3"], "en": "the people of the realm are unprotected.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:28.4"], "en": "They were destroyed by the power of unrighteousness:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:29.1"], "en": "for at night the thieves devour them,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:29.2"], "en": "and by day the crows devour them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:29.3"], "en": "In the kingdom of a treacherous king,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:29.4"], "en": "many people are unrighteous;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:30.1"], "en": "they are fierce, predatory, like a cow roaming at will.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:30.2"], "en": "\"That which we did not milk before,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:30.3"], "en": "that we now milk today,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:30.4"], "en": "being distressed by our desire for milk.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:31.1"], "en": "“Let Pañcāla cry out thus,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:31.2"], "en": "let Viputta wail aloud;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:31.3"], "en": "just as this wretched cow [cries].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:31.4"], "en": "\"Having gone astray, it runs about.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:32.1", "PA_ja_520:32.2"], "en": "\"Whatever the beast might stumble over or cry out at while with its herdsman,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:32.3"], "en": "\"What offense has been committed here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:32.4"], "en": "O Great Brahmā, against King Brahmadatta?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:33.1"], "en": "\"The offense, O Great Brahmā,\" [he replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:33.2"], "en": "Of King Brahmadatta;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:33.3", "PA_ja_520:33.4"], "en": "the unprotected countryfolk were struck down by unrighteous taxes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:34.1"], "en": "For at night the thieves devour,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:34.2"], "en": "by day the Tuṇḍiya-birds devour,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:34.3"], "en": "within the kingdom of a king who acts with deceit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:34.4"], "en": "The people are largely unrighteous;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:34.5", "PA_ja_520:34.6"], "en": "how is it that this milk-drinking folk is being slaughtered by us who do not wield swords or weapons?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:35.1"], "en": "“Let Pañcāla be devoured thus,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:35.2"], "en": "slain in battle along with his son;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:35.3"], "en": "just as I am being devoured today.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:35.4"], "en": "\"O frog, born in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:36.1", "PA_ja_520:36.2"], "en": "kings in the world of men do not provide protection for all living beings.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:36.3"], "en": "\"To that extent the king is a practitioner of unrighteousness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:36.4"], "en": "since they would devour such a living being like vultures.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:37.1"], "en": "Truly, this practitioner of the holy life is one who has taken on an unrighteous form.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:37.2"], "en": "You speak pleasing words to the kshatriya;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:37.3"], "en": "while the common folk are being ruined,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:37.4"], "en": "you honor the king with supreme heedlessness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:38.1"], "en": "If, O Brahmā, this realm were well-governed—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:38.2"], "en": "a kingdom prosperous, joyful, and serene— then the crows,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:38.3"], "en": "having consumed the offering and the first alms-food, would not be seen.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:38.4"], "en": "“Crows would not eat one such as me while I am still alive.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:39.1"], "en": "The Gandhatinduka Jātaka, the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:40.1"], "en": "The Tiṃsanipāta is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:41.1", "PA_ja_520:42.1"], "en": "Its summary verse (uddāna) is: Kiñchanda, Kumbha, Jayaddisa, Chaddanta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:42.2"], "en": "then Paṇḍitasambhava, and Sirikapi.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:42.3"], "en": "Dakarakkhasa, Paṇḍaranāgavara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:42.4"], "en": "and then Sambula, Tinduka, and Devasuta.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_520:43.1"], "en": "Thus ends the first part of the Jātakapāḷi.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
