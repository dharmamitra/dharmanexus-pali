[
{"segs": ["PA_cp_29:0.1"], "en": "The Basket of Conduct (Cariyāpiṭaka),", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:0.2"], "en": "Chapter on Yudhañjaya,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:0.3"], "en": "Truth-Pāramitā 3", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:0.4", "PA_cp_29:1.1"], "en": "The Conduct as a Wild Goose Cub: “Furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:1.2"], "en": "when I was a wild goose cub in Magadha;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:1.3"], "en": "A young chick with undeveloped wings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:1.4"], "en": "a mere lump of flesh in its nest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:2.1"], "en": "having been brought by the beak—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:2.2"], "en": "My mother nourishes me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:2.3"], "en": "I live by her touch,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:2.4"], "en": "for I have no bodily strength.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:3.1"], "en": "In the course of a year, during the summer season,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:3.2"], "en": "a forest fire blazes up;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:3.3"], "en": "it approaches us.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:3.4"], "en": "The purifier with blackened tracks,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:4.1"], "en": "the great flame roaring thus,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:4.2"], "en": "making a sound like \"dhamadhamā.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:4.3"], "en": "Consuming them gradually,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:4.4", "PA_cp_29:5.1"], "en": "the fire approached me. Having transcended the fear of the fire's force, I remained.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:5.2"], "en": "My parents were thirsty;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:5.3"], "en": "having abandoned me in the nest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:5.4"], "en": "they sought their own deliverance.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:6.1"], "en": "I abandon my feet and my wings;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:6.2"], "en": "I have no bodily strength;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:6.3"], "en": "thus, I am without recourse there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:6.4"], "en": "I thought thus at that time:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:7.1"], "en": "\"To whom should I run,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:7.2"], "en": "being afraid, terrified, and trembling?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:7.3"], "en": "They have abandoned me and departed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:7.4"], "en": "what am I to do today?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:8.1"], "en": "There is the quality of virtue in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:8.2"], "en": "Truth, purity, and compassion:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:8.3", "PA_cp_29:8.4"], "en": "by that truth, I shall perform the supreme act of truth (*saccakiriya*).", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:9.1"], "en": "Having invoked the power of the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:9.2"], "en": "having recollected the Conquerors of old,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:9.3"], "en": "and having relied upon the power of truth—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:9.4"], "en": "I performed an act of truth:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:10.1"], "en": "\"There are wings that do not fly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:10.2"], "en": "and there are feet that do not run.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:10.3"], "en": "My mother and father have departed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:10.4"], "en": "O Jātaveda, withdraw!", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:11.1"], "en": "Since my word has been made true, [do not burn me].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:11.2"], "en": "Greatly blazing, like a cresting flame,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:11.3"], "en": "he avoided [the path] for sixteen karīsas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:11.4"], "en": "just as a flame avoids water.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:11.5"], "en": "“There is nothing equal to truth for me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:11.6"], "en": "this is my perfection of truth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_29:12.1"], "en": "Thus ends the ninth deed, the Story of Vaṭṭapotaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
