{"segs": ["PA_thag_1.115:0.2", "PA_thag_1.115:0.3"], "en": "Ekakanipāta, Dvādasamavagga (The Twelfth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.115:0.4"], "en": "Mahānāma Thera’s Verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.115:1.1"], "en": "“Here you are being carried away by a mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.115:1.2"], "en": "Which is covered with many thickets, thorns, and sallakī trees.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.115:1.3"], "en": "“By the hunter Girin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.115:1.4"], "en": "by the retinue of Yasassin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.115:1.5"], "en": "… [Thus spoke] the Elder Mahānāma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
