[
{"segs": ["PA_tha-ap_119:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:0.2"], "en": "Mahāparivāravagga 7.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:0.3"], "en": "The Apadāna of the Elder Buddhasaññaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:1.1"], "en": "“When Vipassi, the foremost in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:1.2"], "en": "relinquished the life-formations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:1.3"], "en": "the earth trembled all over.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:1.4"], "en": "The earth, girdled by the waters,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:2.1", "PA_tha-ap_119:2.2"], "en": "is spread out and extended for me as a most exquisite head-ornament.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:2.3", "PA_tha-ap_119:2.4"], "en": "Even the earth itself trembled at the end of the Buddha’s lifespan;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:3.1"], "en": "terror arose within me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:3.2"], "en": "When the palace trembled violently,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:3.3"], "en": "for what purpose was this arising?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:3.4"], "en": "Why did such vast light appear?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:4.1"], "en": "Vessavaṇa, having come here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:4.2"], "en": "brought peace to the great multitude;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:4.3"], "en": "there is no fear for living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:4.4"], "en": "Be one-pointed and restrained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:5.1"], "en": "Oh, the Buddhas! Oh, the Dhammas!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:5.2"], "en": "Oh, the excellence of our Teacher!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:5.3"], "en": "When he was being born,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:5.4"], "en": "the earth trembled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:6.1"], "en": "having praised the power of the Buddha, [I speak].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:6.2"], "en": "May I rejoice in heaven for an eon;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:6.3"], "en": "in the remaining eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:6.4"], "en": "may I practice what is wholesome.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:7.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:7.2"], "en": "when I attained that perception,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:7.3"], "en": "I do not recall ever being born in an unhappy state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:7.4"], "en": "This is the fruit of the perception of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:8.1"], "en": "Fourteen eons from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:8.2"], "en": "I shall be a majestic king.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:8.3"], "en": "One named Samita by name,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:8.4"], "en": "a wheel-turning monarch of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:9.1"], "en": "the four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:9.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:9.3"], "en": "the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:10.1"], "en": "Thus indeed did the venerable elder Buddhasaññaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_119:11.1"], "en": "The legend of the Elder Buddhasaññaka is the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
