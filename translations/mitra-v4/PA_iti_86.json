[
{"segs": ["PA_iti_86:0.1"], "en": "Itivuttaka 86:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:0.2", "PA_iti_86:0.3"], "en": "Tikanipāta, Catutthavagga (The Fourth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:0.4"], "en": "The Discourse on Practicing in Accordance with the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:1.1"], "en": "This was said by the Blessed One; thus have I heard:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:2.1"], "en": "\"For a bhikkhu who is practicing in accordance with the Dhamma, this is the way of practice that accords with the Dhamma for his explanation: [text follows]\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:2.2_0"], "en": "When one says, \"He is practicing in accordance with the Dhamma,\" he speaks only of the Dhamma, not of what is non-Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:2.2_1"], "en": "or when reflecting, he reflects only on thoughts of the Dhamma, not on thoughts of what is non-Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:2.2_2"], "en": "or, having relinquished both, he dwells in equanimity, mindful and clearly comprehending.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:2.3"], "en": "The Blessed One spoke this matter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:2.4"], "en": "Regarding this, it is said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:3.1"], "en": "“Delighting in the Dhamma, rejoicing in the Dhamma...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:3.2", "PA_iti_86:3.3"], "en": "Reflecting upon the Dhamma and recollecting the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:3.4"], "en": "a bhikkhu does not fall away from the true Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:4.1"], "en": "Whether walking or standing,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:4.2"], "en": "sitting or lying down,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:4.3"], "en": "one should constantly keep the mind directed inwardly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:4.4"], "en": "“He attains peace alone.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:5.1"], "en": "This matter was also spoken by the Blessed One; thus have I heard.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_86:5.2"], "en": "The seventh [sutta].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
