[
{"segs": ["PA_vv_38:0.1"], "en": "Vimānavatthu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:0.2", "PA_vv_38:0.3"], "en": "The Chapter on the Pāricchattaka Tree in the Itthivimāna (The Female Vimānas)", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:0.4", "PA_vv_38:1.1"], "en": "10. The Story of the Pāricchattaka Mansion “In the Pāricchattaka koviḷāra tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:1.2"], "en": "delightful and enchanting;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:1.3"], "en": "Weaving celestial garlands,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:1.4", "PA_vv_38:2.1"], "en": "you sing with great joy; as you dance, for you—", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:2.2"], "en": "From every single limb,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:2.3"], "en": "divine sounds issue forth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:2.4"], "en": "melodious and enchanting.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:3.1", "PA_vv_38:3.2"], "en": "As you dance, from every limb of yours,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:3.3"], "en": "divine fragrances waft forth on all sides.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:3.4"], "en": "Fragrant and delightful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:4.1", "PA_vv_38:4.2"], "en": "those ornaments which were worn upon their braided hair as they turned their bodies.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:4.3", "PA_vv_38:4.4"], "en": "Their sound is heard like that of a fivefold musical ensemble;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:5.1"], "en": "their ornaments are shaken by the wind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:5.2"], "en": "Shaken by the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:5.3", "PA_vv_38:5.4"], "en": "their sound is heard like that of a fivefold musical ensemble.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:6.1"], "en": "Even that garland upon your head,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:6.2"], "en": "pure-scented and delightful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:6.3"], "en": "its fragrance wafts in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:6.4"], "en": "Just like a *mañjūsaka* tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:7.1", "PA_vv_38:7.2"], "en": "you smell that pure fragrance and behold that superhuman form.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:7.3"], "en": "\"O deity, being questioned, tell us:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:7.4"], "en": "what is the fruit of this karma?", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:8.1"], "en": "\"It is radiant and full of light.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:8.2"], "en": "Endowed with color and fragrance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:8.3", "PA_vv_38:8.4"], "en": "I offered a garland of *asoka* flowers to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:9.1", "PA_vv_38:9.2"], "en": "Having performed that wholesome deed praised by the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:9.3"], "en": "free from sorrow and happy, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:9.4"], "en": "“With joy and well-being.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:10.1"], "en": "The tenth, the *Pāricchattaka-vimāna*.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:11.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:12.1"], "en": "The noble sugarcane couch,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:12.2"], "en": "the creeper, and Guttila;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:12.3"], "en": "Mallikā shone forth resplendent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:12.4"], "en": "The Pāricchattaka tree has large eyes;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:12.5"], "en": "therefore, the section is called by that name.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_38:13.1"], "en": "This is the third section, the Pāricchattaka-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"}
]
