[
{"segs": ["PA_ja_532:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:0.2"], "en": "The Seventy Stories,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:0.3"], "en": "Kusā Chapter", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:0.4"], "en": "2. The Soṇananda Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:1.1", "PA_ja_532:1.2"], "en": "\"Are you a deva, or a gandhabba, or perhaps Sakka Purindada?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:1.3"], "en": "“Being human yet possessing supernormal power,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:1.4"], "en": "how can we know you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:2.1"], "en": "“You are neither a deva nor a gandhabba.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:2.2"], "en": "Nor even Sakka Purindada;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:2.3"], "en": "though he possesses supernatural power while existing as a human,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:2.4"], "en": "know this thus, Bhāradvāja.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:3.1", "PA_ja_532:3.2"], "en": "“What kind of service is this of yours, so no small a task,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:3.3"], "en": "while the god is pouring down rain?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:3.4"], "en": "The venerable one made it free from rain;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:4.1"], "en": "then, amidst terrible wind and heat,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:4.2"], "en": "the venerable one made it cool and shady.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:4.3", "PA_ja_532:4.4"], "en": "Then, amidst his enemies, you provided protection for those who remembered you; then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:5.1"], "en": "the kingdoms became prosperous.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:5.2"], "en": "The venerable one made them his servants;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:5.3", "PA_ja_532:5.4"], "en": "then the venerable one made one hundred and one chieftains his followers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:6.1"], "en": "We have indeed fallen before you, sir;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:6.2"], "en": "tell us what you wish to break:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:6.3"], "en": "the elephant-vehicle, the horse, or the chariot?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:6.4"], "en": "And women adorned with ornaments—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:6.5", "PA_ja_532:6.6"], "en": "these delightful dwellings we offer to you, sir.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:7.1"], "en": "Whether in Vaṅga or Magadha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:7.2"], "en": "we give ourselves to you, sir;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:7.3"], "en": "or whether in Assaka or Avantī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:7.4"], "en": "O Sumanā, we would submit to you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:8.1", "PA_ja_532:8.2"], "en": "We would even give half of the kingdom to your lordship.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:8.3"], "en": "“If you have need of the kingdom,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:8.4"], "en": "rule it as you wish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:9.1"], "en": "“I have no need even for the kingdom;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:9.2"], "en": "Neither by a city nor by wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:9.3"], "en": "nor even by a province,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:9.4"], "en": "do I have any need.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:10.1"], "en": "In the conquered kingdom of Bhotuva,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:10.2"], "en": "there was a hermitage in the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:10.3"], "en": "my father and my mother were there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:10.4"], "en": "Both have gone to their hermitages.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:11.1"], "en": "Among their former teachers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:11.2"], "en": "I find no merit to be performed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:11.3"], "en": "“Having made you our superior,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:11.4"], "en": "we ask Soṇa for restraint.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:12.1"], "en": "“I shall do as you say.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:12.2", "PA_ja_532:12.3"], "en": "\"O Brahmin, as you say to me: 'Tell us this also—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:12.4"], "en": "how many are there who beg'?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:13.1"], "en": "“The hundreds of provincial chieftains,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:13.2"], "en": "the great householders, and the brahmins—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:13.3"], "en": "all these kshatriyas as well— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:13.4"], "en": "They are of noble birth and renowned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:13.5"], "en": "both you, O King Manoja,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:13.6"], "en": "and they shall be worthy recipients for those who beg.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:14.1", "PA_ja_532:14.2"], "en": "“Harness the elephants and horses, O charioteer; prepare the chariot;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:14.3"], "en": "take up the bridles.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:14.4"], "en": "With my banner lowered at its base,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:14.5", "PA_ja_532:14.6"], "en": "I shall go to that hermitage where Kosika attains peace.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:15.1"], "en": "Then King Pāyāsi,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:15.2"], "en": "with his fourfold army,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:15.3"], "en": "went to that delightful hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:15.4"], "en": "Where Kosiya finds peace:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:16.1"], "en": "\"Whose is this kādamba-wood basket,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:16.2"], "en": "four fingers wide, suspended in the air?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:16.3", "PA_ja_532:16.4"], "en": "“He approaches without touching my shoulder as he goes to fetch water.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:17.1"], "en": "“I am Soṇa, Great King.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:17.2"], "en": "Because an ascetic must be sociable,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:17.3"], "en": "I support my mother and father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:17.4"], "en": "untiringly by day and by night.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:18.1", "PA_ja_532:18.2"], "en": "Having brought fruits and roots from the forest, O Disampati,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:18.3"], "en": "I nourish my mother and father.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:18.4"], "en": "\"Recalling what was done in the past.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:19.1", "PA_ja_532:19.2"], "en": "\"We wish to go to the hermitage where Kosika attains peace;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:19.3"], "en": "“Tell us the way, Soṇa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:19.4"], "en": "by which we may go to our hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:20.1"], "en": "“This is the one-track path, O King,” he said.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:20.2"], "en": "Where this cloud-like [tree] stands,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:20.3"], "en": "covered with *koviḷāra* blossoms—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:20.4"], "en": "it is here that Kosika finds rest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:21.1", "PA_ja_532:21.2"], "en": "Having said this, the great seer departed in haste,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:21.3"], "en": "traveling through the air in the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:21.4"], "en": "Having instructed the kṣatriyas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:22.1", "PA_ja_532:22.2"], "en": "and having swept the hermitage and prepared a seat;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:22.3"], "en": "Having entered the leaf-hut,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:22.4"], "en": "he awakened his father:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:23.1"], "en": "\"These kings are coming.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:23.2"], "en": "Noble and renowned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:23.3"], "en": "having departed from the hermitage,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:23.4"], "en": "you, O great lady, should sit down.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:24.1"], "en": "Having heard those words of his,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:24.2"], "en": "the great seer, hurrying,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:24.3"], "en": "went out from the hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:24.4"], "en": "He entered through the sixth gate.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:25.1"], "en": "And seeing him approaching,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:25.2"], "en": "blazing as if with splendor, he [stood there].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:25.3"], "en": "To him who was surrounded by a multitude of Khattiyas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:25.4"], "en": "Kosika spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:26.1"], "en": "\"Whose are these kettle-drums and tabors?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:26.2"], "en": "With the sounds of drums, kettledrums,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:26.3"], "en": "and cymbals, they proceeded ahead,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:26.4"], "en": "bringing joy to the bull among chariot-warriors.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:27.1", "PA_ja_532:27.2", "PA_ja_532:27.3"], "en": "Whose [body], like a youth girt with a quiver, was bound with a broad golden band having the color of lightning?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:27.4"], "en": "Who comes with splendor,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:28.1"], "en": "like a flame struck from the mouth of a forge,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:28.2"], "en": "resembling glowing embers of acacia wood?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:28.3"], "en": "And your face shines with beauty;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:28.4"], "en": "who comes here with such splendor?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:29.1"], "en": "Whose parasol is held aloft?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:29.2", "PA_ja_532:29.3", "PA_ja_532:29.4"], "en": "Who comes, radiant with glory, to this delightful, moonlit place that veils the rays of the sun?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:30.1"], "en": "Having taken up the supreme hair-whisk fan,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:30.2", "PA_ja_532:30.3"], "en": "they move about as a result of their excellent merit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:30.4"], "en": "Stretching out from the back of an elephant:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:31.1"], "en": "whose are these white parasols,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:31.2"], "en": "and these well-bred horses caparisoned?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:31.3"], "en": "They scatter [offerings] all around;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:31.4"], "en": "who comes with a flood of glory?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:32.1"], "en": "Whose hundred khattiyas—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:32.2"], "en": "Followers of great renown,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:32.3"], "en": "they wander all around;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:32.4"], "en": "who comes with a splendor so radiant?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:33.1"], "en": "Elephants, horses, chariots, and infantry—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:33.2", "PA_ja_532:33.3"], "en": "a fourfold army— surrounds it on all sides.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:33.4"], "en": "Who comes with splendor and radiance?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:34.1", "PA_ja_532:34.2"], "en": "To whom does this great army follow behind?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:34.3"], "en": "Unshakeable and boundless,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:34.4"], "en": "like the waves of the ocean—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:35.1"], "en": "Manoja, the king of kings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:35.2"], "en": "Like Indra, the lord of victory,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:35.3", "PA_ja_532:35.4"], "en": "he approaches the hermitage of Nanda, the abode of those who lead the holy life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:36.1", "PA_ja_532:36.2"], "en": "This great army follows behind me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:36.3"], "en": "unshakeable and boundless.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:36.4"], "en": "Like the waves of the ocean,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:37.1", "PA_ja_532:37.2"], "en": "they were anointed with sandalwood and clad in the finest Kāsī garments.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:37.3"], "en": "All, with palms joined in reverence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:37.4"], "en": "approached the seers:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:38.1"], "en": "\"Is all well with you, sir?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:38.2"], "en": "I hope you are free from illness;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:38.3"], "en": "I hope you sustain yourselves by gleaning,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:38.4"], "en": "and that roots and fruits are abundant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:39.1"], "en": "I hope there are no gadflies or mosquitoes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:39.2"], "en": "nor even small reptiles,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:39.3"], "en": "in this forest teeming with predatory beasts?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:39.4", "PA_ja_532:40.1"], "en": "\"Is there indeed no violence? \"O King, we are well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:40.2"], "en": "and likewise, O King, we are free from illness.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:40.3"], "en": "Furthermore, we may subsist by gleaning;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:40.4"], "en": "furthermore, there are many roots and fruits;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:41.1"], "en": "furthermore, there are gadflies and mosquitoes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:41.2", "PA_ja_532:41.3"], "en": "There are indeed many reptiles and wild beasts in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:41.4"], "en": "yet no harm comes to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:42.1"], "en": "For many groups of years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:42.2"], "en": "I have lived here in this hermitage in harmony;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:42.3"], "en": "I do not recall anything arising [that would cause discord].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:42.4"], "en": "This affliction is unpleasant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:43.1"], "en": "Welcome to you, Great King;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:43.2"], "en": "you have come from afar.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:43.3"], "en": "You have attained sovereignty;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:43.4"], "en": "proclaim what exists here:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:44.1"], "en": "the *tinduka* fruits and the *piyāla* fruits.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:44.2"], "en": "Madhuka and kāsumārī;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:44.3"], "en": "eat the small fruits,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:44.4"], "en": "O King, one by one, the best of the best.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:45.1"], "en": "This water is cool,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:45.2"], "en": "brought from the heart of the mountain;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:45.3"], "en": "drink from it, O Great King.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:45.4"], "en": "“If you so desire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:46.1"], "en": "“Whatever has been given has been accepted;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:46.2"], "en": "everything has been rendered as an offering.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:46.3", "PA_ja_532:46.4"], "en": "Listen also to the words of Nanda; he shall speak.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:47.1"], "en": "From Nanda, the reciter, [the lineage continues].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:47.2"], "en": "We have come into the presence of the venerable one;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:47.3", "PA_ja_532:47.4"], "en": "may the venerable one hear the words of Nanda and his assembly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:48.1"], "en": "“The hundreds of provincial chieftains,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:48.2"], "en": "the great *sāla*-tree-like brahmins,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:48.3"], "en": "and all these kṣatriyas— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:48.4"], "en": "They are of noble birth and renowned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:48.5"], "en": "may you, King Manoja,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:48.6"], "en": "also grant your approval for my words.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:49.1"], "en": "And whatever spirits there are here in this monastery,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:49.2"], "en": "whether past or future,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:49.3"], "en": "dwelling in the forest—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:49.4"], "en": "Listen to my words.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:50.1"], "en": "Having paid homage to all beings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:50.2"], "en": "I shall speak of the sage of excellent vows.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:50.3", "PA_ja_532:50.4"], "en": "Therefore, Kosiya, I consider you worthy of this sacrificial gift;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:51.1"], "en": "[I offer it] for my father and my mother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:51.2"], "en": "Since I desire to give alms,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:51.3"], "en": "O Hero, this is a meritorious occasion;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:51.4"], "en": "do not forbid me, Kosiya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:52.1"], "en": "This has been prescribed by the virtuous;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:52.2", "PA_ja_532:52.3"], "en": "relinquish this to me, for the sake of rising and attending upon [the teacher].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:52.4", "PA_ja_532:52.5"], "en": "For a long time you have performed meritorious deeds toward your mother and father;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:52.6"], "en": "may you become the giver of the world to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:53.1", "PA_ja_532:53.2"], "en": "In the same way, there are men who understand the Dhamma and the words of the Dhamma—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:53.3"], "en": "the path to the heavenly world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:53.4"], "en": "Just as you know, O Lord,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:54.1"], "en": "that through rising to attend to one's parents,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:54.2"], "en": "one brings happiness to them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:54.3"], "en": "“Merit restrains me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:54.4"], "en": "I who am a man treading the noble path.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:55.1"], "en": "“Let your honors hear my words:”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:55.2", "PA_ja_532:55.3", "PA_ja_532:55.4"], "en": "O Great King, my brother’s chief queen was causing our ancient family lineage to decline.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:55.5", "PA_ja_532:55.6"], "en": "One who acts contrary to the Dhamma toward elders is reborn in hell;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:56.1"], "en": "whereas those who are skilled in the Dhamma—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:56.2"], "en": "And of the ancient Disampati;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:56.3", "PA_ja_532:56.4"], "en": "those endowed with such conduct do not go to an evil destination.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:57.1"], "en": "Mother, father, brother,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:57.2"], "en": "sister, and kinsmen—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:57.3"], "en": "all these are burdens for the elder.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:57.4"], "en": "Know this, Bhāradvāja:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:58.1"], "en": "having taken up a heavy burden,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:58.2"], "en": "one must exert oneself like a boatman.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:58.3"], "en": "“I do not neglect the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:58.4"], "en": "and I am the eldest, O bull among charioteers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:59.1"], "en": "Through his attainment, he realized that knowledge.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:59.2"], "en": "Just as a net from a fire,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:59.3", "PA_ja_532:59.4"], "en": "even so has Master Kosiya revealed the Dhamma to us.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:60.1"], "en": "Just as the rising sun,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:60.2"], "en": "Vāsudeva, the maker of light,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:60.3"], "en": "reveals all beings to living creatures, so too does he manifest [the Dhamma].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:60.4"], "en": "“Form is beautiful or foul;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:60.5", "PA_ja_532:60.6"], "en": "in this very way, Master Kosiya has revealed the Dhamma to us.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:61.1"], "en": "“Though I entreated you in this way,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:61.2"], "en": "you did not acknowledge my joined palms;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:61.3"], "en": "I shall become your follower.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:61.4"], "en": "“The attendant has risen.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:62.1"], "en": "“Surely you understand, Nanda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:62.2"], "en": "the True Dhamma taught by the virtuous;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:62.3"], "en": "Noble one, you of noble conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:62.4"], "en": "you are very pleasing to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:63.1"], "en": "I address you as \"bhavanta\" and \"bhote.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:63.2"], "en": "Listen to my words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:63.3", "PA_ja_532:63.4"], "en": "this burden was never at any time considered a burden by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:64.1"], "en": "While I was thus attending to him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:64.2"], "en": "bringing happiness to my mother and father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:64.3"], "en": "Nanda made me his attendant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:64.4"], "en": "He requests her for the sake of attendance.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:65.1"], "en": "For whoever, out of desire,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:65.2"], "en": "seeks to entangle those who live the holy life—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:65.3"], "en": "“Choose one of you as Nanda;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:65.4"], "en": "whom shall Nanda serve?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:66.1"], "en": "“If you are permitted by our father, dear one,” [they said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:66.2"], "en": "\"O Soṇa, we depend on him;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:66.3"], "en": "I have found an opportunity to strike Nanda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:66.4"], "en": "that practitioner of the holy life, upon his head.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:67.1"], "en": "Like a young *assattha* tree,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:67.2"], "en": "its coral-red shoots stirred by the wind—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:67.3"], "en": "having seen Nanda after so long, [he rejoiced].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:67.4"], "en": "My heart trembles when,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:68.1"], "en": "even in my dreams while asleep,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:68.2"], "en": "I see Nanda come.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:68.3"], "en": "I am uplifted and joyful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:68.4"], "en": "for this Nanda has arrived.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:69.1"], "en": "And when I have awakened—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:69.2"], "en": "I see that Nanda has not returned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:69.3"], "en": "grief enters me even more deeply,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:69.4"], "en": "and my dejection is no small thing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:70.1"], "en": "Today, after a long time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:70.2"], "en": "I see Nanda come;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:70.3"], "en": "he is dear to my husband and to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:70.4"], "en": "Nanda did not enter his home.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:71.1"], "en": "Even his father was pleased with Nanda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:71.2"], "en": "because Nanda did not depart from his house.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:71.3"], "en": "\"May Nanda receive it, dear one;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:71.4"], "en": "let Nanda attend upon me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:72.1"], "en": "\"He is compassionate and a firm support,\" [he said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:72.2"], "en": "In the past we were givers of flavors and so forth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:72.3"], "en": "the path to the heavenly world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:72.4"], "en": "O Lord, you choose for us.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:73.1"], "en": "In former times, the giving of flavors was a clan tradition;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:73.2"], "en": "a mother is endowed with merit;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:73.3"], "en": "this is the path to the heavenly world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:73.4"], "en": "“His mother chooses him as her son.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:74.1"], "en": "Desiring the fruit of a son,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:74.2"], "en": "she pays homage to the deity.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:74.3"], "en": "She asks about the constellations,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:74.4", "PA_ja_532:75.1"], "en": "the seasons, and the years; when she has bathed according to the season—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:75.2"], "en": "There is an emergence from the womb;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:75.3", "PA_ja_532:75.4"], "en": "because of that she has cravings, and because of that she is called \"one who gives birth with ease.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:76.1"], "en": "Having carried [the fetus] for a year or less,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:76.2", "PA_ja_532:76.3"], "en": "she gives birth; therefore, she is called \"one who gives birth.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:76.4"], "en": "Therefore she is called \"mother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:77.1"], "en": "By means of nursing at the breast, by song,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:77.2"], "en": "and by clothing her limbs;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:77.3"], "en": "She pleases her crying child;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:77.4"], "en": "thus she is called \"pleasing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:78.1"], "en": "Then, amidst the terrible wind and heat,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:78.2"], "en": "She looks upon me as her own;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:78.3"], "en": "nourishing a child who does not recognize her,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:78.4"], "en": "she is therefore called \"mother.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:79.1", "PA_ja_532:79.2"], "en": "Whatever wealth belongs to his mother and whatever wealth belongs to his father—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:79.3"], "en": "he protects both of these.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:79.4"], "en": "\"May it not happen to our son.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:80.1", "PA_ja_532:80.2"], "en": "Thus, \"O son! Alas, my son!\"—in this way the mother is distressed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:80.3"], "en": "He who is heedless regarding the wives of others,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:80.4"], "en": "being young and in the prime of life,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:80.5"], "en": "and who does not bring home his son in the evening—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:80.6"], "en": "Thus the mother suffers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:81.1", "PA_ja_532:81.2"], "en": "In this way, the man who does not care for his mother lives in misery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:81.3"], "en": "Having committed misconduct toward his mother,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:81.4"], "en": "he is reborn in hell;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:82.1"], "en": "thus does a person live in misery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:82.2"], "en": "One who does not attend to his father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:82.3"], "en": "having behaved wrongly toward his father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:82.4"], "en": "is reborn in hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:83.1"], "en": "Even wealth perishes for those who desire wealth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:83.2"], "en": "thus have I heard:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:83.3"], "en": "by failing to serve one's mother, it is lost.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:83.4"], "en": "Or he meets with misfortune;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:84.1"], "en": "even his wealth perishes for those who desire wealth—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:84.2"], "en": "thus have I heard.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:84.3"], "en": "Having failed to serve one's father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:84.4"], "en": "one encounters hardship;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:85.1"], "en": "yet there is joy and gladness [in serving him].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:85.2", "PA_ja_532:85.3", "PA_ja_532:85.4"], "en": "This constant laughter and play is obtained by one who understands after having served his mother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:86.1"], "en": "Ānanda and Pramoda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:86.2"], "en": "always laughing and playing—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:86.3"], "en": "having served their father, they attained heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:86.4"], "en": "This is attainable by one who understands:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:87.1"], "en": "generosity, pleasant speech,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:87.2"], "en": "and purposeful conduct in this world;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:87.3"], "en": "And impartiality toward all things,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:87.4"], "en": "as is appropriate in each case—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:87.5"], "en": "these indeed are the means of integration in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:87.6"], "en": "Just as the linchpin of a moving chariot,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:88.1"], "en": "if these means of integration did not exist,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:88.2"], "en": "even a mother would not, for the sake of her son, restrain him from evil.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:88.3"], "en": "One might receive honor or worship,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:88.4"], "en": "just as a father does for the sake of his son;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:89.1"], "en": "yet these are merely forms of attachment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:89.2"], "en": "The wise perceive correctly;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:89.3", "PA_ja_532:89.4"], "en": "therefore they attain greatness and become objects of praise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:90.1", "PA_ja_532:90.2"], "en": "Parents are called \"Brahmās\" and \"former teachers\";", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:90.3"], "en": "they are worthy of offerings from their children.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:90.4"], "en": "They have compassion for all beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:91.1", "PA_ja_532:91.2"], "en": "Therefore, a wise person should revere and honor them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:91.3"], "en": "With food and likewise with drink,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:91.4"], "en": "with clothing and with bedding;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:91.5"], "en": "with ointment and with bathing—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:91.6"], "en": "And by washing their feet—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:92.1", "PA_ja_532:92.2"], "en": "with such service toward his parents, the wise person [attains merit].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:92.3"], "en": "“Right here they praise him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:92.4"], "en": "and after death he rejoices in heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:93.1"], "en": "Thus ends the second Jātaka, the Soṇananda Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:94.1"], "en": "The Seventieth Chapter is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:95.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:96.1"], "en": "Now, in this excellent seventieth chapter...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:96.2"], "en": "The excellent King Kusāvatī was possessed of a council hall;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:96.3"], "en": "then there were Soṇa and Sunanda, and again,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_532:96.4"], "en": "as heard in the seventy-first [chapter], the one known as Abhivāsita.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
