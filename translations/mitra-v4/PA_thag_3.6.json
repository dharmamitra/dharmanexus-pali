[
{"segs": ["PA_thag_3.6:0.1", "PA_thag_3.6:0.2"], "en": "Theragāthā 3.6 Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.6:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.6:0.4"], "en": "The Verses of the Elder Khujjasobhita:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.6:1.1", "PA_thag_3.6:1.2"], "en": "“Those eloquent speakers, learned monks residing in Pāṭaliputta;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.6:1.3", "PA_thag_3.6:1.4"], "en": "\"One among them, a youth named Khujjasobhita, stands at the gate.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.6:2.1"], "en": "\"Those who are eloquent in speech and learned...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.6:2.2"], "en": "“These are ascetics dwelling in Pāṭaliputta;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.6:2.3"], "en": "one among them, a youth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.6:2.4"], "en": "stands at the gate, driven by the wind.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.6:3.1"], "en": "“By fair fighting, by giving well, by victory in battle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.6:3.2"], "en": "and by practicing the holy life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.6:3.3"], "en": "[one gains these four things].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.6:3.4"], "en": "“Thus does this one prosper in happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.6:3.5"], "en": "… Thus spoke the Elder Khujjasobhita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
