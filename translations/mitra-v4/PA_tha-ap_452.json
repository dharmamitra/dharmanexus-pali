[
{"segs": ["PA_tha-ap_452:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:0.2"], "en": "Vibhītakavagga 10:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:0.3"], "en": "The Apadāna of the Elder Bodhigharadāyaka (The Giver of the Bodhi-House)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:1.1", "PA_tha-ap_452:1.2", "PA_tha-ap_452:1.3"], "en": "“With a clear mind and joyful heart, [I offer this] to the Blessed One Siddhattha, the Lord of bipeds, the Tathāgata.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:1.4"], "en": "I had a Bodhi-house constructed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:2.1", "PA_tha-ap_452:2.2"], "en": "I have been reborn in Tuṣita and dwell in a house of jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:2.3"], "en": "For me there is neither cold nor heat;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:2.4"], "en": "the wind does not touch my limbs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:3.1"], "en": "For fifty-five eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:3.2"], "en": "I was a wheel-turning monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:3.3"], "en": "there was a city named Kāsika,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:3.4"], "en": "built by Vissakamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:4.1", "PA_tha-ap_452:4.2"], "en": "Ten yojanas in length and eight yojanas in width;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:4.3"], "en": "in that city there was nothing—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:4.4"], "en": "Of wood, creepers, and clay;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:5.1", "PA_tha-ap_452:5.2"], "en": "it was one yojana in length and half a yojana in width.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:5.3", "PA_tha-ap_452:5.4"], "en": "The palace named Maṅgala was constructed by Vissakamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:6.1"], "en": "eighty-four thousand [beings]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:6.2"], "en": "The pillars were made of gold;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:6.3"], "en": "the finials were made of jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:6.4"], "en": "and the roof was made of silver.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:7.1"], "en": "This house made entirely of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:7.2"], "en": "constructed by Vissakamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:7.3"], "en": "has been inhabited by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:7.4"], "en": "This is the fruit of giving a house.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:8.1", "PA_tha-ap_452:8.2"], "en": "Having experienced all those [rewards] in both divine and human existences,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:8.3"], "en": "I have attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:8.4"], "en": "the unsurpassed state of peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:9.1"], "en": "In thirty thousand aeons—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:9.2"], "en": "I had a Bodhi-house constructed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:9.3"], "en": "I do not know a state of misery—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:9.4"], "en": "this is the fruit of giving a house.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:10.1", "PA_tha-ap_452:10.2"], "en": "The defilements have been burnt away by me; ... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:10.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:11.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:11.2", "PA_tha-ap_452:11.3"], "en": "[and so forth] ...the Buddha’s instruction has been fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:12.1", "PA_tha-ap_452:12.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:12.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:13.1"], "en": "Thus indeed the venerable elder Bodhigharadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:14.1"], "en": "This is the tenth *apadāna* of the elder Bodhigharadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:15.1"], "en": "The forty-fifth chapter, the Vibhītakavagga, is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:16.1"], "en": "Its summary verse (uddāna):", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:17.1"], "en": "Vibhītaki, kolaphalī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:17.2"], "en": "billa, bhallātaka, and appada.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:17.3"], "en": "The high hanging canopy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:17.4"], "en": "the seat, and the footstool;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:18.1"], "en": "the altar and the pavilion for the Bodhi tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:18.2"], "en": "The verses have been counted as well;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_452:18.3", "PA_tha-ap_452:18.4"], "en": "all seventy-nine [verses] are enumerated in this chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
