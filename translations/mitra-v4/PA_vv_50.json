[
{"segs": ["PA_vv_50:0.1"], "en": "Vimānavatthu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:0.2", "PA_vv_50:0.3"], "en": "The Chapter on the Mañjiṭṭhaka Mansion in the Section on Female Vimānas", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:0.4", "PA_vv_50:1.1", "PA_vv_50:1.2"], "en": "12. The Story of the Rajjumālā Vimāna “O goddess, you who stand there with such exquisite beauty;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:1.3", "PA_vv_50:1.4"], "en": "Grasping at hands and feet, you dance, O well-sounding one.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:2.1"], "en": "As you are dancing, [the world]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:2.2"], "en": "From every single limb,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:2.3"], "en": "divine sounds issue forth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:2.4"], "en": "melodious and enchanting.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:3.1", "PA_vv_50:3.2"], "en": "As you dance, from every one of your limbs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:3.3"], "en": "divine fragrances waft forth on all sides.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:3.4"], "en": "Fragrant and delightful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:4.1", "PA_vv_50:4.2"], "en": "those ornaments which were worn upon their braided hair as they turned their bodies.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:4.3", "PA_vv_50:4.4"], "en": "Their sound was heard like that of a fivefold musical ensemble;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:5.1"], "en": "their head-ornaments were shaken by the wind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:5.2"], "en": "Shaken by the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:5.3", "PA_vv_50:5.4"], "en": "their sound is heard like that of a fivefold musical ensemble.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:6.1"], "en": "Even that garland upon your head,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:6.2"], "en": "pure-scented and delightful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:6.3"], "en": "its fragrance wafts in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:6.4"], "en": "Just like a mañjūsaka tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:7.1", "PA_vv_50:7.2"], "en": "you smell that pure fragrance and behold that superhuman form.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:7.3"], "en": "“O deity, being questioned, tell me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:7.4"], "en": "what is the fruit of which deed is this?", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:8.1"], "en": "“In the past, I was a slave.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:8.2"], "en": "I am a brahmin of Gayā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:8.3"], "en": "possessing little merit and lacking fortune,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:8.4"], "en": "the wise know me as \"Rajjumālā.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:9.1"], "en": "Amidst verbal abuse, killings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:9.2"], "en": "and fierce threats of execution,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:9.3"], "en": "he emerged, taking up a club.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:9.4"], "en": "I went as a water-carrier.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:10.1"], "en": "Having set down my jar on a bypath,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:10.2"], "en": "I approached a forest grove.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:10.3"], "en": "Right here I shall die;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:10.4"], "en": "what is the use of my life?", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:11.1"], "en": "Having set a firm snare, I shall remain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:11.2"], "en": "Having climbed up into the tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:11.3"], "en": "I then looked out in all directions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:11.4"], "en": "wondering, \"Who indeed is dwelling in this forest?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:12.1"], "en": "There I saw the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:12.2"], "en": "the Sage who works for the welfare of the whole world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:12.3"], "en": "seated at the foot of a tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:12.4"], "en": "As he meditated, free from fear from any quarter,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:13.1"], "en": "a sense of urgency arose within me—", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:13.2"], "en": "extraordinary and hair-raising.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:13.3"], "en": "Who is this dwelling in the forest?", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:13.4"], "en": "Is it a human being or a deity?", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:14.1"], "en": "He is inspiring and full of faith-inspiring grace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:14.2"], "en": "Having seen him who has come from the forest to the state beyond the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:14.3"], "en": "my mind was filled with confidence:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:14.4"], "en": "he is not like anyone else.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:15.1"], "en": "With the faculty of the mind guarded, delighting in meditation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:15.2"], "en": "with his mind not directed outward,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:15.3"], "en": "he is a benefactor to the whole world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:15.4"], "en": "\"This one will become a Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:16.1"], "en": "Terrifying and formidable, he is difficult to approach,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:16.2"], "en": "like a lion dwelling in its cave.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:16.3", "PA_vv_50:16.4"], "en": "He is as difficult to behold as the udumbara flower;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:17.1"], "en": "he [addresses] me with gentle words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:17.2", "PA_vv_50:17.3"], "en": "Having thus addressed me, the Tathāgata said, \"I am called Rajjumāla;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:17.4"], "en": "go for refuge to the Tathāgata.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:18.1"], "en": "Having heard that speech—", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:18.2"], "en": "flawless, meaningful, pure, gentle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:18.3"], "en": "soft, and charming—", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:18.4"], "en": "The dispeller of all sorrows.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:19.1"], "en": "And knowing me to be of ready mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:19.2"], "en": "serene and pure in heart;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:19.3", "PA_vv_50:19.4"], "en": "The Tathāgata, the teacher of the entire world, has instructed me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:20.1"], "en": "\"This is suffering.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:20.2"], "en": "This is the origin of suffering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:20.3", "PA_vv_50:20.4"], "en": "the cessation of suffering and the path leading directly to the immersion in the Deathless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:21.1", "PA_vv_50:21.2"], "en": "Abiding by the instruction of the compassionate and skillful one,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:21.3"], "en": "I have attained the peace of the Deathless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:21.4"], "en": "Nibbāna is the deathless state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:22.1"], "en": "With love firmly established,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:22.2"], "en": "unshakable in its vision, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:22.3"], "en": "Born from faith rooted in the root,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:22.4"], "en": "the Buddha’s own legitimate daughter—", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:23.1"], "en": "I, she, delight and sport.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:23.2"], "en": "I rejoice, free from fear from any quarter;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:23.3", "PA_vv_50:23.4"], "en": "I wear celestial garlands and drink sweet, intoxicating honey-wine.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:24.1"], "en": "Sixty thousand musical instruments awaken me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:24.2", "PA_vv_50:24.3"], "en": "Āḷamba, Gaggaro, and Bhīma, too.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:24.4", "PA_vv_50:25.1"], "en": "Sādhuvādī, Saṃsaya, Pokkharo, Suphasso,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:25.2"], "en": "Vīṇāmokkhā, and Nāriyo.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:25.3"], "en": "Nandā and Sunandā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:25.4"], "en": "Soṇadinnā and Sucimhitā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:26.1"], "en": "Alambusā and Missakesī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:26.2"], "en": "Puṇḍarīkā was exceedingly fierce;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:26.3"], "en": "Eṇīphassā was pleasant to touch, as was Suphassā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:26.4"], "en": "Subhaddā was soft-spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:27.1"], "en": "These and other excellent women,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:27.2"], "en": "who awaken the celestial nymphs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:27.3"], "en": "approached me at the proper time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:27.4"], "en": "The deities address him:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:28.1"], "en": "\"Come, let us dance and sing;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:28.2"], "en": "come, let us delight you.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:28.3"], "en": "This is not for those who have not performed merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:28.4"], "en": "this is only for those who have performed merit—", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:29.1"], "en": "this sorrowless, delightful, and charming Nandana grove.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:29.2"], "en": "The Great Forest of the Thirty-three gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:29.3", "PA_vv_50:29.4"], "en": "for those who have not performed meritorious deeds, there is no happiness here or in the world beyond.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:30.1"], "en": "And happiness for those who have performed merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:30.2"], "en": "both here and in the world beyond,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:30.3"], "en": "for those who desire companionship with them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:30.4"], "en": "One should perform much wholesome merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:30.5", "PA_vv_50:30.6"], "en": "for those who have performed meritorious deeds rejoice in heaven, endowed with enjoyments.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:31.1", "PA_vv_50:31.2"], "en": "Truly, for the benefit of many do Tathāgatas arise,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:31.3"], "en": "worthy of offerings from human beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:31.4"], "en": "They are mines of fields of merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:31.5"], "en": "having performed service there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:31.6"], "en": "donors rejoice in heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:32.1"], "en": "The Rajjumālāvimāna is the twelfth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:33.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:34.1"], "en": "Mañjiṭṭhā, Pabhassarā, Nāgā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:34.2"], "en": "The giver of rice-scum without husks;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:34.3"], "en": "the four pillars of the monastery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:34.4"], "en": "the yellow one; and the sugarcane-stalk rope-garland.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:34.5"], "en": "Thus it is called a chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:35.1"], "en": "The fourth chapter, the Mañjiṭṭhaka-vagga, is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_50:36.1"], "en": "The Itthivimāna is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"}
]
