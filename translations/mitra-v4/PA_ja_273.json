[
{"segs": ["PA_ja_273:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:0.2", "PA_ja_273:0.3"], "en": "The Collection of Threes, Chapter on the Well (Udapānavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:0.4"], "en": "3. The Kacchapa Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:1.1", "PA_ja_273:1.2"], "en": "“Who is this who, like one with food already lifted up, or like a brahmin with his bowl full of rice, ... [is departing]?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:1.3"], "en": "“Where indeed did he wander for alms?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:1.4"], "en": "To whom did he go with faith?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:2.1"], "en": "“At Kapila, I was foolish.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:2.2"], "en": "I touched things that should not be touched;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:2.3"], "en": "may you release me, may it be well with you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:2.4"], "en": "for once released, I shall go to the mountain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:3.1"], "en": "“The tortoises are Kassapas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:3.2"], "en": "the monkeys are Koṇḍaññas;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:3.3"], "en": "release Kassapa and Koṇḍañña.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:3.4"], "en": "“You have committed adultery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_273:4.1"], "en": "The Third Jātaka, the Tortoise Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
