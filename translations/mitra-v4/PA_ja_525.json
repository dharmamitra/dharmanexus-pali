[
{"segs": ["PA_ja_525:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:0.2"], "en": "The Collection of Forty Birth Stories,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:0.3"], "en": "Chapter on the Tesakuṇa Birds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:0.4"], "en": "5. The Cūḷasutasoma Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:1.1", "PA_ja_525:1.2"], "en": "“I summon the town, my friends and kinsmen;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:1.3"], "en": "“Gray hair has grown upon my head;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:1.4"], "en": "now I find delight in going forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:2.1"], "en": "“How can you speak such words to me?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:2.2"], "en": "\"O King, you have driven a spear into my chest;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:2.3"], "en": "you have seven hundred wives—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:2.4"], "en": "how indeed will they fare?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:3.1", "PA_ja_525:3.2"], "en": "“These young women will be seen, and others besides them will go there as well;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:3.3"], "en": "desiring heaven for himself, [one should practice virtue].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:3.4"], "en": "\"Therefore, I shall go forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:4.1"], "en": "\"It was a misfortune for me, Sutasoma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:4.2"], "en": "that I am your mother.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:4.3", "PA_ja_525:4.4"], "en": "Since you have gone forth, O King, without regard for me as I lamented,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:5.1"], "en": "it was a misfortune for me, Sutasoma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:5.2", "PA_ja_525:5.3"], "en": "\"That which I shall give birth to, and that for which they lament as I cry out— you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:5.4"], "en": "O King, have gone forth without a care.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:6.1"], "en": "“What indeed is this Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:6.2"], "en": "Sutasoma, and what is this so-called renunciation,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:6.3"], "en": "that you would leave us who are old?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:6.4"], "en": "O King, you have gone forth without longing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:7.1"], "en": "You have many sons,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:7.2"], "en": "still young and not yet reached the prime of youth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:7.3", "PA_ja_525:7.4"], "en": "“Even Mañjuśrī, I think, suffers when he does not see him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:8.1"], "en": "“By these sons of mine...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:8.2", "PA_ja_525:8.3"], "en": "Though you are all young, not yet reached the prime of youth, and full of charm—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:8.4"], "en": "even after remaining for a long time, the nature of destruction awaits you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:9.1", "PA_ja_525:9.2"], "en": "“Is your heart truly cut out, or do you have no compassion for us,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:9.3"], "en": "that while we are crying out, [you remain indifferent]?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:9.4"], "en": "“You have gone forth, O King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:10.1"], "en": "without longing. “My heart is not severed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:10.2"], "en": "nor is there a lack of compassion for you.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:10.3"], "en": "“Desiring heaven,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:10.4"], "en": "for that reason I shall go forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:11.1"], "en": "“It was a misfortune for me,” [he thought].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:11.2"], "en": "Sutasoma, you for whom I am your wife—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:11.3", "PA_ja_525:11.4"], "en": "O King, you have gone forth into homelessness without regard for me as I lamented.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:12.1"], "en": "I was ill-fated,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:12.2"], "en": "Sutasoma, you for whom I was a wife;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:12.3"], "en": "that I had a connection with your womb—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:12.4"], "en": "\"O King, you have gone forth without regard for anything.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:13.1"], "en": "My pregnancy is full;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:13.2"], "en": "let me give birth to that which is within my womb.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:13.3"], "en": "\"May I not be left alone as a widow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:13.4"], "en": "And later behold sufferings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:14.1"], "en": "\"Your pregnancy is fully matured.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:14.2"], "en": "\"Come now, give birth to the one within your womb;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:14.3"], "en": "once I have left that son of extraordinary beauty,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:14.4"], "en": "I shall go forth into homelessness.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:15.1"], "en": "“Do not weep, Canda;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:15.2"], "en": "do not grieve, you whose eyes are blinded by the darkness of the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:15.3"], "en": "ascend the excellent palace.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:15.4"], "en": "“Without longing I shall go.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:16.1"], "en": "“Who has angered you, mother?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:16.2"], "en": "Why do you weep and look at me so intensely?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:16.3", "PA_ja_525:16.4"], "en": "Whom, while my kinsmen look on, shall I slay that is not to be slain?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:17.1"], "en": "Indeed, he cannot be killed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:17.2"], "en": "\"O dear one, Vijitāvī who has provoked my anger—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:17.3"], "en": "your father said this to me, dear one:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:17.4"], "en": "'I shall go without looking back.'\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:18.1", "PA_ja_525:18.2"], "en": "“I who formerly went out to the park and fought with rutting elephants—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:18.3"], "en": "now that Sutasoma has gone forth, [I am no more].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:18.4"], "en": "\"How indeed shall I act now?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:19.1", "PA_ja_525:19.2"], "en": "While my mother weeps and my eldest brother is unwilling...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:19.3"], "en": "\"I will seize you by the hand;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:19.4"], "en": "you shall not go against our will.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:20.1"], "en": "\"Arise, nurse!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:20.2"], "en": "\"Delight this prince elsewhere;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:20.3", "PA_ja_525:20.4"], "en": "do not create an obstacle for me who am longing for heaven.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:21.1"], "en": "“What if I were now to give this light-maker?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:21.2", "PA_ja_525:21.3"], "en": "What need have I for it, now that Sutasoma has gone forth?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:21.4"], "en": "\"What indeed shall I do with this?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:22.1"], "en": "\"Your treasury is vast,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:22.2"], "en": "and your storehouse is full.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:22.3"], "en": "\"The earth has been conquered by you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:22.4"], "en": "enjoy it, O King, do not go forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:23.1"], "en": "\"My treasury is vast,\" [he replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:23.2"], "en": "My storehouses are full;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:23.3"], "en": "the earth is conquered by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:23.4"], "en": "Having abandoned that, I shall go forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:24.1"], "en": "“I too have abundant wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:24.2"], "en": "O King, which I cannot even calculate;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:24.3"], "en": "I give all of that to you.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:24.4"], "en": "“Do not go forth, O King!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:25.1", "PA_ja_525:25.2"], "en": "[He replied: “I know that wealth is abundant, and I am honored by you, O increaser of the lineage.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:25.3"], "en": "Longing for heaven,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:25.4"], "en": "it is for that reason that I shall go forth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:26.1"], "en": "I am deeply disenchanted.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:26.2"], "en": "“Discontent, O Somadatta, has entered me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:26.3"], "en": "there are many obstacles for me as well.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:26.4"], "en": "This very day I shall go forth.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:27.1"], "en": "“If this is your wish,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:27.2"], "en": "Sutasoma, then renounce the world this very day;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:27.3"], "en": "I too shall go forth.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:27.4"], "en": "\"I cannot endure to remain without you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:28.1"], "en": "\"It is not possible to go forth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:28.2"], "en": "for food is not cooked in the city nor in the countryside.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:28.3"], "en": "Now that Sutasoma has gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:28.4"], "en": "how indeed shall we act?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:29.1"], "en": "I think this [kingdom] is being led away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:29.2"], "en": "Just as a tiny drop of water on the rim of a potter's wheel,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:29.3"], "en": "so too, life being so very short,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:29.4"], "en": "it is no time to be negligent.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:30.1", "PA_ja_525:30.2"], "en": "I think this life is being led away like a little water in a cow’s footprint;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:30.3"], "en": "thus, when life is so very short, [one should practice].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:30.4"], "en": "The blind fools are heedless;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:31.1"], "en": "they increase hell, the animal realm,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:31.2"], "en": "and the sphere of hungry ghosts.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:31.3"], "en": "Bound by the fetters of craving,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:31.4"], "en": "they increase the host of asuras.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:32.1"], "en": "The cloud of dust is being swept away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:32.2"], "en": "\"Not far from the eastern palace,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:32.3", "PA_ja_525:32.4"], "en": "I think, were the hairs cut off of the illustrious King of Dharma.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:33.1"], "en": "“This is his palace,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:33.2"], "en": "strewn with golden flowers and garlands;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:33.3"], "en": "here the king used to wander about.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:33.4"], "en": "Surrounded by women of the harem,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:34.1"], "en": "this is his palace,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:34.2"], "en": "strewn with golden flowers and garlands.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:34.3", "PA_ja_525:34.4"], "en": "The king, surrounded by his circle of kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:35.1"], "en": "deliberated upon this gabled chamber of his.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:35.2", "PA_ja_525:35.3"], "en": "There the king wandered about, strewn with golden flowers and garlands,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:35.4"], "en": "surrounded by his retinue of women.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:36.1"], "en": "This is his gabled hall,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:36.2"], "en": "strewn with golden flowers and garlands,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:36.3"], "en": "wherein the king used to wander about.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:36.4"], "en": "Surrounded by a multitude of kinsmen—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:37.1"], "en": "this is his Asoka grove,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:37.2"], "en": "ever-blooming with beautiful flowers and delightful at all times.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:37.3", "PA_ja_525:37.4"], "en": "The king, surrounded by his women’s quarters,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:38.1"], "en": "wandered about this Aśoka grove of his.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:38.2"], "en": "In this delightful grove, which is in full bloom at all times,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:38.3"], "en": "the king roamed about,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:38.4"], "en": "surrounded by his assembly of kinsmen.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:39.1"], "en": "This is his pleasure grove,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:39.2"], "en": "ever-blooming and delightful at all times,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:39.3"], "en": "wherein the king wanders.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:39.4"], "en": "Surrounded by women of the harem,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:40.1"], "en": "he has this pleasure grove,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:40.2"], "en": "which is always in full bloom and delightful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:40.3", "PA_ja_525:40.4"], "en": "The king, surrounded by his circle of kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:41.1"], "en": "wandered about this grove of *kaṇikāra* trees.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:41.2"], "en": "In this delightful place, which blooms at all times,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:41.3"], "en": "the king roamed about,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:41.4"], "en": "surrounded by his harem of women.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:42.1", "PA_ja_525:42.2"], "en": "This is his lovely *kaṇikāra* grove, in full bloom at all times;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:42.3"], "en": "here the king wanders about.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:42.4"], "en": "Surrounded by a host of kinsmen.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:43.1"], "en": "This is his Pāṭalivana grove,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:43.2"], "en": "ever-blooming and delightful at all times.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:43.3", "PA_ja_525:43.4"], "en": "The king, surrounded by his harem,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:44.1"], "en": "was wandering about this Pāṭalīvana grove of his.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:44.2"], "en": "In this delightful place, which is in full bloom at all times,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:44.3"], "en": "the king roamed about,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:44.4"], "en": "surrounded by his host of kinsmen.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:45.1", "PA_ja_525:45.2"], "en": "This mango grove of his is in full bloom at all times, delightful;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:45.3"], "en": "here the king used to wander about.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:45.4"], "en": "Surrounded by his harem women,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:46.1"], "en": "he has this mango grove,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:46.2"], "en": "which is beautiful, always in full bloom, and delightful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:46.3", "PA_ja_525:46.4"], "en": "King Yama, surrounded by his host of kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:47.1"], "en": "wanders about this lotus pond. This is his [pond].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:47.2"], "en": "Covered and strewn with egg-born creatures,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:47.3"], "en": "the king wandered about there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:47.4"], "en": "surrounded by his harem.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:48.1"], "en": "This is his lotus pond,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:48.2"], "en": "covered and strewn with egg-born creatures,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:48.3"], "en": "wherein the king used to roam.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:48.4"], "en": "Surrounded by his circle of kinsmen:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:49.1"], "en": "\"The king has indeed gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:49.2"], "en": "having renounced this kingdom, O Sutasoma.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:49.3"], "en": "Clad in saffron robes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:49.4"], "en": "he wanders alone like an elephant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:50.1"], "en": "Do not recall your former pleasures and games.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:50.2"], "en": "And you remembered your smiles;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:50.3"], "en": "let not sensual desires overcome you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:50.4"], "en": "for this city is delightful and beautiful to behold.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:51.1"], "en": "Cultivate a mind of loving-kindness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:51.2"], "en": "immeasurable, by day and by night;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:51.3"], "en": "you shall go to the city of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:51.4"], "en": "“A dwelling for those who perform meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:52.1"], "en": "Thus ends the fifth story, the Cūḷasutasoma Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:53.1"], "en": "The Fortieth Book is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:54.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:55.1"], "en": "Suvapaṇḍita, Jambuka, Kuṇḍalinī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:55.2"], "en": "Varakaññā, and the Alambusa Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:55.3"], "en": "The most excellent king, renowned by the name Saṅkhasiri,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_525:55.4"], "en": "was the noble King Sutasoma Arindama.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
