[
{"segs": ["PA_thag_6.3:0.1", "PA_thag_6.3:0.2"], "en": "Theragāthā 6.3 Chakkanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:0.4"], "en": "The Verses of the Elder Mahānāga:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:1.1", "PA_thag_6.3:1.2"], "en": "“He in whom no reverence for his fellow-celibates is found;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:1.3"], "en": "He falls away from the true Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:1.4"], "en": "like a fish in shallow water—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:2.1"], "en": "he who [acts thus] toward his fellow celibates.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:2.2"], "en": "Reverence is not found [in him];", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:2.3"], "en": "it does not grow in the True Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:2.4"], "en": "like a rotten seed in a field.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:3.1", "PA_thag_6.3:3.2", "PA_thag_6.3:3.3"], "en": "He in whom no reverence for his fellow-celibates is found is far from Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:3.4"], "en": "In the teaching of the Dhamma King,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:4.1", "PA_thag_6.3:4.2"], "en": "for one in whom reverence toward fellow practitioners of the holy life is found;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:4.3"], "en": "One does not depart from the true Dharma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:4.4"], "en": "just as a fish does not leave abundant water—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:5.1"], "en": "this is for one who [acts rightly] toward his fellow practitioners of the holy life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:5.2"], "en": "Reverence is found;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:5.3", "PA_thag_6.3:5.4"], "en": "it grows within the true Dhamma like a noble seed in a fertile field.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:6.1", "PA_thag_6.3:6.2"], "en": "For one in whom reverence for their fellow practitioners is found,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:6.3"], "en": "Nibbāna is near at hand.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:6.4"], "en": "“In the teaching of the Dhamma King.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.3:6.5"], "en": "… Thus spoke the elder Mahānāga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
