[
{"segs": ["PA_kp_4:0.1"], "en": "Khuddakapāṭha 4:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:0.2", "PA_kp_4:1.1"], "en": "The Questions of the Prince (Kumārapañhā) What is that which is called \"one\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:1.2"], "en": "All beings subsist on nutriment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:2.1", "PA_kp_4:2.2"], "en": "What two? Name and form.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:3.1"], "en": "What are the three?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:3.2"], "en": "The three feelings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:4.1"], "en": "What are the four?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:4.2"], "en": "The four noble truths.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:5.1", "PA_kp_4:5.2"], "en": "What five? The five aggregates of clinging.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:6.1"], "en": "What is called \"six\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:6.2"], "en": "The six internal sense bases.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:7.1"], "en": "What is called \"seven\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:7.2"], "en": "The seven factors of enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:8.1"], "en": "What is called the eightfold?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:8.2"], "en": "The noble eightfold path.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:9.1"], "en": "What is ninefold?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:9.2"], "en": "The nine abodes of beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:10.1"], "en": "What is tenfold?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:10.2"], "en": "\"One endowed with ten factors is called an 'Arahant'.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_4:11.1"], "en": "Thus ends the Questions of the Youth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"}
]
