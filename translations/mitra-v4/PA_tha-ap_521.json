[
{"segs": ["PA_tha-ap_521:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:0.2"], "en": "The Chapter on the Giver of All Fruits (Phaladāyakavagga) 9.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:0.3"], "en": "The Apadāna of the Elder Sabbaphaladāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:1.1", "PA_tha-ap_521:1.2"], "en": "“There was a brahmin named Varuṇa, a master of the mantras;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:1.3"], "en": "having abandoned his ten sons,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:1.4"], "en": "I then entered deep into the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:2.1"], "en": "Having constructed a well-made hermitage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:2.2"], "en": "beautifully divided and delightful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:2.3"], "en": "Having built a leaf-hut,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:2.4"], "en": "I dwell in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:3.1"], "en": "Padumuttara, the Knower of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:3.2"], "en": "The recipient of oblations;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:3.3"], "en": "desiring to uplift me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:3.4"], "en": "he came to my hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:4.1", "PA_tha-ap_521:4.2"], "en": "To whatever extent there was a vast radiance within the forest grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:4.3"], "en": "it was through the majestic power of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:4.4"], "en": "Then the forest blazed up.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:5.1"], "en": "Having seen that miracle of the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:5.2"], "en": "the Best of Buddhas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:5.3"], "en": "Taking a leaf-cup,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:5.4", "PA_tha-ap_521:6.1"], "en": "I made an offering of fruit to the Fully Enlightened One as he approached.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:6.2"], "en": "I was able to endure a thousand enemies;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:6.3", "PA_tha-ap_521:6.4"], "en": "out of compassion for me, the Buddha spoke these words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:7.1", "PA_tha-ap_521:7.2"], "en": "“Take a khāri-load and follow behind me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:7.3"], "en": "when the Saṅgha has finished eating, [give it to them].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:7.4"], "en": "\"Merit shall be yours.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:8.1"], "en": "Having taken the edge of the bundle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:8.2"], "en": "I gave it to the community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:8.3"], "en": "Having gladdened my mind there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:8.4"], "en": "I was reborn in Tusita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:9.1"], "en": "There, with divine dances...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:9.2"], "en": "Through songs and instrumental music,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:9.3", "PA_tha-ap_521:9.4"], "en": "I always experience happiness connected with meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:10.1"], "en": "Whatever womb I am reborn into,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:10.2"], "en": "whether among the gods or among humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:10.3"], "en": "there is no deficiency in my wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:10.4"], "en": "This is the fruit of giving fruit:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:11.1"], "en": "as far as the four continents,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:11.2"], "en": "together with the oceans and the mountains.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:11.3"], "en": "Having offered fruit to the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:11.4", "PA_tha-ap_521:12.1"], "en": "I exercised my sovereignty over as many flocks of birds as there were.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:12.2"], "en": "Even if they were to leap into the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:12.3"], "en": "they too would come under my control;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:12.4"], "en": "this is the fruit of giving the fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:13.1"], "en": "As many as there are in the forest grove—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:13.2"], "en": "yakkhas, bhūtas, and rakkhasas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:13.3"], "en": "kumbhaṇḍas, and garuḷas as well—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:13.4"], "en": "They attend upon me in service:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:14.1"], "en": "mongooses, jackals, and honey-bees,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:14.2"], "en": "as well as gadflies and mosquitoes— both.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:14.3", "PA_tha-ap_521:14.4", "PA_tha-ap_521:15.1"], "en": "The birds called supaṇṇas come under my control; this is the fruit of giving fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:15.2"], "en": "Even those born as birds, possessed of great strength,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:15.3"], "en": "go to me for refuge;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:15.4"], "en": "this is the fruit of giving fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:16.1"], "en": "Even those long-lived nāgas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:16.2"], "en": "possessed of psychic power and great fame—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:16.3"], "en": "even they come under my control.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:16.4", "PA_tha-ap_521:17.1"], "en": "This is the fruit of giving fruit: lions, tigers, leopards,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:17.2"], "en": "bears, hyenas, and jackals;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:17.3"], "en": "The forest edges submit to my will;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:17.4"], "en": "this is the fruit of giving fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:18.1"], "en": "And I dwell among medicinal herbs and grasses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:18.2"], "en": "And those who dwell in the sky—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:18.3"], "en": "all go to me for refuge;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:18.4"], "en": "this is the fruit of giving the fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:19.1"], "en": "Having touched that which is very difficult to see, most subtle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:19.2"], "en": "profound, and well-expounded,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:19.3"], "en": "I dwell [in it].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:19.4"], "en": "This is the fruit of giving:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:20.1"], "en": "having attained the eight liberations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:20.2"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:20.3"], "en": "I am ardent and wise;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:20.4"], "en": "this is the fruit of giving fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:21.1"], "en": "Those sons of the Buddha who stand upon the fruits—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:21.2"], "en": "They have exhausted their faults and possess great renown;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:21.3"], "en": "I am one among them—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:21.4"], "en": "this is the fruit of giving fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:22.1"], "en": "Having reached the perfection of direct knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:22.2"], "en": "urged on by the root of the wholesome,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:22.3"], "en": "and having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:22.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:23.1", "PA_tha-ap_521:23.2"], "en": "These sons of the Buddha, of great renown, possess the three knowledges and have attained the bases of psychic power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:23.3"], "en": "Having attained the divine ear,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:23.4"], "en": "I was one among them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:24.1"], "en": "A hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:24.2"], "en": "The fruit that I gave back then—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:24.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:24.4"], "en": "this is the fruit of giving fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:25.1", "PA_tha-ap_521:25.2"], "en": "The defilements have been incinerated by me; ... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:25.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:26.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:26.2", "PA_tha-ap_521:26.3"], "en": "[pe] ...the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:27.1", "PA_tha-ap_521:27.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:27.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:28.1"], "en": "Thus indeed the venerable elder Sabbaphaladāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_521:29.1"], "en": "The legend of the elder Sabbaphaladāyaka is the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
