[
{"segs": ["PA_thag_4.11:0.1", "PA_thag_4.11:0.2"], "en": "Theragāthā 4.11 Catukkanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:0.4"], "en": "The Verse of the Elder Sappaka:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:1.1"], "en": "“When the crane, with its pure white wings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:1.2"], "en": "was terrified by the fear of the black cloud;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:1.3"], "en": "When she who seeks a dwelling finds her home,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:1.4"], "en": "then the Ajakaraṇī river delights me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:2.1"], "en": "when the crane is perfectly pure and white.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:2.2"], "en": "Terrified by the fear of the black cloud, she,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:2.3"], "en": "seeing no place of refuge, seeks one;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:2.4"], "en": "at that time, the Ajakaraṇī river delights me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:3.1"], "en": "Who indeed would not delight there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:3.2"], "en": "where rose-apple trees grow on both sides?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:3.3"], "en": "They beautify the riverbank.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:3.4"], "en": "Behind my cave, frogs—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:4.1"], "en": "having completely abandoned intoxication and pride—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:4.2"], "en": "croak softly like those who are gentle.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:4.3"], "en": "“This is no time for separation from the mountain streams;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:4.4"], "en": "Khemā Ajakaraṇī is secure, auspicious, and delightful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.11:4.5"], "en": "... The Elder Sappaka...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
