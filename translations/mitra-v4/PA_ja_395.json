[
{"segs": ["PA_ja_395:0.1", "PA_ja_395:0.2"], "en": "Jātaka: The Sixth Book of Birth Stories,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:0.3"], "en": "Chapter on the Son of Kharā (Kharaputtavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:0.4", "PA_ja_395:1.1"], "en": "10. The Pārāvata Jātaka “After a long time, indeed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:1.2"], "en": "I behold my friend, the wearer of the jewel!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:1.3", "PA_ja_395:1.4"], "en": "“‘My friend truly shines with his well-groomed beard,’ he thought. ‘But with my armpits,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:2.1"], "en": "nails, and body hair grown long— ’”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:2.2"], "en": "\"I have been occupied with my work;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:2.3"], "en": "having finally found a barber after a long time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:2.4"], "en": "I had my hair shaved today.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:3.1"], "en": "“Since you have taken away my hair,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:3.2"], "en": "having obtained a barber so difficult to find—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:3.3"], "en": "then why now, good sir, do you [act thus] toward me?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:3.4"], "en": "\"It jingles around the neck.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:4.1", "PA_ja_395:4.2"], "en": "\"A jewel hangs from the necks of those delicate humans;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:4.3"], "en": "I train myself according to their example;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:4.4"], "en": "do not think that what they have done was done in sport.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:5.1"], "en": "If you too desire this, [you must follow them].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:5.2"], "en": "\"A well-crafted ivory comb;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:5.3"], "en": "I shall have one made for you, my good man,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:5.4"], "en": "and I will give you a gem as well.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:6.1"], "en": "“You alone are covered with jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:6.2"], "en": "and with the well-fashioned tresses of Sukatā;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:6.3"], "en": "I bid you farewell, I am going.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:6.4"], "en": "“I would indeed find it pleasing to see you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:7.1"], "en": "The Pārāvata Jātaka, the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:7.2"], "en": "The second chapter, the Kharaputtavagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:8.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:9.1"], "en": "Now behold the Sasūci, the Tuṇḍilaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:9.2"], "en": "the Migasammata, and the excellent bird Mayhaka as the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:9.3"], "en": "Then, with hands joined like the center of a lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:9.4"], "en": "he was then honored by the excellent Kapota bird.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:10.1"], "en": "This is the summary verse of the Vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:11.1"], "en": "Now I shall recite the Vagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:11.2"], "en": "the most excellent group of six verses;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:11.3"], "en": "[beginning with] \"Avāriyā\" and \"Kharo.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:11.4"], "en": "\"And two [verses] are stated with beautiful phrasing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_395:12.1"], "en": "The Chapter of Sixes is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
