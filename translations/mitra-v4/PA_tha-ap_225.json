[
{"segs": ["PA_tha-ap_225:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:0.2"], "en": "The Chapter on the Giver of a Support (Ālambaṇadāyakavagga), Number Three:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:0.3"], "en": "The Apadāna of the Elder Dverataniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:1.1", "PA_tha-ap_225:1.2"], "en": "“In the past, I was a deer-hunter in the forest glades;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:1.3"], "en": "there I saw the stainless Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:1.4"], "en": "The recipient of the oblations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:2.1", "PA_tha-ap_225:2.2"], "en": "A piece of meat was given by me to Vipassi, the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:2.3"], "en": "In this world with its devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:2.4"], "en": "I exercise lordship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:3.1"], "en": "By this gift of flesh, [may I attain it].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:3.2"], "en": "The jewel is produced for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:3.3", "PA_tha-ap_225:3.4"], "en": "these two jewels in the world are for the attainment of the visible Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:4.1", "PA_tha-ap_225:4.2"], "en": "I experience all of that through the power of my gift of flesh;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:4.3"], "en": "even my limbs have become soft.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:4.4"], "en": "Wisdom is to be experienced with subtlety.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:5.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:5.2"], "en": "when I gave that meat at that time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:5.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:5.4"], "en": "this is the fruit of giving meat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:6.1"], "en": "In the fourth aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:6.2"], "en": "I was once a lord of men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:6.3"], "en": "he was named Mahārohaṇa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:6.4"], "en": "a wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:7.1", "PA_tha-ap_225:7.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:7.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:8.1"], "en": "Thus indeed the venerable elder Dverataniya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:9.1"], "en": "This is the third legend of the elder Dverataniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_225:9.2"], "en": "The tenth section for recitation is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
