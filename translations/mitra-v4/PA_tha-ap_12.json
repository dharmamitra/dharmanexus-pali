[
{"segs": ["PA_tha-ap_12:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:0.2"], "en": "Buddhavagga 12.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:0.3"], "en": "The Apadāna of the Elder Ānanda", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:1.1"], "en": "“Emerging from the gate of the monastery,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:1.2", "PA_tha-ap_12:1.3"], "en": "the Great Sage Padumuttara rained down the rain of the Deathless.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:1.4"], "en": "He brought peace to the great multitude.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:2.1"], "en": "Those wise ones, numbering one hundred thousand,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:2.2"], "en": "possessed the six direct knowledges and great psychic power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:2.3", "PA_tha-ap_12:2.4"], "en": "They attend upon the Perfectly Enlightened One like a shadow that never departs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:3.1"], "en": "I was mounted upon the back of an elephant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:3.2", "PA_tha-ap_12:3.3"], "en": "Having seen that most excellent white parasol, so beautiful in form,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:3.4"], "en": "joy arose within me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:4.1"], "en": "Having descended from the back of the elephant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:4.2"], "en": "I approached the Bull among Men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:4.3"], "en": "a parasol made of jewels was held over me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:4.4"], "en": "I maintained [the practice] for the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:5.1"], "en": "Knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:5.2"], "en": "the Great Sage Padumuttara—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:5.3"], "en": "Having set that aside,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:5.4"], "en": "he spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:6.1"], "en": "“He who carried the parasol— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:6.2"], "en": "Adorned with golden ornaments—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:6.3"], "en": "I shall describe him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:6.4"], "en": "listen as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:7.1", "PA_tha-ap_12:7.2"], "en": "Having gone from here, this person will dwell in Tusita;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:7.3"], "en": "he will experience prosperity.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:7.4"], "en": "Honored by celestial nymphs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:8.1", "PA_tha-ap_12:8.2"], "en": "he will exercise divine sovereignty thirty-four times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:8.3", "PA_tha-ap_12:8.4"], "en": "The Lord of Bala will dwell upon the earth for eight hundred years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:9.1"], "en": "and for fifty-eight times [more].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:9.2"], "en": "He will become a wheel-turning monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:9.3", "PA_tha-ap_12:9.4"], "en": "he will exercise extensive regional sovereignty over the earth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:10.1"], "en": "In a hundred thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:10.2"], "en": "one born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:10.3"], "en": "known by the family name Gotama, will appear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:10.4"], "en": "A Teacher shall arise in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:11.1", "PA_tha-ap_12:11.2"], "en": "He shall be the kinsman and relative of the Sakyan, the banner of the clan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:11.3"], "en": "Named Ānanda,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:11.4"], "en": "he was the attendant of the Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:12.1"], "en": "he was ardent and also wise.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:12.2"], "en": "Skilled in the truth of his own arms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:12.3"], "en": "humble in conduct and free from arrogance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:12.4"], "en": "he will become a master of all branches of learning.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:13.1"], "en": "With his mind intent on exertion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:13.2"], "en": "peaceful and free from acquisitions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:13.3"], "en": "having fully understood all taints—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:13.4"], "en": "He will attain Nibbāna, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:14.1"], "en": "There are forest-dwelling elephants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:14.2"], "en": "tuskers sixty years of age.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:14.3", "PA_tha-ap_12:14.4"], "en": "Elephants with tusks like plow-poles, of great stature, were broken into three parts;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:15.1"], "en": "many hundreds of thousands [of them].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:15.2"], "en": "Though they were wise and possessed of great psychic power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:15.3", "PA_tha-ap_12:15.4"], "en": "none of them were equal to this Naga of a Buddha in their aspiration.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:16.1"], "en": "I pay homage to the First,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:16.2"], "en": "to the Middle, and then to the Last;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:16.3"], "en": "with a serene heart and a joyful mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:16.4"], "en": "I attended upon the Best of Buddhas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:17.1"], "en": "ardent, wise,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:17.2"], "en": "clearly comprehending, and mindful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:17.3"], "en": "Having attained the fruit of stream-entry,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:17.4"], "en": "he was skilled in the stages of training.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:18.1"], "en": "A hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:18.2"], "en": "The karma that I brought forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:18.3"], "en": "I have now reached its ground;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:18.4"], "en": "I stand firm upon the unshakable True Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:19.1", "PA_tha-ap_12:19.2"], "en": "Welcome indeed has come to me in the presence of the Best of Buddhas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:19.3"], "en": "the three knowledges have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:19.4"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:20.1", "PA_tha-ap_12:20.2"], "en": "the four analytical knowledges and these eight liberations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:20.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:20.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:21.1"], "en": "Thus indeed did the venerable elder Ānanda speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:22.1"], "en": "The legend of the Elder Ānanda is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:23.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:24.1"], "en": "Buddha and Paccekabuddha...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:24.2"], "en": "Sāriputta and Kolita;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:24.3"], "en": "Kassapa and Anuruddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:24.4"], "en": "as well as the elder Puṇṇa and Upāli.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:25.1"], "en": "Aññāsikoṇḍañña, Piṇḍola,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:25.2"], "en": "Revata, and the wise Ānanda—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:25.3"], "en": "six hundred and fifty [monks].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:25.4"], "en": "All the verses combined.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_12:26.1"], "en": "In the *Apadāna*, this is the first chapter, the Buddha Chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
