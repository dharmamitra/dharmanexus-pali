[
{"segs": ["PA_thag_6.11:0.1", "PA_thag_6.11:0.2"], "en": "Theragāthā 6.11 Chakkanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:0.4"], "en": "The Verses of the Elder Nhātakamuni:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:1.1"], "en": "“Afflicted by a wind-disease,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:1.2"], "en": "you dwell in the forest grove;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:1.3"], "en": "“In this desolate place where food is discarded,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:1.4"], "en": "how will you fare, O bhikkhu?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:2.1"], "en": "“With abundant rapture and bliss,” he replied.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:2.2"], "en": "Having pervaded my entire body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:2.3"], "en": "though enduring even what is coarse,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:2.4"], "en": "I shall dwell in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:3.1"], "en": "Cultivating the seven factors of enlightenment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:3.2"], "en": "the faculties, and the powers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:3.3"], "en": "he is perfected in the subtlety of jhāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:3.4"], "en": "I shall dwell free from taints—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:4.1"], "en": "liberated from defilements,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:4.2"], "en": "with a pure mind, undisturbed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:4.3"], "en": "Constantly reflecting thus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:4.4"], "en": "I shall dwell free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:5.1"], "en": "both internally and externally.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:5.2"], "en": "Those taints that existed within me—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:5.3"], "en": "all have been eradicated without remainder,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:5.4"], "en": "and they shall not arise again.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:6.1"], "en": "The five aggregates are fully understood;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:6.2"], "en": "they stand with their roots cut off.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:6.3"], "en": "The destruction of suffering has been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:6.4"], "en": "“There is now no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.11:6.5"], "en": "… The Elder Nhātakamuni … [said].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
