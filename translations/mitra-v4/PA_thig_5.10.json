[
{"segs": ["PA_thig_5.10:0.1", "PA_thig_5.10:0.2"], "en": "Therīgāthā 5.10 Pañcakanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:0.3"], "en": "The Verses of the Elder Nun Paṭācārā", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:1.1"], "en": "Plowing the field with plows,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:1.2"], "en": "sowing seeds upon the ground,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:1.3"], "en": "and supporting wives and children—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:1.4"], "en": "Young men acquire wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:2.1", "PA_thig_5.10:2.2"], "en": "But what of me, who am endowed with virtue and carry out the Teacher’s instruction?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:2.3"], "en": "I do not attain Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:2.4"], "en": "being neither indolent nor restless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:3.1"], "en": "Having washed my feet, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:3.2"], "en": "We perform our ablutions in the waters;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:3.3"], "en": "and having seen the water for washing the feet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:3.4"], "en": "we see it has flowed down from the high ground to the low.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:4.1"], "en": "Then I concentrated my mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:4.2"], "en": "like a noble thoroughbred horse; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:4.3"], "en": "having taken up the island, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:4.4"], "en": "I entered the monastery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:4.5"], "en": "having looked about for a bed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:4.6"], "en": "I sat down upon a couch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:5.1"], "en": "Then, having taken the needle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:5.2"], "en": "I pulled out the wick,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:5.3"], "en": "like the extinguishing of a lamp.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:5.4"], "en": "“...there was liberation of the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.10:6.1"], "en": "...Thus spoke the elder nun Paṭācārā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"}
]
