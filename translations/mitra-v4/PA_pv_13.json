[
{"segs": ["PA_pv_13:0.1"], "en": "Petavatthu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:0.2"], "en": "Ubbarivagga 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:0.3"], "en": "Saṃsāramocakapetivatthu (The Story of the Ghost Who Liberated Beings from Saṃsāra)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:1.1"], "en": "“Naked, ill-favored in form,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:1.2"], "en": "emaciated, with veins showing all over;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:1.3"], "en": "you are haggard and thin.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:1.4"], "en": "“Who are you that stands here?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:2.1"], "en": "“Venerable sir, I am a peta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:2.2"], "en": "one gone to a miserable state in the world of Yama.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:2.3"], "en": "“Having committed evil deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:2.4"], "en": "they have gone from here to the world of the departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:3.1"], "en": "“What indeed [was done] by body or by speech?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:3.2"], "en": "An evil deed was committed with the mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:3.3", "PA_pv_13:3.4"], "en": "by the ripening of what karma have you gone from here to the world of the hungry ghosts?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:4.1"], "en": "“Venerable sir, there were none who had compassion for me—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:4.2"], "en": "neither my father, nor my mother, nor even my kinsmen—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:4.3"], "en": "who might have urged me, ‘Give this gift.’”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:4.4"], "en": "With a mind full of faith toward recluses and brahmins,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:5.1", "PA_pv_13:5.2"], "en": "it has been five hundred years since I have wandered about naked in such a manner as this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:5.3"], "en": "Devoured by hunger and thirst,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:5.4"], "en": "this is the fruit of my evil deed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:6.1"], "en": "With a mind full of faith, noble sir, I pay homage to you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:6.2"], "en": "\"Have compassion for me, O Hero of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:6.3"], "en": "having given me whatever you may have,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:6.4"], "en": "release me from the miserable states, O Blessed One.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:7.1", "PA_pv_13:7.2", "PA_pv_13:7.3"], "en": "Having replied, \"So be it,\" the compassionate Sāriputta gave a morsel of food to the bhikkhus.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:7.4"], "en": "A cloth as large as a hand,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:7.5"], "en": "and water in a bowl—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:7.6"], "en": "she dedicated this as a gift to her.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:8.1"], "en": "Immediately after it was recited,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:8.2"], "en": "the reward arose:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:8.3"], "en": "food, clothing, and drink.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:8.4"], "en": "This is the fruit of that offering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:9.1"], "en": "Thereafter, pure and dressed in clean garments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:9.2"], "en": "wearing the finest cloth from Kāsi;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:9.3"], "en": "Adorned with various garments and ornaments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:9.4"], "en": "she approached Sāriputta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:10.1"], "en": "\"With such exquisite beauty...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:10.2"], "en": "You who stand there, O deity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:10.3", "PA_pv_13:10.4"], "en": "illuminating all directions like a medicinal herb among the stars.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:11.1"], "en": "By what means do you have such a complexion?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:11.2"], "en": "By what means are you successful here?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:11.3"], "en": "And by what means do riches arise for you?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:11.4"], "en": "\"Whatever things are dear to the mind—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:12.1"], "en": "O goddess of great majesty, I ask you:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:12.2"], "en": "what merit did you perform when you were a human being?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:12.3"], "en": "“By what means have you come to possess such a blazing majesty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:12.4"], "en": "that your complexion shines in every direction?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:13.1"], "en": "“I am pale, emaciated, and famished.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:13.2"], "en": "Naked, with skin fallen away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:13.3", "PA_pv_13:13.4"], "en": "the compassionate Sage in the world saw me there, destitute.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:14.1"], "en": "Having given a morsel of food to the bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:14.2"], "en": "a cloth for wiping the hands,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:14.3"], "en": "and water for the bowl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:14.4"], "en": "He assigned me the right portion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:15.1"], "en": "Behold the fruit of even a morsel of alms:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:15.2"], "en": "for a hundred years and ten more, I have had my meals.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:15.3"], "en": "I eat as I desire,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:15.4"], "en": "with many kinds of sauces and condiments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:16.1"], "en": "on a mere palm-sized cloth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:16.2"], "en": "Behold the kind of karmic result that has come to pass:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:16.3", "PA_pv_13:16.4"], "en": "all the royal insignia found within the realm of King Nanda.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:17.1"], "en": "\"Even more numerous than those, Bhante,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:17.2"], "en": "are my garments for clothing—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:17.3"], "en": "silk and woolen cloths.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:17.4"], "en": "And [robes] made of fine cotton;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:18.1"], "en": "vast and of great value,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:18.2"], "en": "they hung there in the open sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:18.3", "PA_pv_13:18.4"], "en": "I burn with that which is dear to the mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:19.1"], "en": "it is like water in a shallow bowl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:19.2"], "en": "Behold the kind of karmic result that follows:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:19.3"], "en": "deep, four-cornered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:19.4"], "en": "and well-constructed lotus ponds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:20.1"], "en": "With water clear and well-established,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:20.2"], "en": "cool and free from foul odors,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:20.3"], "en": "it is covered with lotuses and water-lilies.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:20.4"], "en": "Filled with water and lotus filaments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:21.1"], "en": "I take delight there, I play,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:21.2"], "en": "and I rejoice, free from fear from any quarter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:21.3", "PA_pv_13:21.4"], "en": "“Venerable sir, we have come to pay homage to the Sage, the compassionate one in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_13:22.1"], "en": "The first story: The Peti Who Was Released from Saṃsāra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
