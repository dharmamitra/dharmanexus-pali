[
{"segs": ["PA_bu-vb_sk34:0.1"], "en": "The Theravāda Vinaya Mahāvibhaṅga:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:0.2", "PA_bu-vb_sk34:0.3"], "en": "The Section on the Training Rules (Sekhiyakaṇḍa)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:0.4"], "en": "Sakkaccavagga 34.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:0.5"], "en": "The Training Rule on Equal Soup:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.1"], "en": "At that time, the Buddha, the Blessed One, was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.2"], "en": "Now at that time, the group-of-six monks, while eating almsfood, ate a great deal of curry alone... [and so on] ...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.3.1"], "en": "\"The training is to be observed: 'I shall eat almsfood with an equal amount of curry.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.4.1"], "en": "What is called \"curry\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.5"], "en": "There are two kinds of soups:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.6"], "en": "mung bean soup and black gram soup that can be carried by hand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.7"], "en": "Almsfood containing equal amounts of soup may be eaten.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.8"], "en": "Whoever, out of disrespect, eats a great deal of soup alone, commits an offense of wrong-doing (dukkaṭa).", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.9.1", "PA_bu-vb_sk34:1.10"], "en": "There is no offense if it was unintentional.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.11"], "en": "For one who is absent-minded,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.12"], "en": "for one who is unaware,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.13"], "en": "for one who is ill,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.14"], "en": "Regarding flavors,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.15"], "en": "regarding relatives,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.16"], "en": "and regarding those who have invited one.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.17"], "en": "With one's own wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.18"], "en": "in times of distress,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.19"], "en": "for one who is insane.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.20"], "en": "\"For one who is a first offender\":", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk34:1.21"], "en": "thus ends the fourth training rule.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
