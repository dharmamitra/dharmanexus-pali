[
{"segs": ["PA_tha-ap_255:0.1", "PA_tha-ap_255:0.2", "PA_tha-ap_255:0.3"], "en": "The Apadāna of the Elder Citakapūjaka Thomakavagga 3.3 [The Elder] who worshipped the funeral pyre.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:1.1"], "en": "“The Fully Enlightened One named Ānanda,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:1.2"], "en": "the self-become, the unconquered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:1.3"], "en": "attained final Nibbāna in the forest.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:1.4"], "en": "In a forest inhabited by non-human beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:2.1"], "en": "having come here from the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:2.2"], "en": "I then made a funeral pyre.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:2.3", "PA_tha-ap_255:2.4"], "en": "There I cremated his body and performed the funeral honors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:3.1"], "en": "Ninety-one eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:3.2"], "en": "Whatever deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:3.4"], "en": "this is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:4.1", "PA_tha-ap_255:4.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:5.1"], "en": "Thus indeed the venerable elder Citakapūjaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_255:6.1"], "en": "This is the third legend (Apadāna) of the elder Citakapūjaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
