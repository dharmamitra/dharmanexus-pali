[
{"segs": ["PA_thag_7.2:0.1", "PA_thag_7.2:0.2", "PA_thag_7.2:0.3"], "en": "Theragāthā 7.2 Sattaka-nipāta Paṭhama-vagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:0.4"], "en": "The Verses of the Elder Lakuṇḍaka Bhaddiya:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:1.1"], "en": "“In the Ambāṭaka Grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:1.2"], "en": "Bhaddiya was in a thicket of trees;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:1.3"], "en": "Having uprooted craving along with its root,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:1.4"], "en": "Bhadda meditates there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:2.1"], "en": "Some take delight in drums;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:2.2"], "en": "With lutes and drums; yet I,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:2.3"], "en": "delighting at the foot of a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:2.4"], "en": "rejoice in the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:3.1"], "en": "If the Buddha would grant me a boon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:3.2"], "en": "and if that boon could be obtained by me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:3.3"], "en": "I would choose this for the entire world:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:3.4"], "en": "Maintaining constant mindfulness directed toward the body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:4.1"], "en": "Those who have perceived me by means of my form,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:4.2"], "en": "and those who have followed after me by means of my voice;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:4.3"], "en": "Possessed by lust and passion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:4.4"], "en": "those people do not know me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:5.1"], "en": "nor do they know their own inner self.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:5.2"], "en": "And he does not see what is outside;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:5.3"], "en": "the fool, obstructed on all sides,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:5.4"], "en": "is indeed carried away by sound.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:6.1"], "en": "One does not know within,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:6.2"], "en": "yet one sees externally;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:6.3"], "en": "seeing the fruit externally—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:6.4"], "en": "He too is carried away by that sound.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:7.1", "PA_thag_7.2:7.2"], "en": "He understands within and he sees clearly without.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:7.3"], "en": "“Seeing without obstruction,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:7.4"], "en": "he is not carried away by mere sound.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.2:7.5"], "en": "… Thus spoke the Elder Lakuṇḍaka Bhaddiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
