[
{"segs": ["PA_thi-ap_28:0.1"], "en": "The Therī-Apadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:0.2"], "en": "The Chapter on Kuṇḍalakesī, No. 8:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:0.3"], "en": "The Apadāna of the Elder Nun Yasodharā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:1.1", "PA_thi-ap_28:1.2"], "en": "At one time, in the delightful and prosperous city of Rājagaha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:1.3"], "en": "in a certain excellent mountain cave,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:1.4"], "en": "In the spring, with the Leader of Men as its lord,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:2.1"], "en": "in that delightful city of Vāsantī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:2.2"], "en": "within the pleasant dwelling for bhikkhunīs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:2.3"], "en": "To the bhikkhunī Yasodharā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:2.4"], "en": "such a thought occurred:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:3.1"], "en": "\"The great king Suddhodana...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:3.2"], "en": "And Gotamī Pajāpatī;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:3.3", "PA_thi-ap_28:3.4"], "en": "renowned great elders and elder nuns of great psychic power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:4.1"], "en": "They had indeed attained peace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:4.2"], "en": "like lamps without fuel,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:4.3"], "en": "while the Lord of the World was still remaining.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:4.4", "PA_thi-ap_28:5.1", "PA_thi-ap_28:5.2"], "en": "Having thought, \"I too shall go to the auspicious state,\" she looked upon her own life-span.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:5.3", "PA_thi-ap_28:5.4"], "en": "Having passed away, the life-constituent reached its end on that very day.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:6.1"], "en": "Taking his bowl and robe, he departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:6.2"], "en": "Having departed from her own home,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:6.3", "PA_thi-ap_28:6.4"], "en": "she was preceded by hundreds and thousands of bhikkhunīs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:7.1"], "en": "Possessing great psychic power and great wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:7.2"], "en": "she approached the Fully Enlightened One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:7.3"], "en": "having paid homage to the Fully Enlightened One, she—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:7.4", "PA_thi-ap_28:7.5"], "en": "Seated to one side near the Teacher’s wheel-marked foot,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:7.6"], "en": "she spoke these words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:8.1"], "en": "“I am seventy-eight years old;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:8.2"], "en": "my final age is passing away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:8.3"], "en": "I have reached this mountain cave.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:8.4"], "en": "I announce it, O Great Sage:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:9.1"], "en": "my age is ripe,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:9.2"], "en": "my life is short.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:9.3"], "en": "Having abandoned you, I shall go;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:9.4"], "en": "I have made a refuge for myself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:10.1"], "en": "It is now the final period of my life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:10.2"], "en": "Death is obstructed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:10.3"], "en": "this very night, O Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:10.4"], "en": "I shall attain Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:11.1"], "en": "There is no birth, aging, sickness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:11.2"], "en": "or death for you, O Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:11.3"], "en": "you have reached the city free from aging and death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:11.4"], "en": "I shall go to the unconditioned.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:12.1", "PA_thi-ap_28:12.2"], "en": "As far as there is any assembly whatsoever that gathers around a Teacher, [there I shall go].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:12.3"], "en": "Unaware of my transgression,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:12.4"], "en": "I asked for forgiveness in the presence of the Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:13.1"], "en": "yet, having wandered through the cycle of existence, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:13.2"], "en": "If I have stumbled in relation to you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:13.3"], "en": "I confess it, O Great Hero;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:13.4"], "en": "forgive my transgression.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:14.1"], "en": "Having heard her words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:14.2"], "en": "the Lord of Sages spoke thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:14.3"], "en": "“What further shall I say to you?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:14.4"], "en": "As she was proceeding toward Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:15.1"], "en": "show your supernatural power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:15.2"], "en": "O fulfiller of my instruction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:15.3"], "en": "\"And for all the assemblies,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:15.4"], "en": "cut through whatever doubt there may be.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:16.1"], "en": "Having heard those words of the Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:16.2"], "en": "That nun was Yasodharā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:16.3"], "en": "having paid homage to that King of Sages,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:16.4"], "en": "she spoke these words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:17.1"], "en": "“I am Yasodharā, O Hero;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:17.2"], "en": "in the home, I was your wife,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:17.3"], "en": "born into the Śākya clan.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:17.4", "PA_thi-ap_28:18.1"], "en": "Established upon the limbs of women—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:18.2"], "en": "ninety-six million women in all.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:18.3"], "en": "In my home, O Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:18.4"], "en": "I am the foremost and the sovereign over all;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:19.1"], "en": "I am endowed with beauty, conduct, and virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:19.2"], "en": "Though they were young and spoke sweetly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:19.3", "PA_thi-ap_28:19.4"], "en": "all those humans honored me as if I were a deity.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:20.1", "PA_thi-ap_28:20.2"], "en": "Headed by hundreds of thousands of maidens in the dwelling of the Son of the Sakyas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:20.3"], "en": "they shared equally in joy and sorrow.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:20.4"], "en": "Like a deity in the Nandana grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:21.1"], "en": "having transcended the realm of sense-desire,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:21.2"], "en": "he is established in the realm of form.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:21.3"], "en": "“There is no one equal in beauty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:21.4"], "en": "except for the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:22.1"], "en": "Having paid homage to the Perfectly Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:22.2"], "en": "He displayed psychic power to the Teacher;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:22.3", "PA_thi-ap_28:22.4"], "en": "he manifested many great psychic powers of various kinds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:23.1"], "en": "Make the body equal to the world-system,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:23.2"], "en": "place the head to the north,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:23.3"], "en": "and let both wings be the two continents.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:23.4"], "en": "From his body [he created] Jambudīpa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:24.1"], "en": "and from his right side, a lake with its feathers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:24.2"], "en": "various branches, and leaves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:24.3"], "en": "The moon and the sun as his eyes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:24.4"], "en": "the peak of Mount Meru as his crest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:25.1"], "en": "and the Cakkavāḷa mountain as his beak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:25.2"], "en": "Having approached the rose-apple tree together with its roots,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:25.3", "PA_thi-ap_28:25.4"], "en": "they fanned it while paying homage to the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:26.1"], "en": "Likewise the form of an elephant, a horse,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:26.2"], "en": "a mountain, and the ocean;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:26.3"], "en": "the moon, the sun, and Mount Meru.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:26.4"], "en": "And he manifested the form of Sakyamuni:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:27.1"], "en": "\"I am Yasodharā, O Hero;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:27.2"], "en": "I bow at your feet, O Visionary One.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:27.3", "PA_thi-ap_28:27.4"], "en": "He covered a thousand world-systems with a full-blown lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:28.1"], "en": "and having assumed the form of Brahmā, he manifested his splendor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:28.2"], "en": "He taught the Dhamma of emptiness:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:28.3"], "en": "“I am Yasodharā, O Hero;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:28.4"], "en": "I bow at your feet, O Visionary One.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:29.1"], "en": "I am a master of the supernormal powers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:29.2"], "en": "of the divine ear-element,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:29.3"], "en": "and of the knowledge of others' minds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:29.4"], "en": "I am a master, a great sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:30.1"], "en": "I know my former births,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:30.2"], "en": "and the divine eye has been purified.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:30.3"], "en": "All taints are utterly destroyed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:30.4"], "en": "there is now no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:31.1"], "en": "Regarding the meanings, the phenomena, and the linguistic expressions—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:31.2"], "en": "And likewise in inspired eloquence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:31.3", "PA_thi-ap_28:31.4"], "en": "O Great Hero, knowledge has arisen in me in your presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:32.1", "PA_thi-ap_28:32.2"], "en": "The meeting with the former Protectors of the World has been shown to you;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:32.3"], "en": "my own service was great.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:32.4"], "en": "For your sake, O Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:33.1"], "en": "Whatever wholesome karma has been fulfilled by me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:33.2"], "en": "O Sage, may it bear fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:33.3"], "en": "For your sake, O Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:33.4"], "en": "merit has been accumulated by me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:34.1"], "en": "having avoided what is unproductive.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:34.2"], "en": "Having restrained this improper conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:34.3", "PA_thi-ap_28:34.4"], "en": "O Great Hero, I have surrendered my very life for your sake.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:35.1", "PA_thi-ap_28:35.2"], "en": "Many thousands of crores of women were given to me for the sake of being my wives;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:35.3"], "en": "yet I was not disheartened by that.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:35.4"], "en": "For your sake, O Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:36.1", "PA_thi-ap_28:36.2"], "en": "she gave me thousands of millions of attendants for my service.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:36.3"], "en": "I am not despondent there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:36.4"], "en": "O Great Sage, for your sake;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:37.1"], "en": "thousands of many millions [of beings].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:37.2"], "en": "She gave me for the sake of food;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:37.3"], "en": "I was not distressed thereby,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:37.4"], "en": "O Great Sage, for it was for your sake.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:38.1", "PA_thi-ap_28:38.2"], "en": "I sacrificed thousands of millions of lives;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:38.3"], "en": "they shall grant me liberation from fear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:38.4"], "en": "I give my very life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:39.1"], "en": "I give the ornaments on my limbs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:39.2"], "en": "and many various kinds of garments.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:39.3"], "en": "I do not hide it within this circle of women,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:39.4"], "en": "O Great Sage; for your sake,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:40.1"], "en": "I shall renounce my wealth and grain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:40.2"], "en": "Villages and towns,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:40.3", "PA_thi-ap_28:40.4"], "en": "fields, sons, and daughters— these were all renounced by the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:41.1"], "en": "Elephants, horses, and cows,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:41.2"], "en": "as well as female slaves and attendants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:41.3"], "en": "are for your sake, O Great Hero.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:41.4"], "en": "Countless [beings] were abandoned by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:42.1"], "en": "When he addressed me, I said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:42.2"], "en": "\"I shall give gifts to those who ask.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:42.3", "PA_thi-ap_28:42.4"], "en": "I do not see any misfortune for me as I give this supreme gift; [rather,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:43.1"], "en": "there will be] much suffering of various kinds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:43.2"], "en": "And throughout the manifold cycle of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:43.3", "PA_thi-ap_28:43.4"], "en": "O Great Hero, you have experienced for your sake that which is incalculable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:44.1"], "en": "I rejoice in those who have attained happiness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:44.2"], "en": "and I am not dejected among those in suffering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:44.3"], "en": "I remain equanimous in all circumstances.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:44.4"], "en": "For your sake, O Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:45.1", "PA_thi-ap_28:45.2"], "en": "the Sambuddha brought forth that Dhamma by following the path of logic.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:45.3"], "en": "Having experienced both pleasure and pain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:45.4"], "en": "the Great Sage attained enlightenment;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:46.1"], "en": "so too did the Sambuddha Brahmadeva.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:46.2"], "en": "To Gotama, the Leader of the World;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:46.3", "PA_thi-ap_28:46.4"], "en": "I have had many encounters with other protectors of the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:47.1", "PA_thi-ap_28:47.2"], "en": "I have made great effort for your sake, O Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:47.3"], "en": "while seeking the Buddha’s Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:47.4", "PA_thi-ap_28:48.1", "PA_thi-ap_28:48.2"], "en": "I was your attendant for one hundred thousand aeons and four incalculable aeons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:48.3"], "en": "The Great Hero Dīpaṅkara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:48.4"], "en": "the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:49.1"], "en": "arose in a border region.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:49.2"], "en": "Having invited the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:49.3", "PA_thi-ap_28:49.4"], "en": "they cleared the path for his arrival with joyful minds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:50.1"], "en": "At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:50.2", "PA_thi-ap_28:50.3"], "en": "there was a brahmin named Sumedha who prepared the path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:50.4"], "en": "Long ago, when the All-Seeing One appeared,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:51.1", "PA_thi-ap_28:51.2"], "en": "at that time I was a maiden born of a brahmin family.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:51.3", "PA_thi-ap_28:51.4"], "en": "One named Sumittā by name approached me for an encounter;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:52.1"], "en": "she carried eight handfuls of blue lotuses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:52.2"], "en": "For the purpose of worshipping the Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:52.3", "PA_thi-ap_28:52.4"], "en": "I took it amidst the crowd of people and saw the exalted seer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:53.1"], "en": "Having seen my beloved, who had long followed me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:53.2"], "en": "now passed away and gone beyond, captivating to the mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:53.3"], "en": "I would then have thought:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:53.4"], "en": "My life has become fruitful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:54.1", "PA_thi-ap_28:54.2"], "en": "I then beheld that supreme exertion of the Seer, which was likewise fruitful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:54.3", "PA_thi-ap_28:54.4"], "en": "Through my past karma, my mind gained confidence in the Fully Awakened One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:55.1"], "en": "I made my mind even more confident.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:55.2"], "en": "O Sage of exalted mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:55.3"], "en": "I see nothing else that should be given;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:55.4"], "en": "I offer these flowers to you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:56.1"], "en": "‘Let there be five cubits for you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:56.2"], "en": "and let there be three for me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:56.3"], "en": "O Lord; by that they shall be equal.’", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:56.4"], "en": "\"O Sage, [this is] for the sake of your awakening.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:57.1"], "en": "This was the fourth recitation section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:58.1"], "en": "The Sage, having taken the flowers, [proceeded].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:58.2"], "en": "As the one of great fame was approaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:58.3", "PA_thi-ap_28:58.4"], "en": "the people in the midst of the assembly honored the great seer for the sake of enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:59.1"], "en": "Having passed through the midst of the crowd,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:59.2"], "en": "the Great Sage Dīpaṅkara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:59.3"], "en": "the Great Hero, made this prophecy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:59.4"], "en": "With a mind like a polished gem.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:60.1"], "en": "In an immeasurable eon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:60.2"], "en": "the Great Sage Dīpaṅkara appeared.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:60.3", "PA_thi-ap_28:60.4"], "en": "The Great Sage explained my karma and my state of rectitude:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:61.1"], "en": "“Those with even minds and even deeds, [attain even results].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:61.2"], "en": "She will be one who acts with equanimity;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:61.3", "PA_thi-ap_28:61.4"], "en": "through her karma, O great seer, she will become dear to you for your sake.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:62.1"], "en": "Sudassanā, Supiyā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:62.2"], "en": "Manāpā, and Piyavādinī—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:62.3"], "en": "these were his heirs in the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:62.4"], "en": "He will dwell with psychic power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:63.1", "PA_thi-ap_28:63.2"], "en": "just as one protects a casket of goods for its owner.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:63.3"], "en": "In this way, he will guard wholesome states;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:63.4", "PA_thi-ap_28:64.1"], "en": "out of compassion for him, they [will protect him].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:64.2"], "en": "He will fulfill the perfections;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:64.3"], "en": "like a lion breaking through its cage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:64.4"], "en": "he will attain enlightenment.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:65.1"], "en": "In an immeasurable eon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:65.2"], "en": "the Buddha made this prediction of me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:65.3"], "en": "rejoicing in those words, I say:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:65.4"], "en": "\"I shall act in this way.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:66.1", "PA_thi-ap_28:66.2"], "en": "I gladdened my heart toward that well-performed deed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:66.3", "PA_thi-ap_28:66.4"], "en": "Having experienced an incalculable number of births among gods and humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:67.1"], "en": "and having experienced both pleasure and pain, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:67.2"], "en": "Among gods and among humans;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:67.3"], "en": "when my final existence was reached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:67.4"], "en": "I was born into the Sakyan clan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:68.1"], "en": "Possessing beauty, possessing wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:68.2"], "en": "and thereafter possessing fame and virtue;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:68.3"], "en": "may I be endowed with excellence in every limb.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:68.4"], "en": "Highly honored among families,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:69.1"], "en": "they encounter gain, fame, honor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:69.2"], "en": "and the convergence of worldly conditions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:69.3"], "en": "My mind is not afflicted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:69.4"], "en": "I dwell without fear from any quarter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:70.1"], "en": "For this was said by the Blessed One:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:70.2", "PA_thi-ap_28:70.3"], "en": "“O Hero, at that time in the king’s inner palace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:70.4"], "en": "you pointed out a benefactor among the kṣatriyas in the city.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:71.1"], "en": "The woman who is helpful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:71.2"], "en": "the woman who shares in both joy and sorrow,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:71.3"], "en": "and the woman who speaks what is beneficial—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:71.4"], "en": "And she who is compassionate toward women—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:72.1", "PA_thi-ap_28:72.2"], "en": "five hundred million Buddhas and nine hundred million [more].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:72.3"], "en": "For these gods of gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:72.4", "PA_thi-ap_28:73.1"], "en": "I performed a great act of giving; my merit was indeed vast.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:73.2"], "en": "O King of Dharma, listen to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:73.3", "PA_thi-ap_28:73.4"], "en": "there were one billion one hundred million and twelve million Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:74.1", "PA_thi-ap_28:74.2"], "en": "I performed a great offering for these gods of gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:74.3"], "en": "my merit was indeed vast.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:74.4"], "en": "O Dhamma King, listen to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:75.1", "PA_thi-ap_28:75.2"], "en": "there were twenty billion Buddhas and thirty billion as well.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:75.3", "PA_thi-ap_28:75.4"], "en": "I performed a great act of merit for these gods of gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:76.1"], "en": "it was a vast service rendered by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:76.2"], "en": "O King of Dharma, listen to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:76.3", "PA_thi-ap_28:76.4"], "en": "there were four hundred and fifty million [beings].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:77.1", "PA_thi-ap_28:77.2"], "en": "I performed a great offering for these gods of gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:77.3"], "en": "my merit was indeed vast.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:77.4"], "en": "O King of Dharma, listen to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:78.1", "PA_thi-ap_28:78.2"], "en": "there were six billion and seven hundred million Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:78.3"], "en": "For these gods among gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:78.4"], "en": "I performed a great act of giving;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:79.1"], "en": "it was a great service rendered by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:79.2"], "en": "O King of Dharma, listen to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:79.3", "PA_thi-ap_28:79.4"], "en": "there were eight hundred crores of Buddhas and nine hundred crores as well.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:80.1", "PA_thi-ap_28:80.2"], "en": "I performed a great offering for these gods of gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:80.3"], "en": "my merit was indeed vast.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:80.4"], "en": "O Dhamma King, listen to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:81.1", "PA_thi-ap_28:81.2"], "en": "there have been hundreds of thousands of millions of leaders of the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:81.3"], "en": "For these gods among gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:81.4"], "en": "I performed a great offering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:82.1"], "en": "my merit was indeed vast.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:82.2"], "en": "O King of Dharma, listen to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:82.3", "PA_thi-ap_28:82.4"], "en": "there were nine thousand times ten million other leaders of the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:83.1"], "en": "For these gods of gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:83.2"], "en": "I performed a great offering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:83.3"], "en": "my merit was indeed vast.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:83.4"], "en": "O King of Dharma, listen to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:84.1", "PA_thi-ap_28:84.2"], "en": "there were one hundred and eighty-five million great seers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:84.3", "PA_thi-ap_28:84.4"], "en": "Five hundred and eighty-five million, and thirty-seven million—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:85.1"], "en": "of these gods among gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:85.2"], "en": "I performed a great act of giving;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:85.3", "PA_thi-ap_28:85.4"], "en": "O King of Dharma, hear from me of this great service I have rendered.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:86.1"], "en": "The Paccekabuddhas, free from passion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:86.2"], "en": "numbering eight times ten million;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:86.3"], "en": "they have performed a great service for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:86.4"], "en": "O King of Dharma, listen to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:87.1", "PA_thi-ap_28:87.2"], "en": "the disciples of the Buddha, whose taints are exhausted and who are free from defilement, are beyond counting.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:87.3"], "en": "I have great authority;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:87.4"], "en": "O King of Dharma, listen to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:88.1"], "en": "Thus it is for those who have practiced the Dharma well.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:88.2"], "en": "For one who always practices the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:88.3", "PA_thi-ap_28:88.4"], "en": "the practitioner of Dhamma dwells in happiness in this world and in the world beyond.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:89.1"], "en": "One should practice the Dhamma with good conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:89.2"], "en": "and not practice misconduct;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:89.3"], "en": "one who lives by the Dhamma sleeps in happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:89.4"], "en": "In this world and in the next.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:90.1"], "en": "Having become disenchanted with saṃsāra,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:90.2"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:90.3", "PA_thi-ap_28:90.4"], "en": "Having gone forth with a retinue of a thousand, possessing nothing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:91.1"], "en": "they abandoned the household life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:91.2"], "en": "I went forth into the homeless life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:91.3"], "en": "before half a month had passed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:91.4"], "en": "I attained the Four Noble Truths.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:92.1", "PA_thi-ap_28:92.2", "PA_thi-ap_28:92.3"], "en": "Many people bring forth robes, almsfood, requisites, and lodgings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:92.4"], "en": "Like waves in the ocean,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:93.1", "PA_thi-ap_28:93.2"], "en": "my defilements have been consumed by fire... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:93.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:94.1", "PA_thi-ap_28:94.2"], "en": "Welcome indeed has come to me... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:94.3"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:95.1", "PA_thi-ap_28:95.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:95.3"], "en": "Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:96.1"], "en": "Thus is suffering manifold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:96.2"], "en": "and prosperity is likewise manifold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:96.3"], "en": "Having attained the state of purity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:96.4"], "en": "I obtain all perfections;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:97.1"], "en": "she who gives away her own self—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:97.2"], "en": "For the sake of merit, for the Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:97.3", "PA_thi-ap_28:97.4"], "en": "they possess the excellence of companionship leading to the unconditioned state of Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:98.1"], "en": "The past is completely exhausted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:98.2"], "en": "as are the present and the future;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:98.3"], "en": "all my karma is extinguished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:98.4"], "en": "“I worship at the feet of the One with Vision.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:99.1"], "en": "Thus indeed did the bhikkhunī Yasodharā recite these verses in the presence of the Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_28:100.1"], "en": "This is the eighth *apadāna* of the Elder Nun Yasodharā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
