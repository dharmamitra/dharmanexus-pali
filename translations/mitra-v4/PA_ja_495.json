[
{"segs": ["PA_ja_495:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:0.2"], "en": "Miscellaneous Section,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:0.3"], "en": "Chapter on the Rice Field of Śālī Rice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:0.4"], "en": "12. The Jātaka of the Ten Brāhmaṇas:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:1.1", "PA_ja_495:1.2"], "en": "King Yudhiṭṭhila, who desired the Dhamma, spoke to Vidhūra.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:1.3"], "en": "“Seek out a brahmin who is wise,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:1.4"], "en": "virtuous, and learned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:2.1"], "en": "who has abstained from sexual intercourse.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:2.2"], "en": "“Whoever should eat my food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:2.3"], "en": "we will give them a gift properly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:2.4"], "en": "wherein what is given bears great fruit.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:3.1", "PA_ja_495:3.2"], "en": "“Brahmins who are virtuous and learned, O King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:3.3"], "en": "who have abstained from sexual intercourse, are rare to find.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:3.4"], "en": "Whoever should eat that food.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:4.1"], "en": "Indeed, O Great King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:4.2"], "en": "there are ten such brahmin castes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:4.3", "PA_ja_495:4.4"], "en": "Listen to me as I explain their analysis and investigation in detail:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:5.1"], "en": "having taken up their bags...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:5.2"], "en": "When Puṇṇa is restrained at the root,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:5.3", "PA_ja_495:5.4"], "en": "they tie together medicinal herbs, bathe him, and recite prayers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:6.1", "PA_ja_495:6.2"], "en": "O King, those who are like physicians are also called brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:6.3"], "en": "they have been described to you, O Great King.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:6.4"], "en": "“Let us fall upon such [a person].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:7.1", "PA_ja_495:7.2"], "en": "“They have departed from the state of a Brahmin,” [said King Koravya].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:7.3"], "en": "They are not called brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:7.4"], "en": "seek others, Vidhura,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:7.5"], "en": "who are virtuous and learned.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:8.1"], "en": "Abstaining from sexual intercourse,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:8.2"], "en": "those who would eat my food—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:8.3"], "en": "may we properly give them the offering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:8.4"], "en": "“Where a gift yields great fruit?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:9.1"], "en": "“Taking up small bells,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:9.2"], "en": "they proclaim it even from the front of them.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:9.3", "PA_ja_495:9.4"], "en": "They even go on errands and train in the maneuvers of chariots,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:10.1"], "en": "O King, acting as attendants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:10.2"], "en": "They too are called brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:10.3"], "en": "they have been declared such, O Great King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:10.4"], "en": "and we bow down before those like them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:11.1"], "en": "“Those who have abandoned the qualities of a brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:11.2"], "en": "O King Koraavya—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:11.3"], "en": "they are not called brahmins.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:11.4"], "en": "Seek others who are steadfast,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:11.5"], "en": "virtuous, and learned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:12.1"], "en": "who have abstained from sexual intercourse.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:12.2"], "en": "\"Whoever might eat my food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:12.3"], "en": "we shall give them a gift properly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:12.4"], "en": "wherein what is given yields great fruit.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:13.1", "PA_ja_495:13.2"], "en": "“Having taken up their water-pots and crooked staffs, O brahmins,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:13.3"], "en": "kings will approach [you].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:13.4"], "en": "In villages and in market towns,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:13.5"], "en": "we shall not rise until what has not been given has been bestowed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:13.6"], "en": "whether in a village or in a forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:14.1", "PA_ja_495:14.2"], "en": "O King, those who are equal to chastisers are also called brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:14.3"], "en": "they have been described to you, O Great King.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:14.4"], "en": "“Let us fall upon such [a person]!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:15.1", "PA_ja_495:15.2"], "en": "“They have departed from the state of a Brahmin,” [said King Koravya].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:15.3"], "en": "They are not called brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:15.4"], "en": "seek others, Vidhura,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:15.5"], "en": "who are virtuous and well-learned.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:16.1"], "en": "Abstaining from sexual intercourse,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:16.2"], "en": "those who would partake of my food—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:16.3"], "en": "we shall properly give them the offering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:16.4"], "en": "“Where a gift yields great fruit?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:17.1"], "en": "“With long hair in the armpits and on the body,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:17.2"], "en": "with dirt-caked teeth and hair as grey as dust;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:17.3"], "en": "Covered with dust and dirt,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:17.4"], "en": "those beggars wander about;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:18.1"], "en": "they are like mere stumps, O King.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:18.2"], "en": "They too are called brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:18.3"], "en": "they have been described to you, O Great King—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:18.4"], "en": "such as these we prostrate ourselves before.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:19.1"], "en": "“Those who have abandoned the qualities of a brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:19.2"], "en": "O King Kauravya—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:19.3"], "en": "such as these are not called brahmins.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:19.4"], "en": "Seek others who are steadfast,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:19.5"], "en": "virtuous, and learned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:20.1"], "en": "who have abstained from sexual intercourse.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:20.2"], "en": "\"Whoever should eat my food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:20.3"], "en": "we shall give them a gift properly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:20.4"], "en": "wherein what is given bears great fruit.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:21.1", "PA_ja_495:21.2"], "en": "“Harītakī, āmalaka, mango, rose-apple, and vibhītaka;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:21.3"], "en": "labuja fruit and tooth-sticks— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:21.4"], "en": "Beluva and badara fruits;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:22.1"], "en": "the Rājāyatana tree, the sugarcane basket,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:22.2"], "en": "the smoking tube, and honey ointment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:22.3"], "en": "They trade in various goods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:22.4"], "en": "both high and low, O lord of men;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:23.1"], "en": "they are like merchants, O King.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:23.2"], "en": "They too are called brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:23.3"], "en": "they have been described to you, O Great King—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:23.4"], "en": "such as these we prostrate ourselves.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:24.1"], "en": "“Those who have abandoned the qualities of a brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:24.2"], "en": "O King Koravya—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:24.3"], "en": "they are not called brahmins.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:24.4"], "en": "Seek others who are steadfast,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:24.5"], "en": "virtuous, and learned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:25.1"], "en": "who have abstained from sexual intercourse.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:25.2"], "en": "\"Whoever would eat my food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:25.3", "PA_ja_495:25.4"], "en": "we shall properly give them a gift where what is given bears great fruit.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:26.1"], "en": "“They practice agriculture and trade,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:26.2"], "en": "they raise goats and sheep,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:26.3"], "en": "and they give away their daughters.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:26.4"], "en": "They perform marriages with them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:27.1"], "en": "Being equal to Ambaṭṭhas and Vessas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:27.2"], "en": "they too are called brahmins.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:27.3"], "en": "“O Great King, you have been declared [to us];", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:27.4"], "en": "we prostrate ourselves before such as you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:28.1"], "en": "“And those who have departed from the state of a Brahmin—”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:28.2"], "en": "(Thus spoke King Kauravya:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:28.3"], "en": "\"They are not called brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:28.4"], "en": "seek others, Vidhura.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:28.5"], "en": "To those who are virtuous and learned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:29.1"], "en": "who abstain from sexual intercourse—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:29.2"], "en": "may they partake of my food.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:29.3", "PA_ja_495:29.4"], "en": "“We shall give a gift properly, wherein what is given bears great fruit. [They replied:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:30.1"], "en": "“They eat alms that have been set aside;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:30.2", "PA_ja_495:30.3", "PA_ja_495:30.4"], "en": "In some villages there are priests who are frequently questioned by those who castrate and brand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:31.1"], "en": "There cattle are slaughtered—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:31.2"], "en": "buffaloes, pigs, and goats—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:31.3"], "en": "just like cow-slaughterers, O King.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:31.4"], "en": "They too are called brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:31.5"], "en": "they have been declared such by you, O Great King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:31.6"], "en": "and we bow down before those like them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:32.1"], "en": "“Those who have abandoned the qualities of a brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:32.2"], "en": "O King Kauravya—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:32.3"], "en": "such as these are not called brahmins.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:32.4"], "en": "Seek others who are steadfast,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:32.5"], "en": "virtuous, and learned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:33.1"], "en": "who have abstained from sexual intercourse.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:33.2"], "en": "\"Whoever would eat my food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:33.3"], "en": "we shall give them a gift properly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:33.4"], "en": "wherein what is given bears great fruit.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:34.1"], "en": "“Taking up shields and grasping swords,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:34.2", "PA_ja_495:34.3"], "en": "the brahmins stand at the crossroads of the merchants.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:34.4"], "en": "They even brandish weapons;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:35.1"], "en": "though they are equal to cowherds and hunters,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:35.2"], "en": "they too are called brahmins.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:35.3"], "en": "“O Great King, you have been declared [to us];", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:35.4"], "en": "we bow down before such as you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:36.1"], "en": "“And those who have departed from the state of a Brahmin...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:36.2"], "en": "(Thus spoke King Koravya:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:36.3"], "en": "\"They are not called brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:36.4"], "en": "seek others, Vidhura.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:36.5"], "en": "To those who are virtuous and learned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:37.1"], "en": "who abstain from sexual intercourse—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:37.2"], "en": "may they partake of my food.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:37.3"], "en": "“We shall give a gift properly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:37.4"], "en": "where what is given bears great fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:38.1"], "en": "Having built a small hut in the forest, they said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:38.2"], "en": "They cause traps to be set;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:38.3"], "en": "they harass the sasabiḷāra deer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:38.4"], "en": "as well as the āgodhā antelope, the fish, and the tortoise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:39.1", "PA_ja_495:39.2"], "en": "O King, those who are equal to hunters are also called brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:39.3"], "en": "they have been described to you, O Great King.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:39.4"], "en": "“Let us fall upon such a one.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:40.1", "PA_ja_495:40.2"], "en": "“They have departed from the state of a Brahmin,” [said King Koravya].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:40.3"], "en": "They are not called brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:40.4"], "en": "seek others, Vidhura,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:40.5"], "en": "who are virtuous and learned.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:41.1"], "en": "Abstaining from sexual intercourse,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:41.2"], "en": "those who would partake of my food— O Noble One,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:41.3"], "en": "we shall give you the offering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:41.4"], "en": "\"Where a gift yields great fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:42.1"], "en": "\"Others indeed desire wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:42.2"], "en": "for they have crawled beneath the bedstead;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:42.3", "PA_ja_495:42.4"], "en": "Kings bathe themselves with perfumes when the Soma sacrifice has been prepared;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:43.1"], "en": "O King, they are like mere dregs and filth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:43.2", "PA_ja_495:43.3"], "en": "\"Brahmins are called 'the banks,' O Great King; they have been explained to you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:43.4"], "en": "and we bow down before such as those.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:44.1"], "en": "“Those who have abandoned the qualities of a brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:44.2"], "en": "O Koravya king—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:44.3"], "en": "such as these are not called brahmins.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:44.4"], "en": "Seek others who are steadfast,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:44.5"], "en": "virtuous, and learned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:45.1"], "en": "who have abstained from sexual intercourse.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:45.2"], "en": "“Whoever would eat my food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:45.3", "PA_ja_495:45.4"], "en": "we shall properly give them a gift where what is given bears great fruit.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:46.1"], "en": "“There are indeed, O Brahmins,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:46.2"], "en": "those who are virtuous and learned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:46.3"], "en": "they abstain from sexual intercourse.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:46.4"], "en": "Those who would eat your food—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:47.1", "PA_ja_495:47.2"], "en": "those who eat but one meal a day and do not drink intoxicants;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:47.3"], "en": "“O Great King, they have been described to you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:47.4"], "en": "we shall prostrate ourselves before such as them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:48.1"], "en": "“These, indeed, O Vidhura, are the brahmins...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:48.2"], "en": "\"Those who are virtuous and learned—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:48.3"], "en": "seek them out, Vidhura,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:48.4"], "en": "and invite them quickly.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_495:49.1"], "en": "The Tenth Birth Story of the Ten Brāhmaṇas, Number Twelve.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
