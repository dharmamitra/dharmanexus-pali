[
{"segs": ["PA_thag_6.5:0.1", "PA_thag_6.5:0.2"], "en": "Theragāthā 6.5 Chakkanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:0.4"], "en": "The Verses of the Elder Māluṅkyaputta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:1.1"], "en": "“For a person who wanders heedlessly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:1.2"], "en": "craving grows like a creeping vine;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:1.3"], "en": "Thus she leaps from here to there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:1.4"], "en": "like a monkey in the forest seeking fruit—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:2.1"], "en": "she who endures this wretched state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:2.2"], "en": "Craving is the attachment in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:2.3", "PA_thag_6.5:2.4"], "en": "for one who has it, sorrows increase like grass after rain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:3.1"], "en": "But whoever overcomes this wretched craving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:3.2"], "en": "so difficult to transcend in the world—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:3.3"], "en": "from him sorrows fall away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:3.4"], "en": "Like a drop of water on a lotus leaf.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:4.1"], "en": "This I say to you, may it be well with you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:4.2"], "en": "all you who have gathered here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:4.3"], "en": "Dig up the root of craving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:4.4"], "en": "just as one seeking usira roots digs up the birana grass;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:4.5"], "en": "lest you be swept away like reeds by a river.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:4.6"], "en": "Māra was shattered again and again.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:5.1"], "en": "Practice the word of the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:5.2"], "en": "let not the opportune moment pass you by.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:5.3", "PA_thag_6.5:5.4"], "en": "For those who have let the opportune moment pass grieve, having been cast into hell.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:6.1"], "en": "Negligence is dust; negligence is dust.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:6.2"], "en": "Dust has fallen upon one through negligence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:6.3"], "en": "by means of heedfulness and true knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:6.4"], "en": "one should pull out that thorn from oneself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.5:6.5"], "en": "… the Elder Māluṅkyaputta …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
