[
{"segs": ["PA_ja_380:0.1", "PA_ja_380:0.2", "PA_ja_380:0.3"], "en": "Jātaka Chakkanipāta: The Section on the Indestructible (Avāriyavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:0.4"], "en": "5. The Āsaṅka-jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:1.1", "PA_ja_380:1.2"], "en": "“The creeper named Āsāvatī was born in the Cittalatāvana grove;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:1.3", "PA_ja_380:1.4"], "en": "For her, one fruit ripens in a thousand years;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:2.1"], "en": "the gods attend upon it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:2.2"], "en": "The fruit of mindfulness is so far-reaching;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:2.3"], "en": "O King, like a prayer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:2.4"], "en": "your hope has borne fruit and brought happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:3.1"], "en": "That bird indeed hopes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:3.2"], "en": "that falcon indeed hopes;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:3.3"], "en": "and his hope is fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:3.4"], "en": "Having gone so far,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:3.5"], "en": "O King, you are like a blessing;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:3.6"], "en": "hope indeed is fruitful and brings happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:4.1"], "en": "“He struck me with words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:4.2"], "en": "but he did not strike me with deeds;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:4.3"], "en": "like the *sereyyaka* flower, his garland.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:4.4"], "en": "Those who possess beauty but lack fragrance are like flowers that have color but no scent.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:5.1", "PA_ja_380:5.2"], "en": "He who utters sweet words toward his friends reaps no fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:5.3"], "en": "Giving away wealth without relinquishing it,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:5.4"], "en": "its bond with him decays;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:6.1"], "en": "for one should say what one would do.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:6.2"], "en": "One should not speak of that which one would not do;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:6.3", "PA_ja_380:6.4"], "en": "the wise clearly discern the person who speaks without acting.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:7.1", "PA_ja_380:7.2"], "en": "\"Alas, my strength is exhausted and provisions are no longer found;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:7.3"], "en": "I fear I shall cause the destruction of living beings.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:7.4"], "en": "“Come now, let us go.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:8.1"], "en": "“This indeed is my name, as I am called,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:8.2"], "en": "O bull among charioteers.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:8.3"], "en": "\"Come, Great King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:8.4"], "en": "let me address my father.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_380:9.1"], "en": "This is the fifth Jātaka, the Āsaṅka-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
