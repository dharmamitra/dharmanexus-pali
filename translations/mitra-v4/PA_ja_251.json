[
{"segs": ["PA_ja_251:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_251:0.2", "PA_ja_251:0.3"], "en": "Tikanipāta, Saṅkappavagga (The Chapter on Intentions)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_251:0.4"], "en": "1. The Saṅkapparāga Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_251:1.1", "PA_ja_251:1.2"], "en": "“By that which is washed away by the stain of intention, and sharpened by discursive thought;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_251:1.3"], "en": "Not by being adorned with a beautiful ornament,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_251:1.4"], "en": "nor by being fashioned by a fletcher,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_251:2.1"], "en": "nor by being pierced through the ear.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_251:2.2"], "en": "Nor by one who dwells in the form of a peacock;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_251:2.3", "PA_ja_251:2.4"], "en": "therefore I have been pierced in the heart by that which burns all my limbs.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_251:3.1"], "en": "I do not see any penetration from which blood would flow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_251:3.2", "PA_ja_251:3.3"], "en": "as long as the mind is not applied to the object in a proper manner.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_251:3.4"], "en": "“Suffering has been brought upon myself.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_251:4.1"], "en": "Thus ends the first Saṅkapparāga Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
