[
{"segs": ["PA_tha-ap_46:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:0.2"], "en": "Upālivagga 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:0.3"], "en": "The Apadāna of the Elder Sanniṭṭhāpaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:1.1"], "en": "“Having built a small hut in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:1.2"], "en": "I dwell amidst the mountains;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:1.3"], "en": "content with gain or loss, I live there.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:1.4"], "en": "By means of both fame and infamy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:2.1"], "en": "Padumuttara, the Knower of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:2.2"], "en": "the recipient of offerings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:2.3"], "en": "Accompanied by one hundred thousand seers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:2.4"], "en": "he came into my presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:3.1"], "en": "To that great naga who had approached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:3.2", "PA_tha-ap_46:3.3"], "en": "Having prepared a grass mat named Jalajuttama,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:3.4"], "en": "I gave it to the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:4.1"], "en": "With a clear mind and a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:4.2", "PA_tha-ap_46:4.3"], "en": "I gave mangoes and drinking water to the one who was upright.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:4.4"], "en": "With a serene mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:5.1", "PA_tha-ap_46:5.2"], "en": "that gift which I gave back then, a hundred thousand aeons ago;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:5.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:5.4"], "en": "this is the fruit of the mango stone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:6.1"], "en": "In the forty-first aeon—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:6.2"], "en": "I was once a sole conqueror of enemies,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:6.3", "PA_tha-ap_46:6.4"], "en": "a wheel-turning monarch of great power, endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:7.1", "PA_tha-ap_46:7.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:7.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:8.1"], "en": "Thus indeed the venerable elder Sanniṭṭhāpaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_46:9.1"], "en": "This is the fourth legend of the elder Sanniṭṭhāpaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
