[
{"segs": ["PA_snp_3.1:0.1", "PA_snp_3.1:0.2", "PA_snp_3.1:1.1"], "en": "Sutta Nipāta 3.1 Pabbajjāsutta “I shall praise the going forth:”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:1.2"], "en": "How the Visionary One went forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:1.3"], "en": "and how, while investigating,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:1.4"], "en": "he took delight in the going-forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:2.1"], "en": "\"This household life is a confinement,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:2.2"], "en": "a breeding ground for dust;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:2.3"], "en": "going forth is like the open air.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:2.4"], "en": "Having seen this, he went forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:3.1", "PA_snp_3.1:3.2"], "en": "Having gone forth, he avoided evil deeds with his body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:3.3"], "en": "Abandoning verbal misconduct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:3.4"], "en": "he purified his livelihood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:4.1"], "en": "The Buddha went to Rājagaha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:4.2"], "en": "To Giribbaja of the Magadhans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:4.3", "PA_snp_3.1:4.4"], "en": "he who was endowed with excellent marks went for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:5.1", "PA_snp_3.1:5.2"], "en": "Bimbisāra, stationed in his palace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:5.3"], "en": "saw him endowed with the auspicious marks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:5.4"], "en": "He spoke this meaning:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:6.1"], "en": "“Gentlemen, attend to this one:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:6.2"], "en": "he is handsome, tall, and pure.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:6.3"], "en": "Endowed with good conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:6.4"], "en": "he gazes only a yoke’s length ahead;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:7.1"], "en": "with downcast eyes and mindful, he walks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:7.2"], "en": "\"This man is not from a lowly family;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:7.3"], "en": "let royal messengers run after him—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:7.4"], "en": "where will the bhikkhu go?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:8.1", "PA_snp_3.1:8.2"], "en": "Those royal messengers sent forth followed closely behind him, asking:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:8.3"], "en": "\"Where will this bhikkhu go?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:8.4"], "en": "Where will my dwelling be?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:9.1"], "en": "Wandering from house to house in regular succession,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:9.2"], "en": "with the sense-doors guarded and well-restrained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:9.3"], "en": "He quickly filled his bowl,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:9.4"], "en": "being clearly comprehending and mindful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:10.1"], "en": "Having wandered for alms, he...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:10.2"], "en": "Having departed from the city,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:10.3"], "en": "the Sage proceeded toward Paṇḍava;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:10.4"], "en": "here his dwelling shall be.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:11.1"], "en": "Having seen him who had entered his dwelling,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:11.2"], "en": "three messengers approached;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:11.3"], "en": "of them, only one returned.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:11.4"], "en": "He reported to the king:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:12.1", "PA_snp_3.1:12.2"], "en": "“O Great King, this bhikkhu is here in front of Paṇḍava.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:12.3", "PA_snp_3.1:12.4"], "en": "Seated like a bull-tiger or a lion in the heart of a mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:13.1"], "en": "having heard the messenger’s words, [he spoke].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:13.2"], "en": "The Kshatriya, in his excellent vehicle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:13.3", "PA_snp_3.1:13.4"], "en": "set out in great haste toward Mount Paṇḍava.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:14.1"], "en": "Having traveled as far as the ground for vehicles,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:14.2", "PA_snp_3.1:14.3"], "en": "the kshatriya alighted from his vehicle and approached on foot.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:14.4"], "en": "Having approached him, he entered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:15.1", "PA_snp_3.1:15.2"], "en": "having sat down, the king exchanged friendly greetings and pleasant conversation with him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:15.3"], "en": "Having thus concluded his conversation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:15.4"], "en": "he spoke on this matter:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:16.1"], "en": "\"You are young and still a youth...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:16.2"], "en": "A youth at his first appearance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:16.3"], "en": "endowed with beauty and stature,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:16.4"], "en": "like a noble-born prince of high birth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:17.1"], "en": "Adorning the front of the army,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:17.2"], "en": "seated in the midst of a multitude of elephants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:17.3"], "en": "I give you wealth; enjoy it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:17.4"], "en": "“Tell me your birth when you are asked.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:18.1"], "en": "“The land is straight, O King,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:18.2"], "en": "facing the Himalayas.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:18.3"], "en": "Endowed with wealth and energy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:18.4"], "en": "residing among the Kosalans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:19.1"], "en": "they were known by the clan name of Ādicca.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:19.2"], "en": "I am of the clan known as the Sākiyas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:19.3"], "en": "I have gone forth from that family,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:19.4"], "en": "not aspiring for sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:20.1"], "en": "Having seen the danger in sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:20.2"], "en": "and having seen renunciation as security,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:20.3"], "en": "I shall go forth for the sake of striving.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:20.4"], "en": "“Here my mind finds delight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.1:20.5"], "en": "Thus ends the first discourse, the Pabbajjā Sutta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
