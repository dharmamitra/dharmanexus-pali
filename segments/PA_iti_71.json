    {
        "segmentnr": "PA_iti_71:1.1",
        "original": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ:",
        "analyzed": "vuttam ha etam bhagavatā vuttam arahatā iti me suta ",
        "folio": "1",
        "suttacentral_link": "https://suttacentral.net/iti71/pli/ms#1.1"
    },
    {
        "segmentnr": "PA_iti_71:2.1",
        "original": "“Diṭṭhā mayā, bhikkhave, sattā kāyasucaritena samannāgatā vacīsucaritena samannāgatā manosucaritena samannāgatā ariyānaṁ anupavādakā sammādiṭṭhikā sammādiṭṭhikammasamādānā.",
        "analyzed": "diṭṭhāḥ mayā bhikkhave sattāḥ kāya su caritena samannāgatāḥ vacī su caritena samannāgatāḥ manaḥ su caritena samannāgatāḥ ariyānam an upavādakā sammādiṭṭhikā sammādiṭṭhi kamma samādānā ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/iti71/pli/ms#2.1"
    },
    {
        "segmentnr": "PA_iti_71:2.2",
        "original": "Te kāyassa bhedā paraṁ maraṇā sugatiṁ saggaṁ lokaṁ upapannā.",
        "analyzed": "te kāyassa bhedā param maraṇā sugatim saggam lokam upapannā ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/iti71/pli/ms#2.2"
    },
    {
        "segmentnr": "PA_iti_71:3.1",
        "original": "Taṁ kho panāhaṁ, bhikkhave, nāññassa samaṇassa vā brāhmaṇassa vā sutvā vadāmi.",
        "analyzed": "tam kho pana āha bhikkhave na aññassa samaṇassa vā brāhmaṇassa vā sutvā vadāmi ",
        "folio": "3",
        "suttacentral_link": "https://suttacentral.net/iti71/pli/ms#3.1"
    },
    {
        "segmentnr": "PA_iti_71:3.2",
        "original": "Diṭṭhā mayā, bhikkhave, sattā kāyasucaritena samannāgatā vacīsucaritena samannāgatā manosucaritena samannāgatā ariyānaṁ anupavādakā sammādiṭṭhikā sammādiṭṭhikammasamādānā.",
        "analyzed": "diṭṭhāḥ mayā bhikkhave sattāḥ kāya su caritena samannāgatāḥ vacī su caritena samannāgatāḥ manaḥ su caritena samannāgatāḥ ariyānam an upavādakā sammādiṭṭhikā sammādiṭṭhi kamma samādānā ",
        "folio": "3",
        "suttacentral_link": "https://suttacentral.net/iti71/pli/ms#3.2"
    },
    {
        "segmentnr": "PA_iti_71:3.3",
        "original": "Te kāyassa bhedā paraṁ maraṇā sugatiṁ saggaṁ lokaṁ upapannā.",
        "analyzed": "te kāyassa bhedā param maraṇā sugatim saggam lokam upapannā ",
        "folio": "3",
        "suttacentral_link": "https://suttacentral.net/iti71/pli/ms#3.3"
    },
    {
        "segmentnr": "PA_iti_71:3.4",
        "original": "Api ca, bhikkhave, yadeva sāmaṁ ñātaṁ sāmaṁ diṭṭhaṁ sāmaṁ viditaṁ tadevāhaṁ vadāmi.",
        "analyzed": "api ca bhikkhave yat eva sāmam ñātam sāmam diṭṭham sāmam viditam tat eva aham vadāmi ",
        "folio": "3",
        "suttacentral_link": "https://suttacentral.net/iti71/pli/ms#3.4"
    },
    {
