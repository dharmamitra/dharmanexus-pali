[
{"segs": ["PA_tha-ap_355:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:0.2"], "en": "The Chapter on Those Who Recognize Sounds (Saddasaññakavagga) 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:0.3"], "en": "The Apadāna of the Elder Kiṃsukapūjaka (The Flowering Tree Worshiper)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:1.1"], "en": "“Having seen a flowering *kiṃsuka* tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:1.2"], "en": "and having raised my joined palms in reverence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:1.3"], "en": "remembering the Buddha Siddhattha, I paid homage.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:1.4"], "en": "I offered worship in the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:2.1"], "en": "For ninety-four aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:2.2"], "en": "because of that flower which I offered in worship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:2.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:2.4"], "en": "this is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:3.1"], "en": "The four analytical insights—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:3.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:3.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:4.1"], "en": "Thus indeed did the Venerable Elder Kiṃsukapūjaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_355:5.1"], "en": "The legend of the Elder Kiṁsukapūjaka is the third.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
