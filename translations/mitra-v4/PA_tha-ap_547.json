[
{"segs": ["PA_tha-ap_547:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:0.2"], "en": "Bhaddiyavagga 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:0.3"], "en": "The Apadāna of the Elder Nandaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:1.2"], "en": "the eye of all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:1.3"], "en": "[appeared] one hundred thousand aeons ago from here.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:1.4", "PA_tha-ap_547:2.1"], "en": "In this eon, the Leader arose for the welfare and happiness of all beings—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:2.2"], "en": "the best among those who speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:2.3", "PA_tha-ap_547:2.4"], "en": "The noble steed among men has practiced for the welfare of the world with its devas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:3.1"], "en": "having attained the pinnacle of glory, he is possessed of splendor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:3.2"], "en": "The Victor is nourished by the praise of his fame;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:3.3"], "en": "honored by the entire world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:3.4"], "en": "he is renowned in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:4.1"], "en": "Having crossed over doubt,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:4.2"], "en": "having transcended perplexity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:4.3"], "en": "his mental intentions are fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:4.4"], "en": "He attained supreme enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:5.1", "PA_tha-ap_547:5.2"], "en": "This best of men is the arouser of the path that had not yet arisen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:5.3", "PA_tha-ap_547:5.4"], "en": "He has declared what was undeclared and brought forth what was unborn;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:6.1"], "en": "he is the knower of the path and the one who understands the path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:6.2"], "en": "The bull among men, the proclaimer of the path;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:6.3"], "en": "the Teacher skilled in the path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:6.4"], "en": "the most excellent of charioteers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:7.1"], "en": "Then the Leader, the Greatly Compassionate One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:7.2", "PA_tha-ap_547:7.3"], "en": "taught the Dhamma to those submerged in the mire of sensual desires.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:7.4"], "en": "He rescued living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:8.1"], "en": "In the exhortation of the bhikkhunīs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:8.2"], "en": "he was esteemed as the best of disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:8.3"], "en": "Praising those foremost in excellence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:8.4"], "en": "the Great Sage designated them;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:9.1"], "en": "having heard that, I was filled with joy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:9.2", "PA_tha-ap_547:9.3"], "en": "Having invited the Tathāgata and fed him along with the Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:9.4"], "en": "I aspired for that supreme state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:10.1", "PA_tha-ap_547:10.2"], "en": "Then the Lord, the great seer, being delighted, said to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:10.3"], "en": "\"May you be happy, long-lived one.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:10.4"], "en": "You shall attain that heart’s desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:11.1"], "en": "In a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:11.2"], "en": "born into the lineage of Okkāka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:11.3", "PA_tha-ap_547:11.4"], "en": "One named Gotama by clan will become a teacher in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:12.1"], "en": "he will be an heir to his teachings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:12.2"], "en": "‘Born from the heart, fashioned by the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:12.3", "PA_tha-ap_547:12.4"], "en": "he shall be a disciple of the Teacher, known by the name Nandaka.’”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:13.1"], "en": "By that well-performed kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:13.2"], "en": "and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:13.3"], "en": "having abandoned this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:13.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:14.1"], "en": "And now, in my final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:14.2"], "en": "I am born into a family of wealthy merchants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:14.3"], "en": "In the excellent city of Sāvatthī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:14.4"], "en": "prosperous, flourishing, and wealthy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:15.1"], "en": "the Sugata entered the city.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:15.2"], "en": "Having seen this, my mind was filled with wonder;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:15.3"], "en": "at the acceptance of the Jeta Grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:15.4"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:16.1"], "en": "Before long,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:16.2"], "en": "I attained arahantship; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:16.3"], "en": "having crossed over saṃsāra, I am free.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:16.4"], "en": "Instructed by the All-Seeing One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:17.1"], "en": "I engaged in a discussion on the Dhamma with the bhikkhunīs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:17.2"], "en": "answering their questions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:17.3", "PA_tha-ap_547:17.4"], "en": "All those five hundred women whom I instructed became free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:18.1"], "en": "No fewer than five hundred.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:18.2"], "en": "Then the greatly beneficial one, being pleased,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:18.3", "PA_tha-ap_547:18.4"], "en": "placed me in the foremost position among those who exhort the bhikkhunīs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:19.1", "PA_tha-ap_547:19.2"], "en": "Kamma performed a hundred thousand eons ago has shown its fruit to me here;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:19.3"], "en": "like an arrow released from a bow, I am completely liberated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:19.4"], "en": "I have incinerated the defilements;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:20.1"], "en": "the defilements have been incinerated by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:20.2"], "en": "…pe…", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:20.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:21.1", "PA_tha-ap_547:21.2"], "en": "Welcome indeed has come to me... [as before]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:21.3"], "en": "This is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:22.1", "PA_tha-ap_547:22.2"], "en": "The four analytical knowledges... [and so on]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:22.3"], "en": "“Thus has been spoken the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:23.1"], "en": "In this way, it is said, the venerable elder Nandaka recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_547:24.1"], "en": "This is the fifth legend of the elder Nandaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
