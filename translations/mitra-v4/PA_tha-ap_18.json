[
{"segs": ["PA_tha-ap_18:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:0.2"], "en": "The Chapter on the Lion Throne (Sīhāsaniyavagga), Number 6.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:0.3"], "en": "The Apadāna of the Elder Rāhula.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:1.1", "PA_tha-ap_18:1.2", "PA_tha-ap_18:1.3"], "en": "“In the seven-storied palace of the Blessed One Padumuttara, the World-Champion, the Neutral One;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:1.4"], "en": "I spread out a mirror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:2.1", "PA_tha-ap_18:2.2"], "en": "while the Great Sage was surrounded by a thousand monks whose taints were exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:2.3", "PA_tha-ap_18:2.4"], "en": "The Lord of bipeds, the Bull among men, approached the fragrant chamber,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:3.1"], "en": "illuminating it with his splendor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:3.2"], "en": "The God of Gods, the Bull among Men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:3.3"], "en": "the Teacher standing before the Saṅgha of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:3.4"], "en": "spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:4.1", "PA_tha-ap_18:4.2", "PA_tha-ap_18:4.3"], "en": "I shall now praise that by which this bed is illuminated, like a well-polished mirror.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:4.4"], "en": "Listen as I speak:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:5.1"], "en": "[there are things] made of gold, made of silver,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:5.2"], "en": "and likewise made of beryl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:5.3"], "en": "Palaces will arise for him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:5.4"], "en": "whatever is dear to the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:6.1"], "en": "Sixty-four times as lord of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:6.2"], "en": "He will exercise sovereignty over the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:6.3", "PA_tha-ap_18:6.4"], "en": "without interval, he will become a wheel-turning monarch a thousand times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:7.1"], "en": "In the twenty-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:7.2"], "en": "there was a kṣatriya named Vimala,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:7.3"], "en": "a conqueror of the four quarters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:7.4"], "en": "He will become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:8.1"], "en": "His city, named Reṇuvatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:8.2"], "en": "will be beautifully constructed with bricks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:8.3"], "en": "In length it was three hundred [yojanas],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:8.4"], "en": "endowed with four equal sides.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:9.1"], "en": "The palace named Sudassana—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:9.2"], "en": "It was constructed by Vissakamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:9.3"], "en": "furnished with excellent gabled chambers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:9.4"], "en": "and adorned with the seven precious gems.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:10.1", "PA_tha-ap_18:10.2"], "en": "That place, uninhabited by the ten classes of beings and crowded with holders of the sciences,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:10.3"], "en": "was like the city of Sudassana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:10.4"], "en": "It will belong to the deities.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:11.1"], "en": "Radiance issues from him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:11.2"], "en": "just as when the sun is rising.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:11.3", "PA_tha-ap_18:11.4"], "en": "It will shine constantly for eight yojanas all around for a hundred thousand eons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:12.1"], "en": "After a hundred thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:12.2"], "en": "Born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:12.3", "PA_tha-ap_18:12.4"], "en": "he will be a teacher in the world named Gotama by lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:13.1"], "en": "Having passed away from Tusita,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:13.2"], "en": "impelled by the root of his wholesome merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:13.3"], "en": "he [was reborn] for the Blessed One Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:13.4"], "en": "The son born here will be such that,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:14.1"], "en": "if he should dwell in the household life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:14.2"], "en": "he would become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:14.3", "PA_tha-ap_18:14.4"], "en": "It is impossible that such a one as he should find delight in the household life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:15.1"], "en": "having gone forth from the home, he would not return.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:15.2"], "en": "Subbata will go forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:15.3", "PA_tha-ap_18:15.4"], "en": "he who is named Rāhula shall become an Arahant.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:16.1"], "en": "As a hen protects her eggs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:16.2"], "en": "or as a yak protects its tail,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:16.3"], "en": "so should one who is prudent and endowed with virtue protect himself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:16.4"], "en": "Thus did the Great Sage protect me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:17.1"], "en": "Having understood his Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:17.2"], "en": "I dwelt delighted in his teaching.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:17.3"], "en": "Having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:17.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:18.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:18.2", "PA_tha-ap_18:18.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:18.4"], "en": "the Buddha’s teaching has been accomplished.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:19.1"], "en": "Thus indeed did the venerable elder Rāhula speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_18:20.1"], "en": "This is the sixth legend of the elder Rāhula.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
