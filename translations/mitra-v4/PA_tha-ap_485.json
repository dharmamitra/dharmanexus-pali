[
{"segs": ["PA_tha-ap_485:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:0.2", "PA_tha-ap_485:0.3"], "en": "The Chapter on Rags from Dustheaps (Paṁsukūlavagga), No. 3: The Apadāna of the Elder Bhisadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:1.1", "PA_tha-ap_485:1.2"], "en": "“Having plunged into a lotus pond frequented by various elephants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:1.3"], "en": "I pluck the lotus root there.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:1.4"], "en": "For the sake of grass,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:2.1", "PA_tha-ap_485:2.2"], "en": "at that time, the Blessed One known by the name Padumuttara—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:2.3"], "en": "The Buddha, clad in saffron robes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:2.4"], "en": "walks upon the wind-swept path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:3.1"], "en": "shaking off the refuse-rags.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:3.2"], "en": "I heard that sound at that time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:3.3"], "en": "looking upward,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:3.4"], "en": "I saw the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:4.1"], "en": "Standing right there, being peaceful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:4.2"], "en": "I entreated the Leader of the World:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:4.3"], "en": "\"Honey flows along with the lotus stalks.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:4.4", "PA_tha-ap_485:5.1", "PA_tha-ap_485:5.2"], "en": "“May the Buddha, the Seer, out of compassion for me, accept this milk and ghee prepared by the Mūlālis.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:5.3"], "en": "Then the compassionate Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:5.4"], "en": "of great renown, having descended,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:6.1"], "en": "accepted my alms-food.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:6.2"], "en": "Out of compassion, the Visionary One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:6.3"], "en": "the Fully Awakened One, having accepted it,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:6.4"], "en": "offered me his words of appreciation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:7.1"], "en": "\"May you be happy, O one of great merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:7.2"], "en": "may your destiny be fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:7.3"], "en": "by this gift of a lotus root,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:7.4"], "en": "\"May you obtain abundant happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:8.1"], "en": "Having said this, the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:8.2"], "en": "whose name means \"Supreme among those with Lotus-like Eyes,\" [departed].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:8.3"], "en": "Having taken alms, the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:8.4"], "en": "the Victor, went through the air; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:9.1"], "en": "having taken a lotus root, he departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:9.2"], "en": "I came to my hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:9.3"], "en": "having tied a lotus root to a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:9.4"], "en": "I recollected my gift to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:10.1", "PA_tha-ap_485:10.2"], "en": "A great wind arose and then shook the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:10.3"], "en": "the sky resounded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:10.4"], "en": "As the thunderbolt was crashing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:11.1", "PA_tha-ap_485:11.2"], "en": "the stroke of that thunderbolt then fell upon my head.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:11.3"], "en": "While sitting there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:11.4", "PA_tha-ap_485:12.1"], "en": "I passed away; endowed with meritorious karma, I was reborn.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:12.2"], "en": "I was reborn in Tusita;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:12.3"], "en": "my physical body having fallen away,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:12.4"], "en": "I rejoiced in the world of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:13.1"], "en": "Sixty-eight thousand women,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:13.2"], "en": "beautifully adorned,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:13.3"], "en": "attend upon him morning and evening.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:13.4"], "en": "This is the fruit of giving medicine:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:14.1"], "en": "having come to a human birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:14.2"], "en": "I am always happy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:14.3"], "en": "I have no deficiency in enjoyments;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:14.4"], "en": "this is the fruit of giving lotus roots.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:15.1"], "en": "I was shown compassion by him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:15.2"], "en": "By the God of Gods, the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:15.3"], "en": "all taints are utterly exhausted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:15.4"], "en": "now there is no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:16.1"], "en": "In a hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:16.2"], "en": "because I gave that lotus root at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:16.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:16.4"], "en": "This is the fruit of giving medicine.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:17.1", "PA_tha-ap_485:17.2"], "en": "My defilements have been incinerated... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:17.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:18.1", "PA_tha-ap_485:18.2"], "en": "Welcome indeed has come to me... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:18.3"], "en": "The Buddha’s teaching has been proclaimed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:19.1", "PA_tha-ap_485:19.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:19.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:20.1"], "en": "It was in this way that the venerable elder Bhisadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_485:21.1"], "en": "This is the third legend of the elder Bhisadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
