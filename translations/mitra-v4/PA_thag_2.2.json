[
{"segs": ["PA_thag_2.2:0.1", "PA_thag_2.2:0.2"], "en": "Theragāthā 2.2 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.2:0.3"], "en": "Paṭhamavagga (The First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.2:0.4"], "en": "The Verses of the Elder Piṇḍolabhāradvāja:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.2:1.1"], "en": "“Life is not lived through wrong means,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.2:1.2"], "en": "nor is food for the sake of the heart’s gratification.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.2:1.3"], "en": "Having seen that this compound of aggregates is sustained by nutriment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.2:1.4"], "en": "I wander seeking [the truth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.2:2.1"], "en": "For they have declared it to be like a mire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.2:2.2", "PA_thag_2.2:2.3"], "en": "This honoring and worshipping among families is a subtle dart, difficult to extract;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.2:2.4"], "en": "honor is hard for a base person to abandon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.2:2.5"], "en": "Thus indeed the venerable elder Piṇḍola Bhāradvāja spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
