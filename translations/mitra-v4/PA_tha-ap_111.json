[
{"segs": ["PA_tha-ap_111:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:0.2", "PA_tha-ap_111:0.3"], "en": "The Chapter on the Giver of Alms-food (Bhikkhadāyivagga), Number Nine: The Apadāna of the Elder Biḷālidāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:1.1"], "en": "“Not far from the Himavat mountains,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:1.2"], "en": "I dwell upon a bed of leaves;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:1.3"], "en": "having fallen into greed for food, I am consumed by craving.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:1.4"], "en": "At that time, I was Seyyasīla.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:2.1", "PA_tha-ap_111:2.2"], "en": "I was digging up kalamba roots and bilāli and takkala tubers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:2.3"], "en": "Having gathered kola, bhallātaka, and billa fruits,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:2.4", "PA_tha-ap_111:3.1"], "en": "they were prepared; Padumuttara, the Knower of the World, [accepted them].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:3.2"], "en": "The recipient of offerings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:3.3"], "en": "having understood my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:3.4"], "en": "he came into my presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:4.1"], "en": "Having approached the Great Naga,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:4.2"], "en": "the God of Gods, the Bull among Men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:4.3"], "en": "and having grasped the lute, Biḷālī—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:4.4"], "en": "I poured it into his bowl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:5.1"], "en": "The Great Hero then consumed it,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:5.2"], "en": "bringing me satisfaction at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:5.3", "PA_tha-ap_111:5.4"], "en": "Having partaken, the All-Knowing One spoke this verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:6.1"], "en": "“Having gladdened one’s own mind, ...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:6.2"], "en": "“You gave me a cat;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:6.3", "PA_tha-ap_111:6.4"], "en": "for a hundred thousand eons you shall not fall into an evil rebirth.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:7.1"], "en": "My final round is turning;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:7.2"], "en": "all states of existence have been eradicated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:7.3"], "en": "I bear my last body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:7.4"], "en": "In the dispensation of the Perfectly Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:8.1"], "en": "in the fifty-fourth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:8.2"], "en": "one known as Sumekhaliya;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:8.3"], "en": "Endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:8.4"], "en": "a wheel-turning monarch of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:9.1"], "en": "[possessing] the four analytical knowledges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:9.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:9.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:10.1"], "en": "Thus indeed did the Venerable Elder Biḷālidāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_111:11.1"], "en": "The legend of the Elder Biḷālidāyaka is the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
