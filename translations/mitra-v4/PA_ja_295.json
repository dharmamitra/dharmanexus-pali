[
{"segs": ["PA_ja_295:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:0.2"], "en": "Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:0.3"], "en": "Kumbhavagga", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:0.4", "PA_ja_295:1.1"], "en": "5. The Anta-jātaka “Your trunk is like that of a bull,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:1.2"], "en": "and your yawn is like that of a lion.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:1.3"], "en": "\"O King of Beasts, homage be to you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:1.4"], "en": "may we receive something.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:2.1"], "en": "\"Only a son of noble family knows [this].\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:2.2"], "en": "To praise this son of noble family;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:2.3"], "en": "O crow, go away from here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:2.4"], "en": "you who resemble a peacock’s neck!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:3.1"], "en": "“The jackal is among the beasts of prey,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:3.2"], "en": "the crow among the birds;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:3.3"], "en": "the castor-oil plant is among the trees.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:3.4"], "en": "“Three ends have come together.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_295:4.1"], "en": "Thus ends the fifth Jātaka, the Anta-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
