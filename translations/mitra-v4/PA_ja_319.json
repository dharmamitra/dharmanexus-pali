[
{"segs": ["PA_ja_319:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:0.2", "PA_ja_319:0.3"], "en": "Catukkanipāta, Pucimandavagga (The Chapter on the Nimba Tree)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:0.4"], "en": "9. The Tittira Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:1.1", "PA_ja_319:1.2"], "en": "“Most happily indeed do I live, for I obtain food to eat;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:1.3"], "en": "\"I stand in the way;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:1.4"], "en": "what, venerable sir, will be my destination?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:2.1"], "en": "\"If your mind does not incline [toward the path]...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:2.2"], "en": "One who is intent on evil deeds is a partisan of evil karma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:2.3", "PA_ja_319:2.4"], "en": "but for the auspicious one who is not so engaged, evil does not adhere.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:3.1", "PA_ja_319:3.2"], "en": "“Thinking, ‘A relative of ours is seated here,’ many people come;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:3.3"], "en": "dependent upon that, one experiences the fruit of karma.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:3.4"], "en": "My mind is afraid of that. [The Blessed One replied:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:4.1", "PA_ja_319:4.2"], "en": "“If the mind does not become corrupted, karma does not touch one who is independent of it.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:4.3", "PA_ja_319:4.4"], "en": "“Evil does not cling to the noble one who is free from anxiety.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_319:5.1"], "en": "The Tittira Jātaka, the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
