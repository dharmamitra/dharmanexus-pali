[
{"segs": ["PA_ja_299:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:0.2"], "en": "Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:0.3"], "en": "Kumbhavagga", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:0.4"], "en": "9. The Komāraputta Jātaka “Formerly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:1.1"], "en": "in the presence of those possessed of virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:1.2"], "en": "you played at hide-and-seek in the hermitage.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:1.3"], "en": "\"Make the monkey-children, O monkey;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:1.4"], "en": "we do not delight in one who possesses virtue and vows.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:2.1"], "en": "\"For I have heard of your supreme purity,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:2.2", "PA_ja_299:2.3"], "en": "“O friend, do not now think of me as you did before, regarding me as the learned son of a young mother;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:2.4"], "en": "I dwell devoted to the jhānas.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:3.1"], "en": "“Even if one were to sow seed upon a rock,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:3.2"], "en": "and the rain-god should send down rain, it would not grow;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:3.3"], "en": "for you have heard of that supreme purity.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:3.4"], "en": "“You are far indeed from the plane of meditation, O monkey!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_299:4.1"], "en": "Thus ends the ninth Jātaka, the Komāraputta Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
