[
{"segs": ["PA_pv_1:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:0.2"], "en": "Uragavagga, 1.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:0.3"], "en": "Khettūpama-petavatthu (The Story of the Simile of the Field)", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:1.1"], "en": "Homage to that Blessed One, the Worthy One, the Perfectly Self-Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:2.1"], "en": "“The Worthy Ones are like fields;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:2.2"], "en": "the donors are like farmers.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:2.3"], "en": "The gift to be given is like a seed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:2.4"], "en": "from this, the fruit is produced.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:3.1"], "en": "This is the seed, and the field is the cultivation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:3.2", "PA_pv_1:3.3"], "en": "And for the donor of the gift to the departed; the departed enjoy that,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:3.4"], "en": "and the giver increases in merit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:4.1"], "en": "Having performed wholesome deeds right here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:4.2", "PA_pv_1:4.3"], "en": "and having honored the departed, one goes to the heavenly realm, that place of no standing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:4.4"], "en": "\"Having performed a wholesome deed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_1:5.1"], "en": "This is the first story, \"The Simile of the Field.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"}
]
