[
{"segs": ["PA_tha-ap_115:0.1", "PA_tha-ap_115:0.2", "PA_tha-ap_115:0.3"], "en": "The Apadāna of the Elder Saraṇagamaniya from the Mahāparivāra Chapter of the Therāpadāna, Number Three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:1.1", "PA_tha-ap_115:1.2", "PA_tha-ap_115:1.3"], "en": "“A battle between the two kings of the gods has arisen; it has been drawn up in battle array.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:1.4"], "en": "A great roar arose.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:2.1"], "en": "Padumuttara, the Knower of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:2.2"], "en": "the recipient of offerings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:2.3", "PA_tha-ap_115:2.4"], "en": "Standing in the sky, the Teacher inspired the great multitude;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:3.1"], "en": "all the gods were delighted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:3.2"], "en": "Having laid aside their armor and weapons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:3.3", "PA_tha-ap_115:3.4"], "en": "they paid homage to the Perfectly Enlightened One and remained there with one-pointed minds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:4.1"], "en": "Knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:4.2", "PA_tha-ap_115:4.3"], "en": "the compassionate Knower of the World uttered a lion’s roar in speech.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:4.4"], "en": "He brought peace to the great multitude.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:5.1"], "en": "Yet a man with a corrupted mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:5.2"], "en": "while harming even a single living being, [is lost].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:5.3"], "en": "Through that corruption of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:5.4"], "en": "one is reborn in a state of woe,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:6.1"], "en": "like an elephant at the head of battle.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:6.2"], "en": "Harming many living beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:6.3"], "en": "you should extinguish your own mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:6.4"], "en": "do not be slain again and again.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:7.1", "PA_tha-ap_115:7.2"], "en": "The army of both those kings of yakkhas was struck with wonder;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:7.3"], "en": "they went for refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:7.4", "PA_tha-ap_115:8.1"], "en": "Having persuaded the people, including his sons and others,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:8.2"], "en": "the Visionary One, the Eldest in the World, lifted up his foot.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:8.3"], "en": "Beholding the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:8.4"], "en": "he departed facing north;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:9.1"], "en": "I went for refuge for the first time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:9.2"], "en": "Of that Tathāgata, the Lord of bipeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:9.3"], "en": "for a hundred thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:9.4"], "en": "I did not fall into an unhappy rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:10.1", "PA_tha-ap_115:10.2"], "en": "And there were sixteen bull-like chariot-warriors named Mahādundubhi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:10.3"], "en": "during the thirty thousand aeons [ago].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:10.4"], "en": "Universal monarchs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:11.1", "PA_tha-ap_115:11.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:11.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:12.1"], "en": "It was in this way that the venerable elder Saraṇagamaniya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_115:13.1"], "en": "This is the third legend of the elder Saraṇagamaniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
