[
{"segs": ["PA_pv_46:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:0.2"], "en": "Mahāvagga 11.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:0.3"], "en": "The Story of the Ghost from Pāṭaliputta", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:1.1"], "en": "“You have seen the hells, the animal realm,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:1.2"], "en": "the hungry ghosts, the asuras, and also humans and gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:1.3"], "en": "you yourself have witnessed the ripening of your own karma.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:1.4"], "en": "“I shall see that Pāṭaliputta unharmed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:1.5"], "en": "having gone there, perform deeds of merit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:2.1"], "en": "“You desire my welfare, O yakkha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:2.2"], "en": "\"You are one who desires my welfare, O deity;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:2.3"], "en": "I shall do your bidding,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:2.4"], "en": "for you are my teacher.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:3.1"], "en": "I have seen the hells, the animal realm,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:3.2"], "en": "the hungry ghosts, the asuras, and likewise humans and gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:3.3"], "en": "I have personally witnessed the ripening of my own karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:3.4"], "en": "“I shall perform abundant meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_46:4.1"], "en": "Thus ends the eleventh story, the *Pāṭaliputta-petavatthu*.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
