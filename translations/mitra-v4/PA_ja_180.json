[
{"segs": ["PA_ja_180:0.1", "PA_ja_180:0.2", "PA_ja_180:0.3"], "en": "Jātaka: The Second Book of Birth Stories (Dukanipāta), Chapter on the Virtuous (Kalyāṇavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:0.4"], "en": "10. The Duddada Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:1.1", "PA_ja_180:1.2"], "en": "“To those who give what is hard to give, who perform deeds that are difficult to do;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:1.3"], "en": "The wicked do not imitate the good;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:1.4"], "en": "the nature of the virtuous is difficult to follow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:2.1"], "en": "Therefore, [one should distinguish] between the virtuous and the wicked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:2.2"], "en": "Diverse are the destinations from here:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:2.3"], "en": "the unwholesome go to hell,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:2.4"], "en": "while the wholesome are destined for heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:3.1"], "en": "The Duddada Jātaka, the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:3.2"], "en": "The Third Chapter on the Beautiful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:4.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:5.1"], "en": "The young brahmin Susamaññamigādhibhū,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:5.2"], "en": "having offered water to the sun when it had assumed its form,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:5.3"], "en": "[was reborn] again in the Sakalāyasatinduka mud.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_180:5.4"], "en": "The ten [virtues] were given by him who gave away even the hundredfold dharma most difficult to give.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
