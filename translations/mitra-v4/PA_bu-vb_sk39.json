[
{"segs": ["PA_bu-vb_sk39:0.1"], "en": "The Theravāda Vinaya Mahāvibhaṅga:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:0.2", "PA_bu-vb_sk39:0.3"], "en": "The Section on the Training Rules (Sekhiyakaṇḍa)", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:0.4"], "en": "Sakkaccavagga 39.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:0.5"], "en": "The Training Rule on Mouthfuls.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.1"], "en": "At that time the Buddha, the Blessed One, was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.2"], "en": "Now at that time, the group-of-six monks made their mouthfuls too large...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.3.1"], "en": "[as before] ... \"The training is to be observed: 'I will not make a mouthful too large.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.4"], "en": "A mouthful should not be made too large.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.5"], "en": "Whoever, out of disrespect, makes a large mouthful, commits an offense of wrong-doing (*dukkaṭa*).", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.6.1", "PA_bu-vb_sk39:1.7"], "en": "There is no offense if it was unintentional.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.8", "PA_bu-vb_sk39:1.9", "PA_bu-vb_sk39:1.10"], "en": "In the case of one who is lacking mindfulness, one who is unaware, or one who is ill.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.11"], "en": "In chewed food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.12"], "en": "in fruits and berries,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.13"], "en": "and in additional curry,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.14"], "en": "In times of distress,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.15"], "en": "for one who is insane,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.16"], "en": "and for the first offender.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk39:1.17"], "en": "The ninth training rule is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
