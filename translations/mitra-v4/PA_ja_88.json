{"segs": ["PA_ja_88:0.2"], "en": "Ekakanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_88:0.3"], "en": "Apāyimhavagga", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_88:0.4"], "en": "8. The Sārambha Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_88:1.1"], "en": "“One should release only what is beautiful;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_88:1.2"], "en": "one should certainly not release what is evil.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_88:1.3"], "en": "“Liberation is good for the virtuous;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_88:1.4"], "en": "having abandoned it, the wicked one suffers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_88:2.1"], "en": "Thus ends the eighth Jātaka, the Sārambha Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
