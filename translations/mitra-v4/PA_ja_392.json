[
{"segs": ["PA_ja_392:0.1", "PA_ja_392:0.2"], "en": "The Jātaka: The Sixth Book of Birth Stories,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:0.3"], "en": "Chapter on the Son Kharaputta.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:0.4"], "en": "7. The Siṅghapuppha Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:1.1", "PA_ja_392:1.2"], "en": "“This water-born flower, which you smell though it has not been given to you—”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:1.3"], "en": "\"This is one factor among thefts:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:1.4"], "en": "you are a thief of perfumes, dear sir.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:2.1"], "en": "\"I do not take them, nor do I break them; [they come to me of their own accord].\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:2.2"], "en": "I smell the water-born lotus from afar;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:2.3"], "en": "by what quality, then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:2.4"], "en": "is it called a \"thief of fragrance\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:3.1", "PA_ja_392:3.2"], "en": "He who digs up lotus roots and breaks off white lotuses—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:3.3"], "en": "thus is one whose actions are defiled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:3.4"], "en": "\"Why is this man not called so?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:4.1"], "en": "\"Because he is a man full of greed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:4.2"], "en": "smeared like a nurse's garment.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:4.3"], "en": "I have no authority over that word of mine,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:4.4"], "en": "yet I am able to speak it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:5.1"], "en": "For a person who is free from blemish...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:5.2"], "en": "For one who constantly seeks purity,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:5.3", "PA_ja_392:5.4"], "en": "even a speck of evil appears as large as a cloud.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:6.1"], "en": "“Surely you know me, O yakkha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:6.2"], "en": "and you have compassion for me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:6.3"], "en": "speak to me again, O yakkha.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:6.4"], "en": "\"When you see such as this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:7.1"], "en": "'I do not depend on you for my livelihood,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:7.2"], "en": "nor am I your hired servant.'\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:7.3", "PA_ja_392:7.4"], "en": "“Only you, O bhikkhu, should know by which way you may go to a happy destination.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_392:8.1"], "en": "Thus ends the Siṅghapuppha Jātaka, the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
