[
{"segs": ["PA_thig_2.6:0.1", "PA_thig_2.6:0.2", "PA_thig_2.6:0.3"], "en": "Therīgāthā 2.6 Dukanipāta Mettikātherīgāthā The Verses of the Elder Nun Mettikā, Second Fifty, Sixth Chapter I am no longer subject to birth; My rebirth has been eradicated. Having realized through direct knowledge, I have lived the holy life; There is now no further existence for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_2.6:1.1"], "en": "“Although I am suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_2.6:1.2"], "en": "weak, and past my youth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_2.6:1.3"], "en": "though I walk leaning on a staff,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_2.6:1.4"], "en": "Having ascended the mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_2.6:2.1", "PA_thig_2.6:2.2"], "en": "he laid aside his outer robe and turned his alms bowl upside down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_2.6:2.3"], "en": "Seated upon the rock,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_2.6:2.4"], "en": "my mind was then liberated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_2.6:2.5"], "en": "the three knowledges were attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_2.6:2.6", "PA_thig_2.6:3.1"], "en": "“... This is the teaching of the Buddha,” said the Elder Nun Mettikā. … [The Elder Nun] Mettikā …", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"}
]
