[
{"segs": ["PA_ja_465:0.1", "PA_ja_465:0.2"], "en": "The Jātaka: The Collection of Twelve Birth Stories,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:0.3"], "en": "Chapter on Cūḷakuṇāla.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:0.4"], "en": "2. The Bhaddasāla Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:1.1", "PA_ja_465:1.2"], "en": "“Who are you, standing in the sky above, clothed in pure garments?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:1.3"], "en": "“By whom are these winds set in motion?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:1.4"], "en": "From where has this fear come?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:2.1"], "en": "“Within your own kingdom, O King.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:2.2"], "en": "The wise know me as Bhaddasāla;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:2.3", "PA_ja_465:2.4"], "en": "I have remained for sixty thousand years, being honored.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:3.1"], "en": "Disampati had cities built,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:3.2", "PA_ja_465:3.3"], "en": "as well as houses and various palaces.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:3.4"], "en": "\"They did not hold me in contempt;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:3.5"], "en": "just as they honored me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:3.6"], "en": "so too should you honor me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:4.1"], "en": "“I do not see anyone like you there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:4.2", "PA_ja_465:4.3"], "en": "O tree, with a body so stout in height and girth.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:4.4"], "en": "\"You are handsome by birth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:5.1", "PA_ja_465:5.2"], "en": "I shall have a delightful palace built for you, with a single pillar.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:5.3"], "en": "\"There I shall lead you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:5.4"], "en": "long will your life be, O yakkha!\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:6.1"], "en": "thus did this thought arise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:6.2"], "en": "There shall be separation from the body;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:6.3"], "en": "having cut me apart individually,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:6.4"], "en": "cut me into pieces.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:7.1"], "en": "Cut it at the top and in the middle, and then cut it at the root;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:7.2", "PA_ja_465:7.3"], "en": "thus, as it is being cut by me, [the craving] shall be severed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:7.4"], "en": "“Death would not be suffering. [The Buddha said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:8.1", "PA_ja_465:8.2"], "en": "“Just as one might cut off the hands and feet, or the ears and nose, while one is still alive;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:8.3"], "en": "After that, one might cut off the head;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:8.4"], "en": "that death would be painful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:9.1"], "en": "But is it pleasant to be cut into pieces?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:9.2"], "en": "O Bhaddasāla, lord of the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:9.3"], "en": "for what reason, on what basis,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:9.4"], "en": "do you wish to be cut into pieces?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:10.1"], "en": "“And whatever cause one relies upon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:10.2"], "en": "that cause which is connected with the Dhamma—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:10.3"], "en": "I desire it to be cut into pieces.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:10.4"], "en": "Great King, listen to me:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:11.1"], "en": "my kinsmen were raised in comfort,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:11.2"], "en": "living by my side in a sheltered place.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:11.3", "PA_ja_465:11.4"], "en": "“I would harm this person who is unaccustomed to the suffering of others.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:12.1"], "en": "“He intended what was intended;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:12.2"], "en": "“O Bhaddasāla, lord of the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:12.3"], "en": "you who desire the welfare of your kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:12.4"], "en": "I grant you fearlessness, my friend.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_465:13.1"], "en": "The Bhaddasāla Jātaka is the second.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
