[
{"segs": ["PA_thag_1.79:0.1", "PA_thag_1.79:0.2", "PA_thag_1.79:0.3"], "en": "Theragāthā 1.79 Ekakanipāta Aṭṭhamavagga (The Eighth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.79:0.4"], "en": "The Verse of the Elder Rakkhita:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.79:1.1"], "en": "“All passion has been abandoned by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.79:1.2"], "en": "all hatred has been uprooted.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.79:1.3"], "en": "“All delusion has vanished for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.79:1.4"], "en": "I have become cool and attained Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.79:1.5"], "en": "… Thus spoke the Elder Rakkhita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
