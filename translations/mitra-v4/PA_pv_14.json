[
{"segs": ["PA_pv_14:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:0.2"], "en": "Ubbarivagga, 2.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:0.3"], "en": "The Story of the Petī Who Was the Mother of the Elder Sāriputta", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:1.1"], "en": "“You are naked, ill-favored in form,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:1.2"], "en": "emaciated, with veins showing all over;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:1.3"], "en": "you are haggard and thin.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:1.4"], "en": "“Who are you that stands here?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:2.1"], "en": "“I am your mother, O Sakyan,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:2.2"], "en": "in former births.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:2.3"], "en": "Reborn in the realm of hungry ghosts,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:2.4"], "en": "they are tormented by hunger and thirst;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:3.1"], "en": "they consume only what has been discarded, spat out, or is saliva.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:3.2"], "en": "Nasal mucus and semen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:3.3"], "en": "fat from those being burned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:3.4"], "en": "and blood from those who have given birth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:4.1", "PA_pv_14:4.2"], "en": "And the blood of merchants whose noses and heads were cut off,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:4.3"], "en": "I eat, overcome by hunger.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:4.4"], "en": "Dependent upon women and men,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:5.1", "PA_pv_14:5.2"], "en": "I shall eat the pus and blood of cattle and of humans.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:5.3", "PA_pv_14:5.4"], "en": "Homeless and shelterless, dependent upon their blue bedsteads,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:6.1"], "en": "give me alms, my dear son!", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:6.2"], "en": "\"Having given [this], assign it to me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:6.3", "PA_pv_14:6.4"], "en": "perhaps I might be released from feeding on pus and blood.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:7.1"], "en": "Having heard his mother’s words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:7.2", "PA_pv_14:7.3"], "en": "the compassionate Upatissa addressed Moggallāna:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:7.4"], "en": "And to Anuruddha and Kappina.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:8.1"], "en": "Having built four huts,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:8.2"], "en": "he gave them to the Saṅgha of the four quarters.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:8.3", "PA_pv_14:8.4"], "en": "She assigned a hut, food, and drink as her mother’s gift;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:9.1"], "en": "immediately after it was assigned, [the result was seen].", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:9.2"], "en": "The fruit of this offering arose:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:9.3"], "en": "food, drink, and clothing—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:9.4"], "en": "this is the fruit of the sacrificial gift.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:10.1"], "en": "Then, pure and dressed in clean garments,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:10.2"], "en": "wearing the finest Kāsika cloth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:10.3"], "en": "adorned with variegated clothes and ornaments—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:10.4"], "en": "He approached Kolita and said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:11.1", "PA_pv_14:11.2"], "en": "“O goddess, with such exquisite beauty as you stand here;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:11.3", "PA_pv_14:11.4"], "en": "Illuminating all directions like a star among the herbs,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:12.1"], "en": "by what means do you possess such a complexion?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:12.2"], "en": "By what means do you succeed here?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:12.3", "PA_pv_14:12.4"], "en": "For all those riches that are dear to the mind arise for you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:13.1"], "en": "I ask you, O goddess of great majesty:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:13.2"], "en": "when you were a human being, what merit did you perform?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:13.3"], "en": "By what means have you come to possess such blazing power?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:13.4"], "en": "\"And your radiance shines in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:14.1", "PA_pv_14:14.2"], "en": "\"In former births, I was the mother of Sāriputta;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:14.3"], "en": "They have been reborn in the realm of hungry ghosts,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:14.4"], "en": "afflicted by hunger and thirst;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:15.1"], "en": "they subsist on discarded and spat-out saliva.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:15.2"], "en": "Nasal mucus, semen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:15.3"], "en": "fat from those being burned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:15.4"], "en": "and blood from those giving birth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:16.1", "PA_pv_14:16.2"], "en": "And the blood of merchants whose noses and heads were cut off,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:16.3"], "en": "I eat, overcome by hunger.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:16.4"], "en": "Dependent upon women and men,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:17.1", "PA_pv_14:17.2"], "en": "I shall feed on the pus and blood of cattle and of humans.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:17.3"], "en": "Homeless and without shelter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:17.4"], "en": "they were dependent on blue-colored beds;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:18.1"], "en": "through the gift of Sāriputta, they attained peace.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:18.2"], "en": "I rejoice, free from fear from any quarter;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:18.3", "PA_pv_14:18.4"], "en": "I have come, Bhante, to pay homage to the compassionate Sage in this world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_14:19.1"], "en": "The second account of the mother of the Elder Sāriputta who had become a peta.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"}
]
