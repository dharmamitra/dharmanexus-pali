[
{"segs": ["PA_tha-ap_543:0.1", "PA_tha-ap_543:0.2"], "en": "The Apadāna of the Elder Lakuṇḍaka-Bhaddiya Bhaddiya Chapter 1:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:0.3"], "en": "The Apadāna of the Elder Lakuṇḍaka-Bhaddiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:1.2"], "en": "the one with vision regarding all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:1.3"], "en": "[appeared] one hundred thousand aeons hence.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:1.4"], "en": "The Leader appeared in that eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:2.1", "PA_tha-ap_543:2.2"], "en": "At that time, I was the son of a wealthy merchant in Haṃsavatī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:2.3"], "en": "While wandering on a walking tour,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:2.4"], "en": "I went to the monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:3.1"], "en": "At that time, the Lamp of the World—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:3.2"], "en": "The Leader taught the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:3.3", "PA_tha-ap_543:3.4"], "en": "he extolled his disciple Mañjussarā, the most excellent among those with beautiful voices.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:4.1"], "en": "Having heard that, becoming joyful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:4.2"], "en": "and having performed service for the Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:4.3"], "en": "he paid homage at the feet of the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:4.4"], "en": "I aspired for that state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:5.1", "PA_tha-ap_543:5.2"], "en": "Then the Buddha, the Guide, prophesied it in the midst of the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:5.3"], "en": "“In a future time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:5.4"], "en": "you shall obtain that heart’s desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:6.1"], "en": "In a hundred thousand aeons, [you will attain it].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:6.2"], "en": "Born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:6.3", "PA_tha-ap_543:6.4"], "en": "he will be a teacher in the world named Gotama by lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:7.1"], "en": "His heir in the Dhammas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:7.2"], "en": "his own legitimate son, fashioned by the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:7.3"], "en": "was named Bhaddiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:7.4"], "en": "He will become a disciple of the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:8.1"], "en": "By that well-performed deed and by his volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:8.2"], "en": "[he will attain the goal].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:8.3"], "en": "Having cast off my human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:8.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:9.1"], "en": "Ninety-two eons ago from now, I attained that state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:9.2"], "en": "Phussa appeared as the Leader;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:9.3"], "en": "difficult to approach and difficult to overcome,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:9.4"], "en": "the Conqueror, supreme over the entire world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:10.1"], "en": "Endowed with conduct, tall,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:10.2"], "en": "upright, and majestic,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:10.3"], "en": "seeking the welfare of all beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:10.4"], "en": "You have liberated many from their bonds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:11.1", "PA_tha-ap_543:11.2"], "en": "In that Nandārāma grove, I was his Phussa cuckoo.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:11.3", "PA_tha-ap_543:11.4"], "en": "I was dwelling in an ambarama tree near the Gandhakuṭī. Then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:12.1"], "en": "as I was going for alms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:12.2"], "en": "Having seen the Supreme Victor, the one worthy of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:12.3", "PA_tha-ap_543:12.4"], "en": "I gladdened my heart and uttered a sweet song.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:13.1", "PA_tha-ap_543:13.2", "PA_tha-ap_543:13.3"], "en": "Then, having gone to the royal garden and taken a cluster of mangoes that were well-ripened and golden-skinned, he—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:13.4"], "en": "I offered it to the Fully Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:14.1"], "en": "Then, knowing my mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:14.2"], "en": "the Victor, the Greatly Compassionate One, [acted].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:14.3", "PA_tha-ap_543:14.4"], "en": "The Leader took the bowl from the hand of his attendant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:15.1"], "en": "with a joyful heart, I gave it to him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:15.2", "PA_tha-ap_543:15.3"], "en": "O Great Sage, having placed a ball of mangoes into your bowl,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:15.4"], "en": "he joined his palms and spoke with gentle words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:16.1"], "en": "Raining with a voice that is essential,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:16.2"], "en": "delightful, and melodious,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:16.3"], "en": "for the sake of worshipping the Buddha—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:16.4"], "en": "Having gone to my nest, I lay down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:17.1"], "en": "At that time, my heart was joyful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:17.2"], "en": "for my inclination was fixed in love for the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:17.3"], "en": "A hawk approached and,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:17.4"], "en": "with a wicked mind, killed me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:18.1"], "en": "having passed away from there, I was reborn in the Tusita heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:18.2"], "en": "Having experienced great bliss,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:18.3", "PA_tha-ap_543:18.4"], "en": "I have come to a human birth by the power of that karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:19.1"], "en": "In this auspicious aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:19.2"], "en": "there was one of great renown, a kinsman of Brahmā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:19.3"], "en": "known by the clan name Kassapa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:19.4"], "en": "The best among those who debate arose.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:20.1", "PA_tha-ap_543:20.2"], "en": "Having illuminated the teaching and having overcome the false teachers, he—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:20.3"], "en": "Having disciplined those worthy of discipline,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:20.4", "PA_tha-ap_543:21.1"], "en": "he, together with his disciples, has attained Nibbāna. Now that the Foremost One in the world has passed into Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:21.2"], "en": "Many people, full of faith,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:21.3", "PA_tha-ap_543:21.4"], "en": "build stūpas for the Teacher in order to honor the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:22.1", "PA_tha-ap_543:22.2", "PA_tha-ap_543:22.3"], "en": "“We shall build for the Great Sage a stupa seven yojanas in height, adorned with the seven precious gems.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:22.4"], "en": "Thus did they deliberate,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:23.1", "PA_tha-ap_543:23.2"], "en": "those Kīkino, while the leader of the army of the King of Kāsi was at that time [there].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:23.3", "PA_tha-ap_543:23.4"], "en": "Having offered at the cetiya, I spoke of a measure for that which is immeasurable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:24.1"], "en": "Then, by my word, they—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:24.2", "PA_tha-ap_543:24.3"], "en": "They built a stupa one yojana high for the Hero among Men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:24.4"], "en": "adorned with various kinds of jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:25.1", "PA_tha-ap_543:25.2"], "en": "By that well-performed kamma and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:25.3"], "en": "having abandoned this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:25.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:26.1"], "en": "And now, in my final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:26.2"], "en": "I was born into a family of wealthy merchants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:26.3"], "en": "In the preeminent city of Sāvatthī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:26.4"], "en": "prosperous, flourishing, and possessing great wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:27.1"], "en": "[the people welcomed] the Sugata upon his entry into the city.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:27.2"], "en": "Having seen this, my mind was filled with wonder;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:27.3"], "en": "not long after going forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:27.4"], "en": "I attained arhatship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:28.1", "PA_tha-ap_543:28.2"], "en": "Because of that deed of making a cetiya of such proportions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:28.3"], "en": "I have come to have a body like that of Lakuṇḍaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:28.4"], "en": "Born worthy of honor, I,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:29.1", "PA_tha-ap_543:29.2"], "en": "having honored the best of seers with my sweet voice, [spoke].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:29.3", "PA_tha-ap_543:29.4"], "en": "I attained the state of preeminence among the monks of sweet voice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:30.1"], "en": "through the offering of fruit to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:30.2"], "en": "And by recollecting his qualities,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:30.3", "PA_tha-ap_543:30.4"], "en": "I dwell, having attained the fruits of recluseship, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:31.1"], "en": "The defilements have been incinerated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:31.2"], "en": "all states of existence have been uprooted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:31.3"], "en": "like a naga who has severed its bonds, I am free.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:31.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:32.1", "PA_tha-ap_543:32.2"], "en": "Welcome indeed has come to me in the presence of the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:32.3"], "en": "The three true insights have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:32.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:33.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:33.2", "PA_tha-ap_543:33.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:33.4"], "en": "and the teaching of the Buddha has been accomplished.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:34.1"], "en": "Thus indeed the venerable elder Lakuṇḍabhaddiya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_543:35.1"], "en": "This is the first legend of the elder Lakuṇḍabhaddiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
