[
{"segs": ["PA_tha-ap_252:0.1", "PA_tha-ap_252:0.2", "PA_tha-ap_252:0.3"], "en": "The Apadāna of the Elder Uddālakadāyaka, from the Tuvaradāyaka Chapter, Number Ten.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:1.1", "PA_tha-ap_252:1.2"], "en": "“The Self-Existent One, Aparājita, known by the name Kakudha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:1.3"], "en": "having emerged from the forest,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:1.4"], "en": "Having reached the great river,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:2.1", "PA_tha-ap_252:2.2"], "en": "I took some uddālaka grass and offered it to the Self-Existent One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:2.3"], "en": "For me, who was self-restrained, upright,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:2.4"], "en": "and possessed of a serene mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:3.1"], "en": "thirty-one eons ago from now—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:3.2"], "en": "Whatever flower I offered in worship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:3.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:3.4"], "en": "this is the fruit of the gift of flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:4.1", "PA_tha-ap_252:4.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:5.1"], "en": "Thus indeed the venerable elder Uddālakadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:6.1"], "en": "This is the tenth legend of the elder Uddālakadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:7.1"], "en": "The twenty-fifth chapter, the Tuvaradāyaka-vagga, is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:8.1", "PA_tha-ap_252:9.1"], "en": "Its summary verse (uddāna) is: Tuvara, Nāga,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:9.2"], "en": "Naḷina, Viravī, Kuṭi, Dhūpaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:9.3"], "en": "The *Patta*, *Dhātusattaliya*,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:9.4"], "en": "*Bimbi*, and *Uddālaka*;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:9.5"], "en": "thirty-seven verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_252:9.6"], "en": "They are counted by those possessed of supernatural power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
