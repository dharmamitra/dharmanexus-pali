[
{"segs": ["PA_tha-ap_68:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:0.2"], "en": "The Chapter on Those to Be Contemplated by Oneself (Sakacintaniyavagga) 6.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:0.3"], "en": "The Apadāna of the Elder Sucintita (Sucintitatthera-apadāna)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:1.1", "PA_tha-ap_68:1.2"], "en": "“I was one who roamed the mountain fastnesses, like a noble lion;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:1.3"], "en": "having slain a herd of deer, I dwelt there.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:1.4"], "en": "I live within the mountains.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:2.1"], "en": "But the Blessed One Atthadassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:2.2"], "en": "the omniscient one, the best among speakers—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:2.3"], "en": "Desiring to rescue me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:2.4"], "en": "he came to that supreme mountain;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:3.1"], "en": "having slain a deer of serene appearance, he...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:3.2"], "en": "I approached in order to eat;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:3.3", "PA_tha-ap_68:3.4"], "en": "at that very time, the Blessed One arrived while wandering for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:4.1"], "en": "Having taken choice pieces of meat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:4.2"], "en": "I gave them to that Teacher;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:4.3"], "en": "the Great Hero expressed his approval.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:4.4"], "en": "Extinguishing me at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:5.1"], "en": "through that clarity of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:5.2"], "en": "I entered the mountain pass.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:5.3"], "en": "Having generated rapture,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:5.4", "PA_tha-ap_68:6.1"], "en": "I passed away there because of this gift of flesh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:6.2"], "en": "And through the aspirations of my mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:6.3"], "en": "for one hundred and fifteen eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:6.4"], "en": "I rejoiced in the world of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:7.1"], "en": "In all the remaining eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:7.2"], "en": "wholesome deeds were contemplated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:7.3"], "en": "solely because of that gift of meat, [I attained this state].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:7.4"], "en": "And by the recollection of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:8.1"], "en": "In the thirty-eighth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:8.2"], "en": "there were eight [Buddhas] named Dīghāyu.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:8.3"], "en": "In the sixtieth century of the kappa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:8.4"], "en": "there were two named Varuṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:9.1"], "en": "they possessed the four analytical knowledges (paṭisambhidā).", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:9.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:9.3"], "en": "the Buddha's instruction has been fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:10.1"], "en": "Thus indeed did the Venerable Thera Sucintita speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_68:11.1"], "en": "The legend of the Elder Sucintita is the sixth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
