[
{"segs": ["PA_tha-ap_319:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:0.2"], "en": "Ārakkhadāyakavagga 7.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:0.3"], "en": "The Apadāna of the Elder Saddasaññaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:1.1"], "en": "“Sudassana, the Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:1.2"], "en": "teaches the deathless state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:1.3"], "en": "surrounded by his disciples.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:1.4"], "en": "He dwells in a supreme house.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:2.1"], "en": "With those sweet words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:2.2"], "en": "he wins over the great multitude.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:2.3"], "en": "The proclamation was vast,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:2.4"], "en": "reaching both gods and humans;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:3.1"], "en": "having heard the sound of that cry, [they came].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:3.2", "PA_tha-ap_319:3.3"], "en": "Having inspired confidence in my mind through the voice of the Great Sage Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:3.4"], "en": "I paid homage to the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:4.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:4.2"], "en": "when I attained that perception,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:4.3"], "en": "I do not recall ever being born in an evil state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:4.4"], "en": "This is the fruit of the perception of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:5.1", "PA_tha-ap_319:5.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:6.1"], "en": "Thus indeed did the venerable elder Saddasaññaka recite these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_319:7.1"], "en": "This is the seventh legend of the elder Saddasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
