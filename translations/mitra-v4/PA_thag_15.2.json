[
{"segs": ["PA_thag_15.2:0.1"], "en": "Theragāthā 15.2,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:0.2"], "en": "Soḷasakanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:0.3"], "en": "First Chapter (Paṭhamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:0.4"], "en": "The Verses of the Elder Udāyi:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:1.1"], "en": "“To the Fully Awakened One who has become human,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:1.2"], "en": "self-tamed and composed;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:1.3"], "en": "Walking upon the path of the Brahmās,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:1.4"], "en": "delighting in the tranquility of the mind—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:2.1"], "en": "him do people revere.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:2.2"], "en": "To him who has reached the further shore of all phenomena—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:2.3"], "en": "even the gods pay homage to him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:2.4"], "en": "thus have I heard from the Arahant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:3.1"], "en": "One who has transcended all fetters,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:3.2"], "en": "come from the forest to the state beyond the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:3.3"], "en": "and delights in renunciation of sensual pleasures—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:3.4"], "en": "Like gold from a rock,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:4.1"], "en": "he is indeed a Naga of exceeding brilliance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:4.2"], "en": "like the Himalayas among other mountains.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:4.3", "PA_thag_15.2:4.4"], "en": "Of all those named \"Nāga,\" he whose name is Truth is unsurpassed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:5.1"], "en": "I shall proclaim the Nāga to you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:5.2"], "en": "For he commits no offense;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:5.3", "PA_thag_15.2:5.4"], "en": "gentleness and non-violence are those two feet of the Naga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:6.1"], "en": "Mindfulness and clear comprehension—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:6.2"], "en": "these are the other three feet of the Naga;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:6.3"], "en": "the Great Naga has faith as his trunk.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:6.4"], "en": "Equanimity is its white tusks;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:7.1"], "en": "mindfulness is the neck and wisdom the head;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:7.2"], "en": "investigation is the reflection on the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:7.3"], "en": "The Dhamma-body is his dwelling,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:7.4"], "en": "seclusion is his tail;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:8.1"], "en": "he is a meditator, devoted to inhalation and exhalation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:8.2"], "en": "Well-composed within himself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:8.3"], "en": "the Naga goes composed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:8.4"], "en": "the Naga stands composed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:9.1"], "en": "The Nāga is concentrated when walking,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:9.2"], "en": "concentrated when sitting;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:9.3"], "en": "the Nāga is restrained in every respect.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:9.4"], "en": "This is the perfection of the Naga:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:10.1", "PA_thag_15.2:10.2"], "en": "he eats what is blameless and does not eat what is blameworthy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:10.3"], "en": "Having obtained grass and clothing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:10.4"], "en": "avoiding the hoarding of possessions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:11.1"], "en": "[one should abandon] fetters, both subtle and gross.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:11.2"], "en": "Having cut every bond,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:11.3"], "en": "wherever one goes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:11.4"], "en": "one goes without looking back.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:12.1", "PA_thag_15.2:12.2"], "en": "Just as the white lotus, born in the water, grows therein,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:12.3"], "en": "yet is not defiled by the water;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:12.4"], "en": "Pure-scented and delightful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:13.1"], "en": "Likewise, born into the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:13.2"], "en": "the Buddha dwells in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:13.3"], "en": "He is not defiled by the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:13.4"], "en": "just as a lotus is not wetted by water.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:14.1"], "en": "Like a great fire blazing forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:14.2"], "en": "It is pacified by the absence of fuel;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:14.3"], "en": "and while embers still exist,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:14.4"], "en": "it is nevertheless called \"extinguished.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:15.1", "PA_thag_15.2:15.2"], "en": "This simile, taught by the wise for the purpose of making the meaning known,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:15.3"], "en": "will be understood by the Great Nagas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:15.4"], "en": "This was taught by the Naga to the Naga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:16.1"], "en": "Free from passion, free from hatred,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:16.2"], "en": "free from delusion, and without taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:16.3"], "en": "“Casting off the body, the Naga,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:16.4"], "en": "free from taints, will attain final Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:16.5"], "en": "… Thus spoke the Elder Udāyī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:16.6"], "en": "The Sixteen-Section Chapter is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:17.0", "PA_thag_15.2:17.1"], "en": "Therein is this summary verse: Koṇḍañña and Udāyī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:17.2"], "en": "Those two elders possessed great supernormal power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:17.3"], "en": "in the sixteenth nipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.2:17.4"], "en": "there are thirty-two verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
