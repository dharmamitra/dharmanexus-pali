[
{"segs": ["PA_tha-ap_354:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:0.2"], "en": "Saddasaññaka-vagga, 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:0.3"], "en": "The Apadāna of the Elder Yavakalāpiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:1.1", "PA_tha-ap_354:1.2"], "en": "“At that time, in the city of Araṇavatī, I was a provider of fodder;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:1.3"], "en": "having seen the Perfectly Enlightened One on the road, I gave him grass.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:1.4"], "en": "I spread out a bundle of barley.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:2.1"], "en": "Compassionate and merciful was Sikhi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:2.2"], "en": "the world’s supreme leader.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:2.3"], "en": "Knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:2.4"], "en": "he sat down upon a layer of straw;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:3.1"], "en": "seeing him sitting there, stainless, [I spoke].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:3.2", "PA_tha-ap_354:3.3"], "en": "Having generated great joy toward that leader, the great meditator,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:3.4"], "en": "I passed away there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:4.1"], "en": "In the thirty-first aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:4.2"], "en": "because of the deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:4.3"], "en": "I do not know any state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:4.4"], "en": "As long as this fruit remains,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:5.1", "PA_tha-ap_354:5.2"], "en": "there are the four analytical knowledges (*paṭisambhidā*), and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:5.3"], "en": "\"Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:6.1"], "en": "Thus indeed did the Venerable Elder Yavakalāpiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_354:7.1"], "en": "This is the second legend of the Elder Yavakalāpiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
