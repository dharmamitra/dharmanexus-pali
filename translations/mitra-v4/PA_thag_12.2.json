[
{"segs": ["PA_thag_12.2:0.1", "PA_thag_12.2:0.2", "PA_thag_12.2:0.3"], "en": "Theragāthā 12.2 Dvādasaka-nipāta Paṭhama-vagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:0.4"], "en": "The Verses of the Elder Sunīta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:1.1"], "en": "“I was born into a lowly family,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:1.2"], "en": "poor and with little to eat;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:1.3"], "en": "My work was lowly;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:1.4"], "en": "I was a flower-scatterer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:2.1"], "en": "loathed by people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:2.2"], "en": "Treated with contempt and reviled,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:2.3"], "en": "having humbled my mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:2.4"], "en": "I shall pay homage to many people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:3.1"], "en": "Then I saw the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:3.2", "PA_thag_12.2:3.3"], "en": "the Great Hero, entering while being honored by the community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:3.4", "PA_thag_12.2:4.1", "PA_thag_12.2:4.2"], "en": "Having set aside my walking staff, I approached the supreme city of Magadha to pay homage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:4.3"], "en": "Out of compassion for me alone,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:4.4"], "en": "the Supreme Person remained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:5.1"], "en": "having paid homage at the Teacher’s feet, he stood there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:5.2"], "en": "Standing then at one side,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:5.3"], "en": "I requested the going-forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:5.4"], "en": "supreme among all beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:6.1"], "en": "Then the compassionate Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:6.2"], "en": "who has pity for the entire world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:6.3"], "en": "said to me: “Come, bhikkhu.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:6.4"], "en": "That was my full ordination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:7.1", "PA_thag_12.2:7.2"], "en": "Dwelling alone in the forest, untiring, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:7.3"], "en": "I carried out the Teacher’s word,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:7.4"], "en": "just as the Jina instructed me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:8.1"], "en": "During the first watch of the night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:8.2"], "en": "I recollected my former births;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:8.3"], "en": "during the middle watch of the night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:8.4"], "en": "I purified the divine eye.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:8.5"], "en": "In the last watch of the night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:8.6"], "en": "I shattered the mass of darkness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:9.1"], "en": "then, at the break of dawn,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:9.2"], "en": "At the rising of the sun,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:9.3", "PA_thag_12.2:9.4"], "en": "Indra and Brahmā came and paid homage to me with palms joined.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:10.1"], "en": "\"Homage to you, O noble steed among men!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:10.2"], "en": "Homage to you, O supreme among men!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:10.3"], "en": "You whose taints are exhausted.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:10.4"], "en": "\"You are worthy of offerings, dear sir.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:11.1", "PA_thag_12.2:11.2"], "en": "Then, having seen me honored by the assembly of gods, the Teacher—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:11.3"], "en": "Having manifested a smile,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:11.4"], "en": "he spoke this meaning:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:12.1"], "en": "“By austerity and by the holy life...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:12.2"], "en": "“Through self-restraint and through self-control—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:12.3"], "en": "one becomes a brahmin by this;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:12.4"], "en": "this is the supreme brahminship.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:12.5", "PA_thag_12.2:12.6"], "en": "… The Elder Sunīta … The Twelfth Chapter is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:13.0"], "en": "Herein is the summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:13.1"], "en": "Sīlavā and Sunīta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:13.2"], "en": "these two elders possessed great supernormal power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:13.3"], "en": "in the twelfth nipāta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_12.2:13.4"], "en": "\"Twenty-four verses.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
