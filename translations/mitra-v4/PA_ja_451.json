[
{"segs": ["PA_ja_451:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:0.2"], "en": "The Collection of Tens,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:0.3"], "en": "Chapter on the Four Gates (Catudvāravagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:0.4", "PA_ja_451:1.1"], "en": "13. The Cakkavāka Jātaka “You are handsome and beautiful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:1.2"], "en": "with a thick body covered in fine down;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:1.3"], "en": "You are as handsome as a ruddy goose,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:1.4"], "en": "with serene face and faculties;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:2.1"], "en": "[you resemble] the pāṭhīna and pāvusa fish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:2.2"], "en": "\"Having eaten the meat of the balaja and muñja-deer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:2.3", "PA_ja_451:2.4"], "en": "you sit on the bank of the Ganges and eat your meal in this manner.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:3.1"], "en": "“I do not eat this,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:3.2"], "en": "whether it be meat from the wild or water-born;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:3.3"], "en": "except for algae and moss.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:3.4"], "en": "“This is my food, good sir.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:4.1", "PA_ja_451:4.2"], "en": "“I do not believe this to be the food of a ruddy goose.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:4.3", "PA_ja_451:4.4"], "en": "I too, friend, eat salted oil-cake from the village—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:5.1"], "en": "the food prepared by people.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:5.2"], "en": "Pure, with meat as its sauce;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:5.3", "PA_ja_451:5.4"], "en": "yet my complexion is not like yours, O Cakravāka.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:6.1"], "en": "“Seeing enmity within yourself,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:6.2"], "en": "you devour the human race with violence;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:6.3"], "en": "terrified and afraid, you consume them.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:6.4"], "en": "Therefore your complexion is such as this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:7.1"], "en": "You are an enemy to the whole world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:7.2"], "en": "O vulture, because of your evil deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:7.3"], "en": "The alms-food obtained does not satisfy me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:7.4"], "en": "therefore, your complexion is such as this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:8.1"], "en": "I too, my friend, eat [only] this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:8.2"], "en": "Non-violence toward all living beings;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:8.3", "PA_ja_451:8.4"], "en": "free from anxiety, without fear, sorrowless, and secure from all quarters.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:9.1"], "en": "Therefore, exert your power,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:9.2"], "en": "transcend the state of a mere moralist,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:9.3"], "en": "and live in the world with harmlessness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:9.4"], "en": "You will become dear to me, just as I am,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:10.1"], "en": "you who neither kill nor causes to kill,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:10.2"], "en": "neither conquers nor causes to conquer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:10.3"], "en": "\"Having loving-kindness toward all beings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:10.4"], "en": "he has no enmity toward anyone.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_451:11.1"], "en": "Thus ends the Thirteenth Jātaka, the Cakkavāka Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
