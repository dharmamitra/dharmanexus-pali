[
{"segs": ["PA_ja_309:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:0.2"], "en": "The Section of Fours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:0.3"], "en": "Chapter on Kāliṅga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:0.4"], "en": "9. The Chavaka Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:1.1"], "en": "“All this has been done for the last time;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:1.2"], "en": "both of you do not perceive the Dhamma.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:1.3"], "en": "Both have passed away from their natural state:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:1.4"], "en": "he who causes the mantra to be recited,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:1.5"], "en": "and he who studies the mantra.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:2.1"], "en": "“I eat fine rice porridge,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:2.2"], "en": "pure and seasoned with meat;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:2.3"], "en": "therefore, I do not indulge in this.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:2.4"], "en": "\"The Dhamma practiced by the seers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:3.1"], "en": "\"The great world wanders about,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:3.2"], "en": "cooking other living beings as well.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:3.3", "PA_ja_309:3.4"], "en": "Let not unrighteousness practiced by you shatter us like a water-jar;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:4.1"], "en": "woe be to that gain of fame!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:4.2"], "en": "And as for the acquisition of wealth, O Brahmin:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:4.3", "PA_ja_309:4.4"], "en": "that livelihood which comes through falling into ruin or through practicing unrighteousness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_309:5.1"], "en": "The Chavaka Jātaka, the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
