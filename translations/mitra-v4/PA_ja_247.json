[
{"segs": ["PA_ja_247:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_247:0.2", "PA_ja_247:0.3"], "en": "The Second Book of Pairs, The Chapter on the Jackal (Siṅgālavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_247:0.4"], "en": "7. The Pādañjalī Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_247:1.1", "PA_ja_247:1.2"], "en": "\"Truly, Pādañjalī excels all others in wisdom.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_247:1.3"], "en": "\"For he bites his lip;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_247:1.4"], "en": "surely he sees something further.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_247:2.1"], "en": "\"He does not distinguish between what is Dhamma and what is non-Dhamma,\" [the other replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_247:2.2"], "en": "One awakens to what is meaningful and what is meaningless;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_247:2.3"], "en": "apart from the movement of the lips,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_247:2.4"], "en": "this person knows nothing at all.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_247:3.1"], "en": "The Pādañjalījātaka, the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
