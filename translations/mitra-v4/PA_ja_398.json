[
{"segs": ["PA_ja_398:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:0.2", "PA_ja_398:0.3"], "en": "The Section of Sevens, Chapter on the Hen-Fowl (Kukkuvagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:0.4"], "en": "3. The Sutanu Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:1.1", "PA_ja_398:1.2"], "en": "“O King, he has sent you food—pure meat with a sauce.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:1.3", "PA_ja_398:1.4"], "en": "“Come, inhabitant of Maghadeva, go forth and eat!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:2.1"], "en": "“Come, young man, wait a moment;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:2.2"], "en": "\"Having taken well-prepared alms-food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:2.3", "PA_ja_398:2.4"], "en": "both you, young man, and the alms-food itself, shall become food for each other.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:3.1"], "en": "“By a small thing, O yakkha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:3.2"], "en": "you will lose a great matter;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:3.3"], "en": "they will not bring alms to you.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:3.4"], "en": "People are mindful of death.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:4.1"], "en": "Having received your constant alms-offering—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:4.2"], "en": "pure, excellent, and endowed with the finest flavors— the yakkhas are satisfied.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:4.3"], "en": "“A man must bring almsfood to you here;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:4.4"], "en": "it will be very difficult to find such food once I have been eaten.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:5.1"], "en": "“My own welfare is what matters to me,” said Sutano.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:5.2"], "en": "Just as you have spoken, young man;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:5.3"], "en": "I give you my permission—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:5.4"], "en": "may you see your mother in safety.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:6.1", "PA_ja_398:6.2"], "en": "O young man, taking your sword, umbrella, and bowl as you go,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:6.3"], "en": "may your mother see you safely.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:6.4"], "en": "\"And you too, look upon your mother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:7.1", "PA_ja_398:7.2"], "en": "\"Thus, O Yakkha, may you be happy together with all your kinsmen.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:7.3"], "en": "\"Wealth has been acquired by me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:7.4"], "en": "and the king’s word has been carried out.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_398:8.1"], "en": "Thus ends the third Jātaka, the Sutanujātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
