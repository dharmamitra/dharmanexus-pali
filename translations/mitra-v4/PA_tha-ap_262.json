[
{"segs": ["PA_tha-ap_262:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:0.2"], "en": "The Chapter on Praise (Thomakavagga) 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:0.3"], "en": "The Apadāna of the Elder Aggapupphiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:1.1"], "en": "“The Sambuddha, golden-hued,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:1.2"], "en": "seated amidst the mountains,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:1.3"], "en": "illuminating everything with his radiance.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:1.4", "PA_tha-ap_262:2.1"], "en": "Just as one might take the crest-flower from among crested birds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:2.2"], "en": "I approached the Supreme among Men, taking that flower.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:2.3"], "en": "With a serene mind and joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:2.4"], "en": "I offered [this] to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:3.1"], "en": "Thirty-one eons ago from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:3.2"], "en": "Because I offered this flower in worship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:3.4"], "en": "this is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:4.1"], "en": "In the twenty-fifth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:4.2"], "en": "there was Amitodgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:4.3"], "en": "endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:4.4"], "en": "A wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:5.1", "PA_tha-ap_262:5.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:6.1"], "en": "In this way, it is said, the venerable elder Aggapupphiya recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:7.1"], "en": "This is the tenth legend of the elder Aggapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:8.1"], "en": "The twenty-sixth chapter is the Thomakavagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:9.1"], "en": "Its summary (uddāna) is:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:10.1"], "en": "Thomaka, Eka, Āsana, and Citaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:10.2"], "en": "Campaka, Sattapāṭali,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:10.3", "PA_tha-ap_262:10.4"], "en": "Pānadhi, Mañjarī, Paṇṇa, Kuṭida, and Aggapupphiya;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_262:10.5", "PA_tha-ap_262:10.6"], "en": "And here, the verses are counted as exactly forty-one.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
