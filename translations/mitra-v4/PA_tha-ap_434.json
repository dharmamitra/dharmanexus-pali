[
{"segs": ["PA_tha-ap_434:0.1", "PA_tha-ap_434:0.2", "PA_tha-ap_434:0.3"], "en": "The Apadāna of the Elder Ekasaṅkhiya Ekavihārivagga 2. Ekasaṅkhiyattheraapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:1.1"], "en": "“For the Blessed One Vipassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:1.2"], "en": "there was a great festival for the Bodhi tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:1.3"], "en": "a great multitude of people having gathered together, [celebrated it].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:1.4"], "en": "They worship the supreme Bodhi tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:2.1"], "en": "I do not consider it insignificant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:2.2"], "en": "he will become the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:2.3", "PA_tha-ap_434:2.4"], "en": "Since this enlightenment of the Teacher is so worthy of worship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:3.1"], "en": "he then took up the conch shell.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:3.2"], "en": "I attended upon the Bodhi tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:3.3"], "en": "fanning it all day long,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:3.4"], "en": "I paid homage to the supreme Bodhi.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:4.1", "PA_tha-ap_434:4.2"], "en": "The deed performed when I was near death has brought me to the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:4.3"], "en": "my physical body has fallen away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:4.4"], "en": "I delight in the world of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:5.1"], "en": "Sixty thousand musical instruments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:5.2"], "en": "joyful, thrilled, and gladdened, [resound].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:5.3"], "en": "These always manifest for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:5.4"], "en": "this is the fruit of worshiping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:6.1"], "en": "In the seventy-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:6.2"], "en": "I was King Sudassana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:6.3"], "en": "a conqueror of the four quarters,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:6.4"], "en": "lord of the Jambudvīpa realm.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:7.1", "PA_tha-ap_434:7.2"], "en": "Then hundreds of musical instruments always surrounded me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:7.3"], "en": "I experienced the fruit of my own karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:7.4"], "en": "This is the fruit of my attendance:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:8.1"], "en": "whatever womb I am reborn into,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:8.2"], "en": "whether among the gods or among humans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:8.3"], "en": "Even while he was still in his mother’s womb,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:8.4"], "en": "drums were sounded constantly;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:9.1"], "en": "having attended upon the Perfectly Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:9.2"], "en": "Having experienced these attainments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:9.3"], "en": "I have reached the auspicious, blissful, deathless,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:9.4"], "en": "and unshakable state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:10.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:10.2"], "en": "because of the deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:10.3"], "en": "I have not known a miserable rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:10.4"], "en": "This is the fruit of worshiping the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:11.1", "PA_tha-ap_434:11.2"], "en": "my defilements have been incinerated... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:11.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:12.1"], "en": "Welcome indeed has come to me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:12.2"], "en": "…pe…", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:12.3"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:13.1"], "en": "the four analytical knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:13.2"], "en": "…pe…", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:13.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:14.1"], "en": "Thus indeed did the venerable elder Ekasaṅkhiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_434:15.1"], "en": "This is the second legend of the elder Ekasaṅkhiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
