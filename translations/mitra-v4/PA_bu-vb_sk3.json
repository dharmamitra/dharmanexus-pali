[
{"segs": ["PA_bu-vb_sk3:0.1"], "en": "The Theravāda Vinaya Mahāvibhaṅga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:0.2", "PA_bu-vb_sk3:0.3"], "en": "Chapter on the Training Rules (Sekhiyakaṇḍa)", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:0.4"], "en": "The Chapter on the Circular [Garment] 3.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:0.5"], "en": "The Training Rule on Being Well-Covered.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:1.1"], "en": "At that time, the Buddha, the Blessed One, was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:1.2"], "en": "Now at that time, the group-of-six monks went through inhabited areas with their bodies uncovered...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:1.3.1"], "en": "[as before] ... \"The training is to be observed: 'I will go through inhabited areas well-covered.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:1.4"], "en": "One should go through inhabited areas well-covered.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:1.5"], "en": "Whoever, out of disrespect, goes through an inhabited area with the body uncovered commits an offense of wrong-doing (dukkaṭa).", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:1.6.1", "PA_bu-vb_sk3:1.7"], "en": "There is no offense if it was unintentional.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:1.8"], "en": "For one who is lacking mindfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:1.9"], "en": "for one who is unaware,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:1.10"], "en": "and for one who is ill.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:1.11"], "en": "In times of distress,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:1.12"], "en": "for one who is insane,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:1.13"], "en": "and for the first offender.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk3:1.14"], "en": "The third training rule is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
