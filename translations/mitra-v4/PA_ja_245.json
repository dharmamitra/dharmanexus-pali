{"segs": ["PA_ja_245:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_245:0.2", "PA_ja_245:0.3"], "en": "The Second Book of Pairs, Chapter on the Jackal (Siṅgālavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_245:0.4"], "en": "5. The Mūlapariyāya Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_245:1.1", "PA_ja_245:1.2"], "en": "“Time devours all beings, including itself.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_245:1.3", "PA_ja_245:1.4"], "en": "But he who has become a devourer of beings cooks those who cook living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_245:2.1"], "en": "Many heads of men—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_245:2.2"], "en": "\"Hairy and long;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_245:2.3"], "en": "they are fastened around the necks—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_245:2.4"], "en": "perhaps someone here has ears.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_245:3.1"], "en": "The Mūlapariyāya Jātaka is the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
