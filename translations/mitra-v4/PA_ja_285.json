[
{"segs": ["PA_ja_285:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:0.2", "PA_ja_285:0.3"], "en": "The Section of Three (Tikanipāta), Chapter on the Inner Circle (Abbhantaravagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:0.4"], "en": "5. The Maṇisūkara Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:1.1", "PA_ja_285:1.2"], "en": "“From the river we have dwelt for seven years, and for about thirty more.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:1.3"], "en": "\"We shall destroy the radiance of the gem\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:1.4"], "en": "such was our deliberation;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:2.1"], "en": "as long as we were rubbing the gem, [it continued to shine].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:2.2"], "en": "The gem becomes even more purified;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:2.3"], "en": "now we ask this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:2.4"], "en": "what do you consider to be the task to be done here?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:3.1"], "en": "“This beryl gem is flawless,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:3.2"], "en": "stainless, and beautiful;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:3.3"], "en": "it is impossible to destroy its splendor.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:3.4"], "en": "“Depart, you swine!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_285:4.1"], "en": "This is the fifth Jātaka, the Maṇisūkara-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
