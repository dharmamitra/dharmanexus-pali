[
{"segs": ["PA_ja_489:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:0.2"], "en": "Miscellaneous Section,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:0.3"], "en": "Chapter on the Rice Field of Śālī Rice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:0.4"], "en": "6. The Suruci Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:1.1", "PA_ja_489:1.2"], "en": "“I was the chief queen, the wife of Suruci, whom he first brought home.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:1.3"], "en": "For ten thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:1.4", "PA_ja_489:2.1"], "en": "O Brahmin, Suruci brought me to the king. I, that very person, [served] the king.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:2.2", "PA_ja_489:2.3"], "en": "I am not aware of having ever harmed the King of Videha or the city of Mithilā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:2.4"], "en": "whether by body, speech, or mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:2.5", "PA_ja_489:2.6"], "en": "He despised Suruci both openly and in secret.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:3.1"], "en": "By this declaration of truth, [may my body be restored].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:3.2", "PA_ja_489:3.3"], "en": "If I am telling a lie when saying that a son was born to this seer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:3.4"], "en": "may my head split into seven pieces!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:4.1"], "en": "My husband’s mother is my mother,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:4.2"], "en": "and his father is my father as well;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:4.3"], "en": "O Brahmā, they are my guides.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:4.4"], "en": "I remained there for as long as life lasted.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:5.1"], "en": "Delighting in non-violence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:5.2"], "en": "I lived according to the Dharma out of my own desire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:5.3"], "en": "I attended upon you with care,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:5.4"], "en": "untiring by day and night.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:6.1"], "en": "By this utterance of truth, may [my wish be fulfilled].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:6.2"], "en": "A son was born to me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:6.3", "PA_ja_489:6.4"], "en": "O Lord; may my head split into seven pieces if I have spoken a falsehood.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:7.1", "PA_ja_489:7.2"], "en": "O Brahmin, among those sixteen thousand women who were my wives,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:7.3"], "en": "there was neither envy nor anger.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:7.4"], "en": "Never have I had [such feelings];", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:8.1"], "en": "I rejoice in their welfare,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:8.2"], "en": "and none among them is unloved by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:8.3"], "en": "Out of compassion for myself,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:8.4"], "en": "and always for all my co-wives,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:9.1"], "en": "by this utterance of truth—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:9.2", "PA_ja_489:9.3"], "en": "If I am speaking falsely, O Seer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:9.4"], "en": "may my head split into seven pieces as my son is being born!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:10.1"], "en": "To slaves, laborers, and servants,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:10.2"], "en": "and to others who depend on me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:10.3"], "en": "I send them forth according to the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:10.4"], "en": "With senses always joyful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:11.1"], "en": "By this utterance of truth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:11.2"], "en": "O Lord, may a son be born to you!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:11.3"], "en": "If I am speaking falsely,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:11.4"], "en": "may my head split into seven pieces,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:12.1"], "en": "even regarding recluses and brahmins.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:12.2"], "en": "And other mendicants as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:12.3"], "en": "I always satisfy with food and drink,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:12.4"], "en": "my hands ever pure.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:13.1"], "en": "By this utterance of truth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:13.2"], "en": "O Sage, may a son be born to me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:13.3"], "en": "if I were speaking a falsehood, [may my head split apart].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:13.4", "PA_ja_489:14.1"], "en": "May his head split into seven pieces on the fourteenth, the fifteenth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:14.2"], "en": "and the eighth day of the fortnight.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:14.3"], "en": "I observe the Uposatha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:14.4"], "en": "endowed with its eight factors,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:14.5"], "en": "on the fortnight of miracles.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:14.6"], "en": "Always restrained in their virtuous conduct.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:15.1"], "en": "By this utterance of truth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:15.2"], "en": "O Sage, may a son be born to you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:15.3", "PA_ja_489:15.4"], "en": "“If I am speaking falsely, may my head split into seven pieces! “All those qualities of the Dhamma...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:16.1"], "en": "[are present in you].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:16.2"], "en": "O illustrious princess,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:16.3", "PA_ja_489:16.4"], "en": "O blessed lady, those qualities which you praise as existing within yourself are indeed found in you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:17.1"], "en": "A Kshatriya, perfected by birth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:17.2"], "en": "high-born and renowned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:17.3"], "en": "the Dharma-king of the Videhas—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:17.4"], "en": "“A son is born to you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:18.1"], "en": "“Dummī, wearing dust and dirt,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:18.2"], "en": "stood in the sky above;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:18.3"], "en": "You speak words that are pleasing,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:18.4"], "en": "which go straight to my heart.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:19.1"], "en": "Are you a deity from the heavenly realms?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:19.2"], "en": "“O seer, you possess great psychic power;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:19.3", "PA_ja_489:19.4"], "en": "who are you that have arrived here? Reveal yourself to me.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:20.1", "PA_ja_489:20.2", "PA_ja_489:20.3"], "en": "“I am that Sakka of a thousand eyes, whom the hosts of gods, having assembled in the Sudhamma hall, pay homage.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:20.4"], "en": "I have come into your presence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:21.1"], "en": "Among women in the world of the living,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:21.2"], "en": "she who conducts herself with equanimity;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:21.3"], "en": "Wise, virtuous,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:21.4"], "en": "devoted to her mother-in-law and faithful to her husband—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:22.1"], "en": "such is the woman of true intelligence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:22.2"], "en": "To a woman who has performed beautiful deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:22.3", "PA_ja_489:22.4"], "en": "both divine and human beings come to behold her.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:23.1", "PA_ja_489:23.2"], "en": "And you, Bhaddā, through what was well-performed and through your good conduct in the past,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:23.3"], "en": "have been born here in a royal family.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:23.4"], "en": "It fulfills all desires.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:24.1"], "en": "And this, O princess,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:24.2"], "en": "is a victory for you in both worlds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:24.3"], "en": "Rebirth in the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:24.4"], "en": "and fame here in this life— may you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:25.1"], "en": "O wise one, long enjoy happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:25.2"], "en": "Protect the mere dharmas;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:25.3"], "en": "thus I go to the triple heaven,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:25.4"], "en": "for I love the sight of you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_489:26.1"], "en": "The Suruci Jātaka is the sixth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
