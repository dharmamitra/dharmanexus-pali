[
{"segs": ["PA_ja_325:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:0.2", "PA_ja_325:0.3"], "en": "Catukkanipāta, Kuṭidūsakavagga (The Section on the Hater of the Hut)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:0.4"], "en": "5. The Godhāraja Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:1.1", "PA_ja_325:1.2"], "en": "“Thinking him to be an ascetic, I approached one who was unrestrained;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:1.3"], "en": "“Thus you have struck me with a staff,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:1.4"], "en": "making me no longer a śramaṇa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:2.1"], "en": "“What use are your matted locks, O dull-witted one?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:2.2"], "en": "What use have you for a cloak of antelope skin?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:2.3"], "en": "Your interior is a thicket,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:2.4"], "en": "yet you polish only the exterior.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:3.1"], "en": "“Come, Godhā, turn back;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:3.2"], "en": "eat rice with fine seasoning.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:3.3"], "en": "I have oil and salt for you.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:3.4"], "en": "\"I have plenty of long pepper.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:4.1"], "en": "I shall now enter further into this anthill,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:4.2"], "en": "which is a hundred fathoms high.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:4.3"], "en": "\"He praises oil and salt;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:4.4"], "en": "pepper is harmful to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_325:5.1"], "en": "The Godharāja Jātaka, the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
