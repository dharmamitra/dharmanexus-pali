[
{"segs": ["PA_cp_19:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:0.2"], "en": "Hatthināgavagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:0.3"], "en": "Sīlapāramī 9", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:0.4"], "en": "The Conduct of Alīnasattu:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:1.1"], "en": "“In the excellent city of Pañcāla,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:1.2"], "en": "in the supreme capital of Kapila;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:1.3", "PA_cp_19:1.4"], "en": "There was a king named Jayaddisa who had attained the virtue of moral conduct;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:2.1"], "en": "I am the son of that king.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:2.2"], "en": "One who has heard the Dhamma, is virtuous in conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:2.3"], "en": "does not abandon living beings, possesses good qualities,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:2.4"], "en": "and always protects his dependents.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:3.1"], "en": "My father, having gone out on a hunt,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:3.2"], "en": "encountered Porisāda;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:3.3"], "en": "he seized my father.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:3.4"], "en": "\"You are my food; do not move.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:4.1", "PA_cp_19:4.2"], "en": "Having heard those words, he was terrified, trembling, and agitated.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:4.3", "PA_cp_19:4.4"], "en": "His thighs became as stiff as pillars upon seeing the man-eater:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:5.1"], "en": "\"Having taken the deer, release it.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:5.2", "PA_cp_19:5.3"], "en": "Having returned once more and given wealth to the brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:5.4"], "en": "my father addressed me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:6.1"], "en": "\"Enter upon the kingship, my son;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:6.2"], "en": "do not neglect this city;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:6.3"], "en": "it was established by me as a man-eater.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:6.4"], "en": "\"And my own return.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:7.1"], "en": "Having paid homage to his mother and father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:7.2"], "en": "he created another form for himself.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:7.3"], "en": "Having laid aside my bow and sword,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:7.4"], "en": "I approached Porisāda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:8.1"], "en": "who had come with a weapon in his hand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:8.2"], "en": "Perhaps he will despise me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:8.3"], "en": "because of that, my virtue will be broken,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:8.4"], "en": "for I have acted out of fear.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:9.1"], "en": "Out of fear for my portion of the precepts,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:9.2"], "en": "I did not speak of what was to be given to him; yet,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:9.3"], "en": "with a mind of loving-kindness, I spoke for his welfare.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:9.4"], "en": "I spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:10.1"], "en": "\"Kindle the great fire;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:10.2"], "en": "I shall leap from the tree.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:10.3"], "en": "\"Knowing that the time has ripened,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:10.4"], "en": "eat me, O Grandfather!\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:11.1"], "en": "thus, for the sake of those possessed of virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:11.2"], "en": "I did not protect my own life;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:11.3", "PA_cp_19:11.4"], "en": "I even ordained that man who was constantly taking the lives of others.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_19:12.1"], "en": "The ninth is the conduct of Alīnasattu.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
