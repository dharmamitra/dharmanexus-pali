[
{"segs": ["PA_ja_307:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:0.2"], "en": "The Fourth Collection of Fours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:0.3"], "en": "Chapter on Kāliṅga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:0.4", "PA_ja_307:1.1"], "en": "7. The Palāsa Tree Jātaka “O Brahmin, this insentient palāsa tree does not hear,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:1.2"], "en": "it knows not, and it has no consciousness.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:1.3"], "en": "“Exerting energy, constant and diligent,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:1.4"], "en": "why do you ask about a comfortable sleep?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:2.1"], "en": "“There is a tree that is far away, both large and tall.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:2.2"], "en": "Standing here, he is the very form of the abode of beings;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:2.3"], "en": "therefore, I revere this Palāsa tree,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:2.4"], "en": "for whatever beings dwell here, they are the cause of my wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:3.1", "PA_ja_307:3.2"], "en": "“Therefore, O Brahmin, observing your gratitude, I shall do for you according to my power;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:3.3"], "en": "for how could one who has come into the presence of the virtuous fail to act?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:3.4"], "en": "Vain indeed were your quiverings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:4.1", "PA_ja_307:4.2"], "en": "That great *pilakkhu* tree, surrounded by the excellent *tinduka* tree, was the former sacrificial offering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:4.3"], "en": "“At its root a treasure has been buried;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:4.4"], "en": "go, take it up, for you have no heir.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_307:5.1"], "en": "The Palāsa Jātaka, the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
