{"segs": ["PA_thag_1.4:0.2", "PA_thag_1.4:0.3"], "en": "Paṭhamavagga (The First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.4:0.4"], "en": "Puṇṇa Thera’s Verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.4:1.1"], "en": "“One should associate only with the virtuous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.4:1.2"], "en": "with the wise who have insight.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.4:1.3"], "en": "The wise attain that which is great in meaning, profound,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.4:1.4", "PA_thag_1.4:1.5"], "en": "difficult to see, subtle, and minute.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.4:1.6"], "en": "\"Being heedful and discerning.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.4:1.7"], "en": "Thus indeed did the Venerable Puṇṇa Mantāṇiputta, the Elder, speak this verse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
