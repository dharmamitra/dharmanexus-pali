[
{"segs": ["PA_ja_324:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:0.2", "PA_ja_324:0.3"], "en": "Catukkanipāta, Kuṭidūsakavagga (The Section on the House-Burner)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:0.4", "PA_ja_324:1.1"], "en": "4. The Leather-Cloth Jātaka “Truly beautiful is this four-footed creature;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:1.2"], "en": "it is both auspicious and very dear.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:1.3"], "en": "“He who honors a brahmin endowed with noble birth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:1.4"], "en": "O illustrious Meṇḍavara. “Do not,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:2.1"], "en": "O brahmin, judge by mere outward appearance;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:2.2"], "en": "He placed his trust in the four-footed beast,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:2.3"], "en": "longing for a firm blow; he drew near,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:2.4"], "en": "thinking, \"He will give me a good blow.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:3.1"], "en": "His thigh was broken and his load of grain fell away;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:3.2"], "en": "all the Brahmin’s goods were shattered.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:3.3"], "en": "Raising both arms, he cried out in lamentation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:3.4"], "en": "“Run away! A practitioner of the holy life is being struck down.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:4.1", "PA_ja_324:4.2"], "en": "Thus he lies slain who praises what is unworthy of praise.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:4.3"], "en": "\"Just as I have been struck today,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:4.4"], "en": "I have been killed by the foolish ram.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_324:5.1"], "en": "Thus ends the fourth Jātaka, the Leather-Cloth Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
