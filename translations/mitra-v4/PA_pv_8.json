[
{"segs": ["PA_pv_8:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:0.2"], "en": "Uragavagga, 8.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:0.3"], "en": "The Story of the Ox-Peta (Goṇapetavatthu)", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:1.1", "PA_pv_8:1.2"], "en": "“Why do you act like one who is mad, having gathered green grass?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:1.3"], "en": "You prattle, ‘Eat! Eat!’”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:1.4"], "en": "Like an old ox whose strength has departed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:2.1", "PA_pv_8:2.2"], "en": "for a dead ox does not rise up again merely through food and drink.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:2.3"], "en": "“You are a fool and dull-witted,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:2.4"], "en": "just like that very same one of poor intelligence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:3.1"], "en": "“These are the feet, this is the head;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:3.2"], "en": "This body has its tether;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:3.3"], "en": "the ropes remain just as they were,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:3.4"], "en": "yet this ox stands up.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:4.1"], "en": "The hands, feet,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:4.2", "PA_pv_8:4.3"], "en": "body, and head of the leader are seen weeping upon the clay mound.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:4.4"], "en": "\"Are you not yourself the one who is foolish?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:5.1", "PA_pv_8:5.2"], "en": "\"Indeed, while I am burning like a fire drenched with ghee,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:5.3"], "en": "Sprinkling with water as it were,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:5.4"], "en": "he extinguishes all distress.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:6.1"], "en": "Truly, the arrow has been pulled out from me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:6.2"], "en": "The sorrow residing in my heart;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:6.3", "PA_pv_8:6.4"], "en": "you who, when I was overcome by grief, dispelled the sorrow for my father.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:7.1"], "en": "I have extracted the arrow;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:7.2"], "en": "I have become cool and attained Nibbāna;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:7.3"], "en": "I do not grieve, nor do I weep.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:7.4"], "en": "Having heard this from you, O young man,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:8.1", "PA_pv_8:8.2"], "en": "those who are wise and compassionate act in this way.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:8.3"], "en": "They turn one away from sorrow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:8.4"], "en": "just as Sujāta did for his father.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_8:9.1"], "en": "Thus ends the eighth story, the *Goṇa-peta-vatthu*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"}
]
