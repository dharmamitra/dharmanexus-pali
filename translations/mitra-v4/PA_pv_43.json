[
{"segs": ["PA_pv_43:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:0.2"], "en": "Mahāvagga 8.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:0.3"], "en": "The Story of the Feces-Eating Ghost (Gūthakhādaka-petavatthu)", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:1.1"], "en": "“Having emerged from a pit of excrement,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:1.2"], "en": "who indeed would stand there dejected?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:1.3"], "en": "Without a doubt, you must be one of evil deeds.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:1.4", "PA_pv_43:2.1"], "en": "\"Do you have faith, then? \"Venerable sir, I am a peta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:2.2"], "en": "one who has gone to the miserable world of Yama.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:2.3"], "en": "\"Having committed an evil deed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:2.4"], "en": "he has gone from here to the world of the departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:3.1"], "en": "\"What indeed [did he do] by way of body or speech...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:3.2"], "en": "“An evil deed was committed with the mind;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:3.3", "PA_pv_43:3.4"], "en": "as the result of what karma do you undergo this suffering?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:4.1"], "en": "“He was a resident here with me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:4.2"], "en": "envious and stingy regarding families;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:4.3"], "en": "he was one who dwelt in my house.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:4.4"], "en": "A miserly reviler.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:5.1"], "en": "Having heard his words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:5.2"], "en": "O monks, I rebuked him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:5.3"], "en": "By the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:5.4"], "en": "he has gone from here to the world of hungry ghosts.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:6.1"], "en": "“An enemy in the guise of a friend— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:6.2"], "en": "He who was your family attendant—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:6.3"], "en": "having broken up the body, that one of poor wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:6.4"], "en": "what destination has he gone to after passing away?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:7.1", "PA_pv_43:7.2"], "en": "“I stand right upon the head of that very same evil-doer;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:7.3"], "en": "yet he has reached another’s realm.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:7.4"], "en": "He is indeed my attendant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:8.1"], "en": "Whatever, O Venerable One,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:8.2"], "en": "others eat, that becomes my food.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:8.3", "PA_pv_43:8.4"], "en": "\"And whatever I eat, he lives off that.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_43:9.1"], "en": "The Story of the Feces-Eating Preta, the Eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"}
]
