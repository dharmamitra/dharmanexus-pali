[
{"segs": ["PA_ja_61:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_61:0.2", "PA_ja_61:0.3"], "en": "Ekakanipāta, Itthivagga (The Chapter on Women)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_61:0.4"], "en": "1. The Asātamanta Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_61:1.1"], "en": "“Worldly women are indeed untrustworthy;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_61:1.2"], "en": "no limit exists for them.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_61:1.3", "PA_ja_61:1.4"], "en": "Passionate and impudent like a fire that devours everything—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_61:1.5"], "en": "having abandoned them, I shall go forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_61:1.6"], "en": "“Cultivating discernment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_61:2.1"], "en": "Thus ends the first Jātaka, the *Asātamanta-jātaka*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
