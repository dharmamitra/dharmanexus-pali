[
{"segs": ["PA_thag_2.20:0.1", "PA_thag_2.20:0.2", "PA_thag_2.20:0.3"], "en": "Theragāthā 2.20 Dukanipāta, Second Chapter I am one who has reached the goal, I am one who has lived the holy life; Having laid down the burden, I am freed from bonds, And I have attained the destruction of craving.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:0.4"], "en": "Sirima Thera-gāthā:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:1.1", "PA_thag_2.20:1.2"], "en": "“If others praise him while he himself is unconcentrated,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:1.3"], "en": "Others praise in vain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:1.4"], "en": "for one's own mind is not concentrated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:2.1"], "en": "and others, too, will reproach him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:2.2"], "en": "If one is well-composed oneself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:2.3"], "en": "then the reproaches of others are in vain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:2.4"], "en": "for one is indeed well-composed oneself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:2.5"], "en": "… Sirimā Thera … The second chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:2.6", "PA_thag_2.20:3.0"], "en": "Its summary verse (uddāna) is as follows:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:3.1"], "en": "Cunda and Jotidāsa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:3.2"], "en": "the Elder and Heraññakāni;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:3.3"], "en": "Somamitta and Sabbamitta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:3.4"], "en": "Kāḷa, Tissa, and Kimila;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.20:3.5", "PA_thag_2.20:3.6"], "en": "Nanda and Sirimā— these ten elders were possessed of great supernormal power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
