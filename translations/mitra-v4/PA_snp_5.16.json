[
{"segs": ["PA_snp_5.16:0.1", "PA_snp_5.16:0.2"], "en": "Sutta Nipāta 5.16 The Young Brahmin Mogharāja’s Question “Twice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:1.1"], "en": "Sakyan, I have asked you:”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:1.2"], "en": "\"Thus spoke the Venerable Mogharāja:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:1.3"], "en": "'The One with Vision did not give me an answer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:1.4"], "en": "even up to the third time, O Queen.'\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:1.5"], "en": "\"He gives an exposition,\" so have I heard:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:2.1"], "en": "\"This world and the other world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:2.2"], "en": "the Brahma-world together with its devas.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:2.3", "PA_snp_5.16:2.4"], "en": "They do not understand the view of the illustrious Gotama;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:3.1"], "en": "thus he is one who sees what is most excellent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:3.2"], "en": "I have come with a question:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:3.3", "PA_snp_5.16:3.4"], "en": "How is it that the King of Death does not see one who contemplates the world?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:4.1", "PA_snp_5.16:4.2"], "en": "“Always mindful, O Mogharāja, look upon the world as empty;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:4.3"], "en": "having uprooted the view of self, [abandon it].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:4.4"], "en": "In this way one may overcome death;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:4.5", "PA_snp_5.16:4.6"], "en": "the King of Death does not see one who thus contemplates the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.16:4.7"], "en": "The fifteenth: The Question of the Young Brahmin Mogharāja.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
