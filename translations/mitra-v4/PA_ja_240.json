[
{"segs": ["PA_ja_240:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:0.2", "PA_ja_240:0.3"], "en": "The Second Book of Pairs (Dukanipāta), Chapter on Sandals (Upāhanavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:0.4"], "en": "10. The Mahāpiṅgala Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:1.1"], "en": "“Indeed, all people were harmed by Piṅgala;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:1.2"], "en": "now that he is dead, they experience the consequences.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:1.3"], "en": "\"Was he not dear to you, O dark-eyed one?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:1.4"], "en": "Why do you weep, gatekeeper?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:2.1"], "en": "\"He was not dear to me, O dark-eyed one.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:2.2"], "en": "I fear returning to him; for if he,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:2.3"], "en": "having gone from here, were to harm the King of Death,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:2.4"], "en": "he, being harmed, might bring him back here again.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:3.1", "PA_ja_240:3.2"], "en": "“Though it was burned by thousands of loads and sprinkled with hundreds of jars,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:3.3"], "en": "that ground was completely excavated.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:3.4"], "en": "\"Do not fear; he will come.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:4.1"], "en": "The tenth story, the Mahāpiṅgala Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:4.2"], "en": "The ninth chapter, the Chapter on Sandals.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:5.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:6.1"], "en": "Varu, upāhana, khujja, vikaṇṇaka-ko,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:6.2"], "en": "asitābhuya, pañcama-vaccha-nakha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:6.3"], "en": "The Brahmin, the best of those who speak with affection,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_240:6.4"], "en": "was bitten by a brown crab on a single spot.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
