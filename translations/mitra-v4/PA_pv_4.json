[
{"segs": ["PA_pv_4:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:0.2"], "en": "Uragavagga 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:0.3"], "en": "The Story of the Plaster-Wall Ghost (Piṭṭhadhītalikapetavatthu)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:1.1"], "en": "“Whatever object one makes the basis for giving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:1.2", "PA_pv_4:1.3"], "en": "if one gives without stinginess, dedicating it to the departed ancestors— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:1.4"], "en": "Or else, there are the deities of the site:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:2.1"], "en": "the four Great Kings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:2.2"], "en": "the renowned guardians of the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:2.3"], "en": "Kuvera, Dhatarattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:2.4"], "en": "Virupakkha, and Virulhaka—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:2.5"], "en": "these are indeed honored.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:2.6"], "en": "And the donors are not without fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:3.1"], "en": "For neither weeping nor sorrow,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:3.2"], "en": "nor any other lamentation, [averts death].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:3.3"], "en": "This does not benefit the deceased;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:3.4"], "en": "thus do relatives remain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:4.1"], "en": "Yet this offering has been given, and...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:4.2"], "en": "Well-established in the Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:4.3", "PA_pv_4:4.4"], "en": "it will be for his benefit for a long time and will be of immediate service.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_4:5.1"], "en": "The Story of the Petī Who Was a Plasterer’s Wife, Number Four.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
