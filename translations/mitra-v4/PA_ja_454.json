[
{"segs": ["PA_ja_454:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:0.2"], "en": "The Collection of Ten Birth Stories,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:0.3"], "en": "Chapter on the Four Gates.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:0.4", "PA_ja_454:1.1"], "en": "16. The Birth Story of the Wise Potter “Arise, Kaṇha! Why do you lie there?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:1.2"], "en": "What is the use of your sleeping?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:1.3"], "en": "Even for your own brother,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:1.4"], "en": "who is your very heart and your right eye,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:1.5"], "en": "the winds blow with great force.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:1.6"], "en": "“Ghaṭa is crying, O Kesava.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:2.1", "PA_ja_454:2.2"], "en": "Having heard those words of Rohiṇeyya, Kesava—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:2.3"], "en": "He emerged in a state of distress,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:2.4"], "en": "tormented by grief for his brother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:3.1"], "en": "“Why indeed do you appear like one mad?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:3.2"], "en": "This is merely a gateway;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:3.3", "PA_ja_454:3.4"], "en": "you keep crying \"hare, hare,\" but who indeed could have brought a hare for you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:4.1"], "en": "“Made of gold, made of jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:4.2"], "en": "made of bronze, or made of silver;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:4.3"], "en": "made of crystal, stone, or coral.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:4.4"], "en": "\"I will get you a hare.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:5.1"], "en": "\"There are other hares as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:5.2"], "en": "roaming in the forest and the woods.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:5.3"], "en": "“I will bring them to you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:5.4"], "en": "what kind of deer do you desire?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:6.1"], "en": "“I do not desire these.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:6.2"], "en": "Those who dwell upon this earth—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:6.3"], "en": "I desire to see them from the moon;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:6.4"], "en": "O Keśava, bring that down for me.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:7.1"], "en": "“Surely, O sweet kinsman,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:7.2"], "en": "you will now give up your life,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:7.3"], "en": "you who long for that which should not be longed for.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:7.4"], "en": "\"Do you wish to be like the moon?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:8.1", "PA_ja_454:8.2"], "en": "\"If it is so, O Kaṇha, that you know this while instructing another,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:8.3", "PA_ja_454:8.4"], "en": "\"Why do you still grieve today for a son who died long ago?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:9.1"], "en": "\"That which cannot be obtained by a human being...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:9.2"], "en": "Or by a non-human being;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:9.3"], "en": "my son has been born, may he not die!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:9.4"], "en": "How could that which is unobtainable be obtained?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:10.1"], "en": "Neither by mantras,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:10.2"], "en": "nor by root medicines, nor by herbs, nor by wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:10.3"], "en": "O Kaṇha, can he be brought back.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:10.4", "PA_ja_454:11.1", "PA_ja_454:11.2"], "en": "“Whose such as these might be— wise men as your ministers— yet you grieve for that departed one.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:11.3", "PA_ja_454:11.4"], "en": "Just as today this wise man Ghaṭa has caused me to reflect:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:12.1"], "en": "\"Alas, while I am burning, I remain unaware!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:12.2", "PA_ja_454:12.3"], "en": "Just as one might extinguish a fire with water poured from a jar, so by sprinkling it with water,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:12.4"], "en": "one should quench every dart of suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:13.1", "PA_ja_454:13.2"], "en": "Truly, the dart that was lodged in my heart has been pulled out— for me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:13.3"], "en": "who was overcome by sorrow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:13.4"], "en": "I have dispelled the grief for my son.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:14.1"], "en": "With the dart extracted,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:14.2"], "en": "I am free from sorrow and undisturbed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:14.3"], "en": "“I do not grieve, nor do I weep,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:14.4"], "en": "O young man, having heard this from you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:15.1"], "en": "Those possessed of wisdom act in this way.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:15.2", "PA_ja_454:15.3"], "en": "Those who are compassionate turn one back from sorrow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:15.4"], "en": "just as Ghaṭa did for his eldest brother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:16.1"], "en": "The Ghaṭapaṇḍitajātaka, the sixteenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:17.1"], "en": "The Dasakanipāta is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:18.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:19.1"], "en": "Daḷha, Kaṇha, Dhanañjaya, Saṅkhavara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:19.2"], "en": "Rāja, Sattaha, Kassa, and Takkalī;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:19.3"], "en": "Dhamma, Kukkuṭa, Kuṇḍali, and Bhojanadā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_454:19.4"], "en": "The ruddy goose, Subhūrisa, the safe jar.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
