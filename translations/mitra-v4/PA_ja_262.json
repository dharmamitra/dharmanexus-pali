[
{"segs": ["PA_ja_262:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_262:0.2", "PA_ja_262:0.3"], "en": "Tikanipāta, Padumavagga (The Chapter on the Lotus)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_262:0.4"], "en": "2. The Mudupāṇi Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_262:1.1", "PA_ja_262:1.2"], "en": "“If his hand be soft and he be a well-trained elephant;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_262:1.3"], "en": "\"And if it were to rain in darkness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_262:1.4"], "en": "then surely that would happen.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_262:2.1"], "en": "\"She is without passion, gentle in speech,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_262:2.2"], "en": "Like rivers, they are difficult to fill;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_262:2.3", "PA_ja_262:2.4"], "en": "knowing them to be such, one should avoid them from afar lest one sink.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_262:3.1"], "en": "Whatever these women frequent,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_262:3.2"], "en": "whether through desire or through wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_262:3.3"], "en": "that place is like fire for him— just as fire consumes its fuel.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_262:3.4"], "en": "\"They quickly burn him up.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_262:4.1"], "en": "Thus ends the second Jātaka, the Mudupāṇi Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
