[
{"segs": ["PA_vv_78:0.1", "PA_vv_78:0.2"], "en": "Vimānavatthu: The Mansion of the Man,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:0.3"], "en": "Chapter on Well-Placed [Offerings]", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:0.4", "PA_vv_78:1.1"], "en": "4. The Story of the Golden Mansion Upon a mountain made of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:1.2"], "en": "there is a mansion radiant on all sides.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:1.3"], "en": "Covered with a net of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:1.4"], "en": "adorned with a network of small bells,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:2.1"], "en": "its pillars were well-fashioned into eight facets.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:2.2"], "en": "All are made of beryl;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:2.3"], "en": "on each single rail,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:2.4"], "en": "seven jewels are fashioned.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:3.1"], "en": "Of beryl and gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:3.2"], "en": "of crystal and silver;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:3.3"], "en": "of emerald and pearl,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:3.4"], "en": "And with rubies,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:4.1"], "en": "the ground was variegated and delightful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:4.2"], "en": "no dust rose there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:4.3"], "en": "Rows of yellow rafters,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:4.4"], "en": "fashioned as figures, support the roof;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:5.1"], "en": "and there are four stairways.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:5.2"], "en": "He has fashioned the four quarters;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:5.3"], "en": "with inner chambers of various jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:5.4"], "en": "he shines like the sun.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:6.1", "PA_vv_78:6.2"], "en": "There, four terraces are divided and measured out in their parts;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:6.3"], "en": "shining brightly, they gleam.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:6.4", "PA_vv_78:7.1", "PA_vv_78:7.2"], "en": "In all four directions around that excellent celestial mansion dwells a son of the gods of great radiance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:7.3"], "en": "You outshine all in beauty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:7.4"], "en": "like the sun as it rises;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:8.1"], "en": "this is the fruit of your generosity.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:8.2"], "en": "Or else, regarding virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:8.3"], "en": "or even the act of joining the palms in reverence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:8.4"], "en": "explain that to me when I have asked you.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:9.1", "PA_vv_78:9.2"], "en": "Thus that son of the gods was delighted...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:9.3"], "en": "[as before] ...the fruit of which action this is.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:10.1", "PA_vv_78:10.2", "PA_vv_78:10.3"], "en": "“In Andhakavinda, I had a monastery built for the Teacher, the Buddha, the Kinsman of the Sun.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:10.4"], "en": "With confident hearts and their own hands,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:11.1"], "en": "they offered there perfumes, garlands,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:11.2"], "en": "requisites, and ointments.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:11.3", "PA_vv_78:11.4"], "en": "I gave a monastery to the Teacher with a mind of clear confidence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:11.5"], "en": "by that deed, this was obtained by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:11.6"], "en": "I dwell in the Nandana grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:12.1"], "en": "in the delightful Nandana forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:12.2"], "en": "which is filled with various flocks of birds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:12.3"], "en": "“I delight in dance and song,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:12.4"], "en": "honored by the celestial nymphs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_78:13.1"], "en": "Thus ends the fourth golden mansion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"}
]
