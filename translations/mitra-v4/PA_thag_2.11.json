{"segs": ["PA_thag_2.11:0.1"], "en": "Theragāthā 2.11 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.11:0.2", "PA_thag_2.11:0.3"], "en": "Second Chapter The Elder’s Verses, Book Two, Chapter Two, Verse Eleven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.11:0.4"], "en": "The Verses of the Elder Mahācunda:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.11:1.1"], "en": "“Desire to hear increases learning;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.11:1.2"], "en": "learning increases wisdom.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.11:1.3"], "en": "Through wisdom one knows the goal;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.11:1.4"], "en": "the goal known brings happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.11:2.1"], "en": "One should frequent remote lodgings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.11:2.2"], "en": "One should practice for the sake of liberation from the fetters;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.11:2.3"], "en": "if one does not find delight therein,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.11:2.4"], "en": "one should dwell in the Saṅgha, guarding oneself and mindful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.11:2.5"], "en": "… the elder Mahācunda …", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
