[
{"segs": ["PA_thag_1.53:0.1", "PA_thag_1.53:0.2", "PA_thag_1.53:0.3"], "en": "Theragāthā 1.53 Ekakanipāta Chaṭṭhavagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.53:0.4"], "en": "The Verses of the Elder Valliya:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.53:1.1"], "en": "“The rain god falls as if to a well-sung song;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.53:1.2"], "en": "my little hut is thatched, pleasant, and sheltered from the wind.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.53:1.3"], "en": "“I dwell there with diligence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.53:1.4"], "en": "therefore, O Deva, rain down if you so desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.53:1.5"], "en": "… Thus spoke the Elder Valliya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
