[
{"segs": ["PA_thig_1.15:0.1", "PA_thig_1.15:0.2"], "en": "Therīgāthā 1.15 Ekakanipāta Uttarātherīgāthā The Verses of the Elder Nun Uttarā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
