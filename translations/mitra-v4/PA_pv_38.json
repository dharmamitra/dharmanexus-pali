[
{"segs": ["PA_pv_38:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:0.2"], "en": "Mahāvagga 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:0.3"], "en": "The Story of the Ghost Nandaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:1.1"], "en": "There was a king named Piṅgalaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:1.2"], "en": "the sovereign of Suraṭṭha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:1.3"], "en": "having gone to attend upon the Moriyas, he—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:1.4"], "en": "He returned once more to Suraṭṭha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:2.1"], "en": "At the time of the hot midday,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:2.2"], "en": "the king approached the mud.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:2.3"], "en": "The king saw a delightful path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:2.4"], "en": "that sandy track of the departed spirits.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:3.1"], "en": "He addressed his charioteer:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:4.1"], "en": "“This path is delightful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:4.2"], "en": "secure, auspicious, and blissful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:4.3"], "en": "by this way, O charioteer, let us go.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:4.4"], "en": "“From here, toward the vicinity of Suraṭṭha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:5.1", "PA_pv_38:5.2"], "en": "Thus Pāyāsi of Suraṭṭha set out with his fourfold army.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:5.3", "PA_pv_38:5.4"], "en": "A man who was terrified spoke these words to Sorattha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:6.1"], "en": "\"We have entered upon a wrong path.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:6.2"], "en": "Terrifying and hair-raising;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:6.3"], "en": "the path is seen ahead,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:6.4"], "en": "but nothing is seen behind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:7.1"], "en": "We have entered upon a wrong path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:7.2"], "en": "in the presence of the messengers of Yama;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:7.3"], "en": "a superhuman stench wafts forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:7.4"], "en": "“A terrible sound is heard.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:8.1", "PA_pv_38:8.2"], "en": "Deeply moved, King Soraṭṭha said this to his charioteer:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:8.3"], "en": "“We have entered upon a wrong path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:8.4"], "en": "terrifying and hair-raising;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:8.5"], "en": "the [right] path is seen ahead.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:8.6"], "en": "And he is not seen from behind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:9.1"], "en": "We have entered upon a wrong path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:9.2"], "en": "in the presence of the messengers of Yama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:9.3"], "en": "“A superhuman fragrance wafts forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:9.4"], "en": "and a dreadful sound is heard.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:10.1"], "en": "Having mounted the back of the elephant, [he said:]", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:10.2"], "en": "Looking around in the four directions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:10.3"], "en": "he saw the delightful banyan tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:10.4"], "en": "a tree endowed with abundant shade.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:10.5"], "en": "Resembling the color of a dark cloud,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:10.6"], "en": "with a splendor like that of a rain-cloud,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:11.1"], "en": "the king addressed his charioteer:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:11.2"], "en": "“What is this that is seen, so vast,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:11.3"], "en": "resembling the color of a dark cloud,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:11.4"], "en": "possessing the splendor of the hue of a rain-cloud?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:12.1", "PA_pv_38:12.2"], "en": "“O Great King, that nigrodha tree is endowed with abundant shade;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:12.3"], "en": "it resembles the color of a dark cloud.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:12.4"], "en": "\"Resembling the splendor of the color of a cloud.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:13.1", "PA_pv_38:13.2"], "en": "Because of that, the Soraṭṭha prince set out toward where that tall man was seen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:13.3"], "en": "Resembling the color of a dark blue cloud,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:13.4"], "en": "with a splendor like the hue of a rain-cloud,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:14.1"], "en": "he descended from the back of the elephant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:14.2"], "en": "The king approached the tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:14.3", "PA_pv_38:14.4"], "en": "together with his ministers and his retinue, he sat down at the foot of the tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:14.5", "PA_pv_38:14.6"], "en": "He saw a water-jar full of water, cakes, and wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:15.1"], "en": "and a man with the appearance of a god.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:15.2"], "en": "Adorned with all his ornaments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:15.3", "PA_pv_38:15.4"], "en": "he approached the King of Soraṭṭha and spoke these words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:16.1"], "en": "“Welcome to you, Great King;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:16.2"], "en": "indeed, you have come from afar.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:16.3"], "en": "Let the Lord drink the water.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:16.4"], "en": "“Eat the cakes, O subduer of enemies!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:17.1"], "en": "Having drunk the water, the king,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:17.2"], "en": "together with his ministers and his retinue, [partook].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:17.3"], "en": "Having eaten the cakes and drunk [the drink],", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:17.4"], "en": "the man from Soraṭṭha said this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:18.1"], "en": "\"Are you a deity, or are you a gandhabba?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:18.2"], "en": "“Is it Sakka, the Giver of First Fruits?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:18.3"], "en": "Not knowing this, we ask you:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:18.4"], "en": "how may we come to know you?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:19.1"], "en": "“I am neither a god nor a gandhabba,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:19.2"], "en": "nor am I Sakka Purindada;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:19.3"], "en": "I am a peta, O Great King.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:19.4"], "en": "“Why have you come here from Surāṣṭra?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:20.1", "PA_pv_38:20.2"], "en": "“What was your character and what was your conduct in the city of Surāṣṭra?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:20.3"], "en": "“By what holy life, O King,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:20.4"], "en": "does this majesty of yours arise?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:21.1"], "en": "“Listen to that, Great King.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:21.2"], "en": "Ariṇḍama, Raṭṭhavaḍḍhana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:21.3"], "en": "the ministers, the assembly members,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:21.4"], "en": "and the brahmin family priest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:22.1"], "en": "In Suratta, O King,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:22.2"], "en": "I was a man of evil intent;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:22.3"], "en": "I held wrong views and was immoral.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:22.4"], "en": "A miserly reviler,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:23.1", "PA_pv_38:23.2"], "en": "I would restrain the many people who were giving and performing meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:23.3", "PA_pv_38:23.4"], "en": "While others were giving gifts, I acted as an obstacle;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:24.1"], "en": "there was no ripening of merit from that gift.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:24.2"], "en": "Whence can there be fruit for self-restraint?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:24.3"], "en": "There is no such thing as a teacher;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:24.4"], "en": "who will tame that which is untamed?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:25.1"], "en": "All beings are equal;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:25.2"], "en": "whence could there be one who honors the elder?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:25.3"], "en": "There is neither power nor strength [in such a person].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:25.4"], "en": "Whence comes human effort?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:26.1"], "en": "There is no such thing as the fruit of giving;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:26.2"], "en": "it does not purify one's enemies.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:26.3", "PA_pv_38:26.4"], "en": "A mortal obtains what he is destined to obtain through the process of fixed destiny;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:27.1"], "en": "there is no mother, no father, and no brother [to provide it].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:27.2"], "en": "There is no world beyond this one;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:27.3"], "en": "there is no giving, no offering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:27.4"], "en": "and no well-placed merit to be found.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:28.1", "PA_pv_38:28.2"], "en": "Even one who might kill a man or cut off another's head—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:28.3"], "en": "no one kills anyone at all.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:28.4"], "en": "Within the opening of the seven [elements].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:29.1"], "en": "For the soul (jīva) is indivisible and inseparable;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:29.2"], "en": "it has eight parts and is as round as a sugar-candy ball.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:29.3", "PA_pv_38:29.4"], "en": "Who is fit to cut off life that spans five hundred yojanas?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:30.1"], "en": "Just like a ball of thread when cast [into the water].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:30.2"], "en": "As one unravels [a snare],", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:30.3", "PA_pv_38:30.4"], "en": "one escapes; even so does that living being escape while unraveling.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:31.1", "PA_pv_38:31.2"], "en": "Just as one who has departed from a village enters another village,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:31.3"], "en": "even so does that living being.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:31.4"], "en": "He enters another body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:32.1", "PA_pv_38:32.2"], "en": "just as one who has gone out from a house enters another house.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:32.3", "PA_pv_38:32.4"], "en": "In this very way, that living being enters another body;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:33.1"], "en": "for eighty-four great eons, it remains there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:33.2"], "en": "For indeed, hundreds of thousands—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:33.3"], "en": "both those who are fools and those who are wise—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:33.4"], "en": "having exhausted the cycle of existence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:33.5"], "en": "They shall bring an end to suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:34.1", "PA_pv_38:34.2"], "en": "Pleasures and pains are measured out like grains in bushels and baskets.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:34.3"], "en": "The Victor understands all;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:34.4"], "en": "other beings are deluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:35.1"], "en": "Such was my view in the past.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:35.2"], "en": "Deluded and shrouded in delusion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:35.3"], "en": "holding wrong views, immoral,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:35.4"], "en": "stingy, and abusive.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:36.1"], "en": "In six months from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:36.2"], "en": "my passing will take place;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:36.3"], "en": "it will be utterly bitter and terrible.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:36.4"], "en": "I shall fall into hell—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:37.1"], "en": "a place with four corners and four gates,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:37.2"], "en": "divided and measured out into sections.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:37.3", "PA_pv_38:37.4"], "en": "Enclosed by an iron wall and covered over with iron;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:38.1"], "en": "its ground is made of iron.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:38.2"], "en": "Blazing and endowed with splendor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:38.3", "PA_pv_38:38.4"], "en": "it remains at all times pervading a hundred yojanas in every direction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:39.1"], "en": "For a hundred thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:39.2"], "en": "that sound was heard; this,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:39.3"], "en": "O Great King, is one lakh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:39.4", "PA_pv_38:40.1"], "en": "For hundreds of millions of years, and for hundreds of thousands of millions more,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:40.2"], "en": "people are cooked in hell.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:40.3"], "en": "Those with wrong view and immoral conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:40.4"], "en": "and those who revile the Noble Ones—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:41.1"], "en": "in this regard, for a long time, I...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:41.2"], "en": "I experience a painful sensation;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:41.3"], "en": "it is the fruit of evil karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:41.4"], "en": "and therefore I grieve intensely.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:42.1"], "en": "Listen to this, O Great King,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:42.2"], "en": "Arindama, increaser of the realm;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:42.3"], "en": "my daughter, O Great King—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:42.4"], "en": "\"May it be well with you, Uttara.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:43.1"], "en": "You perform auspicious deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:43.2"], "en": "delighting in virtue and the uposatha.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:43.3"], "en": "Restrained and sharing with others,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:43.4"], "en": "generous and free from stinginess,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:44.1"], "en": "one who practices the training without breaking it—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:44.2"], "en": "And as daughters-in-law in other families,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:44.3", "PA_pv_38:44.4"], "en": "they were lay female disciples of the glorious Sambuddha, the Sakyan Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:45.1", "PA_pv_38:45.2"], "en": "A bhikkhu endowed with virtue entered a village for alms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:45.3"], "en": "with downcast eyes and mindful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:45.4"], "en": "With his sense-doors guarded and well-restrained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:46.1"], "en": "walking for alms from house to house in due order,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:46.2"], "en": "he came to that dwelling.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:46.3"], "en": "‘I saw him, O Great King;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:46.4"], "en": "may it be well with you, Uttara.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:47.1"], "en": "[He offered] a water-pot full of water.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:47.2"], "en": "She gave him both the cake and the wealth, saying:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:47.3"], "en": "“Venerable sir, my father has passed away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:47.4"], "en": "may this be of benefit to him.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:48.1"], "en": "Immediately after it was recited,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:48.2"], "en": "the result arose; I enjoy all desires here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:48.3"], "en": "being one who seeks them at will.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:48.4"], "en": "Like King Vessavaṇa himself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:49.1"], "en": "Listen to that, O Great King,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:49.2"], "en": "O subduer of enemies, increaser of the realm!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:49.3"], "en": "In the world with its devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:49.4"], "en": "the Buddha is declared supreme;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:49.5"], "en": "go for refuge to that Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:49.6"], "en": "Together with his sons and wife,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:50.1", "PA_pv_38:50.2"], "en": "Arindama touches the deathless state by means of the Eightfold Path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:50.3"], "en": "Go for refuge to that Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:50.4"], "en": "O subduer of enemies, together with your sons and wife,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:51.1"], "en": "and to the four who have entered the path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:51.2"], "en": "And those established in the four fruits—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:51.3"], "en": "this is the Saṅgha, upright,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:51.4"], "en": "endowed with wisdom, virtue, and concentration.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:51.5"], "en": "Go for refuge to that Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:51.6"], "en": "O subduer of enemies, together with your sons and wife.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:52.1"], "en": "Quickly abstain from the taking of life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:52.2"], "en": "In this world, avoid taking what is not given;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:52.3"], "en": "do not drink intoxicants, nor speak falsehoods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:52.4"], "en": "and be content with your own wife.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:53.1"], "en": "“You desire my welfare, O yakkha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:53.2"], "en": "you desire my benefit, O deity;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:53.3"], "en": "I shall do your bidding.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:53.4"], "en": "You are my teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:54.1", "PA_pv_38:54.2"], "en": "I go for refuge to the Buddha and also to the unsurpassed Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:54.3"], "en": "And to the Saṅgha of the god among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:54.4"], "en": "I go for refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:55.1"], "en": "I shall quickly abstain from taking life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:55.2"], "en": "In this world, I avoid taking what is not given;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:55.3"], "en": "I do not drink intoxicants, nor do I speak falsehoods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:55.4"], "en": "and I am content with my own wife.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:56.1", "PA_pv_38:56.2", "PA_pv_38:56.3"], "en": "I blow away evil views like a great wind blowing across a swiftly flowing river.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:56.4"], "en": "\"Delighting in the teaching of the Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:57.1"], "en": "Having said this, Soraṭṭha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:57.2"], "en": "having desisted from the view of evil;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:57.3"], "en": "Having paid homage to the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:57.4"], "en": "the leader mounted his chariot.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_38:58.1"], "en": "Thus ends the third *petavatthu* of Nandaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
