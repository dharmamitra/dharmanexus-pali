[
{"segs": ["PA_tha-ap_173:0.1", "PA_tha-ap_173:0.2", "PA_tha-ap_173:0.3"], "en": "The Apadāna of the Elder Kumudamāliya Kumudavagga 1. Kumudamāliyattheraapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:1.1"], "en": "“In the Himalayan mountains,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:1.2"], "en": "there was a great natural lake;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:1.3"], "en": "there I was born as a rakkhasa.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:1.4"], "en": "Terrible in form and possessed of great strength,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:2.1"], "en": "there the kumuda lilies bloom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:2.2"], "en": "growing as large as chariot wheels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:2.3", "PA_tha-ap_173:2.4"], "en": "I plucked that flower at the assembly of the powerful ones;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:3.1"], "en": "then the Blessed One Atthadassī—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:3.2"], "en": "The lord of bipeds, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:3.3"], "en": "seeing the flowers in full bloom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:3.4"], "en": "came into my presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:4.1"], "en": "Having approached the Fully Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:4.2"], "en": "the God of Gods, the Bull among Men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:4.3"], "en": "and having gathered all the flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:4.4"], "en": "I offered it to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:5.1", "PA_tha-ap_173:5.2"], "en": "At that time, the assembly extended as far as the Himalayas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:5.3"], "en": "Endowed with such a covering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:5.4", "PA_tha-ap_173:6.1"], "en": "the Tathāgata went forth eighteen hundred kappas ago.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:6.2"], "en": "The flower that I offered—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:6.3", "PA_tha-ap_173:6.4"], "en": "of this worship of the Buddha, I do not know a state of woe; this is the fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:7.1"], "en": "In this fifteenth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:7.2", "PA_tha-ap_173:7.3"], "en": "there were seven lords of men named Sahassaratha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:7.4"], "en": "And world-turning monarchs of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:8.1"], "en": "the four analytical knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:8.2"], "en": "and these eight liberations;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:8.3"], "en": "“The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:8.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:9.1"], "en": "Thus indeed did the Elder Thera Kumudamāliya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_173:10.1"], "en": "The legend of the Elder Kumudamāliya is the first.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
