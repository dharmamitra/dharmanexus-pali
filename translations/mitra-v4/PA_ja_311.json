[
{"segs": ["PA_ja_311:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:0.2"], "en": "The Fourth Collection of Fours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:0.3"], "en": "Chapter on the *Pucimanda* Tree.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:0.4"], "en": "1. The Pucimanda Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:1.1"], "en": "“Arise, thief! Why do you lie there?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:1.2"], "en": "What is the use of your sleeping?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:1.3", "PA_ja_311:1.4"], "en": "“May kings not seize you as a wrongdoer in the village.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:2.1"], "en": "“If indeed they should seize me as a thief,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:2.2"], "en": "One who commits evil deeds in the village—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:2.3", "PA_ja_311:2.4"], "en": "what concern is that for the *punnāga* tree growing and standing in the forest?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:3.1"], "en": "“You do not know, O Assattha tree,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:3.2"], "en": "the secret interval of my thief;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:3.3"], "en": "having caught the thief, the kings— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:3.4", "PA_ja_311:3.5"], "en": "“The evildoer in the village they impale upon a neem-thorn;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:3.6"], "en": "my mind fears that fate.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:4.1"], "en": "“One should suspect what is to be suspected,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:4.2"], "en": "and guard against future danger;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:4.3"], "en": "for the wise person, regarding future dangers,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:4.4"], "en": "“He surveys both worlds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_311:5.1"], "en": "Thus ends the first Jātaka, the Pucimanda-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
