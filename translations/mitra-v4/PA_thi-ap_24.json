[
{"segs": ["PA_thi-ap_24:0.1", "PA_thi-ap_24:0.2"], "en": "The Apadāna of the Elder Nun Sakulā Kuṇḍalakesīvagga, Chapter 4, Number 4:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:0.3"], "en": "The Apadāna of the Elder Nun Sakulā", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:1.2"], "en": "who has gone beyond all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:1.3"], "en": "[appeared] one hundred thousand aeons ago from now.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:1.4", "PA_thi-ap_24:2.1"], "en": "In this eon, the Leader arose for the welfare and happiness of all beings—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:2.2"], "en": "the best among those who speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:2.3", "PA_thi-ap_24:2.4"], "en": "The noble steed among men has practiced for the welfare of the world with its devas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:3.1"], "en": "having attained the pinnacle of glory, he is possessed of splendor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:3.2"], "en": "The Victor has attained a reputation for his virtues;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:3.3"], "en": "honored by the entire world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:3.4"], "en": "he is renowned in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:4.1", "PA_thi-ap_24:4.2"], "en": "Having crossed over doubt and transcended all perplexity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:4.3"], "en": "his aspirations for the mind are fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:4.4"], "en": "He attained supreme enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:5.1", "PA_thi-ap_24:5.2"], "en": "This best of men was the arouser of the path that had not yet arisen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:5.3", "PA_thi-ap_24:5.4"], "en": "He has declared what was undeclared and brought forth what was unborn;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:6.1"], "en": "he is the knower of the path and the one who understands the path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:6.2"], "en": "The bull among men, the proclaimer of the path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:6.3"], "en": "the Teacher skilled in the path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:6.4"], "en": "the most excellent of charioteers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:7.1"], "en": "The Teacher of Great Compassion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:7.2", "PA_thi-ap_24:7.3"], "en": "the Leader, taught the Dhamma to those submerged in the mire of sensual desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:7.4"], "en": "He rescued living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:8.1", "PA_thi-ap_24:8.2"], "en": "At that time, I was born in Haṃsavatī as the delight of a kṣatriya family.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:8.3"], "en": "Surūpā, Sadhanā, Dayitā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:8.4", "PA_thi-ap_24:9.1"], "en": "and Sirimatī were the wives of King Ānanda.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:9.2"], "en": "A daughter most beautiful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:9.3"], "en": "and also a half-sister,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:9.4"], "en": "both belonging to the one named Padumuttara.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:10.1", "PA_thi-ap_24:10.2"], "en": "Accompanied by royal maidens and adorned with every ornament,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:10.3"], "en": "she approached the Great Hero.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:10.4"], "en": "I heard the teaching of the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:11.1", "PA_thi-ap_24:11.2"], "en": "For at that time, the World-Honored One [was teaching] a bhikkhunī who possessed the divine eye;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:11.3", "PA_thi-ap_24:11.4"], "en": "Having heard that he placed me in the foremost position in the midst of the assembly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:12.1"], "en": "I was thrilled with joy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:12.2", "PA_thi-ap_24:12.3"], "en": "Having given a gift to the Teacher and having honored the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:12.4"], "en": "I aspired for the divine eye.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:13.1"], "en": "Then the Teacher said to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:13.2"], "en": "\"Nandā, you shall obtain what you have desired,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:13.3"], "en": "through your gift of a lamp and the gift of the Dhamma.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:13.4"], "en": "This fruit is well-determined:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:14.1"], "en": "in a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:14.2"], "en": "he will be born into the Okkāka clan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:14.3", "PA_thi-ap_24:14.4"], "en": "One named Gotama by clan will become a teacher in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:15.1"], "en": "he shall have heirs in his teachings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:15.2"], "en": "“Born from her own breast, fashioned by the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:15.3", "PA_thi-ap_24:15.4"], "en": "she shall be a female disciple of the Teacher, known by the name Sakulā.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:16.1", "PA_thi-ap_24:16.2"], "en": "By that well-performed karma and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:16.3"], "en": "having cast off this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:16.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:17.1"], "en": "In this auspicious eon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:17.2"], "en": "I was a highly renowned \"kinsman of Brahmā.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:17.3"], "en": "One named Kassapa by clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:17.4"], "en": "the best among those who speak, arose;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:18.1"], "en": "I was a female wanderer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:18.2", "PA_thi-ap_24:18.3"], "en": "Then, wandering alone for alms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:18.4"], "en": "I obtained only a small amount of oil.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:19.1"], "en": "Having lit that lamp as an offering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:19.2", "PA_thi-ap_24:19.3"], "en": "he stood before the shrine of the Best of Bipeds, observing every restraint.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:19.4"], "en": "With a serene mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:20.1"], "en": "By that well-performed kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:20.2"], "en": "and by one's intentions and aspirations;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:20.3"], "en": "Having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:20.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:21.1"], "en": "Wherever I am reborn, [there I abide].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:21.2"], "en": "By the power of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:21.3", "PA_thi-ap_24:21.4"], "en": "great lamps blaze forth wherever I have gone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:22.1"], "en": "Passing through walls and through rocks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:22.2"], "en": "having completely crossed over the mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:22.3"], "en": "I see whatever I desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:22.4"], "en": "This is the fruit of giving a lamp:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:23.1"], "en": "I have come to possess pure eyes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:23.2"], "en": "and I am resplendent with glory.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:23.3"], "en": "She is possessed of both faith and wisdom;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:23.4"], "en": "this is the fruit of the gift of an island.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:24.1"], "en": "And now, in her final existence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:24.2"], "en": "I was born into a brahmin family,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:24.3"], "en": "one that possessed abundant wealth and grain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:24.4"], "en": "which was joyful and honored by the king.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:25.1", "PA_thi-ap_24:25.2"], "en": "Endowed with every limb and adorned with all my ornaments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:25.3"], "en": "I [approached] the Sugata for his entry into the city.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:25.4"], "en": "Standing at the window,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:26.1"], "en": "I saw him blazing with glory,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:26.2"], "en": "honored by gods and men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:26.3", "PA_thi-ap_24:26.4"], "en": "Endowed with the excellence of minor marks and adorned with the [major] characteristics,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:27.1"], "en": "with uplifted minds and joyful hearts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:27.2"], "en": "I resolved to go forth into homelessness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:27.3"], "en": "in no long time at all,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:27.4"], "en": "I attained arhatship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:28.1"], "en": "I am a master of the supernormal powers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:28.2"], "en": "I possess the divine ear-element,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:28.3"], "en": "and I know the minds of others.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:28.4"], "en": "I am one who carries out the Teacher’s instruction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:29.1"], "en": "I know my former births,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:29.2"], "en": "and the divine eye has been purified.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:29.3"], "en": "Having discarded all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:29.4"], "en": "I am purified and stainless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:30.1"], "en": "The Teacher has been served by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:30.2"], "en": "The teaching of the Buddha has been fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:30.3"], "en": "the heavy burden has been laid down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:30.4"], "en": "and the conduit to existence has been uprooted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:31.1", "PA_thi-ap_24:31.2"], "en": "That purpose for which I went forth from the home life into homelessness—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:31.3"], "en": "that goal has been attained by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:31.4"], "en": "The destruction of all fetters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:32.1", "PA_thi-ap_24:32.2"], "en": "Because of that, the Greatly Compassionate One placed me in this foremost position.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:32.3", "PA_thi-ap_24:32.4"], "en": "\"O Sakula, best of men, you are foremost among those with the divine eye;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:33.1"], "en": "the defilements have been burnt away by me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:33.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:33.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:34.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:34.2", "PA_thi-ap_24:34.3"], "en": "... [as before] ... the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:35.1"], "en": "The four analytical knowledges (paṭisambhidā) have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:35.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:35.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:36.1"], "en": "Thus indeed did the bhikkhunī Sakulā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_24:37.1"], "en": "The legend of the Elder Sakulā is the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
