[
{"segs": ["PA_ja_349:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:0.2", "PA_ja_349:0.3"], "en": "Catukkanipāta, Cūḷakuṇālavagga (The Short Kuṇāla Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:0.4", "PA_ja_349:1.1"], "en": "9. The Sandhibheda Jātaka “Neither among women is there equality,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:1.2"], "en": "nor even among foods, O charioteer.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:1.3", "PA_ja_349:1.4"], "en": "Behold how well-considered was the thought of that betrayer of his own kin:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:2.1"], "en": "the sword is indeed sharp upon the flesh.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:2.2"], "en": "Slander circulates there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:2.3", "PA_ja_349:2.4"], "en": "where base beasts devour even the bull and the lion.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:3.1"], "en": "This is the bed he lies upon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:3.2"], "en": "O charioteer, which you see here—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:3.3"], "en": "he who has broken the bond of speech.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:3.4"], "en": "They understand the malicious person;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:4.1", "PA_ja_349:4.2"], "en": "those people flourish in happiness like men who have gone to heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:4.3", "PA_ja_349:4.4"], "en": "“Those who do not understand the words of one who has broken his bonds are no charioteers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_349:5.1"], "en": "Thus ends the ninth Jātaka, the Sandhibheda-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
