[
{"segs": ["PA_tha-ap_358:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:0.2"], "en": "Saddasaññaka Chapter, 6.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:0.3"], "en": "The Apadāna of the Elder Ambayāgudāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:1.1", "PA_tha-ap_358:1.2", "PA_tha-ap_358:1.3"], "en": "“The Fully Awakened One named Sataraṃsī, the self-become, the unconquered, having emerged from meditative concentration, Please provide the text you would like me to translate. I am ready to assist you with your request. Please provide the text for translation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:1.4"], "en": "He approached me for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:2.1"], "en": "Having seen the Paccekabuddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:2.2"], "en": "I gave him mango-gruel.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:2.3", "PA_tha-ap_358:2.4"], "en": "With a mind that was serene, and with a heart full of serenity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:3.1"], "en": "[he spoke] ninety-four aeons ago.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:3.2"], "en": "Whatever deed I performed back then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:3.4"], "en": "this is the fruit of that rice-gruel offered to my mother.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:4.1", "PA_tha-ap_358:4.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:5.1"], "en": "Thus indeed the venerable elder Ambayāgudāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_358:6.1"], "en": "This is the sixth legend of the elder Ambayāgudāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
