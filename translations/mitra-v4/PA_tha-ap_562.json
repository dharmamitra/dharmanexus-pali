[
{"segs": ["PA_tha-ap_562:0.1", "PA_tha-ap_562:0.2", "PA_tha-ap_562:0.3"], "en": "The Apadāna of the Elder Upavāna Yasavagga 10. Upavānattheraapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:1.2"], "en": "who had gone beyond all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:1.3"], "en": "blazed like a mass of fire.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:1.4"], "en": "The Fully Enlightened One has attained final Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:2.1"], "en": "The great multitude, having gathered together,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:2.2"], "en": "paid homage to the Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:2.3"], "en": "Having prepared a funeral pyre,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:2.4"], "en": "they placed the Sugata’s body upon it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:3.1"], "en": "Having performed the rites for the body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:3.2"], "en": "They brought the relic there together;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:3.3"], "en": "all those beings, including gods and humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:3.4"], "en": "constructed a stupa for the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:4.1"], "en": "The first is made of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:4.2"], "en": "the second of jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:4.3"], "en": "and the third of silver.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:4.4"], "en": "The fourth was made of crystal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:5.1", "PA_tha-ap_562:5.2"], "en": "There, the fifth was indeed made of ruby.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:5.3"], "en": "The sixth was made of masāragalla stone,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:5.4"], "en": "and everything above it was made of jewels;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:6.1"], "en": "his shanks were made of gems.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:6.2"], "en": "The railings were made of jewels;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:6.3"], "en": "the stupa was made entirely of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:6.4"], "en": "rising a yojana in height.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:7.1"], "en": "Then the devas, having gathered there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:7.2"], "en": "consulted together on one side:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:7.3"], "en": "\"We too shall build a stupa.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:7.4"], "en": "Of the Protector of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:8.1"], "en": "the Tathāgata, there are no separate relics;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:8.2"], "en": "his body remains as a single solid mass.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:8.3"], "en": "\"Upon this stupa of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:8.4"], "en": "we shall offer a robe-casement.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:9.1"], "en": "Thus the devas [prepared] with the seven jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:9.2"], "en": "They increased it by another league;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:9.3"], "en": "the stupa, two leagues in height,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:9.4"], "en": "dispels the darkness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:10.1"], "en": "Then the nāgas, having gathered there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:10.2"], "en": "deliberated together:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:10.3"], "en": "\"Both humans and gods...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:10.4"], "en": "They built a stupa for the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:11.1"], "en": "\"May we not be heedless;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:11.2"], "en": "may we be heedful, together with the devas.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:11.3"], "en": "\"We too shall build a stupa for the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:11.4"], "en": "the Protector of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:12.1"], "en": "[They brought] sapphire and great blue gems.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:12.2", "PA_tha-ap_562:12.3"], "en": "Then, having gathered together the jewel that was full of light from one side,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:12.4"], "en": "they covered the Buddha’s stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:13.1", "PA_tha-ap_562:13.2"], "en": "The entire extent of the Buddha’s cetiya was made of jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:13.3"], "en": "rising three yojanas in height.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:13.4"], "en": "Then there was the making of light.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:14.1"], "en": "And the garuḍas, having assembled,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:14.2"], "en": "then deliberated together.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:14.3", "PA_tha-ap_562:14.4"], "en": "“Humans, gods, and nāgas performed worship to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:15.1"], "en": "Let us not be heedless.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:15.2"], "en": "\"Being diligent, O you who dwell with the devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:15.3", "PA_tha-ap_562:15.4"], "en": "we too shall build a stupa for the Protector of the World, the Tathāgata.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:16.1", "PA_tha-ap_562:16.2"], "en": "They made the entire stupa out of jewels and covered it with a casing;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:16.3"], "en": "they even increased its height by a yojana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:16.4"], "en": "The Buddha’s cetiya is long; the Buddha’s stupa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:17.1"], "en": "four yojanas in height,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:17.2"], "en": "shines resplendently.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:17.3", "PA_tha-ap_562:17.4"], "en": "He illuminates all directions like the risen sun with its hundred rays;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:18.1"], "en": "and the kumbhaṇḍas, having gathered together, [surround him].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:18.2"], "en": "Then they deliberated together:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:18.3"], "en": "“Both humans and gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:18.4"], "en": "as well as nāgas and garuḷas.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:19.1", "PA_tha-ap_562:19.2"], "en": "They erected a supreme stupa for the Best of Pratyekabuddhas, [saying]:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:19.3"], "en": "\"May we not be heedless!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:19.4"], "en": "\"Being diligent, O you who dwell with the devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:20.1", "PA_tha-ap_562:20.2"], "en": "we too shall build a stupa for the Protector of the World, the Tathāgata.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:20.3", "PA_tha-ap_562:20.4"], "en": "“We shall cover the long Buddha-cetiya with jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:21.1"], "en": "They increased it by a league as well.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:21.2"], "en": "The Buddha’s cetiya was long;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:21.3"], "en": "five yojanas in height,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:21.4"], "en": "the stupa then shone forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:22.1"], "en": "Then the yakkhas, having gathered there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:22.2"], "en": "deliberated together:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:22.3"], "en": "\"Humans, gods, and nāgas...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:22.4", "PA_tha-ap_562:23.1", "PA_tha-ap_562:23.2"], "en": "The Garuḍas and the Kumbhaṇḍas erected a supreme stūpa for the most excellent Pratyekabuddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:23.3"], "en": "Let us not be heedless;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:23.4"], "en": "let us be heedful, together with the devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:24.1"], "en": "We too shall build a stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:24.2", "PA_tha-ap_562:24.3", "PA_tha-ap_562:24.4"], "en": "We shall cover the long Buddha-cetiya of the World-Lord, the Tathāgata, with crystal.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:25.1", "PA_tha-ap_562:25.2"], "en": "They also increased the Buddha-cetiya to one yojana in length,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:25.3"], "en": "and six yojanas in height.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:25.4"], "en": "Then the stupa radiated light.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:26.1"], "en": "And the gandhabbas, having gathered together,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:26.2"], "en": "then deliberated among themselves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:26.3"], "en": "“Humans, deities, nāgas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:26.4"], "en": "kumbhaṇḍas, and likewise guhyakas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:27.1"], "en": "all together built a stūpa for the Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:27.2"], "en": "\"We ourselves are not the ones who built it here;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:27.3"], "en": "we too shall build a stupa for the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:27.4"], "en": "the Lord of the World.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:28.1"], "en": "Having fashioned seven altars,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:28.2"], "en": "they made a banner and a parasol;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:28.3"], "en": "the stupa was made entirely of gold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:28.4"], "en": "Then the Gandhabbas constructed it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:29.1", "PA_tha-ap_562:29.2"], "en": "At that time, the stupa, seven yojanas in height, shone forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:29.3"], "en": "Day and night are not distinguished;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:29.4"], "en": "there is light at all times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:30.1"], "en": "His radiance overcomes [all else].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:30.2"], "en": "The moon, the sun, and the stars—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:30.3"], "en": "even within a hundred leagues in every direction—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:30.4"], "en": "not even a lamp was lit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:31.1", "PA_tha-ap_562:31.2", "PA_tha-ap_562:31.3"], "en": "At that time, whatever humans worshiped the stupa did not climb up upon the stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:31.4"], "en": "They toss them up into the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:32.1"], "en": "A yakkha appointed by the devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:32.2"], "en": "named Abhisammata;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:32.3", "PA_tha-ap_562:32.4"], "en": "Whether it be a banner or a floral garland that one offers as an addition—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:33.1"], "en": "those [who are heedless] do not see that yakkha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:33.2"], "en": "They see the tether as they go;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:33.3"], "en": "seeing thus as they walk,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:33.4"], "en": "all go to a happy destination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:34.1"], "en": "Those who are hostile toward the Teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:34.2"], "en": "those who have faith in the Dispensation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:34.3"], "en": "and those who desire to see the miracle—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:34.4"], "en": "Humans worship the stupa. At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:35.1"], "en": "in the city of Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:35.2"], "en": "I was a hired laborer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:35.3"], "en": "Seeing the people so delighted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:35.4"], "en": "I then thought thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:36.1"], "en": "\"This Blessed One is sublime.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:36.2", "PA_tha-ap_562:36.3"], "en": "In whose relic chamber this multitude, being delighted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:36.4"], "en": "performs offerings without weariness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:37.1", "PA_tha-ap_562:37.2"], "en": "I too shall perform service for the Protector of the World, the Tathāgata;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:37.3"], "en": "may I be an heir to his Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:37.4"], "en": "\"I shall exist in the future.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:38.1", "PA_tha-ap_562:38.2"], "en": "\"I would wear my own cloth, well-washed by a washerman;\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:38.3"], "en": "Having fastened it to the top of a bamboo pole,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:38.4"], "en": "I raised the banner aloft in the sky. Then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:39.1"], "en": "being highly esteemed, I took hold of it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:39.2"], "en": "I laughed at my banner in the sky;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:39.3"], "en": "seeing the banner stirred by the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:39.4"], "en": "I produced even greater laughter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:40.1"], "en": "Having inspired confidence there in his mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:40.2"], "en": "I approached that ascetic;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:40.3"], "en": "having paid homage to that bhikkhu, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:40.4"], "en": "I asked about the ripening of kamma, O Banner;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:41.1"], "en": "he explained it to me, Ānanda,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:41.2"], "en": "producing joy and rapture in me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:41.3", "PA_tha-ap_562:41.4"], "en": "\"You shall always experience the fruit of that banner: elephants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:42.1"], "en": "horses, chariots, and infantry.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:42.2", "PA_tha-ap_562:42.3"], "en": "And a fourfold army shall always attend upon you;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:42.4"], "en": "this is the fruit of the gift of a banner.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:43.1", "PA_tha-ap_562:43.2", "PA_tha-ap_562:43.3"], "en": "Sixty thousand musical instruments and well-adorned drums shall constantly attend upon you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:43.4"], "en": "This is the fruit of the gift of a banner:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:44.1", "PA_tha-ap_562:44.2"], "en": "sixty-eight thousand women, beautifully adorned.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:44.3"], "en": "Adorned with various garments and ornaments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:44.4"], "en": "wearing jeweled earrings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:45.1"], "en": "with long, broad eyes and smiling faces.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:45.2"], "en": "Well-proportioned and slender-waisted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:45.3"], "en": "they will constantly attend upon you;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:45.4"], "en": "this is the fruit of the gift of a banner.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:46.1", "PA_tha-ap_562:46.2"], "en": "For thirty thousand aeons you shall delight in the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:46.3"], "en": "eighty times you shall be the lord of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:46.4"], "en": "You will exercise sovereignty over the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:47.1", "PA_tha-ap_562:47.2"], "en": "and a thousand times you will become a universal monarch (cakravartin).", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:47.3"], "en": "A vast regional sovereignty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:47.4"], "en": "incalculable in number;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:48.1"], "en": "for a hundred thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:48.2"], "en": "Born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:48.3", "PA_tha-ap_562:48.4"], "en": "he will be a teacher in the world named Gotama by lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:49.1"], "en": "Having fallen from the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:49.2", "PA_tha-ap_562:49.3"], "en": "impelled by the root of his white virtue and bound by his meritorious deed, he descended.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:49.4"], "en": "\"You will become a mere Brahmin by name.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:50.1"], "en": "Having abandoned eighty million [pieces of gold],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:50.2"], "en": "you will have many slaves and laborers.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:50.3", "PA_tha-ap_562:50.4"], "en": "You shall go forth in the teaching of the Blessed One Gotama;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:51.1"], "en": "having pleased the Perfectly Awakened One, you will attain the goal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:51.2"], "en": "To Gotama, the bull of the Sakyans;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:51.3", "PA_tha-ap_562:51.4"], "en": "you shall be a disciple of the Teacher, Upavāna by name.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:52.1", "PA_tha-ap_562:52.2"], "en": "The karma performed a hundred thousand eons ago has shown its fruit here to me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:52.3"], "en": "completely liberated like the speed of an arrow, I am free.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:52.4"], "en": "I extinguished the defilements within me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:53.1"], "en": "even while I was a wheel-turning monarch,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:53.2"], "en": "the sovereign of the four continents.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:53.3"], "en": "For three yojanas all around,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:53.4"], "en": "banners are always raised;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:54.1"], "en": "for a hundred thousand kalpas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:54.2"], "en": "Whatever deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:54.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:54.4"], "en": "this is the fruit of the gift of a banner.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:55.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:55.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:55.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:56.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:56.2", "PA_tha-ap_562:56.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:57.1", "PA_tha-ap_562:57.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:57.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:58.1"], "en": "Thus indeed the Venerable Elder Upavāna spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_562:59.1"], "en": "This is the tenth legend of the Elder Upavāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
