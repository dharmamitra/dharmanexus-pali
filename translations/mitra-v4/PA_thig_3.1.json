[
{"segs": ["PA_thig_3.1:0.1", "PA_thig_3.1:0.2", "PA_thig_3.1:0.3"], "en": "Therīgāthā 3.1 Tikanipāta Aparāsāmātherīgāthā The Verses of the Elder Nun Aparāsāmā, from the Third Book (Tikanipāta) of the *Therīgāthā* (Verses of the Elder Nuns).", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.1:1.1", "PA_thig_3.1:1.2"], "en": "“For twenty-five years since I went forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.1:1.3"], "en": "I do not recall any state of mind— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.1:1.4"], "en": "It is never obtained equally.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.1:2.1"], "en": "Having failed to attain peace of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.1:2.2"], "en": "one lacks mastery over one's own heart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.1:2.3", "PA_thig_3.1:2.4"], "en": "Then, remembering the teaching of the Victor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.1:3.1"], "en": "I experienced a sense of spiritual urgency regarding the many phenomena of suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.1:3.2"], "en": "Through my delight in heedfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.1:3.3"], "en": "the destruction of craving has been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.1:3.4"], "en": "the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.1:3.5", "PA_thig_3.1:3.6"], "en": "“Today is my seventh night since craving was dried up.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.1:4.1"], "en": "… Another elder nun, Sāmā, said: …", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"}
]
