[
{"segs": ["PA_pv_50:0.1"], "en": "The Peta-Vatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:0.2"], "en": "Great Chapter 15:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:0.3"], "en": "The Story of the Merchant’s Son as a Ghost (Seṭṭhiputta-peta-vatthu)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:1.1"], "en": "“For sixty thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:1.2"], "en": "in their entirety,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:1.3"], "en": "they will burn in hell.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:1.4"], "en": "When will there be an end?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:2.1"], "en": "There is no end; whence could there be an end?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:2.2"], "en": "No end is to be seen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:2.3", "PA_pv_50:2.4"], "en": "For thus, dear sir, evil has been committed by both you and me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:3.1"], "en": "we have lived a life ill-lived.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:3.2", "PA_pv_50:3.3"], "en": "Though there were those worthy of gifts and the things to be given existed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:3.4"], "en": "we did not make an island for ourselves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:4.1", "PA_pv_50:4.2"], "en": "Thus, having surely gone from here and obtained a human birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:4.3"], "en": "may I be generous and perfected in virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:4.4"], "en": "\"I shall perform much wholesome merit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_50:5.1"], "en": "This is the fifteenth story, the *Setthiputta-petavatthu*.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
