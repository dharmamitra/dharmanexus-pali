[
{"segs": ["PA_tha-ap_428:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:0.2"], "en": "Chapter on the Once-Scrubber (Sakiṃsammajjakavagga) 6.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:0.3"], "en": "The Apadāna of the Elder Ghaṭamaṇḍadāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:1.1"], "en": "“[I praise] the Well-Considered One, the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:1.2"], "en": "the Eldest in the World, the Bull among Men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:1.3"], "en": "who has entered the great forest.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:1.4"], "en": "Seeing him oppressed by the affliction of wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:2.1", "PA_tha-ap_428:2.2"], "en": "I gladdened his heart and offered him ghee and cream.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:2.3"], "en": "Because of its accumulation and its gathering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:2.4"], "en": "this Ganges Bhāgīrathī [flows];", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:3.1"], "en": "so too do the four great oceans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:3.2"], "en": "They have come together to crush me into a jar;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:3.3"], "en": "and this earth is terrible,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:3.4"], "en": "immeasurable, and incalculable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:4.1"], "en": "Knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:4.2", "PA_tha-ap_428:4.3"], "en": "these trees from the four continents have become honey and sugar for you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:4.4"], "en": "Trees are those that grow from the earth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:5.1"], "en": "yet, knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:5.2"], "en": "they become wish-fulfilling trees for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:5.3", "PA_tha-ap_428:5.4"], "en": "Fifty times I exercised sovereignty over the gods as Lord of Devas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:6.1"], "en": "and fifty-one times—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:6.2"], "en": "I was a wheel-turning monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:6.3", "PA_tha-ap_428:6.4"], "en": "my local sovereignty was vast and beyond counting.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:7.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:7.2"], "en": "because of the gift I gave then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:7.3"], "en": "I have never known a state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:7.4"], "en": "This is the fruit of the Ghaṭamaṇḍa [Jātaka]:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:8.1", "PA_tha-ap_428:8.2"], "en": "the defilements have been burnt away by me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:8.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:9.1", "PA_tha-ap_428:9.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:9.3"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:10.1", "PA_tha-ap_428:10.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:10.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:11.1"], "en": "Thus indeed did the venerable elder Ghatamaṇḍadāyaka recite these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_428:12.1"], "en": "This is the sixth legend of the elder Ghatamaṇḍadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
