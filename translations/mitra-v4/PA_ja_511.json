[
{"segs": ["PA_ja_511:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:0.2", "PA_ja_511:0.3"], "en": "The Collection of Thirty Birth Stories, Chapter on Kiṁchanda.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:0.4", "PA_ja_511:1.1"], "en": "1. The Kiṁchanda Jātaka “What desire do you have, what is your purpose,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:1.2"], "en": "that you wander alone in the heat?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:1.3"], "en": "“What do you desire? What do you seek?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:1.4"], "en": "For what purpose have you come, O Brahmin?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:2.1"], "en": "“Just as a great rain-cloud...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:2.2"], "en": "A jar of great circumference;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:2.3"], "en": "like that was the ripe mango,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:2.4"], "en": "supreme in color, fragrance, and flavor.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:3.1", "PA_ja_511:3.2"], "en": "Seeing that pure one being carried away by the current,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:3.3"], "en": "he took hold of him with his hands.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:3.4"], "en": "I brought firewood. Then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:4.1", "PA_ja_511:4.2"], "en": "having placed it upon plantain leaves myself, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:4.3"], "en": "Having distributed it with a knife,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:4.4"], "en": "hunger and thirst left me; thus,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:5.1"], "en": "free from distress, I am at peace.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:5.2"], "en": "Having become tranquil and enduring suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:5.3", "PA_ja_511:5.4"], "en": "I find no gratification in any other fruits whatsoever.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:6.1"], "en": "Surely death, having approached,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:6.2"], "en": "will bring it upon me—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:6.3"], "en": "that mango whose fruit was so sweet.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:6.4"], "en": "Sweet at its tip and enchanting—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:6.5", "PA_ja_511:6.6"], "en": "this which I pulled out as it was being carried away from the great ocean in the vast sea.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:7.1"], "en": "Everything has been told to you by me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:7.2"], "en": "because of which I am observing the fast;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:7.3"], "en": "I am seated here with my beloved husband.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:7.4"], "en": "The various [beings] are joined with various hides.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:8.1"], "en": "You yourself, moreover, declare it to me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:8.2"], "en": "O you who do not flee from yourself.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:8.3"], "en": "\"Who are you, O beautiful one?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:8.4"], "en": "Or whose daughter are you, O fair-waisted lady?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:9.1"], "en": "You look like one polished with a smooth cloth.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:9.2"], "en": "Like tigresses born on mountain peaks,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:9.3", "PA_ja_511:9.4"], "en": "are those women who exist among the gods as the attendants of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:10.1", "PA_ja_511:10.2"], "en": "And whatever women there are in the world of men who are endowed with beauty,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:10.3"], "en": "there is none who is equal to you in beauty.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:10.4"], "en": "\"O lady of beautiful limbs, you who have been questioned by me among the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:10.5"], "en": "gandhabbas, and the world of humans—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:10.6"], "en": "tell me your name and your kinsmen.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:11.1", "PA_ja_511:11.2"], "en": "“O Brahmin, you are seated upon the delightful Kosika couch,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:11.3"], "en": "while I have risen from my lowly bed.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:11.4"], "en": "Carrying floods of excellent water,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:12.1", "PA_ja_511:12.2"], "en": "the many mountain caves were filled with various groves of trees.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:12.3"], "en": "They come with me as their leader,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:12.4"], "en": "streaming forth like rain-clouds; moreover,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:13.1"], "en": "there are many forest torrents.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:13.2"], "en": "Bearing dark blue waters,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:13.3"], "en": "the many great rivers, rich in treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:13.4"], "en": "flow down with their flood of water.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:14.1"], "en": "The mango, rose-apple, breadfruit,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:14.2"], "en": "nīpa, palmyra, and udumbara—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:14.3"], "en": "many such varieties of fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:14.4", "PA_ja_511:15.1", "PA_ja_511:15.2"], "en": "They constantly carry away whatever fruit falls into the water from either bank.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:15.3"], "en": "Without doubt, that is the fruit of the ear,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:15.4"], "en": "which follows one's mastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:16.1"], "en": "Having understood this, the wise person...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:16.2"], "en": "O you of broad wisdom, listen to me:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:16.3"], "en": "do not find pleasure in attachment,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:16.4"], "en": "but restrain it, O lord of men.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:17.1"], "en": "I do not think you are growing at all,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:17.2", "PA_ja_511:17.3"], "en": "O Raṭṭhābhivaḍḍhana, though you are being filled up, O royal sage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:17.4"], "en": "You long for death. Your parents,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:18.1", "PA_ja_511:18.2"], "en": "the gandhabbas, and the gods together with Indra know of this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:18.3", "PA_ja_511:18.4"], "en": "And those seers in the world who are self-restrained and ascetic—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:18.5"], "en": "without a doubt, they too know this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:18.6"], "en": "“Having become established and renowned.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:19.1"], "en": "“Knowing thus all phenomena—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:19.2"], "en": "the destruction and passing away of life— the wise one...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:19.3"], "en": "No evil accrues to that man,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:19.4"], "en": "provided he does not intend his death,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:20.1"], "en": "even among those known as a host of seers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:20.2"], "en": "When you have thus understood the world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:20.3", "PA_ja_511:20.4"], "en": "do not seek to commit evil deeds in the company of ignoble people.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:21.1", "PA_ja_511:21.2"], "en": "If I die, O broad-hipped one, on your bank,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:21.3"], "en": "there will undoubtedly be ill-repute for you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:21.4"], "en": "When I have passed away, it will come upon you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:22.1", "PA_ja_511:22.2"], "en": "Therefore, O slender-waisted one, guard yourself against evil karma as you would a demon.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:22.3", "PA_ja_511:22.4"], "en": "“Let not all the people reproach me after I have passed away. “This is known;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:23.1"], "en": "tell us what is impossible,” he said.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:23.2"], "en": "I give myself and my mother to you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:23.3"], "en": "having abandoned those sensual qualities so difficult to renounce,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:23.4"], "en": "you are established in peace and the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:24.1", "PA_ja_511:24.2"], "en": "He who, having abandoned former fetters, yet remains bound by subsequent ones,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:24.3"], "en": "practices what is contrary to the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:24.4"], "en": "And his evil increases.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:25.1"], "en": "\"Come, I shall cause you to fall into evil;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:25.2"], "en": "you may remain at ease.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:25.3"], "en": "I bring it for you in the cool;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:25.4"], "en": "dwell there free from anxiety.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:26.1"], "en": "With those who are like honeyed flowers, [dwell].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:26.2"], "en": "O subduer of enemies, among the birds there are curlews,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:26.3"], "en": "peacocks, divine birds, woodpeckers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:26.4"], "en": "honey-birds, and sāḷikas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:26.5"], "en": "Resounding with flocks of swans,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:26.6"], "en": "the cuckoos here are awakening;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:27.1"], "en": "here the mango trees have branches spread wide.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:27.2"], "en": "Resembling heaps of straw,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:27.3", "PA_ja_511:27.4"], "en": "the *saḷala* and *nīpa* trees of Kosambī hang down like ripe palm fruits.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:28.1"], "en": "Wearing garlands, wreaths, and armlets,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:28.2"], "en": "adorned with bracelets and sandalwood paste,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:28.3"], "en": "you sported there throughout the night.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:28.4"], "en": "During the day she experienced feelings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:29.1", "PA_ja_511:29.2"], "en": "Those sixteen thousand women who were her attendants at that time—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:29.3"], "en": "Thus you possess such great power,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:29.4"], "en": "wonderful and hair-raising.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:30.1"], "en": "What deed did you perform in the past?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:30.2"], "en": "Evil brings suffering to oneself;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:30.3"], "en": "having committed it among human beings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:30.4"], "en": "you now eat the flesh from their backs.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:31.1"], "en": "Having received the Vedas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:31.2"], "en": "I was addicted to sensual pleasures;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:31.3"], "en": "I wandered for a very long time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:31.4"], "en": "For the harm of others,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:32.1", "PA_ja_511:32.2"], "en": "he who is a back-biter thus carves and devours [the flesh].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:32.3", "PA_ja_511:32.4"], "en": "\"Just as I eat my own back-flesh today.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_511:33.1"], "en": "Thus ends the first *Kiṃchanda-jātaka*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
