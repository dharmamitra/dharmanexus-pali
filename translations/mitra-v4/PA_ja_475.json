[
{"segs": ["PA_ja_475:0.1", "PA_ja_475:0.2"], "en": "The Thirteen-Book Collection of Birth Stories (Jātaka),", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:0.3"], "en": "Chapter on Mangoes (Ambavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:0.4", "PA_ja_475:1.1"], "en": "2. The Phandanajātaka “O man,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:1.2"], "en": "you stand having entered the forest with an axe in hand;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:1.3"], "en": "\"Being asked by me, friend, tell me:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:1.4"], "en": "what kind of wood do you wish to cut?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:2.1"], "en": "\"I roam through the forests.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:2.2"], "en": "\"Both even and uneven;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:2.3"], "en": "O worthy one, being asked by me, tell me:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:2.4"], "en": "what wood is strong for the rim?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:3.1"], "en": "“Neither *sāla*, nor *khadira*,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:3.2"], "en": "nor *assakaṇṇa*, much less *dhava*;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:3.3"], "en": "there is a tree named *phandana*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:3.4"], "en": "“That wood is as firm as a wheel-rim.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:4.1"], "en": "“What are its leaves like,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:4.2"], "en": "and what is its trunk like?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:4.3"], "en": "\"Questioned by me, friend,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:4.4"], "en": "explain it so that we may understand the *phandana* tree.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:5.1"], "en": "\"Its branches hang down...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:5.2"], "en": "They bend but do not break;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:5.3"], "en": "that tree is named Phandana,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:5.4"], "en": "at whose root I stand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:6.1"], "en": "Your spokes, nave, axle-pins,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:6.2"], "en": "pole, and the rim of the chariot—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:6.3"], "en": "all these are functional for you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:6.4"], "en": "“This shall become the *phandana* tree.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:7.1", "PA_ja_475:7.2"], "en": "Thus, even the *phandana* tree addressed him at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:7.3"], "en": "I too have words to say;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:7.4"], "en": "listen to me, Bhāradvāja.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:8.1"], "en": "From the attack of an enemy—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:8.2"], "en": "Having raised it four finger-breadths,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:8.3"], "en": "he extended the rim with that;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:8.4"], "en": "in this way, it would become even more firm.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:9.1", "PA_ja_475:9.2", "PA_ja_475:9.3"], "en": "Thus even the trembling tree at that time laid down its enmity toward both those already born and those yet unborn.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:9.4"], "en": "Envy brought suffering to the *phandana* tree;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:10.1"], "en": "thus indeed did the *phandana* envy the *issa*,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:10.2"], "en": "and the *issa* in turn the *phandana*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:10.3"], "en": "Through mutual dispute,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:10.4"], "en": "they struck one another down;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:11.1"], "en": "even so it is with human beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:11.2"], "en": "Wherever a dispute arises,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:11.3"], "en": "they dance the peacock’s dance,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:11.4"], "en": "just like those trembling with pride.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:12.1"], "en": "I say this to you for your welfare,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:12.2"], "en": "all you who are gathered here:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:12.3"], "en": "Rejoice together, do not dispute.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:12.4"], "en": "Do not be subject to the agitation of pride;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:13.1"], "en": "train yourselves in concord alone,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:13.2"], "en": "for this is praised by the Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:13.3"], "en": "“Delighting in harmony and established in the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:13.4"], "en": "one does not fall away from the security from bondage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_475:14.1"], "en": "Thus ends the second Jātaka, the Phandana Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
