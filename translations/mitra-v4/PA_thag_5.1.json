[
{"segs": ["PA_thag_5.1:0.1", "PA_thag_5.1:0.2", "PA_thag_5.1:0.3"], "en": "Theragāthā 5.1 Pañcaka-nipāta First Chapter (Paṭhama-vagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:0.4"], "en": "The Verses of the Elder Rājadatta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:1.1", "PA_thag_5.1:1.2"], "en": "“Having gone to a cemetery, a bhikkhu saw a woman who had been abandoned.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:1.3"], "en": "Cast away in the cemetery,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:1.4"], "en": "covered with maggots, and being devoured—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:2.1"], "en": "this is what some people loathe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:2.2"], "en": "Having seen that evil thought,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:2.3"], "en": "sensual lust arose within me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:2.4"], "en": "and I became as if blind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:3.1"], "en": "Soon after the rice was cooked,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:3.2"], "en": "I departed from that place,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:3.3"], "en": "mindful and clearly comprehending.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:3.4"], "en": "I sat down to one side.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:4.1", "PA_thag_5.1:4.2"], "en": "Then, right mindfulness arose in me through wise reflection.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:4.3"], "en": "The danger became manifest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:4.4"], "en": "and disenchantment took firm root;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:5.1"], "en": "thereupon my mind was liberated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:5.2"], "en": "Behold the excellence of the Dhamma!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:5.3"], "en": "The three knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:5.4"], "en": "the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.1:5.5"], "en": "… the elder Rājadatta …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
