[
{"segs": ["PA_tha-ap_145:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:0.2", "PA_tha-ap_145:0.3"], "en": "Chapter on the Parasols (Chattavagga), 3. The Apadāna of the Elder Vedikāraka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:1.1", "PA_tha-ap_145:1.2"], "en": "“When the Protector of the World, Piyadassin, the supreme among men, had attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:1.3"], "en": "with a clear heart and a joyful mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:1.4"], "en": "I had an altar made of pearls,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:2.1"], "en": "and having surrounded it with gems,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:2.2"], "en": "I fashioned that most excellent altar.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:2.3"], "en": "Having constructed a great railing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:2.4"], "en": "I passed away there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:3.1"], "en": "Whichever womb I was reborn into, I remained there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:3.2"], "en": "Whether divine or human,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:3.3"], "en": "they wear jewels in the sky;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:3.4"], "en": "this is the fruit of meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:4.1"], "en": "Sixty-one hundred aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:4.2", "PA_tha-ap_145:4.3"], "en": "there were thirty-six kings named Maṇippabhāsa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:4.4"], "en": "Universal monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:5.1", "PA_tha-ap_145:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:6.1"], "en": "Thus indeed did the Venerable Elder Vedikāraka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_145:7.1"], "en": "This is the third *apadāna* of the Elder Vedikāraka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
