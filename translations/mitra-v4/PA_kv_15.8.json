[
{"segs": ["PA_kv_15.8:0.1", "PA_kv_15.8:0.2", "PA_kv_15.8:0.3"], "en": "Points of Controversy The Great Fifty The Fifteenth Chapter", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:0.4"], "en": "The Second Discussion on Perception and Feeling:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:1.1", "PA_kv_15.8:1.2"], "en": "Is the attainment of the cessation of perception and feeling mundane? Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:1.3"], "en": "\"Is it form?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:1.4"], "en": "\"One should not say so...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:1.5"], "en": "[and so on] \"...feeling...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:1.6"], "en": "Perception...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:1.7"], "en": "mental formations...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:1.8"], "en": "consciousness?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:1.9", "PA_kv_15.8:1.10"], "en": "It should not be said thus … [as before] … Are they of the sense-sphere realm (*kāmāvacara*)?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:1.11"], "en": "It should not be said thus … [as before] …", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:1.12"], "en": "Are they of the fine-material sphere?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:1.13", "PA_kv_15.8:1.14"], "en": "One should not say so … [as before] … Are they of the immaterial sphere?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:1.15", "PA_kv_15.8:2.1", "PA_kv_15.8:2.2"], "en": "It should not be said thus … [as before] … Should it not be said that “the attainment of the cessation of perception and feeling is mundane”?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:2.3"], "en": "“Yes,” you say.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:2.4"], "en": "“Are they supramundane?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:2.5"], "en": "You should not say so.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:2.6"], "en": "Therefore, they are mundane.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_15.8:2.7"], "en": "The discussion on the second perception of feeling is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"}
]
