[
{"segs": ["PA_thig_1.14:0.1", "PA_thig_1.14:0.2"], "en": "Therīgāthā 1.14 Ekakanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.14:0.3"], "en": "The Verses of the Elder Nun Sumanā", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.14:1.1"], "en": "“Having seen the elements as suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.14:1.2"], "en": "may you not come to birth again;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.14:1.3"], "en": "having dispelled desire for existence, [may you reach the end of suffering].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.14:1.4"], "en": "“You shall live in peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.14:2.1"], "en": "… Thus spoke the elder nun Sumanā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
