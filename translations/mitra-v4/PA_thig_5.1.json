[
{"segs": ["PA_thig_5.1:0.1", "PA_thig_5.1:0.2"], "en": "Therīgāthā 5.1 Pañcakanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:0.3"], "en": "The Verses of a Certain Elder Nun (Aññataratherīgāthā)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:1.1", "PA_thig_5.1:1.2"], "en": "“For twenty-five years since I went forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:1.3"], "en": "not even for the duration of a finger snap— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:1.4"], "en": "Having attained tranquility of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:2.1"], "en": "yet failing to find peace of heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:2.2"], "en": "they are drenched by the lust for sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:2.3"], "en": "Raising my arms and weeping,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:2.4"], "en": "I entered the monastery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:3.1"], "en": "there I approached a bhikkhunī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:3.2", "PA_thig_5.1:3.3"], "en": "She who was my confidante taught me the Dhamma:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:3.4"], "en": "the aggregates, the sense bases, and the elements.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:4.1"], "en": "Having heard his Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:4.2"], "en": "I withdrew to a secluded place;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:4.3"], "en": "I know my former births.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:4.4"], "en": "The divine eye has been purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:5.1", "PA_thig_5.1:5.2"], "en": "the knowledge of penetrating others' minds and the faculty of the ear have been purified.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:5.3"], "en": "The supernormal powers have been realized by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:5.4"], "en": "the destruction of the taints has been attained by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:5.5"], "en": "the six direct knowledges have been realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:5.6"], "en": "“Thus was the teaching of the Buddha spoken. ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_5.1:6.1"], "en": "[Spoken by] a certain elder nun.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"}
]
