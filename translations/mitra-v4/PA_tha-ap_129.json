[
{"segs": ["PA_tha-ap_129:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:0.2"], "en": "Sereyyavagga 7.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:0.3"], "en": "The Apadāna of the Elder Phaladāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:1.1"], "en": "“A reciter, a bearer of mantras,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:1.2"], "en": "one who has mastered the three Vedas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:1.3"], "en": "not far from the Himalayas.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:1.4"], "en": "I dwell in this hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:2.1", "PA_tha-ap_129:2.2"], "en": "I have the sacred fire-oblation and lotus seeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:2.3"], "en": "Having placed it in a casket,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:2.4"], "en": "I hung it upon a tree branch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:3.1"], "en": "Padumuttara, the Knower of the World, [saw it].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:3.2"], "en": "He is the recipient of oblations;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:3.3"], "en": "desiring to lift me up,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:3.4"], "en": "he has come to me as a mendicant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:4.1"], "en": "With a clear mind and a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:4.2"], "en": "I gave a fruit to the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:4.3"], "en": "generating great gladness within me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:4.4"], "en": "Bringing happiness in this very life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:5.1"], "en": "the Sambuddha, golden-hued,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:5.2"], "en": "is the recipient of offerings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:5.3", "PA_tha-ap_129:5.4"], "en": "Standing in the sky, the Teacher spoke this verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:6.1"], "en": "“By this gift of fruit, [may I...]”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:6.2"], "en": "And through his volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:6.3"], "en": "for a hundred thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:6.4"], "en": "he does not fall into an evil rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:7.1", "PA_tha-ap_129:7.2"], "en": "Having experienced prosperity through that very same root of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:7.3"], "en": "I have attained the unshakable state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:7.4"], "en": "Having abandoned victory and defeat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:8.1"], "en": "seven hundred kalpas ago from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:8.2"], "en": "I was King Sumaṅgala.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:8.3"], "en": "Endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:8.4"], "en": "a wheel-turning monarch of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:9.1"], "en": "[I possess] the four analytical knowledges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:9.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:9.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:10.1"], "en": "Thus indeed did the Venerable Phaladāyaka Thera speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_129:11.1"], "en": "The legend of the Elder Phaladāyaka is the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
