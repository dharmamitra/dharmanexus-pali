[
{"segs": ["PA_tha-ap_264:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:0.2"], "en": "Padumukkhipavagga 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:0.3"], "en": "The Apadāna of the Elder Telamakkhiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:1.1"], "en": "“When the Blessed One Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:1.2"], "en": "that bull among men, had attained final Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:1.3"], "en": "I [built] a railing for his Bodhi tree.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:1.4"], "en": "I anointed [him] with oil at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:2.1", "PA_tha-ap_264:2.2"], "en": "That oil which I anointed with then, ninety-four aeons ago—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:2.3"], "en": "I do not recall being born in an evil state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:2.4"], "en": "this is the fruit of anointing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:3.1"], "en": "Twenty-four aeons from now...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:3.2"], "en": "A Kṣatriya named Succhavi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:3.3", "PA_tha-ap_264:3.4"], "en": "a wheel-turning monarch of great power, endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:4.1", "PA_tha-ap_264:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:5.1"], "en": "Thus indeed the venerable elder Telamakkhiya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_264:6.1"], "en": "This is the second *apadāna* of the elder Telamakkhiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
