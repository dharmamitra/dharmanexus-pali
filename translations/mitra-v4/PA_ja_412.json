[
{"segs": ["PA_ja_412:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:0.2"], "en": "The Section of Seven Stories,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:0.3"], "en": "Chapter on Gandhāra.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:0.4", "PA_ja_412:1.1", "PA_ja_412:1.2"], "en": "7. The Koṭasimbalijātaka “I have come bringing a serpent ten hundred fathoms long.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:1.3", "PA_ja_412:1.4"], "en": "And you do not tremble while supporting that very large body; yet now,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:2.1"], "en": "this small bird—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:2.2"], "en": "I am far more powerful than you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:2.3"], "en": "why do you tremble in fear while holding me?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:2.4"], "en": "For what purpose, O Koṭasimbali?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:3.1"], "en": "“You, O King, are an eater of meat,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:3.2"], "en": "while this brahmin is an eater of fruits;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:3.3"], "en": "he [is sowing] seeds of the *nigrodha* tree.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:3.4"], "en": "Having eaten the Pilakkhu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:3.5"], "en": "Udumbara, and Assattha fruits,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:3.6"], "en": "he will discharge his waste upon my trunk.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:4.1"], "en": "Those trees grow up,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:4.2"], "en": "sheltered from the wind on my side;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:4.3"], "en": "they will completely envelop me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:4.4"], "en": "They will make me a tree.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:5.1"], "en": "There are other trees as well—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:5.2"], "en": "those with roots and trunks, those great trees.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:5.3"], "en": "By this species of bird,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:5.4"], "en": "the seeds were brought and destroyed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:6.1"], "en": "yet the overgrowths continue to increase.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:6.2"], "en": "Even a massive forest tree;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:6.3"], "en": "therefore, O King, I tremble,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:6.4"], "en": "foreseeing the danger that has arrived.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:7.1"], "en": "“One should suspect those things that are to be suspected,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:7.2"], "en": "and guard against future danger;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:7.3"], "en": "for the wise person [guards] against future dangers.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:7.4"], "en": "“He surveys both worlds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_412:8.1"], "en": "Thus ends the seventh Jātaka, the Koṭasimbalijātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
