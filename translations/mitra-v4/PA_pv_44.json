[
{"segs": ["PA_pv_44:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:0.2"], "en": "Mahāvagga 9.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:0.3"], "en": "The Story of the Feces-Eating Ghost (Gūthakhādaka-petivatthu)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:1.1"], "en": "“Having emerged from a pit of excrement,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:1.2"], "en": "who are you that stands here so dejected?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:1.3"], "en": "Without doubt, you are one of evil deeds.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:1.4"], "en": "\"Do you believe me, then?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:2.1", "PA_pv_44:2.2"], "en": "\"I do, venerable sir; I am a female peta, miserable, belonging to the world of Yama.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:2.3"], "en": "“Having committed evil deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:2.4"], "en": "we have gone from here to the world of the departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:3.1"], "en": "“What indeed [did you do] by way of body or speech?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:3.2"], "en": "An evil deed was committed by you with the mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:3.3", "PA_pv_44:3.4"], "en": "through the ripening of what karma do you undergo this suffering?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:4.1"], "en": "“There was a resident in my home,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:4.2"], "en": "envious and stingy regarding families;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:4.3"], "en": "he was obsessed with my house.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:4.4"], "en": "A miserly reviler.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:5.1"], "en": "Having heard his words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:5.2"], "en": "O monks, I rebuked him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:5.3"], "en": "“By the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:5.4"], "en": "she has gone from here to the world of the hungry ghosts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:6.1"], "en": "“A friend in the guise of a friend,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:6.2"], "en": "He who was your family attendant—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:6.3"], "en": "having broken up the body, that one of poor wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:6.4"], "en": "what destination has he gone to after passing away?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:7.1", "PA_pv_44:7.2"], "en": "“I stand right there upon the head of that very person for their evil deed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:7.3"], "en": "yet he has reached the territory of another.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:7.4"], "en": "He is indeed my attendant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:8.1"], "en": "Whatever else, O Venerable Sir,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:8.2"], "en": "I might offer, that becomes my food.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:8.3", "PA_pv_44:8.4"], "en": "\"And whatever I eat, that he subsists upon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_44:9.1"], "en": "The Story of the Feces-Eating Preta, the Ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
