[
{"segs": ["PA_thag_1.30:0.1", "PA_thag_1.30:0.2", "PA_thag_1.30:0.3"], "en": "Theragāthā 1.30 Ekakanipāta Tatiyavagga (The Third Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:0.4"], "en": "The Verses of the Elder Uttiya:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:1.1"], "en": "“When affliction arose within me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:1.2"], "en": "mindfulness was born in me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:1.3"], "en": "“An affliction has arisen for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:1.4"], "en": "it is time for me not to be negligent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:1.5"], "en": "… Thus spoke the Elder Uttiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:1.6"], "en": "The third chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:2.0"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:2.1"], "en": "Nigrodha, Thera Cittaka, and...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:2.2"], "en": "The elder Gosāla, Sugandha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:2.3"], "en": "the elders Nandiya and Abhaya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:2.4"], "en": "and the elder Lomasakaṅgiya;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:2.5"], "en": "And Jambukhādaka, the son of the village headman,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.30:2.6"], "en": "Hārita, and the seer Uttiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
