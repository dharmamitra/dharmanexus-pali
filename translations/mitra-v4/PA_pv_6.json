[
{"segs": ["PA_pv_6:0.1"], "en": "The Peta Stories,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:0.2"], "en": "Chapter on Snakes, Story 6:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:0.3"], "en": "The Story of the Female Ghost Who Ate Five Sons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:1.1"], "en": "“Naked you are, of ugly form,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:1.2"], "en": "foul-smelling and exhaling stench;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:1.3"], "en": "you are surrounded by flies.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:1.4"], "en": "“Who are you that stands here?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:2.1"], "en": "“I am a female peta, venerable sir,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:2.2"], "en": "miserable and belonging to the world of Yama.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:2.3"], "en": "Having committed evil deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:2.4"], "en": "they have gone from here to the world of the departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:3.1"], "en": "In due time, five sons—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:3.2"], "en": "In the evening, five more;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:3.3"], "en": "having given birth, I devour them,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:3.4"], "en": "yet even they are not enough for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:4.1", "PA_pv_6:4.2"], "en": "My heart burns and smokes with hunger;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:4.3"], "en": "I find no water to drink.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:4.4"], "en": "“Behold me fallen into calamity!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:5.1", "PA_pv_6:5.2"], "en": "[He asked: “What evil deed have you committed by body, speech, or mind?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:5.3", "PA_pv_6:5.4"], "en": "“By the ripening of what karma do you eat the flesh of your own son?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:6.1"], "en": "“My co-wife was pregnant,” he replied.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:6.2"], "en": "I conceived an evil thought toward her;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:6.3"], "en": "with a corrupted mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:6.4"], "en": "I brought about her miscarriage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:7.1", "PA_pv_6:7.2"], "en": "Her two-month-old fetus was discharged as blood alone; at that,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:7.3"], "en": "her mother became angry.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:7.4"], "en": "He brought my kinsmen together;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:7.5", "PA_pv_6:7.6"], "en": "he made me take an oath and caused me to be reviled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:8.1", "PA_pv_6:8.2"], "en": "I uttered a terrible oath and spoke a falsehood:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:8.3"], "en": "\"I eat the flesh of my own son.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:8.4", "PA_pv_6:9.1"], "en": "If that was done by me, then as the result of that karma—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:9.2"], "en": "of both [the deed] and the false speech—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:9.3", "PA_pv_6:9.4"], "en": "“I eat the flesh of my sons, smeared with pus and blood. The sixth story:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_6:10.1"], "en": "The Story of Her Who Caused Her Five Sons to Be Eaten.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
