[
{"segs": ["PA_ja_530:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:0.2"], "en": "The Sixty-Nipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:0.3"], "en": "the Soṇaka Chapter", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:0.4"], "en": "2. The Saṅkicca Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:1.1", "PA_ja_530:1.2"], "en": "Having seen King Brahmadatta, the bull among charioteers, seated there;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:1.3"], "en": "Then he informed him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:1.4"], "en": "\"O you who are compassionate,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:2.1"], "en": "Saṅkicca has arrived.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:2.2"], "en": "This sage is honored by the virtuous;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:2.3"], "en": "go forth in haste,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:2.4"], "en": "quickly see the Great Seer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:3.1"], "en": "Then the king, hurrying,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:3.2", "PA_ja_530:3.3"], "en": "mounted his harnessed chariot and was surrounded by friends and ministers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:3.4"], "en": "The bull among charioteers arrived.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:4.1"], "en": "Having laid aside the five insignia of royalty,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:4.2"], "en": "the prosperer of the Kāsi kingdom, he entered.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:4.3", "PA_ja_530:4.4"], "en": "A yak-tail whisk, a turban, a sword, a parasol, and sandals— having mounted his vehicle,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:5.1"], "en": "the king [descended].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:5.2"], "en": "Setting aside his cloak,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:5.3", "PA_ja_530:5.4"], "en": "he approached Saṅkicca as he sat on the bank of the river.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:6.1", "PA_ja_530:6.2"], "en": "Having approached, the king exchanged greetings with the seer;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:6.3"], "en": "having concluded that conversation, he—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:6.4"], "en": "He sat down to one side.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:7.1"], "en": "While sitting there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:7.2"], "en": "he then considered the time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:7.3", "PA_ja_530:7.4"], "en": "Therefore, proceed to ask about evil deeds:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:8.1"], "en": "\"We shall question the seer Saṅkicca.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:8.2"], "en": "To the seer esteemed by the virtuous,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:8.3", "PA_ja_530:8.4"], "en": "seated on the mountain slope and honored by the assembly of seers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:9.1", "PA_ja_530:9.2"], "en": "To what destination do men who have transgressed the Dhamma go after they pass away?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:9.3"], "en": "\"The Dhamma has been transgressed by me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:9.4"], "en": "\"Tell me that when you are asked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:10.1", "PA_ja_530:10.2"], "en": "Thus did the seer Saṅkicca speak to the one who increases the prosperity of the kingdom of Kāsī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:10.3"], "en": "“Seated on the bank of the Dāya, [the Buddha said]:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:10.4"], "en": "‘Great King, listen to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:11.1"], "en": "For one traveling by a wrong path, ...’”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:11.2"], "en": "He who instructs one in the path—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:11.3"], "en": "if one were to act upon his words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:11.4"], "en": "no thorn would pierce that person's foot.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:12.1", "PA_ja_530:12.2"], "en": "If one who practices unrighteousness should follow the instruction of one who teaches the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:12.3"], "en": "and should act upon that word—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:12.4"], "en": "“He would not go to an evil destination.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:13.1"], "en": "“The Dhamma is the path, O Great King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:13.2"], "en": "while non-Dhamma is the wrong path.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:13.3"], "en": "Unrighteousness leads to hell;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:13.4"], "en": "righteousness brings one to a happy destination.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:14.1"], "en": "O King, for those who practice unrighteousness—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:14.2"], "en": "Those men who live by dishonest means—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:14.3", "PA_ja_530:14.4"], "en": "listen to me as I describe the destination they go to after passing away: it is hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:15.1"], "en": "Sañjīva and Kālasutta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:15.2"], "en": "Saṅghāta and the two Roruvas;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:15.3"], "en": "and furthermore, Mahāvīci.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:15.4"], "en": "Tāpana and Patāpana—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:16.1"], "en": "thus these eight hells have been declared,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:16.2"], "en": "which are difficult to transcend.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:16.3"], "en": "Crowded with cruel deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:16.4"], "en": "each one possessing sixteen swellings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:17.1"], "en": "they are terrible, tormenting those who are miserly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:17.2"], "en": "They are full of flames and bring great terror;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:17.3"], "en": "their forms cause the hair to stand on end,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:17.4"], "en": "being dreadful, fearsome, and painful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:18.1"], "en": "With four corners and four gates,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:18.2"], "en": "divided and measured out in sections,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:18.3"], "en": "and surrounded by an iron wall.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:18.4"], "en": "They are covered with iron.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:19.1"], "en": "For them, the ground is made of iron,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:19.2"], "en": "blazing and filled with heat.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:19.3"], "en": "Pervading a hundred leagues all around,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:19.4"], "en": "they stand there at all times.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:20.1"], "en": "These fall into hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:20.2"], "en": "With feet upturned and heads hanging down,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:20.3", "PA_ja_530:20.4"], "en": "they overstep the sages who are self-restrained and devoted to austerity.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:21.1", "PA_ja_530:21.2", "PA_ja_530:21.3"], "en": "Those slayers of living beings are tormented for incalculable years, like fish broiled on a spit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:21.4"], "en": "Those people who commit evil deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:22.1", "PA_ja_530:22.2"], "en": "with their limbs constantly burning both inside and out;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:22.3", "PA_ja_530:22.4"], "en": "Seeking an exit, they do not find the gates;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:23.1"], "en": "they run toward the east.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:23.2"], "en": "Then they run behind;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:23.3"], "en": "they run to the north,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:23.4"], "en": "and then they run to the south.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:23.5"], "en": "For whichever door they go toward,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:23.6"], "en": "that very one is closed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:24.1"], "en": "for many thousands of years.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:24.2"], "en": "People bound for hell,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:24.3"], "en": "having raised their arms and wailed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:24.4"], "en": "shall experience no small suffering once they have arrived there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:25.1"], "en": "Like an angry venomous snake,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:25.2"], "en": "radiant and difficult to overcome,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:25.3"], "en": "one should not step upon one of noble character.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:25.4"], "en": "Of those who are self-restrained and ascetic.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:26.1", "PA_ja_530:26.2"], "en": "Ajjuna, the lord of the Kekakas, possessed a massive body and was a great archer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:26.3", "PA_ja_530:26.4"], "en": "Sahassabāhu, having seized the seer Gotama, cut off his thousand arms;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:27.1"], "en": "he covered the dustless one with dust, O Vaccha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:27.2"], "en": "Having cast down the wretched Daṇḍakī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:27.3", "PA_ja_530:27.4"], "en": "that king perished from his royal power like a palmyra tree cut off at the root.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:28.1"], "en": "Having struck down his pride,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:28.2"], "en": "he stood in the midst of the illustrious Mātaṅga;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:28.3"], "en": "together with his retinue, he was utterly destroyed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:28.4", "PA_ja_530:29.1", "PA_ja_530:29.2"], "en": "At that time, the Andhakaveṇḍas approached the seer Kaṇhadīpāyana in the middle of the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:29.3"], "en": "Having struck one another with pestles,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:29.4"], "en": "they have reached the abode of Yama;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:30.1"], "en": "now this being has been [struck] by the seer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:30.2"], "en": "Formerly a wanderer through the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:30.3"], "en": "that greedy man has now descended to the earth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:30.4"], "en": "base-minded and reduced to the state of a mere alms-bowl carrier.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:31.1", "PA_ja_530:31.2"], "en": "Therefore, the wise do not praise approaching with desire;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:31.3"], "en": "one should speak with a mind free from ill will.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:31.4"], "en": "One should speak speech endowed with truth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:32.1", "PA_ja_530:32.2"], "en": "But if a man, with a corrupted mind, looks upon a sage;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:32.3"], "en": "One who reviles those endowed with true knowledge and conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:32.4", "PA_ja_530:33.1"], "en": "and those who revile the elders, shall go to the depths of hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:33.2"], "en": "People who act with harshness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:33.3"], "en": "who are ungrateful and leave no inheritance,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:33.4"], "en": "become like the base of a palmyra tree.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:34.1"], "en": "And he who kills one gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:34.2"], "en": "a great seer who has accomplished his task—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:34.3"], "en": "he [will fall] into the Kāḷasutta hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:34.4"], "en": "He is cooked for a long time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:35.1"], "en": "And that king who stands on unrighteousness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:35.2"], "en": "a beast who destroys the kingdom;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:35.3"], "en": "Having scorched the country,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:35.4", "PA_ja_530:36.1"], "en": "he is cooked in the Scorching Hell after death for thousands of years. And he—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:36.2"], "en": "For a hundred [eons], he is cooked in the divine realms;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:36.3"], "en": "overtaken by a mass of flames,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:36.4"], "en": "he experiences painful sensation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:37.1", "PA_ja_530:37.2"], "en": "From his body, radiant crests of flame issued forth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:37.3"], "en": "the limbs of him who subsists on fire-energy shone brightly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:37.4"], "en": "With hair and with nails,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:38.1", "PA_ja_530:38.2"], "en": "as my body burns constantly both within and without;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:38.3"], "en": "Oppressed by suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:38.4"], "en": "he cries out like an elephant struck by a goad—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:39.1"], "en": "he who, out of greed, kills his own father.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:39.2"], "en": "Or a base man of defilements—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:39.3", "PA_ja_530:39.4"], "en": "he is cooked for a long time in the Kālasutta hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:40.1"], "en": "Such a one is cooked in a copper cauldron;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:40.2"], "en": "once cooked, they are struck with spears until their skin is stripped away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:40.3"], "en": "Having been blinded, they are made to consume urine and excrement.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:40.4"], "en": "Such a person sinks into salt water,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:41.1"], "en": "as does a red-hot, boiling iron ball,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:41.2"], "en": "or a long ploughshare heated for a long time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:41.3"], "en": "Taking hold of the obstructing ropes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:41.4"], "en": "the rākṣasas enter through the opened mouth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:42.1"], "en": "there are vultures, jackals, crows, and eagles.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:42.2"], "en": "And flocks of crows with iron beaks,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:42.3"], "en": "having gathered together, devour the quivering tongue,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:42.4"], "en": "dividing it into pieces along with the dregs and blood.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:43.1"], "en": "As that palm tree is being consumed and its body shattered,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:43.2"], "en": "the rākṣasas roam about crushing it;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:43.3"], "en": "for their pleasure indeed consists in the suffering of others.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:43.4"], "en": "Such is the hell in which those dwell who,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:43.5"], "en": "in this world, have murdered their fathers;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:44.1"], "en": "and the son who has slain his mother—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:44.2"], "en": "Having gone from here to the destruction of the Yama realm,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:44.3"], "en": "one undergoes intense suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:44.4"], "en": "reaping the fruit of one's own actions.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:45.1", "PA_ja_530:45.2"], "en": "Non-human beings of exceeding strength will strike the one who causes her to conceive,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:45.3"], "en": "with hair-tips made of iron.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:45.4"], "en": "They crush it again and again—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:46.1", "PA_ja_530:46.2"], "en": "their own limbs exude blood born from their own bodies.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:46.3", "PA_ja_530:46.4"], "en": "They force them to drink molten copper as hot as fire; it is loathsome,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:47.1"], "en": "putrid, and foul-smelling.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:47.2"], "en": "Having plunged into a pond that is foul-smelling,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:47.3"], "en": "a mire of excrement,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:47.4"], "en": "resembling pus and blood, he stands therein.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:48.1", "PA_ja_530:48.2", "PA_ja_530:48.3"], "en": "There, worms with massive bodies and iron mouths pierce through his skin and devour him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:48.4"], "en": "Greedy for flesh and blood,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:49.1"], "en": "he has fallen into that hell,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:49.2"], "en": "submerged in it to a depth of a hundred fathoms.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:49.3", "PA_ja_530:49.4"], "en": "The putrid corpse stinks for a hundred yojanas all around;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:50.1"], "en": "for even one with eyes cannot [bear it] with his eyes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:50.2"], "en": "One is overcome by that scent;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:50.3", "PA_ja_530:50.4"], "en": "such is the suffering a woman incurs, O Brahmadatta.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:51.1", "PA_ja_530:51.2"], "en": "Following the sharp and difficult-to-traverse path that bears the weight of the burden,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:51.3"], "en": "those who have fallen from the womb descend.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:51.4"], "en": "The difficult-to-cross river Vetaraṇī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:52.1", "PA_ja_530:52.2"], "en": "and the iron *śālmali* trees with thorns sixteen finger-breadths long.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:52.3", "PA_ja_530:52.4"], "en": "They hang down on both sides over the difficult-to-cross river Vetaraṇī;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:53.1"], "en": "blazing with flames, they stand there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:53.2"], "en": "They are far removed from masses of fire,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:53.3"], "en": "blazing with Jātaveda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:53.4"], "en": "rising a yojana high.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:54.1"], "en": "These go to hell,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:54.2"], "en": "where there are those sharp thorns;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:54.3"], "en": "and so do women who commit adultery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:54.4"], "en": "And those men who take another’s wife—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:55.1", "PA_ja_530:55.2"], "en": "these, with their shoulders drooping, fallen away and shattered, fall down in great numbers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:55.3"], "en": "With their limbs pierced through,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:55.4"], "en": "they keep watch for a long time at all times; then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:56.1"], "en": "at the end of the night, they say:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:56.2"], "en": "They enter a vast iron cauldron,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:56.3"], "en": "resembling a mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:56.4"], "en": "filled with boiling water as hot as fire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:57.1"], "en": "Thus, both by day and by night,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:57.2", "PA_ja_530:57.3"], "en": "those who are immoral and shrouded in delusion experience their own karma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:57.4"], "en": "One’s own prior misconduct,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:58.1", "PA_ja_530:58.2"], "en": "and a wife purchased with wealth who treats her husband with contempt.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:58.3"], "en": "Whether it be his mother-in-law, his father-in-law,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:58.4"], "en": "or even his eldest sister-in-law—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:59.1"], "en": "he bends down his tongue-tip toward her.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:59.2"], "en": "They carry away their bonds;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:59.3", "PA_ja_530:59.4"], "en": "he sees within himself a worm the size of a span on his tongue.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:59.5"], "en": "If one is unable to make them understand,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:59.6"], "en": "one will be cooked in torment after passing away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:60.1"], "en": "[This applies to] those who deal in sheep and those who deal in pigs.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:60.2"], "en": "Fishermen, deer-trappers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:60.3"], "en": "thieves, cattle-slaughterers, and hunters—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:60.4"], "en": "those who speak praise where there is no praise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:61.1"], "en": "Being struck by spears,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:61.2"], "en": "iron clubs, javelins, and arrows,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:61.3"], "en": "they enter the river of lye.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:61.4"], "en": "They fall headlong.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:62.1"], "en": "At evening and at dawn,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:62.2"], "en": "the deceitful one is struck with iron clubs.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:62.3", "PA_ja_530:62.4"], "en": "Then they always consume the vomit of others who have spoken ill;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:63.1"], "en": "vultures, jackals, and scavengers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:63.2", "PA_ja_530:63.3", "PA_ja_530:63.4"], "en": "And the kākoḷa birds with iron beaks devour the man who has committed evil deeds as he writhes in agony.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:64.1"], "en": "Those who kill a deer with a deer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:64.2", "PA_ja_530:64.3"], "en": "or a bird with a bird, are the unvirtuous ones shrouded by the dust [of passion].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:64.4"], "en": "The wicked go to the eternal hell,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:65.1", "PA_ja_530:65.2"], "en": "while the virtuous go upwards by means of their well-performed deeds in this world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:65.3"], "en": "Behold the fruit of what has been well-performed:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:65.4"], "en": "the gods together with Indra and Brahmā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:66.1"], "en": "That, O Great King, I declare to you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:66.2"], "en": "Practice the Dhamma, O lord of the land;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:66.3"], "en": "practice the Dhamma, O King, in such a way that,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:66.4"], "en": "having practiced it well, you will have no regret later.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:67.1"], "en": "The Saṅkicca Jātaka, the second.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:68.1"], "en": "The Sixty-Chapter Collection is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:69.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:70.1"], "en": "Now, in the Saṭṭhinipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:70.2"], "en": "listen to my speech;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:70.3"], "en": "it is the excellent collection known as the Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:70.4"], "en": "Thus were called Soṇaka, Ariṇḍama, and Savhaya;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_530:70.5"], "en": "likewise Vutta, Ratha, Isabha, Kicca, and Vara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
