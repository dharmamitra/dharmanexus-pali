[
{"segs": ["PA_thag_8.1:0.1", "PA_thag_8.1:0.2", "PA_thag_8.1:0.3"], "en": "Theragāthā 8.1 Aṭṭhaka-nipāta Paṭhama-vagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:0.4"], "en": "The Verses of the Elder Mahākaccāyana:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:1.1"], "en": "\"One should not perform much work;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:1.2"], "en": "one should avoid crowds and not exert oneself.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:1.3"], "en": "Thus, being zealous and greedy for flavors,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:1.4"], "en": "one neglects the goal that brings true happiness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:2.1"], "en": "for they have known this to be a mire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:2.2", "PA_thag_8.1:2.3"], "en": "This honoring and worshiping among families is a subtle dart difficult to extract;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:2.4"], "en": "honor is hard for a base person to abandon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:3.1", "PA_thag_8.1:3.2"], "en": "A mortal should not perform an evil deed for the sake of another;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:3.3"], "en": "he should not practice it himself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:3.4"], "en": "For one's kamma is indeed one's kin, O Mother.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:4.1"], "en": "One is not a thief because of another’s word,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:4.2"], "en": "nor is one a sage because of another’s word.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:4.3"], "en": "As he himself knows himself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:4.4"], "en": "so do the gods know him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:5.1"], "en": "but others do not understand him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:5.2"], "en": "We shall strive for this here:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:5.3"], "en": "those who understand this matter,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:5.4"], "en": "their disputes are thereby stilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:6.1"], "en": "Even one who lives with wisdom is better,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:6.2"], "en": "even if their wealth is exhausted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:6.3"], "en": "than one who lacks wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:6.4"], "en": "Even one who possesses wealth does not truly live.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:7.1"], "en": "One hears everything with the ear;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:7.2"], "en": "one sees everything with the eye.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:7.3", "PA_thag_8.1:7.4"], "en": "Yet a wise person should not abandon everything seen or heard;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:8.1"], "en": "for he is like one with sight compared to a blind man.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:8.2"], "en": "Like one who has ears but is deaf;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:8.3"], "en": "like one who has wisdom but is mute;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:8.4"], "en": "like one who is strong but is weak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:8.5", "PA_thag_8.1:8.6"], "en": "\"Then, when a matter has arisen, one should lie down like a dead person. ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.1:8.7"], "en": "Thus spoke the Elder Mahākaccāyana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
