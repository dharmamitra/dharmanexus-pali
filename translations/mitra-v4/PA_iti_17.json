[
{"segs": ["PA_iti_17:0.1"], "en": "Itivuttaka 17:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:0.2"], "en": "Ekakanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:0.3"], "en": "Second Chapter (Dutiyavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:0.4"], "en": "The Second Discourse on the Trainee.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:1.1"], "en": "This was said by the Blessed One, said by the Arahant; thus have I heard:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:2.1_0"], "en": "“Bhikkhus, for a bhikkhu who is a trainee, who has not yet attained his mind’s ideal, but who aspires to the unsurpassed security from bondage—”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:2.1_1", "PA_iti_17:2.1_2"], "en": "“Monks, for one who dwells making external factors a limb, I do not see even a single other factor that is so helpful as this: having virtuous friends.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:2.2"], "en": "Monks, a monk with virtuous friends abandons what is unwholesome and develops what is wholesome.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:2.3"], "en": "The Blessed One spoke this matter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:2.4"], "en": "Regarding this, it is said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:3.1"], "en": "“The bhikkhu who has a virtuous friend...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:3.2"], "en": "Full of deference and respect,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:3.3"], "en": "acting upon the advice of friends,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:3.4"], "en": "he is clearly comprehending and mindful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:3.5", "PA_iti_17:3.6"], "en": "\"One shall gradually attain the destruction of all fetters.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:4.1"], "en": "This meaning was also spoken by the Blessed One; thus have I heard.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_17:4.2"], "en": "The seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
