[
{"segs": ["PA_cp_20:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:0.2"], "en": "Hatthināgavagga, Sīlapāramī 10:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:0.3"], "en": "The Perfection of Virtue of the Elephant King.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:0.4", "PA_cp_20:1.1"], "en": "The Saṅkhapāla Jātaka: “Furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:1.2"], "en": "when I was the powerful Saṅkhapāla, ...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:1.3"], "en": "The fanged weapon, of terrible venom,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:1.4"], "en": "the double-tongued lord of serpents,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:2.1"], "en": "at the crossroads on the great highway.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:2.2"], "en": "In that place crowded with various people,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:2.3"], "en": "having resolved upon the four requisites,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:2.4"], "en": "I made my dwelling there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:3.1"], "en": "Whether by skin, hide, flesh,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:3.2", "PA_cp_20:3.3"], "en": "sinew, or bone— whatever is to be done with these, let it be done.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:3.4"], "en": "\"Let him take what has been given.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:4.1", "PA_cp_20:4.2"], "en": "Then the Bhojaputta hunters— cruel, fierce, and pitiless— beheld [him].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:4.3"], "en": "They approached me there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:4.4"], "en": "with sticks and clubs in their hands;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:5.1"], "en": "having pierced through my nose, they—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:5.2", "PA_cp_20:5.3"], "en": "Having hoisted me upon a palanquin by my tail and spine,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:5.4"], "en": "the sons of Bhoja carried me away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:6.1", "PA_cp_20:6.2", "PA_cp_20:6.3"], "en": "If I so desired, I could [rule] the earth bounded by the ocean, together with its forests and its mountains.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:6.4"], "en": "One should not extinguish it with a wind-blown fan,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:7.1", "PA_cp_20:7.2"], "en": "even while being pierced by stakes or crushed by spears.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:7.3"], "en": "“I am not angry with the son of the Bhoja;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:7.4"], "en": "this is my perfection of virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:8.1"], "en": "Thus ends the tenth chapter, the Story of Saṅkhapāla.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:9.1"], "en": "The second chapter: The Hatthināga Chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:10.1"], "en": "Its summary (uddāna) is:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:11.1"], "en": "Hatthināga and Bhūridatta.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:11.2"], "en": "Campeyya, Bodhi, Mahiṁsa, Ruru,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:11.3", "PA_cp_20:11.4"], "en": "Mātaṅga, Dhamma, Atraja, and Jayaddisa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:12.1", "PA_cp_20:12.2"], "en": "These nine powers of virtue are the requisites for the higher training;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:12.3"], "en": "having protected one's livelihood, [one should apply them].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:12.4"], "en": "I guarded my moral precepts.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:13.1"], "en": "While I was living as Saṅkhapāla,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:13.2"], "en": "my life lasted for all time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:13.3"], "en": "Whatever has been relinquished by anyone,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:13.4"], "en": "therefore that is the perfection of virtue (sīlapāramī).", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_20:14.1"], "en": "The exposition of the perfection of virtue is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
