{"segs": ["PA_thig_1.1:0.1", "PA_thig_1.1:0.2"], "en": "Therīgāthā 1.1 Ekakanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.1:0.3"], "en": "Verses of a Certain Elder Nun (Aññatarātherīgāthā)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.1:1.0"], "en": "Homage to that Blessed One, the Worthy One, the Perfectly Self-Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.1:1.1"], "en": "“Sleep happily, young nun,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.1:1.2"], "en": "having covered yourself with a cloth.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.1:1.3"], "en": "\"For your passion has been stilled,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.1:1.4"], "en": "like a pot of boiled rice.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_1.1:2.1"], "en": "Thus indeed did a certain elder nun, an unknown bhikkhunī, speak this verse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
