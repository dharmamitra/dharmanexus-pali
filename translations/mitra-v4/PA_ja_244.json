[
{"segs": ["PA_ja_244:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_244:0.2", "PA_ja_244:0.3"], "en": "The Second Book of Pairs, The Chapter on the Jackal (Siṅgālavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_244:0.4"], "en": "4. The Jātaka of the One Free from Desire:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_244:1.1"], "en": "\"What one sees, one does not desire;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_244:1.2"], "en": "and what one does not see, it is said, one desires.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_244:1.3"], "en": "I think he will wander for a long time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_244:1.4"], "en": "for he shall not obtain what he desires;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_244:2.1"], "en": "and that which he does obtain, he is not satisfied with it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_244:2.2"], "en": "Whatever one longs for, one despises when obtained;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_244:2.3"], "en": "for desire has an infinite range.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_244:2.4"], "en": "Homage to those who are free from desire!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_244:3.1"], "en": "The Vigaticchā Jātaka, the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
