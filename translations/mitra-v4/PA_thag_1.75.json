[
{"segs": ["PA_thag_1.75:0.1", "PA_thag_1.75:0.2", "PA_thag_1.75:0.3"], "en": "Theragāthā 1.75 Ekakanipāta Aṭṭhamavagga (The Eighth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.75:0.4"], "en": "The Verses of the Elder Susāradatta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.75:1.1"], "en": "“Good is the sight of those well-disciplined;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.75:1.2"], "en": "doubt is cut away and wisdom increases.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.75:1.3"], "en": "“They make even a fool wise;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.75:1.4"], "en": "therefore, meeting with the virtuous is good.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.75:1.5"], "en": "… [Spoken by] the Elder Susārada.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
