[
{"segs": ["PA_pv_9:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:0.2"], "en": "Uragavagga 9.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:0.3"], "en": "The Story of the Great Weaver-Preta (Mahāpesakārapetivatthu)", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:1.1", "PA_pv_9:1.2"], "en": "“She consumes excrement, urine, blood, and pus— what is the ripening of this?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:1.3"], "en": "What deed did this woman commit?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:1.4"], "en": "She who at all times feeds upon blood and pus;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:2.1", "PA_pv_9:2.2"], "en": "[she desires] new garments that are beautiful, soft, pure, and hairy.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:2.3"], "en": "“Having been given to me, she has become pale;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:2.4"], "en": "what deed did this woman do?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:3.1"], "en": "“She was my wife, venerable sir.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:3.2"], "en": "She is stingy, miserly, and avaricious;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:3.3"], "en": "when I give to ascetics and brahmins,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:3.4"], "en": "she reviles and abuses me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:4.1"], "en": "\"Consume excrement, urine, blood, and pus—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:4.2"], "en": "enjoy this impurity at all times;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:4.3"], "en": "let this be yours in the world beyond.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:4.4"], "en": "\"And let your clothes be made of rags.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:4.5"], "en": "Having practiced such misconduct,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:4.6"], "en": "one who has come here eats for a long time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_9:5.1"], "en": "The Ninth Story of the Ghost of the Great Weaver.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"}
]
