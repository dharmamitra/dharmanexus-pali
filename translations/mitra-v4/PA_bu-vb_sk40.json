[
{"segs": ["PA_bu-vb_sk40:0.1"], "en": "The Theravāda Vinaya Mahāvibhaṅga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:0.2", "PA_bu-vb_sk40:0.3"], "en": "Chapter on the Training Rules (Sekhiyakaṇḍa)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:0.4"], "en": "Sakkaccavagga 40.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:0.5"], "en": "The Training Rule on Mouthfuls.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.1"], "en": "At that time, the Buddha, the Blessed One, was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.2"], "en": "Now at that time, the group-of-six monks made their mouthfuls long... [etc.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.3.1"], "en": "\"The training is to be observed: 'I shall make my mouthfuls round.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.4"], "en": "A mouthful is to be made round.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.5"], "en": "Whoever, out of disrespect, makes a long mouthful, commits an offense of wrong-doing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.6.1", "PA_bu-vb_sk40:1.7"], "en": "There is no offense if it is unintentional.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.8", "PA_bu-vb_sk40:1.9", "PA_bu-vb_sk40:1.10"], "en": "In the case of one who is lacking mindfulness, one who is unaware, or one who is ill.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.11"], "en": "In snacks,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.12", "PA_bu-vb_sk40:1.13"], "en": "fruits, and supplementary foods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.14"], "en": "In times of distress,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.15"], "en": "for one who is insane,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.16"], "en": "and for an original offender.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.17"], "en": "The tenth training rule is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk40:1.18"], "en": "The fourth chapter, on \"With Care,\" is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
