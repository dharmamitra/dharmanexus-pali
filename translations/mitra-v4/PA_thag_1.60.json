[
{"segs": ["PA_thag_1.60:0.1", "PA_thag_1.60:0.2", "PA_thag_1.60:0.3"], "en": "Theragāthā 1.60 Ekakanipāta Chaṭṭhavagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.60:0.4"], "en": "Sīvali Thera’s Verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.60:1.1"], "en": "“Those intentions of mine were fulfilled,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.60:1.2"], "en": "for which purpose I entered the hut;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.60:1.3"], "en": "“May you attain true knowledge and liberation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.60:1.4"], "en": "abandoning the underlying tendency to conceit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.60:1.5"], "en": "… [Thus spoke] the Elder Sīvali.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.60:1.6"], "en": "The sixth chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.60:2.0", "PA_thag_1.60:2.1"], "en": "Its summary verse: Godhika and Subāhu, and...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.60:2.2"], "en": "The seer Valliya and Uttiya;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.60:2.3", "PA_thag_1.60:2.4"], "en": "the elder Añjanavaniya and two who dwelt in leaf huts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.60:2.5"], "en": "And Rāmaṇīyakaṭika,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.60:2.6"], "en": "and Sīvali called Kosala.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
