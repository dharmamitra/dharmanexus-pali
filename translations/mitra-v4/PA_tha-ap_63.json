[
{"segs": ["PA_tha-ap_63:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:0.2"], "en": "The Chapter on Those to be Thought About by Oneself (Sakacintaniyavagga) 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:0.3"], "en": "The Apadāna of the Elder Sakacintaniya (Sakacintaniyattheraapadāna)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:1.1"], "en": "“Having seen a forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:1.2"], "en": "windless, quiet, and undisturbed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:1.3"], "en": "as if frequented by seers;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:1.4"], "en": "The recipient of offerings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:2.1"], "en": "Having built a stupa out of sand,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:2.2"], "en": "I scattered various flowers upon it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:2.3", "PA_tha-ap_63:2.4"], "en": "I pay homage to the Emanation, who is like the Fully Enlightened One standing before me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:3.1"], "en": "he is endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:3.2"], "en": "The king is the lord over the realm;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:3.3"], "en": "I am satisfied by my own deeds—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:3.4"], "en": "this is the fruit of this flower-offering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:4.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:4.2"], "en": "because I offered that flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:4.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:4.4"], "en": "This is the fruit of that flower-offering:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:5.1"], "en": "for eighty eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:5.2"], "en": "I was a glorious wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:5.3"], "en": "Endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:5.4"], "en": "lord over the four continents;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:6.1"], "en": "possessing the four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:6.2", "PA_tha-ap_63:6.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:6.4"], "en": "the teaching of the Buddha has been accomplished.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:7.1"], "en": "Thus indeed did the venerable elder Sakacintaniya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_63:8.1"], "en": "This is the first legend of the elder Sakacintaniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
