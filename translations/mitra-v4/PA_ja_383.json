[
{"segs": ["PA_ja_383:0.1", "PA_ja_383:0.2", "PA_ja_383:0.3"], "en": "Jātaka Chakkanipāta: The Section on the Indestructible (Avāriyavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:0.4", "PA_ja_383:1.1", "PA_ja_383:1.2"], "en": "8. The Kukkuta Jātaka “O bird with a variegated-feathered wing-covering and a copper-colored crest;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:1.3"], "en": "“Descend from the branch of the tree;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:1.4"], "en": "I shall become your wife for nothing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:2.1"], "en": "“O auspicious one, you are a four-footed creature!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:2.2"], "en": "I am a delightful woman among bipeds;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:2.3"], "en": "like a doe or a bird unattached,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:2.4"], "en": "seek another husband.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:3.1"], "en": "“I shall be your maiden,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:3.2"], "en": "Mañjukā, speaking sweetly;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:3.3"], "en": "find me with noble knowledge.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:3.4"], "en": "“Listen to me if you wish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:4.1"], "en": "“You who eat corpses and drink blood,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:4.2"], "en": "you thief, you chicken-slayer!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:4.3", "PA_ja_383:4.4"], "en": "\"You do not desire me as your husband with the feeling of a noble one.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:5.1"], "en": "\"Even so, O clever woman,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:5.2"], "en": "Having seen a man possessed of wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:5.3"], "en": "they lead him away with gentle words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:5.4"], "en": "like a female cat leading a cock.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:6.1", "PA_ja_383:6.2", "PA_ja_383:6.3"], "en": "But he who does not quickly comprehend a matter that has arisen falls under the power of his enemies.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:6.4"], "en": "And later he regrets it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:7.1", "PA_ja_383:7.2"], "en": "But he who quickly understands a matter that has arisen—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:7.3"], "en": "He is released from the oppression of his enemy,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:7.4"], "en": "like a cock from a cat.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_383:8.1"], "en": "Thus ends the Eighth Jātaka, the Kukkuṭa-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
