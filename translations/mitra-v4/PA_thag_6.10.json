[
{"segs": ["PA_thag_6.10:0.1", "PA_thag_6.10:0.2"], "en": "Theragāthā 6.10 Chakkanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:0.3"], "en": "First Chapter (Paṭhamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:0.4"], "en": "The Verse of the Elder Sumanatthera:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:1.1"], "en": "“When I was newly gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:1.2"], "en": "being seven years of age;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:1.3", "PA_thag_6.10:1.4"], "en": "Having overcome the lord of serpents, who possessed great psychic power, by means of his own psychic power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:2.1"], "en": "he offered water to his preceptor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:2.2"], "en": "“The great lake Anotatta;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:2.3"], "en": "having seen it, I brought [water] from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:2.4"], "en": "and the Teacher said this to me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:3.1", "PA_thag_6.10:3.2"], "en": "“Sāriputta, look at this young man coming along,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:3.3"], "en": "carrying a water-pot.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:3.4"], "en": "Well-composed within,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:4.1", "PA_thag_6.10:4.2"], "en": "with a pleasing mode of conduct and virtuous deportment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:4.3", "PA_thag_6.10:4.4"], "en": "Sāmaṇera Anuruddha was confident in his psychic power; like a well-bred steed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:5.1"], "en": "he was a thoroughbred.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:5.2"], "en": "He was made to act rightly by the virtuous one;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:5.3", "PA_thag_6.10:5.4"], "en": "he was disciplined by Anuruddha and instructed by him who had accomplished his task.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:6.1", "PA_thag_6.10:6.2"], "en": "Having thus attained supreme peace and realized the unshakable state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:6.3"], "en": "that novice Saṃpanna was joyful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:6.4"], "en": "“May no one know me,” he desires.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.10:6.5"], "en": "… Thus spoke the Elder Sumana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
