[
{"segs": ["PA_ja_254:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_254:0.2", "PA_ja_254:0.3"], "en": "The Section of Threes, Chapter on Intention (Saṅkappavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_254:0.4"], "en": "4. The Kuṇḍakakucchisindhava Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_254:1.1", "PA_ja_254:1.2"], "en": "“Having eaten a fodder of grass, having eaten rice-scum and broken grains;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_254:1.3"], "en": "“This was your food;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_254:1.4"], "en": "why do you not eat it now?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_254:2.1"], "en": "“Where they do not know a person...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_254:2.2"], "en": "Whether by birth or by discipline—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_254:2.3"], "en": "O Great Brahmā, even there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_254:2.4"], "en": "a mere bowl of rice-scum is of great value.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_254:3.1"], "en": "And you indeed know me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_254:3.2", "PA_ja_254:3.3"], "en": "as this supreme steed is; knowing, and having recourse to that knowledge, [you have spoken].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_254:3.4"], "en": "\"I will not eat you, Kuṇḍaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_254:4.1"], "en": "This concludes the fourth Jātaka, the Kuṇḍaka-kucchi-sindhava-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
