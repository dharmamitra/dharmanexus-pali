[
{"segs": ["PA_ja_313:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:0.2", "PA_ja_313:0.3"], "en": "Catukkanipāta, Pucimandavagga (The Chapter on the Nimba Tree)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:0.4"], "en": "3. The Khantīvādī Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:1.1", "PA_ja_313:1.2"], "en": "“He who cut off your hands and feet, and your ears and nose;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:1.3"], "en": "\"Be angry with him, O Great Hero;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:1.4"], "en": "do not let this kingdom perish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:2.1"], "en": "\"He who [offended] me in hand and foot...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:2.2"], "en": "He had his ears and nose cut off;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:2.3"], "en": "may that king live long,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:2.4"], "en": "for those like me do not give way to anger.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:3.1", "PA_ja_313:3.2"], "en": "In the past, there was a recluse who illuminated patience;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:3.3"], "en": "he remained steadfast in patience alone.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:3.4", "PA_ja_313:4.1"], "en": "The King of Kāśī caused it to be cut down. For that harsh deed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:4.2"], "en": "the ripening was bitter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:4.3"], "en": "\"What the King of Kāsi experienced,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:4.4"], "en": "being cast into hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_313:5.1"], "en": "Thus ends the third Jātaka, the Khantivādī Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
