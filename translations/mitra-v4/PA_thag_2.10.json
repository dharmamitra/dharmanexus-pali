[
{"segs": ["PA_thag_2.10:0.1", "PA_thag_2.10:0.2"], "en": "Theragāthā 2.10 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:0.4"], "en": "The Verses of the Elder Vasabha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:1.1"], "en": "“First he strikes himself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:1.2"], "en": "and afterwards he strikes others.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:1.3"], "en": "One who is ill-behaved destroys himself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:1.4"], "en": "like a bird caught in a net;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:2.1"], "en": "a brahmin is not one who is merely fair in outward appearance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:2.2"], "en": "For a brahmin is defined by his inner character;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:2.3", "PA_thag_2.10:2.4"], "en": "he in whom evil deeds reside is indeed black, O Sujampati.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:2.5", "PA_thag_2.10:2.6"], "en": "… The Elder Vasabha … This is the first chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:3.0"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:3.1"], "en": "Uttara and Piṇḍola,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:3.2"], "en": "Valliya and the seer Tīriya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:3.3"], "en": "Ajina and Meḷajina—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:3.4"], "en": "Rādha, Surādha, and Gotama—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:3.5"], "en": "these, together with Vasabha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.10:3.6"], "en": "are the ten elders of great psychic power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
