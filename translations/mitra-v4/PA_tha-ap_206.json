[
{"segs": ["PA_tha-ap_206:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:0.2"], "en": "The Section on the Kaṇikāra Flower, 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:0.3"], "en": "The Apadāna of the Elder Taraṇiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:1.1"], "en": "But the Blessed One Atthadassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:1.2"], "en": "the lord of bipeds, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:1.3"], "en": "was preceded by his disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:1.4"], "en": "He approached the bank of the Ganges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:2.1", "PA_tha-ap_206:2.2"], "en": "At that time, the Ganges was level with its banks and as shallow as a crow’s drink, yet it was difficult to cross.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:2.3"], "en": "I ferried across the community of monks and the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:2.4"], "en": "the supreme among bipeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:3.1"], "en": "In eighteen hundred aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:3.2"], "en": "Whatever deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:3.4"], "en": "this is the fruit of my crossing over.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:4.1"], "en": "In the one hundred and three aeons [following],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:4.2"], "en": "I was five times the possessor of all existences,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:4.3"], "en": "endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:4.4"], "en": "I was a wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:5.1"], "en": "And in this my final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:5.2"], "en": "I was born into a brahmin family.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:5.3"], "en": "Together with three companions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:5.4"], "en": "I went forth in the Teacher’s dispensation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:6.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:7.1"], "en": "Thus indeed did the venerable elder Taraṇiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_206:8.1"], "en": "The legend of the Elder Tāraṇiya is the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
