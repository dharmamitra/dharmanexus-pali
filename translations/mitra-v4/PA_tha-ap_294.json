[
{"segs": ["PA_tha-ap_294:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:0.2"], "en": "Chapter on Those Who Honored the Pyre (Citakapūjakavagga) 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:0.3"], "en": "The Apadāna of the Elder Pupphadhāraka (The Flower-Bearer)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:1.1", "PA_tha-ap_294:1.2"], "en": "I was one who wore garments of bark and was clothed in an upper robe of antelope skin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:1.3"], "en": "the five higher knowledges were realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:1.4"], "en": "A polisher of the moon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:2.1", "PA_tha-ap_294:2.2"], "en": "having seen Vipassī, the light of the world, approaching me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:2.3", "PA_tha-ap_294:2.4", "PA_tha-ap_294:3.1"], "en": "I carried pāricchattaka flowers for the Teacher in the ninety-first aeon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:3.2"], "en": "Because I offered that flower in worship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:3.4"], "en": "this is the fruit of my retention.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:4.1"], "en": "In the eighty-seventh aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:4.2", "PA_tha-ap_294:4.3"], "en": "there was one lord of the earth named Samantadhāraṇa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:4.4"], "en": "A wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:5.1", "PA_tha-ap_294:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:6.1"], "en": "In this way, indeed, the venerable elder Pupphadhāraka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_294:7.1"], "en": "This is the second legend (apadāna) of the elder Pupphadhāraka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
