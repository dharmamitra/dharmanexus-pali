[
{"segs": ["PA_ja_355:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:0.2"], "en": "The Fifth Collection,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:0.3"], "en": "Chapter on the Jeweled Earrings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:0.4"], "en": "5. The Ghaṭa Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:1.1"], "en": "“Others grieve and weep;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:1.2"], "en": "other people have tearful faces.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:1.3"], "en": "“Your facial complexion is serene;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:1.4"], "en": "why, Ghaṭa, do you not grieve?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:2.1"], "en": "“Grief does not take away what is past.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:2.2"], "en": "It brings happiness in the future;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:2.3"], "en": "therefore, O vulture, I do not grieve,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:2.4"], "en": "for there is no second who shares in one's grief.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:3.1"], "en": "Through grief he becomes pale and emaciated,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:3.2"], "en": "and food does not please him;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:3.3"], "en": "his enemies rejoice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:3.4"], "en": "For one pierced by an arrow and suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:4.1"], "en": "whether in a village or in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:4.2"], "en": "in a low place or on high ground;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:4.3"], "en": "While I stand firm, it shall not come;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:4.4"], "en": "thus have I seen the state.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:5.1"], "en": "He for whose sake even I alone am not enough—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:5.2", "PA_ja_355:5.3", "PA_ja_355:5.4"], "en": "Even the entire earth, though it should take away all the flavors of sensual pleasures, will not bring him happiness.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_355:6.1"], "en": "The Ghaṭajātakam, the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
