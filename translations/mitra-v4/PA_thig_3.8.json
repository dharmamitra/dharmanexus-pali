[
{"segs": ["PA_thig_3.8:0.1", "PA_thig_3.8:0.2", "PA_thig_3.8:0.3"], "en": "Therīgāthā 3.8 Tikanipāta Somā Therīgāthā", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.8:1.1", "PA_thig_3.8:1.2"], "en": "“That state which is to be attained by seers, so difficult to achieve—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.8:1.3"], "en": "that cannot be reached by one of two-finger’s-breadth wisdom.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.8:1.4"], "en": "“Can it be attained by a woman? [The Buddha replied:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.8:2.1", "PA_thig_3.8:2.2"], "en": "“What does being female matter when the mind is well-composed?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.8:2.3", "PA_thig_3.8:2.4"], "en": "While knowledge is present for one who correctly discerns the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.8:3.1"], "en": "delight is destroyed everywhere.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.8:3.2"], "en": "The mass of darkness has been shattered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.8:3.3"], "en": "know this, O Evil One:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.8:3.4"], "en": "you are defeated, O End-maker!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.8:4.1", "PA_thig_3.8:5.1"], "en": "… The Elder Nun Somā … The Third Chapter (Tikanipāta) is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"}
]
