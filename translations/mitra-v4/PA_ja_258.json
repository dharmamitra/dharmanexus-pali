[
{"segs": ["PA_ja_258:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_258:0.2", "PA_ja_258:0.3"], "en": "Tikanipāta, Saṅkappavagga (The Chapter on Intention)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_258:0.4"], "en": "8. The Māndhātṛ Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_258:1.1", "PA_ja_258:1.2"], "en": "“As far as the moon and sun revolve, illuminating and shining throughout the quarters;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_258:1.3"], "en": "All the slaves of Mandhātā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_258:1.4"], "en": "whatever living beings dwell upon the earth—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_258:2.1"], "en": "even with a rain of gold coins— could not satisfy him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_258:2.2"], "en": "Satiety is not found in sensual pleasures;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_258:2.3"], "en": "sensual pleasures are of little flavor and are suffering—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_258:2.4"], "en": "thus has the wise one understood.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_258:3.1"], "en": "Even toward divine sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_258:3.2", "PA_ja_258:3.3"], "en": "he finds no delight; he is one who delights in the destruction of craving.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_258:3.4"], "en": "“a disciple of the Perfectly Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_258:4.1"], "en": "Thus ends the eighth Jātaka, the Mandhātu Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
