[
{"segs": ["PA_ja_70:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_70:0.2", "PA_ja_70:0.3"], "en": "The First Book (Ekakanipāta), The Chapter on Women (Itthivagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_70:0.4"], "en": "10. The Kuddāla Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_70:1.1", "PA_ja_70:1.2"], "en": "“That victory is not well-won which, having been won, is lost again.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_70:1.3"], "en": "\"That which is conquered is well-conquered,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_70:1.4"], "en": "that which is conquered is not to be conquered again.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_70:2.1"], "en": "Thus ends the tenth Jātaka, the Kuddāla Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_70:2.2"], "en": "The Seventh Chapter on Women.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_70:3.1", "PA_ja_70:4.1"], "en": "Its summary verse: Sikhī, Sabbaghā, and Vīṇavara;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_70:4.2"], "en": "Slander, the sowing of dissension among friends, delight, the river,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_70:4.3"], "en": "the brother of Mudulakkhaṇa, the mind, poison,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_70:4.4"], "en": "and the one conquered by the virtuous— these are the ten.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
