[
{"segs": ["PA_tha-ap_169:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:0.2"], "en": "Supāricariya-vagga 7:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:0.3"], "en": "The Apadāna of the Elder Yūthikapupphiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:1.1"], "en": "“On the bank of the Candabhāgā River,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:1.2"], "en": "I was traveling downstream;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:1.3"], "en": "there I saw the Self-Existent One.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:1.4"], "en": "Like a blossoming king of sal trees,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:2.1", "PA_tha-ap_169:2.2"], "en": "I took a yūthika flower and approached the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:2.3"], "en": "With a serene mind and joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:2.4"], "en": "I offered it to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:3.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:3.2"], "en": "The flower that I offered—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:3.3"], "en": "of this I know no bad rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:3.4"], "en": "this is the fruit of worshiping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:4.1"], "en": "In the sixty-seventh aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:4.2"], "en": "I was once a sea-king,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:4.3"], "en": "endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:4.4"], "en": "A wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:5.1", "PA_tha-ap_169:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:6.1"], "en": "In this way, it is said, the venerable elder Yūthikapupphiya recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_169:7.1"], "en": "This is the seventh *apadāna* of the elder Yūthikapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
