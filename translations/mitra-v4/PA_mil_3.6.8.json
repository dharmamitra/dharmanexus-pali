[
{"segs": ["PA_mil_3.6.8:0.1", "PA_mil_3.6.8:0.2"], "en": "The Questions of King Milinda, Chapter on Mindfulness, 8.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.8:0.3"], "en": "The Question on the Foundation of Wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.8:1.1"], "en": "The King said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.8:1.2"], "en": "\"Venerable Nāgasena, where does wisdom dwell?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.8:1.3"], "en": "\"Nowhere at all, Great King,\" he replied.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.8:1.4"], "en": "“In that case, venerable Nāgasena, wisdom does not exist.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.8:1.5"], "en": "“Where, Great King, does the wind dwell?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.8:1.6"], "en": "“Nowhere at all, venerable sir.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.8:1.7"], "en": "“Therefore, Great King, there is no wind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.8:2.1"], "en": "“Excellent, Bhante Nāgasena!", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.8:3.1"], "en": "This was the eighth question: On the Foundation of Wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"}
]
