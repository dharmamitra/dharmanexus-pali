[
{"segs": ["PA_ja_163:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_163:0.2", "PA_ja_163:0.3"], "en": "Dukanipāta, Santhavavagga (The Chapter on Intimacy)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_163:0.4"], "en": "3. The Susīma Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_163:1.1"], "en": "“Black are these deer, white their teeth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_163:1.2"], "en": "more than a hundred of them are covered with nets of gold.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_163:1.3"], "en": "\"‘I give them to you,’ Susīma, you say,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_163:1.4"], "en": "remembering your ancestors and forefathers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_163:2.1"], "en": "‘These black deer with white teeth are mine.’\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_163:2.2"], "en": "“Hundreds of them, covered with nets of gold—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_163:2.3"], "en": "these I give to you, young man,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_163:2.4"], "en": "as I call to mind my fathers and grandfathers.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_163:3.1"], "en": "The Susīma Jātaka, the third.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
