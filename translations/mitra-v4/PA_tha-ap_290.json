[
{"segs": ["PA_tha-ap_290:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:0.2", "PA_tha-ap_290:0.3"], "en": "Paṇṇadāyakavagga 8. The Apadāna of the Elder Sattāhapabbajita (One Who Went Forth After Seven Days)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:1.1", "PA_tha-ap_290:1.2"], "en": "“The Saṅgha of the Blessed One Vipassī was honored and revered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:1.3"], "en": "yet calamity has come upon me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:1.4"], "en": "In the past there was a division among my kinsmen;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:2.1"], "en": "having gone forth into homelessness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:2.2"], "en": "I sought the pacification of misfortune.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:2.3", "PA_tha-ap_290:2.4"], "en": "Delighting there for seven days out of a desire for the Teacher’s instruction,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:3.1"], "en": "[he was reborn] ninety-one aeons ago.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:3.2"], "en": "When I went forth at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:3.3"], "en": "I have not known a miserable rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:3.4"], "en": "this is the fruit of going forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:4.1"], "en": "In the sixty-seventh aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:4.2", "PA_tha-ap_290:4.3"], "en": "there were seven lords of the earth known as the Sunikkhamas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:4.4"], "en": "Universal monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:5.1", "PA_tha-ap_290:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:6.1"], "en": "In this way, it is said, the Venerable Elder Sattāhapabbajita recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_290:7.1"], "en": "This is the eighth legend (Apadāna) of the Elder Sattāhapabbajita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
