[
{"segs": ["PA_thag_10.2:0.1", "PA_thag_10.2:0.2", "PA_thag_10.2:0.3"], "en": "Theragāthā 10.2 Paṭhamavagga (First Chapter) Dasakanipāta (The Ten-Verse Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:0.4"], "en": "The Verses of the Elder Ekavihāriya:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:1.1", "PA_thag_10.2:1.2"], "en": "“If neither before nor behind is there another to be found;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:1.3", "PA_thag_10.2:1.4"], "en": "It is exceedingly comfortable for one living alone in the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:2.1"], "en": "come, I shall go alone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:2.2"], "en": "The forest is praised by the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:2.3", "PA_thag_10.2:2.4"], "en": "it is a place of comfort for a bhikkhu who dwells alone and is resolute in self-exertion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:3.1"], "en": "Delightful and charming, frequented by elephants in rut—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:3.2"], "en": "a place that brings joy to yogis— there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:3.3"], "en": "alone and having mastery over himself, he quickly [attained].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:3.4"], "en": "I shall enter the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:4.1"], "en": "into the cool grove of Sītavana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:4.2"], "en": "into the cool mountain cleft.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:4.3"], "en": "Having bathed my limbs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:4.4"], "en": "I shall walk back and forth alone;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:5.1"], "en": "solitary and without a second.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:5.2"], "en": "In the delightful great forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:5.3"], "en": "when shall I dwell,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:5.4"], "en": "having done what was to be done and free from taints?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:6.1", "PA_thag_10.2:6.2"], "en": "May the intention of me, who desires to act thus, be fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:6.3"], "en": "I myself shall accomplish it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:6.4"], "en": "One person is not the maker of another.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:7.1", "PA_thag_10.2:7.2"], "en": "Thus I bind on my armor and shall enter the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:7.3", "PA_thag_10.2:7.4"], "en": "I shall not emerge from there until I have attained the destruction of the taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:8.1"], "en": "even while the wind blows.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:8.2"], "en": "O Sītā of fragrant scent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:8.3", "PA_thag_10.2:8.4"], "en": "seated upon the mountain peak, I shall shatter ignorance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:9.1", "PA_thag_10.2:9.2"], "en": "Surely in a cool mountain glen, covered with blossoming flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:9.3"], "en": "he dwells happy with the bliss of liberation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:9.4"], "en": "I shall delight in Giribbaja.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:10.1"], "en": "With my purpose fulfilled,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:10.2"], "en": "I am like the moon on the fifteenth day.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:10.3"], "en": "“All taints are utterly destroyed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:10.4"], "en": "there is now no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_10.2:10.5"], "en": "… The Elder Ekavihāriya …", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
