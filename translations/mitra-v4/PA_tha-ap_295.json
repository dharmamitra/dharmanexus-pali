[
{"segs": ["PA_tha-ap_295:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:0.2"], "en": "Chapter on the Worshipers of the Pile (Citakapūjakavagga) 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:0.3"], "en": "The Apadāna of the Elder Chattadāyaka (The Giver of the Parasol)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:1.1"], "en": "“My son has gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:1.2"], "en": "clad in saffron robes;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:1.3"], "en": "he has now attained Buddhahood.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:1.4"], "en": "The one extinguished, honored by the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:2.1"], "en": "was searching for his own son;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:2.2"], "en": "I followed behind him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:2.3"], "en": "When the Great One had attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:2.4"], "en": "I went to his funeral pyre; there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:3.1"], "en": "raising my hands in reverent salutation, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:3.2"], "en": "Having paid homage to the funeral pyre,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:3.3", "PA_tha-ap_295:3.4"], "en": "I then took up the white parasol and placed it upon it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:4.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:4.2"], "en": "because I offered this parasol,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:4.3"], "en": "I do not know any state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:4.4"], "en": "This is the fruit of the gift of a parasol.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:5.1"], "en": "In the twenty-fifth aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:5.2"], "en": "there were seven lords of men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:5.3"], "en": "They shall be named Mahāraha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:5.4"], "en": "wheel-turning monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:6.1"], "en": "The four analytical knowledges (paṭisambhidā),...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:6.3"], "en": "the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:7.1"], "en": "Thus indeed did the venerable elder Chattadāyaka recite these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_295:8.1"], "en": "The legend of the Elder Chattadāyaka is the third.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
