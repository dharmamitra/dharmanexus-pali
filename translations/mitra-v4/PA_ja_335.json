[
{"segs": ["PA_ja_335:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:0.2", "PA_ja_335:0.3"], "en": "Catukkanipāta, Kokilavagga (The Chapter on the Cuckoo)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:0.4"], "en": "5. The Jātaka of the Jackal:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:1.1", "PA_ja_335:1.2"], "en": "“Tall and large-bodied he was, O jackal with long fangs;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:1.3", "PA_ja_335:1.4"], "en": "\"You were not born into that family where they seize an elephant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:2.1"], "en": "\"Though I am no lion, with the pride of a lion,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:2.2"], "en": "He who transforms himself—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:2.3"], "en": "like a hyena attacking an elephant—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:2.4"], "en": "lies upon the ground groaning.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:3.1"], "en": "Of the illustrious Supreme Person,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:3.2"], "en": "who has produced the aggregates and possesses great power—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:3.3"], "en": "without considering his own strength, power, or rebirth—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:3.4"], "en": "This jackal lies here, slain by a serpent—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:4.1"], "en": "just so with him who here performs an action out of negligence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:4.2"], "en": "imagining within himself that he possesses strength and power.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:4.3"], "en": "\"By means of prayer, incantation, and well-spoken words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:4.4"], "en": "he who possesses discernment conquers extensively.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_335:5.1"], "en": "Thus ends the fifth Jātaka, the Jambuka-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
