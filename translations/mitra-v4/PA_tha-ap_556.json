[
{"segs": ["PA_tha-ap_556:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:0.2", "PA_tha-ap_556:0.3"], "en": "Chapter on Renown (Yasavagga), Number 4: The Apadāna of the Elder Kimila.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:1.1", "PA_tha-ap_556:1.2"], "en": "“When Kakusandha, the brahmin of cultivated mind, had attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:1.3"], "en": "[I] took a wreath of *salala* flowers and— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:1.4"], "en": "I had a pavilion constructed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:2.1"], "en": "Having gone to the Tāvatiṃsa heaven,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:2.2"], "en": "I obtained a supreme palace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:2.3"], "en": "I shine forth among other gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:2.4"], "en": "this is the fruit of meritorious deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:3.1"], "en": "whether by day or by night.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:3.2"], "en": "Whether walking or standing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:3.3"], "en": "I am covered by salala flowers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:3.4"], "en": "this is the fruit of meritorious karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:4.1"], "en": "In this very eon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:4.2"], "en": "because I worshipped the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:4.3"], "en": "I have not known a bad rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:4.4"], "en": "This is the fruit of my worship of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:5.1", "PA_tha-ap_556:5.2"], "en": "the defilements have been incinerated by me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:5.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:6.1", "PA_tha-ap_556:6.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:6.3"], "en": "Thus was the teaching of the Buddha spoken:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:7.1", "PA_tha-ap_556:7.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:7.3"], "en": "“Thus has been spoken the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:8.1"], "en": "In this way, it is said, the venerable elder Kimila spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_556:9.1"], "en": "This is the fourth legend of the elder Kimila.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
