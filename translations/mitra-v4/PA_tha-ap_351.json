[
{"segs": ["PA_tha-ap_351:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_351:0.2"], "en": "Ekapadumiya-vagga 9.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_351:0.3"], "en": "The Apadāna of the Elder Tindukaphaladāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_351:1.1", "PA_tha-ap_351:1.2", "PA_tha-ap_351:1.3"], "en": "I saw the stainless Buddha, shining like a kaṇikāra flower, seated amidst the mountains.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_351:1.4", "PA_tha-ap_351:2.1", "PA_tha-ap_351:2.2"], "en": "Having seen a *tinduka* tree with fruit, he broke it down along with its husk, [releasing] one whose mind has crossed over the flood and is free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_351:2.3"], "en": "With a clear mind and joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_351:2.4", "PA_tha-ap_351:3.1"], "en": "I offered a madā flower to the Self-Existent One ninety-one aeons ago.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_351:3.2"], "en": "Whatever fruit I gave back then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_351:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_351:3.4"], "en": "this is the fruit of giving fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_351:4.1", "PA_tha-ap_351:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_351:4.3"], "en": "[and so forth] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_351:5.1"], "en": "Thus indeed the venerable elder Tindukaphaladāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_351:6.1"], "en": "This is the ninth legend of the elder Tindukaphaladāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
