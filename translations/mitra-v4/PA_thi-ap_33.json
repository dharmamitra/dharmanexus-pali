[
{"segs": ["PA_thi-ap_33:0.1", "PA_thi-ap_33:0.2"], "en": "The Therī-apadāna, Chapter on the Kṣatriyas, No. 3:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:0.3"], "en": "The Apadāna of the Elder Nun Uppaladāyikā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:1.1"], "en": "“In the city of Aruṇavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:1.2"], "en": "there was a kshatriya named Aruṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:1.3"], "en": "I was the wife of that king.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:1.4"], "en": "I distributed [the food] all at once.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:2.1"], "en": "Having gone into seclusion and sat down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:2.2"], "en": "I then reflected thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:2.3"], "en": "‘I have done no wholesome deed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:2.4"], "en": "I am departing with nothing but my burden.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:3.1"], "en": "Great is the torment, bitter indeed.’", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:3.2"], "en": "Of terrible form and most dreadful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:3.3"], "en": "surely I shall go to hell—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:3.4"], "en": "of this there is no doubt for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:4.1", "PA_thi-ap_33:4.2"], "en": "Having thus reflected and gladdened my mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:4.3"], "en": "I approached the king.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:4.4"], "en": "I spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:5.1"], "en": "“O Lord, we are indeed women,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:5.2"], "en": "though we have been husbands to men.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:5.3"], "en": "\"O Kṣatriya, give me one ascetic;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:5.4", "PA_thi-ap_33:6.1"], "en": "I shall feed him. Then the king gave him to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:6.2"], "en": "To that ascetic whose faculties were cultivated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:6.3", "PA_thi-ap_33:6.4"], "en": "I took his bowl and filled it with excellent rice.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:7.1"], "en": "Having filled it with supreme food,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:7.2"], "en": "together with fragrant ointments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:7.3"], "en": "and having covered it with a great cloth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:7.4"], "en": "I gave with a joyful mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:8.1", "PA_thi-ap_33:8.2"], "en": "By that well-performed deed and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:8.3"], "en": "Having abandoned my human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:8.4"], "en": "I went to the realm of the Thirty-three,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:9.1"], "en": "where there are thousands of kings of gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:9.2"], "en": "I exercised the sovereignty of a Great Queen;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:9.3", "PA_thi-ap_33:9.4"], "en": "I exercised the sovereignty of a thousand Wheel-turning Monarchs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:10.1"], "en": "A vast regional sovereignty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:10.2"], "en": "incalculable in number,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:10.3"], "en": "and many other various kinds of wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:10.4"], "en": "From that, the fruit of his karma arose:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:11.1"], "en": "my complexion is like that of a blue lotus;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:11.2"], "en": "I am beautiful and lovely to behold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:11.3"], "en": "Endowed with all these limbs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:11.4"], "en": "noble-born and radiant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:12.1"], "en": "when her final existence was reached—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:12.2"], "en": "I was born into the Śākya clan;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:12.3", "PA_thi-ap_33:12.4"], "en": "I was the leader of a thousand women for the son of Suddhodana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:13.1"], "en": "Having become disenchanted with the household life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:13.2"], "en": "I went forth into homelessness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:13.3"], "en": "seven nights have now passed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:13.4"], "en": "I attained the Four Noble Truths.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:14.1"], "en": "Robes, almsfood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:14.2"], "en": "requisites, and lodgings—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:14.3", "PA_thi-ap_33:14.4"], "en": "I am unable to measure this fruit of almsfood;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:15.1"], "en": "it is the result of the karma I have fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:15.2"], "en": "O Sage, you know what is wholesome;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:15.3", "PA_thi-ap_33:15.4"], "en": "O Great Hero, for your sake much has been sacrificed by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:16.1"], "en": "In the thirty-first aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:16.2"], "en": "because of the gift I gave at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:16.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:16.4"], "en": "This is the fruit of almsfood:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:17.1"], "en": "I know two destinations—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:17.2"], "en": "divinity and the human state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:17.3"], "en": "I know no other destiny;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:17.4"], "en": "this is the fruit of almsfood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:18.1"], "en": "I am reborn into a noble family.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:18.2"], "en": "In a family of great halls and vast wealth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:18.3"], "en": "I know no other family—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:18.4"], "en": "this is the fruit of almsfood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:19.1"], "en": "Having wandered through various states of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:19.2"], "en": "impelled by the root of my wholesome merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:19.3"], "en": "I do not see anything unpleasant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:19.4"], "en": "The fruit of that joy is this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:20.1", "PA_thi-ap_33:20.2"], "en": "I have mastery over the supernormal powers and possess the divine ear-element.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:20.3", "PA_thi-ap_33:20.4"], "en": "O Great Sage, I have mastery over the knowledge of the minds of others;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:21.1"], "en": "I know my own past lives.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:21.2"], "en": "The divine eye has been purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:21.3"], "en": "all taints are completely exhausted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:21.4"], "en": "there is now no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:22.1", "PA_thi-ap_33:22.2", "PA_thi-ap_33:22.3"], "en": "O Great Hero, my knowledge regarding the meanings, the phenomena, the linguistic expressions, and likewise regarding inspired eloquence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:22.4"], "en": "Has arisen in your presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:23.1"], "en": "The defilements have been incinerated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:23.2"], "en": "…pe…", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:23.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:24.1", "PA_thi-ap_33:24.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:24.3"], "en": "The Buddha’s teaching has been proclaimed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:25.1", "PA_thi-ap_33:25.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:25.3"], "en": "“Thus was the Buddha’s teaching proclaimed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:26.1"], "en": "In this way, it is said, the bhikkhunī Uppaladāyikā recited these verses in the presence of the Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_33:27.1"], "en": "This is the third legend of the Elder Nun Uppaladāyikā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
