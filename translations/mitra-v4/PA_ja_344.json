[
{"segs": ["PA_ja_344:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:0.2"], "en": "The Collection of Fours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:0.3"], "en": "Chapter on Cūḷakuṇāla.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:0.4"], "en": "4. The Amba Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:1.1", "PA_ja_344:1.2"], "en": "“He who adorns himself with indigo is tormented by the tongs.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:1.3", "PA_ja_344:1.4"], "en": "May she who carried away your mother come under his control.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:2.1"], "en": "Twenty or twenty-five—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:2.2"], "en": "In thirty-nine births,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:2.3", "PA_ja_344:2.4"], "en": "may you never obtain such a husband as he who carried off your mother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:3.1", "PA_ja_344:3.2"], "en": "“May you travel a long distance alone as a woman going to meet her lover;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:3.3"], "en": "do not trust your husband at the rendezvous.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:3.4", "PA_ja_344:4.1"], "en": "“O mother, she whom you brought here is adorned with fine garments,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:4.2"], "en": "wearing garlands and anointed with sandalwood paste.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:4.3"], "en": "“Alone she lies upon her bed—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:4.4"], "en": "she whom you carried away from her mother,” [said the king].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_344:5.1"], "en": "Thus ends the fourth Jātaka, the Amba-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
