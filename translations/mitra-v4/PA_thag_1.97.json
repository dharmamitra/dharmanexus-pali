{"segs": ["PA_thag_1.97:0.4", "PA_thag_1.97:1.1"], "en": "Tissattheragāthā “Having abandoned the bronze vessel weighing a hundred palas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.97:1.2"], "en": "And the golden one with a hundred stripes;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.97:1.3"], "en": "“I took up a clay bowl;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.97:1.4"], "en": "this was my second consecration.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.97:1.5"], "en": "… Thus spoke the Elder Tissa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
