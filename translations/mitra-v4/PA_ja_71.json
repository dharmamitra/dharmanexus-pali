{"segs": ["PA_ja_71:0.3"], "en": "Varuṇavagga", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_71:0.4"], "en": "1. The Varuṇa Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_71:1.1", "PA_ja_71:1.2"], "en": "“He who wishes to do later what ought to be done earlier;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
