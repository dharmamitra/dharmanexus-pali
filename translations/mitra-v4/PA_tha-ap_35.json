[
{"segs": ["PA_tha-ap_35:0.1", "PA_tha-ap_35:0.2", "PA_tha-ap_35:0.3"], "en": "The Legend of the Elder Mahākaccāna From the Kuṇḍadhāna Chapter of the Therāpadāna, Number Three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:1.1"], "en": "“For the Lord Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:1.2", "PA_tha-ap_35:1.3"], "en": "having had a stone seat constructed for the cetiya named Paduma, [I offered it].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:1.4"], "en": "I anointed it with gold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:2.1", "PA_tha-ap_35:2.2"], "en": "Taking up a parasol made of jewels and a yak-tail fan, I stood there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:2.3"], "en": "I offered it to the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:2.4"], "en": "the kinsman of the world, the Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:3.1"], "en": "As many as there are deities dwelling on earth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:3.2"], "en": "Then, let everyone assemble;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:3.3", "PA_tha-ap_35:3.4"], "en": "he will describe the karmic result of the parasols made of jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:4.1", "PA_tha-ap_35:4.2"], "en": "And we shall hear all of that as the Teacher speaks;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:4.3"], "en": "we shall produce even greater joy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:4.4"], "en": "In the teaching of the Perfectly Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:5.1", "PA_tha-ap_35:5.2"], "en": "the Self-Existent One, the Supreme Person, sat upon a golden throne.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:5.3"], "en": "Surrounded by the community of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:5.4"], "en": "he spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:6.1"], "en": "“By whom this seat was given, [he has performed a great deed].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:6.2"], "en": "It was made of gold and precious gems;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:6.3"], "en": "I shall describe it to you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:6.4"], "en": "so listen as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:7.1", "PA_tha-ap_35:7.2", "PA_tha-ap_35:7.3"], "en": "For thirty eons, the lord of gods will exercise divine sovereignty over a realm extending a hundred yojanas in every direction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:7.4"], "en": "He will overcome [all] with his radiance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:8.1"], "en": "Having come to the world of humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:8.2"], "en": "he will become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:8.3"], "en": "Known by the name Pabhassara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:8.4"], "en": "he will possess intense radiance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:9.1"], "en": "whether by day or by night.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:9.2"], "en": "Like the sun risen with its four rays,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:9.3", "PA_tha-ap_35:9.4"], "en": "this Kṣatriya will illuminate the area for eighteen cubits on all sides.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:10.1"], "en": "In a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:10.2"], "en": "one born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:10.3"], "en": "known by the name Gotama by lineage, will appear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:10.4"], "en": "The Teacher shall appear in the world. For,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:11.1"], "en": "having passed away from the Tusita heaven,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:11.2"], "en": "impelled by the root of his white merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:11.3", "PA_tha-ap_35:11.4"], "en": "One named Kaccāna by name will become a mere kinsman of Brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:12.1"], "en": "later, having gone forth into homelessness, he—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:12.2"], "en": "He will become an arahant, free from taints;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:12.3"], "en": "Gotama, the lamp of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:12.4"], "en": "will establish him in the highest place.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:13.1", "PA_tha-ap_35:13.2"], "en": "He will explain in detail a question asked in brief;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:13.3"], "en": "and while explaining that question, he will...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:13.4"], "en": "He will fulfill his aspiration.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:14.1"], "en": "Born into a wealthy family,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:14.2"], "en": "he is a brahmin who has mastered the mantras.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:14.3"], "en": "Having abandoned wealth and grain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:14.4"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:15.1"], "en": "Even when asked in brief, I replied:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:15.2"], "en": "How could I possibly describe it in detail?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:15.3", "PA_tha-ap_35:15.4"], "en": "I fulfill their aspirations and satisfy the Supreme among Bipeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:16.1"], "en": "The Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:16.2"], "en": "the Self-Existent One, the Supreme Person,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:16.3"], "en": "was pleased with me as he sat within the community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:16.4"], "en": "He placed me in this foremost position:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:17.1", "PA_tha-ap_35:17.2"], "en": "\"The four analytical knowledges... [and so forth].\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:17.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:18.1"], "en": "In this way, it is said, the elder Venerable Mahākaccāna recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_35:19.1"], "en": "This is the third *apadāna* of the elder Mahākaccāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
