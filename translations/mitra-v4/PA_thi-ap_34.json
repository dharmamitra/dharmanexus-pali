[
{"segs": ["PA_thi-ap_34:0.1"], "en": "Therīapadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:0.2"], "en": "Khattiyāvagga 4:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:0.3"], "en": "The Apadāna of the Elder Nun Siṅgālamātā", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:1.2"], "en": "who has gone beyond all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:1.3"], "en": "[lived] one hundred thousand aeons ago from here.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:1.4"], "en": "The Leader appeared in that eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:2.1"], "en": "At that time, I was born in Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:2.2"], "en": "in a family of ministers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:2.3", "PA_thi-ap_34:2.4", "PA_thi-ap_34:3.1"], "en": "Having gone together with my father to that place, which was radiant with various jewels, prosperous, flourishing, and possessed of great wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:3.2"], "en": "Honored by the great multitude,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:3.3"], "en": "having heard the Dhamma of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:3.4"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:4.1", "PA_thi-ap_34:4.2"], "en": "Having gone forth, I avoided evil deeds with the body;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:4.3"], "en": "having abandoned verbal misconduct, I refrained from it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:4.4"], "en": "I purified my livelihood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:5.1", "PA_thi-ap_34:5.2"], "en": "With confidence in the Buddha and with intense reverence for the Dhamma and the Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:5.3"], "en": "Devoted to hearing the true Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:5.4"], "en": "longing for the sight of the Buddha—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:6.1"], "en": "these are the foremost among those resolved in faith.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:6.2"], "en": "I heard of a bhikkhunī at that time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:6.3"], "en": "aspiring for her state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:6.4"], "en": "I fulfilled the three trainings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:7.1", "PA_thi-ap_34:7.2"], "en": "Then the Sugata, whose heart was moved by compassion, said to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:7.3"], "en": "\"He who has faith in the Tathāgata...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:7.4"], "en": "It is immovable and well-established:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:7.5"], "en": "the virtue of one who is noble,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:7.6"], "en": "beloved by the Ariyas, and praised.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:8.1", "PA_thi-ap_34:8.2"], "en": "He who has faith in the Saṅgha and whose vision is upright—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:8.3"], "en": "him they call \"not poor.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:8.4"], "en": "His life is not in vain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:9.1"], "en": "Therefore, faith and virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:9.2"], "en": "serenity and the vision of the Dhamma—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:9.3"], "en": "\"The wise one should apply himself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:9.4"], "en": "remembering the teaching of the Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:10.1"], "en": "Hearing this, I was overjoyed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:10.2"], "en": "I asked for my aspiration;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:10.3"], "en": "then the peerless,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:10.4"], "en": "immeasurable Leader gave me his prediction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:10.5"], "en": "“O virtuous one, you have faith in the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:10.6"], "en": "you shall obtain that well-established [fruit].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:11.1"], "en": "In a hundred thousand aeons,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:11.2"], "en": "Born in the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:11.3", "PA_thi-ap_34:11.4"], "en": "he will be a teacher in the world named Gotama by lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:12.1"], "en": "She is his heir to the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:12.2"], "en": "his own child born of the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:12.3"], "en": "she is the mother of Siṅgālaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:12.4"], "en": "‘She will become a female disciple of the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:13.1"], "en": "Having heard this, she was filled with joy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:13.2"], "en": "and for as long as she lived, she [served] the Conqueror.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:13.3"], "en": "With a mind of loving-kindness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:13.4"], "en": "I served the Leader through my practices.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:14.1"], "en": "By that well-performed deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:14.2"], "en": "And through my volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:14.3"], "en": "having abandoned my human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:14.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:15.1"], "en": "And now, in this final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:15.2", "PA_thi-ap_34:15.3"], "en": "born into a prosperous merchant family in Giribbaja, the most excellent of cities.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:15.4"], "en": "In this accumulation of great jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:16.1"], "en": "you were my son named Siṅgālaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:16.2"], "en": "who delighted in the wrong path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:16.3"], "en": "Falling into the thicket of views,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:16.4"], "en": "intent on worshipping the directions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:17.1"], "en": "he paid homage to various quarters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:17.2", "PA_thi-ap_34:17.3"], "en": "The Buddha, the Guide, having seen him as he was entering the city for alms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:17.4"], "en": "stood upon the path and exhorted him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:18.1"], "en": "As he was teaching the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:18.2", "PA_thi-ap_34:18.3"], "en": "a wonderful sound arose from twenty million men and women.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:18.4"], "en": "There was a realization of the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:19.1", "PA_thi-ap_34:19.2"], "en": "Then, having gone to the assembly and heard what was spoken by the Sugata, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:19.3"], "en": "Having attained the fruit of stream-entry,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:19.4"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:20.1"], "en": "In no long time at all,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:20.2"], "en": "Longing for a vision of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:20.3", "PA_thi-ap_34:20.4"], "en": "I developed that recollection and attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:21.1", "PA_thi-ap_34:21.2", "PA_thi-ap_34:21.3"], "en": "I always go to see the Buddha, yet I behold him as if never satiated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:21.4"], "en": "His form is a delight to the eyes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:22.1", "PA_thi-ap_34:22.2"], "en": "the supreme abode of glory, produced by the perfection of all the pāramīs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:22.3"], "en": "Form is entirely mixed with impurity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:22.4"], "en": "yet I dwell unsatisfied;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:23.1"], "en": "the Victor was pleased by that quality.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:23.2"], "en": "He placed me in this foremost position:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:23.3"], "en": "\"Among the mothers of Siṅgālaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:23.4"], "en": "she is the foremost in being devoted to faith.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:24.1"], "en": "I am a master of the supernormal powers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:24.2"], "en": "of the divine ear-element,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:24.3"], "en": "and of the knowledge of others' minds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:24.4"], "en": "I am a master, a great sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:25.1"], "en": "I know my former births,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:25.2"], "en": "and my divine eye is purified.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:25.3"], "en": "All taints are utterly destroyed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:25.4"], "en": "there is now no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:26.1"], "en": "Regarding the meanings, the phenomena, and the linguistic expressions—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:26.2"], "en": "And likewise in inspired eloquence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:26.3", "PA_thi-ap_34:26.4"], "en": "O Great Hero, knowledge has arisen in me in your presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:27.1"], "en": "The defilements have been incinerated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:27.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:27.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:28.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:28.2", "PA_thi-ap_34:28.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:29.1", "PA_thi-ap_34:29.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:29.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:30.1"], "en": "Thus indeed did the bhikkhunī Siṅgālamātā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_34:31.1"], "en": "This is the fourth legend of the elder nun Siṅgālamātā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
