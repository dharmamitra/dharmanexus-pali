[
{"segs": ["PA_tha-ap_274:0.1", "PA_tha-ap_274:0.2", "PA_tha-ap_274:0.3"], "en": "The Apadāna of the Elder Tilamuṭṭhidāyaka, from the Suvaṇṇabibbohana Chapter of the Therāpadāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:1.1"], "en": "“Knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:1.2"], "en": "the Teacher, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:1.3"], "en": "[appeared] with a mind-made body.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:1.4"], "en": "He approached by means of psychic power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:2.1"], "en": "Having approached the Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:2.2"], "en": "he paid homage to the Supreme among Men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:2.3"], "en": "With a clear mind and joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:2.4"], "en": "I gave three handfuls of sesame seeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:3.1"], "en": "Ninety-one aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:3.2"], "en": "Because I gave that gift at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:3.4"], "en": "this is the fruit of that handful of sesame seeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:4.1"], "en": "In this sixteenth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:4.2"], "en": "there was a kshatriya named Tanti,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:4.3"], "en": "endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:4.4"], "en": "A wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:5.1", "PA_tha-ap_274:5.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:5.3"], "en": "\"Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:6.1"], "en": "Thus indeed did the venerable Elder Tilamuṭṭhidāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_274:7.1"], "en": "This is the second legend of the Elder Tilamuṭṭhidāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
