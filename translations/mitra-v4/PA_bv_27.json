[
{"segs": ["PA_bv_27:0.1", "PA_bv_27:0.2"], "en": "Buddhavamsa 27. Gotama-buddhavamsa:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:1.1"], "en": "\"I am now the Fully Enlightened One.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:1.2"], "en": "Gotama, the scion of the Sakyas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:1.3"], "en": "having exerted himself in striving,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:1.4"], "en": "attained supreme enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:2.1"], "en": "Being entreated by Brahmā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:2.2", "PA_bv_27:2.3"], "en": "I, being compassionate, set in motion the Wheel of Dhamma for eighteen koṭis.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:2.4"], "en": "The first realization occurred.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:3.1", "PA_bv_27:3.2"], "en": "Thereafter, as he was teaching in the assembly of men and gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:3.3"], "en": "He cannot be reckoned by calculation;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:3.4"], "en": "there was a second realization.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:4.1"], "en": "Even here, even now, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:4.2"], "en": "I exhorted my own son;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:4.3"], "en": "it cannot be expressed by calculation—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:4.4"], "en": "there was the third realization.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:5.1"], "en": "There was one assembly of mine,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:5.2"], "en": "of great seers who were my disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:5.3"], "en": "numbering twelve hundred and fifty.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:5.4"], "en": "There was a gathering of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:6.1"], "en": "Radiant and stainless,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:6.2"], "en": "he stood in the midst of the community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:6.3"], "en": "I grant everything desired,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:6.4"], "en": "like a wish-fulfilling gem that grants all wishes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:7.1"], "en": "for those who long for its fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:7.2"], "en": "To those seeking the abandonment of desire for existence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:7.3", "PA_bv_27:7.4"], "en": "I proclaim the Four Noble Truths out of compassion for living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:8.1", "PA_bv_27:8.2"], "en": "There was the realization of the Dhamma for twenty thousand;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:8.3"], "en": "there was the realization of one or two.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:8.4"], "en": "In number, it is incalculable.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:9.1", "PA_bv_27:9.2"], "en": "It is widespread, well-known, prosperous, flourishing, and fully blossomed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:9.3", "PA_bv_27:9.4"], "en": "Here, the teaching of the Sakyan Sage has been thoroughly purified by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:10.1"], "en": "We are free from taints and devoid of passion.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:10.2"], "en": "With peaceful minds and concentrated,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:10.3", "PA_bv_27:10.4"], "en": "all one hundred bhikkhus constantly surround me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:11.1", "PA_bv_27:11.2"], "en": "Now, those who at this present time abandon human existence—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:11.3"], "en": "those trainees whose minds have not yet attained their goal—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:11.4"], "en": "Those monks were censured by the wise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:12.1", "PA_bv_27:12.2"], "en": "But those people who always delight in the Dhamma praise the Noble Ones.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:12.3", "PA_bv_27:12.4"], "en": "The mindful ones, having entered the river of saṃsāra, will awaken;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:13.1"], "en": "my city is Kapilavatthu.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:13.2"], "en": "King Suddhodana is my father;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:13.3"], "en": "she who gave me birth is my mother,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:13.4"], "en": "known as Queen Māyā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:14.1", "PA_bv_27:14.2"], "en": "For nineteen years I dwelt in the household life; it was delightful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:14.3"], "en": "very pleasant, and beautiful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:14.4"], "en": "There were three supreme palaces.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:15.1", "PA_bv_27:15.2"], "en": "Forty thousand women were beautifully adorned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:15.3"], "en": "The woman named Bhaddakañcanā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:15.4"], "en": "and the son named Rāhula;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:16.1"], "en": "having seen four omens, [he departed].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:16.2"], "en": "I went forth by means of the noble vehicle;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:16.3"], "en": "for six years I practiced the course of striving,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:16.4"], "en": "performing what is difficult to do.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:17.1"], "en": "At Isipatana in Bārāṇasī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:17.2"], "en": "the Wheel was set in motion by me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:17.3"], "en": "I am the Sambuddha Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:17.4"], "en": "A refuge for all living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:18.1"], "en": "Kolita and Upatissa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:18.2"], "en": "these two bhikkhus, the foremost disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:18.3"], "en": "Ānanda is my attendant,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:18.4"], "en": "one who dwells in my presence;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:18.5"], "en": "so too are Khemā and Uppalavaṇṇā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:18.6"], "en": "The nun was the foremost female disciple;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:19.1", "PA_bv_27:19.2"], "en": "Citta of Hatthāḷavaka and [his wife] were the foremost male lay supporters.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:19.3", "PA_bv_27:19.4"], "en": "And Nandamātā Uttarā was the foremost female lay follower in service.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:20.1"], "en": "I [sat] at the foot of the Assattha tree.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:20.2"], "en": "I attained supreme enlightenment;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:20.3", "PA_bv_27:20.4"], "en": "my radiance, like that of a sunbeam, is always sixteen cubits high.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:21.1", "PA_bv_27:21.2"], "en": "A lifespan of only a hundred years exists at this present time;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:21.3"], "en": "remaining for that long, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:21.4"], "en": "I shall deliver the vast multitude of people,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:22.1", "PA_bv_27:22.2"], "en": "having established the pinnacle of the Dhamma as the final awakening for humanity.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:22.3", "PA_bv_27:22.4"], "en": "Before long, together with my assembly of disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:22.5"], "en": "I too shall attain final nibbāna right here.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:22.6", "PA_bv_27:23.1"], "en": "The fire is extinguished by the exhaustion of its fuel; those [fires] possessed incomparable brilliance,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:23.2"], "en": "and these are the ten powers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:23.3", "PA_bv_27:23.4"], "en": "And this body, which upholds virtues and is adorned with the thirty-two excellent marks,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:24.1"], "en": "having illuminated the ten directions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:24.2"], "en": "Like the sixfold radiance of the sun,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:24.3"], "en": "all that shall disappear;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:24.4"], "en": "are not all conditioned phenomena indeed empty?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_27:25.1"], "en": "The twenty-fifth chapter is the lineage of the Blessed One Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
