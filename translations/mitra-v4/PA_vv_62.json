[
{"segs": ["PA_vv_62:0.1", "PA_vv_62:0.2"], "en": "Vimānavatthu: The Mansion of the Man,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:0.3"], "en": "Chapter on the Great Chariot (Mahārathavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:0.4"], "en": "12. The Third Nāga-Vimāna Story:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:1.1", "PA_vv_62:1.2"], "en": "“Who indeed, with a divine vehicle, with an entirely white elephant;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:1.3", "PA_vv_62:1.4"], "en": "The sound of the cymbals being struck is honored in the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:2.1"], "en": "Are you a deity, or perhaps a gandhabba?", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:2.2"], "en": "\"Is it Sakka, the Giver of Cities?", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:2.3"], "en": "Not knowing this, we ask you:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:2.4"], "en": "how may we come to know you?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:3.1"], "en": "“There is no god there, nor a gandhabba,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:3.2"], "en": "nor even Sakka Purindada;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:3.3"], "en": "those gods who are called Sudhammā— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:3.4"], "en": "\"I am one of them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:4.1"], "en": "\"We ask the god of good Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:4.2"], "en": "having joined our palms together in reverence.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:4.3", "PA_vv_62:4.4"], "en": "“By doing what kind of human deed does one arise in Sudhammā?", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:5.1"], "en": "“A house of sugarcane, a house of grass...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:5.2"], "en": "And whoever should give a clothing-chamber;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:5.3"], "en": "having given one of these three,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:5.4"], "en": "one is reborn in Sudhammā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_62:6.1"], "en": "The thirteenth Nāga-vimāna, the twelfth [chapter].", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"}
]
