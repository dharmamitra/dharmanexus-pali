[
{"segs": ["PA_mil_3.1.6:0.1"], "en": "The Questions of King Milinda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.1.6:0.2"], "en": "Great Chapter 6:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.1.6:0.3"], "en": "The Question on Rebirth-linking (Paṭisandhi)", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.1.6:1.1"], "en": "The King said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.1.6:1.2"], "en": "\"Venerable Nāgasena, is there anyone who, having died, does not undergo rebirth?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.1.6:1.3"], "en": "The Elder replied:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.1.6:1.4"], "en": "“Does anyone undergo rebirth, or does anyone not undergo rebirth?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.1.6:1.5"], "en": "“Who undergoes rebirth, and who does not undergo rebirth?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.1.6:1.6"], "en": "“One who possesses defilements, Great King, undergoes rebirth; one who is free from defilements does not undergo rebirth.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.1.6:1.7"], "en": "“But will you yourself, venerable Nāgasena, undergo rebirth?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.1.6:1.8"], "en": "“If, Great King, I am possessed of clinging, I shall undergo rebirth; if I am without clinging, I shall not undergo rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.1.6:2.1"], "en": "“You are skillful, venerable Nāgasena.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.1.6:3.1"], "en": "The Sixth Question on Rebirth-linking.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"}
]
