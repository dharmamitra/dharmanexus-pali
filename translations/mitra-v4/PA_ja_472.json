[
{"segs": ["PA_ja_472:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:0.2"], "en": "The Twelfth Chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:0.3"], "en": "The Section on Cūḷakuṇāla", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:0.4"], "en": "9. The Mahāpaduma Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:1.1", "PA_ja_472:1.2"], "en": "“One should not perceive any fault in others, whether small or great, in any way whatsoever.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:1.3", "PA_ja_472:1.4"], "en": "The lord inflicts punishment without having personally investigated; and he who,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:2.1"], "en": "without having investigated, [inflicts it].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:2.2"], "en": "The Kṣatriya inflicts punishment;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:2.3", "PA_ja_472:2.4"], "en": "he swallows a thorn like one born blind swallowing a fly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:3.1", "PA_ja_472:3.2"], "en": "He punishes the innocent and punishes the guilty;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:3.3"], "en": "like a blind man on an uneven path, he stumbles.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:3.4"], "en": "He does not know what is equal or unequal.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:4.1"], "en": "But he who [knows] all these points,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:4.2"], "en": "both subtle and gross, in their entirety—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:4.3"], "en": "One who has seen clearly should provide instruction;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:4.4"], "en": "such a person indeed deserves to engage in discourse.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:5.1"], "en": "It is not possible [to guide] by means of one-sided softness alone.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:5.2"], "en": "Or with that which is exclusively sharp;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:5.3"], "en": "in order to establish oneself in greatness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:5.4"], "en": "one should therefore practice both.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:6.1"], "en": "One who is despised becomes mild,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:6.2"], "en": "while one who is excessively harsh incurs enmity;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:6.3"], "en": "having understood both of these, [one should act accordingly].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:6.4"], "en": "One should act with reflection.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:7.1"], "en": "Even one who is impassioned speaks much,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:7.2"], "en": "and even one who is malicious speaks much.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:7.3", "PA_ja_472:7.4"], "en": "“O King, you ought not to have your son killed for the sake of a woman.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:8.1"], "en": "“The entire world is united as one;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:8.2"], "en": "\"And this woman is all alone;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:8.3"], "en": "therefore, I shall deal with her.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:8.4"], "en": "Go, throw her right onto the path!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:9.1"], "en": "“Into many hells,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:9.2"], "en": "deep and difficult to cross,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:9.3"], "en": "I have been cast into a mountain precipice.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:9.4"], "en": "“By what means did you go there?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:10.1"], "en": "“I am a nāga with an expanded hood there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:10.2"], "en": "powerful, born from the mountain peak.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:10.3"], "en": "“He accepted me with wealth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:10.4"], "en": "therefore I lived there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:11.1"], "en": "“Come, I shall restore you to him.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:11.2"], "en": "\"O Prince, go to your own home;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:11.3"], "en": "rule the kingdom, O Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:11.4"], "en": "What will you do in the forest?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:12.1", "PA_ja_472:12.2"], "en": "Just as one might pull out a fishhook after swallowing it, even with blood;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:12.3"], "en": "having pulled it out, one would be at ease.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:12.4"], "en": "“Thus do I see myself.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:13.1", "PA_ja_472:13.2"], "en": "“What do you mean by ‘a hook,’ and what do you mean by ‘with blood’?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:13.3"], "en": "\"Why do you call it 'cast up'?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:13.4"], "en": "Tell me that when you are asked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:14.1"], "en": "\"I call sensual pleasures a fishhook,\" he replied.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:14.2"], "en": "With its trunk and blood,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:14.3"], "en": "I say it remains pulled out for four days;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:14.4"], "en": "know this, O Kṣatriya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:15.1"], "en": "“Ciñcā Māṇavikā was my mother,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:15.2"], "en": "Devadatta was my father;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:15.3"], "en": "Ānanda was the wise Nāga.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:15.4"], "en": "Sāriputta was the deity;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:15.5"], "en": "I was the prince—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:15.6"], "en": "thus you should remember this Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_472:16.1"], "en": "The Mahāpaduma Jātaka, the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
