[
{"segs": ["PA_ja_470:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:0.2"], "en": "The Twelfth Chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:0.3"], "en": "The Minor Section on Kuṇāla.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:0.4"], "en": "7. The Kosiya Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:1.1", "PA_ja_470:1.2"], "en": "“I neither buy nor sell, nor do I have any store of goods.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:1.3"], "en": "“Truly, this small gift is of poor quality;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:1.4"], "en": "a handful of rice is not enough for two.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:2.1"], "en": "“One should give even a little from what is little;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:2.2"], "en": "From what is moderate, one should give moderately;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:2.3"], "en": "from what is abundant, one should give abundantly—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:2.4"], "en": "non-giving does not lead to rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:3.1"], "en": "I say this to you, Kosiya:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:3.2"], "en": "give gifts and enjoy them;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:3.3"], "en": "ascend the Noble Path.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:3.4"], "en": "One who eats alone does not obtain happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:4.1"], "en": "His offerings are in vain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:4.2"], "en": "and his striving is likewise in vain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:4.3", "PA_ja_470:4.4", "PA_ja_470:5.1"], "en": "O Kosiya, I say this to you: he who eats his meal alone while a guest is seated there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:5.2"], "en": "Give gifts and enjoy them;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:5.3"], "en": "ascend the Noble Path,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:5.4"], "en": "for one who eats alone does not obtain happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:6.1"], "en": "Truth has been offered by him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:6.2"], "en": "and truth has been striven for,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:6.3"], "en": "by one who, when a guest is seated, [offers hospitality].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:6.4"], "en": "Someone else is eating the food.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:7.1"], "en": "Regarding that, Kosiya, I say to you:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:7.2"], "en": "give gifts and eat [the merit].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:7.3"], "en": "Having ascended the Noble Path,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:7.4"], "en": "one who eats but little attains happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:8.1"], "en": "A person burns up their own memories...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:8.2"], "en": "At Bahukā and at Gayā;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:8.3"], "en": "at Doṇa and at the ford of Timbaru,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:8.4"], "en": "where the swift current flows with a great rush.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:9.1"], "en": "In this case, one has truly offered the sacrifice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:9.2"], "en": "and in this case, one’s purpose is fulfilled:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:9.3"], "en": "when a guest is seated there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:9.4"], "en": "Someone else eats the food.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:10.1"], "en": "To you, Kosiya, I say this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:10.2"], "en": "give gifts and eat yourself.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:10.3"], "en": "Having ascended the Noble Path,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:10.4"], "en": "one who eats not alone attains happiness;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:11.1"], "en": "for he swallows the hook.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:11.2"], "en": "The Long Discourse with its bond:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:11.3"], "en": "he who, while a guest is seated,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:11.4"], "en": "eats his food all alone.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:12.1"], "en": "This I say to you, Kosiya:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:12.2"], "en": "give gifts and enjoy them;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:12.3"], "en": "ascend the Noble Path.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:12.4"], "en": "One who eats alone does not find happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:13.1"], "en": "“These brahmins indeed possess such sublime appearance;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:13.2"], "en": "yet what is the reason for this dog?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:13.3"], "en": "\"You transform yourself into various forms of diverse appearance;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:13.4"], "en": "tell us, O brahmins, who indeed are you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:14.1"], "en": "\"Both the Moon and the Sun have come here.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:14.2"], "en": "\"This, however, is Mātali,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:14.3"], "en": "the charioteer of the gods; I am Sakka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:14.4"], "en": "the lord of the thirty-three, and this one is called Pañcasikha.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:15.1"], "en": "With hand-clapping, mridanga drums,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:15.2"], "en": "murajas, and alambaras,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:15.3"], "en": "they awaken him with this music.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:15.4"], "en": "And having awakened, he rejoices.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:16.1"], "en": "\"Whosoever these are— miserly and stingy,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:16.2"], "en": "revilers of ascetics and brahmins;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:16.3"], "en": "“Having cast off this physical body right here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:16.4"], "en": "at the breaking up of the body, they go to hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:17.1"], "en": "“Whosoever among these, aspiring for a happy destination...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:17.2"], "en": "Established in the Dhamma, in self-restraint, and in sharing;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:17.3"], "en": "having laid down this physical body right here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:17.4"], "en": "they go to a happy destination upon the dissolution of the body.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:18.1"], "en": "In former births you were our kinsman,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:18.2"], "en": "yet you were miserly, irritable, and of evil character;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:18.3"], "en": "it is for your own sake that we have come here.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:18.4"], "en": "\"Do not, being of evil nature, go to hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:19.1", "PA_ja_470:19.2"], "en": "\"Surely those who instruct me do so out of a desire for my welfare.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:19.3"], "en": "Thus shall I act accordingly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:19.4"], "en": "doing all that has been spoken by those who wish me well.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:20.1"], "en": "This very day I shall bring it to rest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:20.2", "PA_ja_470:20.3"], "en": "I would not do any evil here, nor is there anything that I should not give; furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:20.4"], "en": "I do not drink water without having first offered it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:21.1"], "en": "And as I give in this way at all times,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:21.2"], "en": "O Vāsava, these riches will be exhausted;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:21.3"], "en": "therefore, Sakka, I shall go forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:21.4"], "en": "“Having abandoned sensual pleasures according to their nature.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_470:22.1"], "en": "Thus ends the seventh Jātaka, the Kosiya Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
