[
{"segs": ["PA_tha-ap_203:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:0.2"], "en": "The Section on the Kaṇikāra Flower, 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:0.3"], "en": "The Apadāna of the Elder Kaṇikārapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:1.1"], "en": "“Having seen a *kaṇikāra* tree in full bloom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:1.2", "PA_tha-ap_203:1.3"], "en": "I then plucked its flowers and offered them to Tissa.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:1.4"], "en": "To that Tathāgata who had crossed the flood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:2.1"], "en": "ninety-two aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:2.2"], "en": "I offered this flower.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:2.3"], "en": "I do not recall ever being born in an evil state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:2.4"], "en": "this is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:3.1"], "en": "In the twenty-fifth aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:3.2"], "en": "Renowned as Aruṇapāṇi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:3.3", "PA_tha-ap_203:3.4"], "en": "he was a wheel-turning monarch of great power, endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:4.1"], "en": "The four analytical knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:4.2"], "en": "these eight liberations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:4.3"], "en": "and the six direct knowledges have been realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:4.4"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:5.1"], "en": "It was in this way that the venerable elder Kaṇikārapupphiya recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_203:6.1"], "en": "This is the first legend of the elder Kaṇikārapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
