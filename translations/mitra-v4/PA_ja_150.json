[
{"segs": ["PA_ja_150:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:0.2"], "en": "The First Collection,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:0.3"], "en": "The Chapter on Kakkaṇṭaka", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:0.4"], "en": "10. The Sañjīva Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:1.1", "PA_ja_150:1.2"], "en": "“He who favors what is non-existent, and he who serves what is non-existent;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:1.3"], "en": "\"He makes that very same fodder his own,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:1.4"], "en": "just as the tiger Sañjīvaka did.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:2.1"], "en": "Thus ends the tenth Jātaka, the Sañjīvaka Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:2.2"], "en": "The fifteenth chapter, the Kakaṇṭaka-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:3.1", "PA_ja_150:4.1"], "en": "Its summary verse (uddāna) is: Sukhamedhati and Daṇḍavara, and again...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:4.2"], "en": "With the tail-hair as the fifth, the excellent Rādhava;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:4.3"], "en": "again, with the ocean and the body [as the first],", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:4.4"], "en": "the excellent Vyāghra with four finger-breadths makes ten.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:5.1"], "en": "The Upper Fifty.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:6.1"], "en": "Now, the summary of the chapters:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:7.1"], "en": "The Incontrovertible, the Chapter on Virtue, and the Kurunga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:7.2"], "en": "The fifth is the Kulāvaka;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:7.3"], "en": "the Āsīsa and the Itthivimāna were drunk by Varuṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:7.4"], "en": "with the Littavagga, these are ten.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:7.5"], "en": "The *Kusa-nāḷi* [chapter] has one hundred and two;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:7.6"], "en": "the *Kakaṇṭaka-vagga* has ninety-nine.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:8.1"], "en": "Thus it is compiled from the First Book (*Ekanipāta*).", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_150:9.1"], "en": "The First Book is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
