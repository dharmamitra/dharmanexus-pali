[
{"segs": ["PA_tha-ap_342:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:0.2"], "en": "Gandhodakavagga 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:0.3"], "en": "The Apadāna of the Elder Ukkhittapadumiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:1.1", "PA_tha-ap_342:1.2"], "en": "“At that time, in the city of Haṃsavatī, I was a florist;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:1.3"], "en": "having plunged into a lotus pond, I— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:1.4"], "en": "I plucked a hundred-petaled lotus.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:2.1"], "en": "There was a Conqueror named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:2.2"], "en": "who had gone beyond all phenomena.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:2.3"], "en": "Together with one hundred thousand [monks],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:2.4"], "en": "those of tranquil mind, the Tathāgatas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:3.1"], "en": "whose taints were exhausted and who were pure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:3.2"], "en": "Possessing the six supernormal powers and being meditators,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:3.3"], "en": "seeking my growth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:3.4"], "en": "he came into my presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:4.1"], "en": "Having seen the God of Gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:4.2"], "en": "the Self-Existent One, the Leader of the World;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:4.3"], "en": "having cut the stalk of the hundred-petaled lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:4.4"], "en": "I then tossed it up into the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:5.1"], "en": "If you are indeed the Buddha, O Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:5.2"], "en": "the Eldest in the World, the Bull among Men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:5.3"], "en": "Having gone there themselves,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:5.4"], "en": "let the hundred-petaled lotuses bear you upon their heads.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:6.1"], "en": "Resolve this, O Great Hero!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:6.2"], "en": "The eldest in the world, the bull among men—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:6.3", "PA_tha-ap_342:6.4"], "en": "the Buddha’s power caused them to hold it upon their heads.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:7.1", "PA_tha-ap_342:7.2"], "en": "By that well-performed kamma and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:7.3"], "en": "having abandoned this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:7.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:8.1", "PA_tha-ap_342:8.2"], "en": "There, a well-constructed celestial mansion of mine was called \"The Hundred-leaved.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:8.3", "PA_tha-ap_342:8.4"], "en": "Sixty yojanas in height and thirty yojanas in breadth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:9.1"], "en": "this many times over, O Lord of Devas, [he has risen].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:9.2"], "en": "I exercised the sovereignty of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:9.3", "PA_tha-ap_342:9.4"], "en": "and seventy-five times I was a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:10.1", "PA_tha-ap_342:10.2", "PA_tha-ap_342:10.3"], "en": "I experience my own karma: a vast regional sovereignty, beyond counting and incalculable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:10.4", "PA_tha-ap_342:11.1", "PA_tha-ap_342:11.2"], "en": "Having experienced the success resulting from that very single lotus, which was well-made by oneself in the past.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:11.3", "PA_tha-ap_342:11.4"], "en": "Having realized the Dhamma of the Blessed One Gotama,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:12.1"], "en": "my defilements have been incinerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:12.2"], "en": "All states of existence have been utterly eradicated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:12.3"], "en": "like a snake that has severed its bonds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:12.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:13.1"], "en": "In a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:13.2"], "en": "because I offered that flower in worship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:13.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:13.4"], "en": "This is the fruit of a single lotus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:14.1", "PA_tha-ap_342:14.2"], "en": "the four analytical knowledges (*paṭisambhidā*), and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:14.3"], "en": "\"Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:15.1"], "en": "It is said that the venerable elder Ukkhittapadumiya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:16.1"], "en": "This is the tenth legend of the elder Ukkhittapadumiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:17.1"], "en": "The thirty-fourth chapter: The Section on Scented Water.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:18.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:19.1"], "en": "Scent, incense, and water;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:19.2"], "en": "Punnāga and Ekadussaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:19.3"], "en": "Phusita and Pabhaṅkara;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:19.4"], "en": "Kuṭida and Uttarīyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:20.1"], "en": "The *Savanī* and the *Ekapadumī*,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:20.2"], "en": "with all the verses combined,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:20.3"], "en": "amount to one hundred and one verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_342:20.4"], "en": "And exactly forty-four.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
