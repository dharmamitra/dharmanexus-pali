[
{"segs": ["PA_thi-ap_15:0.1"], "en": "The Therī-apadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:0.2"], "en": "Ekūposathika-vagga 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:0.3"], "en": "The Apadāna of the Elder Nun Pañcadīpadāyikā", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:1.1", "PA_thi-ap_15:1.2", "PA_thi-ap_15:1.3"], "en": "“At that time, I was wandering from park to park in the city of Haṃsavatī.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:1.4"], "en": "Seeking what is wholesome, I was traveling when,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:2.1"], "en": "on a day of the dark fortnight,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:2.2"], "en": "I saw the supreme Bodhi tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:2.3"], "en": "Having gladdened my mind therein,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:2.4"], "en": "I sat at the foot of the Bodhi tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:3.1"], "en": "maintaining a heart of deep reverence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:3.2", "PA_thi-ap_15:3.3"], "en": "Having placed his palms together in reverence and expressed his joy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:3.4"], "en": "he then thought thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:4.1", "PA_thi-ap_15:4.2"], "en": "“If the Buddha possesses immeasurable qualities and is the peerless person,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:4.3"], "en": "may he show me a miracle.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:4.4"], "en": "\"May this Bodhi tree shine forth!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:5.1"], "en": "As soon as I directed my attention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:5.2"], "en": "the Bodhi tree immediately burst into flames.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:5.3", "PA_thi-ap_15:5.4"], "en": "It was made entirely of gold and shone in all directions;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:6.1"], "en": "for seven days and nights there, it blazed forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:6.2"], "en": "I sat at the foot of the Bodhi tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:6.3"], "en": "when the seventh day had arrived,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:6.4"], "en": "I performed an offering of lamps.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:7.1"], "en": "Having surrounded the seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:7.2", "PA_thi-ap_15:7.3"], "en": "they lit five lamps until the sun rose.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:7.4"], "en": "Then the lamps were lit for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:8.1"], "en": "By that well-performed deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:8.2"], "en": "and by my volition and aspiration, [I attained this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:8.3"], "en": "Having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:8.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:9.1"], "en": "There, a well-constructed celestial mansion was mine.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:9.2"], "en": "It is called the Five Islands;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:9.3", "PA_thi-ap_15:9.4"], "en": "it is sixty yojanas in height and thirty yojanas in width.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:10.1", "PA_thi-ap_15:10.2"], "en": "Innumerable islands blazed around me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:10.3"], "en": "as far as the realm of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:10.4"], "en": "It shines by the light of a lamp.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:11.1"], "en": "Sitting with my back turned,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:11.2"], "en": "if I wish to see, [I can do so].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:11.3"], "en": "Above, below, and across,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:11.4", "PA_thi-ap_15:12.1"], "en": "I see everything with my eye as far as I desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:12.2", "PA_thi-ap_15:12.3"], "en": "There is no obstruction there for seeing those who have fared well or poorly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:12.4"], "en": "whether among trees or mountains.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:13.1", "PA_thi-ap_15:13.2"], "en": "I exercised the great sovereignty over eighty kings of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:13.3"], "en": "and over hundreds of universal monarchs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:13.4"], "en": "I exercised supreme sovereignty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:14.1"], "en": "Whichever womb I was reborn into—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:14.2"], "en": "whether among the gods or among humans—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:14.3", "PA_thi-ap_15:14.4"], "en": "A hundred thousand lamps burn as my retinue;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:15.1"], "en": "having passed away from the world of the gods, I have come here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:15.2"], "en": "I was born from my mother’s womb;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:15.3"], "en": "while remaining within my mother’s womb,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:15.4"], "en": "my eyes did not close.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:16.1", "PA_thi-ap_15:16.2", "PA_thi-ap_15:16.3"], "en": "Hundreds of thousands of lamps burn in the birth-chamber due to her possession of meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:16.4"], "en": "This is the fruit of the five lamps.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:17.1"], "en": "When my final existence was reached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:17.2"], "en": "I turned back the mind [from rebirth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:17.3", "PA_thi-ap_15:17.4"], "en": "I have touched the deathless, the state of coolness, Nibbāna;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:18.1"], "en": "I was seven years old when I was born.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:18.2"], "en": "I attained arahantship;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:18.3", "PA_thi-ap_15:18.4"], "en": "the Buddha Gotama, recognizing my virtues, granted me full ordination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:19.1", "PA_thi-ap_15:19.2"], "en": "Whether dwelling in a pavilion, at the foot of a tree, or in an empty hut,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:19.3"], "en": "the lamp always burns bright.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:19.4"], "en": "This is the fruit of the five lamps:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:20.1"], "en": "my divine eye is purified,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:20.2"], "en": "and I am skilled in meditative concentration.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:20.3"], "en": "Having reached the perfection of direct knowledge—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:20.4"], "en": "this is the fruit of the five lamps;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:21.1"], "en": "having brought all duties to their completion, they have attained final rest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:21.2"], "en": "Having accomplished their task and free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:21.3"], "en": "O Great Hero, Five-Lamp One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:21.4"], "en": "I bow at your feet, O Visionary One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:22.1"], "en": "In a hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:22.2"], "en": "when I gave that lamp,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:22.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:22.4"], "en": "This is the fruit of the five lamps:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:23.1", "PA_thi-ap_15:23.2"], "en": "the defilements have been incinerated by me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:23.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:24.1", "PA_thi-ap_15:24.2"], "en": "Welcome indeed has come to me... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:24.3"], "en": "The Buddha’s teaching has been proclaimed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:25.1", "PA_thi-ap_15:25.2"], "en": "the four analytical knowledges, and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:25.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:26.1"], "en": "In this way, it is said, the bhikkhunī Pañcadīpadāyikā recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_15:27.1"], "en": "This is the fifth *apadāna* of the elder nun Pañcadīpadāyikā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
