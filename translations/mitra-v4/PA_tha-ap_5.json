[
{"segs": ["PA_tha-ap_5:0.1", "PA_tha-ap_5:0.2", "PA_tha-ap_5:0.3"], "en": "The Apadāna of the Elder Mahākassapa Buddhavagga 5. Mahākassapattheraapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:1.1"], "en": "“When the Blessed One Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:1.2"], "en": "the World’s Best, the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:1.3"], "en": "the Protector of the World, had attained final Nibbāna,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:1.4", "PA_tha-ap_5:2.1", "PA_tha-ap_5:2.2"], "en": "The people, with uplifted hearts, joyful and exceedingly glad, perform worship for the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:2.3"], "en": "When they had become filled with spiritual urgency,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:2.4"], "en": "rapture arose within me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:3.1"], "en": "Having gathered together my kinsmen and friends,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:3.2"], "en": "I spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:3.3"], "en": "\"The Great Hero has attained final Nibbāna;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:3.4"], "en": "come now, let us pay him honor.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:4.1"], "en": "Having replied \"So be it\" to him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:4.2", "PA_tha-ap_5:4.3"], "en": "they felt even greater joy toward the Buddha, the Lord of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:4.4"], "en": "We shall perform an accumulation of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:5.1", "PA_tha-ap_5:5.2"], "en": "having fashioned a well-made offering altar rising a hundred cubits high.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:5.3", "PA_tha-ap_5:5.4"], "en": "Having constructed a palatial mansion rising into the sky, spread over one and a half cubits,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:6.1"], "en": "and having built a gabled chamber there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:6.2"], "en": "Adorned with rows of palm trees,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:6.3"], "en": "having gladdened one's own mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:6.4"], "en": "one should worship the most excellent shrine.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:7.1"], "en": "Like a blazing mass of fire,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:7.2"], "en": "like a *kiṃsuka* tree in full bloom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:7.3"], "en": "like a rainbow in the sky—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:7.4"], "en": "It illuminates the four quarters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:8.1", "PA_tha-ap_5:8.2"], "en": "Having gladdened the mind therein and having performed much wholesome merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:8.3"], "en": "Recalling my former deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:8.4"], "en": "I was reborn among the Thirty-three gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:9.1"], "en": "possessing a chariot drawn by a thousand horses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:9.2"], "en": "Established upon a divine vehicle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:9.3"], "en": "my celestial palace rises high,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:9.4"], "en": "seven stories tall and towering aloft.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:10.1"], "en": "There were thousands of gabled chambers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:10.2"], "en": "made entirely of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:10.3"], "en": "blazing with their own radiance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:10.4"], "en": "Illuminating all directions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:11.1", "PA_tha-ap_5:11.2"], "en": "there were also other spires made of ruby at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:11.3", "PA_tha-ap_5:11.4"], "en": "They shine with radiance on all four sides;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:12.1"], "en": "they are produced by meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:12.2"], "en": "The gabled halls are well-constructed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:12.3", "PA_tha-ap_5:12.4"], "en": "made of jewels, they shine throughout the ten directions on every side.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:13.1"], "en": "As they were shining forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:13.2"], "en": "a vast radiance arose;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:13.3"], "en": "I surpass all the devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:13.4"], "en": "This is the fruit of meritorious karma:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:14.1"], "en": "sixty thousand eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:14.2"], "en": "there was a kshatriya named Ubbiddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:14.3"], "en": "A conqueror of the four quarters,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:14.4"], "en": "I dwelt upon the earth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:15.1"], "en": "even so during the auspicious aeon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:15.2", "PA_tha-ap_5:15.3", "PA_tha-ap_5:15.4"], "en": "Thirty times I was a wheel-turning monarch of great power, delighted by my own deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:16.1"], "en": "Endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:16.2"], "en": "a lord over the four continents—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:16.3"], "en": "even there, my palace was located.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:16.4"], "en": "It rises up like a pillar of Indra;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:17.1", "PA_tha-ap_5:17.2"], "en": "twenty-four finger-breadths in length and twelve in width.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:17.3"], "en": "There was a city named Rammaṇa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:17.4"], "en": "with firm walls and gate-towers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:18.1"], "en": "measuring five hundred [leagues] in length.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:18.2"], "en": "In detail, it was half that size;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:18.3"], "en": "crowded with throngs of people,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:18.4"], "en": "like the city of the Thirty-three gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:19.1", "PA_tha-ap_5:19.2"], "en": "Just as twenty-five needles, when inserted into a needle-case,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:19.3"], "en": "strike against one another, so too—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:19.4"], "en": "It is crowded and adorned.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:20.1", "PA_tha-ap_5:20.2"], "en": "In this way too, my city is thronged with elephants and chariots.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:20.3"], "en": "Always crowded with people,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:20.4"], "en": "that most delightful and excellent city;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:21.1"], "en": "having eaten and drunk there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:21.2"], "en": "Again I went to the state of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:21.3"], "en": "in my final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:21.4"], "en": "there was for me a perfection of lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:22.1"], "en": "Born into a brahmin family,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:22.2"], "en": "a treasury of great jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:22.3"], "en": "having abandoned eighty koṭis—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:22.4"], "en": "I too went forth from wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:23.1", "PA_tha-ap_5:23.2"], "en": "There are the four analytical knowledges and these eight liberations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:23.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:23.4"], "en": "the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:24.1"], "en": "Thus indeed did the Venerable Elder Mahākassapa speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_5:25.1"], "en": "The legend of the Elder Mahākassapa is the third.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
