[
{"segs": ["PA_thi-ap_36:0.1"], "en": "The Therī-apadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:0.2"], "en": "Chapter on the Kṣatriyas, 6:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:0.3"], "en": "The Apadāna of the Elder Nun Abhirūpanandā", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:1.1"], "en": "“Ninety-one eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:1.2"], "en": "a leader named Vipassī arose,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:1.3"], "en": "one of beautiful appearance.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:1.4"], "en": "The one with vision regarding all phenomena.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:2.1"], "en": "At that time, in Bandhumatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:2.2"], "en": "I was born into a prosperous, flourishing, and great family.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:2.3"], "en": "She was born beautiful and beloved,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:2.4"], "en": "worthy of honor by the people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:3.1"], "en": "Having approached the Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:3.2", "PA_thi-ap_36:3.3"], "en": "Having heard the Dhamma from Vipassī, the leader of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:3.4"], "en": "I went for refuge to that leader of men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:4.1"], "en": "Having been restrained in the precepts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:4.2"], "en": "when the Supreme among Men has attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:4.3"], "en": "[one should offer] upon the stupa of his relics...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:4.4"], "en": "I worshipped with a golden parasol.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:5.1"], "en": "Being virtuous and generous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:5.2"], "en": "when I passed away from there at the end of my life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:5.3"], "en": "Having cast off the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:5.4"], "en": "I went to the Tāvatiṃsa realm.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:6.1"], "en": "Then, in ten ways—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:6.2"], "en": "Having overcome the remainder:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:6.3"], "en": "forms, sounds, odors,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:6.4"], "en": "tastes, and tangibles.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:7.1"], "en": "And by lifespan, by beauty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:7.2", "PA_thi-ap_36:7.3"], "en": "by happiness, and by fame; likewise by sovereignty—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:7.4"], "en": "Having attained [this], I shine forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:8.1"], "en": "And now, in my final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:8.2"], "en": "I am born in Kapilavatthu.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:8.3"], "en": "The daughter of Khemaka the Sakyan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:8.4"], "en": "renowned by the name Nandā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:9.1"], "en": "was also endowed with great beauty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:9.2", "PA_thi-ap_36:9.3"], "en": "\"It was a sign of my beauty when, having reached youth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:9.4"], "en": "I was adorned with physical form and grace.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:10.1", "PA_thi-ap_36:10.2"], "en": "Then, at my birth, there arose a very great dispute among the Sakyans; from that,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:10.3"], "en": "my father caused me to go forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:10.4"], "en": "\"Lest the Sakyans perish.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:11.1"], "en": "Having gone forth [into homelessness] before the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:11.2"], "en": "the one of beautiful form, the supreme among men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:11.3"], "en": "Having heard [this], I did not approach,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:11.4"], "en": "being intoxicated by my own beauty;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:12.1"], "en": "I did not even follow his advice.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:12.2"], "en": "Out of fear at the sight of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:12.3"], "en": "the Conqueror then, by means of a skillful method,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:12.4"], "en": "led him into his presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:13.1", "PA_thi-ap_36:13.2", "PA_thi-ap_36:13.3"], "en": "Skilled in the ways of psychic power, he displayed three women who resembled celestial nymphs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:13.4", "PA_thi-ap_36:14.1"], "en": "Seeing those who were young, aged, and dead,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:14.2"], "en": "they became deeply agitated and detached from the physical body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:14.3"], "en": "Standing there, disenchanted with existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:14.4"], "en": "the Leader then said to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:15.1"], "en": "“It is afflicted, impure, and putrid;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:15.2"], "en": "Behold, Nanda, this physical heap,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:15.3"], "en": "oozing and trickling,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:15.4"], "en": "which fools delight in.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:16.1"], "en": "Develop the mind in the meditation on the foul,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:16.2", "PA_thi-ap_36:16.3"], "en": "one-pointed and well-concentrated; as this is, so is that.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:16.4", "PA_thi-ap_36:17.1"], "en": "As that is, so is this. Contemplating it thus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:17.2"], "en": "without sloth day and night;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:17.3", "PA_thi-ap_36:17.4"], "en": "\"Then, having become disillusioned through your own wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:18.1"], "en": "you shall go forth. While I am thus heedful,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:18.2"], "en": "For one who reflects thoroughly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:18.3", "PA_thi-ap_36:18.4"], "en": "this body is seen as it truly is, both internally and externally.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:19.1", "PA_thi-ap_36:19.2"], "en": "Then, becoming disenchanted with the body and becoming detached within,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:19.3"], "en": "being heedful and disjoined from it—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:19.4"], "en": "I am peaceful and extinguished;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:20.1", "PA_thi-ap_36:20.2"], "en": "I have mastery over the supernormal powers and possess the divine ear-element.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:20.3", "PA_thi-ap_36:20.4"], "en": "O Great Sage, I have mastery over the knowledge of the minds of others;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:21.1"], "en": "I know my own past lives.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:21.2"], "en": "The divine eye has been purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:21.3"], "en": "all taints are completely exhausted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:21.4"], "en": "there is now no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:22.1", "PA_thi-ap_36:22.2", "PA_thi-ap_36:22.3"], "en": "O Great Hero, my knowledge regarding the meanings, the phenomena, the linguistic expressions, and likewise regarding inspired eloquence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:22.4"], "en": "Has arisen in your presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:23.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:23.2"], "en": "…pe…", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:23.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:24.1", "PA_thi-ap_36:24.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:24.3"], "en": "This is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:25.1", "PA_thi-ap_36:25.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:25.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:26.1"], "en": "In this way, it is said, the bhikkhunī Abhirūpanandā spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_36:27.1"], "en": "This is the sixth legend of the elder nun Abhirūpanandā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
