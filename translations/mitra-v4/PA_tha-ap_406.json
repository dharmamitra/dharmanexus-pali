[
{"segs": ["PA_tha-ap_406:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:0.2"], "en": "Metteyyavagga 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:0.3"], "en": "The Apadāna of the Elder Dhotaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:1.1"], "en": "“The Ganges, named Bhāgīrathī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:1.2", "PA_tha-ap_406:1.3"], "en": "flows forth from the Himālayas by way of the gate of Haṃsavatī.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:1.4"], "en": "He continued his investigation as far as that.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:2.1"], "en": "There was a monastery named Sobhita,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:2.2"], "en": "beautifully constructed on the bank of the Ganges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:2.3", "PA_tha-ap_406:2.4"], "en": "There dwelt the Buddha Padumuttara, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:3.1"], "en": "like Indra among the Thirty-Three gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:3.2"], "en": "Honored by men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:3.3"], "en": "the Blessed One sat there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:3.4"], "en": "fearless like a lion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:4.1"], "en": "In the city of Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:4.2"], "en": "I dwell as a brahmin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:4.3"], "en": "by name, I am called Chaḷaṅga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:4.4"], "en": "O Great Sage of such a name!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:5.1", "PA_tha-ap_406:5.2"], "en": "At that time, eighteen hundred disciples surrounded me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:5.3"], "en": "Accompanied by those disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:5.4"], "en": "I approached the bank of the Ganges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:6.1"], "en": "There I saw ascetics.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:6.2", "PA_tha-ap_406:6.3"], "en": "While crossing the Bhāgīrathī, I, free from guile and cleansed of evil,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:6.4"], "en": "thought thus at that time:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:7.1"], "en": "“Crossing over day and night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:7.2", "PA_tha-ap_406:7.3"], "en": "the sons of the Buddha of great renown afflict themselves.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:7.4"], "en": "Their own selves are tormented.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:8.1"], "en": "In the world with its devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:8.2"], "en": "the Buddha is declared supreme.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:8.3", "PA_tha-ap_406:8.4"], "en": "I have no further duty to perform for the purification of my path of rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:9.1"], "en": "what if I were now [to offer] to the Best of Buddhas?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:9.2"], "en": "I shall cause a bridge to be built over the Ganges;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:9.3"], "en": "having had this work performed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:9.4"], "en": "I shall cross over this existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:10.1"], "en": "Having given a hundred thousand,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:10.2"], "en": "I had a bridge constructed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:10.3"], "en": "having faith, I performed this deed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:10.4"], "en": "\"Great will my merit become.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:11.1"], "en": "Having had that bridge constructed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:11.2"], "en": "I approached the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:11.3"], "en": "Placing my hands in añjali at my head,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:11.4"], "en": "I spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:12.1"], "en": "“Of a hundred thousand [pieces of gold], we— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:12.2", "PA_tha-ap_406:12.3"], "en": "Having given this, it was caused to be built by me for your sake—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:12.4"], "en": "a great bridge; please accept it, O Great Sage.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:13.1"], "en": "Padumuttara, the knower of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:13.2"], "en": "the recipient of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:13.3"], "en": "sat within the community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:13.4"], "en": "He spoke these verses: “He who,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:14.1", "PA_tha-ap_406:14.2"], "en": "with faith, built a bridge for me with his own hands...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:14.3"], "en": "I shall proclaim that;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:14.4"], "en": "listen as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:15.0"], "en": "4.1. The Benefits of the Bridge-Gift.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:15.1"], "en": "Even if one has fallen from a cliff, from a mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:15.2"], "en": "or from a tree, having passed away,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:15.3"], "en": "one may still attain that state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:15.4"], "en": "This is the fruit of the gift of a bridge:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:16.1", "PA_tha-ap_406:16.2"], "en": "like a banyan tree with deep-rooted growth when stirred by the wind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:16.3"], "en": "Enemies do not prevail over him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:16.4"], "en": "this is the fruit of giving a bridge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:17.1"], "en": "Thieves do not prevail over him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:17.2"], "en": "The kṣatriyas do not despise them;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:17.3"], "en": "all their enemies shall cross over—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:17.4"], "en": "this is the fruit of giving a bridge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:18.1"], "en": "To one who has gone to the open air, peaceful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:18.2"], "en": "scorched by the heat of the sun,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:18.3"], "en": "and endowed with meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:18.4"], "en": "There will be no more feeling—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:19.1"], "en": "whether in the world of the gods or among humans—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:19.2"], "en": "not even a well-fashioned elephant chariot.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:19.3"], "en": "Knowing his intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:19.4", "PA_tha-ap_406:20.1"], "en": "there will immediately arise a thousand [horses] with the speed of the wind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:20.2"], "en": "Horses, swift steeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:20.3"], "en": "shall come to me morning and evening;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:20.4"], "en": "this is the fruit of the gift of a bridge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:21.1"], "en": "Having come to human birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:21.2", "PA_tha-ap_406:21.3"], "en": "he will be happy; like a man [traveling] through the air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:21.4"], "en": "There will be an elephant vehicle.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:22.1"], "en": "In a hundred thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:22.2"], "en": "one born of the Okkāka clan;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:22.3", "PA_tha-ap_406:22.4"], "en": "One named Gotama by clan will become a teacher in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:23.1"], "en": "he shall be an heir to his teachings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:23.2"], "en": "Born from the heart, fashioned by the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:23.3"], "en": "having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:23.4"], "en": "he will extinguish, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:24.1", "PA_tha-ap_406:24.2"], "en": "\"Aha! Well done by me is this deed, O you named the Best of Water-Born;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:24.3"], "en": "having performed service there,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:24.4"], "en": "I have attained the destruction of the taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:25.1"], "en": "Diligent and resolute,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:25.2"], "en": "I am peaceful and free from acquisitions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:25.3"], "en": "Like a snake that has severed its bonds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:25.4"], "en": "I dwell free from taints;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:26.1"], "en": "my defilements have been incinerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:26.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:26.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:27.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:27.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:27.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:28.1"], "en": "The four analytical knowledges (paṭisambhidā) [are attained].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:28.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:28.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:29.1"], "en": "Thus indeed did the Venerable Elder Dhotaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_406:30.1"], "en": "The legend of the Elder Dhotaka is the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
