[
{"segs": ["PA_tha-ap_265:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:0.2"], "en": "Padumukkhipavagga 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:0.3"], "en": "The Apadāna of the Elder Aḍḍhacandiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:1.1", "PA_tha-ap_265:1.2"], "en": "“At the supreme Bodhi tree of the Blessed One Tissa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:1.3"], "en": "I offered a half-moon [shaped ornament].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:1.4"], "en": "In the tree that grows from the earth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:2.1"], "en": "Ninety-two aeons ago from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:2.2"], "en": "when I offered a moon [to the Buddha];", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:2.3"], "en": "I do not recall ever being born in an unhappy state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:2.4"], "en": "this is the fruit of my worship of the Bodhi tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:3.1"], "en": "Twenty-five eons from now...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:3.2"], "en": "A kṣatriya named Devala,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:3.3", "PA_tha-ap_265:3.4"], "en": "a wheel-turning monarch of great power, endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:4.1", "PA_tha-ap_265:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:5.1"], "en": "Thus indeed the venerable elder Aḍḍhacandiya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_265:6.1"], "en": "This is the third legend of the elder Aḍḍhacandiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
