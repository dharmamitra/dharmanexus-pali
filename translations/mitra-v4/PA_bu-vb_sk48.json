[
{"segs": ["PA_bu-vb_sk48:0.1"], "en": "The Theravāda Vinaya Mahāvibhaṅga:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:0.2", "PA_bu-vb_sk48:0.3"], "en": "The Section on the Training Rules (Sekhiyakaṇḍa)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:0.4"], "en": "Kabaḷavagga 48.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:0.5"], "en": "The Training Rule on Rice Grains.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:1.1"], "en": "At that time, the Buddha, the Blessed One, was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:1.2"], "en": "Now at that time, the group-of-six monks ate scattering rice grains.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:1.3.1"], "en": "… “‘I shall not eat scattering rice grains,’ this training is to be observed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:1.4"], "en": "One must not eat scattering rice grains.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:1.5"], "en": "Whoever, out of disrespect, eats scattering rice about commits an offense of wrong-doing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:1.6.1", "PA_bu-vb_sk48:1.7"], "en": "There is no offense if it is unintentional.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:1.8", "PA_bu-vb_sk48:1.9", "PA_bu-vb_sk48:1.10"], "en": "In the case of one who is absent-minded, one who is unaware, or one who is ill.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:1.11"], "en": "One who, while throwing away refuse, throws away cooked rice;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:1.12", "PA_bu-vb_sk48:1.13"], "en": "one in times of distress; one who is insane.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:1.14"], "en": "\"For one who is a first-offender.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk48:1.15"], "en": "The eighth training rule is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
