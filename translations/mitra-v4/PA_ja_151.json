[
{"segs": ["PA_ja_151:0.1", "PA_ja_151:0.2", "PA_ja_151:0.3"], "en": "Jātaka: The Second Book of Birth Stories (Dukanipāta), Chapter on the Firm (Daḷhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_151:0.4"], "en": "1. The Rājovāda Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_151:1.1", "PA_ja_151:1.2"], "en": "“The strong man hurls back the strong, and the archer returns the weak with the weak;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_151:1.3"], "en": "One wins the good by means of the good,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_151:1.4"], "en": "and the bad by means of the bad;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_151:1.5"], "en": "such is this king.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_151:1.6"], "en": "“Drive the chariot away from the path, charioteer!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_151:2.1"], "en": "“Conquer anger with non-anger;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_151:2.2"], "en": "conquer the wicked with goodness.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_151:2.3"], "en": "One should conquer the miser with generosity,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_151:2.4"], "en": "and the liar with truth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_151:2.5"], "en": "such is this king.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_151:2.6"], "en": "“Depart from the path, charioteer!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_151:3.1"], "en": "This concludes the first Jātaka, the Rājovāda Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
