[
{"segs": ["PA_tha-ap_272:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:0.2"], "en": "The Section on the Flower-Thrower (Padumukkhipavagga) 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:0.3"], "en": "The Apadāna of the Elder Taraṇiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:1.1"], "en": "The golden-hued Sambuddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:1.2"], "en": "Vipassī, worthy of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:1.3"], "en": "the Teacher, stood upon the riverbank.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:1.4"], "en": "Honored by the community of monks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:2.1", "PA_tha-ap_272:2.2"], "en": "there was no boat there to carry them across the great ocean.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:2.3"], "en": "Having departed from the river,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:2.4"], "en": "I ferried the Leader of the World across.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:3.1"], "en": "Ninety-one eons ago—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:3.2"], "en": "I rescued that supreme among men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:3.3"], "en": "I do not know a state of misery—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:3.4"], "en": "this is the fruit of that rescue.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:4.1", "PA_tha-ap_272:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:5.1"], "en": "Thus indeed the venerable elder Taraṇiya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:6.1"], "en": "This is the tenth legend of the elder Taraṇiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:7.1"], "en": "The twenty-seventh chapter, the Padumukkhipa Chapter, is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:8.1", "PA_tha-ap_272:9.1"], "en": "Its summary verse: Ukkhipī, Telacandī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:9.2"], "en": "Dīpada, and Biḷālida.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:9.3"], "en": "Maccha, java, saḷalada,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:9.4"], "en": "rakkhasa, taraṇa, dasa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:9.5"], "en": "and here the verses are enumerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_272:9.6"], "en": "And tālīsa alone as well.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
