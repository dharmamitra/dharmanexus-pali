[
{"segs": ["PA_ja_523:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:0.2"], "en": "The Section of Forty [Stories],", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:0.3"], "en": "Tesakuṇa Chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:0.4"], "en": "3. The Alambusā Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:1.1", "PA_ja_523:1.2"], "en": "Then the great Indra spoke, the father of the victor Vṛtrahan.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:1.3", "PA_ja_523:1.4"], "en": "Having surpassed the celestial maiden Alambusā in the Sudhamma hall,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:2.1"], "en": "[the gods say]: \"O lady, the gods entreat you.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:2.2"], "en": "The Thirty-three gods together with Indra;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:2.3"], "en": "go to Isippalobhana,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:2.4"], "en": "Alambusa, and Isisinga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:3.1"], "en": "Soon he will surpass us—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:3.2"], "en": "he who speaks the truth, lives the holy life,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:3.3"], "en": "delights in Nibbāna, and is mature.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:3.4", "PA_ja_523:4.1"], "en": "“Block his paths. “O King of Devas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:4.2"], "en": "why do you instruct me as if you were I?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:4.3", "PA_ja_523:4.4"], "en": "Go, O Isipālī, there are other nymphs as well;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:5.1"], "en": "those like me are indeed most excellent.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:5.2"], "en": "In the grove of Aśoka trees,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:5.3"], "en": "which brings delight; let there be an opportunity for them as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:5.4"], "en": "and let them too go to that place of seduction.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:6.1"], "en": "“Truly you speak the truth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:6.2"], "en": "there are indeed other apsarases as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:6.3"], "en": "who are just as excellent and sublime.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:6.4"], "en": "In the Ashoka grove, the Nandana forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:7.1"], "en": "they do not understand this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:7.2"], "en": "that they have gone to serve a man.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:7.3", "PA_ja_523:7.4", "PA_ja_523:8.1"], "en": "\"O woman beautiful in every limb, go yourself, O auspicious one, as you understand what is required.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:8.2"], "en": "You are the most excellent among women;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:8.3"], "en": "by your very complexion and form,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:8.4"], "en": "you will bring all others into subjection.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:9.1"], "en": "“Neither will I not go,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:9.2"], "en": "for I have been sent by the King of the Gods;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:9.3"], "en": "yet I am afraid to enter this place.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:9.4"], "en": "For a brahmin possesses fierce power;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:10.1", "PA_ja_523:10.2"], "en": "many people, by insulting the seer, have fallen into hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:10.3"], "en": "\"Having fallen into the saṃsāra of delusion,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:10.4"], "en": "one should pluck out the hairs [of the mind].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:11.1"], "en": "Having said this, he departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:11.2"], "en": "The nymph Alambusā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:11.3"], "en": "possessing a form of sensual beauty, desired to mix with him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:11.4"], "en": "longing for the sage’s horn.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:12.1", "PA_ja_523:12.2"], "en": "And she, having entered that forest protected by the sage Siṅga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:12.3"], "en": "which was covered with lattices of creepers—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:12.4"], "en": "For half a yojana all around.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:13.1"], "en": "At dawn, at the time for the morning meal,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:13.2"], "en": "during the early part of the day;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:13.3", "PA_ja_523:13.4"], "en": "As he was rubbing the sacred fire, Isisinga approached him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:14.1"], "en": "\"Who is it that shines like lightning? he asked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:14.2"], "en": "Like stars among herbs,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:14.3", "PA_ja_523:14.4"], "en": "they had variegated hand-ornaments and wore jeweled earrings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:15.1"], "en": "Resembling the color of the sun,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:15.2"], "en": "possessing the fragrance of gold and sandalwood,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:15.3"], "en": "Māyā was self-restrained and noble.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:15.4"], "en": "A maiden of beautiful appearance,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:16.1"], "en": "with limbs that are slender, soft, and pure,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:16.2"], "en": "her feet are well-set.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:16.3", "PA_ja_523:16.4"], "en": "Your gait is so desirable that it truly captivates my mind;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:17.1"], "en": "your thighs are indeed tapering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:17.2"], "en": "Resembling the trunk of an elephant,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:17.3", "PA_ja_523:17.4"], "en": "your well-rounded hips are polished like the axle-plate of a chariot.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:18.1"], "en": "Like the filaments of a blue lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:18.2", "PA_ja_523:18.3"], "en": "your navel is well-formed and filled as if with black collyrium.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:18.4"], "en": "It is visible from afar.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:19.1"], "en": "Two kinds of *urajā* have arisen:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:19.2"], "en": "those without stalks and those with excellent backs.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:19.3"], "en": "Her breasts have not yet fallen away;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:19.4", "PA_ja_523:20.1"], "en": "they are like half-pumpkins. Long and shining with the luster of conch shells, they are beautiful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:20.2"], "en": "Her neck is like that of an antelope;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:20.3"], "en": "white, with a beautiful covering,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:20.4"], "en": "it resembles the fourth stage of meditation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:21.1", "PA_ja_523:21.2"], "en": "High and low, rubbed against the tops of trees;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:21.3"], "en": "difficult to pierce, born of craftiness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:21.4"], "en": "Your teeth are beautiful to behold;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:22.1"], "en": "they are not pale, but red-edged,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:22.2"], "en": "resembling the fruit of the *jiñjūka*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:22.3"], "en": "Long and wide are your eyes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:22.4"], "en": "so beautiful to behold;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:23.1"], "en": "they are neither too long nor ill-kept.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:23.2", "PA_ja_523:23.3", "PA_ja_523:23.4"], "en": "Your hair, growing from your noble body, is as fragrant as sandalwood and is adorned with golden combs.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:24.1"], "en": "As far as the range of cattle-herding,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:24.2", "PA_ja_523:24.3"], "en": "the sphere of merchants, and the domain of those who have exerted themselves as seers—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:24.4"], "en": "Of those who are self-restrained and ascetic,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:25.1", "PA_ja_523:25.2"], "en": "one would not find an equal upon this circle of the earth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:25.3"], "en": "“Who are you, or whose son are you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:25.4", "PA_ja_523:26.1"], "en": "How may we know you? “It is not the time for questions, venerable sirs.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:26.2"], "en": "Since Kassapa has gone thus,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:26.3", "PA_ja_523:26.4"], "en": "come, friend, let us both enjoy ourselves here in our own hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:26.5"], "en": "\"Come, I shall embrace you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:26.6"], "en": "become skilled in pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:27.1"], "en": "Having said this, she departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:27.2"], "en": "The nymph Alambusā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:27.3"], "en": "possessing a form of sensual beauty, desired to mix with the Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:27.4"], "en": "wishing to unite with him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:28.1", "PA_ja_523:28.2"], "en": "And so, having departed with speed and abandoned sluggish effort,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:28.3"], "en": "he [entered] among those women with the finest braids.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:28.4"], "en": "Having attained it, he grasped it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:29.1"], "en": "The beautiful woman turned back toward him;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:29.2"], "en": "the lovely one embraced him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:29.3", "PA_ja_523:29.4"], "en": "Having praised the holy life as they were satisfied,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:30.1"], "en": "she approached Indra with her mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:30.2"], "en": "While she was dwelling in the Nandana grove,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:30.3", "PA_ja_523:30.4"], "en": "Maghavan, that elephant among gods, understood her intention.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:31.1", "PA_ja_523:31.2"], "en": "He quickly sent a golden palanquin with bearers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:31.3"], "en": "provided with a canopy and fifty [attendants].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:31.4"], "en": "Adorned with a thousand [ornaments],", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:32.1", "PA_ja_523:32.2"], "en": "she bore that beautiful woman there, holding her to her breast.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:32.3"], "en": "Just as he had maintained it for a single moment,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:32.4", "PA_ja_523:33.1"], "en": "so too did he maintain it for three years. Free from intoxication, after those three years, he—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:33.2", "PA_ja_523:33.3", "PA_ja_523:33.4"], "en": "Having awakened, the brahmin saw the Āgneyāyana grove surrounded on all sides by green trees.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:34.1"], "en": "Having looked all around at the forest of fresh leaves,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:34.2", "PA_ja_523:34.3"], "en": "in full bloom and resounded by the cries of flocks of cuckoos,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:34.4"], "en": "Weeping, he shed tears:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:35.1"], "en": "\"I neither offered oblations nor chanted mantras;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:35.2"], "en": "I have abandoned the sacred fire.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:35.3", "PA_ja_523:35.4"], "en": "Who was it that formerly tempted my mind with service,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:36.1"], "en": "while I was dwelling in the forest?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:36.2"], "en": "He took from me that splendor which had arisen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:36.3", "PA_ja_523:36.4"], "en": "like one who takes a ship filled with various jewels from the great ocean.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:37.1", "PA_ja_523:37.2"], "en": "“I have been sent by the King of the Gods to serve you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:37.3"], "en": "I have conquered my own mind with my mind.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:37.4"], "en": "“Through negligence you do not wake up.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:38.1", "PA_ja_523:38.2"], "en": "“It seems these are the instructions my father Kassapa gives me;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:38.3", "PA_ja_523:38.4"], "en": "O young man, you recognized those women who resembled lotuses;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:39.1"], "en": "you recognized those with goiters on their necks.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:39.2"], "en": "\"You understood them, young man;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:39.3", "PA_ja_523:39.4"], "en": "thus did my father instruct me out of compassion for me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:40.1"], "en": "I did not accept her words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:40.2"], "en": "the instruction of my aged father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:40.3"], "en": "[to dwell] in the forest devoid of people.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:40.4"], "en": "Today I shall meditate alone.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:41.1"], "en": "I will act accordingly;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:41.2"], "en": "shame on this life of mine!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:41.3"], "en": "\"Or else I shall become such again;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:41.4"], "en": "death will come to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:42.1"], "en": "Such was his fervor and his energy.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:42.2"], "en": "Knowing that his resolve was firm,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:42.3", "PA_ja_523:42.4"], "en": "Alambusā grasped the feet of the sage Isisinga with her head.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:43.1"], "en": "\"Do not be angry with me, O Great Hero;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:43.2"], "en": "do not be angry with me, O Great Seer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:43.3"], "en": "A great purpose has been accomplished by me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:43.4"], "en": "Of the glorious Thirty-three;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:43.5", "PA_ja_523:43.6"], "en": "by you, the entire city of the gods was shaken at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:44.1"], "en": "“May the Tāvatiṃsa gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:44.2"], "en": "Vāsava the lord of the thirty-three,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:44.3"], "en": "and you too, Bhaddā, be happy.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:44.4"], "en": "“Go, maiden, as you please.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:45.1", "PA_ja_523:45.2"], "en": "Having grasped his feet and circumambulated him, she departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:45.3"], "en": "Having raised his hands in reverential salutation,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:45.4"], "en": "he departed from that place;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:46.1"], "en": "and as for the couch that belonged to him—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:46.2"], "en": "It was golden, with a golden carriage;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:46.3", "PA_ja_523:46.4"], "en": "it had fifty canopies above and was prepared with a thousand [attendants].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:46.5"], "en": "Having ascended that very couch,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:46.6"], "en": "he went into the presence of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:47.1"], "en": "like approaching darkness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:47.2"], "en": "Like a lightning flash blazing forth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:47.3", "PA_ja_523:47.4"], "en": "the Lord of Devas, overcome with joy, glad, and delighted, granted a boon.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:48.1"], "en": "“If you would grant me a boon, O Sakka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:48.2"], "en": "Lord of all beings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:48.3"], "en": "may my lustful wife go forth.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:48.4"], "en": "“Sakka, choose this boon.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_523:49.1"], "en": "The Third Jātaka, the Alambusā Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
