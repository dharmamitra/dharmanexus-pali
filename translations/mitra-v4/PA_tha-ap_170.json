[
{"segs": ["PA_tha-ap_170:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:0.2"], "en": "Supāricariyavagga 8.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:0.3"], "en": "The Apadāna of the Elder Dussadāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:1.1", "PA_tha-ap_170:1.2"], "en": "“At that time, in the delightful city of Tivarā, I was a prince;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:1.3"], "en": "having received a gift, I— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:1.4"], "en": "To him who was thus pacified,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:2.1", "PA_tha-ap_170:2.2"], "en": "the Blessed One consented and touched the cloth with his hand.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:2.3"], "en": "Siddhattha, having consented,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:2.4", "PA_tha-ap_170:3.1"], "en": "rose up into the sky through the air as the Buddha was departing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:3.2"], "en": "The cloths were trailing behind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:3.3"], "en": "there I felt confidence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:3.4"], "en": "for the Buddha is the supreme person among us.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:4.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:4.2"], "en": "because I gave that robe,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:4.3"], "en": "I do not recall ever being born in an unhappy state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:4.4"], "en": "This is the fruit of the gift of cloth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:5.1"], "en": "Then, in the sixty-seventh aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:5.2"], "en": "I was a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:5.3", "PA_tha-ap_170:5.4"], "en": "The lord of men, possessed of great power, was named Parisuddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:6.1"], "en": "he [attained] the four analytical knowledges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:7.1"], "en": "Thus indeed did the venerable elder Dussadāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_170:8.1"], "en": "The legend of the Elder Dussadāyaka is the eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
