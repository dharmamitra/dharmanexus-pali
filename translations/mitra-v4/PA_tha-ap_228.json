[
{"segs": ["PA_tha-ap_228:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:0.2"], "en": "The Chapter on the Giver of the Support (Ālambaṇadāyakavagga), Number Six:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:0.3"], "en": "The Apadāna of the Elder Aṅkolapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:1.1"], "en": "“Nārada” is my name,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:1.2"], "en": "and I am known as Kassapa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:1.3"], "en": "I have seen the foremost of recluses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:1.4"], "en": "Vipassī, honored by gods and humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:2.1"], "en": "the Buddha who bears the secondary marks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:2.2"], "en": "the recipient of offerings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:2.3"], "en": "Having taken an aṅkola flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:2.4"], "en": "I offered it to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:3.1"], "en": "Ninety-one aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:3.2"], "en": "The flower that I offered in worship—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:3.4"], "en": "this is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:4.1"], "en": "In the seventy-fourth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:4.2"], "en": "there was a kshatriya named Romasa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:4.3"], "en": "adorned with garlands and ornaments.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:4.4"], "en": "Equipped with his forces and his vehicle.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:5.1", "PA_tha-ap_228:5.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:6.1"], "en": "In this way, indeed, the Venerable Elder Aṅkolapupphiya recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_228:7.1"], "en": "This is the sixth legend of the Elder Aṅkolapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
