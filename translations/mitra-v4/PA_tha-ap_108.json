[
{"segs": ["PA_tha-ap_108:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:0.2"], "en": "The Chapter on the Giver of Alms-food (Bhikkhadāyivagga) 6.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:0.3"], "en": "The Apadāna of the Elder Udakapūjaka (The Water-Worshipper)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:1.1"], "en": "“The Sambuddha, golden-hued,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:1.2"], "en": "as he went along the path of the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:1.3"], "en": "was like a lamp burning with a steady flame.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:1.4"], "en": "Like a blazing fire,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:2.1", "PA_tha-ap_108:2.2"], "en": "I took water in my hand and threw it up into the air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:2.3", "PA_tha-ap_108:2.4"], "en": "The Great Hero, the compassionate Buddha, the Seer, accepted it;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:3.1"], "en": "the Teacher remained poised in the air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:3.2"], "en": "The one named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:3.3"], "en": "having understood my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:3.4"], "en": "spoke this verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:4.1"], "en": "“By this gift of water,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:4.2"], "en": "and by the arising of joy;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:4.3"], "en": "even for a hundred thousand eons...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:4.4"], "en": "He does not fall into an evil rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:5.1"], "en": "By that karma, O Lord of Bipeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:5.2"], "en": "Supreme One in the World, Bull among Men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:5.3"], "en": "I have reached the immovable state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:5.4"], "en": "having abandoned victory and defeat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:6.1"], "en": "By the name of Sahassara, I am...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:6.2"], "en": "Those three were wheel-turning monarchs;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:6.3"], "en": "for five hundred and sixty aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:6.4"], "en": "they were lords of people over the four quarters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:7.1", "PA_tha-ap_108:7.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:7.3"], "en": "[and so forth] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:8.1"], "en": "Thus indeed the venerable elder Udakapūjaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_108:9.1"], "en": "This is the sixth legend of the elder Udakapūjaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
