[
{"segs": ["PA_tha-ap_97:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:0.2"], "en": "Sudhāvagga 5:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:0.3"], "en": "The Apadāna of the Elder Gandhamāliya", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:1.1"], "en": "“For the Blessed One Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:1.2"], "en": "I constructed a fragrant stupa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:1.3"], "en": "covered with jasmine flowers.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:1.4"], "en": "What has been done is worthy of the Buddhas. To the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:2.1"], "en": "who resembles a priceless golden ornament,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:2.2"], "en": "the Leader Supreme of the World;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:2.3"], "en": "Like a blooming blue lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:2.4"], "en": "like a blazing sacrificial fire,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:3.1"], "en": "like a noble tiger or bull.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:3.2"], "en": "Like a noble-born lion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:3.3"], "en": "the foremost of ascetics sat there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:3.4"], "en": "honored by the community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:4.1"], "en": "Having paid homage at the Teacher’s feet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:4.2"], "en": "I departed facing north;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:4.3"], "en": "ninety-four aeons ago, I...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:4.4"], "en": "Since I offered this perfume and garland,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:5.1", "PA_tha-ap_97:5.2"], "en": "I have attained preeminence through the fruit of my service rendered to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:5.3"], "en": "I do not know a miserable rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:5.4"], "en": "this is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:6.1"], "en": "In the [aeon] of thirty-nine [Buddhas],...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:6.2", "PA_tha-ap_97:6.3"], "en": "In sixteen eons there were sixteen kings named Devagandha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:6.4"], "en": "all of whom were universal monarchs (cakravartin).", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:7.1", "PA_tha-ap_97:7.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:7.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:8.1"], "en": "Thus indeed the venerable elder Gandhamāliya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_97:9.1"], "en": "This is the fifth legend of the elder Gandhamāliya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
