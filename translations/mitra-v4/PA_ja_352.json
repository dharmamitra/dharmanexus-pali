[
{"segs": ["PA_ja_352:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:0.2", "PA_ja_352:0.3"], "en": "The Fifth Collection, Chapter on the Jeweled Earrings (Maṇikuṇḍalavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:0.4"], "en": "2. The Sujāta Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:1.1", "PA_ja_352:1.2"], "en": "\"Why indeed, hurrying as you were, did you pluck and carry away the green grass? ... [the rest of the verse follows] ...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:1.3"], "en": "\"You eat, you eat,\" you prattle,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:1.4"], "en": "to this old bull whose life has departed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:2.1"], "en": "for it is not by food and drink [that one is sustained].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:2.2"], "en": "A dead ox might rise up again,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:2.3"], "en": "but you prattle vainly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:2.4"], "en": "just as one who is foolish does.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:3.1"], "en": "“Just so the head remains,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:3.2"], "en": "as do the hands, feet, and tail;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:3.3"], "en": "the ears likewise remain just as they were.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:3.4"], "en": "I think the ox has risen up,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:4.1", "PA_ja_352:4.2"], "en": "yet neither its head nor its hands and feet are visible.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:4.3", "PA_ja_352:4.4"], "en": "\"Were you not crying at the clay stupa, you fool?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:5.1"], "en": "\"While I was burning, alas!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:5.2", "PA_ja_352:5.3"], "en": "Like a fire doused with water from a jar, by sprinkling it with water,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:5.4"], "en": "one should extinguish every affliction.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:6.1", "PA_ja_352:6.2"], "en": "Truly, the arrow has been pulled out from my heart,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:6.3"], "en": "that which was lodged there while I was overcome by sorrow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:6.4"], "en": "I have dispelled my grief for my father.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:7.1"], "en": "I am one whose arrow has been pulled out,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:7.2"], "en": "free from sorrow and undisturbed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:7.3"], "en": "I do not grieve, nor do I weep,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:7.4"], "en": "O young man, having heard this from you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:8.1"], "en": "Thus do those possessed of wisdom act.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:8.2", "PA_ja_352:8.3"], "en": "Those who are compassionate turn one away from sorrow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:8.4"], "en": "just as Sujāta did for his father.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_352:9.1"], "en": "The Sujāta Jātaka, the second.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
