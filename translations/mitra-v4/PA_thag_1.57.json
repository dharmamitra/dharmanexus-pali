{"segs": ["PA_thag_1.57:0.1", "PA_thag_1.57:0.2", "PA_thag_1.57:0.3"], "en": "Theragāthā 1.57 Ekakanipāta Chaṭṭhavagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.57:0.4"], "en": "The Second Kuṭivihāri Thera’s Verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.57:1.1"], "en": "“This is an old hut, they say;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.57:1.2"], "en": "you desire another, a new hut.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.57:1.3"], "en": "“Adorn your hut with hope;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.57:1.4"], "en": "for a bhikkhu, a new hut is a source of suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.57:1.5"], "en": "… [Thus spoke] the Elder Dutiyakuṭivihārin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
