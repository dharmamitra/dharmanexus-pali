[
{"segs": ["PA_ja_463:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:0.2", "PA_ja_463:0.3"], "en": "The Section of Eleven, Chapter on the Supporter of His Mother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:0.4"], "en": "9. The Suppāraka Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:1.1", "PA_ja_463:1.2"], "en": "“People with snouts like ploughshares are surfacing and submerging;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:1.3"], "en": "\"We ask you about Suppāraka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:1.4"], "en": "what ocean is this?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:2.1"], "en": "\"For those who have set out from Kurukacchā...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:2.2"], "en": "For merchants seeking wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:2.3"], "en": "when their ship is lost,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:2.4"], "en": "it is called \"Khuramālī.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:3.1"], "en": "“Like a fire, like the sun,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:3.2"], "en": "like the ocean— such is he who appears.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:3.3"], "en": "We ask about Suppāraka.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:3.4"], "en": "“What ocean is this?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:4.1", "PA_ja_463:4.2"], "en": "“For the merchants from Kurukaccha who have set out seeking wealth,” [he replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:4.3", "PA_ja_463:4.4"], "en": "\"One who has lost his ship is called 'Agni-mālin' (Garlanded with Fire).", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:5.1"], "en": "\"Just as curd [comes from] milk,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:5.2"], "en": "The ocean appears before us;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:5.3"], "en": "we ask about Suppāraka—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:5.4"], "en": "what ocean is this?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:6.1", "PA_ja_463:6.2"], "en": "“Of the merchants from Kurukaccha who had set out seeking wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:6.3"], "en": "their ship having been lost at sea,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:6.4"], "en": "\"He is called Dadhimālī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:7.1", "PA_ja_463:7.2"], "en": "\"Just as if barley or rice were reflected in the ocean,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:7.3"], "en": "“We ask you about Suppāraka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:7.4"], "en": "what ocean is this?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:8.1"], "en": "“[It is] for those who have set out from Kurukacchā.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:8.2"], "en": "For merchants seeking wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:8.3"], "en": "when their ship has gone astray,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:8.4"], "en": "it is called *kusamālī*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:9.1", "PA_ja_463:9.2"], "en": "\"Just as the ocean appears like reeds or bamboos,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:9.3"], "en": "we ask you about that Suppāraka.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:9.4"], "en": "“What kind of ocean is this?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:10.1", "PA_ja_463:10.2"], "en": "“For the merchants from Kurukaccha who have set out seeking wealth,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:10.3", "PA_ja_463:10.4"], "en": "\"One who has lost his ship is called 'the one with the reed-garland.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:11.1"], "en": "Great is the fear, terrifying...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:11.2"], "en": "A human voice is heard;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:11.3"], "en": "like a precipitous abyss,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:11.4"], "en": "the ocean appears before one's eyes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:11.5"], "en": "“We ask you about Suppāraka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:11.6"], "en": "what ocean is this?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:12.1"], "en": "“For those who have set out from Kurukacchā,” [he replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:12.2"], "en": "For merchants seeking wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:12.3"], "en": "when their ship has gone astray,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:12.4"], "en": "it is called \"the mouth of the crocodile.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:13.1"], "en": "As far back as I can remember,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:13.2"], "en": "since I attained the state of discernment,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:13.3"], "en": "I do not recall ever intentionally—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:13.4"], "en": "Not even a single hand has been harmed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:13.5"], "en": "by this utterance of truth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:13.6"], "en": "may the ship return in safety.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:14.1"], "en": "The Suppāraka Jātaka, the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:15.1"], "en": "The Book of the Elevens is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:16.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:17.1"], "en": "The noble Naga Sirimātusuposaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:17.2", "PA_ja_463:17.3"], "en": "then the excellent Juṇhaka Dhammudaya, and furthermore Yudhañcayaka— these ten.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_463:17.4"], "en": "\"By one who has gone to the further shore of the restraint of the chariot,\" it is said.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
