[
{"segs": ["PA_ja_80:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_80:0.2"], "en": "The First Book,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_80:0.3"], "en": "The Chapter on Varuṇa", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_80:0.4"], "en": "10. The Bhīmasena Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_80:1.1", "PA_ja_80:1.2"], "en": "“That which you boasted of before, that now flows forth from you as putrid pus.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_80:1.3"], "en": "\"Both do not agree, Bhīmasena:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_80:1.4"], "en": "this talk of war and this distress of yours.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_80:2.1"], "en": "The Bhīmasena Jātaka, the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_80:2.2"], "en": "The eighth chapter is the Varuṇa-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_80:3.1"], "en": "Its summary verse (uddāna) is:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_80:4.1"], "en": "Varuṇa, Akataññū, Vara, Saccavara, and Tuvara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_80:4.2"], "en": "And by the roar of the lord of the thunderclouds;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_80:4.3"], "en": "by the compassion of the one who drew the stone-raft;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_80:4.4"], "en": "and again by the sweet sound of the *ḍiṇḍima* drum—thus [he was saved], ten times over.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
