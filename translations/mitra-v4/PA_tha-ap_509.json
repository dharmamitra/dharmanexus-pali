[
{"segs": ["PA_tha-ap_509:0.1", "PA_tha-ap_509:0.2", "PA_tha-ap_509:0.3"], "en": "The Legend of the Elder Ajeliphaladāyaka from the Kaṇikāra Chapter of the Therāpadāna, Number Seven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:1.1", "PA_tha-ap_509:1.2"], "en": "“The Fully Awakened One named Ajjuna then dwelt in the Himalayas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:1.3"], "en": "he was endowed with virtuous conduct.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:1.4"], "en": "The Sage, skilled in meditative concentration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:2.1", "PA_tha-ap_509:2.2"], "en": "took a vessel the size of a water-jar and washed a jīvajīvaka bird.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:2.3"], "en": "Taking a *chattapaṇṇa* leaf,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:2.4"], "en": "I gave it to the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:3.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:3.2"], "en": "The fruit that I gave back then—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:3.4"], "en": "this is the fruit of giving fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:4.1"], "en": "The defilements have been incinerated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:4.2", "PA_tha-ap_509:4.3"], "en": "…pe… I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:5.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:5.2", "PA_tha-ap_509:5.3"], "en": "[and so on] ...the teaching of the Buddha has been fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:6.1", "PA_tha-ap_509:6.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:6.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:7.1"], "en": "Thus indeed the venerable elder Ajeliphaladāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_509:8.1"], "en": "This is the seventh legend of the elder Ajeliphaladāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
