[
{"segs": ["PA_thag_4.9:0.1", "PA_thag_4.9:0.2"], "en": "Theragāthā 4.9 Catukkanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:0.4"], "en": "The Verses of the Elder Candana:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:1.1"], "en": "“Covered in gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:1.2"], "en": "surrounded by a retinue of female slaves;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:1.3", "PA_thag_4.9:1.4"], "en": "My wife approached me, carrying her son on her hip;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:2.1"], "en": "and seeing her coming toward me, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:2.2"], "en": "The mother of one who has a son,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:2.3"], "en": "adorned and well-dressed—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:2.4"], "en": "like a snare of Death laid out.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:3.1", "PA_thag_4.9:3.2"], "en": "Then right reflection arose in me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:3.3"], "en": "the danger became manifest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:3.4"], "en": "Through disenchantment, I became established in equanimity.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:4.1"], "en": "Then my mind was liberated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:4.2"], "en": "behold the excellence of the Dhamma!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:4.3"], "en": "“The three knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:4.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.9:4.5"], "en": "… Thus spoke the Elder Candana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
