[
{"segs": ["PA_tha-ap_123:0.1"], "en": "The *Therāpadāna*,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:0.2"], "en": "Sereyyavagga 1:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:0.3"], "en": "The *Apadāna* of the Elder Sereyyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:1.1"], "en": "“A reciter, a bearer of mantras,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:1.2"], "en": "one who has mastered the three Vedas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:1.3"], "en": "standing in the open air, being virtuous— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:1.4"], "en": "I saw the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:2.1"], "en": "like a lion roaming the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:2.2"], "en": "or like a fearless king of tigers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:2.3", "PA_tha-ap_123:2.4", "PA_tha-ap_123:3.1"], "en": "Having taken sereyyaka grass, [he approached] the Great Seer, who was like an elephant, a tusker with three-fold rut-fluid flowing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:3.2"], "en": "I cast it up into the sky;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:3.3"], "en": "by the Buddha’s majestic power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:3.4"], "en": "they surrounded it on all sides.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:4.1"], "en": "May the Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:4.2"], "en": "the Omniscient Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:4.3"], "en": "resolve that it be covered all over with flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:4.4"], "en": "They strewed [flowers] over the bull among men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:5.1"], "en": "Then that floral mantle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:5.2"], "en": "with its stalks inside and its opening outward;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:5.3"], "en": "Having created a covering for seven days,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:5.4"], "en": "they then vanished;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:6.1"], "en": "and having seen that marvel, [the people were amazed].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:6.2"], "en": "A marvel, hair-raising;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:6.3"], "en": "I gained confidence in the mind toward the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:6.4"], "en": "the Sugata, the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:7.1", "PA_tha-ap_123:7.2"], "en": "Urged on by that clarity of mind and that root of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:7.3"], "en": "for a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:7.4"], "en": "I did not fall into an evil rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:8.1", "PA_tha-ap_123:8.2"], "en": "For fifteen thousand aeons and twenty-five [thousand more], I did not go to a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:8.3"], "en": "Stainless and equanimous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:8.4"], "en": "they are wheel-turning monarchs of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:9.1"], "en": "the four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:9.2", "PA_tha-ap_123:9.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:9.4"], "en": "and the Buddha’s teaching has been fulfilled.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:10.1"], "en": "Thus indeed the venerable Elder Sereyyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_123:11.1"], "en": "This is the first legend of the Elder Sereyyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
