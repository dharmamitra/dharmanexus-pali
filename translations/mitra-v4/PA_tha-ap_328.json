[
{"segs": ["PA_tha-ap_328:0.1"], "en": "The Elder’s Apadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:0.2"], "en": "The Chapter on Umāpupphiya, No.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:0.3"], "en": "6. The Apadāna of the Elder Annasaṃsāvaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:1.1"], "en": "“The Perfectly Enlightened One, golden-hued,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:1.2", "PA_tha-ap_328:1.3"], "en": "resembling a priceless ornament of gold, was walking through the marketplace.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:1.4"], "en": "Possessing the thirty-two excellent marks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:2.1", "PA_tha-ap_328:2.2"], "en": "Siddhattha, the one for whom all aims are accomplished, the unshakable, the unconquered.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:2.3"], "en": "Having waited upon the Fully Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:2.4"], "en": "I fed that Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:3.1"], "en": "The Sage is compassionate toward the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:3.2"], "en": "It illuminated me at that time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:3.3"], "en": "having inspired confidence in my mind toward the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:3.4"], "en": "I rejoiced in heaven for an eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:4.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:4.2"], "en": "because of the gift I gave then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:4.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:4.4"], "en": "This is the fruit of giving almsfood:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:5.1", "PA_tha-ap_328:5.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:5.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:6.1"], "en": "Thus indeed did the elder Ānasaṃsāvaka recite these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_328:7.1"], "en": "This is the sixth legend of the elder Ānasaṃsāvaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
