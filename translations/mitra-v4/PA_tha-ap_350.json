[
{"segs": ["PA_tha-ap_350:0.1", "PA_tha-ap_350:0.2", "PA_tha-ap_350:0.3"], "en": "The Apadāna of the Elder Tiṇamuṭṭhidāyaka, from the Ekapadumiya Chapter, Number Eight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:1.1", "PA_tha-ap_350:1.2"], "en": "Not far from the Himālaya mountains is a mountain named Lambaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:1.3"], "en": "there dwells the Perfectly Enlightened One named Upatissa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:1.4"], "en": "I walked back and forth in the open air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:2.1", "PA_tha-ap_350:2.2"], "en": "At that time, I was a deer-hunter in the forest grove.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:2.3"], "en": "Having seen that God of Gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:2.4"], "en": "the Self-Existent One, the Unconquered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:3.1"], "en": "with a mind full of serene confidence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:3.2", "PA_tha-ap_350:3.3"], "en": "Then, for the sake of a seat for that Great Seer, the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:3.4"], "en": "I offered him a handful of grass.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:4.1"], "en": "Having given to the God of Gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:4.2"], "en": "I further gladdened my heart;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:4.3"], "en": "having paid homage to the Perfectly Enlightened One, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:4.4"], "en": "I set out facing north.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:5.1"], "en": "Not long after I had departed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:5.2"], "en": "the king of beasts tore me apart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:5.3"], "en": "Having been struck by a lion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:5.4"], "en": "I died right there;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:6.1"], "en": "the deed was committed in my very presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:6.2"], "en": "To the Best of Buddhas, free from taints;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:6.3"], "en": "like an arrow released from a bow,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:6.4"], "en": "I went to the world of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:7.1"], "en": "There stood a beautiful sacrificial post,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:7.2"], "en": "fashioned by meritorious deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:7.3"], "en": "with a thousand branches and a hundred tiers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:7.4"], "en": "His banner is green and full of radiance;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:8.1", "PA_tha-ap_350:8.2"], "en": "his light streams forth like the risen sun with its thousand rays.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:8.3"], "en": "Surrounded by celestial maidens,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:8.4"], "en": "I rejoiced, indulging in every desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:9.1"], "en": "Then, having fallen from the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:9.2"], "en": "Urged on by the root of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:9.3"], "en": "having come to human birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:9.4"], "en": "I have attained the destruction of the taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:10.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:10.2"], "en": "I gave a seat;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:10.3"], "en": "I do not recall being born in an unhappy state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:10.4"], "en": "This is the fruit of a handful of grass.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:11.1", "PA_tha-ap_350:11.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:11.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:12.1"], "en": "Thus indeed did the venerable elder Tiṇamuṭṭhidāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_350:13.1"], "en": "This is the eighth legend of the elder Tiṇamuṭṭhidāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
