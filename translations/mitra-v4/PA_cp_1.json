[
{"segs": ["PA_cp_1:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:0.2"], "en": "Akittivagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:0.3"], "en": "Dānapāramī 1", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:0.4"], "en": "The Conduct of Akitti.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:1.1"], "en": "Homage to that Blessed One, the Worthy One, the Perfectly Self-Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:2.1"], "en": "“For a hundred thousand aeons...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:2.2"], "en": "And for four incalculable eons;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:2.3"], "en": "whatever conduct was practiced during that interval,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:2.4"], "en": "all of it ripened into enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:3.1", "PA_cp_1:3.2"], "en": "Having set aside the conduct throughout past aeons across various states of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:3.3"], "en": "[I shall relate] the conduct in this present aeon.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:3.4"], "en": "I shall speak; listen to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:4.1", "PA_cp_1:4.2"], "en": "When I was in the great forest, in that empty woodland grove;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:4.3", "PA_cp_1:4.4"], "en": "Having plunged [into the water], I dwell there as an ascetic named Akitti; then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:5.1"], "en": "by the power of my ascetic heat, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:5.2"], "en": "The Conqueror of the Three Realms,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:5.3"], "en": "appearing in the guise of a brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:5.4"], "en": "approached me for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:6.1"], "en": "Seeing a leaf brought by the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:6.2"], "en": "without oil and without salt,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:6.3"], "en": "standing at my door, I said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:6.4"], "en": "I covered it with a cooking pot.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:7.1", "PA_cp_1:7.2"], "en": "Having given him the leaf and turned the vessel upside down, I said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:7.3"], "en": "Having abandoned the search for food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:7.4"], "en": "I entered the leaf-hut;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:8.1"], "en": "a second time, and a third time as well.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:8.2"], "en": "He approached me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:8.3"], "en": "unshaken and unattached,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:8.4"], "en": "I spoke to him in this very way.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:9.1", "PA_cp_1:9.2"], "en": "On account of that, there was no discolouration in my body;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:9.3"], "en": "through rapture and bliss, I rejoiced.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:9.4"], "en": "I pass that day;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:10.1", "PA_cp_1:10.2"], "en": "if I were to obtain a worthy recipient of offerings for even a month or two months, [I would pass it].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:10.3"], "en": "Unshaken and unattached,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:10.4"], "en": "one should give the supreme gift.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:11.1"], "en": "While giving that gift, one does not...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:11.2"], "en": "I aspired for fame and gain;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:11.3"], "en": "aspiring to omniscience,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:11.4"], "en": "I performed those deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_1:12.1"], "en": "The first is the conduct of Akitti.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
