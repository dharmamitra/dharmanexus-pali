[
{"segs": ["PA_tha-ap_450:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:0.2"], "en": "The Chapter on the Vibhītaka Tree, 8.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:0.3"], "en": "The Apadāna of the Elder Pādapīṭhiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:1.1"], "en": "“The Perfectly Enlightened One named Sumedha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:1.2"], "en": "the supreme, compassionate Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:1.3"], "en": "having delivered many beings,...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:1.4"], "en": "That one of great renown has attained Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:2.1", "PA_tha-ap_450:2.2"], "en": "Around the lion throne of the Great Sage Sumedha—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:2.3"], "en": "With a clear heart and a joyful mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:2.4"], "en": "I had a footstool made.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:3.1"], "en": "Having performed this wholesome deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:3.2"], "en": "Having a pleasant ripening and a pleasant outcome,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:3.3"], "en": "joined with meritorious karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:3.4"], "en": "I went to the Tāvatiṃsa heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:4.1"], "en": "While I was dwelling there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:4.2"], "en": "endowed with meritorious deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:4.3"], "en": "as I was lifting my feet, ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:4.4"], "en": "They have golden seats for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:5.1"], "en": "It is a gain for them, it is well-acquired by you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:5.2"], "en": "who obtain the opportunity to overhear [the Dhamma].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:5.3"], "en": "Having performed service for those who have attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:5.4"], "en": "they obtain vast happiness. By me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:6.1"], "en": "too, well-performed karma was done.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:6.2"], "en": "Through well-applied trade,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:6.3"], "en": "having fashioned a footstool,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:6.4"], "en": "I obtained a golden throne.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:7.1", "PA_tha-ap_450:7.2"], "en": "Whichever direction I set out toward for whatever purpose,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:7.3"], "en": "I tread upon a golden seat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:7.4"], "en": "This is the fruit of a meritorious deed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:8.1", "PA_tha-ap_450:8.2"], "en": "That karma which I performed back then, thirty thousand aeons ago;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:8.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:8.4"], "en": "this is the fruit of the footstool.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:9.1"], "en": "The defilements have been burnt away by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:9.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:9.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:10.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:10.2", "PA_tha-ap_450:10.3"], "en": "... [as before] ... the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:11.1"], "en": "The four analytical knowledges (paṭisambhidā) have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:11.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:11.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:12.1"], "en": "Thus indeed did the Venerable Elder Pādapīṭhiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_450:13.1"], "en": "The legend of the Elder Pādapīṭhiya is the eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
