[
{"segs": ["PA_ja_336:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:0.2", "PA_ja_336:0.3"], "en": "Catukkanipāta, Kokilavagga (The Chapter on the Cuckoo)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:0.4", "PA_ja_336:1.1"], "en": "6. The Brahāchatta Jātaka “You speak of ‘grass, grass,’ but who indeed has brought you grass?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:1.2"], "en": "Who has spread this canopy for you?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:1.3", "PA_ja_336:1.4"], "en": "\"What need have you for grass that you speak only of grass?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:2.1"], "en": "\"A practitioner of the holy life has come here.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:2.2", "PA_ja_336:2.3"], "en": "The tall one, the one with the parasol, the one of great learning—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:2.4"], "en": "he takes all of that from me and goes away, leaving behind only the grass.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:3.1", "PA_ja_336:3.2"], "en": "“Thus it is that much should be done with little by one who desires the great;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:3.3"], "en": "all of one’s own acquisitions— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:3.4"], "en": "\"Non-grasping even at grass.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:4.1"], "en": "\"The virtuous do not do it;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:4.2"], "en": "the fool does the deeds of virtue.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:4.3"], "en": "“Impermanence is a state of immorality;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:4.4"], "en": "what wisdom will it bring?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_336:5.1"], "en": "Thus ends the sixth Jātaka, the Brahāchatta Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
