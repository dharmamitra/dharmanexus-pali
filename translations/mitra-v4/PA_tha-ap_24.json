[
{"segs": ["PA_tha-ap_24:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:0.2"], "en": "Subhūti Chapter 2:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:0.3"], "en": "The Apadāna of the Elder Upavāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:1.2"], "en": "who had gone beyond all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:1.3"], "en": "having blazed like a mass of fire— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:1.4"], "en": "The Perfectly Enlightened One has attained final Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:2.1"], "en": "The great multitude, having gathered together,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:2.2"], "en": "paid homage to the Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:2.3"], "en": "Having performed the funeral rites well,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:2.4"], "en": "they placed the body [on the pyre].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:3.1"], "en": "Having completed the duties for the body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:3.2"], "en": "They gathered the relics there; all beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:3.3"], "en": "including gods and humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:3.4"], "en": "constructed that stupa for the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:4.1"], "en": "The first was made of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:4.2"], "en": "the second was made of jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:4.3"], "en": "and the third was made of silver.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:4.4"], "en": "The fourth was made of crystal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:5.1", "PA_tha-ap_24:5.2"], "en": "Likewise, the fifth stage was made of ruby.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:5.3"], "en": "The sixth was made of masāragalla stone,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:5.4", "PA_tha-ap_24:6.1"], "en": "and above it was a crest made of all kinds of jewels; his shanks were made of gems.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:6.2"], "en": "The railing was made of jewels;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:6.3"], "en": "the stupa was made entirely of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:6.4"], "en": "rising a yojana in height.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:7.1"], "en": "Then the devas, having gathered there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:7.2"], "en": "deliberated together:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:7.3"], "en": "\"We too shall build a stupa.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:7.4"], "en": "Of the Protector of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:8.1"], "en": "the Tathāgata, there are no separate relics;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:8.2"], "en": "his body is a single solid mass.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:8.3"], "en": "At this stupa of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:8.4"], "en": "we shall offer a robe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:9.1"], "en": "O devas, with the seven jewels!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:9.2"], "en": "They increased another yojana;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:9.3", "PA_tha-ap_24:9.4"], "en": "the stupa rose two yojanas high and dispelled the darkness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:10.1"], "en": "Then the nāgas, having assembled there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:10.2", "PA_tha-ap_24:10.3"], "en": "deliberated together with both humans and gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:10.4"], "en": "They built a stupa for the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:11.1"], "en": "\"May we not be heedless;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:11.2"], "en": "may we be heedful, together with the devas.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:11.3"], "en": "We too shall build a stupa for the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:11.4"], "en": "the Lord of the World—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:12.1"], "en": "using indranīla and mahānīla gems.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:12.2", "PA_tha-ap_24:12.3"], "en": "Then, having brought together the jewel that was like a light on one side,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:12.4"], "en": "they covered the Buddha’s stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:13.1", "PA_tha-ap_24:13.2"], "en": "The entire Buddha-cetiya was made of jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:13.3"], "en": "rising three yojanas high.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:13.4"], "en": "Then there was the making of light.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:14.1"], "en": "And the garuḷas, having assembled together,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:14.2"], "en": "then deliberated among themselves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:14.3", "PA_tha-ap_24:14.4"], "en": "Humans, gods, and nāgas built that stupa for the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:15.1"], "en": "\"May we not be heedless! they thought.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:15.2"], "en": "\"Being diligent, O you who include the devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:15.3"], "en": "we too shall build a stupa for the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:15.4"], "en": "the Protector of the World.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:16.1", "PA_tha-ap_24:16.2"], "en": "They made the entire stupa out of jewels and covered it with a casing;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:16.3"], "en": "they even increased its size by a yojana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:16.4"], "en": "The Buddha’s cetiya is long;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:17.1", "PA_tha-ap_24:17.2"], "en": "the Buddha’s stupa, four yojanas in height, shines forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:17.3", "PA_tha-ap_24:17.4"], "en": "He illuminates all directions like the risen sun with its hundred rays;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:18.1"], "en": "and the kumbhaṇḍas, having gathered together, [approach].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:18.2", "PA_tha-ap_24:18.3", "PA_tha-ap_24:18.4"], "en": "Then humans, gods, nāgas, and likewise garuḷas, deliberated together on one side.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:18.5", "PA_tha-ap_24:18.6"], "en": "They constructed a supreme stupa for the Best of Pratyekabuddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:19.1"], "en": "\"May we not be heedless! they thought.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:19.2"], "en": "\"Being diligent, O you who include the devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:19.3"], "en": "we too shall build a stupa for the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:19.4"], "en": "the Lord of the World.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:19.5", "PA_tha-ap_24:19.6"], "en": "\"We shall cover the long Buddha-cetiya with jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:20.1"], "en": "They increased it by another yojana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:20.2"], "en": "The Buddha’s cetiya was long;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:20.3", "PA_tha-ap_24:20.4"], "en": "a stupa five yojanas high then shone forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:21.1"], "en": "Then the yakkhas, having gathered there together,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:21.2"], "en": "consulted with one another;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:21.3"], "en": "so too did the humans, the devas, and the nāgas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:21.4", "PA_tha-ap_24:22.1", "PA_tha-ap_24:22.2"], "en": "The Garuḷas and Kumbhaṇḍas erected a supreme stūpa for the most excellent Pratyekabuddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:22.3"], "en": "\"Let us not be heedless;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:22.4"], "en": "let us be heedful together with the devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:23.1"], "en": "We too shall build a stupa.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:23.2", "PA_tha-ap_24:23.3", "PA_tha-ap_24:23.4"], "en": "We shall cover the long Buddha-cetiya of the Lord of the World, the Tathāgata, with crystals.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:24.1", "PA_tha-ap_24:24.2"], "en": "They increased the length of the Buddha’s cetiya by one yojana;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:24.3"], "en": "it rose six yojanas high.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:24.4"], "en": "Then the stupa shone with radiance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:25.1"], "en": "And the gandhabbas, having gathered together,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:25.2"], "en": "then deliberated among themselves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:25.3"], "en": "Humans, deities, nāgas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:25.4"], "en": "garuḷas, and kumbha-yakkhas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:26.1"], "en": "all together honored the stupa of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:26.2"], "en": "\"We ourselves are not the ones who built it here;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:26.3"], "en": "we too shall build a stupa for the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:26.4"], "en": "the Lord of the World.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:27.1"], "en": "Having constructed seven terraces,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:27.2"], "en": "they raised a parasol;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:27.3"], "en": "the stupa was made entirely of gold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:27.4"], "en": "Then the Gandhabbas constructed it. At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:28.1"], "en": "the stupa, rising seven yojanas high,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:28.2"], "en": "shone brilliantly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:28.3"], "en": "Day and night are not distinguished;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:28.4"], "en": "there is light at all times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:29.1"], "en": "His radiance overcomes [all else].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:29.2"], "en": "The moon, the sun, and the stars—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:29.3"], "en": "within a hundred leagues on all sides—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:29.4"], "en": "not even a lamp shone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:30.1", "PA_tha-ap_24:30.2", "PA_tha-ap_24:30.3"], "en": "At that time, whatever humans were worshipping the stupa did not climb up onto the stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:30.4"], "en": "They toss them up into the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:31.1"], "en": "A yakkha appointed by the devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:31.2"], "en": "named Abhisammata;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:31.3"], "en": "Whether it be a banner or a flower garland,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:31.4"], "en": "they offer it above;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:32.1"], "en": "yet those beings do not see that yakkha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:32.2"], "en": "They see the one who goes with a rope;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:32.3"], "en": "seeing thus as they go,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:32.4"], "en": "all go to a happy destination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:33.1"], "en": "Those who are hostile toward the Word,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:33.2"], "en": "those who have faith in the Teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:33.3"], "en": "and those who desire to see a miracle—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:33.4"], "en": "Humans worship the stupa. At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:34.1"], "en": "in the city of Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:34.2"], "en": "I was a hired laborer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:34.3"], "en": "Seeing the people delighted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:34.4"], "en": "I then thought thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:35.1"], "en": "\"Exalted indeed is this Blessed One!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:35.2"], "en": "For one who carries such a nature as this,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:35.3"], "en": "these people are delighted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:35.4"], "en": "yet they do not tire of performing services.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:36.1", "PA_tha-ap_24:36.2"], "en": "I too shall perform service for the Protector of the World, the Tathāgata;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:36.3"], "en": "may I become an heir to his Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:36.4"], "en": "\"I shall be so in the future.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:37.1", "PA_tha-ap_24:37.2"], "en": "My upper garment had been washed by a laundryman until it was perfectly clean.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:37.3"], "en": "Having fastened it to the top of a bamboo pole,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:37.4"], "en": "I raised the banner aloft in the sky. Then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:38.1"], "en": "being highly esteemed, I took hold of it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:38.2"], "en": "My banner was in the sky;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:38.3"], "en": "seeing the banner stirred by the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:38.4"], "en": "I produced even greater laughter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:39.1"], "en": "Having inspired confidence there in my mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:39.2"], "en": "I approached the ascetic;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:39.3"], "en": "having paid homage to that bhikkhu, I...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:39.4"], "en": "\"I asked about the ripening [of karma], O Dhaja;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:40.1"], "en": "he explained it to me, Ānanda,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:40.2"], "en": "producing joy within me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:40.3", "PA_tha-ap_24:40.4"], "en": "“You shall always experience the ripening of that banner:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:41.1"], "en": "elephants, horses, chariots, and infantry.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:41.2", "PA_tha-ap_24:41.3"], "en": "And a fourfold army shall constantly attend upon you;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:41.4"], "en": "this is the fruit of the gift of a banner.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:42.1", "PA_tha-ap_24:42.2", "PA_tha-ap_24:42.3"], "en": "Sixty thousand musical instruments and well-adorned drums will constantly attend upon you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:42.4"], "en": "This is the fruit of the gift of a banner:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:43.1"], "en": "eighty-six thousand women,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:43.2"], "en": "beautifully adorned.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:43.3"], "en": "Adorned with various garments and ornaments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:43.4"], "en": "wearing jeweled earrings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:44.1"], "en": "with long, reddish-brown eyes and a smiling face.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:44.2"], "en": "Well-proportioned and slender-waisted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:44.3"], "en": "they shall always attend upon you;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:44.4"], "en": "this is the fruit of giving a banner.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:45.1", "PA_tha-ap_24:45.2"], "en": "For thirty thousand aeons you will delight in the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:45.3"], "en": "eighty times you will be the lord of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:45.4"], "en": "You shall exercise sovereignty as a king of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:46.1", "PA_tha-ap_24:46.2"], "en": "and a thousand times you shall become a universal monarch (cakravartin).", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:46.3"], "en": "A vast regional kingship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:46.4"], "en": "beyond counting—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:47.1"], "en": "throughout one hundred thousand eons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:47.2"], "en": "Born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:47.3", "PA_tha-ap_24:47.4"], "en": "he whose family name is Gotama will become a teacher in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:48.1"], "en": "Having passed away from the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:48.2", "PA_tha-ap_24:48.3"], "en": "impelled by the root of purity and endowed with meritorious deeds, he descended.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:48.4"], "en": "\"You will become a mere Brahmin by name.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:49.1"], "en": "Having abandoned eighty crores [of wealth],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:49.2"], "en": "you will have many slaves and laborers.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:49.3", "PA_tha-ap_24:49.4"], "en": "You shall go forth in the teaching of the Blessed One Gotama;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:50.1"], "en": "having gratified the Perfectly Awakened One, you will attain the goal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:50.2"], "en": "\"To Gotama, the bull of the Sakyas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:50.3"], "en": "by the name Upavāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:50.4"], "en": "you shall become a disciple of the Teacher.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:51.1", "PA_tha-ap_24:51.2"], "en": "The karma performed a hundred thousand eons ago has shown its fruit to me here;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:51.3"], "en": "like an arrow released from a bow, I am completely liberated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:51.4"], "en": "He extinguished my defilements.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:52.1"], "en": "While I was a wheel-turning monarch,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:52.2"], "en": "the sovereign of the four continents;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:52.3"], "en": "For three yojanas all around,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:52.4"], "en": "banners always stand erect;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:53.1"], "en": "for a hundred thousand kalpas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:53.2"], "en": "Whatever deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:53.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:53.4"], "en": "this is the fruit of the gift of a banner.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:54.1"], "en": "The four analytical knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:54.2"], "en": "these eight liberations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:54.3"], "en": "and the six direct knowledges have been realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:54.4"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:55.1"], "en": "In this way, it is said, the venerable elder Upavāna recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_24:56.1"], "en": "This is the second apadāna of the elder Upavāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
