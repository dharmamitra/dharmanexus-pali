        "folio": "1",
        "suttacentral_link": "https://suttacentral.net/mil7.6.8/pli/ms#1.1"
    },
    {
        "segmentnr": "PA_mil_7.6.8:1.2",
        "original": "“Yathā, mahārāja, jalūkā yattha allīyati, tattheva daḷhaṁ allīyitvā ruhiraṁ pivati;",
