[
{"segs": ["PA_ja_366:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:0.2", "PA_ja_366:0.3"], "en": "The Fifth Collection (Pañcakanipāta), Chapter on the Description of Physical Beauty (Vaṇṇārohavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:0.4", "PA_ja_366:1.1"], "en": "6. The Gumbiya Jātaka “There was poison that had the color of honey,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:1.2"], "en": "the taste of honey, and the scent of honey.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:1.3"], "en": "Gumbiya, seeking fodder,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:1.4"], "en": "dropped poison in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:2.1"], "en": "thinking it was honey.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:2.2", "PA_ja_366:2.3"], "en": "Those who ate that poison found it bitter; through it,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:2.4"], "en": "they met their death.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:3.1", "PA_ja_366:3.2"], "en": "But those who, having reflected, avoid that poison—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:3.3"], "en": "they are happy amidst the afflicted.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:3.4"], "en": "While others are burning, they are extinguished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:4.1"], "en": "Even so among humans,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:4.2"], "en": "the poison of sensual desires has settled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:4.3"], "en": "This bait is a bond, appearing in the guise of death,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:4.4"], "en": "dwelling within the cave of the heart;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:5.1"], "en": "even so are these sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:5.2", "PA_ja_366:5.3"], "en": "Those who always avoid women, who are like attendants to the sick,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:5.4"], "en": "have transcended attachment in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_366:6.1"], "en": "The Gumbiya Jātaka is the sixth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
