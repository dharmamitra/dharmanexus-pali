[
{"segs": ["PA_thag_6.4:0.1", "PA_thag_6.4:0.2", "PA_thag_6.4:0.3"], "en": "Theragāthā 6.4 Chakkanipāta Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:0.4"], "en": "The Verses of the Elder Kulla:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:1.1"], "en": "“Kulla, having gone to a charnel ground,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:1.2"], "en": "saw a woman abandoned there.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:1.3"], "en": "Cast away in the charnel ground,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:1.4"], "en": "being devoured by worms, covered in sores,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:2.1"], "en": "afflicted, impure, and putrid—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:2.2"], "en": "Behold this body, O Kulla,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:2.3"], "en": "a collection of sores, oozing and trickling,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:2.4"], "en": "which fools delight in.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:3.1", "PA_thag_6.4:3.2"], "en": "Having taken up the mirror of the Dhamma for the attainment of knowledge and vision,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:3.3"], "en": "I reflected upon this body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:3.4"], "en": "Empty within and without.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:4.1", "PA_thag_6.4:4.2"], "en": "As this is, so is that; as that is, so is this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:4.3", "PA_thag_6.4:4.4"], "en": "As below, so above; as above, so below.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:5.1"], "en": "As by day, so by night; as by night, so by day.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:5.2"], "en": "As by night, so by day;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:5.3", "PA_thag_6.4:5.4"], "en": "as before, so after; as after, so before.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:6.1", "PA_thag_6.4:6.2", "PA_thag_6.4:6.3"], "en": "There is no such delight from the fivefold musical ensemble as that which comes to one whose mind is one-pointed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:6.4"], "en": "“For one who clearly sees the Dhamma with right insight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.4:6.5"], "en": "… The Elder Kulla … said this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
