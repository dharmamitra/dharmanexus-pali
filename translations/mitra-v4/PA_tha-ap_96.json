[
{"segs": ["PA_tha-ap_96:0.1", "PA_tha-ap_96:0.2", "PA_tha-ap_96:0.3"], "en": "The Apadāna of the Elder Sūcidāyaka Sudhāvagga 4. Sūcidāyakattheraapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:1.1", "PA_tha-ap_96:1.2"], "en": "“In the past, in the most excellent city of Bandhumatī, I was a smith.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:1.3"], "en": "Pure gifts were given by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:1.4"], "en": "For the Great Seer Vipassi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:2.1", "PA_tha-ap_96:2.2"], "en": "wisdom equal to the tip of a diamond arises in accordance with his karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:2.3"], "en": "I am dispassionate, I am liberated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:2.4"], "en": "I have attained the destruction of the taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:3.1"], "en": "And regarding all past existences—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:3.2"], "en": "Whether present or future,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:3.3"], "en": "I have scrutinized it all with wisdom:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:3.4"], "en": "this is the fruit of giving a needle.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:4.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:4.2"], "en": "there were those called Vajira,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:4.3"], "en": "endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:4.4"], "en": "Universal monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:5.1", "PA_tha-ap_96:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:5.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:6.1"], "en": "Thus indeed did the venerable Elder Sūcidāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_96:7.1"], "en": "This is the fourth legend (apadāna) of the Elder Sūcidāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
