[
{"segs": ["PA_snp_5.11:0.1", "PA_snp_5.11:0.2", "PA_snp_5.11:1.1"], "en": "Sutta Nipāta 5.11 Kappamāṇavapucchā “Standing in the midst of the flood, ... [the one who does not sink]”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:1.2"], "en": "(Thus spoke the Venerable Kappa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:1.3"], "en": "When the flood has arisen, full of great terror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:1.4"], "en": "for those overcome by old age and death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:1.5"], "en": "Speak of an island, dear sir;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:1.6"], "en": "you yourself explain an island to me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:1.7"], "en": "such that there may be no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:2.1"], "en": "“Standing in the middle of the lake,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:2.2"], "en": "O Kappa,” said the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:2.3"], "en": "“when a flood has arisen and there is great terror.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:2.4", "PA_snp_5.11:2.5"], "en": "I declare you to be an island for those overcome by old age and death;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:3.1"], "en": "one who possesses nothing and grasps at nothing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:3.2"], "en": "This is the island,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:3.3"], "en": "there is no other; I call it Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:3.4"], "en": "the utter destruction of old age and death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:4.1", "PA_snp_5.11:4.2", "PA_snp_5.11:4.3"], "en": "Having understood this, those who are mindful and have attained final Nibbāna in this very life do not fall under the power of Māra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:4.4"], "en": "“They are not followers of Māra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.11:4.5"], "en": "This is the tenth inquiry of Kappa the young brahmin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
