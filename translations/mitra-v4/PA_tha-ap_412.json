[
{"segs": ["PA_tha-ap_412:0.1", "PA_tha-ap_412:0.2", "PA_tha-ap_412:0.3"], "en": "The Apadāna of the Elder Udena Metteyyavagga 10. Udenattheraapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:1.1", "PA_tha-ap_412:1.2"], "en": "\"Not far from the Himālaya is a mountain named Paduma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:1.3"], "en": "there my well-constructed hermitage is located.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:1.4"], "en": "A leaf-hut was well-constructed there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:2.1", "PA_tha-ap_412:2.2"], "en": "where rivers flow with beautiful landing-stairs and are delightful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:2.3", "PA_tha-ap_412:2.4"], "en": "The rivers always flow with clear water and cool currents;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:3.1"], "en": "there are *pāṭhīna* and *pāvusa* fish.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:3.2"], "en": "Balajas, muñjas, and rohitas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:3.3", "PA_tha-ap_412:3.4"], "en": "these adorn the rivers and dwell there forever.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:4.1"], "en": "Covered with mango and rose-apple trees,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:4.2"], "en": "as well as kareri and tilaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:4.3"], "en": "uddālaka and pāṭali trees.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:4.4"], "en": "They beautify my hermitage:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:5.1"], "en": "the aṅkolaka trees, the bimbi-jāla trees,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:5.2"], "en": "and the māyākārī in full bloom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:5.3"], "en": "Fragrant with their scent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:5.4"], "en": "they beautify my hermitage—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:6.1"], "en": "the atimuttā and sattalika flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:6.2"], "en": "The *nāga* trees and the *sāla* trees are in bloom;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:6.3"], "en": "wafting a divine fragrance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:6.4"], "en": "they beautify my hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:7.1"], "en": "The *kosamba*, *saḷala*, and *nīpa* trees,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:7.2"], "en": "as well as the *aṭṭhaṅga*, were all in bloom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:7.3"], "en": "wafting a divine fragrance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:7.4"], "en": "They beautify my hermitage:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:8.1"], "en": "harītaka, āmalaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:8.2"], "en": "mango, jambu, and vibhītaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:8.3"], "en": "Kolā, bhallātakas, and bilvas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:8.4"], "en": "many such fruits were there in the hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:9.1"], "en": "kalambas and kandalīs were found there as well.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:9.2"], "en": "They blossom in my hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:9.3"], "en": "wafting a divine fragrance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:9.4"], "en": "they beautify my hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:10.1", "PA_tha-ap_412:10.2"], "en": "The *asokapiṇḍī* trees and the *nimba* trees are in bloom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:10.3"], "en": "wafting a divine fragrance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:10.4"], "en": "They beautify my hermitage:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:11.1"], "en": "the punnāgas, the giripunnāgas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:11.2"], "en": "and the timira trees are in full bloom there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:11.3"], "en": "Exuding a divine fragrance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:11.4"], "en": "they beautify my hermitage:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:12.1"], "en": "the nigguṇḍī and the sirinigguṇḍī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:12.2"], "en": "The campaka trees here are in full bloom;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:12.3"], "en": "wafting a divine fragrance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:12.4"], "en": "they beautify my hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:13.1"], "en": "Not far away was a lotus pond,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:13.2", "PA_tha-ap_412:13.3"], "en": "resounding with the cries of ruddy geese and covered with mandālaka flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:13.4"], "en": "And with lotuses and water-lilies.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:14.1"], "en": "With clear water, cool and refreshing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:14.2"], "en": "they have excellent landing-stairs and are enchanting.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:14.3"], "en": "Clear and like crystals,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:14.4"], "en": "they beautify my hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:15.1"], "en": "lotuses bloom there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:15.2"], "en": "The white lotuses and blue water-lilies,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:15.3"], "en": "covered with mandārava flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:15.4"], "en": "beautify my hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:16.1"], "en": "Pāṭhīna fish, pāvusa fish,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:16.2"], "en": "balaja fish, muñja fish, and rohita fish—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:16.3"], "en": "these were wandering about there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:16.4"], "en": "They beautify my hermitage:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:17.1"], "en": "crocodiles, sharks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:17.2"], "en": "tortoises, and many water-monsters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:17.3", "PA_tha-ap_412:17.4"], "en": "Ogaha serpents and pythons adorn my hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:18.1"], "en": "so too do pigeons and ruddy geese.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:18.2"], "en": "Cakravāka ducks that frequent the river,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:18.3"], "en": "as well as dindibha birds and sālika thrushes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:18.4"], "en": "grace my hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:19.1"], "en": "Nayitā and Ambagandhī trees,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:19.2"], "en": "and Ketakas blooming there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:19.3"], "en": "wafting a divine fragrance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:19.4"], "en": "They beautify my hermitage:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:20.1"], "en": "lions, tigers, leopards,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:20.2"], "en": "bears, hyenas, and jackals.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:20.3"], "en": "Wandering through the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:20.4"], "en": "they beautify my hermitage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:21.1"], "en": "burdened as they are with their mass of matted hair.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:21.2"], "en": "Clad in upper garments of antelope skin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:21.3", "PA_tha-ap_412:21.4"], "en": "they wander through the forest and beautify my hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:22.1", "PA_tha-ap_412:22.2"], "en": "These wearers of antelope skins are prudent and live in peace;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:22.3"], "en": "they are all indeed moderate in their food.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:22.4"], "en": "They beautify my hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:23.1"], "en": "Having taken up a load of a khāri measure,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:23.2"], "en": "they then plunged deep into the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:23.3"], "en": "Eating roots and fruits,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:23.4"], "en": "they then dwelt in the hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:24.1"], "en": "they did not fetch wood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:24.2"], "en": "Water for washing the feet—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:24.3"], "en": "for all these things, by their own majestic power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:24.4"], "en": "are brought forth spontaneously.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:25.1", "PA_tha-ap_412:25.2"], "en": "Eighty-four thousand seers have gathered here;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:25.3"], "en": "all of them are practitioners of meditation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:25.4"], "en": "Seekers of the supreme goal,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:26.1"], "en": "ascetics living the holy life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:26.2"], "en": "they are indeed reprovers of themselves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:26.3", "PA_tha-ap_412:26.4"], "en": "Then all those who dwell in the sky-roving realm lived in that hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:27.1"], "en": "they would assemble there for five days.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:27.2"], "en": "One-pointed and living in peace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:27.3"], "en": "having paid homage to one another,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:27.4"], "en": "they depart toward their respective directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:28.1"], "en": "The Conqueror named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:28.2"], "en": "who has gone to the further shore of all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:28.3"], "en": "dispelled that darkness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:28.4"], "en": "At that very moment, the Conqueror appeared.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:29.1"], "en": "Near my hermitage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:29.2"], "en": "there was a yakkha of great psychic power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:29.3"], "en": "Thus I praised the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:29.4"], "en": "the supreme leader of those born from the water:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:30.1"], "en": "“This Buddha has arisen.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:30.2"], "en": "\"Padumuttara, the Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:30.3"], "en": "having gone quickly to the Perfectly Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:30.4"], "en": "he attended upon him, O Noble One.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:31.1"], "en": "Having heard the words of the yakkha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:31.2"], "en": "with a mind full of serene confidence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:31.3"], "en": "he set the hermitage in order.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:31.4"], "en": "I then departed from the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:32.1", "PA_tha-ap_412:32.2"], "en": "Having emerged from the hermitage while my very clothes were still burning, I went forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:32.3"], "en": "Having dressed for one night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:32.4"], "en": "I approached the Leader,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:33.1"], "en": "Padumuttara, the Knower of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:33.2"], "en": "The recipient of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:33.3", "PA_tha-ap_412:33.4"], "en": "he proclaimed the Four Noble Truths and taught the state of deathlessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:34.1", "PA_tha-ap_412:34.2"], "en": "Having taken a full-blown lotus and approached the Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:34.3"], "en": "with a clear mind and joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:34.4"], "en": "I offered it to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:35.1"], "en": "Having worshipped the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:35.2"], "en": "the supreme leader of those born from the water;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:35.3"], "en": "Arranging my deerskin robe to one side,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:35.4"], "en": "I praised the Leader of the World:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:36.1"], "en": "“By whatever knowledge the Sambuddha [attained],”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:36.2"], "en": "He dwells here free from taints;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:36.3"], "en": "I shall proclaim that knowledge—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:36.4"], "en": "listen to me as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:37.1"], "en": "Having cut the stream of saṃsāra,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:37.2"], "en": "you have enabled all living beings to cross over;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:37.3"], "en": "having heard your Dhamma, they have done so.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:37.4"], "en": "They cross over the stream of craving.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:38.1"], "en": "You are the teacher and the banner,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:38.2"], "en": "the standard and the sacrificial post for living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:38.3"], "en": "The ultimate refuge, the foundation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:38.4"], "en": "and the island, O supreme among bipeds;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:39.1"], "en": "as far as there are leaders of groups in the world—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:39.2"], "en": "They are called caravan-leaders; you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:39.3"], "en": "O Omniscient One, are the foremost,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:39.4"], "en": "for they are all contained within you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:40.1"], "en": "Through your wisdom, O All-Knowing One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:40.2"], "en": "you have delivered many people;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:40.3"], "en": "having come to your vision, they are saved.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:40.4"], "en": "They will make an end of suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:41.1", "PA_tha-ap_412:41.2"], "en": "Whatever kinds of fragrances there are that blow in the world, O Visionary One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:41.3"], "en": "There is nothing equal to your fragrance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:41.4"], "en": "O Great Sage, in this field of merit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:42.1"], "en": "[Even] the animal realm and hell...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:42.2"], "en": "The One with Vision has brought about liberation;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:42.3", "PA_tha-ap_412:42.4"], "en": "you, O Great Sage, have taught the unconditioned, peaceful state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:43.1"], "en": "Padumuttara, the knower of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:43.2"], "en": "the recipient of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:43.3"], "en": "sat within the community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:43.4"], "en": "He spoke these verses: “He who,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:44.1", "PA_tha-ap_412:44.2"], "en": "with faith, honored my knowledge with his own hands;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:44.3"], "en": "I shall proclaim that;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:44.4"], "en": "listen as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:45.1"], "en": "For thirty thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:45.2"], "en": "He will delight in the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:45.3", "PA_tha-ap_412:45.4"], "en": "and a thousand times he will become a wheel-turning monarch.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:46.1"], "en": "I have gained a gain well-gained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:46.2"], "en": "having satisfied the one of excellent vows;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:46.3"], "en": "having fully understood all taints, I am at peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:46.4"], "en": "I dwell free from taints;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:47.1"], "en": "my defilements have been incinerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:47.2"], "en": "…pe…", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:47.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:48.1", "PA_tha-ap_412:48.2"], "en": "Welcome indeed has come to me... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:48.3"], "en": "This is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:49.1", "PA_tha-ap_412:49.2"], "en": "The four analytical knowledges... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:49.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:50.1"], "en": "In this way, it is said, the Venerable Elder Udena recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:51.1"], "en": "The legend of the Elder Udena is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:52.1"], "en": "The forty-first chapter: The Section on Metteyya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:53.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:54.1"], "en": "Metteyya, the elder Puṇṇaka, ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:54.2"], "en": "Mettagū and Dhotaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:54.3"], "en": "Upasīva and Nanda,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:54.4"], "en": "and Hemaka was the seventh among them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:55.1"], "en": "Todeyya, Jatukaṇṇī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:55.2"], "en": "and Udena of great renown;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:55.3"], "en": "herein there are three hundred stanzas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_412:55.4"], "en": "Eighty-three hundred and forty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
