[
{"segs": ["PA_ja_332:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:0.2", "PA_ja_332:0.3"], "en": "Catukkanipāta, Kokilavagga (The Chapter on the Cuckoo)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:0.4"], "en": "2. The Rathalaṭṭhi Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:1.1"], "en": "\"Having killed, he says 'I have killed';", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:1.2"], "en": "having conquered, he declares 'I have conquered'.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:1.3", "PA_ja_332:1.4"], "en": "O King, one who speaks of the past should not be believed at all;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:2.1"], "en": "therefore, one of wise nature—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:2.2"], "en": "One should listen even to the other;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:2.3"], "en": "having heard the words of both,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:2.4"], "en": "one should act according to the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:3.1"], "en": "A lazy householder who indulges in sensual pleasures is not good;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:3.2"], "en": "an unrestrained renunciant is not good;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:3.3"], "en": "a king who acts without reflection is not good.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:3.4"], "en": "It is not good for a wise man to be angry.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:4.1", "PA_ja_332:4.2"], "en": "A Kshatriya, a lord of the earth, should act with reflection, not without reflection.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:4.3"], "en": "“O King, for those who act with circumspection,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:4.4"], "en": "glory and fame increase.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_332:5.1"], "en": "The Second Jātaka, the Rathalaṭṭhiya Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
