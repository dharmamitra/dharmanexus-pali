[
{"segs": ["PA_tha-ap_546:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:0.2"], "en": "Bhaddiyavagga 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:0.3"], "en": "The Apadāna of the Elder Vaṅgīsa", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:1.2"], "en": "the eye-seer regarding all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:1.3"], "en": "[appeared] one hundred thousand aeons hence.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:1.4"], "en": "The Leader appeared in the aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:2.1"], "en": "like a wave in the ocean,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:2.2"], "en": "like a star in the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:2.3", "PA_tha-ap_546:2.4"], "en": "Thus was his teaching inscribed by the Arahants, together with the devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:3.1"], "en": "asuras, and nāgas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:3.2"], "en": "Honored by men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:3.3", "PA_tha-ap_546:3.4"], "en": "the Supreme Victor stood in the midst of the people, crowded with recluses and brahmins.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:4.1", "PA_tha-ap_546:4.2", "PA_tha-ap_546:4.3"], "en": "The Victor, who has reached the end of the world, illuminating the world with his radiance and awakening it with his word—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:4.4", "PA_tha-ap_546:5.1", "PA_tha-ap_546:5.2"], "en": "He, the supreme among men, endowed with the four kinds of self-confidence, [opens] the lotuses of those who are ready to be trained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:5.3"], "en": "Having abandoned fear and agitation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:5.4"], "en": "having attained security and being confident,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:6.1"], "en": "he stands in the pre-eminent place of the bull.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:6.2"], "en": "And the unique stage of Buddhahood;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:6.3"], "en": "the Chief of the World claims this for himself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:6.4"], "en": "and there is no one anywhere who can challenge him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:7.1", "PA_tha-ap_546:7.2"], "en": "As that Tathāgata roars his fearless lion’s roar,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:7.3"], "en": "whether it be a god, a human, or a Brahmā—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:7.4"], "en": "There is no one who can turn him back.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:8.1"], "en": "Teaching the sublime Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:8.2"], "en": "he brings across the world together with its devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:8.3"], "en": "He sets in motion the Wheel of Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:8.4"], "en": "confident among the assemblies;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:9.1"], "en": "he is the foremost of those possessed of inspired eloquence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:9.2", "PA_tha-ap_546:9.3"], "en": "Having proclaimed the many virtues of that disciple esteemed as virtuous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:9.4"], "en": "he placed him at the very head of his followers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:10.1"], "en": "At that time, in Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:10.2", "PA_tha-ap_546:10.3"], "en": "I was born as a brahmin esteemed as virtuous, a knower of all the Vedas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:10.4"], "en": "The Lord of Speech,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:11.1", "PA_tha-ap_546:11.2"], "en": "the subduer of disputants— having approached that Great Hero and heard his teaching of the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:11.3"], "en": "I obtained the supreme joy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:11.4"], "en": "delighting in the virtues of the disciple;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:12.1"], "en": "having invited the Sugata, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:12.2", "PA_tha-ap_546:12.3"], "en": "Having fed the one who delights the world together with his Saṅgha for seven days,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:12.4"], "en": "I then covered him with fine cloths.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:13.1"], "en": "Having bowed his head at [the Buddha's] feet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:13.2"], "en": "having been granted permission and with palms joined in reverence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:13.3"], "en": "he stood to one side, joyful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:13.4"], "en": "Having paid homage to the supreme Victor:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:14.1"], "en": "“Homage to you, crusher of disputants;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:14.2"], "en": "homage to you, best of seers!”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:14.3"], "en": "Homage to you, supreme in all the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:14.4"], "en": "homage to you, who grant fearlessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:15.1"], "en": "Homage to you, crusher of Māra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:15.2"], "en": "Homage to you, O destroyer of wrong views;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:15.3"], "en": "homage to you, the giver of peace and happiness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:15.4"], "en": "homage to you, who provide refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:16.1"], "en": "You are the protector of the helpless,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:16.2"], "en": "the giver of fearlessness to those who are afraid,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:16.3"], "en": "and a place of rest for those who are weary.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:16.4", "PA_tha-ap_546:17.1", "PA_tha-ap_546:17.2"], "en": "Having thus praised the Perfectly Enlightened One of great virtue with such words as, \"A refuge for those seeking refuge,\"...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:17.3", "PA_tha-ap_546:17.4"], "en": "\"I am attaining the destination of the monk, the subduer of disputants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:18.1"], "en": "Then the Blessed One said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:18.2"], "en": "Possessing infinite eloquence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:18.3"], "en": "he said: \"He who fed the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:18.4"], "en": "together with his assembly of seven thousand disciples, for seven days...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:19.1", "PA_tha-ap_546:19.2"], "en": "And he, with palms joined in faith, proclaimed my virtues, saying:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:19.3"], "en": "\"He aspires to this state.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:19.4"], "en": "For the monk who is a subduer of disputants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:20.1"], "en": "in a future time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:20.2"], "en": "you shall obtain that heart's desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:20.3", "PA_tha-ap_546:20.4", "PA_tha-ap_546:21.1"], "en": "Having experienced no small measure of divine and human prosperity for a hundred thousand aeons, In the hundred-thousandth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:21.2"], "en": "Born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:21.3", "PA_tha-ap_546:21.4"], "en": "he will be a teacher in the world named Gotama by lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:22.1"], "en": "His heir in the Dhammas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:22.2"], "en": "his own legitimate son, fashioned by the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:22.3"], "en": "known by the name Vaṅgīsa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:22.4"], "en": "‘He will become a disciple of the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:23.1"], "en": "Having heard this, he became joyful and,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:23.2"], "en": "for as long as he lived, [served] the Conqueror;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:23.3", "PA_tha-ap_546:23.4"], "en": "With a mind of loving-kindness, I attended upon the Tathāgata with various requisites.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:24.1"], "en": "By that well-performed kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:24.2"], "en": "And through my volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:24.3"], "en": "having cast off the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:24.4"], "en": "I went to the Tusita heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:25.1"], "en": "And now, in my final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:25.2"], "en": "I was born into a brahmin family;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:25.3"], "en": "when I was reborn [there], I was once again born [into one].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:25.4"], "en": "Seven years from birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:26.1", "PA_tha-ap_546:26.2"], "en": "he was born knowing all the Vedas and skilled in the science of debate.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:26.3"], "en": "A speaker of eloquent speech, a debater,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:26.4"], "en": "a crusher of opposing arguments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:27.1"], "en": "born in Vaṅga— thus he is called Vaṅgīsa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:27.2"], "en": "Or \"one who is master of speech\";", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:27.3"], "en": "thus my name became Vaṅgīsa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:27.4"], "en": "as it was recognized by the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:28.1", "PA_tha-ap_546:28.2"], "en": "When I had reached the age of discretion and stood in the prime of youth, then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:28.3"], "en": "in delightful Rājagaha, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:28.4"], "en": "To Sāriputta, the great seer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:29.1"], "en": "The twenty-fifth recitation section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:30.1"], "en": "As he was wandering for alms, [he saw] him...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:30.2"], "en": "With bowl in hand, well-restrained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:30.3"], "en": "with untroubled eyes, speaking in moderation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:30.4"], "en": "looking ahead only the distance of a yoke.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:31.1", "PA_tha-ap_546:31.2"], "en": "Seeing him, I was struck with wonder and said, \"He is worthy of me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:31.3"], "en": "like a dense cluster of kaṇikāra flowers.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:31.4"], "en": "I recited the verse-line beginning with \"The mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:32.1"], "en": "He pointed out to me the Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:32.2"], "en": "the Fully Awakened One, the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:32.3", "PA_tha-ap_546:32.4", "PA_tha-ap_546:33.1"], "en": "Then that wise hero spoke further to me words endowed with dispassion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:33.2"], "en": "Having made that supreme [teaching] difficult to see,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:33.3", "PA_tha-ap_546:33.4"], "en": "he was satisfied by that Neutral One with his various inspired utterances.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:34.1"], "en": "Bowing his head at my feet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:34.2"], "en": "he said to me, “Please grant me the going forth”;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:34.3"], "en": "then that one of great wisdom—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:34.4"], "en": "He led me to the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:35.1"], "en": "Bowing my head at the Teacher’s feet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:35.2"], "en": "I sat down in his presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:35.3"], "en": "The Best of Speakers said to me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:35.4", "PA_tha-ap_546:36.1"], "en": "\"Vaṅgīsa, do you know anything of a craft? To him I replied:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:36.2"], "en": "And I said, \"I know it\";", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:36.3"], "en": "even the Matasīsa forest-cleared area,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:36.4"], "en": "though twelve years old.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:36.5"], "en": "\"By your special knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:36.6", "PA_tha-ap_546:37.1"], "en": "if you are able, please recite it. \"So be it,\" he consented.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:37.2"], "en": "He showed three heads;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:37.3", "PA_tha-ap_546:37.4"], "en": "I declared which among them had been reborn in hell, as a human, or as a deva.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:38.1", "PA_tha-ap_546:38.2"], "en": "Then the Leader showed his head to one whose taints were exhausted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:38.3"], "en": "thereupon, my exertion was destroyed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:38.4"], "en": "I requested the going-forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:39.1"], "en": "Having gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:39.2"], "en": "I associated with the Sugata here and there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:39.3", "PA_tha-ap_546:39.4"], "en": "\"Therefore, you are a master of poetry,\" so the bhikkhus here reproach me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:40.1"], "en": "Therefore, for the sake of testing me—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:40.2"], "en": "The Buddha, the Guide, said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:40.3", "PA_tha-ap_546:40.4"], "en": "\"These verses of reasoning occur to you spontaneously.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:41.1"], "en": "“I am not a master of poetry, O Hero;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:41.2"], "en": "it does not occur to me instantly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:41.3"], "en": "“In that case, Vaṅgīsa, now—”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:41.4"], "en": "“Do not praise me on account of my status.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:42.1"], "en": "Then I praised the Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:42.2"], "en": "the best of seers, with verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:42.3"], "en": "Then, instantly pleased with me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:42.4", "PA_tha-ap_546:43.1"], "en": "the Jina placed me at the forefront because of my inspired eloquence and my state of mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:43.2"], "en": "I held others in contempt; because of that,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:43.3"], "en": "I was filled with spiritual urgency toward those who were virtuous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:43.4"], "en": "and I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:44.1", "PA_tha-ap_546:44.2"], "en": "\"There is no one else to be found who is the foremost among those possessed of inspired eloquence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:44.3"], "en": "such as this monk Vaṅgīsa.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:44.4"], "en": "\"Thus, O monks, you should remember it:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:45.1", "PA_tha-ap_546:45.2"], "en": "the karma performed during one hundred thousand [aeons] has shown its fruit to me here.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:45.3"], "en": "Like an arrow released from a bow,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:45.4"], "en": "I have burned away my defilements;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:46.1"], "en": "my defilements have been incinerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:46.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:46.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:47.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:47.2", "PA_tha-ap_546:47.3"], "en": "... [as before] ... the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:48.1"], "en": "The four analytical knowledges (paṭisambhidā) have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:48.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:48.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:49.1"], "en": "Thus indeed did the Venerable Elder Vaṅgīsa speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_546:50.1"], "en": "The legend of the Elder Vaṅgīsa, the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
