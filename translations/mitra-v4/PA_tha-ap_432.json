[
{"segs": ["PA_tha-ap_432:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:0.2"], "en": "Chapter on the Once-Sweeper (Sakiṃsammajjakavagga), Number Ten:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:0.3"], "en": "The Apadāna of the Elder Soṇṇakontarika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:1.1"], "en": "“The Buddha, who is to be cherished by the mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:1.2"], "en": "self-tamed and composed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:1.3"], "en": "moving along the path of the Brahmās— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:1.4"], "en": "Delighting in the tranquility of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:2.1"], "en": "the Fully Awakened One who has crossed the flood—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:2.2"], "en": "the sage, a meditator devoted to meditation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:2.3"], "en": "Having reached the landing-place,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:2.4"], "en": "which shone like the petals of a blue lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:3.1"], "en": "he took water from an alābu gourd.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:3.2"], "en": "I approached the Best of Buddhas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:3.3"], "en": "having washed the Buddha’s feet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:3.4"], "en": "I offered him a gourd.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:4.1", "PA_tha-ap_432:4.2"], "en": "And the Fully Enlightened One named Padumuttara commanded:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:4.3"], "en": "\"Having brought this water, [give it to him].\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:4.4"], "en": "\"Place it at my feet.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:5.1", "PA_tha-ap_432:5.2"], "en": "Having assented with \"So be it,\" and out of reverence for the Teacher;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:5.3"], "en": "Having struck water with a gourd,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:5.4"], "en": "I approached the Best of Buddhas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:6.1"], "en": "the Great Hero rejoiced.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:6.2"], "en": "\"Extinguish my mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:6.3"], "en": "by this gift of a gourd,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:6.4"], "en": "may your intention be fulfilled.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:7.1"], "en": "In fifteen aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:7.2"], "en": "I delighted in the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:7.3"], "en": "and thirty times I was a king.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:7.4"], "en": "I was a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:8.1"], "en": "Whether by day or by night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:8.2"], "en": "while walking or standing still;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:8.3"], "en": "Taking a golden water-pot,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:8.4"], "en": "he stood before me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:9.1"], "en": "having given a gourd to the Buddha, [he attained this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:9.2"], "en": "I obtain a golden vessel;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:9.3", "PA_tha-ap_432:9.4"], "en": "even a small service rendered to such as these becomes vast.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:10.1"], "en": "In the hundred-thousandth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:10.2"], "en": "when I gave that gourd at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:10.3"], "en": "I do not recall ever being born in an unhappy state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:10.4"], "en": "This is the fruit of non-gain:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:11.1", "PA_tha-ap_432:11.2"], "en": "the defilements have been incinerated by me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:11.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:12.1", "PA_tha-ap_432:12.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:12.3"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:13.1", "PA_tha-ap_432:13.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:13.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:14.1"], "en": "Thus indeed did the Venerable Elder Soṇṇakontarika speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:15.1"], "en": "This is the tenth legend of the Elder Soṇṇakontarika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:16.1"], "en": "The Forty-third Chapter: On Sweeping Once.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:17.1"], "en": "Its summary (uddāna) is:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:18.1"], "en": "The Elder Sakiṃsammajjaka...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:18.2"], "en": "One who wears a single garment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:18.3"], "en": "one who uses a single seat; the Kadamba,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:18.4"], "en": "the Koraṇḍaka, and also the Ghaṭassavanika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:19.1"], "en": "Sucintika, Kiṅkaṇika,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:19.2", "PA_tha-ap_432:19.3"], "en": "and Soṇṇakontarika; herein there are one hundred single verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_432:19.4"], "en": "And indeed, the seventy-first.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
