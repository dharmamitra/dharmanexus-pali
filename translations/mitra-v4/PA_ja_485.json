[
{"segs": ["PA_ja_485:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:0.2"], "en": "Miscellaneous Section,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:0.3"], "en": "Chapter on the Rice Field of Śālī Rice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:0.4"], "en": "2. The Canda-Kinnarī Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:1.1", "PA_ja_485:1.2"], "en": "“I think this is being brought forth for Canda, the crusher of the red [blood];”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:1.3"], "en": "Today I abandon life;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:1.4"], "en": "my vital breaths cease within me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:2.1"], "en": "My heart sinks in suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:2.2"], "en": "I burn and I am tormented;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:2.3"], "en": "because of your grief and weeping,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:2.4"], "en": "I suffer more than from any other sorrows.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:3.1"], "en": "I wither like grass, like a forest;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:3.2"], "en": "I dry up like a river that has not been replenished,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:3.3"], "en": "as I grieve for you, O Candi.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:3.4"], "en": "Not by other sorrows is this surpassed:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:4.1", "PA_ja_485:4.2"], "en": "these tears flow from me like rain upon the feet of a tree.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:4.3", "PA_ja_485:4.4"], "en": "“While you, O cruel one, are grieving, there is no sorrow for him greater than yours.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:5.1"], "en": "“You are wicked, O prince!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:5.2"], "en": "He whom you pierced with an arrow at the root of a tree—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:5.3"], "en": "the wretched man who was chosen by me as my husband—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:5.4"], "en": "he now lies pierced upon the ground.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:6.1", "PA_ja_485:6.2"], "en": "O Prince, let your mother take upon herself this sorrow of my heart;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:6.3"], "en": "let her bear that grief which is mine.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:6.4"], "en": "O Prince, as she gazes upon the kimpurisa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:7.1", "PA_ja_485:7.2"], "en": "let your wife wear away this sorrow of my heart.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:7.3"], "en": "The sorrow in my heart,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:7.4"], "en": "as I gaze upon the kimpurisa—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:8.1"], "en": "neither for my son nor for my husband.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:8.2"], "en": "\"O Prince, your mother saw him who slew the Kimpurisa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:8.3", "PA_ja_485:8.4"], "en": "though he was innocent of any offense toward me for the sake of sensual pleasures.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:9.1", "PA_ja_485:9.2"], "en": "Neither her son nor her husband did your wife see, O prince,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:9.3"], "en": "when she killed the kimpurisa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:9.4"], "en": "\"For my desires are indeed blameless.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:10.1"], "en": "\"Do not weep, Canda;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:10.2"], "en": "do not grieve, you whose eyes are blinded by the darkness of the forest!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:10.3"], "en": "\"You shall become my wife,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:10.4"], "en": "honored among women in the royal palace.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:11.1"], "en": "\"Will I indeed die?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:11.2"], "en": "\"I will not be yours, O prince;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:11.3"], "en": "for he who slew the Kimpurisa was innocent toward me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:11.4"], "en": "for he acted out of lust.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:12.1"], "en": "“O timid one, O you who desire life,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:12.2"], "en": "go to the Himalayas, O kinnarī;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:12.3"], "en": "there you shall have tālīsa and tagara as food.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:12.4"], "en": "Other deer will delight there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:13.1"], "en": "“Those mountains, those ravines,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:13.2"], "en": "and those mountain caves remain exactly as they were.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:13.3"], "en": "Not seeing him right there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:13.4"], "en": "O Kimpurisa, how could I speak?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:14.1"], "en": "Those delightful places with their leaf-mats are beautiful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:14.2"], "en": "Pursued by wild beasts,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:14.3"], "en": "not seeing you right there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:14.4"], "en": "O Kimpurisa, what could I possibly do?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:15.1"], "en": "Those delightful places carpeted with flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:15.2"], "en": "frequented by wild beasts—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:15.3"], "en": "seeking you there, they do not see you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:15.4"], "en": "O Kimpurisa, how could I speak?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:16.1", "PA_ja_485:16.2"], "en": "The mountain-forest rivers flow with currents strewn with flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:16.3"], "en": "Not seeing it right there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:16.4"], "en": "O Kimpurisa, how could I speak?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:17.1"], "en": "[There are] blue [forests] on the Himavat mountain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:17.2"], "en": "The peaks are beautiful to behold;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:17.3"], "en": "not seeing it right there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:17.4"], "en": "O Kimpurisa, how could I describe it?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:18.1", "PA_ja_485:18.2"], "en": "The yellow peaks of the Himalaya mountain are beautiful to behold; yet,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:18.3"], "en": "right there, they do not see that.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:18.4"], "en": "O Kimpurisa, how could I speak?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:19.1", "PA_ja_485:19.2"], "en": "The peaks of the Himalayan mountain are beautiful to behold.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:19.3"], "en": "Not seeing it right there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:19.4"], "en": "O Kimpurisa, what could I say?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:20.1"], "en": "[I see] the lofty peaks of the Himavat mountain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:20.2"], "en": "The peaks are beautiful to behold;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:20.3"], "en": "not seeing him right there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:20.4"], "en": "O Kimpurisa, how could I sing?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:21.1", "PA_ja_485:21.2"], "en": "The white peaks of the Himalaya mountain are beautiful to behold;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:21.3"], "en": "yet right there they do not see that.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:21.4"], "en": "O Kimpurisa, how could I describe them?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:22.1", "PA_ja_485:22.2"], "en": "The peaks of the Himalaya mountain are variegated and beautiful to behold.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:22.3"], "en": "Not seeing him right there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:22.4"], "en": "O Kimpurisa, what could I say?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:23.1"], "en": "[I am lost] on Gandhamādana, which is frequented by hosts of yakkhas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:23.2"], "en": "Covered by medicinal herbs,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:23.3"], "en": "not seeing him right there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:23.4"], "en": "O Kimpurisa, what could I have said? To whom could I have spoken?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:24.1", "PA_ja_485:24.2"], "en": "On Mount Gandhamādana, frequented by kinnaras and covered with medicinal herbs,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:24.3"], "en": "they did not see him right there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:24.4"], "en": "“O Kimpurisa, how could I speak?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:25.1"], "en": "I pay homage to you, O noble Brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:25.2"], "en": "who have granted my wish for a husband, I wretched woman.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:25.3"], "en": "I have been consecrated with the nectar;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:25.4"], "en": "I have come together with my most beloved.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:26.1"], "en": "Now let us wander through the mountains, forests, and rivers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:26.2"], "en": "Their streams are strewn with flowers;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:26.3"], "en": "they dwell among various trees,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:26.4"], "en": "speaking kindly to one another.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_485:27.1"], "en": "The Second Jātaka: The Story of the Kinnarī Candā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
