{"segs": ["PA_thag_1.76:0.1", "PA_thag_1.76:0.2", "PA_thag_1.76:0.3"], "en": "Theragāthā 1.76 Ekakanipāta Aṭṭhamavagga (The Eighth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.76:0.4"], "en": "The Verses of the Elder Piyañjaha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.76:1.1"], "en": "“Fall when they rise up;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.76:1.2"], "en": "leap up when they fall down.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.76:1.3"], "en": "“While they are not at peace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.76:1.4"], "en": "I shall not take delight in those who find delight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.76:1.5"], "en": "… Thus spoke the Elder Piyañjahā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
