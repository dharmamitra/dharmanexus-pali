[
{"segs": ["PA_ja_140:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_140:0.2", "PA_ja_140:0.3"], "en": "Ekakanipāta, Asampadānavagga (The Chapter on Non-Generosity)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_140:0.4"], "en": "10. The Kākajātakam:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_140:1.1", "PA_ja_140:1.2"], "en": "“Constantly with hearts full of anxiety, they harass the entire world;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_140:1.3"], "en": "\"Therefore, we have no power over them;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_140:1.4"], "en": "they are our own kin, like crows.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_140:2.1"], "en": "Thus ends the tenth Jātaka, the Kāka-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_140:2.2"], "en": "The fourteenth chapter: The Chapter on Non-Conferral.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_140:3.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_140:4.1"], "en": "Itarītara, Rakkhasī, and Khemiyā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_140:4.2"], "en": "By the question concerning the \"other\" (parosa), [he reached] the Ābhassara realm again;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_140:4.3"], "en": "then, with the best of swans, the supreme lotus-hair,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_140:4.4"], "en": "the eight-fold falling, and the ten by means of the crow-variety.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
