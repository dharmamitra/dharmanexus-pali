[
{"segs": ["PA_ja_308:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:0.2", "PA_ja_308:0.3"], "en": "Catukkanipāta, Kāliṅgavagga (The Chapter on Kāliṅga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:0.4"], "en": "8. The Sakuṇajātakasutta:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:1.1", "PA_ja_308:1.2"], "en": "“We have done what was to be done for you, since we possessed such strength.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:1.3"], "en": "\"O King of Beasts, homage be to you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:1.4"], "en": "may we receive something [in return].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:2.1"], "en": "\"For me, who subsists on blood...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:2.2"], "en": "For one who constantly commits cruel deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:2.3"], "en": "even though you live for a long time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:2.4"], "en": "it is as if you have entered between the teeth of Death.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:3.1"], "en": "“To one who is ungrateful and unthankful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:3.2"], "en": "who does not repay what has been done for them—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:3.3"], "en": "in whom there is no gratitude— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:3.4", "PA_ja_308:4.1", "PA_ja_308:4.2"], "en": "Fruitless is the service rendered to one by whom the duty of friendship is not found in their very presence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:4.3"], "en": "“Without resentment or anger,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:4.4"], "en": "depart from there slowly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_308:5.1"], "en": "The Sakuṇa Jātaka, the eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
