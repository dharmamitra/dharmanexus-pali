[
{"segs": ["PA_tha-ap_299:0.1", "PA_tha-ap_299:0.2", "PA_tha-ap_299:0.3"], "en": "The Apadāna of the Elder Desakittaka, from the Citakapūjaka Chapter, Number Seven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:1.1", "PA_tha-ap_299:1.2"], "en": "“At that time, I was a brahmin named Upasālaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:1.3"], "en": "I had entered a forest thicket.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:1.4"], "en": "Having seen the Eldest of the World, the Bull among Men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:2.1", "PA_tha-ap_299:2.2"], "en": "the recipient of the world's offerings, I paid homage at his feet.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:2.3"], "en": "Knowing my mind was full of faith,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:2.4"], "en": "the Buddha vanished from there;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:3.1"], "en": "having departed from the forest, he disappeared.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:3.2"], "en": "I recollected the Best of Buddhas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:3.3"], "en": "having praised that place,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:3.4"], "en": "I rejoiced in heaven for an eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:4.1", "PA_tha-ap_299:4.2"], "en": "In the ninety-two aeons since I praised that place,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:4.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:4.4"], "en": "This is the fruit of praising.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:5.1", "PA_tha-ap_299:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:6.1"], "en": "In this way, it is said, the venerable elder Desakittaka recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_299:7.1"], "en": "This is the seventh *apadāna* of the elder Desakittaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
