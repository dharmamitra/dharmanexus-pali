[
{"segs": ["PA_ja_282:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_282:0.2", "PA_ja_282:0.3"], "en": "The Section of Three (Tikanipāta), Chapter on the Interior (Abbhantaravagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_282:0.4", "PA_ja_282:1.1", "PA_ja_282:1.2"], "en": "2. The Story of the Bed He becomes even more excellent who attends upon what is excellent.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_282:1.3"], "en": "Having formed an alliance with one,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_282:1.4"], "en": "I liberated hundreds who were to be executed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_282:2.1"], "en": "therefore, by the entire world, [I am known as]...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_282:2.2"], "en": "Having made peace with one another,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_282:2.3"], "en": "one may go to heaven after death;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_282:2.4"], "en": "hear this, O people of Kāsi!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_282:3.1"], "en": "Having said this, the great king Kaṁsa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_282:3.2"], "en": "the ruler of Bārāṇasī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_282:3.3"], "en": "laid aside his bow and arrow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_282:3.4"], "en": "\"He undertook self-restraint.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_282:4.1"], "en": "This is the second, the Seyya Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
