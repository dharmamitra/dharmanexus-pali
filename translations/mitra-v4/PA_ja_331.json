[
{"segs": ["PA_ja_331:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:0.2", "PA_ja_331:0.3"], "en": "Catukkanipāta, Kokilavagga (The Chapter on the Cuckoo)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:0.4"], "en": "1. The Kokila Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:1.1", "PA_ja_331:1.2"], "en": "“He who speaks excessively when the time has not yet come;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:1.3"], "en": "Thus he lies struck down, like a cuckoo’s offspring;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:1.4", "PA_ja_331:2.1"], "en": "for no matter how well-sharpened the blade, [it cannot pierce the heart of one who has abandoned anger].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:2.2"], "en": "Like the Halāhala poison,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:2.3", "PA_ja_331:2.4"], "en": "so does ill-spoken speech cause one to fall when it is near at hand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:3.1"], "en": "Therefore, whether it be the right time or the wrong time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:3.2"], "en": "a wise person should guard their speech;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:3.3"], "en": "they should not speak excessively.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:3.4"], "en": "Or even toward one who is equal to oneself.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:4.1"], "en": "He who speaks measuredly at the proper time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:4.2"], "en": "preceded by reflection and possessed of discernment;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:4.3"], "en": "\"He takes in all his enemies,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:4.4"], "en": "just as a garuḍa takes up snakes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_331:5.1"], "en": "Thus ends the first Kokila Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
