{"segs": ["PA_thag_2.38:0.1", "PA_thag_2.38:0.2"], "en": "Theragāthā 2.38 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.38:0.3"], "en": "Catutthavagga (The Fourth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.38:0.4"], "en": "The Verses of the Elder Nisabha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.38:1.1"], "en": "“Having abandoned the five strands of sensual pleasure,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.38:1.2"], "en": "which are lovely and delightful;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.38:1.3"], "en": "Having gone forth from the home out of faith,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.38:1.4"], "en": "one may become an ender of suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.38:2.1"], "en": "I do not rejoice in death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.38:2.2"], "en": "I do not delight in life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.38:2.3", "PA_thag_2.38:2.4"], "en": "I await my time with clear comprehension and mindfulness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.38:2.5"], "en": "… The Elder Nisabha …", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
