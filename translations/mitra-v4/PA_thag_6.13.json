[
{"segs": ["PA_thag_6.13:0.1", "PA_thag_6.13:0.2"], "en": "Theragāthā 6.13 Chakkanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:0.4"], "en": "The Verse of the Elder Sirimaṇḍa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:1.1"], "en": "“Rain does not penetrate that which is covered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:1.2"], "en": "it does not penetrate that which is open.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:1.3"], "en": "Therefore, uncover what is covered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:1.4"], "en": "thus the rain will not drench you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:2.1"], "en": "The world is struck down by death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:2.2"], "en": "Enveloped by old age,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:2.3"], "en": "pierced by the dart of craving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:2.4"], "en": "he is constantly smoldering with desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:3.1", "PA_thag_6.13:3.2"], "en": "The world is struck down by death and hemmed in by old age;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:3.3"], "en": "it is constantly being slain, finding no protection.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:3.4"], "en": "The doer of the deed is like the handle of the bowl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:4.1", "PA_thag_6.13:4.2"], "en": "Death, disease, and old age— these three are like approaching masses of fire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:4.3"], "en": "There is no strength to resist,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:4.4"], "en": "nor speed to flee;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:5.1"], "en": "one should make this day fruitful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:5.2"], "en": "Or even by a small amount;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:5.3"], "en": "with each night that passes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:5.4"], "en": "his life becomes diminished accordingly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:6.1"], "en": "Whether walking, standing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:6.2"], "en": "sitting, or lying down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:6.3"], "en": "the final night approaches.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.13:6.4", "PA_thag_6.13:6.5"], "en": "“This is not the time for you to be negligent,” said the Elder Sirimaṇḍa. … [The Elder Sirimaṇḍa] …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
