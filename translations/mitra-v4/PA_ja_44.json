[
{"segs": ["PA_ja_44:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_44:0.2", "PA_ja_44:0.3"], "en": "Ekakanipāta, Atthakāmavagga (The Section on Those Desiring Welfare)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_44:0.4"], "en": "4. The Makasa Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_44:1.1", "PA_ja_44:1.2"], "en": "Better is an enemy who is endowed with wisdom than a friend who has abandoned wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_44:1.3"], "en": "\"For the fly will surely kill the one who is dull-witted;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_44:1.4"], "en": "the son shall strike off the head of his father.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_44:2.1"], "en": "Thus ends the fourth *Makasa-jātaka*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
