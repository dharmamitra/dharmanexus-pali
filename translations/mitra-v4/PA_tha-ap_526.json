[
{"segs": ["PA_tha-ap_526:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:0.2"], "en": "Tiṇadāyakavagga 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:0.3"], "en": "The Apadāna of the Elder Abbhañjanadāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:1.1"], "en": "“In the city of Bandhumatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:1.2"], "en": "I lived in the royal park;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:1.3"], "en": "at that time, I was a leather-worker.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:1.4"], "en": "Carrying a water-pot,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:2.1"], "en": "I saw the stainless Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:2.2"], "en": "the self-become, the unconquered.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:2.3"], "en": "To him who was resolute in striving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:2.4"], "en": "meditative, delighting in jhāna, and self-mastered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:3.1"], "en": "and who had attained success in all his desires—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:3.2"], "en": "Having seen him who had crossed the flood and was free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:3.3"], "en": "I, full of faith and joyful in mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:3.4"], "en": "offered him an ointment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:4.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:4.2"], "en": "because of the gift I gave then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:4.3"], "en": "I do not know a state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:4.4"], "en": "This is the fruit of my anointing:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:5.1", "PA_tha-ap_526:5.2"], "en": "the defilements have been burnt away by me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:5.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:6.1", "PA_tha-ap_526:6.2"], "en": "Welcome indeed has come to me... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:6.3"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:7.1", "PA_tha-ap_526:7.2"], "en": "the four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:7.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:8.1"], "en": "In this way, it is said, the venerable elder Abbhañjanadāyaka recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_526:9.1"], "en": "This is the fourth *apadāna* of the elder Abbhañjanadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
