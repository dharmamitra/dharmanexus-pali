{"segs": ["PA_thag_1.61:0.4"], "en": "The Verses of the Elder Vappa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.61:1.1"], "en": "“The seer sees the one who sees,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
