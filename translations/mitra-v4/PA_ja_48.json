{"segs": ["PA_ja_48:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_48:0.2", "PA_ja_48:0.3"], "en": "Ekakanipāta, Atthakāmavagga (The Section on Those Who Desire Welfare)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_48:0.4"], "en": "8. The Vedabbha Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_48:1.1", "PA_ja_48:1.2"], "en": "“He who seeks his welfare by the wrong means is brought to ruin.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_48:1.3"], "en": "The slaves killed Vedabbha;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_48:1.4"], "en": "they all met with disaster.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_48:2.1"], "en": "Thus ends the eighth Jātaka, the Vedabbha-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
