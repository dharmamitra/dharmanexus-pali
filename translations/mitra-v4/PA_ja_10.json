[
{"segs": ["PA_ja_10:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_10:0.2", "PA_ja_10:0.3"], "en": "The First Book, The Chapter on the Incontrovertible (Apaṇṇakavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_10:0.4"], "en": "10. The Birth Story of the One Who Dwells in Happiness:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_10:1.1", "PA_ja_10:1.2"], "en": "“That which others do not protect, and that which one does not protect others from;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_10:1.3"], "en": "Truly, that king sleeps in happiness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_10:1.4"], "en": "having no longing for sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_10:2.1"], "en": "Thus ends the tenth Jātaka, the Sukhavihāri Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_10:2.2"], "en": "The first chapter, the Apaṇṇaka-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_10:3.1"], "en": "Its summary (uddāna) is:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_10:4.1"], "en": "Varā, apaṇṇaka, vaṇṇupatha, and Serivara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_10:4.2"], "en": "It is like a well-sighted stalk of rice;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_10:4.3", "PA_ja_10:4.4"], "en": "and he who does not protect it with the noble village headman that is moral shame— by him it is destroyed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
