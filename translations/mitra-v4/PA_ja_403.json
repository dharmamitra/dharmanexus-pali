[
{"segs": ["PA_ja_403:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:0.2", "PA_ja_403:0.3"], "en": "The Section of Sevens, Chapter on the Hen-Fowl (Kukkuvagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:0.4"], "en": "8. The Aṭṭhisenaka Jātaka “O Aṭṭhisenaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:1.1", "PA_ja_403:1.2"], "en": "mendicant, those whom I do not know— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:1.3"], "en": "“They come together and entreat me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:1.4"], "en": "why do you not entreat me?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:2.1"], "en": "“A beggar is disliked.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:2.2"], "en": "One who does not grant a request becomes unloved;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:2.3"], "en": "therefore, I do not ask that of you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:2.4"], "en": "lest I incur the reproach of being rejected.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:3.1"], "en": "“He who lives by begging,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:3.2"], "en": "yet does not beg at the proper time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:3.3"], "en": "destroys the merit of others.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:3.4"], "en": "He does not even live by himself.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:4.1"], "en": "But he who lives by begging,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:4.2"], "en": "indeed begs at the proper time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:4.3"], "en": "Furthermore, he causes others to gain merit,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:4.4"], "en": "and he himself also lives [righteously].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:5.1"], "en": "Indeed, those possessed of wisdom do not fail to show kindness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:5.2"], "en": "Seeing that the supplicants had arrived, he said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:5.3"], "en": "\"O practitioner of the holy life, you are dear to me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:5.4"], "en": "speak, what is it you wish to hear?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:6.1"], "en": "“Those possessed of wisdom do not beg,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:6.2"], "en": "for the wise man is worthy of being known;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:6.3"], "en": "the Noble Ones stand waiting for those who seek them.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:6.4"], "en": "“This is the request of the noble ones.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:7.1"], "en": "“I give you, brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:7.2"], "en": "a thousand Rohiṇī cows together with a bull.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:7.3"], "en": "\"For a noble person would not fail to give counsel to another noble person,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:7.4"], "en": "having heard your verses which are endowed with Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_403:8.1"], "en": "The Aṭṭhisenaka Jātaka, the eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
