[
{"segs": ["PA_tha-ap_484:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:0.2"], "en": "Paṁsukūla Chapter, 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:0.3"], "en": "The Apadāna of the Elder Buddhasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:1.1"], "en": "“A reciter, a bearer of mantras,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:1.2"], "en": "one who has mastered the three Vedas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:1.3"], "en": "and is proficient in the science of marks and the ancient lore;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:1.4"], "en": "Together with the Nighaṇṭu and Keṭubha lexicons;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:2.1", "PA_tha-ap_484:2.2"], "en": "at that time, my students came to me like the currents of a river.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:2.3", "PA_tha-ap_484:2.4"], "en": "Day and night, without weariness, I recite the mantras for them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:3.1"], "en": "There is a perfectly enlightened Buddha named Siddhattha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:3.2"], "en": "At that time, he arose in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:3.3"], "en": "having destroyed that darkness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:3.4"], "en": "he set forth the light of knowledge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:4.1", "PA_tha-ap_484:4.2"], "en": "A certain disciple of mine spoke this to my disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:4.3"], "en": "having heard this matter from them, [I have declared it].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:4.4"], "en": "They then informed me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:5.1"], "en": "\"A Buddha has arisen in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:5.2"], "en": "the omniscient leader of the world.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:5.3"], "en": "People follow after him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:5.4"], "en": "no gain is found for us.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:6.1"], "en": "Buddhas appear only occasionally.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:6.2"], "en": "\"Those who possess vision have great renown;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:6.3", "PA_tha-ap_484:6.4"], "en": "what if I were now to see the Best of Buddhas, the Leader of the World?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:7.1"], "en": "Having taken my antelope skin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:7.2"], "en": "my bark garment, and my water-pot,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:7.3"], "en": "I departed from the hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:7.4"], "en": "I addressed him thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:8.1"], "en": "\"Like an udumbara flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:8.2"], "en": "or like a hare's mark in the moon;\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:8.3"], "en": "Just as milk is difficult for crows to find,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:8.4"], "en": "so is the Leader of the World rare;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:9.1"], "en": "the Buddha has arisen in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:9.2"], "en": "Human birth is difficult to obtain;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:9.3"], "en": "even when both are present,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:9.4"], "en": "hearing [the Dhamma] is very difficult to find.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:10.1"], "en": "A Buddha has arisen in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:10.2"], "en": "we shall obtain the Eye.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:10.3"], "en": "Come, let us all go.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:10.4"], "en": "Into the presence of the Perfectly Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:11.1", "PA_tha-ap_484:11.2"], "en": "All of them carried water-pots and were clothed in coarse antelope skins.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:11.3"], "en": "Then those matted locks, heavy with their weight,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:11.4"], "en": "emerged from the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:12.1"], "en": "looking ahead only the distance of a yoke, they went forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:12.2"], "en": "Seeking the supreme goal,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:12.3"], "en": "free from the fault of attachment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:12.4"], "en": "they are like lions, utterly fearless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:13.1"], "en": "Having few duties and free from greed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:13.2"], "en": "prudent and living in peace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:13.3"], "en": "they wander for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:13.4", "PA_tha-ap_484:14.1"], "en": "They approached the Best of Buddhas when one and a half yojanas remained [of the journey]; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:14.2"], "en": "illness arose within me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:14.3"], "en": "Having recollected the Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:14.4", "PA_tha-ap_484:15.1"], "en": "I passed away there ninety-four aeons ago.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:15.2"], "en": "Whatever perception I obtained then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:15.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:15.4"], "en": "this is the fruit of the perception of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:16.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:16.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:16.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:17.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:17.2", "PA_tha-ap_484:17.3"], "en": "[and so on] ...the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:18.1", "PA_tha-ap_484:18.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:18.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:19.1"], "en": "Thus indeed the venerable elder Buddhasaññaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_484:20.1"], "en": "This is the second legend of the elder Buddhasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
