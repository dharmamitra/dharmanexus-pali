[
{"segs": ["PA_tha-ap_81:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:0.2"], "en": "Nāgasamāla Chapter, 9.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:0.3"], "en": "The Apadāna of the Elder Ṭhitañjaliya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:1.1", "PA_tha-ap_81:1.2"], "en": "“In the past, I was a deer-hunter in the forest wilderness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:1.3"], "en": "there I saw the Perfectly Awakened One.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:1.4"], "en": "Possessing the thirty-two excellent marks—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:2.1"], "en": "there, having joined my palms in reverence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:2.2"], "en": "I departed facing the east.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:2.3", "PA_tha-ap_81:2.4"], "en": "As I sat not far away upon my own leaf-mat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:3.1"], "en": "a thunderbolt fell upon me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:3.2"], "en": "Then it fell upon my head;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:3.3"], "en": "at the time of my death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:3.4"], "en": "I again joined my palms in reverence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:4.1"], "en": "In the ninety-two aeons since then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:4.2"], "en": "I offered my joined palms;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:4.3"], "en": "I have never known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:4.4"], "en": "This is the fruit of the añjali-greeting:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:5.1"], "en": "in the fifty-fourth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:5.2"], "en": "one named Migaketu;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:5.3"], "en": "Endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:5.4"], "en": "a wheel-turning monarch of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:6.1"], "en": "[I possess] the four analytical knowledges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:6.3"], "en": "the Buddha’s instruction has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:7.1"], "en": "Thus indeed did the venerable elder Thitañjaliya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_81:8.1"], "en": "The legend of the Elder Ṭhitañjaliyati is the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
