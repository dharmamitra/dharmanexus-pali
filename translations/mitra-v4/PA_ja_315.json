[
{"segs": ["PA_ja_315:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:0.2", "PA_ja_315:0.3"], "en": "Catukkanipāta, Pucimandavagga (The Chapter on the Nimba Tree)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:0.4"], "en": "5. The Jātaka of Receiving All the Meat:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:1.1", "PA_ja_315:1.2"], "en": "“Truly harsh is your speech, you who come as a beggar for meat!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:1.3"], "en": "“Your voice is like a scab;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:1.4"], "en": "I give you a scab in return.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:2.1"], "en": "“This is merely a limb of human beings.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:2.2", "PA_ja_315:2.3"], "en": "\"One is called a brother in the world by speech that matches his limbs;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:2.4"], "en": "O limb, I give you to him truly.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:3.1", "PA_ja_315:3.2"], "en": "When a son says, \"Father,\" it makes the father's heart tremble;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:3.3"], "en": "such is the speech that is equal to the heart.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:3.4"], "en": "“I shall properly tame your heart.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:4.1", "PA_ja_315:4.2"], "en": "“He who has no friend in the village is just like one in the forest;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:4.3"], "en": "“Every word is true to me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:4.4"], "en": "I give you everything in full.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_315:5.1"], "en": "The *Sabbamaṁsalābha Jātaka*, the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
