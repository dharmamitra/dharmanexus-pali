[
{"segs": ["PA_tha-ap_118:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:0.2"], "en": "Mahāparivāravagga 6.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:0.3"], "en": "The Apadāna of the Elder Citakapūjaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:1.1"], "en": "“I dwell in Rājāyatana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:1.2"], "en": "together with my ministers and retinue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:1.3"], "en": "now that the Blessed One has attained final nibbāna.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:1.4"], "en": "To Sikhin, the Kinsman of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:2.1"], "en": "With a clear heart and joyful mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:2.2"], "en": "I went to the funeral pyre.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:2.3"], "en": "Having played the tūriya drum there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:2.4"], "en": "I scattered perfumes and garlands;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:3.1"], "en": "having performed worship at the funeral pyre, I offered homage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:3.2"], "en": "Having paid homage to the funeral pyre,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:3.3"], "en": "with a clear mind and a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:3.4"], "en": "I returned to my own abode.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:4.1"], "en": "Seated in my dwelling,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:4.2"], "en": "I recollected the worship of the shrine;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:4.3"], "en": "by that kamma, O Lord of Bipeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:4.4"], "en": "O eldest of the world, bull among men!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:5.1", "PA_tha-ap_118:5.2"], "en": "Having experienced prosperity among both gods and humans, [you have now attained this state].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:5.3"], "en": "I have reached the unshakable state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:5.4"], "en": "having abandoned victory and defeat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:6.1"], "en": "Thirty-one eons ago from now...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:6.2"], "en": "The flower that I offered—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:6.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:6.4"], "en": "this is the fruit of worshiping the funeral pyre.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:7.1"], "en": "In the twenty-ninth aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:7.2", "PA_tha-ap_118:7.3"], "en": "sixteen kings named Uggata will arise.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:7.4"], "en": "Universal monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:8.1", "PA_tha-ap_118:8.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:8.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:9.1"], "en": "It is said that the Venerable Elder Citakapūjaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_118:10.1"], "en": "This is the sixth legend (Apadāna) of the Elder Citakapūjaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
