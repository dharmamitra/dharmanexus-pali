[
{"segs": ["PA_tha-ap_174:0.1", "PA_tha-ap_174:0.2", "PA_tha-ap_174:0.3"], "en": "The Apadāna of the Elder Nisseṇidāyaka, from the Kumuda Chapter, the Second.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_174:1.1", "PA_tha-ap_174:1.2", "PA_tha-ap_174:1.3"], "en": "For the sake of ascending the palace of the Blessed One Koṇḍañña, the World’s Eldest, the Neutral One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_174:1.4"], "en": "A ladder was caused to be built by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_174:2.1"], "en": "Through that clarity of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_174:2.2"], "en": "having experienced prosperity, [I have attained this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_174:2.3", "PA_tha-ap_174:2.4"], "en": "I bear my final body in the teaching of the Perfectly Enlightened One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_174:3.1"], "en": "in the thirty-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_174:3.2"], "en": "In a thousand [aeons],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_174:3.3"], "en": "there were three kings named Sambahula,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_174:3.4"], "en": "wheel-turning monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_174:4.1", "PA_tha-ap_174:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_174:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_174:5.1"], "en": "Thus indeed the venerable elder Nisseṇidāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_174:6.1"], "en": "This is the second legend of the elder Nisseṇidāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
