[
{"segs": ["PA_thi-ap_4:0.1"], "en": "The Therī-apadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:0.2"], "en": "Sumedhāvagga 4:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:0.3"], "en": "The Apadāna of the Elder Nun Saṅkamanatthā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:1.1"], "en": "“Of the Blessed One Vipassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:1.2"], "en": "the World’s Elder, the Neutral One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:1.3"], "en": "as he was proceeding along the highway— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:1.4"], "en": "While ferrying living beings across,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:2.1"], "en": "having gone forth from the household life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:2.2"], "en": "I lay down face-downward.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:2.3", "PA_thi-ap_4:2.4"], "en": "The compassionate Lord of the World stepped upon my head;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:3.1"], "en": "having stepped upon my head, he...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:3.2"], "en": "The Leader of the World departed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:3.3"], "en": "through that serene confidence of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:3.4"], "en": "I too went to the Tusita heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:4.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:4.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:4.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:5.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:5.2", "PA_thi-ap_4:5.3"], "en": "[and so on] ...the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:6.1", "PA_thi-ap_4:6.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:7.1"], "en": "Thus indeed did the Bhikkhunī Saṅkamanatthā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_4:8.1"], "en": "This is the fourth legend of the Elder Nun Saṅkamanatthā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
