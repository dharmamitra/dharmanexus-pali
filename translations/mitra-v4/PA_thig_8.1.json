[
{"segs": ["PA_thig_8.1:0.1", "PA_thig_8.1:0.2"], "en": "Therīgāthā 8.1 Aṭṭhakanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:0.3"], "en": "The Verses of the Elder Nun Sīsūpacālā", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:1.1"], "en": "“A bhikkhunī endowed with virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:1.2"], "en": "well-restrained in her sense faculties,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:1.3"], "en": "shall attain the state of peace.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:1.4"], "en": "“Of unsurpassed beauty and speed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:2.1"], "en": "And the deities of the Tāvatiṃsa, Yāma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:2.2"], "en": "and Tusita realms [rejoiced].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:2.3"], "en": "The gods who delight in their own creations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:2.4"], "en": "and those gods who wield power over others’ creations—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:2.5"], "en": "set your heart upon them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:2.6"], "en": "\"Where you formerly dwelt—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:3.1"], "en": "among the Tāvatiṃsa gods, the Yāma gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:3.2"], "en": "and also the Tusita deities.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:3.3"], "en": "The gods who delight in their own creations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:3.4"], "en": "and those gods who wield power over others' creations;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:4.1"], "en": "from time to time, passing from one existence to another, they pass away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:4.2"], "en": "Preoccupied with personal existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:4.3", "PA_thig_8.1:4.4"], "en": "they have not transcended personal existence and continue to wander through birth and death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:5.1"], "en": "The whole world is set ablaze;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:5.2"], "en": "the whole world is aflame;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:5.3"], "en": "the whole world is burning.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:5.4"], "en": "The entire world trembled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:6.1"], "en": "That which is unshakable, incomparable,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:6.2"], "en": "and not frequented by ordinary persons—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:6.3"], "en": "The Buddha taught the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:6.4"], "en": "my mind delighted therein.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:7.1"], "en": "Having heard his word, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:7.2"], "en": "Dwelling delighted in the Teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:7.3"], "en": "I have attained the three knowledges;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:7.4"], "en": "the Buddha’s instruction has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:8.1"], "en": "Delight is destroyed everywhere,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:8.2"], "en": "and the mass of darkness is shattered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:8.3"], "en": "know this, O Evil One!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:8.4"], "en": "“You are slain, O End-maker!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:9.1"], "en": "… Thus spoke the Elder Nun Sīsūpacālā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_8.1:10.1"], "en": "The Eighth Chapter (Aṭṭhakanipāta) is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
