[
{"segs": ["PA_ja_353:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:0.2"], "en": "The Fifth Collection,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:0.3"], "en": "Chapter on the Jeweled Earrings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:0.4", "PA_ja_353:1.1"], "en": "3. The Venaśākha Jātaka “O Brahmadatta, this cannot be permanent:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:1.2"], "en": "security, abundance of food, and physical well-being.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:1.3"], "en": "Let there be no confusion when your wealth is exhausted,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:1.4"], "en": "like one whose boat has broken in the midst of the ocean.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:2.1"], "en": "Whatever a person does—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:2.2"], "en": "One sees those [results] within oneself:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:2.3"], "en": "the doer of good sees what is good,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:2.4"], "en": "and the doer of evil sees what is evil.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:2.5"], "en": "“As one sows the seed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:2.6"], "en": "so one reaps the fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:3.1"], "en": "This is the word of the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:3.2"], "en": "As Pārāsariya said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:3.3", "PA_ja_353:3.4"], "en": "\"Do not commit evil, lest you be tormented by it after having done so.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:4.1", "PA_ja_353:4.2"], "en": "This very one, Piṅgiya, is that bamboo branch upon which I caused a thousand kṣatriyas—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:4.3"], "en": "adorned and anointed with the essence of sandalwood— to be slain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:4.4"], "en": "That very same suffering has come back upon me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:5.1"], "en": "And Sāmā, her limbs anointed with sandalwood,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:5.2"], "en": "tall as a *sobhañjana* tree;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:5.3"], "en": "“Having seen [this], I shall die;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:5.4"], "en": "that will be even more painful for me than this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_353:6.1"], "en": "The Third Jātaka: The Deer-Veṇusākhā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
