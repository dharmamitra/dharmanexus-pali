[
{"segs": ["PA_pv_16:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:0.2"], "en": "Ubbarivagga, 4.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:0.3"], "en": "The Story of Nandā the Petī", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:1.1"], "en": "“Kālī you are, ill-favored in form,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:1.2"], "en": "harsh and terrifying to behold;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:1.3"], "en": "you are tawny and blackish.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:1.4"], "en": "“I do not consider that to be human.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:2.1"], "en": "“I am Nandā, O Nandisena;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:2.2"], "en": "I was your wife in the past.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:2.3"], "en": "“Having committed evil deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:2.4"], "en": "they have gone from here to the world of the hungry ghosts.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:3.1"], "en": "“What indeed [did they do] by way of body or speech?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:3.2"], "en": "“An evil deed was committed by you with the mind;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:3.3", "PA_pv_16:3.4"], "en": "as the result of what karma have you gone from here to the world of the hungry ghosts?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:4.1"], "en": "“I was fierce and harsh,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:4.2"], "en": "and I lacked respect for you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:4.3"], "en": "having spoken such ill words to you, I— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:4.4"], "en": "“Having gone from here to the world of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:5.1"], "en": "“Well then, I give you this upper garment;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:5.2"], "en": "put on this cloth.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:5.3", "PA_pv_16:5.4"], "en": "Having clothed yourself in this garment, come; I shall lead you home.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:6.1"], "en": "[I shall provide] clothing, food, and drink.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:6.2"], "en": "\"You shall reach your home;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:6.3", "PA_pv_16:6.4"], "en": "you will see your sons and you will behold your daughters-in-law.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:7.1", "PA_pv_16:7.2"], "en": "“What has been given by hand to hand does not benefit me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:7.3"], "en": "[I seek] monks endowed with virtue.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:7.4"], "en": "To one who is free from passion and deeply learned—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:8.1"], "en": "satisfy him with food and drink,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:8.2"], "en": "and dedicate my offering to him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:8.3"], "en": "\"Then I shall be happy,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:8.4"], "en": "having all my desires fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:9.1"], "en": "Having assented with \"So be it,\" he—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:9.2"], "en": "He distributed abundant gifts:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:9.3"], "en": "food, drink, hard foods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:9.4"], "en": "as well as clothing and lodgings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:9.5"], "en": "An umbrella, perfumes, garlands,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:9.6"], "en": "and various kinds of sandals;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:10.1"], "en": "and monks endowed with virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:10.2"], "en": "To one who was free from passion and learned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:10.3"], "en": "having gratified him with food and drink,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:10.4"], "en": "she dedicated the merit of that gift.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:11.1"], "en": "Immediately after it was recited,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:11.2"], "en": "the fruit ripened:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:11.3"], "en": "food, clothing, and drink.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:11.4"], "en": "This is the fruit of that offering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:12.1"], "en": "Thereafter, pure and dressed in clean garments,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:12.2"], "en": "wearing the finest cloth from Kāsī;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:12.3"], "en": "Adorned with various garments and ornaments,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:12.4"], "en": "she approached her husband:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:13.1"], "en": "“With such exquisite beauty...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:13.2"], "en": "You who stand there, O deity,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:13.3", "PA_pv_16:13.4"], "en": "illuminating all directions like a star among the herbs.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:14.1"], "en": "By what means is your complexion so radiant?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:14.2"], "en": "By what means do you prosper here?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:14.3"], "en": "And by what means do your riches arise?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:14.4"], "en": "\"Whosoever are dear to the mind—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:15.1"], "en": "O goddess of great power, I ask you:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:15.2"], "en": "what merit did you perform when you were a human being?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:15.3"], "en": "“By what means have you come to possess such blazing majesty,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:15.4"], "en": "and why does your complexion illuminate all directions?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:16.1"], "en": "“I am Nandā, O Nandisena.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:16.2"], "en": "In the past, I was your wife;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:16.3"], "en": "having committed evil deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:16.4"], "en": "I have gone from here to the world of the hungry ghosts.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:17.1"], "en": "Through the gift given by you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:17.2"], "en": "I rejoice, free from fear from any quarter;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:17.3"], "en": "live long, householder!", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:17.4"], "en": "Together with all his kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:17.5"], "en": "he dwells in that sorrowless, dust-free,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:17.6"], "en": "secure abode of the one who wields mastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:18.1"], "en": "Having practiced the Dhamma here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:18.2"], "en": "having given gifts as a householder,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:18.3"], "en": "and having removed the stain of stinginess along with its root—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:18.4"], "en": "\"Blameless, go to the heavenly realm.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_16:19.1"], "en": "Thus ends the fourth story, the Story of Nandā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"}
]
