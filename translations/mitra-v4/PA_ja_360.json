[
{"segs": ["PA_ja_360:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:0.2"], "en": "The Collection of Five,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:0.3"], "en": "Chapter on the Jeweled Earrings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:0.4"], "en": "10. The Suyonandī Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:1.1", "PA_ja_360:1.2"], "en": "“The fragrance of the *timira* flowers wafts abroad, and the sea of reeds resounds with sound.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:1.3"], "en": "“Far from here is Suyonandī;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:1.4"], "en": "copper-colored desires torment me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:2.1"], "en": "“How did you cross the ocean?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:2.2"], "en": "How did you see Sedumā?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:2.3", "PA_ja_360:2.4"], "en": "And how did the meeting with her and you in heaven come to pass?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:3.1"], "en": "“The ship of the merchants from Kurukaccha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:3.2"], "en": "who had set out seeking wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:3.3"], "en": "was overwhelmed by sea-monsters.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:3.4"], "en": "I floated upon a plank. She,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:4.1", "PA_ja_360:4.2"], "en": "who was always fragrant with sandalwood, with her gentle and soft [touch], [attended to me].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:4.3", "PA_ja_360:4.4"], "en": "Bhaddā, like a mother her own biological son,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:5.1"], "en": "rescued me with food and drink. Aṅga, [she was] my...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:5.2"], "en": "With clothing and with a bed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:5.3"], "en": "and even with yourself, O dull-eyed one—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:5.4"], "en": "know this thus, Tambā.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:6.1"], "en": "The Suyonandī Jātaka is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:6.2"], "en": "The first chapter, the Maṇikuṇḍala Vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:7.1"], "en": "Its summary verse (uddāna):", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:8.1"], "en": "Then the excellent Conqueror [took] a blade of green grass,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:8.2"], "en": "like a snake from a split boat or a jar; then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:8.3"], "en": "O elephant, he was again made to appear as if destroyed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_360:8.4"], "en": "\"By the supreme, highest deer-skin garment, ten [times].\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
