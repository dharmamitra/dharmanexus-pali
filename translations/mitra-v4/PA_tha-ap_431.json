[
{"segs": ["PA_tha-ap_431:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:0.2"], "en": "Chapter on the Once-Sweeper (Sakiṃsammajjaka-vagga), Number Nine:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:0.3"], "en": "The Apadāna of the Elder Sovaṇṇakiṅkaṇiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:1.1"], "en": "“Having gone forth out of faith,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:1.2"], "en": "I renounced the home life for homelessness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:1.3"], "en": "I was one who wore garments of bark.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:1.4", "PA_tha-ap_431:2.1", "PA_tha-ap_431:2.2"], "en": "The Blessed One Atthadassī, the elder of the world, the bull among men, looked upon his work of asceticism.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:2.3"], "en": "At that time he arose,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:2.4"], "en": "delivering the great multitude;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:3.1"], "en": "indeed, my strength has been exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:3.2", "PA_tha-ap_431:3.3"], "en": "Having remembered that best of Buddhas while suffering from a most severe illness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:3.4"], "en": "[he built] a supreme stupa on the sandy shore.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:4.1"], "en": "With a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:4.2", "PA_tha-ap_431:4.3"], "en": "I scattered golden kiṅkaṇī flowers with my own hands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:4.4"], "en": "With an uplifted mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:5.1"], "en": "as if in the very presence of the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:5.2"], "en": "I performed service to the stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:5.3", "PA_tha-ap_431:5.4"], "en": "Through that serene confidence in the Tathāgata Atthadassi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:6.1"], "en": "having gone to the world of the gods, he—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:6.2"], "en": "I obtain abundant happiness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:6.3"], "en": "there I was golden-hued—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:6.4"], "en": "this is the fruit of my worship of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:7.1", "PA_tha-ap_431:7.2"], "en": "Eighty million women, beautifully adorned,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:7.3"], "en": "were always attending upon me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:7.4"], "en": "This is the fruit of worshiping the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:8.1"], "en": "sixty thousand musical instruments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:8.2"], "en": "including drums and small kettledrums.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:8.3"], "en": "There, cymbals and drums,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:8.4"], "en": "and lovely kettledrums resound;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:9.1"], "en": "eighty-four thousand [instruments].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:9.2"], "en": "Elephants beautifully adorned,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:9.3", "PA_tha-ap_431:9.4"], "en": "noble tuskers sixty years of age, with temporal secretions flowing in three streams.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:10.1"], "en": "Covered all over with nets of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:10.2", "PA_tha-ap_431:10.3"], "en": "they wait upon me with their troops and elephants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:10.4"], "en": "No deficiency exists for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:11.1", "PA_tha-ap_431:11.2"], "en": "I am experiencing the fruit of golden kiṅkaṇī flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:11.3"], "en": "And fifty-eight times,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:11.4"], "en": "I exercised sovereignty over the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:12.1"], "en": "and seventy-one times...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:12.2"], "en": "I was a wheel-turning monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:12.3", "PA_tha-ap_431:12.4"], "en": "I exercised sovereignty over the earth for one hundred years.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:13.1"], "en": "Thus, having now attained the Deathless,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:13.2"], "en": "the unconditioned so difficult to see,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:13.3"], "en": "with all fetters utterly destroyed—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:13.4"], "en": "Now there is no further existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:14.1", "PA_tha-ap_431:14.2"], "en": "Because I offered that flower eighteen hundred eons ago, [I have attained this state].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:14.3"], "en": "I do not know a miserable rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:14.4"], "en": "this is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:15.1"], "en": "My defilements have been incinerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:15.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:15.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:16.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:16.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:16.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:17.1"], "en": "The four analytical knowledges (paṭisambhidā) have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:17.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:17.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:18.1"], "en": "Thus indeed did the Venerable Elder Sovaṇṇakiṅkaṇiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_431:19.1"], "en": "The legend of the Elder Sovaṇṇakiṅkaṇiya is the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
