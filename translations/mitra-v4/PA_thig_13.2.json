[
{"segs": ["PA_thig_13.2:0.1", "PA_thig_13.2:0.2"], "en": "Therīgāthā 13.2 Vīsatinipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:0.3"], "en": "The Verses of the Elder Nun Rohinī", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:1.1"], "en": "“‘Ascetics,’ you say while sleeping;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:1.2"], "en": "‘ascetics,’ you awaken;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:1.3"], "en": "you praise only ascetics.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:1.4"], "en": "\"You will surely become a female ascetic;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:2.1", "PA_thig_13.2:2.2"], "en": "you shall bestow abundant food and drink upon the ascetics.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:2.3"], "en": "Now, Rohiṇī, I ask you:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:2.4"], "en": "why are these ascetics dear to you?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:3.1"], "en": "They are inactive and indolent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:3.2"], "en": "Those who live on what is given by others,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:3.3"], "en": "full of longing and desiring the pleasant—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:3.4"], "en": "how could such ascetics be dear to you?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:4.1"], "en": "“After a long time indeed, dear son,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:4.2"], "en": "you question me about the ascetics;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:4.3"], "en": "I shall describe them to you.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:4.4"], "en": "Those who possess wisdom, virtue, and exertion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:5.1"], "en": "who are eager for work and untiring,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:5.2"], "en": "performing what is the best of deeds;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:5.3"], "en": "They abandon lust and hatred;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:5.4"], "en": "for that reason, the recluses are dear to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:6.1"], "en": "The three roots of evil—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:6.2"], "en": "Those who perform pure deeds shake off [all evil];", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:6.3"], "en": "having abandoned all wickedness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:6.4"], "en": "for that reason I hold the ascetics dear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:7.1"], "en": "Pure is their bodily action,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:7.2"], "en": "and likewise their verbal action;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:7.3"], "en": "pure is their mental action.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:7.4"], "en": "Therefore, these ascetics are dear to me—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:8.1"], "en": "stainless like conch shells or pearls,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:8.2"], "en": "pure both within and without.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:8.3"], "en": "Because of my fullness of bright qualities,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:8.4", "PA_thig_13.2:9.1"], "en": "I am fond of those ascetics who are learned and bearers of the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:9.2"], "en": "The noble ones live according to the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:9.3"], "en": "they teach both the goal and the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:9.4"], "en": "and for that reason the ascetics are dear to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:10.1"], "en": "Learned, upholders of the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:10.2"], "en": "noble ones who live according to the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:10.3"], "en": "with one-pointed minds and possessed of mindfulness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:10.4"], "en": "Therefore, these ascetics are dear to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:11.1"], "en": "those who travel far, who possess mindfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:11.2"], "en": "who speak with measured words, and who are free from agitation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:11.3"], "en": "They understand the end of suffering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:11.4", "PA_thig_13.2:12.1"], "en": "for that reason, I am fond of those ascetics from whom they depart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:12.2"], "en": "They do not look back at anything;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:12.3"], "en": "they go forth without longing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:12.4"], "en": "For that reason, these ascetics are dear to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:13.1"], "en": "They do not store [grain] in granaries,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:13.2", "PA_thig_13.2:13.3"], "en": "nor in jars, nor in baskets; seeking only what has been fully prepared, they live.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:13.4"], "en": "Therefore, these ascetics are dear to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:14.1", "PA_thig_13.2:14.2"], "en": "They do not take gold, nor silver, nor bullion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:14.3"], "en": "They subsist on what is present;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:14.4"], "en": "for that reason, these ascetics are dear to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:15.1"], "en": "Having gone forth from various clans, they live thus.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:15.2"], "en": "And from various countries;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:15.3"], "en": "they love one another,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:15.4"], "en": "and therefore the ascetics are dear to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:16.1"], "en": "“Truly for our benefit, O lady,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:16.2"], "en": "were you born in this family as Rohinī;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:16.3"], "en": "you have faith in the Buddha and in the Dhamma.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:16.4"], "en": "And you have intense reverence for the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:17.1"], "en": "For you indeed understand this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:17.2"], "en": "it is the unsurpassed field of merit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:17.3", "PA_thig_13.2:17.4"], "en": "\"These ascetics accept our offerings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:18.1"], "en": "for here the sacrifice is established.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:18.2"], "en": "“it will become vast for us”;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:18.3", "PA_thig_13.2:18.4"], "en": "“If you fear suffering, if suffering is unpleasant to you.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:19.1"], "en": "Go for refuge to the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:19.2"], "en": "to the Dhamma, and to the Tathāgata’s Saṅgha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:19.3"], "en": "undertake the precepts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:19.4"], "en": "That will be for your benefit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:20.1"], "en": "“I go for refuge to the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:20.2"], "en": "to the Dhamma, and to the Tathāgata’s Saṅgha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:20.3"], "en": "I undertake the precepts;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:20.4"], "en": "that will be for my welfare.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:21.1"], "en": "Formerly I was a kinsman of Brahmā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:21.2"], "en": "Thus, I am now a brahmin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:21.3"], "en": "I am a possessor of the three Vedas, a learned scholar,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:21.4"], "en": "a master of knowledge, and one who has performed the purificatory ablutions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thig_13.2:22.1"], "en": "… the elder nun Rohinī …", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
