[
{"segs": ["PA_ja_255:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_255:0.2", "PA_ja_255:0.3"], "en": "Tikanipāta, Saṅkappavagga (The Chapter on Intention)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_255:0.4"], "en": "5. The Sukajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_255:1.1", "PA_ja_255:1.2"], "en": "“As long as that bird did not know moderation in his food;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_255:1.3", "PA_ja_255:1.4"], "en": "He lived for such a long time and supported his mother;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_255:2.1"], "en": "yet when [the time] became even greater,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_255:2.2"], "en": "He consumed his food;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_255:2.3"], "en": "thereupon it was digested right then and there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_255:2.4"], "en": "for he had been one who lacked moderation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_255:3.1"], "en": "Therefore, moderation is good,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_255:3.2"], "en": "being free from greed for food;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_255:3.3"], "en": "for those who lack moderation sink down.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_255:3.4"], "en": "\"And knowing the proper measure, they do not sink.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_255:4.1"], "en": "Thus ends the *Sukajātaka*, the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
