[
{"segs": ["PA_ja_449:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:0.2"], "en": "The Tenth Chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:0.3"], "en": "The Section on the Four Gates (Catudvāravagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:0.4"], "en": "11. The Maṭṭhakuṇḍalī Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:1.1", "PA_ja_449:1.2"], "en": "“Adorned with polished earrings, wearing garlands, and anointed with yellow sandalwood paste;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:1.3"], "en": "“Raising up your arms you weep;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:1.4"], "en": "why are you so distressed in the middle of the forest?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:2.1"], "en": "“It was made of gold and radiant.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:2.2"], "en": "\"A chariot frame has arisen for me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:2.3"], "en": "but I cannot find a pair of wheels for it;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:2.4"], "en": "because of that suffering, I am giving up my life.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:3.1"], "en": "“Whether made of gold, of jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:3.2"], "en": "of iron, or of silver— proclaim it,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:3.3"], "en": "and I shall have a chariot made for you.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:3.4"], "en": "“I shall set the wheel and yoke in motion for you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:4.1"], "en": "That young brahmin replied to him:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:4.2"], "en": "“The moon and the sun are both brothers here.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:4.3"], "en": "“My chariot is made of gold;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:4.4"], "en": "it shines with its wheels and yoke.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:5.1"], "en": "“You are a fool, young man!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:5.2"], "en": "\"You who long for that which should not be longed for—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:5.3"], "en": "I think you will die,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:5.4"], "en": "for you shall never obtain the moon and the sun.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:6.1"], "en": "“Going and coming are seen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:6.2"], "en": "as are the colors and both the pathways;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:6.3"], "en": "but the deceased is not seen at all.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:6.4"], "en": "“Who indeed is more foolish than one who weeps?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:7.1"], "en": "“You speak the truth, young man;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:7.2"], "en": "I alone am more foolish than one who weeps.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:7.3"], "en": "Like a child crying for the moon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:7.4"], "en": "he yearned for a deceased one who had passed away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:8.1"], "en": "\"Alas, while I am burning, [he thinks of me].\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:8.2", "PA_ja_449:8.3"], "en": "Like a fire sprinkled with water, by pouring water upon it,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:8.4"], "en": "one should extinguish every dart.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:9.1", "PA_ja_449:9.2"], "en": "Truly, the dart that was lodged in my heart has been pulled out— for me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:9.3"], "en": "who was overcome by grief.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:9.4"], "en": "I have dispelled the grief for my son.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:10.1"], "en": "With the dart extracted,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:10.2"], "en": "I am free from sorrow and undisturbed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:10.3"], "en": "“I do not grieve, nor do I weep,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:10.4"], "en": "having heard this from you, young man.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_449:11.1"], "en": "Thus ends the eleventh Jātaka, the Maṭṭhakuṇḍalī Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
