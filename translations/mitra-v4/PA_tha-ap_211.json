[
{"segs": ["PA_tha-ap_211:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:0.2"], "en": "The Section on the Kaṇikāra Flower (Kaṇikārapupphiyavagga), Chapter 9.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:0.3"], "en": "The Legend of the Elder Ādhāradāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:1.1"], "en": "“A support was given by me to Sikhin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:1.2"], "en": "the Kinsman of the World;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:1.3"], "en": "I uphold the entire earth.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:1.4"], "en": "This entire earth alone remains.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:2.1"], "en": "My defilements have been incinerated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:2.2"], "en": "all states of existence have been utterly eradicated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:2.3", "PA_tha-ap_211:2.4"], "en": "I bear my final body within the teaching of the Perfectly Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:3.1"], "en": "Twenty-seven aeons from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:3.2"], "en": "There were four men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:3.3"], "en": "named Samantavaraṇa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:3.4"], "en": "they were wheel-turning monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:4.1", "PA_tha-ap_211:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:5.1"], "en": "Thus indeed the venerable elder Ādhāradāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_211:6.1"], "en": "This is the ninth legend of the elder Ādhāradāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
