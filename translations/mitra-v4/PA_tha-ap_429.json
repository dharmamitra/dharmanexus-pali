[
{"segs": ["PA_tha-ap_429:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:0.2"], "en": "Chapter on the Once-Sweeper (Sakiṃsammajjakavagga), Number Seven:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:0.3"], "en": "The Apadāna of the Elder Ekadhammasavaniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:1.2"], "en": "who has gone beyond all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:1.3"], "en": "was proclaiming the Four Truths.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:1.4"], "en": "He delivered many people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:2.1"], "en": "At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:2.2"], "en": "I was a matted-hair ascetic practicing fierce austerities.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:2.3"], "en": "Shaking off my bark garments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:2.4", "PA_tha-ap_429:3.1"], "en": "I then went through the air above the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:3.2"], "en": "I am not able to go;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:3.3"], "en": "like a bird striking against a rock,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:3.4"], "en": "I find no way to proceed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:4.1"], "en": "Having emerged from the water,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:4.2"], "en": "I thus travel through the sky;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:4.3"], "en": "this has never happened to me before.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:4.4"], "en": "There is the disturbance of my posture.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:5.1"], "en": "Come now, I shall search for it;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:5.2"], "en": "perhaps I may find it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:5.3"], "en": "Descending from the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:5.4", "PA_tha-ap_429:6.1"], "en": "he heard the voice of the Teacher with its enchanting tone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:6.2"], "en": "With a voice as beautiful as that of a thrush,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:6.3"], "en": "he spoke of impermanence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:6.4"], "en": "at that time, I grasped exactly what he said.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:6.5"], "en": "Having grasped the perception of impermanence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:6.6"], "en": "I went to my own hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:7.1"], "en": "having dwelt there for the full span of my life, I passed away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:7.2"], "en": "There I passed away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:7.3"], "en": "when my final existence was unfolding,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:7.4"], "en": "I recollected the hearing of the True Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:8.1", "PA_tha-ap_429:8.2"], "en": "By that well-performed kamma and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:8.3"], "en": "having abandoned this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:8.4"], "en": "I went to the realm of the Thirty-three;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:9.1"], "en": "for thirty thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:9.2"], "en": "I rejoiced in the world of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:9.3", "PA_tha-ap_429:9.4"], "en": "And fifty-one times I exercised sovereignty over the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:10.1"], "en": "and twenty-one times—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:10.2"], "en": "I was a wheel-turning monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:10.3", "PA_tha-ap_429:10.4"], "en": "my local sovereignty was vast and beyond counting.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:11.1"], "en": "I experience my own merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:11.2"], "en": "being happy in birth after birth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:11.3"], "en": "I recollect that perception.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:11.4"], "en": "Wandering through various states of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:11.5"], "en": "I did not penetrate the limit—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:11.6"], "en": "the deathless state of Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:12.1"], "en": "Seated in his father’s house,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:12.2"], "en": "the ascetic with developed faculties—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:12.3"], "en": "how does he illuminate it?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:12.4"], "en": "He proclaimed impermanence:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:13.1"], "en": "“Impermanent indeed are conditioned phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:13.2"], "en": "subject to arising and passing away.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:13.3"], "en": "Having arisen, they cease;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:13.4"], "en": "their subsiding is bliss.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:14.1"], "en": "Having heard this verse, together—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:14.2"], "en": "I recollected my former perceptions;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:14.3"], "en": "sitting upon a single seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:14.4"], "en": "I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:15.1"], "en": "Having reached the age of seven,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:15.2"], "en": "I attained arahantship;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:15.3"], "en": "the Buddha ordained me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:15.4"], "en": "This is the fruit of hearing the Dhamma:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:16.1", "PA_tha-ap_429:16.2"], "en": "that which I heard as the Dhamma back then, a hundred thousand eons ago;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:16.3"], "en": "I do not know a miserable rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:16.4"], "en": "this is the fruit of hearing the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:17.1"], "en": "The defilements have been burnt away by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:17.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:17.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:18.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:18.2", "PA_tha-ap_429:18.3"], "en": "... [as before] ... the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:19.1"], "en": "The four analytical knowledges (paṭisambhidā) [are attained].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:19.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:19.3"], "en": "the Buddha’s teaching has been fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:20.1"], "en": "Thus indeed did the Venerable Ekadhammasavaniya Thera speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_429:21.1"], "en": "The legend of the Elder Ekadhammasavaniya is the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
