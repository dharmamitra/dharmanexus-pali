[
{"segs": ["PA_snp_5.14:0.1", "PA_snp_5.14:0.2", "PA_snp_5.14:1.1"], "en": "Sutta Nipāta 5.14 Udaya-māṇava-pucchā “To the one sitting in meditation, free from passion, I asked: ‘What is your name?’”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:1.2"], "en": "(Thus spoke the Venerable Udaya:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:1.3"], "en": "\"One who has done what was to be done, who is free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:1.4"], "en": "and who has gone beyond all phenomena,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:1.5"], "en": "I have come with a question:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:1.6"], "en": "please explain the liberation through final knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:1.7"], "en": "the breaking asunder of ignorance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:2.1"], "en": "“The abandoning of sensual desires,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:2.2", "PA_snp_5.14:2.3"], "en": "(said the Blessed One,) and of both types of grief;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:2.4"], "en": "The dispelling of sloth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:2.5"], "en": "the warding off of remorse,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:3.1"], "en": "and that which is purified by equanimity and mindfulness—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:3.2"], "en": "Preceded by reflection on the nature of things,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:3.3"], "en": "I declare this to be the liberation through higher knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:3.4"], "en": "the breaking asunder of ignorance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:4.1"], "en": "“What is the fetter of the world?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:4.2", "PA_snp_5.14:4.3"], "en": "What is its deliberation? By the abandoning of what is one released?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:4.4"], "en": "“Nibbāna” is what is called [the goal].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:5.1"], "en": "“The world is bound by delight;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:5.2"], "en": "it is the investigation of thought.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:5.3"], "en": "“By the complete abandoning of craving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:5.4"], "en": "it is called Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:6.1"], "en": "“How does one who is mindful and walking,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:6.2"], "en": "Consciousness ceases;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:6.3"], "en": "having come to question the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:6.4"], "en": "we now hear this word of yours.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:7.1", "PA_snp_5.14:7.2"], "en": "For one who does not delight in feeling, whether internal or external,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:7.3"], "en": "thus dwelling mindful and practicing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:7.4"], "en": "“Consciousness ceases.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_5.14:7.5"], "en": "This is the thirteenth inquiry of the youth Udaya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
