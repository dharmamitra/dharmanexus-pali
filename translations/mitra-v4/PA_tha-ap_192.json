[
{"segs": ["PA_tha-ap_192:0.1", "PA_tha-ap_192:0.2", "PA_tha-ap_192:0.3"], "en": "The Apadāna of the Elder Tivaṇṭipupphiya Kuṭajapupphiyavagga 10. Tivaṇṭipupphiyattheraapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:1.1", "PA_tha-ap_192:1.2"], "en": "“But all of them, having come together, envy me who am overcome;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:1.3"], "en": "while they are thus envying me, [I remain unmoved].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:1.4"], "en": "A fever arose.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:2.1", "PA_tha-ap_192:2.2"], "en": "At that time, there was a disciple of the Buddha named Sunanda by name.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:2.3", "PA_tha-ap_192:2.4"], "en": "The sage Dhammadassi came into my presence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:3.1"], "en": "those who had been my companions...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:3.2"], "en": "They gave me flowers at that time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:3.3"], "en": "taking those flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:3.4"], "en": "I presented them to my disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:4.1"], "en": "Having passed away there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:4.2", "PA_tha-ap_192:4.3"], "en": "I was reborn once more after eighteen hundred eons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:4.4"], "en": "I shall not go to a state of ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:5.1"], "en": "For thirteen hundred aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:5.2"], "en": "there were eight [Buddhas] named Dhūmaketu.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:5.3"], "en": "Possessing the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:5.4"], "en": "they are wheel-turning monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:6.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:7.1"], "en": "Thus indeed did the venerable elder Tivaṇṭipupphiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:8.1"], "en": "The legend of the elder Tivaṇṭipupphiya is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:9.1"], "en": "The nineteenth chapter, the Kuṭajapupphiya-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:10.1"], "en": "Its summary (uddāna) is as follows:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:11.1"], "en": "Kuṭaja, bandhujīvī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:11.2"], "en": "koṭumbarika, hatthiya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:11.3"], "en": "isimugga, and bodhi—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:11.4"], "en": "The *Ekacintī*, the *Tikaṇṇiko*;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:11.5"], "en": "the *Ekacārī* and the *Tivaṇṭi*:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_192:11.6"], "en": "thus sixty-two verses have been proclaimed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
