[
{"segs": ["PA_bu-vb_sk44:0.1"], "en": "The Theravāda Vinaya Mahāvibhaṅga:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:0.2", "PA_bu-vb_sk44:0.3"], "en": "The Section on the Training Rules (Sekhiyakaṇḍa)", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:0.4", "PA_bu-vb_sk44:0.5", "PA_bu-vb_sk44:1.1"], "en": "At that time, the Buddha, the Blessed One, was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:1.2"], "en": "Now at that time, the group-of-six monks ate by tossing morsels into their mouths... [etc.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:1.3.1"], "en": "\"The training is to be observed: 'I shall not eat by tossing morsels.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:1.4"], "en": "One must not eat by tossing morsels.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:1.5"], "en": "Whoever, out of disrespect, eats by tossing up morsels of food, commits an offense of wrong-doing (dukkaṭa).", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:1.6.1", "PA_bu-vb_sk44:1.7"], "en": "There is no offense if it was unintentional.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:1.8", "PA_bu-vb_sk44:1.9", "PA_bu-vb_sk44:1.10"], "en": "In the case of one who is absent-minded, one who is unaware, or one who is ill.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:1.11"], "en": "In regard to snacks,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:1.12"], "en": "fruits and roots,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:1.13"], "en": "and in times of distress.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:1.14"], "en": "\"In the case of one who is insane,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:1.15"], "en": "or in the case of the first offender.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk44:1.16"], "en": "The fourth training rule is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
