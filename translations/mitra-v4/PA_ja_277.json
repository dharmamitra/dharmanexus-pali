[
{"segs": ["PA_ja_277:0.1"], "en": "Jātaka Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:0.2", "PA_ja_277:0.3"], "en": "Udapānavagga (The Chapter on the Well)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:0.4"], "en": "7. The Romaka Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:1.1", "PA_ja_277:1.2"], "en": "“O Romaka, for more than fifty years we have dwelt in the cave of Sela.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:1.3"], "en": "Since they have attained final Nibbāna and no longer transmigrate,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:1.4"], "en": "those egg-born ones formerly came into my hands;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:2.1"], "en": "why, Vakkaṅga, are you now so eager for them?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:2.2"], "en": "The birds resort to another mountain cave;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:2.3"], "en": "surely they do not think of me as they did before,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:2.4"], "en": "or perhaps these are not the same ones who lived here for so long.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:3.1"], "en": "“We know you; we are not deluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:3.2"], "en": "You alone are he, and we are yours, none other.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:3.3"], "en": "Yet your mind is corrupted toward these people.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:3.4"], "en": "“Because of that livelihood, we were terrified by him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_277:4.1"], "en": "Thus ends the seventh Jātaka, the Romaka-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
