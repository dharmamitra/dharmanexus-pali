[
{"segs": ["PA_ja_410:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:0.2"], "en": "The Section of Sevens,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:0.3"], "en": "Chapter on Gandhāra", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:0.4"], "en": "5. The Somadatta Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:1.1", "PA_ja_410:1.2"], "en": "“He who formerly rose up for me when I was far away in the forest;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:1.3"], "en": "Thus Mātanga is not seen;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:1.4"], "en": "where has Somadatta gone?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:2.1"], "en": "Or perhaps he lies here dead.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:2.2"], "en": "Licked by his calf like a mother cow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:2.3"], "en": "he lies fallen upon the ground, thinking,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:2.4"], "en": "\"Ah, I am indeed immortal.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:3.1"], "en": "“For one who has entered the homeless life,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:3.2"], "en": "for you who are fully liberated—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:3.3"], "en": "this is not good for a recluse.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:3.4"], "en": "“Whom you thus lament as a pet,” [the Buddha said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:4.1"], "en": "“Indeed, Sakka, through living together,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:4.2"], "en": "whether of a human or of a deer, [one grieves].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:4.3"], "en": "\"Love arises in the heart;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:4.4"], "en": "it is impossible not to grieve for that.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:5.1"], "en": "\"They weep for one who has died or is dying,\" [he said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:5.2"], "en": "They weep and they lament;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:5.3"], "en": "therefore, O seer, do not weep,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:5.4"], "en": "for the virtuous say that weeping is in vain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:6.1"], "en": "Indeed, O Brahmā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:6.2"], "en": "through weeping the dead and departed might rise up;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:6.3"], "en": "we shall all gather together and weep.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:6.4"], "en": "“‘Among the kinsmen of one another.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:7.1"], "en": "‘Alas, while I am burning,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:7.2"], "en": "like a fire fed with ghee;’”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:7.3"], "en": "As if sprinkling with water,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:7.4"], "en": "he extinguished all my distress.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:8.1"], "en": "Truly, he has extracted the arrow from me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:8.2"], "en": "You were the support of my heart;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:8.3", "PA_ja_410:8.4"], "en": "you who dispelled the grief for my son from me as I was overcome by sorrow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:9.1"], "en": "Thus, with the arrow extracted,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:9.2"], "en": "I am free from sorrow and undisturbed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:9.3"], "en": "I neither grieve nor weep.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:9.4"], "en": "“Having heard you, O Vāsava.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_410:10.1"], "en": "Thus ends the fifth Jātaka, the Somadatta-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
