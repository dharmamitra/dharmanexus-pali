[
{"segs": ["PA_thag_3.7:0.1", "PA_thag_3.7:0.2"], "en": "Theragāthā 3.7 Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.7:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.7:0.4"], "en": "The Verses of Vāraṇa Thera:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.7:1.1", "PA_thag_3.7:1.2"], "en": "“Whoever among humans here harms the lives of others;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.7:1.3", "PA_thag_3.7:1.4", "PA_thag_3.7:2.1"], "en": "The person who, with a mind of loving-kindness, falls away from both this world and the world beyond, is ruined in both places.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.7:2.2"], "en": "He has compassion for all living beings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.7:2.3", "PA_thag_3.7:2.4"], "en": "such a person indeed generates much merit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.7:3.1"], "en": "One should train in what is well-spoken,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.7:3.2"], "en": "in attending upon recluses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.7:3.3"], "en": "and in sitting alone in seclusion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.7:3.4"], "en": "\"And for the tranquility of the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.7:3.5"], "en": "...The Elder Vāraṇa...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
