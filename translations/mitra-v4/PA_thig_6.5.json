[
{"segs": ["PA_thig_6.5:0.1", "PA_thig_6.5:0.2"], "en": "Therīgāthā 6.5 Chakkanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:0.3"], "en": "The Verses of the Elder Nun Anopamā", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:1.1"], "en": "“I was born into a high-born family,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:1.2"], "en": "possessing great wealth and vast riches;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:1.3"], "en": "I was endowed with beauty and form.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:1.4", "PA_thig_6.5:2.1", "PA_thig_6.5:2.2"], "en": "The daughter born of Majjha was sought after by princes and coveted by the sons of wealthy merchants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:2.3"], "en": "My father sent a messenger, saying:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:2.4"], "en": "\"Give me this peerless one.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:3.1"], "en": "However much she has been weighed, [so much is her value].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:3.2"], "en": "\"Your daughter is incomparable;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:3.3", "PA_thig_6.5:3.4"], "en": "therefore, I shall give you eightfold more gold and precious gems.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:4.1"], "en": "Having seen the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:4.2"], "en": "the supreme elder of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:4.3"], "en": "I paid homage at his feet.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:4.4"], "en": "I sat down to one side.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:5.1", "PA_thig_6.5:5.2"], "en": "Out of compassion, Gotama taught the Dhamma to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:5.3"], "en": "Seated upon that very seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:5.4"], "en": "I attained the third fruit; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:6.1"], "en": "having cut off my hair, I departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:6.2"], "en": "I went forth into homelessness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:6.3", "PA_thig_6.5:6.4"], "en": "today is my seventh night since craving has been dried up.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.5:7.1"], "en": "… the elder nun Anopamā …", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"}
]
