[
{"segs": ["PA_tha-ap_352:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:0.2"], "en": "Ekapadumiya Chapter 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:0.3"], "en": "The Apadāna of the Elder Ekañjaliya", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:1.1", "PA_tha-ap_352:1.2"], "en": "“At that time, the Sambuddha named Romaso was dwelling on the riverbank;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:1.3"], "en": "I saw the stainless Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:1.4"], "en": "Like the sun with its yellow rays,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:2.1"], "en": "like a piece of khadira wood struck by the mouth of a forge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:2.2"], "en": "resembling glowing embers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:2.3"], "en": "Shining like a medicinal herb,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:2.4"], "en": "I offered a single añjali to him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:3.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:3.2"], "en": "I paid homage with palms joined;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:3.3"], "en": "I do not know a state of woe—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:3.4"], "en": "this is the fruit of joining my palms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:4.1", "PA_tha-ap_352:4.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:5.1"], "en": "Thus indeed did the venerable elder Ekañjaliya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:6.1"], "en": "This is the tenth legend of the elder Ekañjaliya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:7.1"], "en": "The thirty-fifth chapter, Ekapadumiya-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:8.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:9.1"], "en": "Padumī, Uppalamālī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:9.2"], "en": "Dhaja, Kiṅkaṇika, and Naḷa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:9.3"], "en": "The Campaka, Paduma, Muṭṭhi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:9.4"], "en": "Tinduka, and Ekañjali [Suttas],", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:9.5"], "en": "along with sixty-six verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_352:9.6"], "en": "They are counted by those who possess supernormal powers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
