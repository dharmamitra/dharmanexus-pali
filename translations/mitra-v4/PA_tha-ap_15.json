[
{"segs": ["PA_tha-ap_15:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:0.2"], "en": "The Chapter on the Lion Throne (Sīhāsaniyavagga), 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:0.3"], "en": "The Apadāna of the Elder Nanda.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:1.1"], "en": "“To the Blessed One Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:1.2"], "en": "the World’s Best, the Neutral One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:1.3"], "en": "a linen garment was given by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:1.4"], "en": "To the Self-Existent One, the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:2.1", "PA_tha-ap_15:2.2"], "en": "The Buddha named Jalajuttara gave that explanation to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:2.3"], "en": "“By this gift of cloth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:2.4"], "en": "you will become golden-hued.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:3.1"], "en": "Having experienced two successes, [you will attain the third].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:3.2"], "en": "Urged by the roots of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:3.3", "PA_tha-ap_15:3.4"], "en": "you shall become the younger brother of the Blessed One Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:4.1"], "en": "One who is devoted to passion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:4.2"], "en": "habituated to pleasure, and bound by greed for sensual desires,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:4.3"], "en": "even when exhorted by the Buddha, remains thus.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:4.4"], "en": "Then you shall go forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:5.1"], "en": "Having gone forth there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:5.2"], "en": "impelled by the root of merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:5.3"], "en": "“Having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:5.4"], "en": "I shall attain Nibbāna, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:6.1"], "en": "Within seven thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:6.2"], "en": "There were four named Ceḷa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:6.3"], "en": "sixty thousand eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:6.4"], "en": "there were four men named Upaceḷa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:7.1"], "en": "In five thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:7.2", "PA_tha-ap_15:7.3"], "en": "four men who were like servants became endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:7.4"], "en": "The lords over the four continents;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:8.1", "PA_tha-ap_15:8.2"], "en": "the four analytical knowledges and these eight liberations;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:8.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:8.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:9.1"], "en": "Thus indeed did the elder Venerable Nanda speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_15:10.1"], "en": "The legend of the Elder Nanda is the third.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
