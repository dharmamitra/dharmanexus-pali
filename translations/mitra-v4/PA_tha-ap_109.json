[
{"segs": ["PA_tha-ap_109:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:0.2"], "en": "Bhikkhadāyivagga 7.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:0.3"], "en": "The Apadāna of the Elder Naḷamāliya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:1.1"], "en": "“Of the Buddha Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:1.2"], "en": "the World’s Elder, the Neutral One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:1.3"], "en": "as he sat upon a bed of grass;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:1.4"], "en": "To that one who was thus tranquil,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:2.1"], "en": "I took a reed-fiber,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:2.2"], "en": "bound it together, and made it into a fan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:2.3"], "en": "I offered it to the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:2.4"], "en": "the Lord of bipeds, the Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:3.1"], "en": "Having accepted it, the Omniscient One—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:3.2"], "en": "The Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:3.3"], "en": "knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:3.4"], "en": "spoke this verse: \"Bījaṇi.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:4.1", "PA_tha-ap_109:4.2"], "en": "\"Just as my body is cooled and no fever remains,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:4.3"], "en": "so too [let it be] by means of the three fires.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:4.4"], "en": "May your mind be liberated!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:5.1", "PA_tha-ap_109:5.2"], "en": "May all the gods, whoever they may be who dwell in the forest, assemble here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:5.3"], "en": "We shall hear the word of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:5.4"], "en": "making the donor rejoice;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:6.1"], "en": "the Blessed One was seated there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:6.2"], "en": "Honored by the assembly of gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:6.3", "PA_tha-ap_109:6.4"], "en": "he spoke these verses, gladdening the donor:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:7.1"], "en": "“By means of this seed as a cause,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:7.2"], "en": "and through the aspirations of my mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:7.3"], "en": "[he was born] by the name of Subbata.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:7.4"], "en": "He will become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:8.1", "PA_tha-ap_109:8.2"], "en": "Urged on by the remainder of that karma and by the root of merit, he will do so.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:8.3", "PA_tha-ap_109:8.4"], "en": "\"One named Māluta shall become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:9.1"], "en": "By means of this seed as a cause,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:9.2"], "en": "And through abundant honor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:9.3", "PA_tha-ap_109:9.4"], "en": "one does not fall into an evil rebirth even for a hundred thousand eons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:10.1"], "en": "In thirty thousand kappas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:10.2"], "en": "those thirty-eight were well-disciplined;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:10.3"], "en": "in twenty-nine thousand [kappas],...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:10.4"], "en": "Eight named Māluta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:11.1", "PA_tha-ap_109:11.2"], "en": "The four analytical knowledges (paṭisambhidā), ... [and so forth] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:11.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:12.1"], "en": "Thus indeed the Venerable Elder Naḷamāliya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:13.1"], "en": "This is the seventh legend of the Elder Naḷamāliya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_109:13.2"], "en": "The Seventh Recitation Section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
