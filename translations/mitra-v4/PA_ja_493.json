[
{"segs": ["PA_ja_493:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:0.2"], "en": "Miscellaneous Section,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:0.3"], "en": "Chapter on the Rice Field of Śāli Rice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:0.4"], "en": "10. The Mahāvāṇija Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:1.1", "PA_ja_493:1.2"], "en": "Merchants from various countries, having formed a caravan, arrived [there].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:1.3"], "en": "The wealth-seekers departed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:1.4"], "en": "leaving the village headman alone.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:2.1"], "en": "Having reached that wilderness, they...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:2.2"], "en": "With little food and no water,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:2.3"], "en": "they saw a great banyan tree with cool shade,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:2.4"], "en": "enchanting to the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:3.1", "PA_ja_493:3.2"], "en": "And having sat down there in the shade of that tree,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:3.3"], "en": "those merchants reflected:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:3.4"], "en": "Fools are shrouded by delusion:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:4.1"], "en": "\"This tree is alive;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:4.2"], "en": "even water flows from it.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:4.3", "PA_ja_493:4.4"], "en": "\"Come now, merchants, let us cut off its eastern branch.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:5.1"], "en": "And once it was cut, it flowed forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:5.2"], "en": "The water was clear and undisturbed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:5.3"], "en": "having bathed there and drunk their fill,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:5.4"], "en": "the merchants remained for as long as they wished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:6.1", "PA_ja_493:6.2"], "en": "The fools, shrouded in delusion, thought a second time:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:6.3"], "en": "\"Come now, let us [cut] this southern branch.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:6.4"], "en": "\"We are merchants cutting [the tree];", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:7.1"], "en": "it has been cut down and is exuding [sap],", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:7.2"], "en": "along with much boiled rice and meat.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:7.3"], "en": "In water-colored gruel,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:7.4"], "en": "with lentils and split-pea soup;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:8.1"], "en": "having eaten and consumed those there, they—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:8.2"], "en": "As much as the merchants desired,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:8.3", "PA_ja_493:8.4"], "en": "the fools, shrouded in delusion, thought about it for a third time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:8.5", "PA_ja_493:8.6"], "en": "\"Come now, merchants, let us cut off its last branch.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:9.1"], "en": "And once it was cut, it flowed with sap.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:9.2"], "en": "Women were beautifully adorned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:9.3"], "en": "wearing variegated garments and ornaments,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:9.4"], "en": "with jeweled earrings fastened upon them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:10.1", "PA_ja_493:10.2", "PA_ja_493:10.3"], "en": "Then one merchant and twenty-five women surrounded him on all sides.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:10.4"], "en": "By means of that tree’s shade,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:11.1", "PA_ja_493:11.2"], "en": "those merchants enjoyed themselves as long as they desired.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:11.3", "PA_ja_493:11.4"], "en": "The fools, shrouded in delusion, thought about this for a fourth time:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:11.5"], "en": "\"Come now, let us climb the northern branch.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:11.6"], "en": "\"We merchants cut through it,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:12.1", "PA_ja_493:12.2"], "en": "and once severed, it flowed forth with many pearls and beryl.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:12.3"], "en": "Silver and gold,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:12.4"], "en": "skins and fine cloths,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:13.1"], "en": "and garments of Kāsī silk.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:13.2"], "en": "And Uddiyāna and Kambala;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:13.3"], "en": "having bound their wares there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:13.4"], "en": "the merchants remained for as long as they desired.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:14.1", "PA_ja_493:14.2"], "en": "The fools, shrouded in delusion, deliberated on this fifth [alternative]:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:14.3"], "en": "\"Come now, let us cut off his root.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:14.4"], "en": "We receive even more than that.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:15.1"], "en": "Then the Caravan Leader,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:15.2"], "en": "with palms joined in reverence, made his request.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:15.3"], "en": "What does Nigrodha regret?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:15.4"], "en": "\"Merchants, may it be well with you!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:16.1"], "en": "The eastern branch was the giver of water.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:16.2"], "en": "Food and drink are the southern branch;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:16.3"], "en": "women are the western branch;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:16.4"], "en": "and all sensual pleasures are the northern branch.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:16.5"], "en": "What does Nigrodha regret?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:16.6"], "en": "May it be well with you, merchant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:17.1"], "en": "[It is the regret] for the shade of that tree—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:17.2"], "en": "One may sit or lie down [under it],", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:17.3"], "en": "but one should not break its branch,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:17.4"], "en": "for the betrayer of friends is evil.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:18.1"], "en": "And not heeding her, many [men],", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:18.2", "PA_ja_493:18.3"], "en": "with sharpened axes, [struck] the word of one.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:18.4"], "en": "They attacked him from the very root.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:19.1", "PA_ja_493:19.2"], "en": "Then twenty-five nāgas emerged, fully armed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:19.3", "PA_ja_493:19.4"], "en": "“Three hundred archers and six thousand mail-clad warriors—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:20.1"], "en": "slay these men and bind them!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:20.2"], "en": "\"Do not let them escape with their lives;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:20.3"], "en": "like a caravan leader setting aside his own,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:20.4"], "en": "reduce them all to ashes!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:21.1"], "en": "“Therefore, indeed, a wise person,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:21.2"], "en": "seeing his own welfare,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:21.3"], "en": "should not come under the power of greed.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:21.4"], "en": "One should slay the mind that seeks sensual pleasure.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:22.1"], "en": "Having thus understood this danger—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:22.2"], "en": "that craving is the origin of suffering—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:22.3"], "en": "“Free from craving, without grasping,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:22.4"], "en": "let the mindful bhikkhu wander forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_493:23.1"], "en": "Thus ends the tenth Jātaka, the Mahāvāṇijajātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
