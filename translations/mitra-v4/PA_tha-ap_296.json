[
{"segs": ["PA_tha-ap_296:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:0.2"], "en": "Chapter on Those Who Honored the Pile of Firewood, 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:0.3"], "en": "The Apadāna of the Elder Saddasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:1.1"], "en": "“When the sun had risen,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:1.2", "PA_tha-ap_296:1.3"], "en": "a vast radiance appeared in the world for the Best of Buddhas.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:1.4"], "en": "The manifestation of the Great Sage appeared there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:2.1"], "en": "I heard his voice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:2.2"], "en": "yet I did not see that Conqueror.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:2.3"], "en": "Having encountered death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:2.4"], "en": "I recollected the perception of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:3.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:3.2"], "en": "Whatever perception I attained then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:3.3"], "en": "I do not know any state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:3.4"], "en": "this is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:4.1", "PA_tha-ap_296:4.2"], "en": "The four analytical knowledges... [and so on]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:5.1"], "en": "Thus indeed the venerable elder Saddasaññaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_296:6.1"], "en": "This is the fourth legend of the elder Saddasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
