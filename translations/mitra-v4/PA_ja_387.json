[
{"segs": ["PA_ja_387:0.1", "PA_ja_387:0.2"], "en": "The Jātaka: The Sixth Book of Birth Stories,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:0.3"], "en": "Chapter on Kharaputta.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:0.4", "PA_ja_387:1.1"], "en": "2. The Sūci Jātaka “Neither harsh nor rough,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:1.2"], "en": "well-washed and well-polished;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:1.3", "PA_ja_387:1.4"], "en": "Who would wish to buy a needle that is fine, sharp-pointed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:2.1"], "en": "well-polished, and well-whetted?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:2.2", "PA_ja_387:2.3", "PA_ja_387:2.4"], "en": "Who would wish to buy a needle that is gradually rounded, thick at the tip, and stiff?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:3.1"], "en": "“Now these are being spread out—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:3.2", "PA_ja_387:3.3"], "en": "needles and fish-hooks; who is this in the smith’s village?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:3.4"], "en": "He wishes to sell needles.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:4.1"], "en": "From here, weapons go forth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:4.2"], "en": "as do various and manifold crafts.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:4.3"], "en": "\"This man here, in the smith's village,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:4.4"], "en": "wishes to sell a needle.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:5.1"], "en": "\"A needle, in the smith's village...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:5.2"], "en": "It must be forfeited by one who understands;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:5.3", "PA_ja_387:5.4"], "en": "for it is the teachers alone who know an action as well-done or ill-done.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:6.1"], "en": "And if your father, Bhaddā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:6.2"], "en": "were to know that this needle was made by me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:6.3"], "en": "and were to invite me [to his home] because of it—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:6.4"], "en": "\"And whatever other wealth there is in the house.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_387:7.1"], "en": "The Second Sūci Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
