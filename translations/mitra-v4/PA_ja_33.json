{"segs": ["PA_ja_33:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_33:0.2", "PA_ja_33:0.3"], "en": "Ekakanipāta, Kulāvakavagga (The Chapter on the Bird’s Nest)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_33:0.4"], "en": "3. The Sammodamāna Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_33:1.1", "PA_ja_33:1.2"], "en": "“Birds go along in harmony, taking up their webbed feet.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_33:1.3"], "en": "\"When they fall into dispute,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_33:1.4"], "en": "then they will come under my power.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_33:2.1"], "en": "Thus ends the third Jātaka, the *Sammodamāna-jātaka*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
