[
{"segs": ["PA_ja_298:0.1"], "en": "Jātaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:0.2"], "en": "Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:0.3"], "en": "Kumbhavagga", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:0.4"], "en": "8. The Udumbara Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:1.1", "PA_ja_298:1.2"], "en": "“Here these udumbara fruits have ripened, as well as those of the nigrodha and the kapittha trees.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:1.3"], "en": "\"Come, go forth and eat;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:1.4"], "en": "why do you perish from hunger?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:2.1"], "en": "\"In this way he becomes well-fed.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:2.2"], "en": "He who honors the aged,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:2.3", "PA_ja_298:2.4"], "en": "as I am well-fed today after subsisting on the fruits of trees.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:3.1"], "en": "“If one forest-dweller should deceive another forest-dweller,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:3.2"], "en": "as one monkey might deceive another monkey,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:3.3"], "en": "would that young monkey believe him?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:3.4"], "en": "\"For one who is old is not truly aged.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_298:4.1"], "en": "Thus ends the eighth Jātaka, the Udumbara Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
