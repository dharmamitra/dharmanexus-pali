[
{"segs": ["PA_tha-ap_338:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:0.2"], "en": "Gandhodakavagga 6.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:0.3"], "en": "The Apadāna of the Elder Pabhaṅkara", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:1.1"], "en": "“In the forest of the Blessed One Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:1.2"], "en": "the World’s Elder, the Neutral One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:1.3"], "en": "there was a shrine.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:1.4"], "en": "Teeming with wild beasts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:2.1", "PA_tha-ap_338:2.2"], "en": "no one was able to go there to pay homage at the cetiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:2.3", "PA_tha-ap_338:2.4"], "en": "The shrine was overgrown and ruined, covered with grass, wood, and creepers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:3.1"], "en": "At that time, I was a forest worker.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:3.2"], "en": "With my mind intent on my father and mother,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:3.3"], "en": "I saw in the forest a ruined stupa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:3.4"], "en": "overgrown with grass and creepers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:4.1"], "en": "Having seen the Buddha’s stupa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:4.2"], "en": "I established a mind of reverence:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:4.3"], "en": "\"This is the stupa of the Best of Buddhas.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:4.4"], "en": "He remains hidden in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:5.1", "PA_tha-ap_338:5.2"], "en": "It is neither fitting nor appropriate for one who knows the difference between virtue and vice to remain concealed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:5.3"], "en": "Without having cleansed the Buddha-stupa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:5.4"], "en": "one should employ oneself in other work,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:6.1"], "en": "such as gathering grass, wood, and creepers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:6.2", "PA_tha-ap_338:6.3"], "en": "Having cleansed the stupa and paid homage eight times,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:6.4"], "en": "I departed with my face turned away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:7.1", "PA_tha-ap_338:7.2"], "en": "By that well-performed kamma and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:7.3"], "en": "having cast off this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:7.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:8.1", "PA_tha-ap_338:8.2"], "en": "There, for me, a well-constructed celestial mansion was made, golden and radiant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:8.3"], "en": "Sixty yojanas in height,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:8.4"], "en": "thirty yojanas in width;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:9.1"], "en": "and three hundred times—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:9.2"], "en": "I exercised sovereignty over the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:9.3"], "en": "and twenty-five times,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:9.4"], "en": "I was a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:10.1"], "en": "Wandering through various states of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:10.2"], "en": "I obtained great wealth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:10.3"], "en": "there was no deficiency in my riches.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:10.4"], "en": "This is the fruit for its purification:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:11.1", "PA_tha-ap_338:11.2"], "en": "when I was traveling through the forest on the back of an elephant, carried in a palanquin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:11.3"], "en": "To whichever direction I go,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:11.4"], "en": "I fall into the forest as my refuge;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:12.1"], "en": "whether upon a stump or even a thorn.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:12.2"], "en": "I do not see them with my eyes;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:12.3"], "en": "bound by meritorious deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:12.4"], "en": "they have removed themselves by their own accord.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:13.1"], "en": "I have no leprosy, no boils, no white leprosy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:13.2", "PA_tha-ap_338:13.3"], "en": "no skin disease, no itch, no scabies, and no ringworm.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:13.4"], "en": "This is the fruit for the sake of purification.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:14.1", "PA_tha-ap_338:14.2"], "en": "There is another marvel for me regarding the cleaning of the Buddha’s stupa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:14.3", "PA_tha-ap_338:14.4"], "en": "I do not recall any eruption or pimple ever having appeared on my body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:15.1"], "en": "Another marvel of mine is this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:15.2"], "en": "When the Buddha’s stupa had been cleansed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:15.3"], "en": "I transmigrated through two existences:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:15.4"], "en": "among the gods and then among humans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:16.1", "PA_tha-ap_338:16.2"], "en": "There was another marvel for me when the Buddha’s stupa had been cleaned:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:16.3"], "en": "it was golden-hued everywhere.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:16.4"], "en": "\"I became radiant. Furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:17.1", "PA_tha-ap_338:17.2"], "en": "another marvel occurred for me when the Buddha’s stupa had been cleaned.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:17.3"], "en": "The unpleasant is avoided,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:17.4"], "en": "and the pleasant attends upon me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:18.1"], "en": "There is another marvel for me as well:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:18.2"], "en": "When the Buddha’s stupa has been cleansed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:18.3"], "en": "my mind becomes purified,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:18.4"], "en": "one-pointed, and well-concentrated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:19.1", "PA_tha-ap_338:19.2"], "en": "There was another marvel for me when the Buddha’s stupa had been cleaned:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:19.3"], "en": "sitting upon a single seat, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:19.4"], "en": "I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:20.1", "PA_tha-ap_338:20.2"], "en": "That deed which I performed then, a hundred thousand aeons ago;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:20.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:20.4"], "en": "this is the fruit of purification.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:21.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:21.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:21.3"], "en": "the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:22.1"], "en": "Thus indeed did the venerable elder Pabhaṅkara speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_338:23.1"], "en": "The legend of the Elder Pabhankara is the sixth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
