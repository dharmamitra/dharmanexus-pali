[
{"segs": ["PA_ja_393:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:0.2"], "en": "The Sixth Book,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:0.3"], "en": "The Chapter on Kharaputta", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:0.4", "PA_ja_393:1.1", "PA_ja_393:1.2"], "en": "8. The Vighāsāda Jātaka “Very happy indeed live those people who subsist on leftovers;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:1.3"], "en": "\"Praised in this very life,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:1.4"], "en": "and a happy destination in the world beyond.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:2.1"], "en": "\"For one who speaks of happiness...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:2.2"], "en": "The wise should not pay heed to this;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:2.3"], "en": "listen to this, O siblings:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:2.4"], "en": "\"It is us that he praises.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:3.1", "PA_ja_393:3.2"], "en": "“I do not praise you; listen to me, you who feed on corpses!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:3.3"], "en": "You are eaters of leftovers.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:3.4"], "en": "\"You are not scavengers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:4.1"], "en": "\"We have been ordained for seven years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:4.2"], "en": "peacocks in the middle of the forest.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:4.3"], "en": "If we, who subsist on mere scraps,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:4.4"], "en": "are to be censured by you, sir,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:4.5"], "en": "then who indeed would be worthy of praise?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:5.1"], "en": "“You who subsist on the leftovers of lions, tigers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:5.2", "PA_ja_393:5.3"], "en": "and wild beasts, living indeed upon what has been cast off— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:5.4"], "en": "You are but scavengers, living on scraps—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:6.1", "PA_ja_393:6.2"], "en": "those who [live off] a brahmin, an ascetic, or any other mendicant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:6.3"], "en": "\"Having given what remains, they eat;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:6.4"], "en": "those people are the 'scavengers' (vighāsādino).", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_393:7.1"], "en": "Thus ends the eighth Jātaka, the Vighāsāda Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
