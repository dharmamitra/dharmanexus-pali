[
{"segs": ["PA_tha-ap_135:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:0.2"], "en": "Sobhitavagga 3:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:0.3"], "en": "The Apadāna of the Elder Candanapūjanaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:1.1"], "en": "“On the banks of the Candabhāgā River,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:1.2"], "en": "I was then a kinnara;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:1.3"], "en": "I subsisted on flowers.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:1.4", "PA_tha-ap_135:2.1", "PA_tha-ap_135:2.2"], "en": "Likewise, the Blessed One Atthadassī, the eldest in the world, the bull among men, was clothed in flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:2.3"], "en": "He went forth through the opening at the tip of the grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:2.4"], "en": "like a king of swans in the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:3.1"], "en": "Homage to you, O noble being!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:3.2"], "en": "Your mind is thoroughly purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:3.3", "PA_tha-ap_135:3.4"], "en": "the color of your face is serene, and your facial faculties are perfectly clear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:4.1"], "en": "Having descended from the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:4.2", "PA_tha-ap_135:4.3"], "en": "the one of vast wisdom and great intelligence spread out his outer robe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:4.4"], "en": "He sat down cross-legged.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:5.1"], "en": "Taking some melted sandalwood paste,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:5.2"], "en": "I went into the presence of the Conqueror.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:5.3"], "en": "With a serene mind and joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:5.4"], "en": "I offered it to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:6.1"], "en": "Having paid homage to the Fully Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:6.2", "PA_tha-ap_135:6.3"], "en": "Having generated joy toward the Eldest of the World, the Bull among Men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:6.4"], "en": "I departed facing northward.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:7.1"], "en": "In eighteen hundred kappas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:7.2"], "en": "because I worshipped with sandalwood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:7.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:7.4"], "en": "This is the fruit of worshiping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:8.1", "PA_tha-ap_135:8.2"], "en": "Fourteen hundred eons from now, those three existed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:8.3"], "en": "Named Rohaṇī by name,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:8.4"], "en": "she was a Cakkavattin of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:9.1"], "en": "She possessed the four analytical knowledges (paṭisambhidā).", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:9.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:9.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:10.1"], "en": "Thus indeed did the Venerable Elder Candanapūjanaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:11.1"], "en": "The legend of the Elder Candanapūjanaka is the third.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_135:11.2"], "en": "The eighth recitation section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
