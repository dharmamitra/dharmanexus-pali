[
{"segs": ["PA_mil_3.5.5:0.1"], "en": "The Questions of Milinda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:0.2"], "en": "Chapter on the Buddha, 5.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:0.3"], "en": "The Question on Non-Transmigration and Re-linking of Consciousness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:1.1"], "en": "The King said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:1.2"], "en": "\"Venerable Nāgasena, does it not transmigrate and yet undergo rebirth?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:1.3"], "en": "\"Yes, Great King, it does not transmigrate and yet undergoes rebirth.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:1.4"], "en": "“Venerable Nāgasena, how is it that there is no transmigration, yet there is rebirth-linking? Please provide a simile.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:1.5"], "en": "“Great King, suppose a man were to light one lamp from another lamp. Great King, has that lamp transmigrated from the first lamp?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:1.6"], "en": "“No, venerable sir.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:1.7"], "en": "“In the same way, great king, it neither transmigrates nor is it reborn.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:2.1"], "en": "“Give me a further simile.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:2.2"], "en": "“Do you remember, great king, when you were young, learning some verses from a teacher of poetry? “Yes, I do.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:2.3"], "en": "“Yes, venerable sir,” he replied.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:2.4"], "en": "“But, great king, did that verse pass over from the teacher?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:2.5"], "en": "“No, venerable sir.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:2.6"], "en": "“In the same way, Great King, it neither transmigrates nor is it reborn.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:3.1"], "en": "“Excellent, venerable Nāgasena!", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.5.5:4.1"], "en": "This is the fifth question, concerning non-transmigration and rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"}
]
