[
{"segs": ["PA_bu-vb_sk4:0.1"], "en": "The Theravāda Vinaya Mahāvibhaṅga:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:0.2", "PA_bu-vb_sk4:0.3"], "en": "The Section on the Training Rules (Sekhiyakaṇḍa)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:0.4"], "en": "The Chapter on the Circular (Parimaṇḍalavagga) 4.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:0.5"], "en": "The Second Training Rule on Being Well-Covered.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:1.1"], "en": "At that time, the Buddha, the Blessed One, was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:1.2"], "en": "Now at that time, the group-of-six monks sat in inhabited areas with their bodies uncovered...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:1.3.1"], "en": "[as before] ... \"The training is to be observed: 'I shall sit well-covered in inhabited areas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:1.4"], "en": "One must sit well-covered in inhabited areas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:1.5"], "en": "Whoever, out of disrespect, uncovers his body and sits down in an inhabited area, commits an offense of wrong-doing (*dukkaṭa*).", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:1.6.1", "PA_bu-vb_sk4:1.7"], "en": "There is no offense if it was unintentional.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:1.8"], "en": "For one who is absent-minded,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:1.9"], "en": "for one who is unaware,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:1.10"], "en": "and for one who is ill.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:1.11"], "en": "For one who has entered upon the rains residence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:1.12", "PA_bu-vb_sk4:1.13"], "en": "for one in times of distress, and for one who is insane.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:1.14"], "en": "\"For one who is a first offender\":", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bu-vb_sk4:1.15"], "en": "thus ends the fourth training rule.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
