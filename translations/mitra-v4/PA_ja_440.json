[
{"segs": ["PA_ja_440:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:0.2"], "en": "The Collection of Ten Birth Stories,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:0.3"], "en": "Chapter on the Four Gates.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:0.4"], "en": "2. The Kaṇha Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:1.1", "PA_ja_440:1.2"], "en": "“Truly black is this man, and he eats black food;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:1.3"], "en": "“Though he dwells in a dark region,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:1.4"], "en": "he is not dear to my mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:2.1"], "en": "“He is not black by his skin;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:2.2"], "en": "For a brahmin is defined by his inner essence;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:2.3", "PA_ja_440:2.4"], "en": "he in whom evil deeds reside is indeed \"black,\" Sujampati.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:3.1"], "en": "“Since you have spoken so well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:3.2"], "en": "with such fitting and eloquent words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:3.3"], "en": "O brahmin, I grant you a boon.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:3.4"], "en": "“Whatever you desire in your mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:4.1"], "en": "“If you would grant me a boon, O Sakka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:4.2"], "en": "Lord of all beings;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:4.3"], "en": "I long for my own way of life to be free from anger,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:4.4"], "en": "free from hatred, free from greed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:4.5"], "en": "and free from passion.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:4.6"], "en": "\"These are my four boons.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:5.1", "PA_ja_440:5.2"], "en": "\"What then, O Brahmin, regarding anger or hatred, greed or affection?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:5.3"], "en": "“You see danger;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:5.4"], "en": "tell it to me when asked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:6.1"], "en": "“Being few, one becomes many.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:6.2"], "en": "He grows through the production of impatience;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:6.3"], "en": "being full of attachment and much distress,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:6.4"], "en": "one should therefore not take pleasure in anger.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:7.1"], "en": "Harsh speech follows from a corrupt mind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:7.2", "PA_ja_440:7.3"], "en": "and immediately after that comes slander; then the hand, and then the staff.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:7.4"], "en": "The ultimate course of a weapon is hatred;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:7.5"], "en": "hatred arises from anger,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:7.6"], "en": "therefore one should not take pleasure in hatred.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:8.1"], "en": "Morsels of food, acts of violence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:8.2"], "en": "guile, and deceptions—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:8.3"], "en": "these are seen among states of greed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:8.4"], "en": "Therefore, I do not delight in greed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:9.1"], "en": "The fetters, bound together by affection,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:9.2"], "en": "are many and mind-made.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:9.3"], "en": "“They cause intense torment;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:9.4"], "en": "therefore, one should not find pleasure in affection.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:10.1"], "en": "“Regarding this well-spoken word of yours,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:10.2"], "en": "“Worthy and well-spoken,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:10.3"], "en": "O Brahmin! I grant you a boon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:10.4"], "en": "whatever you desire in your mind.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:11.1"], "en": "“If you would grant me a boon, O Sakka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:11.2", "PA_ja_440:11.3"], "en": "Lord of all beings, [grant it] to me as I dwell in the forest.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:11.4", "PA_ja_440:11.5"], "en": "May no afflictions arise for those who dwell alone constantly—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:11.6"], "en": "those severe obstacles that cause hindrance.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:12.1", "PA_ja_440:12.2"], "en": "“Since you have spoken so well, with words that are fitting and beautifully expressed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:12.3"], "en": "I grant you a boon, O brahmin.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:12.4"], "en": "“Whatever you desire in your mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:13.1"], "en": "“If you would grant me a boon, O Sakka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:13.2"], "en": "Lord of all beings;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:13.3"], "en": "Neither mind nor body,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:13.4"], "en": "O Sakka, belongs to anyone as \"mine\";", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:13.5"], "en": "may they never be harmed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:13.6"], "en": "“Sakka, choose this boon.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_440:14.1"], "en": "The Second Story: The Black Antelope Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
