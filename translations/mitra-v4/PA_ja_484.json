[
{"segs": ["PA_ja_484:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:0.2"], "en": "Miscellaneous Section,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:0.3"], "en": "Chapter on the Rice-field of Śāli Rice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:0.4"], "en": "1. The Sālikedāra Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:1.1", "PA_ja_484:1.2"], "en": "“O Kosiya, the crows are eating the ripe rice in the field;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:1.3"], "en": "\"I inform you, O Brahmā:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:1.4", "PA_ja_484:2.1"], "en": "I am not able to prevent them. And there is a bird there,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:2.2"], "en": "That which is the most beautiful of them all,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:2.3"], "en": "having eaten the rice as it pleases,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:2.4"], "en": "takes it with its beak and flies away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:3.1"], "en": "“Set snares for him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:3.2"], "en": "so that the bird may be caught;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:3.3"], "en": "having seized him alive,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:3.4"], "en": "“Bring them into my presence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:4.1"], "en": "“Having eaten and drunk these,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:4.2"], "en": "the birds depart;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:4.3"], "en": "“I am bound by a snare;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:4.4"], "en": "what evil have I committed?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:5.1"], "en": "“Surely it is the belly of others...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:5.2"], "en": "O bird, your belly is not bloated;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:5.3"], "en": "having eaten rice as much as you desire,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:5.4"], "en": "you fly away taking it with your beak.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:6.1"], "en": "Have you filled up a pit there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:6.2"], "en": "or have you incurred enmity with me?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:6.3"], "en": "Answer me when asked, my friend.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:6.4"], "en": "“Where will you store the rice?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:7.1"], "en": "“I have no enmity with you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:7.2"], "en": "I have no granary.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:7.3"], "en": "I release this debt, I give this debt;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:7.4", "PA_ja_484:7.5"], "en": "having reached the *koṭasimbali* tree, I bury my treasure there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:7.6"], "en": "“Know this, Kosiya:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:8.1", "PA_ja_484:8.2"], "en": "What is your debt, and what is the release from that debt?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:8.3"], "en": "“Tell me the place where treasure is hidden,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:8.4"], "en": "and then you shall escape from the snare.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:9.1"], "en": "“The young birds have not yet grown their wings;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:9.2"], "en": "\"Kosiya, these are my sons;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:9.3"], "en": "they will support me as their father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:9.4"], "en": "therefore I shall give them a debt.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:10.1"], "en": "My mother and father are old,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:10.2"], "en": "worn out and past their youth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:10.3"], "en": "having struck them with my beak, I shall—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:10.4"], "en": "I release you from the debt incurred in the past.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:11.1"], "en": "And as for the other birds there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:11.2"], "en": "whose wings are worn away and who are very weak;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:11.3"], "en": "I give it to those who seek merit;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:11.4"], "en": "the wise call that a treasure.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:12.1"], "en": "Such is my gift of debt.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:12.2"], "en": "And this is the liberation from debt;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:12.3"], "en": "I declare it to be a treasure-trove—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:12.4"], "en": "know this thus, O Kosiya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:13.1"], "en": "“Truly fortunate is this bird,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:13.2"], "en": "a twice-born one of supreme righteousness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:13.3"], "en": "among certain men.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:13.4"], "en": "This phenomenon does not exist.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:14.1"], "en": "Eat the rice as you wish,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:14.2"], "en": "together with all your kinsmen.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:14.3"], "en": "\"May we see you again,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:14.4"], "en": "for the sight of you is dear to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:15.1"], "en": "\"I have eaten and drunk my fill at your hermitage.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:15.2"], "en": "And may Rati be yours, O Kosiya;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:15.3"], "en": "give gifts to those who have laid down the rod,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:15.4"], "en": "and support your aged mother and father.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:16.1"], "en": "“Indeed, great fortune has arisen for me today,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:16.2"], "en": "since I have seen the most excellent among birds;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:16.3"], "en": "having heard the well-spoken words of the swan.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:16.4"], "en": "“I shall perform abundant meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:17.1"], "en": "Thus Kosiya, joyful and elated,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:17.2"], "en": "prepared food and drink.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:17.3", "PA_ja_484:17.4"], "en": "\"With a serene mind, he satisfied the ascetics and brahmins with food and drink.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_484:18.1"], "en": "Thus ends the first Sālikedāra Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
