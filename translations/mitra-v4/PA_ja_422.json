[
{"segs": ["PA_ja_422:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:0.2"], "en": "The Eighth Book of Cases,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:0.3"], "en": "The Section on Kaccāyana", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:0.4"], "en": "6. The Cetiyajātika Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:1.1"], "en": "\"Indeed, the Dhamma, when violated, destroys;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:1.2"], "en": "the Dhamma, when not violated, destroys nothing.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:1.3"], "en": "Therefore, do not destroy the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:1.4"], "en": "let the Dhamma, once destroyed, not destroy you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:2.1"], "en": "For one who speaks what is false...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:2.2"], "en": "The deities depart;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:2.3"], "en": "his mouth smells putrid,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:2.4"], "en": "and he falls from his own position.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:2.5"], "en": "He who, being questioned about a matter he knows,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:2.6"], "en": "explains it otherwise—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:3.1"], "en": "if indeed you speak the truth—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:3.2"], "en": "Be a king as you were before;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:3.3"], "en": "but if you speak falsely, O King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:3.4"], "en": "remain as a shrine upon the earth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:4.1"], "en": "It rains for him out of season,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:4.2"], "en": "and it does not rain for him in season: he who,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:4.3"], "en": "though knowing, does not answer a question when asked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:4.4"], "en": "Otherwise, you shall explain it differently.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:5.1"], "en": "For if you speak the truth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:5.2"], "en": "then be a king just as before.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:5.3"], "en": "If you speak falsely, O King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:5.4"], "en": "may you enter the earth as a shrine;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:6.1"], "en": "his tongue shall split in two.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:6.2"], "en": "Like a serpent, O Disampati, is he who,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:6.3"], "en": "when questioned about a matter he knows,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:6.4"], "en": "explains it otherwise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:7.1"], "en": "If indeed you speak the truth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:7.2", "PA_ja_422:7.3"], "en": "O King, be as you were before; but if you speak falsehood, O King, [you shall not remain so].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:7.4"], "en": "Enter the shrine even more deeply.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:8.1"], "en": "His tongue does not exist,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:8.2"], "en": "O Lord of the Earth, just like that of a fish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:8.3"], "en": "He who, being asked a question while knowing it,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:8.4"], "en": "answers it otherwise—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:9.1"], "en": "if indeed you speak the truth, [then you are a liar].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:9.2"], "en": "Be a king as you were before;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:9.3"], "en": "O King, if you speak falsely,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:9.4"], "en": "enter the shrine again.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:10.1"], "en": "Only daughters are born to him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:10.2"], "en": "and no sons are born in his family— he who,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:10.3"], "en": "though knowing the answer, fails to speak when questioned about the matter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:10.4"], "en": "Otherwise, you shall explain it differently.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:11.1"], "en": "For if you speak the truth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:11.2"], "en": "then be a king just as before.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:11.3"], "en": "If you speak thus, O King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:11.4"], "en": "enter the shrine even further;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:12.1"], "en": "for him, no sons shall exist.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:12.2"], "en": "They depart in every direction; he who,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:12.3"], "en": "though knowing, when asked a question,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:12.4"], "en": "explains it otherwise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:13.1"], "en": "If indeed you speak the truth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:13.2", "PA_ja_422:13.3"], "en": "O King, be as you were before; but if you speak falsehood, O King, [you shall fall].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:13.4"], "en": "“Enter the shrine once more.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:14.1"], "en": "“In former times, that king, accompanied by the seer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:14.2"], "en": "was a traveler through the sky.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:14.3"], "en": "The greedy man sinks into the earth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:14.4"], "en": "having reached his end through base conduct;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:15.1"], "en": "therefore, indeed, one should avoid following after desire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:15.2", "PA_ja_422:15.3"], "en": "The wise do not praise him who speaks words devoid of truth; one should speak with a mind free from malice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:15.4"], "en": "uttering speech endowed with truth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_422:16.1"], "en": "The Cetiyajātakam is the sixth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
