[
{"segs": ["PA_pv_27:0.1"], "en": "The Peta-Vatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:0.2"], "en": "Cūḷavagga 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:0.3"], "en": "The Peta-Vatthu of the Elder Sāṇavāsī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:1.1"], "en": "The elder Kuṇḍināgariya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:1.2"], "en": "a resident of Sāṇavāsī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:1.3"], "en": "known by the name Poṭṭhapāda—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:1.4"], "en": "The ascetic has cultivated his faculties.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:2.1", "PA_pv_27:2.2"], "en": "His mother, father, and brother have gone to a miserable state in the world of Yama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:2.3"], "en": "Having committed evil deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:2.4"], "en": "they have gone from here to the world of the hungry ghosts;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:3.1"], "en": "fallen into a miserable state, they are pierced by needles.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:3.2"], "en": "Exhausted, naked, and emaciated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:3.3"], "en": "trembling with great fear,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:3.4"], "en": "those cruel men did not show themselves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:4.1"], "en": "His brother, having crossed over,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:4.2"], "en": "went naked along a solitary path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:4.3"], "en": "having assumed the posture of the four-fold squat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:4.4"], "en": "He showed it to the elder.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:5.1"], "en": "But the elder, paying no heed to it,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:5.2"], "en": "passed by in silence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:5.3"], "en": "And so he made his request to the Elder:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:5.4"], "en": "\"I am your brother who has gone to the realm of the departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:6.1"], "en": "Both my mother and father, venerable sir, [are also there].\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:6.2"], "en": "Wretched ones belonging to the world of Yama;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:6.3"], "en": "having committed evil deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:6.4"], "en": "they have gone from here to the realm of the departed spirits (peta).", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:7.1"], "en": "Those wretched ones, pierced by needles,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:7.2"], "en": "exhausted, naked, and emaciated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:7.3"], "en": "trembling with great longing—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:7.4"], "en": "The cruel ones do not show [the food].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:8.1"], "en": "O compassionate one, have mercy;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:8.2"], "en": "having given it, assign it to us.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:8.3"], "en": "\"By the gift given by you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:8.4"], "en": "the Kurus shall sustain themselves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:9.1"], "en": "Having wandered for alms, the Elder—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:9.2", "PA_pv_27:9.3", "PA_pv_27:9.4"], "en": "Twelve other monks as well gathered together in one place for the purpose of taking their meal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:10.1"], "en": "The Elder said to them all:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:10.2"], "en": "\"Give me whatever you have received;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:10.3"], "en": "I shall prepare a meal for the Sangha.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:10.4"], "en": "Out of compassion for their kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:11.1"], "en": "they presented [the offerings] to the Elder;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:11.2"], "en": "the Elder then invited the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:11.3", "PA_pv_27:11.4"], "en": "Having given it, the Elder dedicated the merit to his mother, father, and brother,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:11.5"], "en": "saying: \"May this be for my kinsmen.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:11.6"], "en": "\"May my relatives be happy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:12.1", "PA_pv_27:12.2"], "en": "Immediately after this was uttered, food appeared.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:12.3"], "en": "Pure, exquisite, and excellent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:12.4"], "en": "with many kinds of sauces and condiments—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:13.1"], "en": "then his brother served it out.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:13.2", "PA_pv_27:13.3"], "en": "“O Venerable Sir, look at our abundant food;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:13.4"], "en": "we are here naked and yet happy.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:13.5", "PA_pv_27:13.6"], "en": "“Venerable sir, exert yourself in such a way that we may obtain cloth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:14.1"], "en": "The Elder [then took it] from a heap of refuse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:14.2"], "en": "Having gathered [rags] from the refuse heap,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:14.3", "PA_pv_27:14.4"], "en": "he made a cloth garment (pilotikapaṭa) and gave it to the Saṅgha of the four quarters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:15.1"], "en": "Having given, the Elder dedicated [the merit], saying:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:15.2"], "en": "\"May this be for my mother, father, and brother;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:15.3"], "en": "may it be for my kinsmen.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:15.4"], "en": "“May my kinsmen be happy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:16.1"], "en": "Immediately after this was recited,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:16.2"], "en": "garments appeared.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:16.3"], "en": "Then, wearing well-washed garments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:16.4"], "en": "he showed himself to the Elder:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:17.1"], "en": "\"As far as the realm of King Nanda...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:17.2"], "en": "In what has been conquered, there are coverings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:17.3", "PA_pv_27:17.4"], "en": "but, venerable sir, our garments and coverings are far more numerous than that.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:18.1"], "en": "Silken garments and woolen blankets,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:18.2"], "en": "as well as those made of linen and cotton—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:18.3"], "en": "vast in quantity and of great value.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:18.4"], "en": "Hanging in the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:19.1", "PA_pv_27:19.2"], "en": "in the open air, we burn those very things that are dear to the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:19.3", "PA_pv_27:19.4"], "en": "“Venerable sir, exert yourself in such a way that we may obtain a dwelling.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:20.1"], "en": "Having constructed a leaf-hut, the Elder—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:20.2"], "en": "He gave [offerings] to the Saṅgha of the four quarters;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:20.3", "PA_pv_27:20.4"], "en": "having given, the Elder dedicated the merit to his mother, father, and brother.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:20.5"], "en": "“May this belong to my relatives;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:20.6"], "en": "may my relatives be happy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:21.1"], "en": "Immediately after it was dedicated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:21.2", "PA_pv_27:21.3"], "en": "Houses arose; they were peaked-roofed dwellings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:21.4"], "en": "well-proportioned and measured out in their divisions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:22.1", "PA_pv_27:22.2"], "en": "“Among humans there are none such as these, our homes here;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:22.3"], "en": "nor even among the gods are there any like them.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:22.4"], "en": "Such are our houses here;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:23.1"], "en": "shining brightly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:23.2"], "en": "they illuminate all four directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:23.3", "PA_pv_27:23.4"], "en": "“Venerable sir, exert yourself in such a way that we may obtain water.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:24.1"], "en": "Having completed his task, the Elder—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:24.2"], "en": "He gave to the Saṅgha of the four quarters;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:24.3", "PA_pv_27:24.4"], "en": "having given, the Elder dedicated the merit to his mother, father, and brother.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:24.5"], "en": "“May this be for my relatives;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:24.6"], "en": "may my relatives be happy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:25.1"], "en": "Immediately after it was dedicated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:25.2"], "en": "Water arose there;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:25.3"], "en": "the lotus ponds were deep, square,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:25.4"], "en": "and beautifully constructed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:26.1"], "en": "With cool waters and a firm footing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:26.2"], "en": "cool and free from foul odors,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:26.3"], "en": "it is covered with lotuses and water-lilies.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:26.4"], "en": "Filled with water and lotus filaments;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:27.1"], "en": "having bathed and drunk there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:27.2"], "en": "they presented themselves before the Elder.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:27.3"], "en": "“There is plenty of water, venerable sir,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:27.4"], "en": "but our feet are sore and painful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:28.1"], "en": "As we wander about, we limp.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:28.2"], "en": "“Gravel, pebbles, and thorns;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:28.3", "PA_pv_27:28.4"], "en": "thus, venerable sir, exert yourself so that we may obtain a vehicle.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:29.1"], "en": "The Elder, having obtained a pair of sandals,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:29.2"], "en": "gave them to the Sangha of the four quarters;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:29.3"], "en": "having given them, the Elder made this dedication:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:29.4"], "en": "\"To my mother, father, and brother:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:29.5"], "en": "'May this belong to my relatives;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:29.6"], "en": "may my relatives be happy.'\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:30.1"], "en": "Immediately after it was recited,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:30.2"], "en": "the departed ones approached on their chariot, saying:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:30.3"], "en": "\"We have been shown compassion, O Blessed One!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:30.4"], "en": "By means of food and clothing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:31.1"], "en": "by the giving of a dwelling and the gift of water,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:31.2"], "en": "and by the gift of vehicles— both [of these].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:31.3", "PA_pv_27:31.4"], "en": "“We have come, Bhante, to pay homage to the compassionate Sage in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_27:32.1"], "en": "The Story of the Deceased Elder Sāṇavāsī, Second.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
