[
{"segs": ["PA_tha-ap_166:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:0.2"], "en": "Supāricariyavagga, 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:0.3"], "en": "The Apadāna of the Elder Desapūjaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:1.1"], "en": "But the Blessed One Atthadassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:1.2"], "en": "the elder of the world, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:1.3"], "en": "having ascended into the air, spoke thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:1.4"], "en": "He went with the speed of the wind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:2.1"], "en": "To whatever place the Teacher stood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:2.2"], "en": "the Great Sage ascended there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:2.3", "PA_tha-ap_166:2.4"], "en": "With a mind full of faith, I worshipped that place with my own hands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:3.1"], "en": "For eighteen hundred kalpas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:3.2"], "en": "I beheld that Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:3.3"], "en": "I do not know a state of woe—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:3.4"], "en": "this is the fruit of honoring the land.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:4.1"], "en": "In the eleventh hundred aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:4.2"], "en": "one named Gosujāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:4.3"], "en": "endowed with the seven treasures, [will appear].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:4.4"], "en": "A wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:5.1", "PA_tha-ap_166:5.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:6.1"], "en": "In this way, it is said, the venerable elder Desapūjaka recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_166:7.1"], "en": "This is the fourth apadāna of the elder Desapūjaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
