[
{"segs": ["PA_tha-ap_442:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:0.2", "PA_tha-ap_442:0.3"], "en": "The Chapter on Those Who Dwell Alone (Ekavihārivagga) 10. The Apadāna of the Elder Ambaphaliya", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:1.1"], "en": "“Of the Buddha Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:1.2"], "en": "the World’s Elder, the Neutral One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:1.3"], "en": "as he was wandering for alms, [he saw] a woman giving a gift of food.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:1.4"], "en": "Bearing supreme glory,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:2.1", "PA_tha-ap_442:2.2"], "en": "having taken the highest fruit with a serene mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:2.3", "PA_tha-ap_442:2.4"], "en": "I gave to the Teacher, the hero worthy of offerings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:3.1"], "en": "by that deed, O Lord of bipeds, [I have attained this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:3.2"], "en": "O eldest in the world, O bull among men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:3.3"], "en": "I have reached the unshakable state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:3.4"], "en": "having abandoned victory and defeat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:4.1"], "en": "In a hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:4.2"], "en": "when I gave that gift,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:4.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:4.4"], "en": "This is the fruit of the supreme gift.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:5.1"], "en": "My defilements have been consumed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:5.2"], "en": "…pe…", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:5.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:6.1", "PA_tha-ap_442:6.2"], "en": "Welcome indeed has come to me... [as before]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:6.3"], "en": "The Buddha’s teaching has been accomplished:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:7.1", "PA_tha-ap_442:7.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:7.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:8.1"], "en": "In this way, it is said, the venerable elder Ambaphaliya recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:9.1"], "en": "This is the tenth legend of the elder Ambaphaliya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:10.1"], "en": "The Forty-fourth Chapter: On Dwelling Alone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:11.1"], "en": "Its summary:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:12.1"], "en": "The Elder and the One Who Dwells Alone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:12.2"], "en": "Saṅkhiya, Pāṭihīraka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:12.3"], "en": "Thavika, Ucchukhaṇḍī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:12.4"], "en": "and Kaḷamba and Ambāṭaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:13.1"], "en": "The *Harītakambapiṇḍī* and the *Amba*,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:13.2"], "en": "with the *Yati* as the tenth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:13.3"], "en": "there are eighty-six verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_442:13.4"], "en": "They are calculated by those possessed of analytical insight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
