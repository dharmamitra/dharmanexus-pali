[
{"segs": ["PA_tha-ap_445:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:0.2"], "en": "The Chapter on the Vibhītaka Tree, Number Three:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:0.3"], "en": "The Apadāna of the Elder Billiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:1.1"], "en": "“On the bank of the Candabhāgā River,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:1.2"], "en": "my well-prepared hermitage is situated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:1.3"], "en": "crowded with bīla trees.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:1.4"], "en": "Frequented by various birds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:2.1"], "en": "upon seeing the fragrant beluva tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:2.2"], "en": "I recollected the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:2.3"], "en": "Having filled a khāribhāra [of offerings],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:2.4"], "en": "joyful and with a heart full of spiritual urgency,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:3.1"], "en": "he approached Kakusandha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:3.2", "PA_tha-ap_445:3.3", "PA_tha-ap_445:3.4"], "en": "I gave ripe *billa* fruits with a mind full of serene confidence to the Hero, that field of merit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:4.1"], "en": "In this very eon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:4.2"], "en": "because I gave that fruit at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:4.3"], "en": "I do not know a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:4.4"], "en": "This is the fruit of giving alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:5.1", "PA_tha-ap_445:5.2"], "en": "My defilements have been incinerated... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:5.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:6.1", "PA_tha-ap_445:6.2"], "en": "Welcome indeed has come to me... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:6.3"], "en": "Such is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:7.1", "PA_tha-ap_445:7.2"], "en": "the four analytical knowledges, and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:7.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:8.1"], "en": "In this way, it is said, the venerable elder Billiya recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_445:9.1"], "en": "This is the third legend of the elder Billiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
