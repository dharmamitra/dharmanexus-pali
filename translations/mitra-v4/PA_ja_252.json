[
{"segs": ["PA_ja_252:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_252:0.2", "PA_ja_252:0.3"], "en": "The Collection of Threes, Chapter on Intention (Saṅkappavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_252:0.4", "PA_ja_252:1.1"], "en": "2. The Tila-muṭṭhi Jātaka “Even today I still recall that [time] when you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_252:1.2"], "en": "with a handful of sesame seeds, [gave to me]...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_252:1.3"], "en": "Having seized me by the arm,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_252:1.4"], "en": "he struck me with a staff.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_252:2.1"], "en": "Do you not take delight in life?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_252:2.2"], "en": "“By which you have come here, O Brahmin;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_252:2.3"], "en": "having seized me by the arm,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_252:2.4"], "en": "you have struck me three times.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_252:3.1", "PA_ja_252:3.2"], "en": "“When a noble one restrains with punishment one who acts ignobly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_252:3.3"], "en": "that is instruction, not enmity.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_252:3.4"], "en": "\"Thus do the wise understand it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_252:4.1"], "en": "The Second Jātaka, the Tilamuṭṭhi-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
