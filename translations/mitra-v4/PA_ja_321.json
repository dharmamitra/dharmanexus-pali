[
{"segs": ["PA_ja_321:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:0.2"], "en": "The Collection of Fours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:0.3"], "en": "Chapter on the House-Burner.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:0.4"], "en": "1. The Jātaka of the House-Spoiler:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:1.1", "PA_ja_321:1.2"], "en": "“Your head is that of a human, yet your hands and feet are those of a monkey.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:1.3", "PA_ja_321:1.4"], "en": "\"Now, for what reason do you have no home?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:2.1"], "en": "\"My head is that of a human being,\" [he replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:2.2"], "en": "And my hands and feet are like those of a porpoise;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:2.3", "PA_ja_321:2.4"], "en": "that wisdom which is supreme among humans is not found in me.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:3.1"], "en": "“For one whose mind is unsteady,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:3.2"], "en": "whose mind is fickle, who is treacherous,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:3.3"], "en": "and whose virtue is constantly inconstant— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:3.4"], "en": "The state of happiness does not exist [for you].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:4.1", "PA_ja_321:4.2"], "en": "Therefore, exert your power and transcend your sluggishness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:4.3", "PA_ja_321:4.4"], "en": "\"O monkey, build a hut to protect yourself from the cold wind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_321:5.1"], "en": "Thus ends the first Jātaka, the Kuṭidūsakajātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
