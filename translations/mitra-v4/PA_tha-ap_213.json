[
{"segs": ["PA_tha-ap_213:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:0.2"], "en": "Hatthivagga 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:0.3"], "en": "The Apadāna of the Elder Hatthidāyaka (The Elephant-Giver)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:1.1"], "en": "“To the Blessed One Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:1.2"], "en": "the Lord of bipeds, the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:1.3"], "en": "this best of elephants was given by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:1.4"], "en": "With tusks like ivory and a broad chest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:2.1"], "en": "I experience the supreme goal,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:2.2"], "en": "the unsurpassed state of peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:2.3"], "en": "The gift of a nāga was given by me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:2.4"], "en": "seeking the welfare of the entire world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:3.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:3.2"], "en": "Since I gave that elephant at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:3.3"], "en": "I have not known a miserable rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:3.4"], "en": "this is the fruit of giving an elephant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:4.1"], "en": "In the seventy-eighth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:4.2", "PA_tha-ap_213:4.3"], "en": "there were sixteen kṣatriyas named Samantapāsādika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:4.4"], "en": "The wheel-turning monarchs of great power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:5.1"], "en": "the four analytical knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:5.2"], "en": "and these eight liberations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:5.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:5.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:6.1"], "en": "Thus indeed did the venerable elder Hatthidāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_213:7.1"], "en": "The legend of the Elder Hatthidāyaka is the first.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
