    },
    {
        "segmentnr": "PA_mil_3.5.5:1.5",
        "original": "“Yathā, mahārāja, kocideva puriso padīpato padīpaṁ padīpeyya, kiṁ nu kho so, mahārāja, padīpo padīpamhā saṅkanto”ti?",
        "analyzed": "yathā mahā rāja kocid eva purisaḥ padīpataḥ padīpam padīpeyya kim nu kho saḥ mahā rāja padīpaḥ padīpamhā saṅkantaḥ iti ",
        "folio": "1",
        "suttacentral_link": "https://suttacentral.net/mil3.5.5/pli/ms#1.5"
    },
    {
