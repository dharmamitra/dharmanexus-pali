[
{"segs": ["PA_tha-ap_122:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:0.2"], "en": "Mahāparivāravagga 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:0.3"], "en": "The Apadāna of the Elder Jātipūjaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:1.1"], "en": "As Vipassi was being born,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:1.2"], "en": "a vast light appeared;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:1.3"], "en": "and the earth trembled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:1.4"], "en": "Including the oceans and the mountains,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:2.1"], "en": "the interpreters of signs declared:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:2.2"], "en": "\"A Buddha shall arise in the world.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:2.3", "PA_tha-ap_122:2.4"], "en": "The foremost of all beings will uplift the people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:3.1"], "en": "Having heard the signs from the omens-makers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:3.2"], "en": "I performed a birth-festival offering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:3.3", "PA_tha-ap_122:3.4"], "en": "there is no such honoring as this birth-festival offering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:4.1"], "en": "Having performed wholesome deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:4.2"], "en": "I gladdened my own mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:4.3"], "en": "having made offerings for the sake of my birth, I paid homage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:4.4"], "en": "There I passed away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:5.1", "PA_tha-ap_122:5.2"], "en": "whomever among the realms of gods or humans I was reborn into, I entered that very womb.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:5.3"], "en": "I overcome all beings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:5.4"], "en": "this is the fruit of honoring [my mother] at birth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:6.1"], "en": "My nurses attend upon me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:6.2", "PA_tha-ap_122:6.3"], "en": "They cannot disturb my mind, which follows its own mastery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:6.4"], "en": "this is the fruit of honoring those born [in the past].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:7.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:7.2"], "en": "because I made that offering then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:7.3"], "en": "I do not know any state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:7.4"], "en": "This is the fruit of honoring one's birth:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:8.1", "PA_tha-ap_122:8.2"], "en": "there were thirty-four rulers of men known for their excellent service.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:8.3"], "en": "In this third aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:8.4"], "en": "there were wheel-turning monarchs of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:9.1"], "en": "[they attained] the four analytical knowledges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:9.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:9.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:10.1"], "en": "Thus indeed did the Venerable Thera Jātipūjaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:11.1"], "en": "The legend of the Elder Jātipūjaka is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:12.1", "PA_tha-ap_122:13.1"], "en": "The twelfth chapter, the Mahāparivāra-vagga. Its summary (uddāna) is as follows:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:14.1"], "en": "Parivārasumaṅgalā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:14.2"], "en": "Saraṇāsanapupphiyā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:14.3"], "en": "Citapūjī Buddhasaññī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:14.4"], "en": "By one born with the manifestation of the Path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:14.5"], "en": "ninety verses were spoken,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_122:14.6"], "en": "as calculated by those who discern them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
