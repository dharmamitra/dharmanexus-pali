[
{"segs": ["PA_thag_2.36:0.1", "PA_thag_2.36:0.2"], "en": "Theragāthā 2.36 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:0.3"], "en": "Catutthavagga (The Fourth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:0.4"], "en": "The Verses of the Elder Nītaka:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:1.1"], "en": "“Whose mind is like a rock—steadfast and unshaken?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:1.2"], "en": "Who, having heard the Dhamma, does not waver?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:1.3"], "en": "Detached from things that provoke passion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:1.4"], "en": "one does not become agitated by things that provoke anger;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:1.5"], "en": "for one whose mind is thus developed—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:1.6"], "en": "From where will suffering come to you?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:2.1"], "en": "My mind is like a rock;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:2.2"], "en": "being firm, it does not tremble.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:2.3"], "en": "Detached from things that cause passion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:2.4"], "en": "it is not disturbed by things that provoke anger;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:2.5"], "en": "such is my mind, thus cultivated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:2.6"], "en": "“From where will suffering come to me?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.36:2.7"], "en": "… [Thus spoke] the Elder Nitaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
