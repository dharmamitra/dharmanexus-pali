[
{"segs": ["PA_snp_1.9:0.1", "PA_snp_1.9:0.2", "PA_snp_1.9:1.1"], "en": "Sutta Nipāta 1.9 Hemavatasutta “Today is the fifteenth day, the Uposatha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:1.2"], "en": "(Thus spoke the yakkha Sātāgira:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:1.3"], "en": "The divine night has arrived;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:1.4"], "en": "[I approach] the Teacher of matchless name.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:1.5"], "en": "“Come, let us see Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:2.1"], "en": "“Is the mind well-directed?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:2.2"], "en": "(Thus spoke the Yakkha Hemavata.)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:2.3"], "en": "Toward all beings, being such as you are—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:2.4", "PA_snp_1.9:2.5"], "en": "have you brought both the desirable and the undesirable under the mastery of your intention?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:3.1"], "en": "“His mind is well-directed toward all beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:3.2", "PA_snp_1.9:3.3"], "en": "being one who remains equanimous,” said the yakkha Sātāgira.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:3.4", "PA_snp_1.9:3.5"], "en": "\"Furthermore, having brought both the desirable and the undesirable under the control of one's intention—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:4.1"], "en": "does he not take what is not given?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:4.2"], "en": "(Thus spoke the yakkha Hemavata:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:4.3"], "en": "\"Are you restrained toward living beings?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:4.4"], "en": "Are you far removed from negligence?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:4.5"], "en": "“Does he not neglect meditative absorption?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:5.1", "PA_snp_1.9:5.2"], "en": "“He does not take what is not given,” said the yakkha Sātāgira.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:5.3"], "en": "Furthermore, restrained among living beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:5.4"], "en": "and far removed from negligence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:5.5"], "en": "the Buddha does not abandon meditative absorption.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:6.1"], "en": "“Does he not speak falsehood?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:6.2", "PA_snp_1.9:6.3"], "en": "(Thus said the Yakkha Hemavata) Does he not have his speech exhausted?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:6.4"], "en": "\"I hope you do not speak divisively;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:6.5"], "en": "I hope you do not speak idle chatter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:7.1"], "en": "\"He does not speak falsehoods.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:7.2"], "en": "(Thus spoke the yakkha Sātāgira:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:7.3"], "en": "\"Furthermore, my speech is not harsh;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:7.4"], "en": "nor do I speak divisively.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:7.5"], "en": "“Does he speak with wisdom and for the sake of the goal?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:8.1", "PA_snp_1.9:8.2"], "en": "“I hope he does not lust after sensual pleasures,” said the Hemavata Yakkha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:8.3"], "en": "Is the mind undisturbed?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:8.4"], "en": "Have you transcended delusion?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:8.5"], "en": "Are you possessed of vision regarding all phenomena?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:9.1"], "en": "“He is not enamored by sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:9.2"], "en": "(so says the yakkha Sātāgira),", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:9.3"], "en": "and his mind is undisturbed.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:9.4"], "en": "“Having transcended all delusion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:9.5"], "en": "the Buddha is the one with vision among all phenomena.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:10.1"], "en": "“Is he truly endowed with true knowledge?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:10.2"], "en": "(Thus spoke the yakkha Hemavata:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:10.3"], "en": "\"Is his conduct completely pure?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:10.4"], "en": "Have his taints been exhausted?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:10.5"], "en": "\"Is there truly no further becoming?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:11.1", "PA_snp_1.9:11.2"], "en": "\"Endowed with true knowledge,\" [said the yakkha Sātāgira].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:11.3"], "en": "And thus, with his conduct completely purified,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:11.4"], "en": "all his taints are exhausted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:11.5"], "en": "for him there is no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:12.1", "PA_snp_1.9:12.2"], "en": "“The mind of the Sage is perfected through his actions and his mode of speech;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:12.3"], "en": "he is perfected in true knowledge and conduct.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:12.4"], "en": "He praises him in accordance with the Dhamma:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:13.1"], "en": "\"The mind of the Sage is perfected,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:13.2"], "en": "as is his conduct and his speech.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:13.3", "PA_snp_1.9:13.4"], "en": "You rejoice according to the Dhamma in the one perfected in true knowledge and conduct;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:14.1"], "en": "the mind of the Sage is perfected.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:14.2"], "en": "By his deeds and by his speech—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:14.3", "PA_snp_1.9:14.4"], "en": "let us now behold Gotama, who is perfected in true knowledge and conduct.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:15.1"], "en": "The hero with shanks like an antelope’s, emaciated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:15.2"], "en": "eating little, and free from greed—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:15.3"], "en": "the sage meditating in the forest—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:15.4"], "en": "Come, let us see Gotama—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:16.1"], "en": "the lion who roams alone, the Naga,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:16.2"], "en": "who has no longing for sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:16.3", "PA_snp_1.9:16.4"], "en": "Having approached, we ask him who releases from the snare of Death—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:17.1"], "en": "the one who explains and proclaims it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:17.2", "PA_snp_1.9:17.3", "PA_snp_1.9:17.4"], "en": "We ask Gotama, the Buddha, who has gone beyond all phenomena and has transcended enmity and fear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:18.1"], "en": "“In what has the world arisen?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:18.2"], "en": "(Thus the Yakkha Hemavata asked:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:18.3"], "en": "In what does it form intimacy?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:18.4"], "en": "“By clinging to what does the world exist?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:18.5"], "en": "By what is the world afflicted?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:19.1"], "en": "“The world has arisen from the six;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:19.2"], "en": "(Hemavata, said the Blessed One:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:19.3"], "en": "\"One forms intimacy with six things;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:19.4"], "en": "by clinging to those very six,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:19.5"], "en": "The world is tormented by the six senses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:20.1"], "en": "What is that clinging,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:20.2"], "en": "by which the world is tormented?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:20.3"], "en": "\"Being asked about the way out, tell me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:20.4"], "en": "how is one released from suffering?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:21.1"], "en": "\"The five strands of sensual pleasure in the world...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:21.2"], "en": "These six are proclaimed as the mind’s domains;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:21.3"], "en": "having detached from desire for these,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:21.4"], "en": "one is thus liberated from suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:22.1"], "en": "This is the escape from the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:22.2"], "en": "as it truly is, that has been declared to you;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:22.3"], "en": "this I declare to you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:22.4"], "en": "In this way one is liberated from suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:23.1"], "en": "Who now crosses over the flood?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:23.2"], "en": "Who crosses over the ocean?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:23.3"], "en": "\"When there is no foothold and no support,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:23.4"], "en": "who does not sink in the deep?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:24.1"], "en": "\"One who is at all times endowed with virtue...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:24.2"], "en": "Possessed of wisdom, well-concentrated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:24.3"], "en": "reflecting inwardly and mindful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:24.4"], "en": "one crosses over the flood that is so difficult to cross.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:25.1"], "en": "Detached from the perception of sensual desire,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:25.2"], "en": "having transcended all fetters,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:25.3"], "en": "with delight in existence utterly exhausted—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:25.4"], "en": "Thus, he does not sink in what is so profound.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:26.1", "PA_snp_1.9:26.2"], "en": "[The Buddha said: “One of profound wisdom who sees the subtle meaning, who possesses nothing and is unattached to sensual existence—”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:26.3"], "en": "Behold that Great Seer, liberated in every respect,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:26.4"], "en": "treading the divine path—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:27.1"], "en": "the one of peerless name who perceives the subtle meaning.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:27.2", "PA_snp_1.9:27.3"], "en": "Behold that wise Great Seer, the giver of wisdom, unattached to the abode of sensual desires,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:27.4"], "en": "the all-knowing one treading the noble path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:28.1", "PA_snp_1.9:28.2"], "en": "Truly well-seen by us today is this auspicious dawn, so beautifully risen,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:28.3"], "en": "since we have beheld the Fully Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:28.4"], "en": "He has crossed the flood and is free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:29.1", "PA_snp_1.9:29.2"], "en": "These one thousand yakkhas are possessed of psychic power and renown.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:29.3"], "en": "All go to you for refuge;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:29.4"], "en": "you are our unsurpassed teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:30.1"], "en": "Thus shall we wander.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:30.2"], "en": "From village to village, from mountain to mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:30.3", "PA_snp_1.9:30.4"], "en": "they paid homage to the Fully Awakened One and to the sublime nature of the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_1.9:30.5"], "en": "The Hemavata Sutta, the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
