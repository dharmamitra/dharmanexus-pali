[
{"segs": ["PA_tha-ap_494:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:0.2"], "en": "The Chapter on Kiṅkaṇī Flowers, 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:0.3"], "en": "The Apadāna of the Elder Paṃsukūlapūjaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:1.1"], "en": "\"Not far from the Himālaya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:1.2"], "en": "there is a mountain named Udaṅgaṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:1.3"], "en": "there I saw a rag-robe.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:1.4"], "en": "Hanging from the tip of a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:2.1", "PA_tha-ap_494:2.2"], "en": "I then plucked three kiṅkaṇī flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:2.3"], "en": "With a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:2.4"], "en": "I honored a rag-robe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:3.1"], "en": "by that well-performed deed, [I attained this fruit].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:3.2"], "en": "And through my volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:3.3"], "en": "having cast off this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:3.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:4.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:4.2"], "en": "because of the deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:4.3"], "en": "I do not know a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:4.4"], "en": "Having worshipped the banner of the Arhat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:5.1", "PA_tha-ap_494:5.2"], "en": "my defilements have been incinerated... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:5.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:6.1", "PA_tha-ap_494:6.2"], "en": "Welcome indeed has come to me... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:6.3"], "en": "Thus was the Buddha’s teaching spoken:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:7.1", "PA_tha-ap_494:7.2"], "en": "the four analytical knowledges, and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:7.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:8.1"], "en": "Thus indeed did the venerable elder Paṃsukūlapūjaka recite these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_494:9.1"], "en": "This is the second legend of the elder Paṃsukūlapūjaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
