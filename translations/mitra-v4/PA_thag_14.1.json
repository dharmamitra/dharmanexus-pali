[
{"segs": ["PA_thag_14.1:0.1", "PA_thag_14.1:0.2", "PA_thag_14.1:0.3"], "en": "Theragāthā 14.1 Cuddasakanipāta Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:0.4"], "en": "The Verses of the Elder Revata of the Khadiravana Grove:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:1.1", "PA_thag_14.1:1.2"], "en": "“When I had gone forth from the home life into homelessness, ...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:1.3", "PA_thag_14.1:1.4"], "en": "I do not recall ever having a nobleless intention associated with hatred, such as:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:2.1"], "en": "\"Let these people be killed! Let them be executed!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:2.2"], "en": "\"May living beings encounter suffering\"—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:2.3", "PA_thag_14.1:2.4"], "en": "I do not recall forming such an intention during this long interval.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:3.1"], "en": "I know loving-kindness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:3.2"], "en": "immeasurable and well-developed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:3.3"], "en": "cultivated in successive stages.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:3.4"], "en": "Just as taught by the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:4.1"], "en": "\"He who is a friend to all, a companion to all,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:4.2"], "en": "and compassionate toward all beings;\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:4.3"], "en": "I cultivate a mind of loving-kindness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:4.4"], "en": "always delighting in non-malice—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:5.1"], "en": "unshakable and unassailable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:5.2"], "en": "I gladden my mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:5.3"], "en": "I cultivate the divine abodes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:5.4"], "en": "which are not practiced by base men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:6.1"], "en": "Having attained the state free from directed thought,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:6.2", "PA_thag_14.1:6.3"], "en": "the disciple of the Perfectly Enlightened One abides in noble silence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:6.4"], "en": "He remains thus for a while,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:7.1"], "en": "like a rocky mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:7.2"], "en": "immovable and firmly established.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:7.3", "PA_thag_14.1:7.4"], "en": "Thus, with the destruction of delusion, a bhikkhu does not tremble, like a mountain;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:8.1"], "en": "for a person free from blemish, there is no fear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:8.2"], "en": "For one who constantly seeks purity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:8.3", "PA_thag_14.1:8.4"], "en": "even a speck of evil appears as large as a cloud.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:9.1", "PA_thag_14.1:9.2"], "en": "Just as a frontier city is guarded both within and without,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:9.3"], "en": "so should you guard yourselves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:9.4"], "en": "Let not the opportune moment pass you by.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:10.1"], "en": "I do not rejoice in death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:10.2"], "en": "nor do I rejoice in life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:10.3", "PA_thag_14.1:10.4"], "en": "I await my time like a servant longing for his wages;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:11.1"], "en": "I do not rejoice in death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:11.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:11.4"], "en": "clearly comprehending and mindful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:12.1"], "en": "The Teacher has been served by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:12.2"], "en": "The teaching of the Buddha has been fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:12.3"], "en": "the heavy burden has been laid down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:12.4"], "en": "and the conduit to existence has been uprooted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:13.1", "PA_thag_14.1:13.2"], "en": "The goal for the sake of which I went forth from the home life into homelessness—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:13.3"], "en": "that purpose of mine has been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:13.4"], "en": "The destruction of all fetters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:14.1"], "en": "Accomplish this through diligence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:14.2"], "en": "this is my instruction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:14.3"], "en": "“Soon indeed I shall attain final Nibbāna;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:14.4"], "en": "I am completely liberated from everything.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_14.1:14.5"], "en": "… Thus spoke the Elder Revata of the Khadiravana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
