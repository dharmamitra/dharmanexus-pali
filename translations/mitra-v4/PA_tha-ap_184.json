[
{"segs": ["PA_tha-ap_184:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:0.2"], "en": "The Chapter on the Kuṭaja Flower, 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:0.3"], "en": "The Apadāna of the Elder Bandhujīvaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:1.1"], "en": "“The Perfectly Enlightened One named Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:1.2"], "en": "the self-become one praised by the virtuous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:1.3"], "en": "has attained meditative absorption.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:1.4"], "en": "He sat within the mountain range,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:2.1", "PA_tha-ap_184:2.2"], "en": "seeking the supreme water-born flower in the lake where it grows.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:2.3", "PA_tha-ap_184:2.4"], "en": "Immediately thereafter, I saw bandhujīvaka flowers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:3.1"], "en": "picking them up with both hands, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:3.2"], "en": "I approached the Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:3.3"], "en": "with a clear heart and joyful mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:3.4"], "en": "I offered [the gift] to Siddhattha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:4.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:4.2"], "en": "because I offered that flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:4.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:4.4"], "en": "This is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:5.1"], "en": "Fourteen aeons ago from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:5.2"], "en": "there was one who was a lord of men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:5.3"], "en": "Known by the name Samuddakappa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:5.4"], "en": "he was a wheel-turning monarch of great power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:6.1"], "en": "possessing the four analytical knowledges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:7.1"], "en": "Thus indeed did the Venerable Elder Bandhujīvaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_184:8.1"], "en": "The legend of the Elder Bandhujīvaka is the second.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
