[
{"segs": ["PA_anya-e10_06n:0"], "en": "Homage to that Blessed One, the Worthy One, the Perfectly Self-Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:1"], "en": "The Method of the Discourses:", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:3"], "en": "Another [verse] concerning the person who has become...", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:4"], "en": "We ask Gotama this question:", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:5"], "en": "having approached you, O Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:6"], "en": "we ask what is the cause of failure.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:8"], "en": "Prosperity is easy to understand,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:9"], "en": "while decline is difficult to understand;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:10"], "en": "may you be one who desires the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:11", "PA_anya-e10_06n:13"], "en": "One who lacks faith in the Dhamma comes to ruin. Thus we know this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:14"], "en": "it is the first cause of ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:15"], "en": "Tell me again, Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:16"], "en": "what is the cause of ruin?", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:18"], "en": "Why does one who is wicked become beloved?", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:19"], "en": "He does not do what is pleasing to the virtuous,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:20"], "en": "but delights in the doctrine of the wicked;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:21"], "en": "that is a cause of ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:22", "PA_anya-e10_06n:23"], "en": "When the destruction of beings through their own karmic transgressions is imminent,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:24"], "en": "misfortune appears in the guise of fortune.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:25"], "en": "He stands having overcome his intellect.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:27"], "en": "That man who is habitually sleepy, habitually social,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:28"], "en": "and one who does not rise up;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:29"], "en": "The lazy one, whose hallmark is anger—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:30"], "en": "that is a gateway to ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:32"], "en": "He who [neglects] his mother or father...", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:33", "PA_anya-e10_06n:34"], "en": "One who, though possessing ample wealth, does not support his aged parents whose youth has passed—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:35"], "en": "this is a cause of one's downfall.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:37"], "en": "Whoever deceives a brahmin, a recluse,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:38", "PA_anya-e10_06n:39"], "en": "or even any other mendicant with false speech,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:40"], "en": "That is the cause of one's downfall:", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:42"], "en": "a man who possesses abundant wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:43"], "en": "together with gold and food.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:44"], "en": "One person eats delicacies;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:45"], "en": "that is a cause of ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:47"], "en": "One who is arrogant because of birth and arrogant because of wealth—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:48"], "en": "And the man who, though wealthy,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:49"], "en": "despises his own kinsmen—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:50"], "en": "that is a gateway to ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:52", "PA_anya-e10_06n:53"], "en": "The man who is a gambler with women, a gambler with liquor,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:54"], "en": "and a gambler with dice destroys whatever he has gained.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:55"], "en": "That is the gateway to ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:56", "PA_anya-e10_06n:57"], "en": "One who perceives the exhaustion of vital energy should not have excessive intercourse with women.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:58"], "en": "Coughing, asthma, trembling, and weakness;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:59", "PA_anya-e10_06n:60"], "en": "one whose fat has been consumed falls away. (Ka)", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:61"], "en": "Illusion and mental confusion, mirage,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:62"], "en": "sorrow, disease, and calamity;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:63"], "en": "harshness and the mind of bondage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:64", "PA_anya-e10_06n:65"], "en": "The snare of Death lies in wait within the cave.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:66"], "en": "(Kha) The strong become weak.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:67"], "en": "Even those who are steadfast fall away;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:68", "PA_anya-e10_06n:69"], "en": "even those with vision become blind when they have come under the power of women.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:70", "PA_anya-e10_06n:71"], "en": "Those who possess virtues become devoid of virtue;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:72"], "en": "even those possessed of wisdom decline.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:73"], "en": "Though released from their bonds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:74"], "en": "they remain under the sway of women.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:75"], "en": "(Gha)", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:76"], "en": "Fame, renown, steadfastness, heroism,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:77"], "en": "erudition, and discernment—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:78"], "en": "these they cause to decline in one who is negligent.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:79"], "en": "Like a fire upon a heap of wood,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:81"], "en": "though satisfied with his own wife,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:82"], "en": "he offends against courtesans.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:83"], "en": "He commits adultery with another's wife;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:84"], "en": "that is a cause of his downfall.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:85"], "en": "(Ka)", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:86"], "en": "We do not transgress against our wives,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:87"], "en": "nor do our wives transgress against us;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:88"], "en": "apart from them, we lead the holy life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:89", "PA_anya-e10_06n:90"], "en": "Therefore, indeed, our children do not die young;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:91"], "en": "they are born from these women who are well-slept.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:92"], "en": "They are intelligent and possess abundant wisdom;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:93"], "en": "they are learned and endowed with the qualities of the elders.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:94"], "en": "Therefore, indeed, our youths do not die.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:96", "PA_anya-e10_06n:97"], "en": "A man whose youth has passed brings home a woman with breasts like *timbaru* fruits;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:98"], "en": "he cannot sleep for jealousy.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:99"], "en": "That is the cause of one's downfall.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:100", "PA_anya-e10_06n:101"], "en": "(Ka) It is not suffering to be bitten by a snake;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:102"], "en": "There is no suffering equal to being struck by a spear;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:103", "PA_anya-e10_06n:104"], "en": "yet that is but a minor suffering compared to the intense suffering one feels when seeing an aged husband.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:105", "PA_anya-e10_06n:106"], "en": "(Kha) There is no joy, there is no pleasure,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:107"], "en": "for one with an aged husband.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:108"], "en": "There is no conversation or discourse;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:109"], "en": "even to laugh is not fitting.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:110"], "en": "(Ga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:111"], "en": "And when the young man and the young woman,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:112"], "en": "having gone into private, deliberated together,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:113"], "en": "all sorrows were destroyed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:114", "PA_anya-e10_06n:116"], "en": "Great is the attachment of the heart toward a woman who is intoxicated and wanton,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:117"], "en": "or likewise toward a man of such a nature.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:118"], "en": "To establish oneself in lordship—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:119", "PA_anya-e10_06n:121"], "en": "this is a cause of ruin. To have little wealth yet great craving— this is a cause of ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:122"], "en": "He is born into a khattiya family;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:123"], "en": "yet he aspires to kingship—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:124"], "en": "this is a cause of his downfall.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:125"], "en": "“Prosperity is easy to recognize,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:126"], "en": "but ruin is difficult to perceive;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:127"], "en": "one may have little wealth yet possess great craving.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:129", "PA_anya-e10_06n:130", "PA_anya-e10_06n:131"], "en": "The wise and noble one, endowed with vision, having reflected upon these in this world as causes of defeat by others—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:132"], "en": "He resorts to an auspicious world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:133", "PA_anya-e10_06n:135"], "en": "(From the *Vasala-sutta*) One who is angry and resentful...", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:136"], "en": "The man who is malicious and full of envy,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:137"], "en": "whose views are corrupted and who is deceitful—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:138"], "en": "know him to be an outcaste.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:140"], "en": "Whether it be a single creature or even two,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:141"], "en": "whoever harms a living being—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:142"], "en": "who has no compassion for living beings—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:143"], "en": "One should know him as an outcaste:", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:145", "PA_anya-e10_06n:146"], "en": "he who kills and obstructs villages and market towns.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:147"], "en": "Known as a reviler,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:148"], "en": "one should know him to be an outcast,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:150"], "en": "whether in the village or in the kingdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:151", "PA_anya-e10_06n:152"], "en": "One who takes by theft what belongs to others, that which is not given—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:153"], "en": "know him to be an outcaste.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:155"], "en": "He who, having incurred a debt,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:156"], "en": "flees when being called upon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:157"], "en": "thinking, \"I owe you nothing\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:158"], "en": "One should know him as an outcaste:", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:160"], "en": "whoever here, out of a desire for something trivial,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:161"], "en": "strikes people walking on the path.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:162"], "en": "Having killed even a trifling creature, he rejoices;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:163"], "en": "one should know him as an outcaste (vasala).", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:165"], "en": "He who, for his own sake or for the sake of another, [acts thus...]", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:166"], "en": "And that man who, for the sake of wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:167"], "en": "speaks falsely when questioned as a witness—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:168"], "en": "him one should know to be an outcaste.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:170", "PA_anya-e10_06n:171"], "en": "He who is seen among his kinsmen or friends, or among his wives, whether by force or out of affection,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:172"], "en": "[is one who has not transcended the world].", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:173"], "en": "One should know him as an outcaste:", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:175", "PA_anya-e10_06n:176"], "en": "he who [neglects] his mother or father when they are aged and their youth has passed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:177"], "en": "One who, though wealthy, does not support them—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:178"], "en": "one should know him as an outcaste (vasala)—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:180"], "en": "if he [neglects] his mother or father.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:181", "PA_anya-e10_06n:182"], "en": "One who strikes or reviles with harsh words one's brother, sister, or mother-in-law—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:183"], "en": "know him as an outcaste.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:185", "PA_anya-e10_06n:186"], "en": "He who, when asked about what is beneficial, instructs one in what is harmful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:187"], "en": "and counsels with concealment—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:188"], "en": "One should know him as an outcaste:", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:190"], "en": "he who, having committed an evil deed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:191"], "en": "desires that people should not know him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:192"], "en": "One whose deeds are concealed—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:193"], "en": "know him as an outcaste (vasala).", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:195"], "en": "Indeed, he who, having gone to another's family...", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:196"], "en": "Having partaken of pure food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:197"], "en": "he does not honor one who has arrived;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:198"], "en": "know him as an outcaste.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:200"], "en": "Whoever deceives a recluse, a brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:201", "PA_anya-e10_06n:202"], "en": "or even another mendicant with false speech—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:203"], "en": "One should know him as an outcaste:", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:205", "PA_anya-e10_06n:206"], "en": "he who, when a recluse or a brahmin has arrived at the time for a meal, [does not offer food].", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:207"], "en": "Or he reviles but does not give—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:208"], "en": "know him as an outcaste (vasala).", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:210"], "en": "He who speaks of what is non-existent here...", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:211"], "en": "Enveloped by delusion,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:212"], "en": "seeking to seize what belongs to another—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:213"], "en": "one should know him as an outcaste.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:215", "PA_anya-e10_06n:216", "PA_anya-e10_06n:217"], "en": "He who exalts himself and despises others is base because of that pride.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:218"], "en": "One should know him as an outcaste:", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:220"], "en": "one who is wrathful and contemptuous,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:221"], "en": "one who has evil desires, is stingy, and deceitful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:222"], "en": "One who is shameless and lacks dread of wrongdoing—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:223"], "en": "one should know him as an outcaste;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:225"], "en": "he who reviles the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:226"], "en": "Or else, one should know that his disciple—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:227", "PA_anya-e10_06n:228"], "en": "whether a wanderer or a householder— is an outcaste.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:229_0"], "en": "“Monks, when a lay follower is endowed with eight qualities, his bowl should be turned upside down.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:229_1"], "en": "He strives for the non-acquisition of gains by monks; he strives for the harm of monks; he strives for the displacement of monks from their dwellings;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:229_2"], "en": "he reviles and abuses monks; he causes dissension among monks; and he speaks dispraise of the Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:229_3"], "en": "He speaks dispraise of the Dhamma; he speaks dispraise of the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:229_4"], "en": "Monks, I allow you to overturn the alms-bowl of a lay follower who is possessed of these eight factors.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:231"], "en": "He who, being unworthy, yet claims to be worthy...", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:232"], "en": "He claims to be an arahant;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:233", "PA_anya-e10_06n:234"], "en": "one should know him as a thief in this world with its brahmas— a *vasala*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:236"], "en": "These indeed are called outcasts by me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:237"], "en": "as they have been declared;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:238"], "en": "one does not become an outcast by birth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:239"], "en": "One is not a brahmin by birth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:241"], "en": "by one's deeds one becomes an outcaste,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:242"], "en": "and by one's deeds one becomes a brahmin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:244"], "en": "Understand this also through Tadinā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:245"], "en": "for it is the illustration of how this came to pass:", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:246"], "en": "Sopāka, the son of a caṇḍāla.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:247"], "en": "Known as Mātaṅga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:249"], "en": "he attained supreme fame—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:250"], "en": "fame that is very difficult to obtain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:251", "PA_anya-e10_06n:252"], "en": "Many kshatriyas and brahmins came to attend upon him; he,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:254"], "en": "having ascended the celestial vehicle, departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:255"], "en": "He [followed] that great path free from dust;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:256"], "en": "having removed lust for sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:257"], "en": "he became one who goes to the Brahma-world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:258"], "en": "You dig at a mountain with your claws;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:259"], "en": "you chew iron with your teeth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:260"], "en": "you kick at the fire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:261", "PA_anya-e10_06n:262", "PA_anya-e10_06n:263"], "en": "He who reviles a seer stretches out his arm from behind, his head turned away, though it is unshakable.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:264"], "en": "His eyes are white like those of a dead man;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e10_06n:265"], "en": "who has made my son thus?", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"}
]
