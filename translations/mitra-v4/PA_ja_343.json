[
{"segs": ["PA_ja_343:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:0.2", "PA_ja_343:0.3"], "en": "Catukkanipāta, Cūḷakuṇālavagga (The Short Chapter on Kuṇāla)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:0.4"], "en": "3. The Kuntinī Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:1.1", "PA_ja_343:1.2"], "en": "“I dwelt in your house, always honored and revered.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:1.3"], "en": "“You yourself have now done it;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:1.4"], "en": "come, O King, let us go.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:2.1"], "en": "“Indeed, he who [responds] to what has been done and repaid...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:2.2"], "en": "Retaliation for an injury and counter-retaliation—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:2.3"], "en": "thus does enmity continue. Stop,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:2.4"], "en": "Kuntī, do not come near!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:3.1"], "en": "“Between one who has done wrong and the doer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:3.2"], "en": "friendship cannot be joined again;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:3.3"], "en": "the heart does not grant its consent.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:3.4"], "en": "“Go indeed, O bull among charioteers!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:4.1"], "en": "“The one who has done what was to be done and is its doer—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:4.2"], "en": "friendship is joined once more.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:4.3"], "en": "“Do not come under the sway of the wise,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:4.4"], "en": "nor of the foolish, O Kuntinī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_343:5.1"], "en": "The Kuntinī Jātaka, the third.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
