[
{"segs": ["PA_ja_268:0.1", "PA_ja_268:0.2", "PA_ja_268:0.3"], "en": "Jātaka Tikanipāta, Padumavagga (The Lotus Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_268:0.4"], "en": "8. The Ārāmadūsakajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_268:1.1", "PA_ja_268:1.2"], "en": "“He who was indeed the most excellent among all those who had attained peace, and was thus esteemed as the best—”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_268:1.3"], "en": "“Such is his wisdom;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_268:1.4"], "en": "how much more so that of other people!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_268:2.1"], "en": "“Just so, O Brahmā.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_268:2.2"], "en": "You revile me without knowing;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_268:2.3", "PA_ja_268:2.4"], "en": "how can one know that a tree is firmly established without seeing its root?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_268:3.1"], "en": "“I do not reproach you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_268:3.2"], "en": "nor those other monkeys in the forest; rather,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_268:3.3"], "en": "it is the one who trusts them who is to be censured.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_268:3.4"], "en": "“For whose sake are trees planted?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_268:4.1"], "en": "Thus ends the eighth Jātaka, the Ārāmadūsaka-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
