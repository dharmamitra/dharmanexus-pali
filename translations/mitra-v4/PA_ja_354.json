[
{"segs": ["PA_ja_354:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:0.2"], "en": "The Fifth Collection,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:0.3"], "en": "Chapter on the Jeweled Earrings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:0.4"], "en": "4. The Uragajātaka “Just as a snake,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:1.1"], "en": "casting off its worn-out skin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:1.2"], "en": "goes forth with its body renewed;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:1.3"], "en": "Thus, when the body is devoid of vitality,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:1.4"], "en": "deceased and passed away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:2.1"], "en": "it does not know even while being burned.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:2.2"], "en": "The lamentation of kinsmen;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:2.3"], "en": "therefore, I do not grieve for this,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:2.4"], "en": "for he has gone to whatever destination is his.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:3.1"], "en": "“Uninvited he came from there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:3.2"], "en": "unpermitted he went from here;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:3.3"], "en": "as he came, so he went.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:3.4"], "en": "In that state, what lamentation is there?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:4.1", "PA_ja_354:4.2"], "en": "Being consumed by fire, he does not know the lamentation of his kinsmen.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:4.3"], "en": "\"Therefore, I do not grieve for this;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:4.4"], "en": "he has gone to whatever destination is his.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:5.1"], "en": "\"If I were to weep, I would become emaciated.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:5.2"], "en": "What would be the fruit for me from that?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:5.3"], "en": "Only greater discontent toward my kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:5.4"], "en": "friends, and companions would arise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:6.1", "PA_ja_354:6.2"], "en": "Burning with fever, he does not know the lamentation of his kinsmen;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:6.3"], "en": "therefore, I do not grieve for this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:6.4"], "en": "“He has gone to whatever destination belongs to him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:7.1", "PA_ja_354:7.2"], "en": "Just as a child cries out after the moon as it moves away;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:7.3", "PA_ja_354:7.4"], "en": "Thus it is with one who, though having attained such perfection, still grieves for that [which has passed].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:8.1"], "en": "Being consumed by fire, he does not know.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:8.2"], "en": "The lamentation of kinsmen;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:8.3"], "en": "therefore, I do not grieve for this,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:8.4"], "en": "for he has gone to whatever destination is his.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:9.1", "PA_ja_354:9.2"], "en": "“Just as a water jar that is broken and cannot be joined again,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:9.3"], "en": "so too is this perfection.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:9.4", "PA_ja_354:10.1"], "en": "He who grieves for one who has passed away does not know that, while burning,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:10.2"], "en": "he is unaware of the lamentations of his kinsmen.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:10.3"], "en": "\"Therefore, I do not grieve for this;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:10.4"], "en": "he has gone to whatever destination is his.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_354:11.1"], "en": "The Fourth Jātaka, the Uraga Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
