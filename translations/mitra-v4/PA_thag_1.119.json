[
{"segs": ["PA_thag_1.119:0.1", "PA_thag_1.119:0.2"], "en": "Theragāthā 1.119 Ekakanipāta, Twelfth Chapter I am alone, my companion is the Dhamma; I dwell in the forest, free from fear. The world is full of many dangers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.119:0.3"], "en": "Therefore, I shall go forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.119:0.4"], "en": "The Verses of the Elder Vajjiputta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.119:1.1"], "en": "Having entered the thicket at the foot of a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.119:1.2"], "en": "having placed Nibbāna within my heart;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.119:1.3"], "en": "\"Meditate, Gotama; do not be negligent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.119:1.4"], "en": "What will that *biḷibiḷikā* do for you? ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.119:1.5"], "en": "[said] the Elder Vajjiputta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
