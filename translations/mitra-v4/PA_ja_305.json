[
{"segs": ["PA_ja_305:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:0.2"], "en": "The Section of Fours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:0.3"], "en": "Chapter on Kāliṅga", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:0.4"], "en": "5. The Sīlavīmaṁsana Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:1.1", "PA_ja_305:1.2"], "en": "\"There is no such thing as secrecy in this world for one who performs an evil deed.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:1.3"], "en": "Seeing the forested areas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:1.4"], "en": "the fool imagines them to be secluded;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:2.1"], "en": "\"I do not see anyone secluded,\" he thinks.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:2.2"], "en": "Nor does emptiness exist;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:2.3"], "en": "where I see nothing else,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:2.4"], "en": "that is non-empty for me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:3.1"], "en": "“Dujjaca and Sujaca,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:3.2"], "en": "Nanda and Sukhavaddhita;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:3.3"], "en": "the physician and Addhuvasila.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:3.4"], "en": "They have abandoned those things as being supreme.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:4.1"], "en": "And how could a brahmin abandon them,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:4.2"], "en": "he who has gone beyond all phenomena?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:4.3"], "en": "“He who guards the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:4.4"], "en": "being steadfast and striving for truth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_305:5.1"], "en": "Thus ends the fifth Jātaka, the Sīlavīmaṁsana-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
