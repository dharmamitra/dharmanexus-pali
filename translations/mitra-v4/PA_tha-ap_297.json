[
{"segs": ["PA_tha-ap_297:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:0.2"], "en": "The Chapter on Those Who Honored the Pyre (Citakapūjakavagga) 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:0.3"], "en": "The Apadāna of the Elder Gosīsanikkhepaka (He Who Deposited the Gosīra Sandalwood)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:1.1"], "en": "“Having gone out from the gate of the monastery,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:1.2", "PA_tha-ap_297:1.3"], "en": "I am experiencing my own karma upon this couch spread with ox-head wool.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:1.4"], "en": "This is the fruit of past karma:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:2.1"], "en": "noble steeds with the speed of the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:2.2"], "en": "Sindhava horses that are swift carriers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:2.3"], "en": "I experience all of this;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:2.4"], "en": "such is the fruit of the gośīrṣa [sandalwood].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:3.1"], "en": "Oh, what a deed! What a supreme deed!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:3.2"], "en": "What was well done by me in this happy field—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:3.3", "PA_tha-ap_297:3.4"], "en": "no other deed is worth a fraction of the service rendered to the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:4.1"], "en": "For ninety-four eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:4.2"], "en": "because I spread out my hair as a mat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:4.3"], "en": "I do not recall ever being born in an evil state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:4.4"], "en": "This is the fruit of spreading out [the robe]:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:5.1"], "en": "in the seventy-fifth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:5.2"], "en": "one named Suppatiṭṭhita;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:5.3", "PA_tha-ap_297:5.4"], "en": "I was once a wheel-turning monarch of great majesty and immense power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:6.1"], "en": "I possessed the four analytical knowledges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:7.1"], "en": "Thus indeed did the Venerable Elder Gosīsanikkhepaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_297:8.1"], "en": "The legend of the Elder Gosīsanikkhepaka is the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
