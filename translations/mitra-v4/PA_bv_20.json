[
{"segs": ["PA_bv_20:0.1"], "en": "Buddhavamsa 20.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:0.2"], "en": "The Chronicle of Phussa Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:1.1"], "en": "\"In that very same auspicious aeon (maṇḍakappa),...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:1.2"], "en": "The Teacher is unsurpassed; incomparable,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:1.3"], "en": "he who is equal to the unequaled,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:1.4"], "en": "Phussa, the leader of the world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:2.1", "PA_bv_20:2.2"], "en": "He too, having destroyed all darkness and unraveled the great tangle,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:2.3"], "en": "brings satisfaction to the world including the devas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:2.4"], "en": "rained down the water of the Deathless.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:3.1"], "en": "While the Wheel of Dhamma was being set in motion,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:3.2"], "en": "on the auspicious occasion of the Phussa constellation,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:3.3", "PA_bv_20:3.4"], "en": "There was the first realization for one hundred and ten million [beings].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:4.1"], "en": "For ninety million...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:4.2"], "en": "The second realization occurred;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:4.3", "PA_bv_20:4.4"], "en": "the third realization occurred for one hundred and eighty thousand [beings].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:5.1", "PA_bv_20:5.2"], "en": "There were three assemblies of the Great Seer Phussa as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:5.3"], "en": "[composed] of those whose taints were destroyed and who were stainless.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:5.4", "PA_bv_20:6.1"], "en": "Of those with peaceful minds and poised equanimity,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:6.2"], "en": "there was a first gathering of six hundred thousand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:6.3", "PA_bv_20:6.4"], "en": "There was a second assembly of five million;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:7.1"], "en": "[and] of four million.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:7.2"], "en": "This was the third assembly:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:7.3"], "en": "of those liberated through non-clinging,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:7.4"], "en": "whose rebirth-linking had been severed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:8.1"], "en": "At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:8.2"], "en": "I was a kshatriya named Vijitāvin;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:8.3"], "en": "having renounced my great sovereignty, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:8.4"], "en": "I went forth in his presence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:9.1", "PA_bv_20:9.2"], "en": "That Buddha Phussa, the leader of the world, also made this prediction concerning me:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:9.3"], "en": "“Ninety-two aeons from now,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:9.4"], "en": "this one will become a Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:10.1"], "en": "Having exerted himself in the supreme effort...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:10.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:10.3"], "en": "we shall face him directly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:11.1"], "en": "Having heard those words of his as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:11.2"], "en": "I further clarified my mind;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:11.3", "PA_bv_20:11.4"], "en": "I resolved upon higher vows for the fulfillment of the ten perfections.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:12.1", "PA_bv_20:12.2", "PA_bv_20:12.3"], "en": "Having mastered the entire Suttanta and Vinaya, as well as the ninefold teaching of the Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:12.4"], "en": "I beautified the teaching of the Jina.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:13.1"], "en": "Dwell there with diligence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:13.2"], "en": "cultivating the sublime meditation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:13.3"], "en": "Having reached perfection in the higher knowledges (abhiññā),", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:13.4"], "en": "I went to the path of the Brahma-world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:14.1"], "en": "[There is] a city named Kāsika.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:14.2"], "en": "The kṣatriya named Jayasena was the father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:14.3", "PA_bv_20:14.4"], "en": "and the mother of the Great Seer Phussa was named Sirimā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:15.1", "PA_bv_20:15.2"], "en": "For nine thousand years he dwelt at home;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:15.3"], "en": "[he was like] a golden swan with the wings of a garuḷa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:15.4"], "en": "There were three supreme palaces,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:16.1", "PA_bv_20:16.2"], "en": "and thirty thousand women beautifully adorned.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:16.3", "PA_bv_20:16.4"], "en": "A woman named Kisāgotamī and her son named Anūpama,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:17.1"], "en": "having seen four omens—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:17.2"], "en": "He departed by elephant-vehicle;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:17.3", "PA_bv_20:17.4"], "en": "for six months, the Supreme Person practiced the course of striving on foot.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:18.1"], "en": "Being entreated by Brahmā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:18.2"], "en": "the virtuous Phussa, the leader of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:18.3"], "en": "the Great Hero, set the Wheel of Dhamma in motion.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:18.4"], "en": "In the Deer Park, the Supreme among Men,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:19.1"], "en": "Dhammasena, was well-guarded;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:19.2"], "en": "they were his chief disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:19.3", "PA_bv_20:19.4"], "en": "The attendant named Sabhiya was also the attendant of the Great Seer Phussa;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:20.1"], "en": "as were Cālā and Upacālā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:20.2"], "en": "were his chief female disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:20.3", "PA_bv_20:20.4"], "en": "the Bodhi tree of that Blessed One is called the Āmaṇḍa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:21.1", "PA_bv_20:21.2"], "en": "Dhanañjaya and Visākha were the foremost attendants,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:21.3"], "en": "as were Paduma and Nāga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:21.4"], "en": "They were his chief attendants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:22.1", "PA_bv_20:22.2"], "en": "That Sage, too, rose up to a height of fifty-eight ratanas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:22.3"], "en": "He shines like the sun,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:22.4"], "en": "like the full moon, king of stars.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:23.1"], "en": "For ninety thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:23.2"], "en": "As long as life remained,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:23.3", "PA_bv_20:23.4"], "en": "for that long he stayed and delivered many people.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:24.1", "PA_bv_20:24.2"], "en": "Having exhorted many beings and delivered many people,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:24.3"], "en": "that Teacher of incomparable fame—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:24.4"], "en": "He has attained Nibbāna together with his disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:25.1"], "en": "Phussa, the supreme Victor and Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:25.2"], "en": "has attained Nibbāna in the Senārāma monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:25.3", "PA_bv_20:25.4"], "en": "“The expansion of the [Buddha’s] elements occurred in various regions.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_20:26.1"], "en": "This is the eighteenth chapter on the lineage of the Blessed One Phussa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
