[
{"segs": ["PA_tha-ap_78:0.1", "PA_tha-ap_78:0.2", "PA_tha-ap_78:0.3"], "en": "The Legend of the Elder Tiṇasantharadāyaka From the Nāgasamāla Chapter of the Therāpadāna, Number Six.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:1.1"], "en": "Not far from the Himālaya mountains,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:1.2"], "en": "there was a great lake of lotuses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:1.3"], "en": "covered with hundred-petaled blooms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:1.4"], "en": "It was garlanded with various birds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:2.1"], "en": "Having bathed and drunk there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:2.2"], "en": "I dwelt not far away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:2.3", "PA_tha-ap_78:2.4"], "en": "I saw the foremost of ascetics traveling along the path of the wind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:3.1"], "en": "having known my intention, he approached me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:3.2"], "en": "The Teacher, unsurpassed in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:3.3"], "en": "having descended from the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:3.4"], "en": "stood for a moment upon the ground.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:4.1"], "en": "Having grasped some grass with my tusk,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:4.2"], "en": "I offered it as a seat;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:4.3"], "en": "there the Blessed One sat down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:4.4"], "en": "The Leader of the World’s three [sons],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:5.1"], "en": "having inspired confidence in his own mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:5.2"], "en": "paid homage to the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:5.3"], "en": "I drew back and stepped aside,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:5.4"], "en": "gazing upon the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:6.1"], "en": "By that clarity of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:6.2"], "en": "I was reborn in the Nimmānarati heaven;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:6.3"], "en": "I do not recall ever falling into an unhappy destination—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:6.4"], "en": "this is the fruit of spreading out [a seat].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:7.1"], "en": "In this second aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:7.2"], "en": "there was a Miga Sammata Kṣatriya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:7.3"], "en": "endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:7.4"], "en": "A wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:8.1", "PA_tha-ap_78:8.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:8.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:9.1"], "en": "In this way, it is said that the venerable elder Tiṇasantharadāyaka recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_78:10.1"], "en": "This is the sixth legend of the elder Tiṇasantharadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
