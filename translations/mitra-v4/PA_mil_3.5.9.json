[
{"segs": ["PA_mil_3.5.9:0.1"], "en": "The Questions of Milinda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.5.9:0.2"], "en": "Chapter on the Buddha, 9.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.5.9:0.3"], "en": "The Question on Knowing Arising and Passing Away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.5.9:1.1"], "en": "The King said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.5.9:1.2"], "en": "\"Venerable Nāgasena, does he who arises know, 'I shall arise'?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.5.9:1.3"], "en": "\"Yes, Great King, he who arises knows, 'I shall arise.'\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.5.9:2.1"], "en": "“Make a simile.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.5.9:2.2"], "en": "“Suppose, great king, a householder farmer, having sown seeds in the earth, knows that when the rain falls properly, ‘the grain will grow,’ would he not know this?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.5.9:2.3"], "en": "“Yes, venerable sir, he would know it.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.5.9:2.4"], "en": "“In the same way, Great King, he who arises knows: ‘I shall arise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.5.9:3.1"], "en": "“Excellent, Bhante Nāgasena!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.5.9:4.1"], "en": "This is the ninth question: On Knowing Arising.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
