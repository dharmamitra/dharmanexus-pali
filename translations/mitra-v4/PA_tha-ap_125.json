[
{"segs": ["PA_tha-ap_125:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:0.2"], "en": "Sereyyavagga, 3:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:0.3"], "en": "The Apadāna of the Elder Pāyasadāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:1.1"], "en": "“The Sambuddha, golden-hued,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:1.2"], "en": "endowed with the thirty-two excellent marks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:1.3"], "en": "has gone forth from the forest.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:1.4"], "en": "Honored by the community of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:2.1", "PA_tha-ap_125:2.2"], "en": "I increased the milk-rice in a magnificent bronze bowl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:2.3"], "en": "Desiring to offer an oblation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:2.4"], "en": "I presented a sacrificial gift.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:3.1"], "en": "At that time, the Blessed One—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:3.2"], "en": "The eldest in the world, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:3.3"], "en": "having well ascended the walking-path in the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:3.4"], "en": "the abode of the wind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:4.1"], "en": "And having seen that marvel,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:4.2"], "en": "that wonder which makes the hair stand on end,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:4.3"], "en": "he set aside the bronze bowl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:4.4"], "en": "I paid homage to Vipassī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:5.1"], "en": "You are a god, omniscient,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:5.2"], "en": "together with the world of gods and humans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:5.3"], "en": "\"Out of compassion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:5.4"], "en": "O Great Sage, please accept it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:6.1"], "en": "The Blessed One accepted it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:6.2"], "en": "The All-Knowing One, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:6.3", "PA_tha-ap_125:6.4"], "en": "the Teacher, the Great Sage in the world, having understood my intention.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:7.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:7.2"], "en": "because of the gift I gave at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:7.3"], "en": "I do not know a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:7.4"], "en": "This is the fruit of that milk-rice offering:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:8.1"], "en": "in the forty-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:8.2"], "en": "there was a kshatriya named Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:8.3"], "en": "Endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:8.4"], "en": "a wheel-turning monarch of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:9.1"], "en": "[possessing] the four analytical knowledges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:9.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:9.3"], "en": "the Buddha’s teaching has been fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:10.1"], "en": "Thus indeed did the venerable elder Pāyasadāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_125:11.1"], "en": "The legend of the Elder Pāyasadāyaka is the third.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
