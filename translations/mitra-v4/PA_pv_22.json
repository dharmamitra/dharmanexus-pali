[
{"segs": ["PA_pv_22:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:0.2"], "en": "Ubbarivagga, 10.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:0.3"], "en": "The Story of the Ghost of Uttara’s Mother", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:1.1", "PA_pv_22:1.2", "PA_pv_22:1.3"], "en": "A female ghost approached a monk who had gone to his midday rest, sitting on the bank of the Ganges.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:1.4"], "en": "Ugly and fearsome to behold,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:2.1"], "en": "her hair was exceedingly long,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:2.2"], "en": "hanging down even to the ground.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:2.3"], "en": "Covered by her hair,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:2.4"], "en": "she said this to the ascetic:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:3.1"], "en": "“For fifty-five years, [I have been a nun].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:3.2"], "en": "Since I passed away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:3.3"], "en": "I do not recall having eaten anything,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:3.4"], "en": "nor even having drunk water.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:3.5"], "en": "“Give me some water, venerable sir;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:3.6"], "en": "I am thirsty for water.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:4.1"], "en": "“Here is the cool water of the Ganges.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:4.2"], "en": "\"It flows from the Himavat mountains;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:4.3"], "en": "drink from it after taking some from here—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:4.4"], "en": "why do you beg me for water?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:5.1", "PA_pv_22:5.2"], "en": "“If, venerable sir, I myself take drinking water from the Ganges,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:5.3"], "en": "my blood turns to bile.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:5.4"], "en": "\"Therefore, I ask you for water.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:6.1", "PA_pv_22:6.2"], "en": "\"What misdeed have I committed by body, speech, or mind?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:6.3", "PA_pv_22:6.4"], "en": "“By the ripening of what karma does the Gaṅgā become red for you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:7.1"], "en": "“My son, named Uttara,” he replied.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:7.2"], "en": "He was a faithful lay follower;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:7.3"], "en": "yet, against my will,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:7.4"], "en": "he gave alms to the ascetics.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:8.1"], "en": "Robes, almsfood,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:8.2"], "en": "requisites, and lodgings—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:8.3"], "en": "these I censure.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:8.4"], "en": "Afflicted by stinginess,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:9.1", "PA_pv_22:9.2"], "en": "you offer these to the recluses against my will.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:9.3"], "en": "Robes, almsfood,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:9.4"], "en": "requisites, and lodgings—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:10.1"], "en": "these are what you will have in the world beyond.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:10.2"], "en": "\"May it be red, Uttara;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:10.3"], "en": "by the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:10.4"], "en": "may the Ganges be red for me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_22:11.1"], "en": "The Tenth Story: The Petī Uttaramātā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"}
]
