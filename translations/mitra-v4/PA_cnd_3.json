[
{"segs": ["PA_cnd_3:0.1"], "en": "Cūḷaniddesa:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:0.2"], "en": "Verses of the Pārāyaṇa Chapter 3.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:0.3"], "en": "Verses in Praise of the Pārāyaṇa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:1.1"], "en": "Thus spoke the Blessed One while staying among the Magadhans at the Pāsāṇaka Cetiya. Being questioned and asked about each question, he answered the sixteen brahmins who were his attendants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:1.2"], "en": "If one, having understood the meaning and having understood the Dhamma of each single question, were to practice in accordance with the Dhamma, they would surely go to the further shore of aging and death.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:1.3"], "en": "“These teachings lead to the further shore.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:1.4"], "en": "Therefore, \"The Way to the Beyond\" (Pārāyana) is indeed the designation for this discourse on the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:2.1"], "en": "Ajita, Tissa Metteyya,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:2.2"], "en": "Puṇṇaka, and then Mettagū;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:2.3"], "en": "Dhotaka and Upasīva,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:2.4"], "en": "Nanda and Hemaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:3.1"], "en": "both Todeyya and Kappa—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:3.2"], "en": "And the wise Jatukaṇṇī;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:3.3"], "en": "Bhadrāvudha and Udaya,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:3.4"], "en": "and the brahmin Posāla as well.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:3.5"], "en": "Mogharāja the wise,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:3.6"], "en": "and Piṅgiya the great seer—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:4.1"], "en": "these approached the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:4.2", "PA_cnd_3:4.3", "PA_cnd_3:4.4"], "en": "Approaching the Buddha, the most excellent one, they questioned the Sage who has perfected his conduct regarding subtle and profound questions.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:5.1", "PA_cnd_3:5.2", "PA_cnd_3:5.3"], "en": "The Buddha, being questioned, answered their questions exactly as they were, according to reality; by means of that explanation of their questions, [he satisfied them].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:5.4"], "en": "The Sage satisfied the brahmins.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:6.1"], "en": "They were satisfied by the Visionary Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:6.2"], "en": "the Kinsman of the Sun.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:6.3", "PA_cnd_3:6.4"], "en": "They lived the holy life in the presence of the one of excellent wisdom;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:7.1"], "en": "for each and every question,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:7.2", "PA_cnd_3:7.3", "PA_cnd_3:7.4"], "en": "Whoever should practice in accordance with what has been taught by the Buddha will go from this shore to the further shore.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:8.1", "PA_cnd_3:8.2"], "en": "One who develops the supreme path may go from the hither shore to the further shore;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:8.3"], "en": "that path leads to the further shore.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cnd_3:8.4"], "en": "Therefore, it is called \"The Way to the Beyond.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
