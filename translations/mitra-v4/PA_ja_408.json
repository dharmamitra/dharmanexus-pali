[
{"segs": ["PA_ja_408:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:0.2"], "en": "The Seventh Chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:0.3"], "en": "the Gandhāra Section", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:0.4"], "en": "3. The Kumbhakāra Jātaka “O Mother,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:1.1"], "en": "here in the midst of the forest is a mango grove,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:1.2"], "en": "dark-blue in luster, laden with fruit, and grown to full maturity.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:1.3"], "en": "I saw that [stūpa] shattered for the sake of its fruit;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:1.4"], "en": "having seen it, I wander on alms-round.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:2.1"], "en": "[I see] a well-polished stone, completed by a hero among men.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:2.2"], "en": "A woman carried a pair [of garments] in silence;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:2.3"], "en": "when a second arrived, there was noise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:2.4"], "en": "Seeing that, I wander for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:3.1"], "en": "The crows, having gathered together in great numbers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:3.2"], "en": "attacked the one who was carrying off a corpse;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:3.3"], "en": "for the sake of food, they struck him down.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:3.4"], "en": "Having seen that, I wander for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:4.1"], "en": "I am like a bull in the midst of the herd,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:4.2"], "en": "possessing beauty and strength, with quivering horns.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:4.3"], "en": "I saw him pierced by the cause of sensual desire;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:4.4"], "en": "having seen that, I wander on my alms-round.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:5.1"], "en": "\"Karaṇḍaka of the Kaliṅgas...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:5.2"], "en": "Naggaji was the king of the Gandhāras;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:5.3"], "en": "King Nimi of the Videhas;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:5.4"], "en": "and Dummukha of the Pañcālas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:5.5"], "en": "Having abandoned their kingdoms,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:5.6"], "en": "these people went forth as possessors of nothing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:6.1"], "en": "All of them, equal to gods, have gathered here together.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:6.2"], "en": "\"Just as these fires are blazing,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:6.3"], "en": "so too shall I wander alone, O Bhaggava,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:6.4"], "en": "having abandoned all sensual pleasures, however great they may be.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:7.1"], "en": "“This is indeed the time, for there is no other;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:7.2"], "en": "there will be no one to instruct me later.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:7.3"], "en": "I too shall wander alone, Bhaggava.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:7.4"], "en": "Like a bird released from a man’s hand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:8.1"], "en": "They know what is raw and what is cooked,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:8.2"], "en": "as well as what is salty and what is unsalted.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:8.3"], "en": "Having seen him, I went forth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:8.4"], "en": "you too, O Great One, should practice the practice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_408:9.1"], "en": "The Third Birth Story, the Potter’s Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
