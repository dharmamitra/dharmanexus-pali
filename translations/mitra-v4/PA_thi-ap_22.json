[
{"segs": ["PA_thi-ap_22:0.1"], "en": "The Therī-apadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:0.2"], "en": "Kuṇḍalakesīvagga 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:0.3"], "en": "The Apadāna of the Elder Nun Kisāgotamī", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:1.2"], "en": "who has gone beyond all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:1.3"], "en": "[lived] one hundred thousand aeons ago from now.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:1.4"], "en": "The Leader appeared in that eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:2.1", "PA_thi-ap_22:2.2"], "en": "At that time, I was born in Haṃsavatī into a certain family.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:2.3"], "en": "Having approached that best of men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:2.4"], "en": "I went to him for refuge;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:3.1"], "en": "and I heard his Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:3.2"], "en": "Connected with the Four Noble Truths,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:3.3"], "en": "sweet, bringing supreme satisfaction,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:3.4"], "en": "and leading to the bliss of peace from the cycle of existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:4.1", "PA_thi-ap_22:4.2", "PA_thi-ap_22:4.3"], "en": "And then the Hero, establishing a bhikkhunī who wore coarse robes as foremost among them—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:4.4"], "en": "The Supreme Person praised her,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:5.1", "PA_thi-ap_22:5.2"], "en": "having generated no small measure of joy upon hearing the virtues of the bhikkhunī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:5.3", "PA_thi-ap_22:5.4"], "en": "Having performed service for the Buddha according to one's capacity and strength,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:6.1"], "en": "and having prostrated to that supreme Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:6.2"], "en": "I aspired for that state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:6.3"], "en": "then the Sambuddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:6.4"], "en": "the Leader, rejoiced in my attainment of that state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:7.1"], "en": "\"In a hundred thousand aeons hence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:7.2"], "en": "one born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:7.3"], "en": "known by the family name Gotama, will appear.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:7.4"], "en": "A Teacher shall appear in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:8.1"], "en": "His heirs in the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:8.2"], "en": "his own legitimate sons, fashioned from the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:8.3"], "en": "“By the name Kisāgotamī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:8.4"], "en": "she will become a female disciple of the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:9.1"], "en": "Having heard this, she became joyful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:9.2"], "en": "For as long as life lasted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:9.3"], "en": "with a mind of loving-kindness, I served the Jina,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:9.4"], "en": "the Guide, with the four requisites.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:10.1", "PA_thi-ap_22:10.2"], "en": "By that well-performed kamma and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:10.3"], "en": "having abandoned this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:10.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:11.1"], "en": "In this auspicious eon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:11.2"], "en": "I was a highly renowned kinsman of Brahmā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:11.3"], "en": "One named Kassapa by clan arose,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:11.4"], "en": "the best among those who speak;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:12.1"], "en": "he was the attendant of the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:12.2"], "en": "At that time there was a lord of men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:12.3"], "en": "the King of Kāsi named Kikī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:12.4"], "en": "in the supreme city of Bārāṇasī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:13.1"], "en": "I was his fifth daughter,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:13.2"], "en": "renowned by the name Dhammā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:13.3"], "en": "having heard the Dhamma from the Foremost Victor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:13.4"], "en": "I resolved to go forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:14.1"], "en": "But our father did not grant us permission;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:14.2"], "en": "at that time, we remained right there in the household.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:14.3"], "en": "For twenty thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:14.4", "PA_thi-ap_22:15.1"], "en": "we wandered untiringly, practicing the celibate life of a maiden.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:15.2"], "en": "The princesses were raised in comfort;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:15.3", "PA_thi-ap_22:15.4"], "en": "seven daughters who delighted in attending upon the Buddha were joyful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:16.1"], "en": "Samaṇī and Samaṇaguttā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:16.2"], "en": "Bhikkhunī and Bhikkhudāyikā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:16.3"], "en": "Dhammā and Sudhammā as well.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:16.4"], "en": "The seventh is Saṅghadāyikā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:17.1"], "en": "Khemā, Uppalavaṇṇā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:17.2"], "en": "Paṭācārā, and Kuṇḍalā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:17.3"], "en": "I and Dhammadinnā—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:17.4"], "en": "Visākhā was the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:18.1"], "en": "By those well-performed deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:18.2"], "en": "And through my volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:18.3"], "en": "having cast off this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:18.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:19.1"], "en": "And now, in my final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:19.2"], "en": "I was born into a family of wealthy merchants;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:19.3"], "en": "[but] I was destitute, penniless, and ruined.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:19.4"], "en": "And she went to a wealthy family. Thinking,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:20.1", "PA_thi-ap_22:20.2"], "en": "\"Except for my husband, all the rest will despise me as one who is destitute,\" she remained there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:20.3"], "en": "And when I had given birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:20.4"], "en": "I was beloved by all.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:21.1"], "en": "When that auspicious youth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:21.2"], "en": "Tender and nurtured in comfort,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:21.3", "PA_thi-ap_22:21.4"], "en": "he was as dear to me as my own life when he fell under the power of Yama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:22.1"], "en": "Speaking of the danger of grief,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:22.2"], "en": "with tearful eyes and weeping faces,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:22.3"], "en": "they took hold of the corpse of the dead man.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:22.4"], "en": "While I was lamenting,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:23.1", "PA_thi-ap_22:23.2"], "en": "I was then sent by one person to approach the supreme physician.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:23.3", "PA_thi-ap_22:23.4"], "en": "I said, \"Give me medicine, O sir, to revive my son. [He replied:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:24.1"], "en": "\"There is no one who has died and yet exists.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:24.2", "PA_thi-ap_22:24.3"], "en": "\"Then bring some mustard seeds from the house,\" said the Victor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:24.4"], "en": "who is skilled in the means of discipline.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:25.1", "PA_thi-ap_22:25.2"], "en": "Then, having gone to Sāvatthī, I did not find such a house;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:25.3"], "en": "how then could I obtain white mustard seeds? Therefore,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:25.4"], "en": "Then, having regained mindfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:26.1", "PA_thi-ap_22:26.2"], "en": "I cast aside that corpse and approached the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:26.3"], "en": "Seeing me from afar,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:26.4"], "en": "he spoke with a sweet voice:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:27.1"], "en": "“Though one should live for a hundred years...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:27.2"], "en": "Not seeing rise and fall,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:27.3", "PA_thi-ap_22:27.4"], "en": "one day of life spent seeing rise and fall is better.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:28.1"], "en": "This is not the custom of the village, nor is it the custom of the town,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:28.2"], "en": "nor even the custom of a single family;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:28.3"], "en": "it is for the entire world, including the devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:28.4"], "en": "\"That very thing is impermanence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:29.1"], "en": "Having heard these verses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:29.2"], "en": "I purified the eye of Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:29.3"], "en": "Then, having understood the true Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:29.4"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:30.1"], "en": "Having thus gone forth, being at peace—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:30.2"], "en": "Applying myself to the teaching of the Conqueror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:30.3", "PA_thi-ap_22:30.4"], "en": "in no long time at all I attained arhatship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:31.1"], "en": "I am a master of the supernormal powers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:31.2"], "en": "I possess the divine ear-element,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:31.3"], "en": "and I know the minds of others.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:31.4"], "en": "I am one who carries out the Teacher’s instruction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:32.1"], "en": "I know my former births,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:32.2"], "en": "and the divine eye has been purified.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:32.3"], "en": "Having dispelled all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:32.4"], "en": "I became pure and stainless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:33.1"], "en": "The Teacher has been served by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:33.2"], "en": "The teaching of the Buddha has been fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:33.3"], "en": "the heavy burden has been laid down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:33.4"], "en": "and the conduit to existence has been uprooted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:34.1", "PA_thi-ap_22:34.2"], "en": "That purpose for which I went forth from the home life into homelessness—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:34.3"], "en": "that goal has been attained by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:34.4"], "en": "The destruction of all fetters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:35.1", "PA_thi-ap_22:35.2"], "en": "Likewise, in regard to meaning, phenomena, language, and eloquence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:35.3", "PA_thi-ap_22:35.4"], "en": "Through the power of the Best of Buddhas, my knowledge has become stainless and pure,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:36.1"], "en": "like having removed [jewels] from a heap of refuse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:36.2"], "en": "From cemeteries and even from roadways,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:36.3", "PA_thi-ap_22:36.4"], "en": "I have made my outer robe (saṅghāṭikā) and wear this coarse garment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:37.1", "PA_thi-ap_22:37.2"], "en": "The Jina, pleased with that quality of wearing coarse robes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:37.3"], "en": "placed him at the very head of those who possess it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:37.4"], "en": "The Guide among assemblies:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:38.1", "PA_thi-ap_22:38.2"], "en": "my defilements have been incinerated... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:38.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:39.1", "PA_thi-ap_22:39.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:39.3"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:40.1", "PA_thi-ap_22:40.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:40.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:41.1"], "en": "Thus indeed did the bhikkhunī Kisāgotamī speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_22:42.1"], "en": "This is the second legend of the elder nun Kisāgotamī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
