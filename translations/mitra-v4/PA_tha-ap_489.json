[
{"segs": ["PA_tha-ap_489:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:0.2"], "en": "The Chapter on Rag-Robes (Paṁsukūlavagga),", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:0.3"], "en": "Number 7, The Deeds of the Elder Pulinuppādaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:1.1"], "en": "\"On a mountain in the Himalayas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:1.2"], "en": "there was an ascetic named Devala;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:1.3"], "en": "there my walking path was located.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:1.4"], "en": "Built by non-human beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:2.1", "PA_tha-ap_489:2.2"], "en": "he was burdened with a mass of matted hair and always carried a water-pot.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:2.3"], "en": "Seeking the supreme goal,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:2.4"], "en": "I then departed from the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:3.1"], "en": "Eighty-four thousand [monks]—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:3.2"], "en": "My students attended upon me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:3.3"], "en": "devoted to their own kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:3.4"], "en": "they then lived in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:4.1"], "en": "Having gone forth from Assama,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:4.2"], "en": "he built the Pulina-cetiya;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:4.3"], "en": "having gathered various flowers, he offered them there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:4.4"], "en": "I worshipped that shrine;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:5.1"], "en": "having brought peace to my mind there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:5.2"], "en": "I entered the hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:5.3", "PA_tha-ap_489:5.4"], "en": "All the students gathered together and asked me about this matter:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:6.1"], "en": "\"A stupa has been built from sand.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:6.2"], "en": "“O King, whom you revere—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:6.3"], "en": "we too wish to know this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:6.4"], "en": "Being asked, please explain it to us.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:7.1", "PA_tha-ap_489:7.2"], "en": "“Have the words of the mantras been pointed out by those who possess vision and great renown?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:7.3"], "en": "To them indeed I pay homage.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:7.4"], "en": "To the Best of Buddhas, of Great Renown:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:8.1"], "en": "What are these great heroes like—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:8.2"], "en": "omniscient leaders of the world?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:8.3", "PA_tha-ap_489:8.4"], "en": "Of what appearance and of what conduct are those Buddhas of great renown,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:9.1"], "en": "who possess the thirty-two marks?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:9.2", "PA_tha-ap_489:9.3"], "en": "And there are also forty types of *dijā* [trees];", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:9.4"], "en": "their *nettā* and *gopakhumā* resemble the *jiñjukā* fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:10.1"], "en": "And as those Buddhas walk,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:10.2"], "en": "they look ahead only the distance of a yoke;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:10.3"], "en": "their knees do not make a sound.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:10.4", "PA_tha-ap_489:11.1"], "en": "The sound of their joints is not heard. As they walk,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:11.2"], "en": "the Sugatas move as if lifting themselves up.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:11.3"], "en": "They place the right foot first;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:11.4"], "en": "this is the natural law of the Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:12.1"], "en": "And those Buddhas are fearless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:12.2"], "en": "Like a lion, the king of beasts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:12.3"], "en": "they do not exalt themselves,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:12.4"], "en": "nor do they disparage living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:13.1"], "en": "Free from honor and dishonor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:13.2"], "en": "equal toward all living beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:13.3"], "en": "the Buddhas do not exalt themselves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:13.4"], "en": "This is the natural law of the Buddhas:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:14.1"], "en": "when the Perfectly Enlightened Ones arise,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:14.2"], "en": "they bring forth light.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:14.3", "PA_tha-ap_489:14.4"], "en": "They cause this entire earth to tremble in six ways;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:15.1"], "en": "they see even the hell realms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:15.2"], "en": "Then the hell is extinguished;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:15.3"], "en": "a great cloud pours down rain—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:15.4"], "en": "this is the natural law for Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:16.1"], "en": "Such are those great beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:16.2"], "en": "incomparable and of great renown;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:16.3"], "en": "they cannot be surpassed in their excellence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:16.4"], "en": "\"The Tathāgatas are immeasurable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:17.1", "PA_tha-ap_489:17.2"], "en": "All my disciples, full of reverence, rejoiced in my words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:17.3", "PA_tha-ap_489:17.4"], "en": "And so they practiced according to their ability and according to their strength;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:18.1"], "en": "they honored the sandy bank.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:18.2"], "en": "Desiring their own kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:18.3"], "en": "they have faith in my words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:18.4"], "en": "with minds that revere the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:19.1"], "en": "Then, descending from Tusita,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:19.2", "PA_tha-ap_489:19.3"], "en": "the son of the gods of great renown was reborn in the mother’s womb.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:19.4"], "en": "The ten thousand worlds trembled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:20.1", "PA_tha-ap_489:20.2"], "en": "Standing upon the walking path not far from the lake, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:20.3", "PA_tha-ap_489:20.4"], "en": "All the disciples gathered together and came into my presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:21.1"], "en": "\"The bull roars upon the earth,\" they said.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:21.2"], "en": "He coos like the king of birds;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:21.3"], "en": "he leaps like a crocodile—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:21.4"], "en": "what will be the result?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:22.1", "PA_tha-ap_489:22.2"], "en": "“That which I have dedicated to the Perfectly Awakened One near the sand stupa—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:22.3"], "en": "may that Blessed One now be my Teacher.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:22.4"], "en": "He entered his mother’s womb.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:23.1", "PA_tha-ap_489:23.2"], "en": "Having spoken this discourse on Dhamma and having extolled the Great Sage, they—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:23.3"], "en": "Having dismissed my own disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:23.4"], "en": "I sat down cross-legged;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:24.1"], "en": "indeed, my strength was exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:24.2"], "en": "Afflicted by a supreme disease,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:24.3"], "en": "having recollected that Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:24.4"], "en": "I passed away there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:25.1"], "en": "Then all the disciples gathered together and,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:25.2", "PA_tha-ap_489:25.3"], "en": "taking my body, they prepared a funeral pyre.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:25.4"], "en": "They approached the funeral pyre.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:26.1", "PA_tha-ap_489:26.2"], "en": "Having surrounded the pyre and placed their joined palms to their heads, they said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:26.3"], "en": "Overwhelmed by the dart of grief,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:26.4"], "en": "they gathered together and wailed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:27.1"], "en": "as they were thus lamenting,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:27.2"], "en": "Then he approached the funeral pyre and said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:27.3"], "en": "\"I am your teacher;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:27.4"], "en": "do not grieve, O wise ones.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:28.1"], "en": "Strive for the goal that is truly good,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:28.2"], "en": "untiringly day and night;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:28.3"], "en": "do not be heedless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:28.4"], "en": "The opportunity has been provided for you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:29.1"], "en": "Having instructed my own disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:29.2"], "en": "I have returned once more to the world of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:29.3", "PA_tha-ap_489:29.4"], "en": "For eighteen eons I delighted in the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:30.1"], "en": "and five hundred times, too—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:30.2"], "en": "I was a wheel-turning monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:30.3"], "en": "and many hundreds of times,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:30.4"], "en": "I exercised sovereignty over the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:31.1"], "en": "In all the remaining eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:31.2"], "en": "I wandered about, mixed among them;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:31.3"], "en": "I do not recall ever being born in an evil state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:31.4"], "en": "This is the fruit of arising:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:32.1", "PA_tha-ap_489:32.2"], "en": "just as many trees blossom in the month of Kattika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:32.3"], "en": "In the same way, at this time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:32.4"], "en": "I have been made to blossom by the Great Seer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:33.1"], "en": "My energy is the yoke-bearing ox.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:33.2"], "en": "Bringing about security through yoga;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:33.3"], "en": "like an elephant that has severed its bonds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:33.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:34.1"], "en": "In a hundred thousand aeons past,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:34.2"], "en": "because I praised the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:34.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:34.4"], "en": "This is the fruit of praising [the Buddha].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:35.1"], "en": "The defilements have been incinerated by me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:35.2"], "en": "[etc.]", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:35.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:36.1", "PA_tha-ap_489:36.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:36.3"], "en": "Such is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:37.1", "PA_tha-ap_489:37.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:37.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:38.1"], "en": "Thus indeed did the venerable elder Pulinuppādaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_489:39.1"], "en": "This concludes the seventh legend of the elder Pulinuppādaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
