        "suttacentral_link": "https://suttacentral.net/ne31/pli/ms#2.2"
    },
    {
        "segmentnr": "PA_ne_31:2.3",
        "original": "“Sammādiṭṭhipurekkhāro”ti sammādiṭṭhiyā gahitāya gahitāni bhavanti pañcindriyāni, ayaṁ indriyehi otaraṇā.",
        "analyzed": "sammādiṭṭhi purekkhāro ti sammādiṭṭhiyāḥ gahitāya gahitāni bhavanti pañca indriyāni ayam indriyehi otaraṇā ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/ne31/pli/ms#2.3"
    },
    {
        "segmentnr": "PA_ne_31:3.1",
        "original": "Tāniyeva indriyāni vijjā, vijjuppādā avijjānirodho, avijjānirodhā saṅkhāranirodho, saṅkhāranirodhā viññāṇanirodho, evaṁ sabbaṁ, ayaṁ paṭiccasamuppādena otaraṇā.",
        "analyzed": "tāni yeva indriyāni vijjā vijjuppādāḥ avijjā nirodhaḥ avijjā nirodhā saṅkhāra nirodho saṅkhāra nirodhā viññāṇa nirodho evam paṭiccasamuppādena otaraṇā ",
        "folio": "3",
        "suttacentral_link": "https://suttacentral.net/ne31/pli/ms#3.1"
    },
    {
        "segmentnr": "PA_ne_31:4.1",
        "original": "Tāniyeva pañcindriyāni tīhi khandhehi saṅgahitāni—",
        "analyzed": "pañca indriyāni tīhi khandhehi saṅgahitāni ",
        "folio": "4",
        "suttacentral_link": "https://suttacentral.net/ne31/pli/ms#4.1"
    },
    {
        "segmentnr": "PA_ne_31:4.2",
        "original": "sīlakkhandhena samādhikkhandhena paññākkhandhena.",
        "analyzed": "sīla kkhandhena samādhi kkhandhena paññā kkhandhena ",
        "folio": "4",
        "suttacentral_link": "https://suttacentral.net/ne31/pli/ms#4.2"
    },
    {
        "segmentnr": "PA_ne_31:4.3",
        "original": "Ayaṁ khandhehi otaraṇā.",
        "analyzed": "ayam khandhehi otaraṇā ",
