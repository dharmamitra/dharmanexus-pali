[
{"segs": ["PA_ja_459:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:0.2", "PA_ja_459:0.3"], "en": "The Section of Eleven, Chapter on the Supporter of His Mother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:0.4"], "en": "5. The Water-Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:1.1", "PA_ja_459:1.2"], "en": "“I consumed water that was not given, though it was my friend’s drink.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:1.3", "PA_ja_459:1.4"], "en": "Because of that, I later felt revulsion for the evil deed I had committed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:1.5"], "en": "may I never again commit such evil.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:1.6"], "en": "Therefore I went forth as a monk.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:2.1"], "en": "But upon seeing another's wife,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:2.2"], "en": "desire arose within me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:2.3", "PA_ja_459:2.4"], "en": "Because of that, I later felt remorse for the evil deed I had committed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:2.5"], "en": "may I never again commit such evil.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:2.6"], "en": "Therefore I have gone forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:3.1", "PA_ja_459:3.2"], "en": "O Great King, thieves seized my father in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:3.3"], "en": "When questioned by them, though knowing the answer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:3.4"], "en": "I explained it otherwise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:4.1"], "en": "Because of that, I later felt deep remorse.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:4.2"], "en": "That evil was committed by me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:4.3"], "en": "may I not commit evil again—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:4.4"], "en": "therefore have I gone forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:5.1", "PA_ja_459:5.2"], "en": "When the Soma sacrifice was set forth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:5.3"], "en": "I gave my consent to those who were taking life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:6.1", "PA_ja_459:6.2"], "en": "Because of that, I later felt remorse for the evil deed I had committed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:6.3"], "en": "may I never again commit such evil.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:6.4"], "en": "Therefore I have gone forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:7.1", "PA_ja_459:7.2"], "en": "Those people who were the first among us to consume fermented liquor, spirits, and intoxicants—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:7.3", "PA_ja_459:7.4"], "en": "That they prepared intoxicants for the harm of many,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:7.5"], "en": "I approved of them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:8.1", "PA_ja_459:8.2"], "en": "Because of that, I later felt remorse for the evil deed I had committed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:8.3"], "en": "may I never again commit such evil.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:8.4"], "en": "\"Therefore I have gone forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:9.1"], "en": "Fie on the many sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:9.2"], "en": "which are foul-smelling and full of thorns!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:9.3"], "en": "“Though I indulged in them,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:9.4"], "en": "I did not obtain such happiness as this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:10.1"], "en": "‘Sensual pleasures are highly gratifying and pleasant;’”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:10.2"], "en": "There is no happiness higher than sensual pleasures;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:10.3", "PA_ja_459:10.4"], "en": "those who indulge in sensual pleasures are reborn in heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:11.1"], "en": "“Sensual pleasures offer little gratification and are painful;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:11.2"], "en": "there is no suffering greater than sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:11.3"], "en": "Those who indulge in sensual pleasures—”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:11.4"], "en": "They are reborn in hell,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:12.1", "PA_ja_459:12.2"], "en": "like a well-sharpened sword or a well-crafted spear.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:12.3", "PA_ja_459:12.4"], "en": "Even a spear thrust into the chest is less painful than sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:13.1"], "en": "which are like glowing embers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:13.2"], "en": "A cauldron larger than a man,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:13.3"], "en": "heated all day like a ploughshare—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:13.4"], "en": "sensual pleasures are even more painful than that.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:14.1"], "en": "Like the halāhala poison,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:14.2"], "en": "like boiling oil,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:14.3"], "en": "or like molten copper;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:14.4"], "en": "Sensual pleasures are more painful than that.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_459:15.1"], "en": "The fifth Jātaka, the Pānīya-jātaka, is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
