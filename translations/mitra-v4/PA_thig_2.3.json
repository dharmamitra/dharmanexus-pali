[
{"segs": ["PA_thig_2.3:0.1", "PA_thig_2.3:0.2"], "en": "Therīgāthā 2.3 Dukanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.3:0.3"], "en": "The Verses of the Elder Nun Sumaṅgalamātā", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.3:1.1"], "en": "“Truly released, truly released!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.3:1.2"], "en": "I am well released from the pestle;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.3:1.3"], "en": "even the mushroom [that grew] on my threshing-floor is gone.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.3:1.4"], "en": "\"The mortar scents my crocodile.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.3:2.1", "PA_thig_2.3:2.2"], "en": "Thus I strike away passion and hatred with the sound \"cicciṭi cicciṭī.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.3:2.3"], "en": "Having approached the foot of a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.3:2.4"], "en": "she meditated with happiness, thinking, “Oh, what happiness!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.3:3.1"], "en": "… Thus spoke the elder nun Sumaṅgalamātā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
