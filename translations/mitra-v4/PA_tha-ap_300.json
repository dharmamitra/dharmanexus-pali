[
{"segs": ["PA_tha-ap_300:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:0.2", "PA_tha-ap_300:0.3"], "en": "Chapter on Those Who Honored the Pile of Firewood (Citakapūjakavagga), Number 8: The Apadāna of the Elder Saraṇagamaniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:1.1", "PA_tha-ap_300:1.2"], "en": "“At that time, on a mountain in the Himalayas, I was a hunter;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:1.3"], "en": "there I saw the Buddha Vipassī.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:1.4", "PA_tha-ap_300:2.1"], "en": "Having attended upon the Fully Enlightened One, the Eldest in the World, the Bull among Men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:2.2"], "en": "I performed services for him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:2.3", "PA_tha-ap_300:2.4"], "en": "I went for refuge to the Lord of Bipeds, the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:3.1"], "en": "ninety-one eons ago.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:3.2"], "en": "I went for refuge;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:3.3"], "en": "I do not recognize any state of misery—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:3.4"], "en": "that is the fruit of going for refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:4.1", "PA_tha-ap_300:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:5.1"], "en": "Thus indeed the venerable elder Saraṇagamaniya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_300:6.1"], "en": "This is the eighth legend of the elder Saraṇagamaniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
