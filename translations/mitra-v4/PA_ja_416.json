[
{"segs": ["PA_ja_416:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:0.2"], "en": "The Section of Sevens,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:0.3"], "en": "Chapter on Gandhāra", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:0.4"], "en": "11. The Parantapa Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:1.1"], "en": "“Evil shall come upon me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:1.2"], "en": "fear shall come upon me.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:1.3"], "en": "\"For it was then that the branch shook,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:1.4"], "en": "whether by a human or by a deer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:2.1"], "en": "Surely my desire is for one who is timid.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:2.2"], "en": "Dwelling not far away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:2.3"], "en": "she will make the scorcher of foes thin and pale,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:2.4"], "en": "even as that very branch.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:3.1", "PA_ja_416:3.2"], "en": "My beloved will vex me while I dwell in the village, blameless as I am;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:3.3"], "en": "she will make me thin and pale.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:3.4"], "en": "O lady with darkened brows,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:4.1", "PA_ja_416:4.2"], "en": "by you were spoken those white words to me, the scorcher of foes, upon that branch.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:4.3"], "en": "\"How will they make him pale and thin?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:4.4"], "en": "That very branch [will wither] the scorcher of foes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:5.1"], "en": "\"Surely that sound has come,\" [he thought].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:5.2"], "en": "Surely he has not deceived you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:5.3", "PA_ja_416:5.4"], "en": "surely he has told you that by which he caused your branch to tremble.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:6.1", "PA_ja_416:6.2"], "en": "This indeed was the thought that occurred to me, a fool, when I had come together [with you];", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:6.3"], "en": "for at that time, the branch shook.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:6.4"], "en": "“Whether by a human or by a beast,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:7.1"], "en": "you have done exactly so;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:7.2"], "en": "you have deceived my father.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:7.3", "PA_ja_416:7.4"], "en": "\"Having struck [me], he will come back covering himself with branches; fear will come upon me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:8.1"], "en": "The *Parantapa Jātaka*, the eleventh.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:8.2"], "en": "The second chapter: Gandhāra.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:9.1"], "en": "Its summary (uddāna) is:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:10.1"], "en": "Varagāma, Mahākapi, and Bhaggava.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:10.2"], "en": "Daḷhadhamma, Sakuñjara, Kesavara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:10.3"], "en": "Uraga, Vidhura, Punajāgarataṃ,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:10.4"], "en": "and then Kosalādhipa Parantapa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:11.1", "PA_ja_416:12.1"], "en": "Now, for the summary of the chapters: Now,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:12.2"], "en": "listen as I recite the chapters within the seventh nipāta.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:12.3"], "en": "And furthermore, Kukkha and Gandhāra—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:12.4"], "en": "these two alone are spoken of by the Great Seer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_416:13.1"], "en": "The Sattaka-nipāta is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
