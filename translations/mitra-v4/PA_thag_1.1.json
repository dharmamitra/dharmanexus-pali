[
{"segs": ["PA_thag_1.1:0.1", "PA_thag_1.1:0.2", "PA_thag_1.1:0.3"], "en": "Theragāthā 1.1 Ekakanipāta Paṭhamavagga (The First Chapter of the Single Verses)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:0.4"], "en": "The Verses of the Elder Subhūti;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:1.0.1"], "en": "The Introductory Verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:1.0.2"], "en": "Homage to that Blessed One, the Worthy One, the Perfectly Self-Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:1.1", "PA_thag_1.1:1.2", "PA_thag_1.1:1.3"], "en": "Listen to those of developed self, who roar like tusked lions within mountain caves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:1.4"], "en": "The verses are introductory to the meaning:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:2.1"], "en": "according to their names, according to their clans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:2.2"], "en": "and according to how they dwell in accordance with the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:2.3"], "en": "Possessing wisdom, they dwelt unwearied according to their inclinations;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:2.4", "PA_thag_1.1:3.1"], "en": "having practiced insight here and there, they remained vigilant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:3.2"], "en": "Having touched the deathless state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:3.3"], "en": "reflecting upon what has been accomplished,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:3.4"], "en": "they spoke this matter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:4.0"], "en": "The Verses of the Elder Subhūti:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:4.1"], "en": "“My little hut is covered, pleasant, and sheltered from the wind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:4.2"], "en": "rain, O god, as you please!”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:4.3"], "en": "\"My mind is well-concentrated and liberated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:4.4"], "en": "I dwell ardent, O gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.1:4.5"], "en": "Thus indeed did the Venerable Elder Subhūti speak this verse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
