[
{"segs": ["PA_pv_2:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:0.2"], "en": "Uragavagga, 2.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:0.3"], "en": "Sūkaramukhapetavatthu (The Story of the Pig-Faced Ghost)", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:1.1"], "en": "“Your body is entirely of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:1.2"], "en": "and all directions are illuminated by it;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:1.3"], "en": "yet your face is like that of a pig.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:1.4"], "en": "\"What deed did you do in the past?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:2.1"], "en": "\"I was restrained in body,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:2.2"], "en": "but I was unrestrained in speech.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:2.3", "PA_pv_2:2.4"], "en": "It is because of that, Nārada, that my complexion is such as you see;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:3.1"], "en": "that, Nārada, I tell you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:3.2"], "en": "\"This has been seen by you yourself;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:3.3"], "en": "do not commit evil with your mouth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:3.4"], "en": "lest you become a pig-faced one.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_2:4.1"], "en": "The Story of the Pig-Faced Petas, Second.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"}
]
