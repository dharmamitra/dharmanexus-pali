[
{"segs": ["PA_tha-ap_312:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:0.2"], "en": "The Chapter on Lotus Filaments (Padumakesaravagga) 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:0.3"], "en": "The Apadāna of the Elder Pabbhāradāyaka (The Giver of the Cave)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:1.1", "PA_tha-ap_312:1.2"], "en": "“The mountain cave of the Blessed One Piyadassin was cleared by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:1.3"], "en": "I also attended upon him with a water-jar.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:1.4"], "en": "For the enjoyment of such a one.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:2.1", "PA_tha-ap_312:2.2"], "en": "The Buddha, the great sage Piyadassī, gave me this explanation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:2.3"], "en": "With a thousand shafts and a hundred crossbars,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:2.4"], "en": "adorned with banners and made of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:3.1"], "en": "that sacrificial post shall arise.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:3.2"], "en": "And not a small amount of jewels;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:3.3"], "en": "having given this mountain-cave gift,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:3.4"], "en": "I rejoiced in heaven for an eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:4.1"], "en": "In the thirty-second aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:4.2"], "en": "there will be a kshatriya named Susuddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:4.3"], "en": "endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:4.4"], "en": "A wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:5.1", "PA_tha-ap_312:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:5.3"], "en": "\"Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:6.1"], "en": "Thus indeed did the venerable elder Pabbhāradāyaka recite these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:7.1"], "en": "This is the tenth legend of the elder Pabbhāradāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:8.1"], "en": "The Thirty-first Chapter: The Chapter on Lotus Filaments.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:9.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:10.1"], "en": "Kesara, Gandha, and Anna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:10.2"], "en": "One who perceives the Dhamma, one who [rejoices] with the fruit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:10.3"], "en": "one who gives delight and pleasure,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:10.4"], "en": "a plasterer, and one who perceives the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_312:10.5", "PA_tha-ap_312:10.6"], "en": "And fifty-one verses of the Pabbhāravagga have been proclaimed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
