[
{"segs": ["PA_cp_14:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:0.2"], "en": "Hatthināgavagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:0.3"], "en": "Sīlapāramī 4", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:0.4", "PA_cp_14:1.1"], "en": "The Minor Bodhisattva Deeds: \"Furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:1.2"], "en": "when I was the well-conducted Cūḷabodhi...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:1.3"], "en": "Having seen existence as fearful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:1.4"], "en": "I went forth into the renunciation [of the world].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:2.1"], "en": "She who was my companion—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:2.2"], "en": "The Brahmin woman, who was like gold in complexion,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:2.3"], "en": "also, without looking back at her son,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:2.4"], "en": "went forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:3.1"], "en": "Without abode, with bonds severed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:3.2"], "en": "and indifferent toward family or group,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:3.3"], "en": "they wander through villages and market towns.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:3.4"], "en": "They arrived at Bārāṇasī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:4.1"], "en": "There we dwelt, being vigilant,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:4.2"], "en": "unassociated with families or groups.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:4.3", "PA_cp_14:4.4"], "en": "We both dwell in the royal garden, which is undisturbed and free from noise;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:5.1"], "en": "having gone to see the garden, we—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:5.2"], "en": "The king saw the brahmin woman;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:5.3"], "en": "approaching me, he asked, \"Who is she?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:5.4"], "en": "Whose wife is she?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:6.1"], "en": "When this was said,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:6.2"], "en": "I spoke these words to him:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:6.3"], "en": "\"This woman is not my wife.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:6.4"], "en": "\"Sharing the same Dhamma, under one teaching.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:7.1"], "en": "Tissa, infatuated and obsessed with her,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:7.2"], "en": "had her seized by servants;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:7.3"], "en": "Pressing me with force,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:7.4"], "en": "he made me enter the inner palace.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:8.1"], "en": "I was like a lotus flower in a water-pot.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:8.2", "PA_cp_14:8.3"], "en": "She was my co-born, sharing the same religious instruction; yet as she dragged me away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:8.4"], "en": "anger arose within me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:9.1"], "en": "As soon as anger arose,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:9.2"], "en": "I recalled my virtue and observances;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:9.3"], "en": "right there, I suppressed that anger.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:9.4"], "en": "I would have grown even higher.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:10.1"], "en": "Had anyone struck that brahmin woman with a sharp weapon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:10.2"], "en": "[I would have grown even more].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:10.3", "PA_cp_14:10.4"], "en": "I shall not break my virtue for the sake of enlightenment alone;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:11.1"], "en": "this brahmin woman is not to be abandoned by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:11.2"], "en": "Nor is it that I lack strength;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:11.3"], "en": "omniscience is dear to me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:11.4"], "en": "therefore I guard my virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_14:12.1"], "en": "The Minor Account of the Bodhisattva’s Conduct is the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
