[
{"segs": ["PA_thag_15.1:0.1"], "en": "Theragāthā 15.1, Soḷasakanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:0.2", "PA_thag_15.1:0.3"], "en": "Paṭhamavagga (The Sixteen-Verse Chapter, First Section)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:0.4"], "en": "The Verses of the Elder Aññāsikoṇḍañña:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:1.1", "PA_thag_15.1:1.2"], "en": "“Having heard the Dhamma of great flavor, I have gained even greater confidence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:1.3"], "en": "“The Dhamma has been taught for dispassion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:1.4"], "en": "entirely without clinging.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:2.1"], "en": "Many are the wonders in the world,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:2.2"], "en": "Upon this circle of the earth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:2.3", "PA_thag_15.1:2.4"], "en": "they seem to churn away my intention associated with beauty and lust.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:3.1", "PA_thag_15.1:3.2"], "en": "Just as dust is laid by the wind when the clouds have cleared,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:3.3"], "en": "so too are intentions stilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:3.4"], "en": "When one sees with wisdom:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:4.1"], "en": "\"All conditioned phenomena are impermanent\"—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:4.2"], "en": "when one sees this with wisdom;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:4.3"], "en": "Then one becomes disenchanted with suffering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:4.4"], "en": "this is the path to purification:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:5.1"], "en": "\"All conditioned phenomena are suffering.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:5.2"], "en": "When one sees with wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:5.3"], "en": "then one becomes disenchanted with suffering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:5.4"], "en": "this is the path to purification.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:6.1", "PA_thag_15.1:6.2"], "en": "When one perceives with wisdom that all phenomena are non-self,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:6.3"], "en": "then one becomes disenchanted with suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:6.4"], "en": "This is the path to purification,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:7.1", "PA_thag_15.1:7.2"], "en": "which was awakened to by the Buddha and followed by the Elder Koṇḍañña of zealous exertion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:7.3"], "en": "One who has abandoned birth and death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:7.4"], "en": "perfected in the holy life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:8.1"], "en": "is free from the snare of the flood and the firm stake.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:8.2"], "en": "The mountain is difficult to shake;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:8.3"], "en": "having cut through the wasteland and the snare,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:8.4"], "en": "and having shattered the rock that is hard to break;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:8.5", "PA_thag_15.1:8.6"], "en": "The meditator who has crossed over and reached the further shore is freed from the bonds of Māra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:9.1"], "en": "But the monk who is agitated and fickle—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:9.2"], "en": "Relying on evil friends,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:9.3"], "en": "one sinks in the great flood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:9.4"], "en": "overwhelmed by the waves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:10.1"], "en": "Unagitated, not fickle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:10.2"], "en": "prudent, with senses restrained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:10.3"], "en": "possessing good friends and being wise—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:10.4"], "en": "May he be one who brings an end to suffering—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:11.1"], "en": "resembling a black bamboo joint,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:11.2"], "en": "emaciated, and with veins showing all over his body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:11.3", "PA_thag_15.1:11.4"], "en": "A person who knows moderation in food and drink, with a mind that is not dejected,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:12.1"], "en": "even when touched by gadflies and mosquitoes, is steadfast.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:12.2"], "en": "In the forest, in the great woods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:12.3", "PA_thag_15.1:12.4"], "en": "one should dwell there mindfully, like an elephant at the head of a battle.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:13.1"], "en": "I do not rejoice in death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:13.2", "PA_thag_15.1:13.4"], "en": "... [as one] like a wage-earner seeking his wages.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:14.1"], "en": "I do not rejoice in death...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:14.2", "PA_thag_15.1:14.4"], "en": "[pe] ...mindful and clearly comprehending.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:15.1"], "en": "The Teacher has been served by me; ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:15.2", "PA_thag_15.1:15.4"], "en": "[as before] ... the conduit to existence has been uprooted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:16.1", "PA_thag_15.1:16.2"], "en": "That purpose for which I went forth from the home life into homelessness—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:16.3"], "en": "that goal has been attained by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:16.4"], "en": "“What need have I for a co-resident?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_15.1:16.5"], "en": "… Thus spoke the Elder Aññāsikoṇḍañña.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
