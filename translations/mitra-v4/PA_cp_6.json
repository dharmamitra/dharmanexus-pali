[
{"segs": ["PA_cp_6:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:0.2"], "en": "Akittivagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:0.3"], "en": "Dānapāramī 6", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:0.4", "PA_cp_6:1.1"], "en": "The Conduct of King Nimi: “Furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:1.2"], "en": "when I was in Mithilā, that most excellent city;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:1.3"], "en": "There was a great king named Nimi,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:1.4"], "en": "wise and seeking the wholesome;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:2.1"], "en": "at that time, having had [the city] measured out, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:2.2"], "en": "A four-sided hall with four entrances;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:2.3"], "en": "there I bestowed gifts upon animals,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:2.4"], "en": "birds, humans, and others.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:3.1", "PA_cp_6:3.2"], "en": "Having provided clothing, bedding, food, drink,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:3.3"], "en": "and sustenance without interruption,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:3.4"], "en": "I bestowed a great gift,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:4.1", "PA_cp_6:4.2"], "en": "just as a servant might approach his master for the sake of wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:4.3"], "en": "In body, speech, and mind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:4.4"], "en": "one should seek to please him;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:5.1"], "en": "even so shall I [behave] toward all beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:5.2"], "en": "I shall seek that which is born of enlightenment;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:5.3"], "en": "having satisfied beings with gifts,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:5.4"], "en": "I desire supreme enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_6:6.1"], "en": "The sixth is the conduct of King Nimi.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
