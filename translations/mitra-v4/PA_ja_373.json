[
{"segs": ["PA_ja_373:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:0.2", "PA_ja_373:0.3"], "en": "The Fifth Collection, Chapter on the Half-Units (Aḍḍhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:0.4"], "en": "3. The Mūsikajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:1.1"], "en": "“Where has she gone? To what place has she gone?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:1.2"], "en": "thus the people lamented.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:1.3", "PA_ja_373:1.4"], "en": "\"I alone know that a mouse was killed in the well;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:2.1"], "en": "and as for this 'iti' and 'cīti'...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:2.2"], "en": "Like a donkey, you turn back;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:2.3"], "en": "having killed a mouse at the well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:2.4"], "en": "you wish to eat barley.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:3.1"], "en": "\"You are young, O witless one,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:3.2"], "en": "just recently arisen, still in your youth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:3.3"], "en": "having attached yourself to this long [life],\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:3.4"], "en": "I will not give you your life,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:4.1", "PA_ja_373:4.2"], "en": "neither by means of a celestial palace nor by the offering of my own limbs and sons.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:4.3"], "en": "For Putta, who was entreated by him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:4.4"], "en": "was released through verses;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:5.1"], "en": "he should study all that has been heard.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:5.2"], "en": "One should understand the inferior, the superior, and the middling;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:5.3"], "en": "one should know the purpose of everything,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:5.4"], "en": "yet not employ everything.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:5.5", "PA_ja_373:5.6"], "en": "There comes such a time when what has been heard brings about one's welfare.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_373:6.1"], "en": "Thus ends the third Jātaka, the Mouse Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
