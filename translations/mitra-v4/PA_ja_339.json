[
{"segs": ["PA_ja_339:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_339:0.2", "PA_ja_339:0.3"], "en": "Catukkanipāta, Kokilavagga (The Chapter on the Cuckoo)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_339:0.4", "PA_ja_339:1.1"], "en": "9. The Bāveru Jātaka “Because of not seeing the peacock,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_339:1.2"], "en": "the crested one of sweet voice;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_339:1.3", "PA_ja_339:1.4", "PA_ja_339:2.1"], "en": "There they honored the crow with meat and fruit; and when he was endowed with strength, [he departed].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_339:2.2"], "en": "I lived by the Bāveru mango tree;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_339:2.3", "PA_ja_339:2.4"], "en": "then, gain and honor departed from the crow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_339:3.1"], "en": "As long as the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_339:3.2"], "en": "the King of Dharma, the bringer of light,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_339:3.3"], "en": "has not arisen, so long do others pay honor.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_339:3.4"], "en": "Many ascetics and brahmins [were present].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_339:4.1", "PA_ja_339:4.2"], "en": "And when the Buddha, endowed with wisdom, taught the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_339:4.3", "PA_ja_339:4.4"], "en": "\"Then gain and honor fell away from the sectarians.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_339:5.1"], "en": "Thus ends the ninth Jātaka, the Bāveru Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
