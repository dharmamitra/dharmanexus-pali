[
{"segs": ["PA_tha-ap_314:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:0.2"], "en": "Ārakkhadāyaka-vagga 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:0.3"], "en": "The Apadāna of the Elder Bhojanadāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:1.1"], "en": "“Like a well-grown sal tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:1.2"], "en": "like a rising sobhañjana plant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:1.3"], "en": "like Indra’s staff in the sky,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:1.4"], "en": "The Jina always shines forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:2.1", "PA_tha-ap_314:2.2"], "en": "Of that Vessabhu, the Great Seer, the god beyond gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:2.3", "PA_tha-ap_314:2.4"], "en": "I gave food with a serene mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:3.1"], "en": "the Buddha rejoiced in that for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:3.2"], "en": "The Self-Existent One, the Unconquered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:3.3", "PA_tha-ap_314:3.4"], "en": "may the fruit arise for you as you are being reborn into existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:4.1"], "en": "In the thirty-first aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:4.2"], "en": "because of the gift I gave at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:4.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:4.4"], "en": "This is the fruit of that meal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:5.1"], "en": "Twenty-five aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:5.2"], "en": "there was one named Amittaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:5.3"], "en": "Endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:5.4"], "en": "a wheel-turning monarch of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:6.1"], "en": "the four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:7.1"], "en": "Thus indeed did the Venerable Elder Bhojanadāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_314:8.1"], "en": "The legend of the Elder Bhojanadāyaka is the second.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
