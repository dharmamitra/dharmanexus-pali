[
{"segs": ["PA_pv_35:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:0.2"], "en": "Cūḷavagga 10.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:0.3"], "en": "The Story of the Ghost with Discolored Elements (Dhātuvivaṇṇa-petavatthu)", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:1.1"], "en": "“Standing in the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:1.2"], "en": "you breathe out foul-smelling rot;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:1.3"], "en": "maggots are in your mouth, smelling of putridness.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:1.4"], "en": "\"What deed did they do in the past that they now eat [this]?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:2.1"], "en": "Having seized a blade,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:2.2"], "en": "they plunge it into themselves again and again.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:2.3"], "en": "Having sprinkled [the body] with salt water,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:2.4"], "en": "they plunge into it again and again.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:3.1"], "en": "What indeed [is the cause] by way of body or speech?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:3.2"], "en": "An evil deed was committed by you with the mind;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:3.3", "PA_pv_35:3.4"], "en": "as the ripening of what karma do you undergo this suffering?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:4.1"], "en": "“In delightful Rājagaha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:4.2"], "en": "in the charming Giribbaja,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:4.3"], "en": "I am the lord of wealth and grain.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:4.4"], "en": "\"Welcome, dear sir!", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:5.1"], "en": "This wife of mine, this daughter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:5.2"], "en": "and this daughter-in-law of mine— \"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:5.3", "PA_pv_35:5.4"], "en": "I stopped those women who were carrying that garland, the blue lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:5.5"], "en": "and the precious ointment to the stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:5.6"], "en": "That evil was committed by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:6.1", "PA_pv_35:6.2"], "en": "We eighty-six thousand have experienced this individually.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:6.3"], "en": "Having disparaged the worship of the stupa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:6.4"], "en": "we fell into hell most severely;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:7.1"], "en": "yet those who [praised] the worship of the stupa...", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:7.2"], "en": "While the festival of the Arahant is taking place,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:7.3"], "en": "they proclaim its dangers;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:7.4"], "en": "you should separate yourselves from them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:8.1"], "en": "And look at these women approaching,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:8.2"], "en": "wearing garlands and adorned with ornaments,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:8.3"], "en": "experiencing the karmic result of their flower-giving.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:8.4"], "en": "And those illustrious women were radiant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:9.1", "PA_pv_35:9.2"], "en": "Having seen that marvel, that wonder, that hair-raising sight;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:9.3", "PA_pv_35:9.4"], "en": "The wise pay homage and revere that Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:10.1"], "en": "surely, having gone from here, I too shall do so.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:10.2"], "en": "Having obtained this human birth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:10.3", "PA_pv_35:10.4"], "en": "I shall perform worship at the stupa with diligence again and again.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:11.1"], "en": "The tenth story, Dhātuvivaṇṇapetavatthu.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:12.1"], "en": "The third chapter, Cūḷavagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:13.1"], "en": "Its summary verse (uddāna):", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:14.1", "PA_pv_35:14.2"], "en": "Abhijjamāna, Kuṇḍiya, Rathakāri, Bhusa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:14.3"], "en": "and the young man Gaṇikā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:14.4"], "en": "Two hunters and the honoring of the back;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_35:14.5"], "en": "by this, the chapter is called.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"}
]
