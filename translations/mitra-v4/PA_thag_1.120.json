[
{"segs": ["PA_thag_1.120:0.1"], "en": "Theragāthā 1.120 Ekakanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:0.2", "PA_thag_1.120:0.3"], "en": "Dvādasamavagga (The Twelfth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:0.4"], "en": "The Verses of the Elder Isidatta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:1.1"], "en": "“The five aggregates have been fully understood;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:1.2"], "en": "they stand with their roots cut off.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:1.3"], "en": "“The destruction of suffering has been reached;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:1.4"], "en": "the destruction of the taints has been attained by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:1.5"], "en": "… Thus spoke the elder Isidatta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:1.6"], "en": "The twelfth chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:2.0", "PA_thag_1.120:2.1"], "en": "Its summary verse: Jenta and Vacchagotta, and...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:2.2"], "en": "Vaccha and Vanasavhaya;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:2.3"], "en": "Adhimutta, Mahānāma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:2.4"], "en": "Pārāpariya, and Yasas as well.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:2.5", "PA_thag_1.120:2.6"], "en": "Kimila the son of Vajji and Isidatta of great fame.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:2.7"], "en": "The First Chapter is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:3.0", "PA_thag_1.120:3.1"], "en": "In this regard, the summary verse is: One hundred and twenty elders,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:3.2"], "en": "who had accomplished their task and were free from taints;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:3.3"], "en": "In the single recension,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.120:3.4"], "en": "it was well-chanted by the great seers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
