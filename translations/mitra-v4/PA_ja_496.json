[
{"segs": ["PA_ja_496:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:0.2"], "en": "The Miscellaneous Chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:0.3"], "en": "The Section on the Rice-field of Śāli Rice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:0.4", "PA_ja_496:1.1", "PA_ja_496:1.2"], "en": "13. The Bhikkhāparamparajātaka “Having seen one of delicate form who had come from the kingdom to the forest...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:1.3", "PA_ja_496:1.4"], "en": "Equipped with an excellent gabled chamber and attended by a great couch—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:2.1"], "en": "out of love for you, I [shall provide it].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:2.2"], "en": "I gave an abundance of rice;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:2.3"], "en": "a meal of husked śāli rice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:2.4"], "en": "pure, with meat as a garnish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:3.1"], "en": "Having received that food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:3.2"], "en": "you gave it to the brahmin;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:3.3"], "en": "without having eaten yourself, you gave it away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:3.4"], "en": "“What is this Dhamma? Homage be to you! [The Buddha replied:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:4.1", "PA_ja_496:4.2"], "en": "“A brahmin is my teacher, occupied with what ought and ought not to be done.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:4.3"], "en": "“He is both venerable and worthy of being addressed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:4.4"], "en": "he deserves to be given food.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:5.1"], "en": "“Now I shall ask the brahmin:”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:5.2"], "en": "To Gotama, who is honored by kings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:5.3"], "en": "the king gave food—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:5.4"], "en": "pure meat with a sauce.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:6.1"], "en": "Having accepted that meal,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:6.2"], "en": "you gave it as food to the seer;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:6.3"], "en": "you were ignorant of the true field for giving.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:6.4"], "en": "“Who is this Dhamma? Homage be to you!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:7.1"], "en": "[The Buddha replied: “I support my children and wife;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:7.2"], "en": "I am attached to household life.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:7.3", "PA_ja_496:7.4"], "en": "I enjoy human pleasures and I instruct kings;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:8.1"], "en": "[this is the way] of the forest-dwelling seer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:8.2"], "en": "“Long has he practiced asceticism;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:8.3"], "en": "to this elder of developed self,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:8.4"], "en": "I ought to give food.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:9.1"], "en": "“And now I ask you, Isi:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:9.2"], "en": "why are you so emaciated, with veins standing out,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:9.3"], "en": "your hair, armpits, and body-hair grown long?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:9.4"], "en": "With mud on your teeth and dust on your head,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:10.1"], "en": "you dwell alone in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:10.2"], "en": "longing not for life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:10.3"], "en": "“O monk, who is better than you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:10.4"], "en": "to whom you have given food?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:11.1"], "en": "“Those who dig up the sweet-tasting roots and tubers,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:11.2"], "en": "And the stalks of wild millet;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:11.3"], "en": "shaking the wild rice and the nīvāra grain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:11.4"], "en": "and spreading out the saṅghāriya and pasāriya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:12.1", "PA_ja_496:12.2"], "en": "Having brought green vegetables, lotus roots, honey, meat,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:12.3"], "en": "and jujubes and emblic myrobalans, I eat them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:12.4", "PA_ja_496:13.1"], "en": "I have that possession: one who is cooking for one who does not cook,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:13.2"], "en": "one who is free from \"mine-ness\" yet possesses something of his own.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:13.3"], "en": "\"To one who takes nothing, I,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:13.4"], "en": "who take, ought to give food.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:14.1"], "en": "\"Now I shall ask the bhikkhu:\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:14.2"], "en": "To you, who sat in silence observing the vow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:14.3"], "en": "the seer gave food—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:14.4"], "en": "pure, with meat as a garnish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:15.1"], "en": "Having received that food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:15.2"], "en": "you eat it alone in silence;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:15.3"], "en": "you do not invite anyone else.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:15.4"], "en": "\"What is this Dhamma? Homage be to you! [The Buddha replied:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:16.1"], "en": "\"I do not cook, nor do I cause to cook;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:16.2"], "en": "I do not cut, nor do I cause to cut.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:16.3"], "en": "Knowing me to be one who possesses nothing,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:16.4"], "en": "having turned away from all evils,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:17.1"], "en": "and taking my alms-bowl in my left hand—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:17.2"], "en": "With his right hand he held a water-pot;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:17.3"], "en": "the seer gave me food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:17.4"], "en": "pure and seasoned with meat.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:18.1"], "en": "For these are worthy of receiving gifts,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:18.2", "PA_ja_496:18.3"], "en": "being impartial and accompanied by their retinues; I consider myself, however, to be an adversary.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:18.4"], "en": "“He who would invite the donor.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:19.1", "PA_ja_496:19.2"], "en": "“Truly, for my benefit has the Bull among Charioteers come here today!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:19.3", "PA_ja_496:19.4"], "en": "Today I understand where what is given bears great fruit:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:20.1"], "en": "kings are greedy for kingdoms.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:20.2"], "en": "The brahmins are concerned with what ought and ought not to be done;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:20.3"], "en": "the seers are greedy for roots and fruits;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:20.4"], "en": "and the bhikkhus are utterly liberated.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:21.1"], "en": "The Thirteenth Jātaka, the Bhikkhāparamparajātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:22.1"], "en": "The Pakiṇṇakanipāta is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:23.1"], "en": "Here is its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:24.1"], "en": "Suva, Kinnara, Mukka, Kharājina,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:24.2"], "en": "Bhisajāta, Mahesi, Kapotavara, then Mora,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:24.3"], "en": "Satacchaka, and Vāṇijaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_496:24.4"], "en": "Then the king, together with the brahmins and the monks.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
