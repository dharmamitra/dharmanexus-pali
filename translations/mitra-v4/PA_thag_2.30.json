[
{"segs": ["PA_thag_2.30:0.1"], "en": "Theragāthā 2.30 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:0.2", "PA_thag_2.30:0.3"], "en": "Tatiyavagga (The Third Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:0.4"], "en": "The Verses of the Elder Kaṇhadinna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:1.1", "PA_thag_2.30:1.2"], "en": "“I have attended upon true persons and have frequently heard the Dhamma.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:1.3", "PA_thag_2.30:1.4"], "en": "Having heard it, I shall practice the straight path that plunges into the Deathless; for me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:2.1"], "en": "who am struck down by the craving for existence, [let there be no further birth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:2.2"], "en": "Furthermore, craving for existence does not exist for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:2.3"], "en": "it has not existed, it will not exist,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:2.4"], "en": "and it does not exist for me now.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:2.5", "PA_thag_2.30:2.6"], "en": "… The Elder Kaṇhadinna … This is the third chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:3.0"], "en": "Its summary (uddāna) is as follows:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:3.1"], "en": "The Elder Bhaddaji Uttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:3.2"], "en": "the seer Sobhita and Valliya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:3.3"], "en": "and the elder who was Vītasoka—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:3.4"], "en": "Puṇṇamāsa and Nandaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:3.5"], "en": "Bharata and Bhāradvāja,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.30:3.6"], "en": "and Kaṇhadinna the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
