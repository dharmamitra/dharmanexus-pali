{"segs": ["PA_thag_1.14:0.2", "PA_thag_1.14:0.3"], "en": "Second Chapter (Dutiyavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.14:0.4"], "en": "The Verses of the Novice Sīvaka:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.14:1.1"], "en": "“My preceptor said to me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.14:1.2"], "en": "‘Sīvaka, let us go from here.’”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.14:1.3"], "en": "My body dwells in the village,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.14:1.4"], "en": "my mind has gone to the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.14:1.5"], "en": "even while remaining here, I go [there].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.14:1.6"], "en": "“There is no attachment for those who understand.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.14:1.7"], "en": "… [This was said by] the elder Vanavaccha, the novice Sāmaṇera. …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
