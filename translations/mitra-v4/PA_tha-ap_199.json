[
{"segs": ["PA_tha-ap_199:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:0.2"], "en": "The Chapter on the Tamāla Flower (Tamālapupphiyavagga), Number 7:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:0.3"], "en": "The Apadāna of the Elder Tindukadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:1.1", "PA_tha-ap_199:1.2"], "en": "“I was a monkey, powerful and swift, dwelling in a mountain fastness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:1.3"], "en": "seeing a fruiting *tinduka* tree, I— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:1.4"], "en": "I recollected the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:2.1", "PA_tha-ap_199:2.2"], "en": "Having gone forth, for several days I sought the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:2.3"], "en": "With a serene mind and joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:2.4"], "en": "Siddhattha, who has transcended the three realms of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:3.1"], "en": "understood my intention.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:3.2"], "en": "The Teacher, unsurpassed in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:3.3", "PA_tha-ap_199:3.4"], "en": "came into my presence accompanied by a thousand monks whose taints were exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:4.1"], "en": "Having generated joy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:4.2"], "en": "I approached with a fruit in my hand;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:4.3"], "en": "the Blessed One accepted it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:4.4"], "en": "The Omniscient One, the best among speakers:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:5.1"], "en": "\"In the ninety-fourth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:5.2"], "en": "whatever fruit I gave at that time,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:5.3"], "en": "I do not recall ever being born in an unhappy state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:5.4"], "en": "this is the fruit of giving alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:6.1"], "en": "In the fifty-seventh aeon...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:6.2"], "en": "Named Upananda,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:6.3", "PA_tha-ap_199:6.4"], "en": "he was a wheel-turning monarch of great power, endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:7.1", "PA_tha-ap_199:7.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:7.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:8.1"], "en": "Thus indeed the venerable elder Tindukadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_199:9.1"], "en": "This is the seventh legend of the elder Tindukadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
