{"segs": ["PA_thag_1.46:0.4"], "en": "The Verses of Samiddhi Thera:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.46:1.1", "PA_thag_1.46:1.2"], "en": "“Out of faith I went forth from the home life into homelessness.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.46:1.3"], "en": "My mindfulness and wisdom have increased,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.46:1.4"], "en": "and my mind is well-concentrated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.46:1.5"], "en": "you may display forms at your pleasure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.46:1.6"], "en": "“You shall not afflict me,” said the Elder Samiddhi.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
