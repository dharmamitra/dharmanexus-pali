{"segs": ["PA_ja_112:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_112:0.2", "PA_ja_112:0.3"], "en": "The First Book (Ekakanipāta), The Chapter on the Swan (Haṃsivagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_112:0.4"], "en": "2. The Amarādevīpañha Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_112:1.1", "PA_ja_112:1.2"], "en": "“Where the *sattubilaṅga* and the double-leaved *palāsa* are in bloom;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_112:1.3"], "en": "That by which I give, by that I speak;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_112:1.4"], "en": "that by which I do not give, by that I do not speak.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_112:1.5"], "en": "This is the path of Yavamajjhaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_112:1.6"], "en": "\"Know this to be the hidden path.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_112:2.1"], "en": "Thus ends the second Jātaka, the Amarādevī-pañha Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
