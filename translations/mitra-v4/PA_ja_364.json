[
{"segs": ["PA_ja_364:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:0.2", "PA_ja_364:0.3"], "en": "The Fifth Collection (Pañcakanipāta), Chapter on the Arising of Praise (Vaṇṇārohavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:0.4", "PA_ja_364:1.1"], "en": "4. The Khajjopanakajātaka “Who indeed, while a lamp is present,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:1.2"], "en": "would go about searching for fire?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:1.3"], "en": "Seeing a glow-worm at night,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:1.4"], "en": "you thought it was fire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:2.1"], "en": "You [sought] its cow-dung ashes...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:2.2"], "en": "Though he threw on grass and other fuel,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:2.3", "PA_ja_364:2.4"], "en": "he was unable to set it ablaze because of his perverted perception.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:3.1"], "en": "In this way too, by an improper means,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:3.2"], "en": "the deer does not obtain its purpose,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:3.3"], "en": "just as one might try to milk a cow from its horn.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:3.4"], "en": "Where they find no milk,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:4.1", "PA_ja_364:4.2"], "en": "young men achieve their goal through various means.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:4.3"], "en": "By the subduing of enemies,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:4.4"], "en": "by the upholding of friends,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:5.1"], "en": "and by the granting of freedom from fear to the army.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:5.2"], "en": "And by means of the policy of those who are beloved,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:5.3", "PA_ja_364:5.4"], "en": "the protectors of the world dwell upon the earth, the bearer of wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_364:6.1"], "en": "The Khajjopanaka Jātaka, the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
