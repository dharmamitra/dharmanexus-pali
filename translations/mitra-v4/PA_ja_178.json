[
{"segs": ["PA_ja_178:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:0.2", "PA_ja_178:0.3"], "en": "The Second Book of Pairs, Chapter on the Virtuous (Kalyāṇavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:0.4"], "en": "8. The Kacchapa Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:1.1"], "en": "\"‘She is my mother!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:1.2"], "en": "She is my mother!’—thus I sank into the mud.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:1.3"], "en": "The mud has overwhelmed me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:1.4"], "en": "just as it would a weakling; that,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:1.5"], "en": "Bhaggava, is what I say to you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:1.6"], "en": "Listen to my words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:2.1"], "en": "\"Whether in a village or in a kingdom,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:2.2"], "en": "wherever one attains happiness;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:2.3", "PA_ja_178:2.4"], "en": "For a man who understands what has been born and what must come to be,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:2.5"], "en": "one should live for that [purpose] and depart from it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:2.6"], "en": "“One should not be destroyed by one’s own dwelling.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_178:3.1"], "en": "Thus ends the eighth Jātaka, the Kacchapa-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
