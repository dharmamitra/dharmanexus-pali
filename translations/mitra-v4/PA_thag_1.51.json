[
{"segs": ["PA_thag_1.51:0.1", "PA_thag_1.51:0.2", "PA_thag_1.51:0.3"], "en": "Theragāthā 1.51 Ekakanipāta Chaṭṭhavagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.51:0.4"], "en": "The Verses of the Elder Godhika:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.51:1.1"], "en": "“The god rains as if to a well-sung song;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.51:1.2"], "en": "my little hut is thatched, pleasant, and sheltered from the wind.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.51:1.3"], "en": "“My mind is perfectly concentrated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.51:1.4"], "en": "now, O Deva, if you so desire, let it rain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.51:1.5"], "en": "… Thus spoke the Elder Godhika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
