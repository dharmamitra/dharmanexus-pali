[
{"segs": ["PA_ja_431:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:0.2", "PA_ja_431:0.3"], "en": "The Ninth Chapter, The Section on Vultures (Gijjhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:0.4", "PA_ja_431:1.1"], "en": "5. The Haritaca Jātaka “Great Brahmā, I have heard this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:1.2"], "en": "Haritaca enjoys sensual pleasures.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:1.3"], "en": "\"Is this speech empty?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:1.4"], "en": "Are you living in purity?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:2.1"], "en": "\"It is so, Great King.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:2.2"], "en": "Just as I heard your words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:2.3"], "en": "so have I entered upon a wrong path,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:2.4"], "en": "infatuated by things that lead to delusion.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:3.1", "PA_ja_431:3.2"], "en": "“What is the purpose of that subtle and wise wisdom, so well-considering,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:3.3"], "en": "by which one [overcomes] arisen passion?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:3.4"], "en": "\"Why does the mind not find delight?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:4.1", "PA_ja_431:4.2"], "en": "\"O Great King, there are these four things in the world that are exceedingly powerful.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:4.3"], "en": "“Where lust, hatred, pride,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:4.4"], "en": "and delusion find no footing in wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:5.1"], "en": "“The Arahant, endowed with virtue...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:5.2"], "en": "“Hārita lives pure;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:5.3"], "en": "he is wise and truly learned—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:5.4"], "en": "thus we hold you in high esteem.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:6.1"], "en": "“Even the wise, O King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:6.2"], "en": "even the seer devoted to the virtues of the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:6.3"], "en": "are harmed by evil thoughts.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:6.4"], "en": "\"Beautiful, yet accompanied by passion.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:7.1", "PA_ja_431:7.2"], "en": "\"This bodily secretion that has arisen, this passion which disfigures your complexion; [it is yours].\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:7.3"], "en": "\"Abandon that; may it be well with you!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:7.4"], "en": "You are highly esteemed for your great wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:8.1"], "en": "\"Those dark desires...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:8.2"], "en": "In this world of great suffering and great poison,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:8.3", "PA_ja_431:8.4"], "en": "I shall seek out their root and cut through passion along with its bonds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:9.1", "PA_ja_431:9.2"], "en": "Having said this, the seer Hārita, who was devoted to truth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:9.3"], "en": "having abandoned sensual lust, [attained liberation].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:9.4"], "en": "\"He went to the Brahma-world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_431:10.1"], "en": "Thus ends the fifth Jātaka, the Haritaca-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
