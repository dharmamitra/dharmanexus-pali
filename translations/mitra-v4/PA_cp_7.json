[
{"segs": ["PA_cp_7:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:0.2"], "en": "Akittivagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:0.3"], "en": "Dānapāramī 7", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:0.4"], "en": "The Conduct of Prince Candaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:1.1", "PA_cp_7:1.2"], "en": "\"Furthermore, when I was the son of a certain king...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:1.3"], "en": "In the city of Pupphavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:1.4"], "en": "there was a prince named Canda.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:2.1"], "en": "At that time, I was released from the sacrifice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:2.2", "PA_cp_7:2.3"], "en": "Having emerged from the sacrificial enclosure and stirred a sense of spiritual urgency,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:2.4"], "en": "I set forth a great gift.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:3.1"], "en": "I do not drink, I do not eat,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:3.2"], "en": "nor do I consume any food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:3.3"], "en": "without first having given to those worthy of offerings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:3.4"], "en": "And for even six or five nights.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:4.1"], "en": "Just as a merchant,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:4.2"], "en": "having made a collection of goods;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:4.3"], "en": "Where there is great profit,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:4.4"], "en": "there one carries away that merchandise; even so,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:5.1"], "en": "those who eat their own gains [carry them away].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:5.2"], "en": "What is given to another bears great fruit;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:5.3"], "en": "therefore, one should give to another,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:5.4"], "en": "for it will become a hundredfold.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:6.1"], "en": "Knowing this essential point,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:6.2"], "en": "I give gifts in every state of existence;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:6.3"], "en": "I do not turn back from giving.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:6.4"], "en": "“...for the sake of attaining perfect enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_7:7.1"], "en": "Thus ends the seventh chapter, the Practice of Prince Candaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
