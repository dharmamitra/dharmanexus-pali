[
{"segs": ["PA_vv_49:0.1"], "en": "Vimānavatthu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:0.2", "PA_vv_49:0.3"], "en": "The Chapter on the Mañjiṭṭhaka Mansion in the Section on Female Vimānas", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:0.4"], "en": "11. The Story of the Mansion of Vanda “O goddess,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:1.1", "PA_vv_49:1.2"], "en": "you who stand there with such exquisite beauty— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:1.3", "PA_vv_49:1.4"], "en": "Illuminating all directions like a star among the herbs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:2.1"], "en": "by what means do you possess such a complexion?", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:2.2", "PA_vv_49:2.3"], "en": "\"...and your radiance shines in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:3.1"], "en": "That deity was uplifted in mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:3.2", "PA_vv_49:3.3"], "en": "…pe… the fruit of which action is this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:4.1"], "en": "“When I was among humans, having become a human being…”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:4.2"], "en": "Having seen those virtuous ascetics,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:4.3"], "en": "I bowed at their feet and gladdened my mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:4.4"], "en": "with wealth, I performed the gesture of reverent salutation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:5.1", "PA_vv_49:5.2"], "en": "\"Because of that, my complexion is such as this...", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:5.3"], "en": "and my complexion shines forth in all directions.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_49:6.1"], "en": "The Vandanavimāna is the eleventh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"}
]
