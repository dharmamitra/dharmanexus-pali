[
{"segs": ["PA_ja_284:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:0.2", "PA_ja_284:0.3"], "en": "The Third Collection (Tikanipāta), Chapter on the Inner Circle (Abbhantaravagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:0.4"], "en": "4. The Sirijātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:1.1", "PA_ja_284:1.2"], "en": "“That great wealth which those who lack merit strive so hard to accumulate—”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:1.3"], "en": "Whether possessing skills or lacking them,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:1.4"], "en": "one with clear vision enjoys those [fruits];", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:2.1"], "en": "everywhere, for the one who has performed merit, [it is so].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:2.2"], "en": "Even before long,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:2.3"], "en": "living beings obtain abundant wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:2.4"], "en": "even in places where there is little scope for it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:3.1"], "en": "A cock, jewels, a staff,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:3.2"], "en": "and women with auspicious marks—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:3.3"], "en": "these appear for one who is free from evil.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:3.4"], "en": "“For the person who has performed merit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_284:4.1"], "en": "The fourth *Sirijātaka* is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
