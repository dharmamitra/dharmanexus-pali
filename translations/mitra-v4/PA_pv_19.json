[
{"segs": ["PA_pv_19:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:0.2"], "en": "Ubbarivagga, 7.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:0.3"], "en": "The Story of the Ghost of the Merchant Dhanapāla", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:1.1"], "en": "“Naked you are, of ugly appearance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:1.2"], "en": "emaciated, with veins showing all over;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:1.3"], "en": "you are gaunt, withered, and haggard.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:1.4"], "en": "“Who indeed are you, O worthy one?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:2.1"], "en": "“I am a peta, venerable sir,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:2.2"], "en": "miserable, belonging to the world of Yama.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:2.3"], "en": "\"Having committed an evil deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:2.4"], "en": "he has gone from here to the world of the petas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:3.1"], "en": "\"What indeed [did he do] by way of body or speech...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:3.2"], "en": "An evil deed was committed by you with the mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:3.3", "PA_pv_19:3.4"], "en": "as the result of what karma have you gone from here to the world of the hungry ghosts?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:4.1"], "en": "“There was a city of the wise,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:4.2"], "en": "renowned as Erakaccha; there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:4.3"], "en": "in that city, I was once a merchant.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:4.4"], "en": "The wise know me as Dhanapāla;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:5.1", "PA_pv_19:5.2"], "en": "I possessed eighty cartloads of gold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:5.3"], "en": "I have abundant gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:5.4"], "en": "many pearls and beryl;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:6.1"], "en": "even with such great wealth as this—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:6.2"], "en": "I did not like to give even what was dear to me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:6.3", "PA_pv_19:6.4"], "en": "having closed the door, I ate so that beggars would not see me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:7.1"], "en": "I was faithless and stingy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:7.2", "PA_pv_19:7.3"], "en": "miserly and abusive toward those who gave and those who performed deeds of merit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:7.4"], "en": "I would have restrained many people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:8.1"], "en": "There is no ripening for giving;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:8.2"], "en": "how could there be a fruit for self-restraint?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:8.3"], "en": "I destroyed lotus ponds and wells,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:8.4", "PA_pv_19:8.5"], "en": "as well as planted groves and waterfalls.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:8.6"], "en": "And narrow passages for crossing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:9.1"], "en": "Having failed to perform what is wholesome and having committed evil,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:9.2"], "en": "when I have passed away from there;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:9.3"], "en": "Reborn in the realm of the hungry ghosts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:9.4"], "en": "afflicted by hunger and thirst,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:10.1"], "en": "for fifty-five years.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:10.2"], "en": "Since the time I passed away,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:10.3"], "en": "I do not recall having eaten anything,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:10.4"], "en": "nor even having drunk water.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:11.1"], "en": "That which is restraint is destruction;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:11.2"], "en": "that which is destruction is restraint.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:11.3"], "en": "For it is said that the departed spirits indeed know this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:11.4"], "en": "That which is restraint is destruction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:12.1"], "en": "Previously I would have restrained myself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:12.2"], "en": "yet I did not acquire much wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:12.3"], "en": "While there were gifts to be given among the virtuous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:12.4"], "en": "I did not make an island for myself;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:12.5"], "en": "therefore, I now feel remorse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:12.6"], "en": "He will experience the fruit of his own deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:13.1"], "en": "Four months from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:13.2"], "en": "his passing away will take place.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:13.3", "PA_pv_19:13.4"], "en": "I shall fall into a terrible hell, utterly bitter,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:14.1"], "en": "having four corners and four gates.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:14.2"], "en": "Divided into sections and measured out,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:14.3", "PA_pv_19:14.4"], "en": "it was bounded by an iron wall and covered over with iron.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:15.1"], "en": "For him, there is a ground made of iron,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:15.2"], "en": "blazing and endowed with heat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:15.3"], "en": "extending for a hundred yojanas on all sides.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:15.4"], "en": "It remains pervading them at all times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:16.1"], "en": "Therein, for a very long duration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:16.2"], "en": "I experienced painful feeling.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:16.3"], "en": "This is the fruit of evil karma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:16.4"], "en": "therefore, I grieve intensely.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:17.1"], "en": "I say this to you: may it be well with you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:17.2"], "en": "All you who have gathered here:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:17.3"], "en": "do not commit an evil deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:17.4"], "en": "whether openly or in secret.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:18.1", "PA_pv_19:18.2"], "en": "If you will do, or have done, that evil deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:18.3"], "en": "there is no escape from suffering for you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:18.4"], "en": "Even if you must flee for your lives,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:19.1"], "en": "be devoted to your mother, be devoted to your father,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:19.2"], "en": "and honor those who are senior in the family.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:19.3"], "en": "\"Be recluses and be brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:19.4"], "en": "in this way you shall go to heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_19:20.1"], "en": "The Story of the Ghost of the Merchant Dhanapāla, the Seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
