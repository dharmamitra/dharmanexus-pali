[
{"segs": ["PA_thi-ap_7:0.1"], "en": "The Therī-apadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:0.2"], "en": "Sumedhāvagga 7:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:0.3"], "en": "The Apadāna of the Elder Nun Kaṭacchubhikkhādāyikā (She Who Gave Alms with a Ladle)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:1.1", "PA_thi-ap_7:1.2"], "en": "As the Teacher named Tissa was wandering for alms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:1.3"], "en": "having taken up his bowl of food,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:1.4"], "en": "\"I am a servant of the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:2.1"], "en": "Having accepted [the offering], the Perfectly Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:2.2"], "en": "Tissa, the Leader Supreme in the World, said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:2.3"], "en": "The Teacher, standing on the street,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:2.4"], "en": "gave me his blessing:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:3.1"], "en": "\"Having given this ladleful of alms-food...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:3.2"], "en": "You will go to the Tāvatiṃsa heaven;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:3.3", "PA_thi-ap_7:3.4"], "en": "you will exercise the great sovereignty over thirty-six divine kings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:4.1", "PA_thi-ap_7:4.2"], "en": "You shall exercise the great sovereignty of fifty wheel-turning monarchs;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:4.3"], "en": "everything you have desired in your mind—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:4.4"], "en": "You shall always obtain it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:5.1"], "en": "Having experienced prosperity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:5.2"], "en": "you will go forth into homelessness, free from possessions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:5.3"], "en": "\"Having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:5.4"], "en": "one will extinguish them, being free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:6.1"], "en": "Having said this, the Fully Awakened One—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:6.2"], "en": "The Hero, the Leader of the World’s Three,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:6.3", "PA_thi-ap_7:6.4"], "en": "ascended into the sky like a king of swans in the atmosphere.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:7.1"], "en": "My gift has been well-bestowed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:7.2"], "en": "my sacrificial perfection well-offered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:7.3"], "en": "having given this ladleful of alms-food, I have attained the supreme state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:7.4"], "en": "I have attained the unshakable state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:8.1"], "en": "Ninety-two aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:8.2"], "en": "the gift that I gave at that time—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:8.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:8.4"], "en": "this is the fruit of giving alms-food.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:9.1"], "en": "My defilements have been consumed by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:9.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:9.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:10.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:10.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:10.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:11.1"], "en": "The four analytical knowledges (paṭisambhidā) have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:11.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:11.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:12.1"], "en": "Thus indeed did the bhikkhunī Kaṭacchubhikkhādāyikā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_7:13.1"], "en": "The legend of the Elder Nun Kaṭacchubhikkhādāyikā is the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
