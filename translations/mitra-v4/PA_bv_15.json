[
{"segs": ["PA_bv_15:0.1"], "en": "Buddhavamsa 15:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:0.2", "PA_bv_15:1.1"], "en": "The Lineage of Piyadassī Buddha “After Sujāta, [there appeared] Piyadassī...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:1.2"], "en": "The Self-Existent One, the Leader of the World;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:1.3"], "en": "difficult to approach, peerless and equal to none,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:1.4"], "en": "lovely to behold, and of great renown.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:2.1", "PA_bv_15:2.2"], "en": "That Buddha of immeasurable fame also shines like the sun,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:2.3"], "en": "having utterly destroyed all darkness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:2.4"], "en": "He set the Wheel of Dhamma in motion.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:3.1"], "en": "For him too, of incomparable majesty,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:3.2"], "en": "there were three clear realizations.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:3.3", "PA_bv_15:3.4"], "en": "There was the first realization for one hundred thousand times ten million [beings].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:4.1"], "en": "Sudassana, the king of the gods, [attained it].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:4.2", "PA_bv_15:4.3"], "en": "He delighted in wrong view; dispelling that view,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:4.4"], "en": "the Teacher taught the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:5.1"], "en": "An incomparable gathering of people,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:5.2"], "en": "a great assembly then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:5.3"], "en": "of ninety thousand crores.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:5.4", "PA_bv_15:6.1", "PA_bv_15:6.2"], "en": "The second realization occurred when the Charioteer of Men trained the elephant Doṇamukha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:6.3", "PA_bv_15:6.4"], "en": "There was a third realization for eighty thousand times ten million;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:7.1"], "en": "there were three such assemblies.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:7.2"], "en": "Of that Piyadassin as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:7.3", "PA_bv_15:7.4"], "en": "there was a first assembly of one hundred thousand times ten million.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:8.1", "PA_bv_15:8.2", "PA_bv_15:8.3"], "en": "After that, ninety koṭis gathered together as one in the third assembly, O Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:8.4"], "en": "There were eighty koṭis.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:9.1"], "en": "At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:9.2"], "en": "I was a brahmin named Kassapa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:9.3"], "en": "A reciter, a bearer of mantras,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:9.4"], "en": "one who has mastered the three Vedas—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:10.1"], "en": "having heard his Dhamma, [one should practice it].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:10.2"], "en": "I generated serene confidence;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:10.3"], "en": "with hundreds of thousands of millions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:10.4"], "en": "I had a monastic park constructed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:11.1"], "en": "Having given him the monastery,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:11.2"], "en": "joyful and with a heart full of awe,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:11.3"], "en": "[he took] the three refuges and the five precepts.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:11.4", "PA_bv_15:12.1"], "en": "Having made it firm, I undertook it. That Buddha also,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:12.2"], "en": "sitting in the midst of the Saṅgha, gave me this prediction:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:12.3"], "en": "“In eighteen hundred kalpas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:12.4"], "en": "this one will become a Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:13.1"], "en": "Having exerted himself in the supreme effort,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:13.2", "PA_bv_15:13.3"], "en": "\"...we shall face him in person.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:14.1"], "en": "Having heard those words of hers as well, [he said:]...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:14.2"], "en": "I further gladdened my heart;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:14.3", "PA_bv_15:14.4"], "en": "I resolved upon higher vows for the fulfillment of the ten perfections.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:15.1"], "en": "There was a city named Sudhañña,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:15.2"], "en": "a kshatriya named Sudatta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:15.3"], "en": "and his mother was named Canda.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:15.4"], "en": "Of the Teacher Piyadassi,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:16.1", "PA_bv_15:16.2"], "en": "he dwelt in the household for nine thousand years.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:16.3", "PA_bv_15:16.4"], "en": "The three supreme palaces: the Sunimmala, the Vimala, and the Giriguha;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:17.1"], "en": "and thirty-three thousand [other palaces].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:17.2"], "en": "Women were beautifully adorned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:17.3"], "en": "there was a woman named Vimalā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:17.4"], "en": "and a son named Kañcanāveḷa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:18.1"], "en": "Having seen the four signs,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:18.2"], "en": "he went forth in a chariot;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:18.3"], "en": "for six months he practiced the course of striving on the ground.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:18.4"], "en": "The Supreme Person practiced [the holy life].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:19.1"], "en": "Being entreated by Brahmā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:19.2"], "en": "the Great Sage Piyadassī, being well-disposed, consented.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:19.3", "PA_bv_15:19.4"], "en": "The Great Hero set the wheel in motion in the delightful Usabha Garden;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:20.1"], "en": "so too did Pālita and Sabbadassī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:20.2"], "en": "were his chief disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:20.3", "PA_bv_15:20.4"], "en": "the attendant of the Teacher Piyadassi was named Sobhita.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:21.1", "PA_bv_15:21.2"], "en": "Sujātā and Dhammadinnā were his chief female disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:21.3"], "en": "such was the Bodhi tree of that Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:21.4"], "en": "He was called Kakudha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:22.1", "PA_bv_15:22.2"], "en": "Sandhaka and Dhammaka were his chief attendants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:22.3", "PA_bv_15:22.4"], "en": "Visākhā and Dhammadinnā were his chief female attendants;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:23.1"], "en": "he too was a Buddha of immeasurable fame.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:23.2"], "en": "Possessing the thirty-two excellent marks,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:23.3"], "en": "eighty cubits in height,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:23.4"], "en": "he appears like a king of sal trees.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:24.1", "PA_bv_15:24.2", "PA_bv_15:24.3"], "en": "The radiance of fire, moon, and sun is not like that which he possessed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:24.4"], "en": "Of that peerless Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:25.1", "PA_bv_15:25.2"], "en": "the God of Gods, the lifespan was likewise of such duration.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:25.3"], "en": "For ninety thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:25.4"], "en": "the Visionary One remained in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:26.1"], "en": "he too was a Buddha, peerless and equal to none.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:26.2"], "en": "Those ages too were incomparable;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:26.3"], "en": "all that has vanished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:26.4"], "en": "Are not all conditioned phenomena empty?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:27.1", "PA_bv_15:27.2"], "en": "The eminent sage Piyadassi attained Nibbāna in the Assattha Monastery;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:27.3"], "en": "right there stands his Jina-thūpa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:27.4"], "en": "“Rising three yojanas high.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_15:28.1"], "en": "This is the thirteenth chapter on the lineage of the Blessed One Piya-dassī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
