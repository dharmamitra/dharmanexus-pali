[
{"segs": ["PA_snp_2.11:0.1", "PA_snp_2.11:0.2", "PA_snp_2.11:1.1"], "en": "Sutta Nipāta 2.11 Rāhulasutta “Is it because of living together constantly, ... [that you speak thus]? (Rāhula)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:1.2"], "en": "Do you not despise the wise one?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:1.3", "PA_snp_2.11:1.4"], "en": "Is he who holds the torch for humanity honored by you?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:2.1"], "en": "“Though living with him constantly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:2.2"], "en": "I do not despise the wise one;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:2.3"], "en": "he is like a torch-bearer for humanity.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:2.4"], "en": "I have always honored him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:3.1"], "en": "Having abandoned the five strands of sensual pleasure—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:3.2"], "en": "those forms that are dear and delightful—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:3.3"], "en": "Having gone forth from the home with faith,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:3.4"], "en": "become one who brings an end to suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:4.1"], "en": "Associate with virtuous friends.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:4.2"], "en": "And dwell in a remote lodging,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:4.3"], "en": "secluded and free from noise;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:4.4"], "en": "be moderate in eating.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:5.1"], "en": "Regarding robes, almsfood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:5.2"], "en": "requisites, and lodgings—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:5.3"], "en": "do not let craving arise for these.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:5.4"], "en": "May he not return again to this world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:6.1", "PA_snp_2.11:6.2"], "en": "Being restrained by the Pātimokkha and in regard to the five sense faculties;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:6.3"], "en": "Let mindfulness be directed toward the body;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:6.4"], "en": "be full of disenchantment with existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:7.1"], "en": "Avoid the sign.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:7.2"], "en": "The beautiful is accompanied by lust;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:7.3"], "en": "develop a mind focused on the foul,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:7.4"], "en": "one-pointed and well-concentrated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:8.1", "PA_snp_2.11:8.2"], "en": "Cultivate the signless and abandon the underlying tendency to conceit; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:8.3"], "en": "through the full comprehension of conceit, [you shall be liberated].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:8.4"], "en": "“Having become tranquil, he will fare [in peace].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:9.1"], "en": "Thus indeed the Blessed One frequently exhorted the Venerable Rāhula with these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_2.11:9.2"], "en": "The Rāhula Sutta is the eleventh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
