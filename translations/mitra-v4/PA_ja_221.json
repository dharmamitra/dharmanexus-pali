{"segs": ["PA_ja_221:0.1", "PA_ja_221:0.2", "PA_ja_221:0.3"], "en": "Jātaka: The Second Book of Birth Stories (Dukanipāta), Chapter on the Yellow Robe (Kāsāvavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_221:0.4"], "en": "1. The Kāsāva Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_221:1.1", "PA_ja_221:1.2"], "en": "“Whoever shall wear the saffron robe without having cast out impurity—”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_221:1.3", "PA_ja_221:1.4"], "en": "One who is devoid of self-restraint and truthfulness does not deserve the saffron robe;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_221:2.1"], "en": "but he who has vomited out all impurities—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_221:2.2"], "en": "Well-composed in the precepts,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_221:2.3"], "en": "endowed with self-control and truthfulness—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_221:2.4"], "en": "he indeed is worthy of the saffron robe.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_221:3.1"], "en": "The Kāsāva Jātaka is the first.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
