[
{"segs": ["PA_cp_24:0.1", "PA_cp_24:0.2"], "en": "The Basket of Conduct (Cariyāpiṭaka), Chapter on Yudhañjaya,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:0.3"], "en": "Perfection of Renunciation (Nekkhammapāramī) 4", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:0.4"], "en": "“Furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:1.1", "PA_cp_24:1.2"], "en": "when I was born in the most excellent city of Kāsi, the Bhisacariya Jātaka:”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:1.3"], "en": "There was a sister and seven brothers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:1.4"], "en": "reborn into a family of Sotthiyas;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:2.1"], "en": "of these, I was the eldest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:2.2"], "en": "Having attained moral shame and purity,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:2.3"], "en": "and seeing existence as fearful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:2.4"], "en": "I delight in renunciation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:3.1"], "en": "Sent by my mother and father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:3.2"], "en": "companions of one mind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:3.3"], "en": "they invite me with sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:3.4"], "en": "\"Maintain the family lineage\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:4.1", "PA_cp_24:4.2"], "en": "these words they spoke bring happiness in the duties of a householder.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:4.3"], "en": "That became a hardship for me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:4.4"], "en": "like a glowing plowshare;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:5.1"], "en": "as they were then throwing me up,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:5.2"], "en": "They asked me about my aspiration:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:5.3"], "en": "“What do you aspire for, friend,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:5.4"], "en": "if you do not enjoy sensual pleasures?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:6.1", "PA_cp_24:6.2"], "en": "To them, who were seeking my welfare and desiring my benefit, I spoke thus:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:6.3"], "en": "“I do not long for the state of a householder.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:6.4"], "en": "\"I am one who delights in renunciation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:7.1"], "en": "Having heard my words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:7.2"], "en": "they informed my father and mother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:7.3"], "en": "My mother and father spoke thus:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:7.4"], "en": "\"O, let us all go forth together.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:8.1"], "en": "Both my mother and father—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:8.2"], "en": "I and my seven brothers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:8.3"], "en": "having abandoned our immense wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:8.4"], "en": "entered the great forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_24:9.1"], "en": "The fourth is the Chapter on the Physician’s Conduct.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
