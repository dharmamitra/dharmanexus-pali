[
{"segs": ["PA_bv_22:0.1"], "en": "Buddhavamsa 22.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:0.2", "PA_bv_22:1.1"], "en": "The Lineage of Buddha Sikhī \"After the time of Vipassī,...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:1.2"], "en": "The Fully Awakened One, supreme among bipeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:1.3"], "en": "was the Victor named Sikhī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:1.4"], "en": "peerless and without rival.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:2.1"], "en": "Having crushed the army of Māra,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:2.2", "PA_bv_22:2.3"], "en": "he attained supreme enlightenment and set in motion the Wheel of Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:2.4"], "en": "Out of compassion for living beings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:3.1", "PA_bv_22:3.2"], "en": "while the Conqueror, the Bull among Men, the Lord of the Sikhis, was setting in motion the Wheel of Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:3.3", "PA_bv_22:3.4"], "en": "There was the first realization for one hundred thousand times ten million;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:4.1"], "en": "while he was teaching the Dhamma further,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:4.2"], "en": "In that best of assemblies, among the supreme among men,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:4.3", "PA_bv_22:4.4"], "en": "there occurred a second realization for ninety thousand times ten million beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:5.1", "PA_bv_22:5.2"], "en": "Displaying the Twin Miracle to the world with its devas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:5.3"], "en": "[he brought] eighty thousand koṭis...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:5.4"], "en": "There was a third realization.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:6.1", "PA_bv_22:6.2"], "en": "There were three assemblies even for the Great Seer Sikhī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:6.3"], "en": "Of those whose taints are destroyed, who are stainless,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:6.4"], "en": "whose minds are peaceful, and who are poised—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:7.1"], "en": "of these one hundred thousand bhikkhus.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:7.2"], "en": "The first assembly took place;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:7.3", "PA_bv_22:7.4"], "en": "the second assembly consisted of eighty thousand bhikkhus.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:8.1", "PA_bv_22:8.2"], "en": "There was a third assembly of seventy thousand bhikkhus;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:8.3"], "en": "unstained like a lotus, they were gathered together.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:8.4"], "en": "It was grown up in water.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:9.1"], "en": "At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:9.2"], "en": "I was a kshatriya named Arindama.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:9.3"], "en": "I gratified the Saṅgha, headed by the Perfectly Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:9.4"], "en": "with food and drink;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:10.1"], "en": "having given many excellent robes, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:10.2", "PA_bv_22:10.3", "PA_bv_22:10.4"], "en": "I gave to the Perfectly Awakened One a vast, priceless elephant chariot, adorned with millions of cloths.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:11.1"], "en": "Having fashioned an elephant vehicle,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:11.2"], "en": "I offered it as an appropriate gift;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:11.3"], "en": "thus I fulfilled my own heart's desire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:11.4"], "en": "Constantly and firmly established.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:12.1", "PA_bv_22:12.2"], "en": "That Buddha Sikhi, the leader supreme in the world, also made this prediction concerning me:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:12.3"], "en": "“Thirty-one eons from now,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:12.4"], "en": "this one will become a Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:13.1"], "en": "There will be a delightful city called Kapila.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:13.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:13.3"], "en": "we shall be face to face with this one.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:14.1"], "en": "Having heard his words, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:14.2"], "en": "I further clarified my mind;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:14.3", "PA_bv_22:14.4"], "en": "I resolved upon higher vows for the fulfillment of the ten perfections.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:15.1"], "en": "The city was named Aruṇavatī;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:15.2"], "en": "the kṣatriya was named Aruṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:15.3"], "en": "his mother was named Pabhāvatī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:15.4", "PA_bv_22:16.1"], "en": "Even though he was training under the Great Seer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:16.2"], "en": "he lived in a household for seven thousand years.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:16.3"], "en": "Sucandaka, the mountain bull,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:16.4"], "en": "three supreme palaces,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:17.1"], "en": "and twenty-four thousand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:17.2"], "en": "Women were beautifully adorned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:17.3"], "en": "the woman was named Sabbakāmā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:17.4"], "en": "and the son was named Atula.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:18.1"], "en": "Having seen the four signs,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:18.2"], "en": "he departed on an elephant vehicle;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:18.3"], "en": "for eight months he engaged in the practice of striving.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:18.4"], "en": "The Supreme Person practiced [the path].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:19.1"], "en": "Being entreated by Brahmā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:19.2"], "en": "Sikhī, the Leader of the World, [arose].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:19.3", "PA_bv_22:19.4"], "en": "The Great Hero, the Supreme among Men, set the wheel rolling in the Deer Park;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:20.1"], "en": "he is the Conqueror and the Source of All.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:20.2"], "en": "They were the chief disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:20.3", "PA_bv_22:20.4"], "en": "the attendant of the Great Seer Sikhī was named Khemaṅkara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:21.1", "PA_bv_22:21.2"], "en": "Sakhilā and Padumā were his two chief female disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:21.3"], "en": "such was the bodhi tree of that Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:21.4"], "en": "He is called Puṇḍarīka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:22.1", "PA_bv_22:22.2"], "en": "Sirivaḍḍha and Nanda were his chief supporters.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:22.3", "PA_bv_22:22.4"], "en": "Cittā and Suguttā were his foremost attendants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:23.1"], "en": "In height, that Buddha—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:23.2"], "en": "Rising to a height of seven cubits,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:23.3"], "en": "resembling a golden statue,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:23.4"], "en": "he possessed the thirty-two excellent marks.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:24.1"], "en": "From her body as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:24.2", "PA_bv_22:24.3"], "en": "a fathom-wide radiance continuously streams out in every direction, day and night.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:24.4"], "en": "His radiance extended for three yojanas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:25.1", "PA_bv_22:25.2"], "en": "The lifespan of that Great Sage was seventy thousand years.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:25.3"], "en": "Remaining for that long,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:25.4"], "en": "he delivered many people.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:26.1"], "en": "Having rained down a cloud of Dhamma, he crossed over.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:26.2"], "en": "Having comforted the world including the devas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:26.3"], "en": "and having established them in safety,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:26.4"], "en": "he has attained Nibbāna together with his disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:27.1", "PA_bv_22:27.2"], "en": "The perfection of the minor marks and the thirty-two excellent major characteristics—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:27.3"], "en": "all that has vanished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:27.4"], "en": "Indeed, all conditioned phenomena are empty.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:28.1"], "en": "The Buddha, the supreme sage Sikhī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:28.2"], "en": "attained parinibbāna at the horse-park.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:28.3"], "en": "Right there his excellent stupa rises three yojanas high.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:28.4"], "en": "Thus ends the twentieth chapter:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_22:29.1"], "en": "The Lineage of the Blessed One Sikhi.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
