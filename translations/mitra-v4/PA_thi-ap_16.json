[
{"segs": ["PA_thi-ap_16:0.1", "PA_thi-ap_16:0.2", "PA_thi-ap_16:0.3"], "en": "Therīapadāna Ekūposathikavagga 6 Naḷamālikātherīapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:1.1"], "en": "“On the bank of the Candabhāgā River,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:1.2"], "en": "I was then a kinnarī;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:1.3"], "en": "I saw the stainless Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:1.4"], "en": "To the Self-Existent One, the Unconquered.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:2.1"], "en": "With a clear mind, joyful and filled with inspired knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:2.2"], "en": "they stood with palms joined in reverence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:2.3"], "en": "Having taken a garland of reeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:2.4"], "en": "I worshipped the Self-Existent One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:3.1"], "en": "By that well-performed deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:3.2"], "en": "And through my volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:3.3"], "en": "having cast off my kinnarī body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:3.4"], "en": "I went to the realm of the Tāvatiṃsa gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:4.1", "PA_thi-ap_16:4.2"], "en": "I exercised supreme sovereignty over thirty-six divine kings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:4.3"], "en": "this was what I had desired in my mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:4.4"], "en": "I was reborn according to my wish.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:5.1", "PA_thi-ap_16:5.2"], "en": "I served as the chief queen to ten universal monarchs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:5.3"], "en": "Having become one whose mind is purified,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:5.4"], "en": "I transmigrate through various states of existence; yet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:6.1"], "en": "wholesome merit still remains within me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:6.2"], "en": "I went forth into homelessness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:6.3", "PA_thi-ap_16:6.4"], "en": "today I am worthy of honor in the teaching of the Son of the Sakyas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:7.1", "PA_thi-ap_16:7.2"], "en": "Today, with minds purified and free from mental evil,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:7.3"], "en": "all taints are utterly exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:7.4"], "en": "Now there is no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:8.1", "PA_thi-ap_16:8.2"], "en": "Because I worshipped the Buddha ninety-four aeons ago, [I have attained this state].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:8.3"], "en": "I do not recognize a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:8.4"], "en": "this is the fruit of the reed-garland.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:9.1"], "en": "The defilements have been burnt away by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:9.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:9.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:10.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:10.2", "PA_thi-ap_16:10.3"], "en": "... [as before] ... the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:11.1"], "en": "The four analytical knowledges (paṭisambhidā) have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:11.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:11.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:12.1"], "en": "Thus indeed did the bhikkhunī Naḷamālikā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_16:13.1"], "en": "The legend of the Therī Naḷamālikā is the sixth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
