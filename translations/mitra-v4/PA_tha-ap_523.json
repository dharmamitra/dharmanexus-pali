[
{"segs": ["PA_tha-ap_523:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:0.2", "PA_tha-ap_523:0.3"], "en": "The Chapter on the Giver of Grass (Tiṇadāyakavagga) 1. The Apadāna of the Elder Tiṇamuṭṭhidāyaka (The Giver of a Handful of Grass)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:1.1", "PA_tha-ap_523:1.2"], "en": "\"Not far from the Himālaya mountains is a mountain named Lambaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:1.3"], "en": "there indeed dwelt the Sambuddha Tissa.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:1.4"], "en": "I walked back and forth in the open air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:2.1", "PA_tha-ap_523:2.2"], "en": "Formerly, I was a deer-hunter in the forest wilderness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:2.3"], "en": "Having seen that God of Gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:2.4", "PA_tha-ap_523:3.1"], "en": "I gave him a handful of grass for the Buddha’s seat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:3.2"], "en": "Having given it, I gladdened my heart;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:3.3"], "en": "having paid homage to the Perfectly Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:3.4"], "en": "I departed facing northward.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:4.1"], "en": "Not long after he had gone,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:4.2"], "en": "the king of beasts struck him down;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:4.3"], "en": "being struck by the lion, he lay there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:4.4"], "en": "There I passed away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:5.1"], "en": "The deed I had performed was near at hand for me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:5.2"], "en": "before the Best of Buddhas, who is free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:5.3"], "en": "Freed like the speed of an arrow,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:5.4"], "en": "I went to the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:6.1"], "en": "there, a beautiful sacrificial post stood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:6.2"], "en": "Fashioned from meritorious deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:6.3"], "en": "it has a thousand joints and a hundred sections;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:6.4"], "en": "it is bannered and made of gold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:7.1", "PA_tha-ap_523:7.2"], "en": "His radiance streams forth like the risen sun with its hundred rays,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:7.3"], "en": "surrounded by celestial maidens.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:7.4"], "en": "I rejoiced, desiring sensual pleasures here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:8.1"], "en": "Having fallen from the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:8.2"], "en": "impelled by the root of my wholesome merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:8.3"], "en": "Having come to human birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:8.4"], "en": "I have attained the destruction of the taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:9.1"], "en": "Ninety-four eons ago...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:9.2"], "en": "I gave a sitting mat;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:9.3"], "en": "I do not know a miserable rebirth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:9.4"], "en": "this is the fruit of that handful of grass.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:10.1"], "en": "The defilements have been incinerated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:10.2"], "en": "all states of existence have been uprooted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:10.3"], "en": "like a nāga who has severed his bonds, I am free.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:10.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:11.1", "PA_tha-ap_523:11.2"], "en": "Welcome indeed has come to me in the presence of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:11.3"], "en": "The three true insights have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:11.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:12.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:12.2", "PA_tha-ap_523:12.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:12.4"], "en": "the teaching of the Buddha has been accomplished.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:13.1"], "en": "Thus indeed the Elder Tiṇamuṭṭhidāyaka (the Giver of a Handful of Grass) spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_523:14.1"], "en": "This is the first legend of the Elder Tiṇamuṭṭhidāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
