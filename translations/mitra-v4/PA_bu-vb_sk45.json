[
{"segs": ["PA_bu-vb_sk45:0.1"], "en": "The Theravāda Vinaya Mahāvibhaṅga:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:0.2", "PA_bu-vb_sk45:0.3"], "en": "The Section on the Training Rules (Sekhiyakaṇḍa)", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:0.4"], "en": "The Chapter on Lumps of Food, 45.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:0.5"], "en": "The Training Rule on Breaking off Lumps of Food.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.1"], "en": "At that time, the Buddha, the Blessed One, was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.2"], "en": "Now at that time, the group-of-six monks ate cutting up mouthfuls...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.3.1"], "en": "\"The training is to be observed: 'I shall not eat by cutting up mouthfuls.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.4"], "en": "One must not eat by cutting up mouthfuls.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.5"], "en": "Whoever, out of disrespect, eats by cutting off mouthfuls, commits an offense of wrong-doing (*dukkaṭa*).", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.6.1", "PA_bu-vb_sk45:1.7"], "en": "There is no offense if it was unintentional.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.8"], "en": "For one who is lacking mindfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.9"], "en": "for one who is unaware,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.10"], "en": "and for one who is ill.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.11"], "en": "In snacks,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.12"], "en": "fruits and juices,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.13"], "en": "and supplementary food;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.14"], "en": "In times of distress,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.15"], "en": "for one who is insane,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.16"], "en": "and for an original offender.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk45:1.17"], "en": "The fifth training rule is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
