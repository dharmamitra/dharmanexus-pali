[
{"segs": ["PA_thag_2.40:0.1", "PA_thag_2.40:0.2"], "en": "Theragāthā 2.40 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:0.3"], "en": "Catutthavagga (The Fourth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:0.4"], "en": "The Verse of the Elder Kappaṭakura:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:1.1"], "en": "“This rag-robe wearer, Kappaṭakura,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:1.2"], "en": "[lives] by a stream that is exceedingly full.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:1.3"], "en": "In this small jar of the Deathless, there is just enough room for the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:1.4"], "en": "having set foot within it, one may ascend to the meditative absorptions (jhānas).", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:2.1"], "en": "Do not, O rag-picker, shake up the vessel!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:2.2"], "en": "“I will not strike you on the ear;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:2.3"], "en": "for you do not even recognize the value of a rag-robe,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:2.4"], "en": "as you nod off while in the midst of the Saṅgha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:2.5", "PA_thag_2.40:2.6"], "en": "… The Elder Kappaṭakura … The fourth chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:3.0"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:3.1"], "en": "Migasira, Sivaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:3.2"], "en": "the wise Upavāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:3.3"], "en": "Isidinna, and Kaccāna—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:3.4"], "en": "Nitaka and Mahāvasī;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:3.5"], "en": "Nisabha, son of Poṭiriya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.40:3.6"], "en": "Usabha, and Kappaṭakura.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
