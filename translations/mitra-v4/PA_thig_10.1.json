[
{"segs": ["PA_thig_10.1:0.1", "PA_thig_10.1:0.2"], "en": "Therīgāthā 10.1, Ekādasaka-nipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:0.3"], "en": "Kisāgotamī Therīgāthā", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:1.1", "PA_thig_10.1:1.2"], "en": "“Having pointed to the world, the Sage praised having virtuous friends;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:1.3"], "en": "by associating with virtuous friends, one...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:1.4"], "en": "Even a fool may become wise.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:2.1"], "en": "One should associate with true persons;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:2.2"], "en": "for those who associate with them, wisdom thus increases.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:2.3"], "en": "By associating with true persons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:2.4", "PA_thig_10.1:3.1"], "en": "one may be liberated from all sufferings and come to understand suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:3.2"], "en": "The origin and the cessation of suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:3.3"], "en": "and the eightfold path—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:3.4"], "en": "these are the four noble truths.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:4.1"], "en": "“Femalehood is suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:4.2"], "en": "as declared by the Charioteer who tames men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:4.3"], "en": "for even having a rival is suffering.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:4.4"], "en": "Some, having given birth for the first time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:5.1"], "en": "tear at their throats;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:5.2"], "en": "those delicate women eat poison.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:5.3"], "en": "“Falling into the midst of those who kill people,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:5.4"], "en": "both of them experience calamities.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:6.1"], "en": "“While going along, she was near her time of delivery;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:6.2"], "en": "I saw my husband dead on the road,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:6.3", "PA_thig_10.1:6.4"], "en": "having given birth before even reaching our own home.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:7.1"], "en": "Two sons have died,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:7.2"], "en": "and the husband of the poor woman has perished on the road;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:7.3"], "en": "her mother, father, and brother—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:7.4"], "en": "\"And they burn upon a single funeral pyre.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:8.1"], "en": "\"O you of exhausted lineage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:8.2"], "en": "you miserable one, immeasurable suffering was experienced by you.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:8.3"], "en": "Your tears have flowed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:8.4"], "en": "through many thousands of births;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:9.1"], "en": "you have dwelt in the midst of charnel grounds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:9.2"], "en": "Furthermore, having eaten the flesh of my own sons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:9.3", "PA_thig_10.1:9.4"], "en": "I, a woman of low caste, despised by all and whose husband had died, attained the Deathless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:10.1", "PA_thig_10.1:10.2"], "en": "The Noble Eightfold Path leading to the Deathless has been cultivated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:10.3"], "en": "Nibbāna has been realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:10.4"], "en": "I have beheld the mirror of the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:11.1"], "en": "I am one whose arrows are drawn out,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:11.2"], "en": "who has laid down the burden, and who has done what was to be done.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:11.3"], "en": "The elder nun Kisā Gotamī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:11.4"], "en": "her mind liberated, spoke this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:12.1"], "en": "… [the elder nun] Kisā Gotamī … [spoke].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_10.1:13.1"], "en": "The Eleventh Chapter is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
