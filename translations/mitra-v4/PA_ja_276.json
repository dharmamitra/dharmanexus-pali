[
{"segs": ["PA_ja_276:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_276:0.2", "PA_ja_276:0.3"], "en": "The Collection of Threes, Chapter on the Well (Udapānavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_276:0.4"], "en": "6. The Garuḷadhamma Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_276:1.1", "PA_ja_276:1.2"], "en": "“Having understood your faith and virtue, O lord of men;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_276:1.3", "PA_ja_276:1.4"], "en": "We painted our bodies with the color of collyrium in Kāliṅga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_276:2.1"], "en": "We were Annabhaccas and Abhaccas, and...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_276:2.2"], "en": "Whoever goes for the sake of [food],", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_276:2.3"], "en": "all those are not to be refused;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_276:2.4"], "en": "this is the word of the ancient teachers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_276:3.1"], "en": "I give this elephant to you, O brahmins—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_276:3.2"], "en": "worthy of a king, a royal possession, renowned, adorned,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_276:3.3"], "en": "and covered with a network of gold.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_276:3.4"], "en": "\"Go with your charioteer wherever you wish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_276:4.1"], "en": "This concludes the sixth Jātaka, the Garudhamma Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
