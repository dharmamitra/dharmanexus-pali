[
{"segs": ["PA_cp_25:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:0.2"], "en": "Yudhañjayavagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:0.3"], "en": "Nekkhammapāramī 5", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:0.4", "PA_cp_25:1.1"], "en": "The Deeds of the Wise Soṇa: \"Furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:1.2"], "en": "when I was in the city of Brahmavaḍḍhana...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:1.3", "PA_cp_25:1.4"], "en": "There, in a most excellent and noble family of great wealth, I was born.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:2.1"], "en": "Even then, having seen the world, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:2.2", "PA_cp_25:2.3", "PA_cp_25:2.4"], "en": "The mind, blinded and shrouded in darkness, recoils from existence as if struck by the force of a whip.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:3.1"], "en": "Having seen various evils,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:3.2"], "en": "I then thought thus: “When shall I,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:3.3"], "en": "having gone forth from home...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:3.4"], "en": "‘I shall enter the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:4.1", "PA_cp_25:4.2"], "en": "Even then my kinsmen invited me with the enjoyments of sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:4.3", "PA_cp_25:4.4"], "en": "I declared my own preference to them: “Do not invite me with them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:5.1"], "en": "My younger brother—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:5.2"], "en": "There was a wise man named Nanda;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:5.3", "PA_cp_25:5.4"], "en": "following my example, he too took delight in the going-forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:6.1", "PA_cp_25:6.2"], "en": "I, Soṇa, and Nanda were both my mother and father; even then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:6.3"], "en": "having renounced wealth, [we departed].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:6.4"], "en": "“We have entered the great forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_25:7.1"], "en": "This is the fifth account of the wise Soṇa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
