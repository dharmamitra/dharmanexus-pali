[
{"segs": ["PA_thag_4.12:0.1", "PA_thag_4.12:0.2", "PA_thag_4.12:0.3"], "en": "Theragāthā 4.12 Catukkanipāta Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:0.4"], "en": "The Verses of the Elder Muditatthera:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:1.1"], "en": "“I went forth for the sake of a livelihood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:1.2"], "en": "having received full ordination;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:1.3", "PA_thag_4.12:1.4"], "en": "Then I gained faith and strove with firm energy:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:2.1"], "en": "\"Let this body be broken as it may.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:2.2"], "en": "May my flesh fall away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:2.3"], "en": "may both my shanks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:2.4"], "en": "from the joints of the knees, fall off.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:3.1"], "en": "I shall not eat, I shall not drink,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:3.2"], "en": "and I shall not go out from the monastery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:3.3"], "en": "nor shall I lie down to sleep.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:3.4"], "en": "While the dart of craving has not been extracted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:4.1", "PA_thag_4.12:4.2"], "en": "observe the exertion of energy of one who dwells in such a manner.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:4.3"], "en": "“The three true insights have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:4.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:4.5"], "en": "… Thus spoke the elder Mudita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:4.6"], "en": "The Catukkanipāta is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:5.0"], "en": "Herein is the summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:5.1"], "en": "Nāgasamāla and Bhagu...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:5.2"], "en": "Sabhiya and Nandaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:5.3"], "en": "the elders Jambuka, Senaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:5.4"], "en": "Sambhūta, and Rāhula.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:6.1"], "en": "There is the Elder Candana;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:6.2"], "en": "these ten are disciples of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:6.3"], "en": "the Elder Dhammika and the Elder Sappaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:6.4"], "en": "And there are also three [sections] on the Joyful One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:6.5"], "en": "the verses number fifty-two,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.12:6.6"], "en": "and all the elders together are thirteen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
