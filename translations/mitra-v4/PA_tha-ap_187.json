[
{"segs": ["PA_tha-ap_187:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:0.2"], "en": "The Section on the Kuṭaja Flower, 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:0.3"], "en": "The Apadāna of the Elder Isimuggadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:1.1"], "en": "Like the rising sun with its hundred rays,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:1.2"], "en": "like the sun with its golden beams,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:1.3"], "en": "like the hump of a bull shining forth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:1.4"], "en": "To the Leader Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:2.1"], "en": "having ground wild cumin seeds that were sweet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:2.2"], "en": "fresh, and free from stalks;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:2.3"], "en": "Standing upon the palace itself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:2.4"], "en": "I gave [these gifts] to the Kinsman of the World:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:3.1"], "en": "eight hundred thousand [pieces of gold].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:3.2"], "en": "There were disciples of the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:3.3"], "en": "filling their alms-bowls,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:3.4"], "en": "they were even more numerous than that.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:4.1", "PA_tha-ap_187:4.2"], "en": "Impelled by that clarity of mind and that root of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:4.3"], "en": "for a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:4.4"], "en": "I did not fall into an evil rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:5.1", "PA_tha-ap_187:5.2"], "en": "For forty thousand aeons, and thirty-eight thousand more;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:5.3"], "en": "They were named Isimuggasena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:5.4"], "en": "wheel-turning monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:6.1"], "en": "The four analytical knowledges (paṭisambhidā),...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:6.3"], "en": "the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:7.1"], "en": "Thus indeed did the Venerable Elder Isimuggadāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_187:8.1"], "en": "The legend of the Elder Isimuggadāyaka is the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
