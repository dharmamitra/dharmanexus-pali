[
{"segs": ["PA_thag_2.21:0.1", "PA_thag_2.21:0.2"], "en": "Theragāthā 2.21 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.21:0.3"], "en": "Third Chapter (Tatiyavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.21:0.4"], "en": "Uttara Thera’s Verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.21:1.1"], "en": "“The aggregates have been fully understood by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.21:1.2"], "en": "craving has been thoroughly uprooted by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.21:1.3"], "en": "The factors of awakening have been cultivated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.21:1.4"], "en": "the destruction of the taints has been attained by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.21:2.1"], "en": "Having fully understood the aggregates, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.21:2.2"], "en": "Having pulled out the net,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.21:2.3"], "en": "and having cultivated the factors of enlightenment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.21:2.4"], "en": "I shall attain Nibbāna, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.21:2.5"], "en": "… The Elder Uttara …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
