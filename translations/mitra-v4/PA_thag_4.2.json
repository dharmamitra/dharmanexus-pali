[
{"segs": ["PA_thag_4.2:0.1", "PA_thag_4.2:0.2", "PA_thag_4.2:0.3"], "en": "Theragāthā 4.2 Catukkanipāta Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:0.4"], "en": "The Verses of Bhagu Thera:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:1.1"], "en": "“Overcome by drowsiness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:1.2"], "en": "I went out from the monastery;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:1.3"], "en": "While ascending the walking path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:1.4"], "en": "I fell right there upon the ground;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:2.1"], "en": "having rubbed my limbs, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:2.2"], "en": "Having ascended again to the walkway,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:2.3"], "en": "I walked back and forth upon that walkway,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:2.4"], "en": "well-composed within.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:3.1", "PA_thag_4.2:3.2"], "en": "Then, through wise attention, there arose in me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:3.3"], "en": "the danger became manifest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:3.4"], "en": "I established myself in disenchantment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:4.1"], "en": "Thereupon my mind was liberated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:4.2"], "en": "behold the excellence of the Dhamma!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:4.3"], "en": "“The threefold knowledge has been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:4.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.2:4.5"], "en": "… Thus spoke the Elder Bhagu.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
