[
{"segs": ["PA_tha-ap_133:0.1", "PA_tha-ap_133:0.2"], "en": "The Therāpadāna, Sobhitavagga: 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:0.3"], "en": "The Apadāna of the Elder Sobhita", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:1.2"], "en": "the eldest in the world, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:1.3"], "en": "[taught] to a great multitude of people...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:1.4"], "en": "He teaches the deathless state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:2.1"], "en": "Having heard his words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:2.2"], "en": "uttered with the voice of a bull, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:2.3"], "en": "Raising my hands in reverential salutation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:2.4"], "en": "I then sat with one-pointed mind:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:3.1"], "en": "\"Just as the ocean is the foremost among bodies of water...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:3.2"], "en": "Neru, the most excellent of mountains, that mass of rock—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:3.3", "PA_tha-ap_133:3.4"], "en": "likewise, those who act under the sway of their minds do not approach even a fraction of the Buddha’s knowledge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:4.1"], "en": "Having established the method of the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:4.2"], "en": "the compassionate Buddha, the Seer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:4.3"], "en": "sat down in the community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:4.4"], "en": "He spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:5.1", "PA_tha-ap_133:5.2"], "en": "“He who proclaimed knowledge regarding the Buddha, the Leader of the World;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:5.3"], "en": "For a hundred thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:5.4"], "en": "he shall not go to a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:6.1"], "en": "having incinerated the defilements, he will attain Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:6.2"], "en": "One-pointed and well-composed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:6.3", "PA_tha-ap_133:6.4"], "en": "he will be a disciple of the Teacher known by the name Sobhita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:7.1"], "en": "In fifty-five thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:7.2"], "en": "seven [kings] named Yasuggata appeared,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:7.3"], "en": "endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:7.4"], "en": "World-turning monarchs of great power—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:8.1"], "en": "my defilements have been incinerated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:8.2"], "en": "and all states of existence have been utterly eradicated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:8.3"], "en": "The three true knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:8.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:9.1"], "en": "The four analytical insights—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:9.2", "PA_tha-ap_133:9.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:9.4"], "en": "the teaching of the Buddha has been accomplished.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:10.1"], "en": "Thus indeed the venerable elder Sobhita spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_133:11.1"], "en": "This is the first legend of the elder Sobhita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
