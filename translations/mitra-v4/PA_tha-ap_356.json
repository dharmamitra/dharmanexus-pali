[
{"segs": ["PA_tha-ap_356:0.1", "PA_tha-ap_356:0.2", "PA_tha-ap_356:0.3"], "en": "The Apadāna of the Elder Sakosakakoraṇḍadāyaka, from the Saddasaññaka Chapter, Number Four.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:1.1"], "en": "“Having seen the footprint left by Sikhi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:1.2"], "en": "the Kinsman of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:1.3"], "en": "he placed his antelope skin on one shoulder.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:1.4"], "en": "I paid homage to the best of trees.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:2.1"], "en": "Having seen a *koraṇḍa* tree in full bloom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:2.2"], "en": "a footed plant growing from the earth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:2.3"], "en": "Taking whatever cloth I had,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:2.4"], "en": "I worshipped the wheel of footprints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:3.1"], "en": "Thirty-one eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:3.2"], "en": "Whatever deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:3.3"], "en": "I do not know any state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:3.4"], "en": "this is the fruit of worshipping his footprints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:4.1", "PA_tha-ap_356:4.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:5.1"], "en": "Thus indeed the venerable Elder Sakosakakoraṇḍadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_356:6.1"], "en": "This is the fourth legend of the Elder Sakosakakoraṇḍadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
