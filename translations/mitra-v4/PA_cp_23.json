[
{"segs": ["PA_cp_23:0.1", "PA_cp_23:0.2"], "en": "The Basket of Conduct (Cariyāpiṭaka), Chapter on Yudhañjaya,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:0.3"], "en": "Perfection of Renunciation (Nekkhammapāramī) 3", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:0.4"], "en": "The Practice of Ayoghara:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:1.1", "PA_cp_23:1.2"], "en": "“Furthermore, when I was born as the son of the King of Kāsi;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:1.3"], "en": "Raised in an iron house,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:1.4"], "en": "you were named Ayoghara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:2.1"], "en": "\"Life was obtained through suffering;...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:2.2"], "en": "Having been nurtured by you through great exertion,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:2.3", "PA_cp_23:2.4"], "en": "my son, take possession of this entire earth this very day.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:3.1", "PA_cp_23:3.2"], "en": "Having paid homage to the Khattiya together with his kingdom, his town, and his kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:3.3"], "en": "and having raised his hands in reverential salutation, he said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:3.4"], "en": "I spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:4.1"], "en": "“Whatever beings there are on earth—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:4.2"], "en": "whether low, superior, or middling;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:4.3"], "en": "Unprotected in their own homes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:4.4"], "en": "they grow up with their own kinsmen;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:5.1"], "en": "this is the highest good in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:5.2"], "en": "My nourishment was through compression;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:5.3"], "en": "I grew up in the Iron House,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:5.4"], "en": "where there was no light from moon or sun.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:6.1"], "en": "Filled with putrid corpses,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:6.2"], "en": "having emerged from the mother's womb,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:6.3"], "en": "[one falls] into sufferings even more terrible than that.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:6.4"], "en": "Again, I was cast into the house of the flood.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:7.1"], "en": "Having encountered such a state here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:7.2"], "en": "I experienced suffering that was most terrible.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:7.3"], "en": "If I were to take pleasure in kingdoms,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:7.4"], "en": "I would be the worst of evildoers;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:8.1"], "en": "I am weary of the body.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:8.2"], "en": "I have no need for kingship;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:8.3", "PA_cp_23:8.4"], "en": "I shall seek nibbāna, where death shall not crush me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:9.1", "PA_cp_23:9.2"], "en": "Having thought thus while the great multitude was crying out,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:9.3"], "en": "like an elephant breaking its bonds, I departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:9.4"], "en": "I entered the forest grove.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:10.1"], "en": "Neither my mother nor my father were to be missed by me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:10.2"], "en": "nor was great fame to be missed by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:10.3"], "en": "\"Omniscience is dear to me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:10.4"], "en": "therefore, I have renounced kingship.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_23:11.1"], "en": "Thus ends the third chapter, the Ayogharacariya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
