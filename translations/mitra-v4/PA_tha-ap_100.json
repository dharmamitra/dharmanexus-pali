[
{"segs": ["PA_tha-ap_100:0.1", "PA_tha-ap_100:0.2", "PA_tha-ap_100:0.3"], "en": "The Apadāna of the Elder Senāsanadāyaka Sudhāvagga 8. Senāsanadāyakattheraapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:1.1"], "en": "“To the Blessed One Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:1.2"], "en": "I gave a spread of leaves,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:1.3"], "en": "as well as an offering on all sides.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:1.4"], "en": "I scattered flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:2.1", "PA_tha-ap_100:2.2"], "en": "I enjoy this delightful and most precious palace, which possesses such excellent qualities.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:2.3", "PA_tha-ap_100:2.4"], "en": "And costly flowers are sprinkled upon my bed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:3.1"], "en": "I lie down upon that very bed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:3.2"], "en": "Upon a bed strewn with various flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:3.3", "PA_tha-ap_100:3.4"], "en": "a rain of blossoms fell continuously upon that very couch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:4.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:4.2"], "en": "I gave a spread of leaves;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:4.3"], "en": "I do not recall ever being born in an unhappy state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:4.4"], "en": "This is the fruit of spreading out [a seat]:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:5.1", "PA_tha-ap_100:5.2"], "en": "those seven who were known as \"grass-spreader\" became universal monarchs (cakkavatti).", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:5.3"], "en": "In this fifth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:5.4"], "en": "these lords of men appeared,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:6.1"], "en": "possessing the four analytical knowledges (paṭisambhidā).", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:7.1"], "en": "Thus indeed did the Venerable Elder Senāsanadāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_100:8.1"], "en": "The legend of the Elder Senāsanadāyaka is the eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
