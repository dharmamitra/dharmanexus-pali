[
{"segs": ["PA_tha-ap_362:0.1", "PA_tha-ap_362:0.2", "PA_tha-ap_362:0.3"], "en": "The Apadāna of the Elder Piṇḍapātika, from the Saddasaññaka Chapter, Number Ten.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:1.1", "PA_tha-ap_362:1.2"], "en": "The Sambuddha named Tissa then dwelt in the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:1.3"], "en": "for the Tusita devas, having come here, [honored him].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:1.4", "PA_tha-ap_362:2.1", "PA_tha-ap_362:2.2"], "en": "I gave almsfood to the Greatly Renowned One named Tissa, after having paid homage to the Perfectly Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:2.3"], "en": "Having gladdened my own mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:2.4"], "en": "I went to the Tusita heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:3.1"], "en": "Ninety-two eons ago from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:3.2"], "en": "Because I gave that gift at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:3.4"], "en": "this is the fruit of that alms-food offering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:4.1"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:4.2", "PA_tha-ap_362:4.3"], "en": "[as above] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:5.1"], "en": "Thus indeed did the Venerable Elder Piṇḍapātika speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:6.1"], "en": "This is the tenth legend of the Elder Piṇḍapātika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:7.1"], "en": "The thirty-sixth chapter, the Saddasaññaka-vagga, is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:8.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:9.1"], "en": "Saddasaññī, Yavasika,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:9.2"], "en": "Kiṃsuka, and Korandapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:9.3"], "en": "Ālambana, Ambayāgu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:9.4"], "en": "Supuṭī, Mañcadāyaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:9.5"], "en": "Saraṇa, and Piṇḍapāta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_362:9.6"], "en": "And the verse is exactly like the palm-leaf.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
