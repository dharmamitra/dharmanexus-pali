[
{"segs": ["PA_thag_7.5:0.1", "PA_thag_7.5:0.2", "PA_thag_7.5:0.3"], "en": "Theragāthā 7.5 Sattaka-nipāta Paṭhama-vagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:0.4"], "en": "The Verses of the Elder Sarabhaṅga:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:1.1"], "en": "“Having broken reeds with my hands,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:1.2"], "en": "and having made a hut for myself;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:1.3", "PA_thag_7.5:1.4"], "en": "Therefore, \"Sarabhaṅga\" became my name by common convention.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:2.1"], "en": "Today, it is no longer appropriate for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:2.2"], "en": "To break them with all our hands;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:2.3", "PA_thag_7.5:2.4"], "en": "the training rules have been laid down for us by the illustrious Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:3.1", "PA_thag_7.5:3.2"], "en": "Previously, Sarabhaṅga did not see this entire disease in its entirety;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:3.3"], "en": "now that very disease has been seen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:3.4"], "en": "By the reciter for the Overlord of Devas:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:4.1"], "en": "by whichever path Vipassī went,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:4.2"], "en": "and by whichever path Sikhī and Vessabhū went;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:4.3"], "en": "Kakusandha, Koṇāgamana, and Kassapa—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:4.4"], "en": "by that same direct path did Gotama go.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:5.1"], "en": "Free from craving and without grasping, they have all reached final peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:5.2"], "en": "The seven Buddhas are established in the destruction [of the defilements];", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:5.3", "PA_thag_7.5:5.4"], "en": "by them, who have become the Dhamma and are poised in equanimity, this Dhamma has been taught.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:6.1"], "en": "The Four Noble Truths,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:6.2"], "en": "out of compassion for living beings:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:6.3"], "en": "suffering, its origin, and the path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:6.4"], "en": "Cessation is the destruction of suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:7.1", "PA_thag_7.5:7.2"], "en": "That in which the endless suffering of saṃsāra ceases—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:7.3", "PA_thag_7.5:7.4"], "en": "With the breaking up of this body and the exhaustion of life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:7.5"], "en": "there is no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:7.6"], "en": "“I am well-liberated in every respect.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:7.7"], "en": "… Thus spoke the Elder Sarabhaṅga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:7.8"], "en": "The Seventh Chapter is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:8.0"], "en": "In this regard,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:8.1"], "en": "the summary verse is: The Elder Sundarasamudda,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:8.2"], "en": "the Elder Lakuṇḍabhaddiya;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:8.3"], "en": "The Elder Bhadda, Sopāka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:8.4"], "en": "the great seer Sarabhaṅga,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:8.5"], "en": "and the seven groups of five elders.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.5:8.6"], "en": "\"Thirty-five verses.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
