[
{"segs": ["PA_vv_81:0.1", "PA_vv_81:0.2"], "en": "Vimānavatthu: The Mansion of a Man,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:0.3"], "en": "Chapter on Those Well-Placed (Sunikkhittavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:0.4"], "en": "7. The Story of the Kaṇḍaka Mansion:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:1.1", "PA_vv_81:1.2"], "en": "“Just as the moon on the full-moon night, surrounded by the constellations,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:1.3", "PA_vv_81:1.4"], "en": "The moon, the lord of stars, travels all around;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:2.1"], "en": "this celestial palace is just like that.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:2.2"], "en": "And in the divine city of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:2.3"], "en": "he outshines them in beauty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:2.4"], "en": "like the sun rising with its rays.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:3.1"], "en": "Of beryl and gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:3.2"], "en": "of crystal and silver;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:3.3"], "en": "of emerald and pearls—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:3.4"], "en": "And with rubies,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:4.1"], "en": "the ground was variegated and delightful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:4.2"], "en": "spread over with beryl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:4.3"], "en": "Your gabled halls are beautiful and delightful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:4.4"], "en": "your palace is well-constructed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:5.1"], "en": "And your lotus pond is lovely.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:5.2"], "en": "Frequented by various birds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:5.3"], "en": "with clear water, serene,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:5.4"], "en": "and strewn with golden sand.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:6.1", "PA_vv_81:6.2"], "en": "Covered with various lotuses and strewn with white lilies,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:6.3"], "en": "they waft forth a fragrant scent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:6.4"], "en": "Pleasant, stirred by the breeze;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:7.1"], "en": "on both its sides,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:7.2"], "en": "groves of forest trees are beautifully arranged.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:7.3", "PA_vv_81:7.4"], "en": "It was filled with both flowering trees and fruit-bearing trees; there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:8.1"], "en": "upon a couch with legs of gold, [he sat].", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:8.2"], "en": "Seated upon a soft, well-spread couch,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:8.3", "PA_vv_81:8.4"], "en": "celestial nymphs attend upon him like the King of the Gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:9.1", "PA_vv_81:9.2"], "en": "Adorned with every ornament and embellished with various garlands,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:9.3"], "en": "they delight that one of great psychic power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:9.4"], "en": "You rejoice as if you were a lord of wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:10.1"], "en": "with kettledrums, conchs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:10.2"], "en": "mridanga drums, lutes, and cymbals.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:10.3"], "en": "You take delight in the perfection of pleasure,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:10.4"], "en": "in well-performed dance, song, and music;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:11.1"], "en": "various divine forms are yours.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:11.2"], "en": "Divine sounds as well as tastes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:11.3"], "en": "those fragrances intended for you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:11.4"], "en": "and delightful tangibles.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:12.1"], "en": "In that excellent celestial mansion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:12.2"], "en": "O son of the gods of great splendor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:12.3"], "en": "you shine forth with your radiance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:12.4"], "en": "Like the rising sun,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:13.1"], "en": "this is the fruit of your giving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:13.2"], "en": "or perhaps of your virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:13.3"], "en": "\"And also regarding the act of joining the palms in reverence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:13.4"], "en": "explain that to me when I ask.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:14.1"], "en": "That son of the gods, being delighted, [replied].", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:14.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:14.3"], "en": "the fruit of which action is this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:15.1"], "en": "\"In Kapilavatthu, I...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:15.2", "PA_vv_81:15.3"], "en": "I am Kaṇḍaka, born together with the son of Śuddhodana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:15.4"], "en": "the most eminent among the Śākyas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:16.1", "PA_vv_81:16.2"], "en": "When he went forth for enlightenment at the hour of midnight,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:16.3"], "en": "he [touched] me with his soft hands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:16.4", "PA_vv_81:17.1"], "en": "And Jāli, having struck the sixty with copper-clad nails, said,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:17.2"], "en": "\"Drive it on! and \"Drive it well!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:17.3"], "en": "\"I shall ferry across the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:17.4"], "en": "having attained supreme enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:18.1"], "en": "As he heard those words of mine,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:18.2"], "en": "A vast laughter arose within me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:18.3"], "en": "with an uplifted mind and a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:18.4"], "en": "I was then consecrated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:19.1"], "en": "And knowing that I, the son of the Sakyas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:19.2"], "en": "of great renown, had ascended,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:19.3"], "en": "he was uplifted in heart and joyful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:19.4"], "en": "I shall carry the Supreme Person.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:20.1", "PA_vv_81:20.2"], "en": "Having gone to the conquered territory of others when the sun had risen,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:20.3"], "en": "Leaving me and Channa behind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:20.4"], "en": "he departed without looking back;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:21.1"], "en": "his feet had copper-colored nails.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:21.2"], "en": "I licked his tongue;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:21.3"], "en": "and as the Great Hero departed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:21.4"], "en": "I gazed after him while weeping.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:22.1", "PA_vv_81:22.2"], "en": "Because I did not see that glorious son of the Sakyans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:22.3"], "en": "I contracted a severe illness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:22.4"], "en": "My death came quickly;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:23.1"], "en": "by that very power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:23.2"], "en": "I now dwell in this celestial mansion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:23.3", "PA_vv_81:23.4", "PA_vv_81:24.1"], "en": "And whatever laughter there was of mine, endowed with all the qualities of desire, in the divine city of the gods—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:24.2"], "en": "Having heard the sound of the Bodhi tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:24.3"], "en": "by that very root of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:24.4"], "en": "may I attain the destruction of the taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:25.1"], "en": "For if you should go, venerable sir,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:25.2"], "en": "into the presence of the Teacher, the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:25.3"], "en": "speak to him also on my behalf.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:25.4"], "en": "With your head, you should pay homage with veneration.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:26.1"], "en": "I too shall go to see the Jina,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:26.2"], "en": "the peerless one.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:26.3"], "en": "“Rare is the sight of those Tathāgatas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:26.4"], "en": "the Lords of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:27.1"], "en": "Thus he was grateful and mindful of what had been done for him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:27.2"], "en": "He approached the Teacher;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:27.3"], "en": "having heard the words of the One with Vision,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:27.4"], "en": "he purified the eye of Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:28.1"], "en": "Having purified his views,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:28.2"], "en": "doubts, and vows,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:28.3"], "en": "and having paid homage at the feet of the Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:28.4"], "en": "\"Right there they vanished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_81:29.1"], "en": "This concludes the seventh vimāna, the Kaṇḍaka-vimāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"}
]
