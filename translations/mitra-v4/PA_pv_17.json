[
{"segs": ["PA_pv_17:0.1"], "en": "The Peta-Vatthu:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:0.2"], "en": "Chapter on Ubbari, Story 5:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:0.3"], "en": "The Peta-Vatthu of Maṭṭhakuṇḍalī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:1.1"], "en": "“Adorned with polished earrings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:1.2"], "en": "wearing a garland, and anointed with yellow sandalwood paste,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:1.3"], "en": "you raise your arms and weep.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:1.4"], "en": "\"Why are you distressed in the middle of the forest?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:2.1", "PA_pv_17:2.2"], "en": "\"A radiant chariot-fortress made of gold has arisen for me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:2.3"], "en": "“I do not find even a pair of wheels for it;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:2.4"], "en": "because of that suffering, I would give up my life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:3.1"], "en": "“One made of gold, one made of jewels,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:3.2"], "en": "“Whether it be made of copper or made of silver—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:3.3"], "en": "tell me, noble youth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:3.4"], "en": "and I shall provide you with a pair of wheels.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:4.1"], "en": "Then the young man said to him:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:4.2"], "en": "\"Both the moon and the sun are seen here;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:4.3"], "en": "my chariot is made of gold.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:4.4"], "en": "“By that pair of wheels it shines.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:5.1"], "en": "“You are indeed a fool, young man,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:5.2"], "en": "you who desire what is undesired.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:5.3"], "en": "\"I think you will die,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:5.4"], "en": "for you shall not see the moon and the sun.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:6.1"], "en": "\"Coming and going are still seen,\" [he replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:6.2"], "en": "The element of beauty exists in both places along the path;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:6.3"], "en": "one who has passed away and died is no longer seen—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:6.4"], "en": "who here is more foolish than the one who weeps?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:7.1"], "en": "“You speak the truth, young man;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:7.2"], "en": "I am indeed the more childish of those who weep,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:7.3"], "en": "crying like a child at the moon.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:7.4"], "en": "\"She desires one who is dead and gone.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:8.1", "PA_pv_17:8.2"], "en": "\"Alas, while I am burning like a fire fed with ghee,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:8.3"], "en": "Sprinkling it as with water,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:8.4"], "en": "one should extinguish all distress.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:9.1"], "en": "Truly, I have extracted the arrow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:9.2"], "en": "The grief residing in my heart;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:9.3"], "en": "you who dispelled the sorrow for my son from me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:9.4"], "en": "who was overcome by grief.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:10.1"], "en": "I have extracted the arrow;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:10.2"], "en": "I have become cool and attained Nibbāna;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:10.3"], "en": "I do not grieve, nor do I weep.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:10.4"], "en": "“Having heard you, O young man,” [they said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:11.1"], "en": "“Are you a deity, or a gandhabba,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:11.2"], "en": "or perhaps Sakka Purindada?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:11.3"], "en": "“Who are you, or whose son are you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:11.4", "PA_pv_17:12.1"], "en": "How shall we know you? “Because you weep and because you wail...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:12.2"], "en": "Having personally cremated my son on the funeral pyre,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:12.3"], "en": "and having performed wholesome deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:12.4"], "en": "I have gone to the company of the Thirty-three gods.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:13.1"], "en": "“Whether small or great,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:13.2"], "en": "we have not seen [anyone] giving alms in their own home,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:13.3"], "en": "nor such a performance of the Uposatha rite;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:13.4"], "en": "“By what karma have you gone to the world of the gods?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:14.1"], "en": "“I was afflicted, suffering, and sick;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:14.2"], "en": "I was in a state of illness in my own home.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:14.3"], "en": "I beheld the Buddha, free from dust, who has crossed over doubt,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:14.4"], "en": "the Well-Gone One of peerless wisdom;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:15.1"], "en": "with a joyful mind and a clear heart, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:15.2"], "en": "I paid homage with joined palms to the Tathāgata;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:15.3"], "en": "having performed that wholesome deed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:15.4"], "en": "I went to the company of the Tidasas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:16.1"], "en": "“It is wonderful indeed, it is marvelous indeed!", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:16.2"], "en": "Such is the ripening of this act of joining the palms;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:16.3"], "en": "I too, with a joyful mind and a serene heart,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:16.4"], "en": "“Right this very day, I go for refuge to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:17.1"], "en": "“Right this very day, go for refuge to the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:17.2"], "en": "and with a confident heart, go for refuge to the Dhamma and the Saṅgha.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:17.3"], "en": "In the same way, undertake the five steps of training,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:17.4"], "en": "unbroken and fully blossomed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:18.1"], "en": "Quickly abstain from the taking of life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:18.2"], "en": "In this world, avoid taking what is not given;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:18.3"], "en": "do not drink intoxicants, nor speak falsehoods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:18.4"], "en": "and be content with your own wife.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:19.1"], "en": "“You desire my welfare, O yakkha;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:19.2"], "en": "you desire my benefit, O deity;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:19.3"], "en": "I shall do according to your word.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:19.4"], "en": "\"You are my teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:20.1", "PA_pv_17:20.2"], "en": "Thus I go for refuge to the Buddha and also to the unsurpassed Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:20.3"], "en": "And to the Saṅgha of the God among Men,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:20.4"], "en": "I go for refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:21.1"], "en": "I shall quickly abstain from taking life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:21.2"], "en": "In this world, I avoid what is not given;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:21.3"], "en": "I do not drink intoxicants, nor do I speak falsehoods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:21.4"], "en": "and I am content with my own wife.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_17:22.1"], "en": "The Fifth Story of the Ghost Maṭṭhakuṇḍalī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"}
]
