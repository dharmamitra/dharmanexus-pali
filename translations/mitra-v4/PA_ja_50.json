[
{"segs": ["PA_ja_50:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_50:0.2", "PA_ja_50:0.3"], "en": "Ekakanipāta, Atthakāmavagga (The Chapter on Those Desiring Welfare)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_50:0.4"], "en": "10. The Dummedha Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_50:1.1", "PA_ja_50:1.2"], "en": "\"A sacrifice was requested of me by a thousand fools.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_50:1.3"], "en": "\"Now indeed I shall sacrifice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_50:1.4"], "en": "for many people are unrighteous.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_50:2.1"], "en": "The *Dummedha-jātaka*, the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_50:2.2"], "en": "The fifth chapter: *Atthakāmavagga*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_50:3.1"], "en": "Its summary (*uddāna*):", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_50:4.1"], "en": "Now, *Mittaka*, *Mātu*, and *Kapotavara*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_50:4.2"], "en": "Likewise Veḷuka, Eḷamūga, Rohiṇī, Kapi,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_50:4.3"], "en": "Vāruṇī, Cetacarā, and again Tāraka—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_50:4.4"], "en": "these ten by means of the excellence of the sacrifice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_50:5.1"], "en": "The First Fifty.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
