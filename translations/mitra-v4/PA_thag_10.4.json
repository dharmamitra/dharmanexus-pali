[
{"segs": ["PA_thag_10.4:0.1", "PA_thag_10.4:0.2", "PA_thag_10.4:0.3"], "en": "Theragāthā 10.4 Dasaka-nipāta Paṭhama-vagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:0.4"], "en": "The Verses of the Elder Cūḷapanthaka:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:1.1"], "en": "“My progress was slow,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:1.2"], "en": "and formerly I was held in contempt.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:1.3"], "en": "My brother dismissed me, saying,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:1.4"], "en": "\"Go now, you, to your own home.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:2.1"], "en": "Having been thus dismissed, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:2.2"], "en": "At the gateway of the monastery,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:2.3"], "en": "I stood there dejected,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:2.4"], "en": "longing for the Dispensation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:3.1", "PA_thag_10.4:3.2"], "en": "The Blessed One came there and stroked my head;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:3.3"], "en": "taking me by the arm, he—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:3.4"], "en": "He led me into the monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:4.1"], "en": "Out of compassion for me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:4.2"], "en": "the Teacher gave me a foot-wiping cloth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:4.3"], "en": "“Resolve upon this purity;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:4.4"], "en": "it is well-resolved in solitude.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:5.1"], "en": "Having heard his words, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:5.2"], "en": "I dwelt delighting in the Teaching;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:5.3", "PA_thag_10.4:5.4"], "en": "I practiced for concentration in order to attain the supreme goal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:6.1"], "en": "I know my former abodes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:6.2"], "en": "the divine eye is purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:6.3"], "en": "the threefold knowledge has been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:6.4"], "en": "Thus was the Buddha’s teaching proclaimed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:7.1", "PA_thag_10.4:7.2"], "en": "Having manifested himself a thousand times, Panthaka—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:7.3", "PA_thag_10.4:7.4"], "en": "Sit in the delightful mango grove until the announcement of the time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:8.1"], "en": "then my Teacher sent for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:8.2"], "en": "To the messenger who announces the time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:8.3"], "en": "when the time had been announced,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:8.4"], "en": "I approached from the air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:9.1"], "en": "Having paid homage at the Teacher’s feet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:9.2"], "en": "I sat down to one side;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:9.3"], "en": "and perceiving that I was seated, he spoke.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:9.4"], "en": "Then the Teacher accepted it:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:10.1"], "en": "\"I am the sacrifice for the entire world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:10.2"], "en": "the recipient of offerings.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:10.3"], "en": "“He was the field of merit for humanity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:10.4"], "en": "who accepted the offering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.4:10.5"], "en": "… Thus spoke the Elder Cūḷapanthaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
