[
{"segs": ["PA_bv_13:0.1"], "en": "Buddhavamsa 13.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:0.2"], "en": "The Lineage of Sumedha Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:1.1"], "en": "\"After Padumuttara...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:1.2", "PA_bv_13:1.3"], "en": "The Leader named Sumedha was difficult to approach, possessed of fierce energy,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:1.4"], "en": "and the Sage supreme over the entire world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:2.1"], "en": "With serene eyes and a pleasant face, tall,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:2.2"], "en": "upright, and majestic;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:2.3"], "en": "seeking the welfare of all beings—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:2.4"], "en": "You have liberated many from their bonds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:3.1"], "en": "When you had attained, O Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:3.2"], "en": "the complete and supreme enlightenment;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:3.3"], "en": "In the city of Sudassana,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:3.4"], "en": "he set in motion the Wheel of Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:4.1"], "en": "through that realization as well, there were three [knowledges].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:4.2"], "en": "During the teaching of the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:4.3", "PA_bv_13:4.4"], "en": "there was the first realization for one hundred thousand times ten million beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:5.1", "PA_bv_13:5.2"], "en": "Furthermore, the Conqueror tamed the yakkha Kumbhakaṇṇa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:5.3"], "en": "along with ninety thousand koṭis.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:5.4"], "en": "There was a second realization.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:6.1", "PA_bv_13:6.2"], "en": "Furthermore, the one of immeasurable fame proclaimed the Four Noble Truths.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:6.3", "PA_bv_13:6.4"], "en": "There was a third realization of eighty thousand koṭis;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:7.1"], "en": "there were three such assemblies.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:7.2"], "en": "Of the Great Sage Sumedha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:7.3"], "en": "of those whose taints were exhausted, who were stainless,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:7.4"], "en": "whose minds were peaceful, and who were steadfast.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:8.1", "PA_bv_13:8.2"], "en": "When the Conqueror approached the city named Sudassana,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:8.3"], "en": "at that time the bhikkhus were those whose taints were exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:8.4"], "en": "There were six hundred million [deities].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:9.1"], "en": "Furthermore, at Devakūṭa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:9.2"], "en": "when the kaṭhina had been spread for the bhikkhus;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:9.3", "PA_bv_13:9.4"], "en": "At that time, there was a second assembly of ninety koṭis.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:10.1"], "en": "Furthermore, the One of Ten Powers—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:10.2"], "en": "When he went forth on his journey,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:10.3", "PA_bv_13:10.4"], "en": "there was a third assembly of eighty koṭis.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:11.1"], "en": "At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:11.2"], "en": "I was a young brahmin named Uttara;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:11.3"], "en": "I had eighty koṭis [of followers].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:11.4"], "en": "Having given away all the wealth accumulated in my home,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:12.1", "PA_bv_13:12.2"], "en": "I offered it entirely to the Leader of the World together with the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:12.3", "PA_bv_13:12.4"], "en": "I went to him for refuge and took delight in the going-forth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:13.1"], "en": "that Buddha also made a prediction concerning me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:13.2"], "en": "While offering this expression of sympathetic joy:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:13.3"], "en": "“In thirty thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:13.4"], "en": "this one shall become a Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:14.1"], "en": "Having exerted ourselves in striving...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:14.2", "PA_bv_13:14.3"], "en": "we shall stand face to face with this one.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:15.1"], "en": "Having heard her words as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:15.2"], "en": "my heart became even more serene;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:15.3"], "en": "I resolved upon a further ascetic practice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:15.4"], "en": "Through the fulfillment of the ten perfections,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:16.1"], "en": "[he mastered] the Suttanta and the Vinaya,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:16.2"], "en": "as well as the ninefold teaching of the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:16.3"], "en": "Having mastered everything,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:16.4"], "en": "I brought glory to the Conqueror’s teaching.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:17.1"], "en": "Dwelling there with diligence, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:17.2"], "en": "In sitting, standing, and walking,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:17.3"], "en": "having reached perfection in the higher knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:17.4"], "en": "I went to the world of Brahmā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:18.1"], "en": "The city named Sudassana,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:18.2"], "en": "the kshatriya named Sudatta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:18.3"], "en": "and the mother named Sudattā—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:18.4", "PA_bv_13:19.1", "PA_bv_13:19.2"], "en": "The great sage Sumedha lived within the household for nine thousand years.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:19.3"], "en": "Sucanda, Kancana, and Sirivaḍḍha—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:19.4"], "en": "these were the three supreme palaces.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:20.1"], "en": "There were sixteen thousand [attendants].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:20.2"], "en": "The women were beautifully adorned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:20.3"], "en": "that woman was named Sumanā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:20.4"], "en": "and her son was named Punabbasu.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:21.1"], "en": "Having seen four omens,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:21.2"], "en": "he departed on an elephant mount;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:21.3"], "en": "for no less than half a month, he remained there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:21.4", "PA_bv_13:22.1", "PA_bv_13:22.2"], "en": "The Conqueror, the wise Leader of the World, being entreated by Brahmā, exerted himself in striving.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:22.3", "PA_bv_13:22.4"], "en": "The Great Hero set the wheel in motion in the most excellent Sudassana Garden;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:23.1"], "en": "he was the refuge and the fulfiller of all desires.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:23.2"], "en": "They were the chief disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:23.3", "PA_bv_13:23.4"], "en": "the attendant of the Great Seer Sumedha was named Sāgara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:24.1", "PA_bv_13:24.2"], "en": "Rāmā and Surāmā were his chief female disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:24.3"], "en": "such was the enlightenment of that Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:24.4"], "en": "Mahānīpa is what is called [the place].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:25.1", "PA_bv_13:25.2"], "en": "Uruvelā and Yasavat were the chief supporters.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:25.3", "PA_bv_13:25.4"], "en": "Yasodharā and Sirimā were the foremost attendants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:26.1"], "en": "There were eighty thousand gems.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:26.2"], "en": "The Great Sage has risen high;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:26.3", "PA_bv_13:26.4"], "en": "he illuminates all directions like the moon among the hosts of stars.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:27.1", "PA_bv_13:27.2"], "en": "The so-called wheel-turning king’s jewel shines for a league;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:27.3"], "en": "even so is his gem.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:27.4"], "en": "It pervades a league on all sides.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:28.1"], "en": "For ninety thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:28.2"], "en": "such a lifespan exists.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:28.3"], "en": "Remaining for that long,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:28.4"], "en": "he brought many people across;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:29.1"], "en": "by means of those possessing the three knowledges and the six direct knowledges, he led them to liberation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:29.2", "PA_bv_13:29.3"], "en": "This world was filled with such noble ones who had attained strength—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:29.4"], "en": "Arahants, virtuous and excellent.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:30.1"], "en": "All those with infinite lifespans,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:30.2"], "en": "liberated and free from acquisitions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:30.3"], "en": "having displayed the light of knowledge—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:30.4"], "en": "Those of great renown have attained extinction.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:31.1"], "en": "The supreme Victor, the Buddha Sumedha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:31.2"], "en": "has attained extinction in the Grove of Wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:31.3", "PA_bv_13:31.4"], "en": "“The expansion of the relics occurred in various regions. Thus ends the eleventh chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_13:32.1"], "en": "the lineage of the Blessed One Sumedha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
