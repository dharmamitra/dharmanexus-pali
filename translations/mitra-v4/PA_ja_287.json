[
{"segs": ["PA_ja_287:0.1"], "en": "Jātaka Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_287:0.2", "PA_ja_287:0.3"], "en": "Abbhantaravagga (The Chapter on the Inner Group)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_287:0.4"], "en": "7. The Lābhagarahajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_287:1.1", "PA_ja_287:1.2"], "en": "“One who is not intoxicated, nor malicious, nor deceitful, nor full of idle curiosity;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_287:1.3"], "en": "“One gains profit among those who are deluded;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_287:1.4"], "en": "this is your instruction.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_287:2.1"], "en": "“Fie on that gain of fame!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_287:2.2"], "en": "And as for the acquisition of wealth, O Brahmin:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_287:2.3", "PA_ja_287:2.4"], "en": "that livelihood which proceeds through downfall or by practicing unrighteousness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_287:3.1", "PA_ja_287:3.2"], "en": "Even if one goes forth as a homeless wanderer, taking up the alms-bowl,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_287:3.3"], "en": "this very livelihood is better.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_287:3.4"], "en": "\"And that which is a search by means of what is not in accordance with the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_287:4.1"], "en": "Thus ends the seventh Jātaka, the Lābhagaraha Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
