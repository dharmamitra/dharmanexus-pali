[
{"segs": ["PA_tha-ap_298:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:0.2"], "en": "Chapter on the Worshipers of the Pyre (Citakapūjakavagga),", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:0.3"], "en": "Number Six: The Apadāna of the Elder Pādapūjaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:1.1", "PA_tha-ap_298:1.2"], "en": "“At that time, on a mountain in the Himālayas, I was a kinnara;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:1.3"], "en": "I saw the stainless Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:1.4"], "en": "Like the sun with its golden rays—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:2.1"], "en": "I approached that Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:2.2"], "en": "Vipassī, the leader of the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:2.3", "PA_tha-ap_298:2.4"], "en": "Then I sprinkled sandalwood and tagara upon his feet.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:3.1"], "en": "Ninety-one eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:3.2"], "en": "Because I worshipped that foot,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:3.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:3.4"], "en": "this is the fruit of worshipping the foot.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:4.1", "PA_tha-ap_298:4.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:5.1"], "en": "Thus indeed the venerable elder Pādapūjaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_298:6.1"], "en": "This is the sixth legend of the elder Pādapūjaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
