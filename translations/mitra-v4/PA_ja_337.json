[
{"segs": ["PA_ja_337:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:0.2", "PA_ja_337:0.3"], "en": "Catukkanipāta, Kokilavagga (The Chapter on the Cuckoo)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:0.4", "PA_ja_337:1.1"], "en": "7. The Pīṭha Jātaka “We did not give you a seat,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:1.2"], "en": "nor drink, nor food;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:1.3"], "en": "“O celibate student, forgive me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:1.4"], "en": "I see this as a transgression.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:2.1"], "en": "“I am neither resentful nor angry.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:2.2"], "en": "Nor was there anything unpleasant to me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:2.3"], "en": "yet there arose in my mind this thought:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:2.4"], "en": "\"Surely such is the nature of this family.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:3.1", "PA_ja_337:3.2"], "en": "“In our family, the Dhamma has always been the tradition of our fathers and grandfathers:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:3.3"], "en": "[the offering of] a seat, water, and foot-washing.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:3.4"], "en": "We bow down to all of this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:4.1"], "en": "This is the tradition in our family,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:4.2"], "en": "handed down always from father to grandfather.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:4.3"], "en": "\"We shall attend upon him with reverence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:4.4"], "en": "as if he were our most excellent kinsman.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_337:5.1"], "en": "Thus ends the seventh Jātaka, the Pīṭha-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
