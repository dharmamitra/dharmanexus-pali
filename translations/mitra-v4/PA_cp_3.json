[
{"segs": ["PA_cp_3:0.1"], "en": "Cariyāpiṭaka, Akittivagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:0.2", "PA_cp_3:0.3"], "en": "Dānapāramī 3: The Perfection of Giving, Story of Akitti (3)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:0.4"], "en": "Furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:1.1", "PA_cp_3:1.2"], "en": "when I was the King of the Kurus in the supreme city of Indapatta;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:1.3", "PA_cp_3:1.4"], "en": "The king named Dhanañcaya attained the ten wholesome qualities;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:2.1"], "en": "he was from the territory of the Kaliṅga kingdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:2.2", "PA_cp_3:2.3"], "en": "Brahmins approached me and entreated me for the noble elephant,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:2.4"], "en": "who was esteemed as an auspicious blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:3.1"], "en": "“The country is destitute,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:3.2"], "en": "there is famine and great hunger;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:3.3"], "en": "give away this excellent elephant.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:3.4"], "en": "\"Blue, called by the name Añjana.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:4.1"], "en": "\"When a petitioner has come to me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:4.2"], "en": "a refusal is not fitting for me;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:4.3"], "en": "\"May my vow not be broken;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:4.4"], "en": "I shall give this vast elephant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:5.1"], "en": "Having seized the elephant by its trunk, [he gave it].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:5.2", "PA_cp_3:5.3"], "en": "Having poured water from a jeweled pitcher into their hands,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:5.4"], "en": "I gave the elephant to the brahmins.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:6.1"], "en": "When the elephant had been given away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:6.2"], "en": "his ministers said this to him:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:6.3"], "en": "“Why indeed do you give away the best of elephants?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:6.4"], "en": "You will grant it to supplicants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:7.1"], "en": "It is a blessing endowed with auspiciousness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:7.2"], "en": "the supreme victory in battle.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:7.3", "PA_cp_3:7.4"], "en": "“Now that this Naga has been given away, what will your kingdom do for you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:8.1"], "en": "“I would give me my entire kingdom.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:8.2"], "en": "\"I would rather give up my own body;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:8.3"], "en": "omniscience is dear to me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:8.4"], "en": "therefore I gave the elephant.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_3:9.1"], "en": "The third [chapter] on the conduct of the King of the Kurus.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
