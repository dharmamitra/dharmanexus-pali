[
{"segs": ["PA_vv_26:0.1", "PA_vv_26:0.2", "PA_vv_26:0.3"], "en": "Vimānavatthu: The Chapter on the Cittalatā Grove of the Itthivimāna (The Stories of the Female Celestial Mansions)", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:0.4", "PA_vv_26:1.1", "PA_vv_26:1.2"], "en": "9. The Mansion of Suniddā “With a most excellent complexion... [as before] ...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:1.3"], "en": "Like medicinal herbs among the stars.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:2.1"], "en": "By what means is your complexion such as this?", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:2.2"], "en": "…pe…", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:2.3"], "en": "\"And your complexion shines in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:3.1", "PA_vv_26:3.2"], "en": "That deity, with a joyful mind... [as before]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:3.3"], "en": "The fruit of which deed is this?", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:4.1"], "en": "\"They knew me as Suniddā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:4.2"], "en": "a female lay follower in Rājagaha.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:4.3"], "en": "Endowed with faith and virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:4.4"], "en": "always delighting in sharing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:6.1"], "en": "they take pleasure in the five precepts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:6.2"], "en": "Skilled in the noble truths,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:6.3", "PA_vv_26:6.4"], "en": "she was a female lay disciple of the illustrious Gotama, the Visionary One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:7.1", "PA_vv_26:7.2"], "en": "\"Because of that, my complexion is such as this...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:7.3"], "en": "and my complexion shines forth in all directions.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_26:8.1"], "en": "The ninth is the Suniddha-vimāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"}
]
