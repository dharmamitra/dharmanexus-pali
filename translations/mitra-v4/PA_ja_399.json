[
{"segs": ["PA_ja_399:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:0.2", "PA_ja_399:0.3"], "en": "The Section of Sevens, Chapter on the Cocks (Kukkuvagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:0.4"], "en": "4. The Gijjhajātika Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:1.1", "PA_ja_399:1.2"], "en": "\"How indeed will they fare, those who are old and dwell in mountain caves?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:1.3"], "en": "“I am bound by the snare;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:1.4"], "en": "I have fallen under the power of the hunter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:2.1"], "en": "“Why do you lament like a vulture?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:2.2"], "en": "What lamentation can there be for you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:2.3", "PA_ja_399:2.4"], "en": "For I have neither heard nor seen a bird speaking in human speech.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:3.1"], "en": "“I support my parents,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:3.2"], "en": "who are old and dwell in a mountain cave;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:3.3"], "en": "how indeed will they manage?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:3.4"], "en": "“I have fallen under your power.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:4.1", "PA_ja_399:4.2"], "en": "“Just as a vulture gazes upon carcasses for a hundred leagues;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:4.3", "PA_ja_399:4.4"], "en": "\"Why do you not wake up even when encountering the net and the snare?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:5.1"], "en": "\"When ruin occurs...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:5.2"], "en": "When life is at its end,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:5.3", "PA_ja_399:5.4"], "en": "one does not even wake up upon encountering the snare and the net.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:6.1"], "en": "“Support your parents,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:6.2"], "en": "who are aged and like caves in a mountain cliff;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:6.3"], "en": "you have been authorized by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:6.4"], "en": "“Look upon your kinsmen with safety.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:7.1", "PA_ja_399:7.2"], "en": "“Thus, hunter, may you rejoice together with all your kinsmen.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:7.3", "PA_ja_399:7.4"], "en": "“I shall support my mother and father when they are old and dwelling in a mountain cave.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_399:8.1"], "en": "The Vulture Who Supports His Mother Jātaka, the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
