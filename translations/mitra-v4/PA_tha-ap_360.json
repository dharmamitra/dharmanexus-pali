[
{"segs": ["PA_tha-ap_360:0.1", "PA_tha-ap_360:0.2", "PA_tha-ap_360:0.3"], "en": "The Apadāna of the Elder Mañcadāyaka, from the Saddasaññaka Chapter, Number Eight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:1.1"], "en": "“To the Blessed One Vipassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:1.2"], "en": "the World’s Elder, the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:1.3"], "en": "I gave a single couch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:1.4"], "en": "With a confident hand,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:2.1", "PA_tha-ap_360:2.2"], "en": "he attained elephant-vehicles, horse-vehicles, and celestial vehicles.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:2.3"], "en": "By that gift of a bed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:2.4"], "en": "I have attained the destruction of the taints;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:3.1"], "en": "ninety-one eons ago, I reached this state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:3.2"], "en": "Because I gave that bed at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:3.4"], "en": "this is the fruit of giving a bed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:4.1", "PA_tha-ap_360:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:5.1"], "en": "Thus indeed the venerable elder Mañcadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_360:6.1"], "en": "This is the eighth legend of the elder Mañcadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
