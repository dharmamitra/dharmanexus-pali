[
{"segs": ["PA_tha-ap_310:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:0.2"], "en": "Padumakesara Chapter, 8.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:0.3"], "en": "The Apadāna of the Elder Anulepadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:1.1", "PA_tha-ap_310:1.2", "PA_tha-ap_310:1.3"], "en": "“I saw a disciple of the Sage Atthadassi while he was engaged in new construction work.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:1.4"], "en": "I approached the boundary.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:2.1"], "en": "When the new construction was finished,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:2.2"], "en": "I offered an ointment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:2.3"], "en": "With a clear mind and joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:2.4"], "en": "in this unsurpassed field of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:3.1"], "en": "for eighteen hundred kappas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:3.2"], "en": "Whatever deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:3.4"], "en": "this is the fruit of that ointment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:4.1", "PA_tha-ap_310:4.2"], "en": "The four analytical knowledges... [and so on]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:5.1"], "en": "Thus indeed the venerable elder Anulepadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_310:6.1"], "en": "This is the eighth legend of the elder Anulepadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
