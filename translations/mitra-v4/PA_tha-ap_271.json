[
{"segs": ["PA_tha-ap_271:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:0.2"], "en": "Padumukkhipavagga 9:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:0.3"], "en": "The Apadāna of the Elder Upāgatāsayatthera.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:1.1"], "en": "“In the midst of the Himālaya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:1.2"], "en": "there was a well-constructed lake;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:1.3"], "en": "there I was a rākṣasa.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:1.4"], "en": "Of firm virtue and formidable,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:2.1"], "en": "compassionate and merciful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:2.2"], "en": "Vipassī, the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:2.3"], "en": "Desiring to rescue me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:2.4"], "en": "he came into my presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:3.1"], "en": "To the Great Hero who had approached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:3.2", "PA_tha-ap_271:3.3"], "en": "Having gone forth from my dwelling with the intention [to see] the God of Gods, the Bull among Men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:3.4"], "en": "I paid homage to the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:4.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:4.2"], "en": "because I paid homage to that Supreme Person,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:4.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:4.4"], "en": "This is the fruit of paying homage:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:5.1", "PA_tha-ap_271:5.2"], "en": "the four analytical knowledges (*paṭisambhidā*), and so forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:5.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:6.1"], "en": "Thus indeed did the Venerable Elder Upāgatāsayo speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_271:7.1"], "en": "This is the ninth legend of the Elder Upāgatāsayo.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
