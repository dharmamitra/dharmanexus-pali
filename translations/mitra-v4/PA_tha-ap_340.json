[
{"segs": ["PA_tha-ap_340:0.1", "PA_tha-ap_340:0.2", "PA_tha-ap_340:0.3"], "en": "The Apadāna of the Elder Uttareyyadāyaka, from the Gandhodakavagga, the Eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:1.1", "PA_tha-ap_340:1.2"], "en": "“At that time, in the city of Haṃsavatī, I was a brahmin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:1.3"], "en": "a reciter of the Vedas and a bearer of the mantras.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:1.4"], "en": "A master of the three Vedas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:2.1"], "en": "honored by his disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:2.2"], "en": "of noble birth and well-trained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:2.3"], "en": "Then, for the purpose of the water-consecration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:2.4"], "en": "I departed from the city.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:3.1"], "en": "The Victor named Padumuttara—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:3.2"], "en": "Having reached the further shore of all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:3.3", "PA_tha-ap_340:3.4"], "en": "the Victor entered the city accompanied by a thousand monks whose taints were exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:4.1"], "en": "Having seen his beautiful form,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:4.2"], "en": "which was as if produced by the power of imperturbability,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:4.3"], "en": "surrounded by Arahants—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:4.4"], "en": "Having seen him, I gladdened my heart;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:5.1"], "en": "placing my joined palms to my head,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:5.2"], "en": "I paid homage to that one of noble vows.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:5.3"], "en": "With a clear mind and joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:5.4"], "en": "I offered an upper garment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:6.1"], "en": "having taken it up with both hands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:6.2"], "en": "I threw up my single garment;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:6.3", "PA_tha-ap_340:6.4"], "en": "it covered as far as the entire assembly of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:7.1"], "en": "As he was walking for alms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:7.2"], "en": "leading a great company of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:7.3"], "en": "a certain person stood there spreading a canopy over him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:7.4"], "en": "Making me laugh at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:8.1"], "en": "as I was departing from my home,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:8.2"], "en": "was the Self-Existent One, the Supreme Person.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:8.3", "PA_tha-ap_340:8.4"], "en": "Standing on the road, the Teacher offered me his expression of appreciation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:9.1"], "en": "his mind serene and joyful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:9.2", "PA_tha-ap_340:9.3"], "en": "I shall praise him who gave me this cloth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:9.4"], "en": "listen as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:10.1", "PA_tha-ap_340:10.2"], "en": "For thirty thousand aeons he will delight in the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:10.3"], "en": "fifty times he will be the Lord of the Gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:10.4"], "en": "He will exercise sovereignty over the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:11.1"], "en": "While dwelling in the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:11.2"], "en": "endowed with meritorious deeds;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:11.3"], "en": "For a hundred leagues all around,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:11.4"], "en": "it will be covered with cloth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:12.1"], "en": "And thirty-six times as king, he will—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:12.2"], "en": "He will become a wheel-turning monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:12.3", "PA_tha-ap_340:12.4"], "en": "his local sovereignty will be vast and beyond counting.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:13.1", "PA_tha-ap_340:13.2"], "en": "For one who possesses meritorious deeds while wandering through existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:13.3"], "en": "everything desired by the mind—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:13.4"], "en": "At that very moment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:14.1"], "en": "garments of silk, wool, linen,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:14.2"], "en": "and cotton will appear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:14.3", "PA_tha-ap_340:14.4"], "en": "A person shall obtain costly garments;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:15.1"], "en": "everything wished for by the mind [shall be attained].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:15.2", "PA_tha-ap_340:15.3", "PA_tha-ap_340:15.4"], "en": "A person who receives [this gift] will always experience the ripening of that single cloth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:16.1"], "en": "Thus, having gone forth later on,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:16.2"], "en": "urged on by the root of his wholesome merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:16.3"], "en": "[he went] to the Blessed One Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:16.4"], "en": "‘He will realize the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:17.1", "PA_tha-ap_340:17.2"], "en": "Oh, how well-performed is my deed for the All-Knowing Great Sage!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:17.3"], "en": "Having given a single garment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:17.4"], "en": "I have attained the deathless state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:18.1"], "en": "whether in a pavilion or at the foot of a tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:18.2"], "en": "Dwelling in an empty house,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:18.3", "PA_tha-ap_340:18.4"], "en": "she wears a garment of cloth that covers me all around for a fathom's length.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:19.1", "PA_tha-ap_340:19.2"], "en": "I wore my robe without it being formally offered, as did my requisites;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:19.3"], "en": "I was a recipient of food and drink.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:19.4"], "en": "This is the fruit of that upper garment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:20.1", "PA_tha-ap_340:20.2"], "en": "Of the deed I performed then, a hundred thousand aeons ago;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:20.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:20.4"], "en": "this is the fruit of giving cloth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:21.1"], "en": "The four analytical insights—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:21.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:21.3"], "en": "the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:22.1"], "en": "Thus indeed did the Venerable Elder Uttareyyadāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_340:23.1"], "en": "The legend of the Elder Uttareyyadāyaka is the eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
