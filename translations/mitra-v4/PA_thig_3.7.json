[
{"segs": ["PA_thig_3.7:0.1", "PA_thig_3.7:0.2", "PA_thig_3.7:0.3"], "en": "Therīgāthā 3.7 Tikanipāta Selātherīgāthā The Verses of the Elder Nun Selā, from the Third Chapter (Tikanipāta) of the *Therīgāthā* (Verses of the Elder Nuns).", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.7:1.1"], "en": "“There is no escape in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.7:1.2"], "en": "what will you achieve through seclusion?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.7:1.3"], "en": "Enjoy the pleasures of the senses.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.7:1.4"], "en": "Do not be one who regrets it later.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.7:2.1"], "en": "Sensual pleasures are like spears and spikes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.7:2.2"], "en": "hammering at the aggregates.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.7:2.3", "PA_thig_3.7:2.4"], "en": "That which you call \"delight in sensual pleasures\" is now for me \"displeasure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.7:3.1"], "en": "Everywhere, delight has been destroyed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.7:3.2"], "en": "The mass of delusion has been shattered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.7:3.3"], "en": "know this, O Evil One:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.7:3.4"], "en": "you are defeated, O Ender!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.7:4.1"], "en": "… The Elder Nun Selā …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
