[
{"segs": ["PA_iti_19:0.1"], "en": "Itivuttaka 19:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:0.2"], "en": "Ekakanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:0.3"], "en": "Second Chapter (Dutiyavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:0.4"], "en": "The Discourse on Concord in the Sangha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:1.1"], "en": "This was said by the Blessed One, said by the Arahant; thus have I heard:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:2.1"], "en": "\"Bhikkhus, one thing, when it arises in the world, arises for the welfare of many people, for the happiness of many people, for the benefit, welfare, and happiness of many people, including devas and humans.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:2.2"], "en": "What is that one thing?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:2.3"], "en": "Concord in the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:2.4"], "en": "When the Saṅgha is in concord, monks, there are no mutual quarrels, no mutual reviling, no mutual censuring, and no mutual rejection.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:2.5"], "en": "\"In this regard, those who lack faith gain confidence, and for those who already have confidence, there is further increase.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:2.6", "PA_iti_19:2.7"], "en": "Thus the Blessed One spoke. Concerning this, it is said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:3.1"], "en": "“Happy is concord in the Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:3.2"], "en": "and the support for those who are in concord;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:3.3"], "en": "one who delights in concord, established in the Dhamma,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:3.4"], "en": "He does not fall away from the security of yoga;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:3.5"], "en": "having made the Saṅgha harmonious,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:3.6"], "en": "he rejoices in heaven for an eon.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:4.1"], "en": "This matter too was spoken by the Blessed One; thus have I heard.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_19:4.2"], "en": "The ninth [discourse].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
