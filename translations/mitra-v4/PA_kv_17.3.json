[
{"segs": ["PA_kv_17.3:0.1", "PA_kv_17.3:0.2", "PA_kv_17.3:0.3"], "en": "Points of Controversy The Great Fifty The Seventeenth Chapter", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:0.4", "PA_kv_17.3:1.1"], "en": "The Discussion on Whether All This is Action: \"Is all this action?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:1.2"], "en": "Yes, it is.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:1.3"], "en": "Is action also called \"action\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:1.4"], "en": "One should not say so...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:1.5"], "en": "[and so on] ... Is all this \"action\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:1.6", "PA_kv_17.3:1.7"], "en": "“Yes. “Is all this caused by what was done in the past?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:1.8"], "en": "“One should not say so…” [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:1.9", "PA_kv_17.3:1.10"], "en": "Is all this karma? Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:1.11"], "en": "Is all this the result of karma (kamma-vipāka)?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:1.12", "PA_kv_17.3:2.1", "PA_kv_17.3:2.2"], "en": "It should not be said thus … [as before] … “All this is the result of kamma”? Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:2.3"], "en": "\"Does one kill a living being by way of the ripening of karma?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:2.4"], "en": "\"Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:2.5"], "en": "\"Is the taking of life accompanied by fruit?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:2.6"], "en": "“Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:2.7"], "en": "“Is the ripening of kamma possessed of fruit?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:2.8"], "en": "You should not say so … [and so on] …", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:2.9"], "en": "Is the ripening of karma fruitless?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:2.10", "PA_kv_17.3:2.11"], "en": "Yes. Is the taking of life fruitless? [Yes.]", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:2.12", "PA_kv_17.3:3.1", "PA_kv_17.3:3.2"], "en": "It should not be said thus… [as before] …one might take what is not given as a result of kamma-vipāka… one might speak falsehood… [as before].", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.3", "PA_kv_17.3:3.4", "PA_kv_17.3:3.5"], "en": "One might speak maliciously… one might speak harshly… one might engage in idle chatter…", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.6"], "en": "One might break into a house,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.7"], "en": "one might carry off plunder,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.8"], "en": "or one might commit burglary.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.9"], "en": "One might stand in ambush...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.10"], "en": "one might commit adultery...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.11"], "en": "one might commit a village raid...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.12"], "en": "One might commit the destruction of a city;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.13"], "en": "through the ripening of that karma, one might give a gift,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.14"], "en": "or one might give a robe.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.15"], "en": "\"Would one give almsfood...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.16"], "en": "would one give lodging...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.17"], "en": "would one give medicinal requisites for the sick?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.18"], "en": "“Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.19"], "en": "“Is the requisite of medicinal support for the sick fruitful?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.20"], "en": "“Yes.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.21"], "en": "Is the ripening of karma possessed of fruit?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.22"], "en": "One should not say so...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.23"], "en": "Is the ripening of karma without fruit?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.24"], "en": "“Yes,” you say.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.25"], "en": "“Is the requisite of medicine as a support for the sick fruitless?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:3.26"], "en": "You must not say so… [as before]… No, indeed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:4.1", "PA_kv_17.3:4.2"], "en": "Is it not to be said that \"all this is from karma\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:4.3"], "en": "Yes, it is.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:4.4"], "en": "Has it not been said by the Blessed One:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:5.1"], "en": "\"The world is led by karma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:5.2"], "en": "by karma the generation is led\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:5.3"], "en": "Beings are bound by their karma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:5.4"], "en": "like the linchpin of a moving chariot.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:6.1"], "en": "Through karma one gains fame and praise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:6.2"], "en": "“Since one knows through action [the consequences of] killing and binding—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:6.3"], "en": "having understood that action as the cause of differentiation—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:6.4"], "en": "why do you say that there is no action in the world?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:7.1", "PA_kv_17.3:7.2"], "en": "Is this indeed a sutta? Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:7.3"], "en": "Therefore, [it follows that] \"all this is from karma.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_17.3:7.4"], "en": "The entire discussion on the sequence of tasks is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"}
]
