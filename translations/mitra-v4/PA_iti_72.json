[
{"segs": ["PA_iti_72:0.1"], "en": "Itivuttaka 72:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:0.2", "PA_iti_72:0.3"], "en": "Tikanipāta, Tatiyavagga (The Third Chapter of the Group of Threes)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:0.4"], "en": "The Discourse on Escape.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:1.1"], "en": "Thus it was said by the Blessed One, said by the Arahant; so I have heard:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:2.1"], "en": "“Bhikkhus, there are these three elements of escape.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:2.2"], "en": "“What are the three?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:2.3", "PA_iti_72:2.4"], "en": "Renunciation is the escape from sensual pleasures; the formless is the escape from forms; and the cessation of whatever is become, conditioned, and dependently arisen is the escape from that—these, monks, are the three elements of escape.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:2.5"], "en": "The Blessed One spoke this matter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:2.6"], "en": "Regarding this, it is said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:3.1"], "en": "“Having understood the escape from sensual desires...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:3.2"], "en": "And by transcending forms,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:3.3", "PA_iti_72:3.4"], "en": "he who is always ardent touches the stilling of all formations.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:4.1"], "en": "That bhikkhu is indeed one who sees rightly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:4.2"], "en": "since he is liberated therein;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:4.3"], "en": "being peaceful, he has reached the culmination of direct knowledge.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:4.4"], "en": "“He is indeed a sage who has transcended all bonds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:5.1"], "en": "This matter was also spoken by the Blessed One; thus have I heard.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_72:5.2"], "en": "The third [sutta].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
