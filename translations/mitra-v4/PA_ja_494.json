[
{"segs": ["PA_ja_494:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:0.2"], "en": "Miscellaneous Section,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:0.3"], "en": "Chapter on the Rice Field of Śāli Rice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:0.4"], "en": "11. The Sādhina Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:1.1", "PA_ja_494:1.2"], "en": "“A truly wonderful thing has arisen in the world, causing the hair to stand on end!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:1.3", "PA_ja_494:1.4"], "en": "A divine chariot appeared for the illustrious King of Videha;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:2.1"], "en": "a son of the gods of great psychic power [was there].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:2.2"], "en": "Mātali, the charioteer of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:2.3"], "en": "invited the King of Videha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:2.4"], "en": "the ruler of Mithilā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:3.1"], "en": "“Mount this chariot,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:3.2"], "en": "O Disampati, best of kings;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:3.3"], "en": "the devas desire to see you.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:3.4"], "en": "The Thirty-three gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:3.5"], "en": "together with Indra, being mindful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:3.6"], "en": "indeed gather in the Sudhamma hall.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:4.1"], "en": "Then King Sādhu Vedeha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:4.2", "PA_ja_494:4.3"], "en": "ruler of Mithilā, mounted a chariot yoked with a thousand [horses].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:4.4"], "en": "He went into the presence of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:4.5", "PA_ja_494:4.6"], "en": "seeing that the king had arrived, the gods greeted him with joy.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:5.1"], "en": "“Welcome to you, Great King;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:5.2"], "en": "indeed, you have come from afar.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:5.3"], "en": "Now, O Lord of Kings, please be seated.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:5.4"], "en": "“...in the presence of the King of the Gods.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:6.1"], "en": "Sakka also responded,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:6.2"], "en": "[addressing] Vedeha, the seizer of Mithilā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:6.3", "PA_ja_494:6.4"], "en": "Vāsava invited him with sensual pleasures and a seat, saying:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:7.1"], "en": "\"It is well that you have arrived.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:7.2"], "en": "Dwelling in the realm of mastery,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:7.3"], "en": "you reign as king among the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:7.4"], "en": "where every desire is fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:7.5"], "en": "\"Among the Tāvatiṁsa devas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:7.6"], "en": "enjoy superhuman pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:8.1"], "en": "\"In the past, when I had gone to heaven, I delighted there.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:8.2"], "en": "Amidst dances, songs, and instrumental music,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:8.3"], "en": "I no longer find delight today in heaven;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:8.4"], "en": "has my lifespan indeed been exhausted, or is death now close at hand?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:8.5"], "en": "\"Or am I deluded, O best of lords of men?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:9.1"], "en": "\"Your life is not yet exhausted and death is far off;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:9.2"], "en": "nor, O best of heroes among men, are you deluded.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:9.3"], "en": "And your merits are but meager,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:9.4"], "en": "the fruit of which you are now experiencing here; therefore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:10.1"], "en": "dwell by the power of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:10.2"], "en": "O best of kings, Disampati:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:10.3", "PA_ja_494:10.4"], "en": "enjoy superhuman pleasures among the gods of the Thirty-three!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:11.1"], "en": "Just as a borrowed vehicle,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:11.2"], "en": "just as borrowed wealth—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:11.3"], "en": "so too is this attainment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:11.4"], "en": "That which comes from others by way of a gift:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:12.1"], "en": "I do not desire this,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:12.2"], "en": "that it should come from others by way of a gift.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:12.3", "PA_ja_494:12.4"], "en": "The merits I have performed myself— this is my unique wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:13.1"], "en": "Having gone among human beings, I...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:13.2", "PA_ja_494:13.3"], "en": "I shall perform much wholesome merit through generosity, righteous conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:13.4"], "en": "self-restraint, and self-mastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:13.5", "PA_ja_494:13.6"], "en": "Having done which one becomes happy and does not regret it later—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:14.1"], "en": "these are those fields.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:14.2"], "en": "This is the coin with beautiful earrings;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:14.3"], "en": "these are the lush marshlands,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:14.4"], "en": "and these are the flowing rivers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:15.1"], "en": "These are those delightful lotus ponds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:15.2", "PA_ja_494:15.3"], "en": "resounding with the cries of ruddy geese and covered with mandārava flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:15.4"], "en": "And with lotuses and water-lilies;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:15.5"], "en": "those for whom these were cherished—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:15.6"], "en": "where indeed have they gone?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:16.1"], "en": "Those fields here, that plot of land,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:16.2"], "en": "those very groves and forest precincts—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:16.3"], "en": "without seeing even that same people of mine, I [remain].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:16.4"], "en": "“The quarters appear empty to me, O Nārada.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:17.1", "PA_ja_494:17.2"], "en": "“I have seen celestial mansions illuminating the four directions;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:17.3", "PA_ja_494:17.4"], "en": "In the presence of the king of the gods and in the presence of the Thirty-three,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:18.1"], "en": "my divine abode was inhabited by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:18.2", "PA_ja_494:18.3"], "en": "They have enjoyed superhuman pleasures among the Tāvatiṃsa gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:18.4"], "en": "where every desire is fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:19.1"], "en": "Thus, having abandoned such things,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:19.2"], "en": "I have come here for the sake of merit;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:19.3"], "en": "I shall practice the Dhamma alone.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:19.4"], "en": "I have no need for kingship;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:20.1"], "en": "I seek the path free from punishment,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:20.2"], "en": "as taught by the Perfectly Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:20.3", "PA_ja_494:20.4"], "en": "“I shall enter upon that path by which those of noble vows go.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_494:21.1"], "en": "Thus ends the Sādhina Jātaka, the eleventh.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
