[
{"segs": ["PA_ja_270:0.1"], "en": "Jātaka Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:0.2", "PA_ja_270:0.3"], "en": "Padumavagga (The Chapter on the Lotus)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:0.4"], "en": "10. The Ulūka Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:1.1", "PA_ja_270:1.2"], "en": "“It seems that by all his kinsmen, Kosika was made their lord.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:1.3"], "en": "“If you have been permitted by your kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:1.4"], "en": "I shall speak a single word.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:2.1"], "en": "“Speak, friend, for I am permitted.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:2.2"], "en": "The goal and the Dhamma in its entirety—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:2.3", "PA_ja_270:2.4"], "en": "for there are indeed young birds who are wise and radiant with splendor.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:3.1"], "en": "“I do not approve, may you be blessed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:3.2"], "en": "of this consecration of the owl;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:3.3"], "en": "look at the face of one who is unangered.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:3.4"], "en": "“How will one who is angry act?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:4.1"], "en": "Thus ends the tenth story, the Owl Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:4.2"], "en": "This is the second chapter, the Lotus Chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:5.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:6.1"], "en": "Padumuttara, Nāgasiri by name,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:6.2"], "en": "Sa-mahaṇṇava, Yūpa, and Khurappavara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:6.3"], "en": "Then Bhaddālī, like an elephant among trees,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_270:6.4"], "en": "was bitten by the chief of owls with harsh words.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
