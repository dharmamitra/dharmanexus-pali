[
{"segs": ["PA_ja_406:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:0.2"], "en": "The Section of Sevens,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:0.3"], "en": "Chapter on Gandhāra", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:0.4"], "en": "1. The Gandhāra Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:1.1", "PA_ja_406:1.2"], "en": "\"Having abandoned sixteen full thousands of villages...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:1.3"], "en": "\"The storehouses are full;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:1.4"], "en": "now you are making a hoard.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:2.1"], "en": "\"Having abandoned the realm of Gandhāra,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:2.2"], "en": "Having possessed abundant wealth and grain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:2.3", "PA_ja_406:2.4"], "en": "you have now emerged from your rule to govern here.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:3.1"], "en": "“I speak the Dhamma, O Videhan;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:3.2"], "en": "unrighteousness does not please me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:3.3"], "en": "As I speak the Dhamma, [may there be no harm].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:3.4"], "en": "“Evil does not smear him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:4.1", "PA_ja_406:4.2"], "en": "“In whatever way another person may find cause for irritation;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:4.3"], "en": "“Even if it were of great benefit,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:4.4"], "en": "the wise person would not speak such a word.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:5.1"], "en": "Whether it be crushed or not, let it be.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:5.2"], "en": "Let it be scattered like chaff;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:5.3"], "en": "when I speak the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:5.4"], "en": "no evil shall cling to me.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:6.1", "PA_ja_406:6.2"], "en": "If one possesses neither innate wisdom nor well-trained discipline,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:6.3"], "en": "one is like a blind buffalo in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:6.4"], "en": "Many people would practice [rightly].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:7.1", "PA_ja_406:7.2"], "en": "And because some here have been well-trained in the teacher's way,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:7.3", "PA_ja_406:7.4"], "en": "\"Therefore, those who have trained in the discipline wander about with minds well-composed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_406:8.1"], "en": "Thus ends the first Jātaka, the Gandhāra Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
