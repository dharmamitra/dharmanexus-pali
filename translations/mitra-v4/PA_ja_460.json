[
{"segs": ["PA_ja_460:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:0.2", "PA_ja_460:0.3"], "en": "The Section of Eleven, Chapter on the Supporter of His Mother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:0.4"], "en": "6. The Yudhañjayajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:1.1", "PA_ja_460:1.2"], "en": "“I pay homage to that bull among charioteers, who was surrounded by friends and kinsmen.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:1.3"], "en": "“I shall go forth, O King;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:1.4"], "en": "may Your Majesty grant me permission.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:2.1"], "en": "“If there is anything lacking for you in sensual pleasures...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:2.2"], "en": "I shall fulfill your [desire];", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:2.3"], "en": "whoever harms you, I will restrain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:2.4"], "en": "Do not go forth into homelessness; remain here, O Yudhañjaya!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:3.1"], "en": "“I have no lack of sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:3.2"], "en": "nor is there anyone who harms me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:3.3"], "en": "yet I wish to make an island.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:3.4"], "en": "That which old age does not overwhelm.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:4.1"], "en": "“A son might beg from his father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:4.2"], "en": "or a father from his own legitimate son;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:4.3"], "en": "“Negama, my dear, beg him [to stay];", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:4.4"], "en": "do not let him go forth, Yudhañjaya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:5.1"], "en": "“Do not stop me, O King;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:5.2"], "en": "O bull among chariot-warriors, as he was going forth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:5.3"], "en": "[he thought]: \"May I not, being intoxicated by sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:5.4"], "en": "fall under the power of old age.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:6.1"], "en": "“I beg you, dear father, I beg you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:6.2"], "en": "my son, do not stop me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:6.3"], "en": "I wish to see him for a long time.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:6.4"], "en": "\"Do not go forth, Yudhañjaya!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:7.1", "PA_ja_460:7.2"], "en": "Like dew upon the tip of a blade of grass at the rising of the sun,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:7.3"], "en": "“Such is the lifespan of humans;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:7.4"], "en": "do not stop me, mother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:8.1"], "en": "“Hastening toward this vehicle...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:8.2"], "en": "\"O Bull among Charioteers, please drive on;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:8.3", "PA_ja_460:8.4"], "en": "let not my mother become an obstacle to me as I cross over.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:9.1"], "en": "“Run away, O venerable sirs!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:9.2"], "en": "Rammarka will become empty;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:9.3"], "en": "for this battle has been permitted.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:9.4"], "en": "By King Sabbadatta:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:10.1"], "en": "\"He who is the best of a thousand,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:10.2"], "en": "a youth with a complexion like gold— \"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:10.3"], "en": "“This prince has gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:10.4"], "en": "strong and clad in saffron robes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:11.1"], "en": "“Both princes have gone forth.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:11.2"], "en": "Yudhañcayo Yudhiṭṭhila,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:11.3"], "en": "having abandoned his mother and father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:11.4"], "en": "cut through the attachment to death.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_460:12.1"], "en": "The Yudhañcayajātaka, the sixth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
