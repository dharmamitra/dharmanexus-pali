[
{"segs": ["PA_thag_5.4:0.1", "PA_thag_5.4:0.2", "PA_thag_5.4:0.3"], "en": "Theragāthā 5.4 Pañcaka-nipāta First Chapter (Paṭhamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:0.4"], "en": "The Verse of the Elder Sumanā:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:1.1", "PA_thag_5.4:1.2"], "en": "“That which my preceptor, while desiring for me, encouraged me toward the teachings;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:1.3", "PA_thag_5.4:1.4"], "en": "For me who longed for the Deathless, what was to be done has been done.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:2.1"], "en": "It has been reached and realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:2.2"], "en": "This Dhamma is not subject to dispute;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:2.3"], "en": "with purified knowledge and free from doubt,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:2.4"], "en": "I declare it in your presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:3.1"], "en": "I know my former births,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:3.2"], "en": "the divine eye is purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:3.3"], "en": "the goal for myself has been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:3.4"], "en": "Thus was the Buddha’s teaching proclaimed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:4.1"], "en": "My training has been heard well from you, O diligent one,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:4.2"], "en": "in your dispensation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:4.3"], "en": "All my taints are exhausted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:4.4"], "en": "there is now no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:5.1"], "en": "The Noble One has instructed me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:5.2"], "en": "Out of compassion you have helped me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:5.3"], "en": "your instruction has not been in vain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:5.4"], "en": "for it has been learned by your resident pupil.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.4:5.5"], "en": "… the Elder Sumana …", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
