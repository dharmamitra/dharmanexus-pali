[
{"segs": ["PA_ja_415:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:0.2"], "en": "The Section of Sevens,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:0.3"], "en": "Chapter on Gandhāra.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:0.4"], "en": "10. The Kummāsapiṇḍa Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:1.1", "PA_ja_415:1.2"], "en": "“Indeed, there is no service rendered to the Buddhas, those of peerless vision, that is too small.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:1.3", "PA_ja_415:1.4"], "en": "Of dried, saltless *passa* fruit and balls of *kummāsa* porridge;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:2.1"], "en": "these many elephants, cattle, and horses—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:2.2"], "en": "Wealth, grain, and the entire earth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:2.3"], "en": "and these women who resemble celestial nymphs—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:2.4"], "en": "behold the fruit of that ball of boiled rice!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:3.1"], "en": "“O elephant among kings, Lord of Kosala,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:3.2"], "en": "you speak verses constantly;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:3.3"], "en": "I ask you, O increaser of the realm:”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:3.4"], "en": "“You speak with such intense joy! [The Buddha replied:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:4.1", "PA_ja_415:4.2"], "en": "“In this very city, I was born into a certain family;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:4.3", "PA_ja_415:4.4"], "en": "I was a hired laborer, supported by wages and restrained by virtue;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:5.1"], "en": "as I was going out for work, I thought:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:5.2"], "en": "I saw four ascetics,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:5.3"], "en": "endowed with conduct and virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:5.4"], "en": "become cool and free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:6.1"], "en": "Having gladdened my mind toward them,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:6.2", "PA_ja_415:6.3"], "en": "I sat upon a mat of leaves and gave the monks the rice-mash.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:6.4"], "en": "With my own hands, full of faith,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:7.1"], "en": "I performed that wholesome deed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:7.2"], "en": "this is the fruit of such merit for me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:7.3"], "en": "“I enjoy this kingdom,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:7.4"], "en": "this most excellent and prosperous earth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:8.1"], "en": "“Give and enjoy it, and do not be negligent.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:8.2"], "en": "Turn the wheel, O Lord of Kosala;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:8.3"], "en": "let not the King be unrighteous,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:8.4"], "en": "but protect the Dhamma, O Lord of Kosala.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:9.1", "PA_ja_415:9.2"], "en": "“O beautiful one, I shall practice that very same path again and again;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:9.3"], "en": "it is the conduct of the Noble Ones, O Sukosala.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:9.4"], "en": "The Arahants are pleasing for me to behold.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:10.1"], "en": "Like a goddess, with the form of an apsarā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:10.2"], "en": "you shine in the midst of this company of women.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:10.3"], "en": "\"What auspicious deed did you perform,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:10.4"], "en": "by what means have you become so beautiful, O Sukosala?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:11.1"], "en": "\"O Kshatriya of the Ambattha clan,\" she replied.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:11.2"], "en": "I was a maidservant, bound by the service of others;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:11.3"], "en": "yet I was self-restrained, living according to the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:11.4"], "en": "virtuous, and possessed of blameless vision.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:12.1", "PA_ja_415:12.2", "PA_ja_415:12.3"], "en": "At that time, being wealthy and joyful myself, I gave a meal to a wandering bhikkhu.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:12.4"], "en": "“Such is the fruit of that deed for me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_415:13.1"], "en": "The *Kuṃmāsapiṇḍi Jātaka*, the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
