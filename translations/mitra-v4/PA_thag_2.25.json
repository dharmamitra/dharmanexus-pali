{"segs": ["PA_thag_2.25:0.1"], "en": "Theragāthā 2.25 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.25:0.2", "PA_thag_2.25:0.3"], "en": "Tatiyavagga (The Third Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.25:0.4"], "en": "Vītasoka Thera’s Verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.25:1.1"], "en": "“They will shave my hair;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.25:1.2"], "en": "the barber has approached me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.25:1.3"], "en": "Then, taking up a mirror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.25:1.4", "PA_thag_2.25:2.1"], "en": "I examined my body; the body appeared empty and devoid of substance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.25:2.2"], "en": "The darkness and gloom have vanished;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.25:2.3"], "en": "all the fetters are severed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.25:2.4"], "en": "now there is no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.25:2.5"], "en": "… The Elder Vītaśoka …", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
