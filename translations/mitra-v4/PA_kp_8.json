[
{"segs": ["PA_kp_8:0.1"], "en": "Khuddakapāṭha 8:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:0.2", "PA_kp_8:1.1"], "en": "Nidhikaṇḍasutta A person deposits a treasure-trove;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:1.2"], "en": "Whether it be deep or reaching only to the water's edge,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:1.3"], "en": "when a need or purpose arises,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:1.4"], "en": "it will be for my benefit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:2.1"], "en": "Whether for release from harsh treatment by a king,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:2.2"], "en": "or from being oppressed by thieves,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:2.3"], "en": "or for the sake of liberation from debt, [one may take what is not given].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:2.4"], "en": "In times of famine or during calamities—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:2.5", "PA_kp_8:2.6"], "en": "for this purpose indeed is a treasure stored up in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:3.1", "PA_kp_8:3.2"], "en": "Though one may be thus established in a deep pool reaching to the water's edge,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:3.3"], "en": "not everyone is [so] at all times.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:3.4"], "en": "That serves him well:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:4.1"], "en": "either his treasure shifts from its place,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:4.2"], "en": "or his mindfulness fails him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:4.3"], "en": "Either nāgas carry it away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:4.4"], "en": "or yakkhas take it;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:5.1"], "en": "or even unwelcome heirs [claim it].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:5.2"], "en": "They carry it away while one looks on;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:5.3"], "en": "when the merit is exhausted,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:5.4"], "en": "all of this perishes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:6.1"], "en": "For one who, through generosity, virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:6.2"], "en": "self-restraint, and self-mastery,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:6.3"], "en": "has well-deposited a treasure,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:6.4"], "en": "To a woman or a man;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:7.1"], "en": "or to a cetiya, or to the Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:7.2"], "en": "or to an individual, or to guests.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:7.3"], "en": "In one's mother, in one's father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:7.4"], "en": "and likewise in one's eldest brother—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:8.1"], "en": "this is a treasure well-stored.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:8.2"], "en": "Invincible and following after,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:8.3"], "en": "having abandoned what must be left behind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:8.4"], "en": "one goes taking this along.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:9.1", "PA_kp_8:9.2"], "en": "A treasure not shared with others, which no thief can steal—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:9.3"], "en": "the wise person should therefore perform meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:9.4", "PA_kp_8:10.1", "PA_kp_8:10.2"], "en": "This treasure that follows one wherever one goes is a treasure that grants all desires for both gods and humans.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:10.3"], "en": "Whatever they aspire to,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:10.4"], "en": "all that is obtained by means of this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:11.1"], "en": "beauty of form, beauty of voice, and so forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:11.2"], "en": "A well-proportioned form and beauty,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:11.3"], "en": "sovereignty, and a retinue—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:11.4"], "en": "all this is obtained by means of this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:12.1"], "en": "Local sovereignty and power,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:12.2"], "en": "the beloved happiness of a wheel-turning monarch,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:12.3"], "en": "and even the kingship of the gods among the celestial realms—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:12.4"], "en": "By this all is obtained:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:13.1", "PA_kp_8:13.2"], "en": "human prosperity and whatever delight exists in the world of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:13.3"], "en": "And whatever attainment of Nibbāna there is—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:13.4"], "en": "all that is obtained by means of this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:14.1"], "en": "by relying upon the excellence of friendship.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:14.2"], "en": "For one who applies themselves with proper method,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:14.3"], "en": "mastery over true knowledge and liberation—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:14.4"], "en": "all this is obtained by means of this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:15.1"], "en": "The analytical knowledges and the liberations,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:15.2"], "en": "the perfections of the disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:15.3"], "en": "the enlightenment of the paccekabuddhas, and the stage of a Buddha—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:15.4"], "en": "All this is obtained by means of this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:16.1", "PA_kp_8:16.2"], "en": "thus is this attainment of merit of great benefit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:16.3", "PA_kp_8:16.4"], "en": "Therefore, the wise and the learned praise the state of having performed meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kp_8:17.1"], "en": "Thus ends the Nidhikaṇḍa Sutta.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
