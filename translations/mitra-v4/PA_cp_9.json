[
{"segs": ["PA_cp_9:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:0.2"], "en": "Akittivagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:0.3"], "en": "Dānapāramī 9", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:0.4"], "en": "The Vessantara Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:1.1"], "en": "\"She who was my mother,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:1.2"], "en": "a noblewoman named Phussatī;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:1.3"], "en": "In past births,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:1.4"], "en": "she was the beloved chief queen of Sakka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:2.1"], "en": "Knowing that her life had reached its end,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:2.2"], "en": "The Lord of Devas spoke this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:2.3"], "en": "“I grant you ten boons,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:2.4"], "en": "O most excellent lady, whatever you desire.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:3.1"], "en": "When she had been addressed thus,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:3.2"], "en": "the goddess spoke again to Sakka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:3.3"], "en": "\"What offense have I committed?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:3.4"], "en": "\"Am I not dear to you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:3.5"], "en": "Why do you drive me from this delightful place,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:3.6"], "en": "like the wind uproots a tree?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:4.1", "PA_cp_9:4.2"], "en": "When he had been addressed thus, Sakka spoke this to him again:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:4.3"], "en": "“No evil has been committed by you.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:4.4"], "en": "And you are not unloved by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:5.1"], "en": "Your life span is only this much;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:5.2"], "en": "the time for your passing away will come.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:5.3", "PA_cp_9:5.4"], "en": "“Accept these ten most excellent boons given by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:6.1"], "en": "Thus she was granted boons by Sakka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:6.2"], "en": "Joyful, delighted, and overjoyed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:6.3", "PA_cp_9:6.4"], "en": "Phussatī, the most excellent of women, chose ten boons, making me her innermost wish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:7.1"], "en": "Then, having passed away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:7.2", "PA_cp_9:7.3"], "en": "that Phussatī was reborn among the kṣatriyas in the city of Jetuttara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:7.4"], "en": "I met with Sañjaya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:8.1", "PA_cp_9:8.2"], "en": "When I had descended into the womb of my beloved mother Phussatī...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:8.3", "PA_cp_9:8.4"], "en": "By my power, my mother was always devoted to giving to the poor,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:9.1"], "en": "the afflicted, and the aged.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:9.2"], "en": "To beggars and travelers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:9.3"], "en": "to ascetics and brahmins who have exhausted their defilements—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:9.4"], "en": "those who possess nothing— he gives gifts.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:10.1"], "en": "Having carried [the child] for ten months,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:10.2"], "en": "while performing a circumambulation of the city,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:10.3"], "en": "[she was delivered] in the middle of the merchants' street.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:10.4"], "en": "Phussatī conceived me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:11.1"], "en": "My name is not derived from my mother’s side,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:11.2"], "en": "nor is it born of my father’s lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:11.3"], "en": "Because I was born here in Vessavīthī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:11.4"], "en": "therefore I was named Vessantara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:12.1"], "en": "When I was a young boy—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:12.2"], "en": "Eight years from my birth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:12.3"], "en": "while sitting in the palace,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:12.4"], "en": "I then thought of giving a gift.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:13.1"], "en": "“I would give my heart, my eye,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:13.2"], "en": "my very flesh and blood; having summoned [him],", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:13.3"], "en": "I would give even my body.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:13.4"], "en": "If anyone should beg from me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:14.1"], "en": "reflecting upon my own true nature—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:14.2"], "en": "unshakable and unestablished— ;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:14.3"], "en": "There the earth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:14.4"], "en": "with Sineru as its forest-ornament,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:15.1"], "en": "trembled on the fifteenth day of every half-month.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:15.2"], "en": "On the full-moon Uposatha day,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:15.3"], "en": "having mounted the elephant Paccaya,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:15.4"], "en": "I approached to give a gift.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:16.1", "PA_cp_9:16.2"], "en": "Brāhmaṇas from the territory of the Kaliṅga kingdom approached me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:16.3"], "en": "they begged me for a noble elephant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:16.4"], "en": "Grain is considered a blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:17.1"], "en": "\"The country is without rain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:17.2"], "en": "there is famine, and great hunger.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:17.3", "PA_cp_9:17.4"], "en": "\"Give me the preeminent elephant, the all-white, supreme among tuskers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:18.1"], "en": "\"I give him; I do not waver.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:18.2"], "en": "Whatever the brahmins ask of me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:18.3"], "en": "I do not withhold it from them;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:18.4"], "en": "my mind delights in giving.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:19.1", "PA_cp_9:19.2"], "en": "When a supplicant has approached me, a refusal is not fitting;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:19.3"], "en": "let not my commitment be broken.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:19.4"], "en": "\"I shall give a vast elephant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:20.1", "PA_cp_9:20.2"], "en": "Having seized the nāga by its trunk with jeweled jars, [he said:]", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:20.3"], "en": "Having sprinkled water upon my hand,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:20.4"], "en": "I gave this elephant to the brahmins.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:21.1"], "en": "Furthermore, as I was giving it away, [the earth shook].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:21.2"], "en": "That supreme elephant was entirely white;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:21.3", "PA_cp_9:21.4"], "en": "even then, the earth, adorned with Mount Sineru and its forests, trembled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:22.1"], "en": "Because of that elephant’s gift,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:22.2", "PA_cp_9:22.3"], "en": "the Śivis gathered in anger and banished him from their kingdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:22.4"], "en": "\"Let it go to Vaṅka Mountain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:23.1"], "en": "As they were casting it out,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:23.2"], "en": "it remained unshaken and unswayed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:23.3"], "en": "To perform a great act of giving,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:23.4"], "en": "I requested one boon;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:24.1"], "en": "all the Śivas were thus entreated.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:24.2"], "en": "They granted me one boon;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:24.3"], "en": "having had the kanna-bherī drum sounded,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:24.4"], "en": "I gave a great gift.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:25.1", "PA_cp_9:25.2"], "en": "Then a great, tumultuous, and terrifying sound arose here;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:25.3"], "en": "they are carrying him out with gifts.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:25.4"], "en": "Furthermore, this one gives gifts:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:26.1"], "en": "having given elephants, horses, and chariots,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:26.2"], "en": "as well as female and male slaves, cattle, and wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:26.3"], "en": "Having given a great gift,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:26.4"], "en": "I then departed from the city.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:27.1"], "en": "Having departed from the city, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:27.2"], "en": "When he turned back and looked,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:27.3", "PA_cp_9:27.4"], "en": "even then the earth, with Sineru as its forest-diadem, trembled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:28.1"], "en": "Having given a chariot drawn by four horses,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:28.2"], "en": "and standing at the crossroads,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:28.3"], "en": "alone and without a second, he departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:28.4"], "en": "I said this to Queen Maddī:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:29.1"], "en": "“Maddī, you take Kanhā;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:29.2"], "en": "she is the younger sister and light in weight.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:29.3"], "en": "\"I shall seize Jāli,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:29.4"], "en": "for that brother of mine is powerful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:30.1"], "en": "Like a red or white lotus, [he was like a fire].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:30.2"], "en": "Maddī took hold of the black antelope skin;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:30.3"], "en": "I, like a golden image,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:30.4"], "en": "took hold of Prince Jāli.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:31.1"], "en": "Noble-born and delicate,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:31.2", "PA_cp_9:31.3"], "en": "these four kṣatriya men tread upon the uneven as if it were level.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:31.4"], "en": "We are going to Mount Vaṅka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:32.1"], "en": "Whatever people come along the path or on the opposite track,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:32.2"], "en": "[we shall meet them].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:32.3"], "en": "While searching, we asked,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:32.4"], "en": "“Where is Vaṅkantapabbata?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:33.1"], "en": "When they saw us there, they said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:33.2"], "en": "They uttered compassionate words;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:33.3", "PA_cp_9:33.4"], "en": "from afar, from Vaṅkanta Mountain, they announced the end of suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:34.1", "PA_cp_9:34.2"], "en": "If children see fruit-bearing trees in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:34.3"], "en": "they [seek] the cause of those fruits.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:34.4"], "en": "The children cry out;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:35.1"], "en": "seeing the children weeping,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:35.2"], "en": "the vast trees rise up in agitation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:35.3"], "en": "Bending down of their own accord,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:35.4"], "en": "they approach the children.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:36.1"], "en": "Having seen this marvel,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:36.2"], "en": "A miracle, hair-raising and wonderful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:36.3"], "en": "Maddī— beautiful in every limb—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:36.4"], "en": "uttered a cry of \"Well done!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:37.1"], "en": "Truly a marvel in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:37.2"], "en": "a wonder that makes the hair stand on end,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:37.3"], "en": "through the majesty of Vessantara!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:37.4"], "en": "The trees bent down of their own accord.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:38.1", "PA_cp_9:38.2"], "en": "Out of compassion for the children, the yakkhas shortened the path.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:38.3"], "en": "On the very day they departed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:38.4", "PA_cp_9:39.1"], "en": "sixty thousand kings arrived at Cetaraṭṭha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:39.2"], "en": "Then they all went to dwell with their maternal uncle;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:39.3"], "en": "having joined their palms in reverence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:39.4"], "en": "they approached him weeping.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:40.1", "PA_cp_9:40.2"], "en": "Having conversed there with those sons of merchants,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:40.3"], "en": "they departed from that place.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:40.4"], "en": "He went to Mount Vaṅka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:41.1"], "en": "Having summoned the lord of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:41.2"], "en": "Vissakamma of great psychic power, he said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:41.3", "PA_cp_9:41.4"], "en": "\"Construct a well-made, delightful hermitage and build a leaf-hut.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:42.1"], "en": "Having heard Sakka's words, [he did so].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:42.2"], "en": "Vissakamma, possessed of great psychic power,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:42.3", "PA_cp_9:42.4"], "en": "constructed a delightful hermitage and completed a well-built leaf-hut.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:43.1"], "en": "Having entered the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:43.2"], "en": "quiet and undisturbed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:43.3"], "en": "we four people were there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:43.4"], "en": "We dwell within the mountains.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:44.1"], "en": "Both I and Queen Maddi,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:44.2"], "en": "as well as Jālī and Kaṇhājinā— both of us.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:44.3"], "en": "Dispelling each other's grief,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:44.4"], "en": "we lived then in that hermitage,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:45.1"], "en": "protecting the children.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:45.2"], "en": "I remained alone in the hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:45.3"], "en": "Maddī, having brought fruit,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:45.4"], "en": "sustained those three people.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:46.1"], "en": "While I was living in Pava,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:46.2", "PA_cp_9:46.3"], "en": "a traveler approached me and requested my two children.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:46.4", "PA_cp_9:47.1"], "en": "Seeing Jāli, Kanhājinā, and both of them as they approached as supplicants,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:47.2"], "en": "joy arose within me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:47.3"], "en": "Having taken both sons,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:47.4"], "en": "I then gave them to the brahmin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:48.1"], "en": "As I was relinquishing my own sons, [the earth shook].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:48.2"], "en": "When Jūjaka the brahmin [was seized],", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:48.3"], "en": "then too the earth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:48.4"], "en": "with Sineru as its forest-diadem, trembled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:49.1"], "en": "Then Sakka descended once more,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:49.2"], "en": "appearing in the likeness of a brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:49.3"], "en": "and entreated me for Queen Maddi.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:49.4", "PA_cp_9:50.1"], "en": "Taking Maddī by the hand— she who was virtuous and devoted—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:50.2"], "en": "and filling his cupped hands with water;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:50.3", "PA_cp_9:50.4"], "en": "With a mind full of serene confidence, I gave Maddī to him;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:51.1"], "en": "while Maddī was being given away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:51.2"], "en": "The gods in the sky were filled with joy;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:51.3", "PA_cp_9:51.4"], "en": "even then, the earth, with Sineru as its forest-diadem, trembled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:52.1"], "en": "While renouncing my daughter Jālī, clad in black antelope skin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:52.2", "PA_cp_9:52.3"], "en": "and my devoted queen Maddi, I did not worry.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:52.4"], "en": "It was solely for the sake of enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:53.1"], "en": "Neither my two sons were to be given away by me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:53.2"], "en": "nor was Queen Maddī to be given away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:53.3"], "en": "Omniscience is dear to me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:53.4"], "en": "therefore, I gave what was dear.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:54.1"], "en": "Furthermore, in the vast forest...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:54.2"], "en": "In the gathering of mother and father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:54.3"], "en": "they lament with compassion,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:54.4"], "en": "conversing about pleasure and pain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:55.1"], "en": "With a heavy heart, out of a sense of shame and dread of wrongdoing,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:55.2"], "en": "he approached both of them;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:55.3"], "en": "even then, the earth trembled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:55.4"], "en": "The crest-jewels of the Sineru world-system.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:56.1", "PA_cp_9:56.2"], "en": "Furthermore, having departed from the great forest together with their kinsmen, they—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:56.3"], "en": "I enter the delightful city,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:56.4"], "en": "Jetuttara, the supreme among cities;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:57.1"], "en": "the seven treasures have rained down.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:57.2"], "en": "A great cloud rained down;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:57.3", "PA_cp_9:57.4"], "en": "even then, the earth, with Sineru as its forest-diadem, trembled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:58.1"], "en": "This earth is insentient,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:58.2"], "en": "it does not perceive pleasure or pain; yet even she,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:58.3"], "en": "by the power of my gift, [shall tremble].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:58.4"], "en": "It shook seven times.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_9:59.1"], "en": "Thus ends the ninth chapter, the Vessantara Cariyā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
