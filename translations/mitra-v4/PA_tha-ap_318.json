[
{"segs": ["PA_tha-ap_318:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:0.2"], "en": "Ārakkhadāyakavagga 6,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:0.3"], "en": "The Apadāna of the Elder Āsanasanthavika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:1.1"], "en": "“The supreme shrine named Uttama belongs to Sikhin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:1.2"], "en": "the Kinsman of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:1.3"], "en": "in a desolate forest in the wilderness.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:1.4"], "en": "I was wandering about blind at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:2.1"], "en": "As the wind blew out,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:2.2"], "en": "the lion throne was seen by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:2.3"], "en": "Placing my joined palms together in reverence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:2.4"], "en": "I praised the Leader of the World;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:3.1"], "en": "having praised him for a portion of the day, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:3.2"], "en": "To the Buddha, the leader supreme in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:3.3"], "en": "joyful with a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:3.4"], "en": "I uttered these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:4.1"], "en": "\"Homage to you, O noble steed among men!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:4.2"], "en": "Homage to you, O supreme among men!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:4.3"], "en": "You are omniscient, O Great Hero.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:4.4"], "en": "\"O Elder of the World, Bull among Men!\"—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:5.1", "PA_tha-ap_318:5.2"], "en": "having thus praised Sikhi by means of a prophetic sign, I...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:5.3"], "en": "Having paid homage to the seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:5.4"], "en": "I departed facing north.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:6.1"], "en": "Thirty-one eons ago from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:6.2"], "en": "Because I praised the best of speakers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:6.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:6.4"], "en": "this is the fruit of that eulogy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:7.1"], "en": "In the twenty-seventh aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:7.2"], "en": "there were seven incomparable ones;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:7.3"], "en": "they were endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:7.4"], "en": "Universal monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:8.1", "PA_tha-ap_318:8.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:8.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:9.1"], "en": "In this way, it is said, the venerable elder Āsanasanthavika recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_318:10.1"], "en": "This is the sixth legend of the elder Āsanasanthavika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
