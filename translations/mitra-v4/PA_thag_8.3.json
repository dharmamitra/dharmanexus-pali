[
{"segs": ["PA_thag_8.3:0.1", "PA_thag_8.3:0.2", "PA_thag_8.3:0.3"], "en": "Theragāthā 8.3 Aṭṭhaka-nipāta Paṭhama-vagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:0.4"], "en": "The Verses of the Elder Mahāpanthaka:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:1.1"], "en": "“When I first beheld the Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:1.2"], "en": "who is fearless from every quarter;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:1.3", "PA_thag_8.3:1.4", "PA_thag_8.3:2.1"], "en": "Then, having beheld that Supreme Person, a sense of spiritual urgency arose within me as I saw his glory in his hands and feet.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:2.2"], "en": "He who would drive away one who has come—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:2.3"], "en": "having propitiated such a teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:2.4"], "en": "he would then bring him to ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:3.1"], "en": "Then I abandoned my children and wife,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:3.2"], "en": "as well as my wealth and grain;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:3.3"], "en": "having shaved off my hair and beard, I went forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:3.4"], "en": "I went forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:4.1"], "en": "Endowed with training and right livelihood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:4.2"], "en": "well-restrained in the sense faculties;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:4.3"], "en": "Paying homage to the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:4.4"], "en": "I dwelt undefeated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:5.1"], "en": "Then this aspiration arose in me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:5.2"], "en": "Longed for by the mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:5.3", "PA_thag_8.3:5.4"], "en": "one should not sit down even for a moment as long as the arrow of craving has not been extracted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:6.1"], "en": "As I was dwelling thus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:6.2"], "en": "behold my exertion of energy:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:6.3"], "en": "the three knowledges have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:6.4"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:7.1"], "en": "I know my former births,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:7.2"], "en": "and the divine eye has been purified.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:7.3"], "en": "I am an arahant worthy of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:7.4"], "en": "utterly liberated and free from acquisitions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:8.1"], "en": "Then, at the end of that night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:8.2"], "en": "Facing the rising of the sun,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:8.3"], "en": "having dried up all craving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:8.4"], "en": "he sat down cross-legged.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:8.5", "PA_thag_8.3:8.6"], "en": "… The Elder Mahāpanthaka … The Eighth Chapter is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:9.0"], "en": "Herein is the summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:9.1"], "en": "The Elder Mahākaccāyana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:9.2"], "en": "Sirimitta, and Mahāpanthaka—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:9.3"], "en": "these [are the teachers] in the Eighth Chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.3:9.4"], "en": "\"Twenty-four stanzas.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
