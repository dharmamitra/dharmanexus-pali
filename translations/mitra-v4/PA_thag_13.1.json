[
{"segs": ["PA_thag_13.1:0.1", "PA_thag_13.1:0.2"], "en": "Theragāthā 13.1 Terasanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:0.3"], "en": "First Chapter (Paṭhamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:0.4"], "en": "The Verses of the Elder Soṇakoḷivisa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:1.1"], "en": "“He who was preeminent in the kingdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:1.2"], "en": "the chief attendant of the King of Aṅga;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:1.3"], "en": "Today Soṇa has reached the pinnacle among those who possess the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:1.4"], "en": "he has gone beyond suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:2.1"], "en": "Cut off the five, abandon the five.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:2.2"], "en": "One should cultivate the five higher [faculties];", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:2.3", "PA_thag_13.1:2.4"], "en": "the bhikkhu who has transcended the five attachments is called one who has crossed the flood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:3.1", "PA_thag_13.1:3.2"], "en": "For a bhikkhu who is haughty, negligent, and outward-looking,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:3.3"], "en": "virtue, concentration, and wisdom—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:3.4"], "en": "It does not reach fulfillment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:4.1"], "en": "For when what ought to be done is neglected,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:4.2"], "en": "and what ought not to be done is performed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:4.3"], "en": "For those who are unrestrained and negligent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:4.4"], "en": "their taints increase;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:5.1"], "en": "but for those by whom [the faculties] are well-undertaken, [they do not].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:5.2"], "en": "With constant mindfulness directed toward the body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:5.3", "PA_thag_13.1:5.4"], "en": "they do not engage in what should not be done, but practice with persistence in what ought to be done.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:5.5"], "en": "For those who are mindful and clearly comprehending,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:5.6", "PA_thag_13.1:6.1"], "en": "the taints come to an end upon the straight path that has been proclaimed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:6.2"], "en": "Go forth, do not turn back;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:6.3"], "en": "exhort yourselves,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:6.4"], "en": "and strive for Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:7.1"], "en": "When energy was over-exerted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:7.2"], "en": "the Teacher, the unsurpassed one in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:7.3"], "en": "made for me a simile of the lute.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:7.4"], "en": "The Visionary One taught the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:7.5"], "en": "having heard his words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:7.6"], "en": "I dwelt delighted in his teaching.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:8.1", "PA_thag_13.1:8.2"], "en": "I practiced serenity for the sake of attaining the supreme goal;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:8.3"], "en": "the three knowledges have been realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:8.4"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:9.1", "PA_thag_13.1:9.2"], "en": "for one intent upon renunciation and solitude of mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:9.3"], "en": "To one intent on non-affliction,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:9.4"], "en": "to one intent on the destruction of clinging,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:10.1"], "en": "and to one intent on the destruction of craving—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:10.2"], "en": "And with a mind free from delusion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:10.3"], "en": "having seen the arising of the sense bases,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:10.4"], "en": "the mind is rightly liberated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:11.1", "PA_thag_13.1:11.2"], "en": "For that bhikkhu who is rightly liberated and whose mind is at peace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:11.3"], "en": "there is no accumulation of what has been done.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:11.4"], "en": "There is nothing further to be done.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:12.1"], "en": "Like a solid mass of rock,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:12.2"], "en": "he is not shaken by the wind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:12.3"], "en": "Such are forms, tastes, sounds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:12.4"], "en": "smells, and tangibles in their entirety—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:13.1"], "en": "both desirable and undesirable phenomena.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:13.2"], "en": "The Tathāgatas do not tremble;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:13.3"], "en": "their minds are steadfast, detached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:13.4"], "en": "and they contemplate its passing away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:13.5", "PA_thag_13.1:13.6"], "en": "… The Elder Soṇa Koḷivisa … The Thirteenth Chapter is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:14.0"], "en": "Herein is the summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:14.1", "PA_thag_13.1:14.2"], "en": "The elder Soṇa Koḷivisa alone was possessed of great psychic power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:14.3"], "en": "in the thirteenth nipāta—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_13.1:14.4"], "en": "And there are thirteen verses here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
