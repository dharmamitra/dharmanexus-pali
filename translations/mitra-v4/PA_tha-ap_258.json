[
{"segs": ["PA_tha-ap_258:0.1", "PA_tha-ap_258:0.2"], "en": "The Apadāna of the Elder Upāhanadāyaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:0.3"], "en": "Chapter on Praise, Number Six.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:1.1"], "en": "“At that time I was named Candana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:1.2"], "en": "the son of a fully enlightened Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:1.3"], "en": "a single sandal was given by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:1.4"], "en": "\"May you help me attain enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:2.1"], "en": "Ninety-one aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:2.2"], "en": "when I gave a sandal at that time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:2.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:2.4"], "en": "this is the fruit of my sandals.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:3.1"], "en": "The four analytical knowledges (paṭisambhidā) [are mine].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:3.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:3.3"], "en": "the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:4.1"], "en": "Thus indeed did the Venerable Upāhanadāyaka Thera speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_258:5.1"], "en": "The legend of the Elder Upāhanadāyaka is the sixth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
