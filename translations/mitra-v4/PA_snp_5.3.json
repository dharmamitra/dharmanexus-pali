[
{"segs": ["PA_snp_5.3:0.1", "PA_snp_5.3:0.2", "PA_snp_5.3:1.1"], "en": "Sutta Nipāta 5.3 The Young Man Tissa Metteyya’s Question “Who in this world is contented?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:1.2"], "en": "(Thus spoke the Venerable Tissa Metteyya:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:1.3"], "en": "\"To whom do no fluctuations exist?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:1.4"], "en": "Who, having directly known both extremes,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:1.5"], "en": "In the midst, the wise one is not defiled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:1.6"], "en": "whom do you call a Great Man?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:1.7"], "en": "Who here has transcended the seamstress?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:2.1"], "en": "“Living the holy life regarding sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:2.2"], "en": "O Metteyya,” said the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:2.3"], "en": "“one who is free from craving and always mindful;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:2.4"], "en": "The bhikkhu who has attained Nibbāna through full understanding—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:2.5"], "en": "for him there are no more fluctuations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:3.1"], "en": "Having directly known both ends, he...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:3.2"], "en": "In the midst of them, the wise one is not defiled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:3.3"], "en": "him I call a Great Man—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:3.4"], "en": "he has here transcended the seamstress.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.3:3.5"], "en": "The second inquiry of the young brahmin Tissa-Metteyya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
