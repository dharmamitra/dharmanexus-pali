[
{"segs": ["PA_tha-ap_266:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:0.2"], "en": "The Chapter on the Throwing of the Lotus (Padumukkhipavagga) 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:0.3"], "en": "The Apadāna of the Elder Padīpadāyaka (The Giver of the Lamp)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:1.1", "PA_tha-ap_266:1.2"], "en": "“Having been a deva, while descending to the earth at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:1.3"], "en": "I gave five lamps as offerings.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:1.4"], "en": "With palms joined in faith,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:2.1", "PA_tha-ap_266:2.2"], "en": "that lamp which I offered back then, ninety-four aeons ago—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:2.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:2.4"], "en": "this is the fruit of giving a lamp.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:3.1"], "en": "For fifty-five aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:3.2"], "en": "I was once a lord of the earth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:3.3", "PA_tha-ap_266:3.4"], "en": "a mighty universal monarch named Samantacakkhu.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:4.1", "PA_tha-ap_266:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:5.1"], "en": "Thus indeed did the venerable elder Padīpadāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_266:6.1"], "en": "This is the fourth *apadāna* of the elder Padīpadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
