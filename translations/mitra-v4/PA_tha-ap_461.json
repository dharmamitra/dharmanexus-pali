[
{"segs": ["PA_tha-ap_461:0.1", "PA_tha-ap_461:0.2", "PA_tha-ap_461:0.3"], "en": "The Apadāna of the Elder Paṭṭipupphiya Jagatidāyaka Chapter 9 The Apadāna of the Elder Paṭṭipupphiya: \"I offered a *paṭṭi*-flower to the Buddha, the Great Sage, who was seated upon his throne. Because of that root of merit, I have attained the fruit of stream-entry (*sotāpatti-phala*). I am now free from birth in the four woeful states; I shall not fall into the lower realms.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:1.1", "PA_tha-ap_461:1.2"], "en": "While the body was being carried out and the drums were being beaten,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:1.3"], "en": "with a clear heart and a joyful mind, he spoke thus.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:1.4"], "en": "I worshipped with a *paṭṭi* flower.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:2.1"], "en": "For a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:2.2"], "en": "because of that flower which I offered in worship, [the fruit has ripened].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:2.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:2.4"], "en": "this is the fruit of honoring the body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:3.1"], "en": "The defilements have been burnt away by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:3.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:3.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:4.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:4.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:5.1"], "en": "The four analytical knowledges (paṭisambhidā) [are attained].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:5.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:5.3"], "en": "the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:6.1"], "en": "Thus indeed did the Venerable Elder Paṭṭipupphiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_461:7.1"], "en": "The legend of the Elder Paṭṭipupphiya, the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
