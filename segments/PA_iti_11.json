    {
        "segmentnr": "PA_iti_11:1.1",
        "original": "Vuttañhetaṁ bhagavatā vuttamarahatāti me sutaṁ:",
        "analyzed": "vuttam ha etam bhagavatā vuttam arahatā iti me suta ",
        "folio": "1",
        "suttacentral_link": "https://suttacentral.net/iti11/pli/ms#1.1"
    },
    {
        "segmentnr": "PA_iti_11:2.1",
        "original": "“Mohaṁ, bhikkhave, anabhijānaṁ aparijānaṁ tattha cittaṁ avirājayaṁ appajahaṁ abhabbo dukkhakkhayāya.",
        "analyzed": "bhikkhave an abhijānam a parijānam tattha cittam a virājayam a pajaham abhabbaḥ dukkha kkhayāya ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/iti11/pli/ms#2.1"
    },
    {
        "segmentnr": "PA_iti_11:2.2",
        "original": "Mohañca kho, bhikkhave, abhijānaṁ parijānaṁ tattha cittaṁ virājayaṁ pajahaṁ bhabbo dukkhakkhayāyā”ti.",
        "analyzed": "moham ca kho bhikkhave abhijānam parijānam tattha cittam virājayam pajaham bhabbaḥ dukkha kkhayāya ati ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/iti11/pli/ms#2.2"
    },
    {
        "segmentnr": "PA_iti_11:2.3",
        "original": "Etamatthaṁ bhagavā avoca.",
