{"segs": ["PA_ja_128:0.2", "PA_ja_128:0.3"], "en": "Ekakanipāta, Kusanāḷivagga (The Chapter on the Reed)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_128:0.4"], "en": "8. The Biḷāravata Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_128:1.1", "PA_ja_128:1.2"], "en": "“Whoever, having made the Dhamma his banner, should practice evil in secret;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_128:1.3"], "en": "\"Having inspired confidence in all beings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_128:1.4"], "en": "that is the practice known as 'the Cat'.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_128:2.1"], "en": "Thus ends the eighth Jātaka, the Cat Practice Jātaka (Biḷāravata-jātaka).", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
