[
{"segs": ["PA_ja_310:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:0.2"], "en": "The Section of Fours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:0.3"], "en": "Chapter on Kāliṅga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:0.4"], "en": "10. The Sejjā Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:1.1", "PA_ja_310:1.2"], "en": "“The earth, bounded by the ocean, with the sea as its earring...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:1.3"], "en": "One should not desire fame along with blame;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:1.4"], "en": "understand excellence in this way:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:2.1"], "en": "\"Woe be to that acquisition of fame!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:2.2"], "en": "And as for the acquisition of wealth, O Brahmin:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:2.3", "PA_ja_310:2.4"], "en": "that livelihood which comes through falling into ruin or through practicing unrighteousness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:3.1", "PA_ja_310:3.2"], "en": "Even if one goes forth as a homeless wanderer, taking up the alms-bowl,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:3.3"], "en": "that very livelihood is better.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:3.4"], "en": "And whatever search is conducted unrighteously— even if one,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:4.1"], "en": "having taken up the bowl,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:4.2"], "en": "should wander as a homeless renunciant;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:4.3", "PA_ja_310:4.4"], "en": "\"Any other harmlessness in the world is better than even sovereignty.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:5.1"], "en": "The Seyya Jātaka, the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:5.2"], "en": "The first chapter, the Kāliṅga-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:6.1", "PA_ja_310:7.1"], "en": "Its summary verse (uddāna) is: Vivara, Adeyya, and Samiddhavara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:7.2"], "en": "Then Daddara, Pāpamahātiratha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:7.3"], "en": "Koli, Palāsavara, and Kara— these ten,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_310:7.4"], "en": "together with Sasamuddavara, were the last.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
