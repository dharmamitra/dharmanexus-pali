[
{"segs": ["PA_iti_3:0.1"], "en": "Itivuttaka 3:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:0.2", "PA_iti_3:0.3"], "en": "Ekakanipāta, First Chapter (Paṭhamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:0.4"], "en": "The Discourse on Delusion.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:1.1"], "en": "Thus it was said by the Blessed One, so I have heard:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:2.1"], "en": "\"Bhikkhus, abandon one thing.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:2.2"], "en": "I am your guarantor for non-returning.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:2.3"], "en": "What is that one thing?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:2.4"], "en": "Monks, abandon delusion, which is that one thing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:2.5"], "en": "“I am your guarantor for non-returning.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:2.6"], "en": "This is what the Blessed One said.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:2.7"], "en": "With regard to this, it is said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:3.1"], "en": "“Having fully understood that delusion by which beings, being deluded,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:3.2"], "en": "go to an evil destination—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:3.3"], "en": "that delusion, having fully understood it...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:3.4"], "en": "Those who possess insight abandon them;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:3.5", "PA_iti_3:3.6"], "en": "having abandoned them, they never again return to this world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:4.1"], "en": "This matter was also spoken by the Blessed One; thus have I heard.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_3:4.2"], "en": "The third [sutta].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
