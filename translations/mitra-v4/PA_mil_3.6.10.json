[
{"segs": ["PA_mil_3.6.10:0.1", "PA_mil_3.6.10:0.2"], "en": "The Questions of Milinda, Chapter on Mindfulness, 10.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.10:0.3"], "en": "The Question on Taking Refuge After a Long Time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.10:1.1"], "en": "The king said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.10:1.2"], "en": "“Venerable Nāgasena, by what means does one remember the past, that which was done long ago?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.10:1.3"], "en": "“By mindfulness, Great King,” he replied.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.10:1.4"], "en": "“But, venerable Nāgasena, does one remember by means of the mind, not by means of mindfulness?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.10:1.5"], "en": "“Do you recall, Great King, having done some task and then forgetting it?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.10:1.6"], "en": "“Yes, venerable sir.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.10:1.7"], "en": "“Great king, were you without consciousness at that time?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.10:1.8"], "en": "“No, venerable sir; mindfulness was not absent at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.10:1.9"], "en": "“Then why, great king, do you say this?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.10:1.10"], "en": "“Does one recollect by means of the mind, not by means of mindfulness?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.10:2.1"], "en": "“You are skillful, venerable Nāgasena.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.6.10:3.1"], "en": "This is the tenth dilemma, on remembering what was done long ago.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"}
]
