[
{"segs": ["PA_vv_42:0.1"], "en": "Vimānavatthu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:0.2", "PA_vv_42:0.3"], "en": "The Chapter on the Mañjiṭṭhaka Mansion in the Itthivimāna Section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:0.4", "PA_vv_42:1.1", "PA_vv_42:1.2"], "en": "4. The Story of the Hairless Mansion “O deity, you who stand there with such exquisite beauty— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:1.3", "PA_vv_42:1.4"], "en": "Illuminating all directions like a star among the herbs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:2.1"], "en": "by what cause do you possess such a complexion?", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:2.2", "PA_vv_42:2.3"], "en": "\"...and your radiance illuminates all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:3.1"], "en": "That deity was uplifted in mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:3.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:3.3"], "en": "the fruit of which action is this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:4.1"], "en": "\"And I, in Bārāṇasī...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:4.2"], "en": "To the Buddha, the Kinsman of the Sun,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:4.3", "PA_vv_42:4.4"], "en": "I, with a clear mind, gave dry groats with my own hands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:5.1", "PA_vv_42:5.2"], "en": "Behold the fruit of a lump of boiled rice that was dry and saltless;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:5.3"], "en": "seeing him hairless and happy, [the people] were amazed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:5.4"], "en": "Who would not perform merit?", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:6.1", "PA_vv_42:6.2"], "en": "Because of that, my complexion is such as this... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:6.3"], "en": "\"And my radiance shines in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_42:7.1"], "en": "Thus ends the fourth, the *Aloma-vimāna*.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"}
]
