[
{"segs": ["PA_tha-ap_508:0.1", "PA_tha-ap_508:0.2", "PA_tha-ap_508:0.3"], "en": "The Apadāna of the Elder Mātuluṅgaphaladāyaka, from the Kaṇikāra Chapter, Number Six.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:1.1"], "en": "“Like a blossoming kaṇikāra tree in full bloom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:1.2"], "en": "like the moon on a full-moon night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:1.3"], "en": "like a blazing lamp-tree.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:1.4"], "en": "I saw the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:2.1"], "en": "Having taken a mātuluṅga fruit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:2.2"], "en": "I gave it to the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:2.3", "PA_tha-ap_508:2.4"], "en": "With my own hands, full of faith, I made an offering to the Hero worthy of gifts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:3.1"], "en": "Thirty-one eons ago from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:3.2"], "en": "Whatever fruit I gave back then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:3.4"], "en": "this is the fruit of that gift of fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:4.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:4.2", "PA_tha-ap_508:4.3"], "en": "…pe… I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:5.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:5.2", "PA_tha-ap_508:5.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:6.1", "PA_tha-ap_508:6.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:6.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:7.1"], "en": "Thus indeed the venerable elder Mātuluṅgaphaladāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_508:8.1"], "en": "This is the sixth legend of the elder Mātuluṅgaphaladāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
