[
{"segs": ["PA_thag_1.20:0.1", "PA_thag_1.20:0.2", "PA_thag_1.20:0.3"], "en": "Theragāthā 1.20 Ekakanipāta Dutiyavagga (The Second Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:0.4"], "en": "The Verses of the Elder Ajita:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:1.1"], "en": "“I have no fear of death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:1.2"], "en": "nor do I have attachment to life;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:1.3"], "en": "“I shall lay aside my doubt,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:1.4"], "en": "being clearly comprehending and mindful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:1.5"], "en": "… Thus spoke the Elder Ajita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:1.6"], "en": "The second chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:2.0"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:2.1"], "en": "Cūḷavaccha, Mahāvaccha, ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:2.2"], "en": "Vanavaccha and Sīvaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:2.3"], "en": "Kuṇḍadhāna and Belaṭṭhi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:2.4"], "en": "and Dāsaka after them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:2.5"], "en": "The Elder Siṅgālapitika,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.20:2.6"], "en": "Kula, and Ajita Dasaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
