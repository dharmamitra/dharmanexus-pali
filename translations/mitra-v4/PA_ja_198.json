{"segs": ["PA_ja_198:0.4"], "en": "8. The Rādhajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_198:1.1"], "en": "“I have returned from my journey, dear father;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_198:1.2"], "en": "it has not been long since I left.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_198:1.3", "PA_ja_198:1.4"], "en": "“I hope, dear father, that your mother does not serve another man?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_198:2.1"], "en": "“This is not well spoken, Subha.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_198:2.2"], "en": "One should speak speech endowed with truth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_198:2.3"], "en": "otherwise, one might lie like Poṭṭhapāda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_198:2.4"], "en": "scorched upon the hot embers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_198:3.1"], "en": "The Rādhajātaka is the eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
