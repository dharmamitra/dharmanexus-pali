[
{"segs": ["PA_ja_293:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_293:0.2"], "en": "Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_293:0.3"], "en": "Kumbhavagga", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_293:0.4", "PA_ja_293:1.1"], "en": "3. The Kāyanibbinda Jātaka “Touched by a certain disease,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_293:1.2"], "en": "greatly afflicted by illness, and suffering in pain;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_293:1.3"], "en": "This body quickly decays,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_293:1.4"], "en": "like a flower placed in the sun upon dust;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_293:2.1"], "en": "that which is ignoble is reckoned as noble.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_293:2.2"], "en": "One regards the impure as pure,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_293:2.3", "PA_ja_293:2.4"], "en": "failing to see that this physical form is filled with various kinds of filth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_293:3.1", "PA_ja_293:3.2"], "en": "Well done! This diseased, putrid body— loathsome, impure, and subject to illness—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_293:3.3"], "en": "is that upon which people, being heedless, are infatuated.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_293:3.4"], "en": "“They abandon the path leading to rebirth in the world of the Sugata.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_293:4.1"], "en": "Thus ends the third Jātaka, the Kāyanibbinda Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
