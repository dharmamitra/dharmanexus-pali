[
{"segs": ["PA_mil_3.6.4:0.1", "PA_mil_3.6.4:0.2"], "en": "The Questions of King Milinda, Chapter on Mindfulness, 4.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:0.3"], "en": "The Question on the Brahma-farer of the Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:1.1"], "en": "The king said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:1.2"], "en": "\"Venerable Nāgasena, is the Buddha a practitioner of the holy life (brahmacārī)?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:1.3"], "en": "\"Yes, great king, the Blessed One is a practitioner of the holy life.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:1.4"], "en": "“Therefore, venerable Nāgasena, the Buddha is a disciple of Brahmā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:1.5"], "en": "“But do you have, Great King, a chief elephant?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:1.6"], "en": "“I do, venerable sir.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:1.7"], "en": "“Great King, does that elephant ever at any time utter the cry of a crane?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:1.8"], "en": "“Yes, venerable sir, it does.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:1.9"], "en": "“In that case, Great King, is that elephant a pupil of the crane?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:1.10"], "en": "“No indeed, Bhante.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:1.11"], "en": "“But what do you think, Great King—is Brahmā wise or unwise?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:1.12"], "en": "“He is wise, Bhante.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:1.13"], "en": "“In that case, Great King, Brahmā is a disciple of the Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:2.1"], "en": "“Excellent, Venerable Nāgasena!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_mil_3.6.4:3.1"], "en": "This was the fourth question concerning the Blessed One’s celibate disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
