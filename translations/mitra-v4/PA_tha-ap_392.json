[
{"segs": ["PA_tha-ap_392:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:0.2", "PA_tha-ap_392:0.3"], "en": "The Buddha-Apadāna on the Remnant of Previous Karma, the Tenth Chapter in the Avaṭaphala Section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:1.1"], "en": "Near the lake Anotatta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:1.2"], "en": "on a delightful rocky surface,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:1.3"], "en": "shimmering with various kinds of jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:1.4"], "en": "In the midst of various fragrant woods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:2.1", "PA_tha-ap_392:2.2"], "en": "the Leader of the World was surrounded by a great community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:2.3", "PA_tha-ap_392:2.4"], "en": "Seated there, he explained his own past kamma:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:3.1"], "en": "\"Listen to me, O monks.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:3.2"], "en": "Whatever deed was performed by me—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:3.3"], "en": "even for that act of providing a rag-robe—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:3.4"], "en": "it ripens even in the state of Buddhahood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:4.1", "PA_tha-ap_392:4.2"], "en": "In former births, in other lives, I was a rogue named Munāli;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:4.3"], "en": "[I once struck] the fragrant Paccekabuddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:4.4"], "en": "I falsely accused one who was innocent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:5.1"], "en": "By the ripening of that kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:5.2"], "en": "I wandered in hell for a long time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:5.3"], "en": "For many thousands of years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:5.4"], "en": "he experienced painful sensation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:6.1"], "en": "By the remainder of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:6.2"], "en": "In this my final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:6.3", "PA_tha-ap_392:6.4"], "en": "I have received false accusations on account of Sundarī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:7.1"], "en": "To the Buddha Sabbābhibhū,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:7.2"], "en": "there was a disciple named Nanda;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:7.3"], "en": "having falsely accused him, [he fell] into hell.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:7.4"], "en": "I have wandered for a long time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:8.1"], "en": "For ten thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:8.2"], "en": "I wandered for a long time in hell.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:8.3"], "en": "Having attained human status,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:8.4"], "en": "I received much false accusation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:9.1"], "en": "By the remaining residue of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:9.2", "PA_tha-ap_392:9.3"], "en": "Ciñcamānavikā falsely accused me with what was untrue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:9.4"], "en": "in the presence of the assembly of people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:10.1"], "en": "I was a learned brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:10.2"], "en": "honored and revered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:10.3"], "en": "[I taught] five hundred [students] in the great forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:10.4"], "en": "I recite the mantras to the young brahmin students.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:11.1"], "en": "Therein dwells the formidable seer, the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:11.2"], "en": "possessed of the five super-knowledges and great psychic power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:11.3"], "en": "And seeing him arrive,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:11.4"], "en": "though he was innocent, I slandered him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:12.1"], "en": "then I spoke to my disciples:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:12.2"], "en": "\"This seer is a seeker of sensual pleasures\";", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:12.3"], "en": "yet even as I spoke,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:12.4"], "en": "the young brahmins applauded me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:13.1"], "en": "Then all those young men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:13.2"], "en": "as he was begging from family to family,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:13.3"], "en": "said to the great multitude:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:13.4"], "en": "This seer was once a consumer of sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:14.1"], "en": "By the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:14.2"], "en": "these five hundred bhikkhus [have come to be].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:14.3", "PA_tha-ap_392:14.4"], "en": "They all received false accusations because of Sundarī;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:15.1"], "en": "formerly, [they had been] half-brothers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:15.2"], "en": "For the sake of wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:15.3", "PA_tha-ap_392:15.4"], "en": "I cast him into a mountain ravine and ground him with a stone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:16.1"], "en": "Through the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:16.2"], "en": "Devadatta hurled a stone;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:16.3"], "en": "it crushed his toe on the foot.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:16.4"], "en": "\"My pebble-stone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:17.1", "PA_tha-ap_392:17.2"], "en": "Formerly, when I was a boy playing on the great highway;\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:17.3"], "en": "Having seen a paccekabuddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:17.4"], "en": "I threw a piece of wood onto the path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:18.1"], "en": "By the ripening of that kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:18.2"], "en": "In this my final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:18.3", "PA_tha-ap_392:18.4"], "en": "Devadatta incited me to be assassinated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:19.1"], "en": "In the past, I was an elephant rider;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:19.2", "PA_tha-ap_392:19.3"], "en": "[I saw] that supreme Paccekabuddha wandering for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:19.4"], "en": "I mounted upon the elephant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:20.1"], "en": "By the ripening of that kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:20.2"], "en": "the elephant Nāḷāgiri became agitated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:20.3"], "en": "In the excellent city of Giribbaja,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:20.4"], "en": "a terrible [disease] approached.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:21.1"], "en": "I was the king, the lord of the earth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:21.2"], "en": "I struck a man with a spear;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:21.3"], "en": "by the ripening of that kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:21.4"], "en": "I suffered intensely in hell.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:22.1"], "en": "By the remainder of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:22.2", "PA_tha-ap_392:22.3"], "en": "he has now caused the skin on all my feet to be stripped away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:22.4"], "en": "For indeed, karma does not perish.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:23.1"], "en": "In the village of Kevaṭṭa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:23.2"], "en": "I was once a fisherman’s son.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:23.3"], "en": "Seeing a fish being killed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:23.4"], "en": "I gave rise to a feeling of joy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:24.1"], "en": "By the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:24.2"], "en": "There was pain in my head;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:24.3", "PA_tha-ap_392:24.4"], "en": "all the Sakyans were slain when Viḍūḍabha struck them down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:25.1"], "en": "In the dispensation of Phussa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:25.2"], "en": "I reviled his disciples, saying:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:25.3"], "en": "\"Eat and consume barley!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:25.4"], "en": "And do not eat with attachment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:26.1"], "en": "By the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:26.2"], "en": "you ate barley for three months.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:26.3"], "en": "Invited by a brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:26.4", "PA_tha-ap_392:27.1"], "en": "I then dwelt in Verañjā while the Nibbuddha festival was taking place.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:27.2"], "en": "I caused suffering to the son of a wrestler;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:27.3"], "en": "by the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:27.4"], "en": "I have suffered back pain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:28.1", "PA_tha-ap_392:28.2"], "en": "I was once a physician and administered a purgative to the son of a merchant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:28.3"], "en": "by the ripening of that kamma, [I am now suffering].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:28.4", "PA_tha-ap_392:29.1", "PA_tha-ap_392:29.2"], "en": "\"I have dysentery,\" Jotipāla said to the Sugata Kassapa at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:29.3"], "en": "Whence indeed can there be awakening for one who is shaven-headed?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:29.4"], "en": "Awakening is extremely difficult to attain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:30.1"], "en": "By the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:30.2", "PA_tha-ap_392:30.3"], "en": "I practiced many difficult austerities for six years at Uruvelā; from that,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:30.4"], "en": "I attained enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:31.1", "PA_tha-ap_392:31.2"], "en": "I did not attain supreme enlightenment by this path;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:31.3"], "en": "I sought it by a wrong path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:31.4"], "en": "He was restrained by past karma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:32.1"], "en": "with merit and demerit completely exhausted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:32.2"], "en": "he was freed from all suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:32.3"], "en": "“Asoka, free from distress,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:32.4"], "en": "shall be extinguished, his taints destroyed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:33.1"], "en": "Thus the Victor prophesied.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:33.2"], "en": "In the presence of the Saṅgha of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:33.3"], "en": "having attained the power of all direct knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:33.4"], "en": "[he dwelt] at the great lake Anotatta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:34.1"], "en": "Thus indeed the Blessed One spoke this Dhamma discourse on the Buddha’s lineage of past deeds, known as “The Tangled Web of Karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:35.1"], "en": "This concludes the tenth chapter of the Buddha’s lineage of past deeds, titled “The Tangled Web of Past Karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:36.1"], "en": "This is the thirty-ninth chapter, the Section on the Avata Fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:37.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:38.1"], "en": "The *avaṭa*, the *labuja*,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:38.2"], "en": "the *udumbara*, and the *pilakkhu*;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_392:38.3"], "en": "The Phāru creeper and the plantain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
