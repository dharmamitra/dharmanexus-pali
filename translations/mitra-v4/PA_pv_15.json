[
{"segs": ["PA_pv_15:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:0.2"], "en": "Ubbarivagga, 3.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:0.3"], "en": "The Story of Mattāpeti", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:1.1"], "en": "“Naked, of ugly form,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:1.2"], "en": "emaciated, with veins showing all over;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:1.3"], "en": "you are parched and thin, O emaciated one.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:1.4"], "en": "“Who are you standing here?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:2.1"], "en": "“I am your intoxicated rival, Tissa;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:2.2"], "en": "I was your co-wife in the past.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:2.3"], "en": "“Having committed evil deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:2.4"], "en": "they have gone from here to the world of the departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:3.1"], "en": "“What indeed [was done] by way of body or speech...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:3.2"], "en": "“An evil deed was committed with the mind;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:3.3", "PA_pv_15:3.4"], "en": "by the ripening of what karma have you gone from here to the world of the hungry ghosts?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:4.1"], "en": "“I was fierce and harsh,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:4.2"], "en": "envious, stingy, and deceitful;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:4.3"], "en": "having spoken such evil words to her, I— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:4.4"], "en": "“Have gone from here to the world of the Petas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:5.1"], "en": "“I too know all this,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:5.2"], "en": "just as you have been fierce;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:5.3"], "en": "\"But I ask you something else:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:5.4"], "en": "by what have you been covered in dust?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:6.1"], "en": "\"I had just washed my head,\" she replied.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:6.2"], "en": "They were well-clad and adorned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:6.3", "PA_pv_15:6.4"], "en": "yet I was even more exquisitely adorned than you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:7.1"], "en": "While I was looking on,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:7.2"], "en": "my husband deliberated with her;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:7.3"], "en": "then, great envy arose within me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:7.4"], "en": "Anger arose within me. Then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:8.1"], "en": "having taken some dust,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:8.2"], "en": "I indeed sprinkled it over him with that dust.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:8.3"], "en": "“By the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:8.4"], "en": "I am covered in dust.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:9.1"], "en": "“I know all of this as well.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:9.2"], "en": "\"I sprinkled you with dust;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:9.3"], "en": "yet I ask you another thing:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:9.4"], "en": "by what are you afflicted with this itch?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:10.1", "PA_pv_15:10.2", "PA_pv_15:10.3"], "en": "“Both of us went to the edge of the forest to fetch medicine; you fetched the medicine, and— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:10.4"], "en": "And I [prepared] a bath of *kapikacchu*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:11.1"], "en": "While she was unaware of it,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:11.2"], "en": "I sprinkled that bath over her bed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:11.3"], "en": "“Because of the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:11.4"], "en": "I am now tormented by this itch.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:12.1"], "en": "“I too know all of this,” [the Buddha said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:12.2"], "en": "\"You have defiled my bed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:12.3"], "en": "furthermore, I ask you this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:12.4"], "en": "by what means are you naked?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:13.1"], "en": "“There was a gathering of companions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:13.2"], "en": "an assembly of kinsmen;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:13.3"], "en": "and you were invited there.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:13.4"], "en": "She was with child, yet I did not know it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:14.1", "PA_pv_15:14.2"], "en": "When she informed me of this, I gave her a garment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:14.3"], "en": "“By the ripening of that kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:14.4"], "en": "I am thus naked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:15.1"], "en": "“I too know all of this;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:15.2"], "en": "\"You have blown away my robe;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:15.3"], "en": "but I ask you this further:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:15.4"], "en": "by what means have you become smelling of excrement?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:16.1"], "en": "“Your perfume and garland,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:16.2"], "en": "and your most precious ointment,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:16.3"], "en": "I cast into a pit of excrement.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:16.4"], "en": "That evil was committed by me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:16.5"], "en": "through the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:16.6"], "en": "I am thus foul-smelling with excrement.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:17.1", "PA_pv_15:17.2"], "en": "“I know all that evil deed committed by you; furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:17.3"], "en": "I ask you another thing.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:17.4"], "en": "“By what means have you fallen into misfortune?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:18.1", "PA_pv_15:18.2"], "en": "[She replied: “Whatever wealth was found in the house was shared equally between us two.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:18.3"], "en": "While there were gifts to be given among the virtuous,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:18.4"], "en": "I did not make an island for myself;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:18.5"], "en": "by the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:18.6"], "en": "Because of that, I have fallen into misfortune.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:19.1"], "en": "Yet you spoke to me then:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:19.2"], "en": "“You are practicing evil deeds.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:19.3"], "en": "“Indeed, through evil deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:19.4"], "en": "a happy destination is not easily attained.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:20.1"], "en": "“You are judging me from a wrong perspective,” [he said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:20.2"], "en": "And yet you envy me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:20.3", "PA_pv_15:20.4"], "en": "behold how such is the ripening of evil deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:21.1", "PA_pv_15:21.2", "PA_pv_15:21.3"], "en": "Those houses, those maidservants, and these very ornaments— they now serve others.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:21.4"], "en": "Possessions do not last forever.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:22.1", "PA_pv_15:22.2"], "en": "Now that his father has passed away, he will come home from the marketplace.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:22.3"], "en": "“May I give you something;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:22.4"], "en": "do not go away from here yet.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:23.1"], "en": "“I am naked and of ugly appearance,” she said.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:23.2"], "en": "“Emaciated, with veins protruding—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:23.3"], "en": "this is the natural state of women;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:23.4"], "en": "let not my father, who gave me birth, see me!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:24.1", "PA_pv_15:24.2"], "en": "“Come now, what shall I give you, or what shall I do for you here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:24.3"], "en": "by which you may be happy?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:24.4"], "en": "“Accomplishing all desires.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:25.1"], "en": "“Four [types of] monks from the Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:25.2"], "en": "and four types of individuals;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:25.3"], "en": "Having fed eight bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:25.4"], "en": "dedicate the merit to me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:25.5"], "en": "then I shall be happy.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:25.6", "PA_pv_15:26.1"], "en": "\"Which fulfills all desires. Having agreed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:26.2"], "en": "saying \"So be it,\" she fed the eight bhikkhus.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:26.3"], "en": "Having covered her with garments,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:26.4"], "en": "he dedicated the gift to her.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:27.1"], "en": "Immediately after it was dedicated,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:27.2"], "en": "The fruit of this offering arose:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:27.3"], "en": "food, clothing, and drink—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:27.4"], "en": "this is the result of that gift.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:28.1"], "en": "Then, pure and dressed in clean garments,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:28.2"], "en": "wearing the finest Kāsī cloth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:28.3"], "en": "adorned with variegated clothes and ornaments—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:28.4"], "en": "She approached Sappati and said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:29.1", "PA_pv_15:29.2"], "en": "“O goddess, with such exquisite beauty you stand there!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:29.3", "PA_pv_15:29.4"], "en": "Illuminating all directions like a star among the herbs,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:30.1"], "en": "by what means do you possess such a complexion?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:30.2"], "en": "By what means do you succeed here?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:30.3", "PA_pv_15:30.4"], "en": "For all those riches that are dear to the mind arise for you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:31.1"], "en": "I ask you, O goddess of great majesty:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:31.2"], "en": "what merit did you perform while being a human being?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:31.3"], "en": "By what means have you come to possess such blazing power?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:31.4"], "en": "\"And your beauty shines forth in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:32.1"], "en": "\"I was intoxicated, you were my rival;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:32.2"], "en": "you were my co-wife in the past.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:32.3"], "en": "Having committed evil deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:32.4"], "en": "they have gone from here to the world of the departed (peta).", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:33.1"], "en": "By means of the gift given by you, [may they be relieved].", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:33.2"], "en": "I rejoice, free from fear from any quarter;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:33.3"], "en": "live long, sister,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:33.4"], "en": "together with all your kinsmen.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:33.5"], "en": "The sorrowless, stainless state,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:33.6"], "en": "the abode of those who have mastery—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:34.1"], "en": "having practiced the Dhamma here, [one attains it].", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:34.2"], "en": "Having given a gift, O beautiful one,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_15:34.3"], "en": "having removed the stain of stinginess along with its root, go,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
