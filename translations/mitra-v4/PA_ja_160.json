[
{"segs": ["PA_ja_160:0.1", "PA_ja_160:0.2", "PA_ja_160:0.3"], "en": "Jātaka: The Second Book of Birth Stories (Dukanipāta), Chapter on the Firm (Daḷhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:0.4"], "en": "10. The Vinīlaka Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:1.1", "PA_ja_160:1.2"], "en": "“In this very way, surely, the King of Videha, the seizer of Mithilā;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:1.3"], "en": "“Swift thoroughbreds carry you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:1.4"], "en": "like swans carrying Vinīlaka. “Vinīlaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:2.1"], "en": "you resort to a difficult path;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:2.2"], "en": "\"My dear, you are frequenting an improper place;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:2.3"], "en": "frequent the outskirts of villages,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:2.4"], "en": "for that is your mother's domain.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:3.1"], "en": "The Vinīla Jātaka is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:3.2"], "en": "The first chapter, the Daḷha-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:4.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:5.1"], "en": "Varaballika, Daddara, Sūkarako,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:5.2"], "en": "Uraguttama, Pañcamabhaggavara;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:5.3"], "en": "Mahatīcamu, and as far as Siṅgālavara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_160:5.4"], "en": "“O supreme swan, my dark-blue garment has been snatched away.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
