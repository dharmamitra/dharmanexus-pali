[
{"segs": ["PA_tha-ap_405:0.1", "PA_tha-ap_405:0.2"], "en": "The Therāpadāna, Metteyyavagga: 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:0.3"], "en": "The Apadāna of the Elder Mettagu", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:1.1"], "en": "\"Not far from the Himālaya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:1.2"], "en": "there is a mountain named Asoka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:1.3"], "en": "there was my hermitage.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:1.4"], "en": "It was constructed by Vissakamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:2.1"], "en": "There was a perfectly enlightened Buddha named Sumedha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:2.2"], "en": "the supreme, compassionate Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:2.3"], "en": "Having dressed in the forenoon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:2.4"], "en": "he approached me for alms;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:3.1"], "en": "when the Great Hero had arrived, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:3.2"], "en": "To Sumedha, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:3.3", "PA_tha-ap_405:3.4"], "en": "I took the alms-bowl of the Sugata and filled it with ghee and oil.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:4.1"], "en": "Having given [this] to the Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:4.2"], "en": "Sumedha, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:4.3"], "en": "and having raised my hands in reverent salutation, I said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:4.4"], "en": "I produced even greater joy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:5.1"], "en": "By this gift of ghee,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:5.2"], "en": "and by my volition and aspiration;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:5.3"], "en": "Whether born as a god or a human,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:5.4"], "en": "I obtain abundant happiness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:6.1"], "en": "having avoided the lower realms, I am free from ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:6.2"], "en": "I wander through various states of existence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:6.3"], "en": "having directed my mind toward that [goal],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:6.4"], "en": "I attain the unshakable state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:7.1"], "en": "“It is a gain for you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:7.2"], "en": "O brahmin, it is well-acquired by you, that you have seen me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:7.3"], "en": "having come to see me— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:7.4"], "en": "Arahatship shall be yours.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:8.1"], "en": "Be confident and do not fear;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:8.2"], "en": "you shall attain great glory.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:8.3"], "en": "“Having given me ghee,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:8.4"], "en": "you shall be liberated from birth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:9.1"], "en": "By this gift of ghee, [you shall attain release].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:9.2"], "en": "And through volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:9.3"], "en": "whether born as a god or a human,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:9.4"], "en": "you obtain abundant happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:10.1", "PA_tha-ap_405:10.2"], "en": "By this gift of ghee and by my state of loving-kindness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:10.3"], "en": "for eighteen hundred aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:10.4"], "en": "You will delight in the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:11.1", "PA_tha-ap_405:11.2"], "en": "and thirty-eight times you will become a king of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:11.3"], "en": "A vast regional kingship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:11.4"], "en": "beyond counting,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:12.1"], "en": "and fifty-one times over.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:12.2"], "en": "\"You shall become a wheel-turning monarch,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:12.3"], "en": "a conqueror of the four quarters,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:12.4"], "en": "the lord of the Jambudvīpa realm.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:13.1", "PA_tha-ap_405:13.2"], "en": "Just as the great ocean is unshakeable and the earth is difficult to support,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:13.3"], "en": "so too are your riches.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:13.4"], "en": "They will become immeasurable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:14.1"], "en": "Having renounced sixty million pieces of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:14.2"], "en": "I went forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:14.3"], "en": "Seeking what is wholesome,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:14.4"], "en": "I approached Bāvari;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:15.1"], "en": "there I studied the mantras.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:15.2"], "en": "The characteristic known as the sixfold limb—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:15.3", "PA_tha-ap_405:15.4"], "en": "you, O Great Sage, have arisen dispelling that darkness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:16.1", "PA_tha-ap_405:16.2"], "en": "I have come, O Great Sage, desiring to see you;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:16.3"], "en": "having heard your Dhamma, I shall [attain peace].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:16.4"], "en": "I have attained the immovable state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:17.1"], "en": "Thirty thousand eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:17.2"], "en": "I gave ghee to a Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:17.3"], "en": "In this interval,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:17.4"], "en": "I do not recall having requested ghee.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:18.1"], "en": "Knowing my intention, [the Blessed One]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:18.2"], "en": "It arises according to my wish;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:18.3", "PA_tha-ap_405:18.4"], "en": "having been produced by understanding the mind, I satisfy them all.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:19.1"], "en": "O wonderful are the Buddhas, O wonderful are the Dhammas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:19.2"], "en": "O wonderful is our Teacher’s accomplishment!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:19.3"], "en": "For by giving but a little ghee, [one attains such great results].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:19.4"], "en": "I obtain what is immeasurable:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:20.1", "PA_tha-ap_405:20.2"], "en": "as much water as there is in the great ocean from the base of Mount Neru.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:20.3"], "en": "Taking my ghee as a measure,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:20.4"], "en": "it would not even constitute a sixteenth part;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:21.1"], "en": "as far as the entire world-system extends, [it would be no more than that].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:21.2"], "en": "Even as I continue to build it up,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:21.3", "PA_tha-ap_405:21.4"], "en": "that heap of places where I have been reborn does not come to an end.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:22.1"], "en": "Even the Himalaya, the king of mountains,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:22.2"], "en": "that most excellent mass of rock,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:22.3"], "en": "[would not equal] my anointed perfume.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:22.4"], "en": "It will not be comparable to a deposit:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:23.1"], "en": "clothing, incense, ghee,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:23.2"], "en": "and other things pertaining to this present life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:23.3"], "en": "And unconditioned Nibbāna—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:23.4"], "en": "this is the fruit of giving ghee.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:24.1"], "en": "One whose bed is the foundations of mindfulness...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:24.2"], "en": "With the domain of meditative absorption and jhāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:24.3", "PA_tha-ap_405:24.4"], "en": "and nourished by the factors of enlightenment— this today is the fruit of the gift of ghee.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:25.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:25.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:25.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:26.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:26.2", "PA_tha-ap_405:26.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:27.1"], "en": "The four analytical insights...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:27.2", "PA_tha-ap_405:27.3"], "en": "[and so forth] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:28.1"], "en": "Thus indeed the venerable elder Mettagū spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_405:29.1"], "en": "This is the third legend of the elder Mettagū.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
