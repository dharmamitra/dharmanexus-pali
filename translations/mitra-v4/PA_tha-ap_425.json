[
{"segs": ["PA_tha-ap_425:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:0.2"], "en": "Chapter on the Once-Sweeper (Sakiṃsammajjakavagga) 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:0.3"], "en": "The Apadāna of the Elder Ekāsanadāyaka (The Giver of a Single Seat)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:1.1", "PA_tha-ap_425:1.2"], "en": "Not far from the Himālaya is a mountain named Gosīta;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:1.3"], "en": "there my well-prepared hermitage stands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:1.4"], "en": "The leaf-hut was well-constructed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:2.1", "PA_tha-ap_425:2.2"], "en": "I am known by the name Kassapa, though I am called Narada.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:2.3"], "en": "Seeking the path of purity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:2.4"], "en": "I was then dwelling in Gosīta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:3.1"], "en": "There lived a Conqueror named Padumuttara.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:3.2"], "en": "Having reached the further shore of all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:3.3"], "en": "the perfectly awakened one, desiring solitude,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:3.4"], "en": "went with the speed of the wind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:4.1"], "en": "As he was going through the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:4.2"], "en": "seeing the radiance of the Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:4.3"], "en": "he prepared a wooden bedstead.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:4.4"], "en": "And I spread out a deerskin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:5.1", "PA_tha-ap_425:5.2"], "en": "Having prepared a seat and placed my joined palms upon my head, I paid homage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:5.3"], "en": "Having expressed my joy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:5.4"], "en": "I spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:6.1"], "en": "“O Great Hero, Surgeon of the World!”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:6.2"], "en": "A physician for those who are ill;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:6.3", "PA_tha-ap_425:6.4"], "en": "O Leader, grant healing to me who am overcome by disease.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:7.1"], "en": "Those who behold you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:7.2"], "en": "O Sage, the Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:7.3"], "en": "attain the accomplishment of their constant welfare.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:7.4"], "en": "May I be free from old age among these [beings].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:8.1"], "en": "I have no property to give away,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:8.2"], "en": "for I subsist on windfall fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:8.3"], "en": "\"I have this seat;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:8.4"], "en": "sit upon the wooden bed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:9.1"], "en": "There the Blessed One sat down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:9.2"], "en": "Like a fearless lion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:9.3"], "en": "having waited for a moment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:9.4"], "en": "he spoke these words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:10.1"], "en": "“Be confident and do not fear;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:10.2"], "en": "you have obtained the Jotirasa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:10.3"], "en": "Whatever you have desired, all that—”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:10.4"], "en": "It will be fulfilled in the future.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:11.1", "PA_tha-ap_425:11.2"], "en": "That which you have done for this unsurpassed field of merit is not in vain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:11.3", "PA_tha-ap_425:11.4", "PA_tha-ap_425:12.1"], "en": "One whose mind is well-directed can uplift oneself by means of this gift of a seat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:12.2"], "en": "And through your volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:12.3", "PA_tha-ap_425:12.4"], "en": "for a hundred thousand eons you shall not go to the lower realms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:13.1", "PA_tha-ap_425:13.2"], "en": "Fifty times you will exercise divine sovereignty as Lord of the Devas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:13.3"], "en": "and eighty times you will be a king.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:13.4"], "en": "\"You shall become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:14.1"], "en": "Your regional sovereignty will be vast,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:14.2"], "en": "beyond all calculation.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:14.3"], "en": "\"Having been happy in every respect,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:14.4"], "en": "you will wander through saṃsāra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:15.1"], "en": "Having said this, the Sambuddha—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:15.2"], "en": "Named Jalajuttama,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:15.3", "PA_tha-ap_425:15.4"], "en": "the hero ascended into the sky like a king of swans in the air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:16.1"], "en": "Elephant-vehicles, horse-vehicles,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:16.2"], "en": "chariots with poles, and wheeled carriages—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:16.3"], "en": "I obtain all of these.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:16.4"], "en": "This is the fruit of sitting on a single seat:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:17.1"], "en": "even when I have entered the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:17.2"], "en": "whenever I desire a seat;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:17.3"], "en": "Knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:17.4", "PA_tha-ap_425:18.1"], "en": "a couch appeared before me as I stood in the midst of the water.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:18.2"], "en": "Whenever I desire a seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:18.3"], "en": "understanding my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:18.4"], "en": "a couch appears before me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:19.1"], "en": "Whichever womb I am reborn into,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:19.2"], "en": "whether among the gods or among humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:19.3"], "en": "[there appear] hundreds of thousands of couches.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:19.4"], "en": "They always attend upon me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:20.1"], "en": "I transmigrate through two states of existence:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:20.2"], "en": "among the gods and among humans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:20.3"], "en": "I am born into two clans:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:20.4"], "en": "among the Kshatriyas and the Brahmins.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:21.1"], "en": "Having given a single seat, [one attains this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:21.2"], "en": "In this unsurpassed field of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:21.3"], "en": "taking up the Dhamma-couch,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:21.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:22.1"], "en": "In a hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:22.2"], "en": "because of the gift I gave then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:22.3"], "en": "I have never known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:22.4"], "en": "This is the fruit of sitting at a single seat:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:23.1", "PA_tha-ap_425:23.2"], "en": "my defilements have been incinerated... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:23.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:24.1", "PA_tha-ap_425:24.2"], "en": "Welcome indeed has come to me... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:24.3"], "en": "Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:25.1", "PA_tha-ap_425:25.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:25.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:26.1"], "en": "In this way, the venerable elder Ekāsanadāyaka indeed spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_425:27.1"], "en": "This is the third *apadāna* of the elder Ekāsanadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
