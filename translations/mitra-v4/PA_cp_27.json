[
{"segs": ["PA_cp_27:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:0.2"], "en": "Yudhañjayavagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:0.3"], "en": "Saccapāramī 1", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:0.4", "PA_cp_27:1.1"], "en": "The Conduct of the Monkey King: “When I was a monkey,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:1.2"], "en": "dwelling in a cave on a riverbank;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:1.3"], "en": "Oppressed by the crocodile,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:1.4"], "en": "I cannot find a way to go;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:2.1"], "en": "from whatever place I stand, I am unable to escape.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:2.2"], "en": "As I was crossing from this shore to the far shore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:2.3"], "en": "there stood an enemy, a murderer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:2.4"], "en": "a crocodile of cruel aspect.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:3.1"], "en": "Thus he said to me, \"Come,\" and I replied to him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:3.2", "PA_cp_27:3.3"], "en": "\"I am coming. Having touched the crown of his head, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:3.4"], "en": "I established myself on the opposite bank.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:4.1"], "en": "No falsehood was spoken by me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:4.2"], "en": "I acted exactly according to my word.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:4.3"], "en": "“There is nothing equal to truth for me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:4.4"], "en": "this is my perfection of truth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_27:4.5"], "en": "Thus ends the seventh chapter, the Conduct of the Monkey King.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
