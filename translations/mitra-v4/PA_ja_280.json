[
{"segs": ["PA_ja_280:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:0.2", "PA_ja_280:0.3"], "en": "The Collection of Threes, Chapter on the Well (Udapānavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:0.4"], "en": "10. The Puṭadūsakajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:1.1", "PA_ja_280:1.2"], "en": "“Surely this king of beasts must indeed be skilled in the art of making baskets;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:1.3"], "en": "\"For he defiles the vessel;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:1.4"], "en": "surely he will do something else.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:2.1"], "en": "\"Neither my mother nor my father,\" [said the child].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:2.2"], "en": "\"Skilled in the art of folding,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:2.3"], "en": "we spoil whatever has been done;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:2.4"], "en": "such is the nature of this family.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:3.1"], "en": "“For those of you for whom such is the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:3.2", "PA_ja_280:3.3"], "en": "what then is non-Dhamma? Do not [confuse] Dhamma with non-Dhamma.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:3.4"], "en": "\"We have never seen [such a thing] at any time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:4.1"], "en": "This is the tenth Jātaka, the Puṭadūsakajātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:4.2"], "en": "The third chapter, the Udapānavagga, is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:5.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:6.1"], "en": "The excellent well, the forest tiger, the monkey,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:6.2"], "en": "the peahen, the crane, and the beautiful Ruciravara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_280:6.3", "PA_ja_280:6.4"], "en": "Furthermore, there were the Sujanādhipa-romaka-dūsa and the hundred-fold excellent leaf-casket work.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
