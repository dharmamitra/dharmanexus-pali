[
{"segs": ["PA_thag_3.2:0.1", "PA_thag_3.2:0.2"], "en": "Theragāthā 3.2 Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:0.4"], "en": "The Verses of the Elder Paccaya:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:1.1"], "en": "“I have been gone forth for five days;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:1.2"], "en": "I am still a trainee, not yet having attained my heart’s goal.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:1.3"], "en": "When I had entered my dwelling,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:1.4"], "en": "a resolution arose in my mind:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:2.1"], "en": "\"I shall neither eat nor drink.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:2.2"], "en": "I shall not go out from the monastery,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:2.3", "PA_thag_3.2:2.4"], "en": "nor shall I cast down my gaze as long as the arrow of craving has not been extracted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:3.1"], "en": "As I was dwelling thus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:3.2"], "en": "behold my exertion of energy:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:3.3"], "en": "the threefold knowledge has been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:3.4"], "en": "“... This is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.2:3.5"], "en": "... The elder Paccaya...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
