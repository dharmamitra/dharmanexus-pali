[
{"segs": ["PA_vv_25:0.1"], "en": "Vimānavatthu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:0.2", "PA_vv_25:0.3"], "en": "The Chapter on the Cittalatā Grove in the Itthivimāna (The Female Vimānas)", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:0.4", "PA_vv_25:1.1"], "en": "8. Niddāvimānavatthu “With such exquisite beauty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:1.2"], "en": "O deity, you stand there;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:1.3", "PA_vv_25:1.4"], "en": "Illuminating all directions like a star among the herbs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:2.1"], "en": "by what cause is your complexion such as this?", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:2.2", "PA_vv_25:2.3"], "en": "\"...and your radiance shines in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:3.1"], "en": "That deity was uplifted in mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:3.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:3.3", "PA_vv_25:4.1"], "en": "\"They knew me as Nidda; this is the fruit of that karma.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:4.2"], "en": "In Rājagaha there was a female lay follower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:4.3"], "en": "endowed with faith and virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:4.4"], "en": "always delighting in sharing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:5.1", "PA_vv_25:5.2", "PA_vv_25:5.3"], "en": "I gave clothing, food, lodgings, and lamps to those who were upright.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:5.4"], "en": "With a serene mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:6.1"], "en": "on the fourteenth, the fifteenth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:6.2"], "en": "and the eighth day of the lunar fortnight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:6.3"], "en": "And during the fortnight of miracles,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:6.4", "PA_vv_25:7.1"], "en": "I shall observe the Uposatha day, perfectly endowed with its eight factors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:7.2"], "en": "Always restrained in our virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:7.3"], "en": "self-controlled and generous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:7.4"], "en": "we now dwell in this celestial mansion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:8.1"], "en": "Abstaining from the destruction of life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:8.2"], "en": "restrained from false speech,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:8.3"], "en": "and from theft and sexual misconduct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:8.4"], "en": "And far removed from the drinking of intoxicants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:9.1", "PA_vv_25:9.2"], "en": "they delight in the five precepts and are skilled in the Noble Truths.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:9.3", "PA_vv_25:9.4"], "en": "I am a female lay follower of Gotama, the illustrious one who possesses vision.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:10.1"], "en": "Because of that, my complexion is such as this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:10.2", "PA_vv_25:10.3"], "en": "\"...and my radiance shines in all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_25:11.1"], "en": "Thus ends the eighth Vimāna, the Niddā-vimāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"}
]
