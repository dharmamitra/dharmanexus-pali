[
{"segs": ["PA_ja_421:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:0.2"], "en": "The Eighth Chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:0.3"], "en": "the Section on Kaccāyana.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:0.4"], "en": "5. The Gaṅgamāla Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:1.1", "PA_ja_421:1.2"], "en": "“The earth is ablaze with embers; the world is filled with glowing coals.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:1.3"], "en": "But if you sing the verses,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:1.4"], "en": "the heat does not distress you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:2.1"], "en": "the sun shines from above.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:2.2"], "en": "The sand below burns;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:2.3"], "en": "yet if you sing your songs,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:2.4"], "en": "the heat does not burn you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:3.1"], "en": "“The sun does not scorch me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:3.2"], "en": "nor do the sun’s rays scorch me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:3.3"], "en": "for there are many purposes, O King.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:3.4"], "en": "They burn, not the sun’s heat.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:4.1"], "en": "“I have seen the root of sensual desire:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:4.2"], "en": "Sensual desire is born from intention.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:4.3"], "en": "\"I shall not intend that;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:4.4"], "en": "thus, O desire, you shall not come to be.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:5.1"], "en": "\"Even a little desire is not enough,\" [he said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:5.2"], "en": "He is not satisfied even with much;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:5.3"], "en": "\"Alas, the chatter of fools!\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:5.4"], "en": "thus one who is awake should avoid it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:6.1", "PA_ja_421:6.2"], "en": "“This is the fruit of my own small deed, that Udaya has attained such great eminence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:6.3"], "en": "Truly, what a gain for the young man! What a wonderful acquisition!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:6.4"], "en": "“He who has gone forth, having abandoned sensual lust.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:7.1"], "en": "“By austerity they abandon evil karma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:7.2"], "en": "by austerity they wash away the state of being a potter.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:7.3"], "en": "“Having overcome Gaṅgamāla by means of asceticism (tapas),", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:7.4"], "en": "he addressed Brahmadatta by name:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:8.1"], "en": "‘Look, mother, at this very visible result!’”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:8.2"], "en": "This is the fruit of patience and gentleness:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:8.3"], "en": "that one is honored by all people.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:8.4"], "en": "Therefore, together with our kings and ministers, we pay homage to you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:9.1"], "en": "“Say nothing at all to Gaṅgamālā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:9.2"], "en": "who is training in the paths of silence of the Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:9.3"], "en": "for she has crossed over the ocean.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:9.4"], "en": "\"Having crossed over which, they wander free from sorrow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_421:10.1"], "en": "Thus ends the fifth Jātaka, the Gaṅgamāla Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
