[
{"segs": ["PA_thag_5.11:0.1", "PA_thag_5.11:0.2", "PA_thag_5.11:0.3"], "en": "Theragāthā 5.11 Pañcaka-nipāta First Chapter (Paṭhama-vagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:0.4"], "en": "The Verse of the Elder Soṇakuṭikaṇṇa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:1.1"], "en": "“I have received full ordination,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:1.2"], "en": "and I am liberated, free from taints.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:1.3"], "en": "And so I have seen the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:1.4", "PA_thag_5.11:2.1"], "en": "and I dwelt with him in his dwelling for much of the night. The Blessed One—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:2.2"], "en": "He directed him toward the open air;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:2.3"], "en": "then the Teacher, skilled in dwellings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:2.4"], "en": "entered his dwelling.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:3.1"], "en": "Having spread out his outer robe,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:3.2"], "en": "Gotama made his bed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:3.3"], "en": "like a lion in a rocky cave.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:3.4"], "en": "Having abandoned fear and terror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:4.1"], "en": "he is one of beautiful speech,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:4.2"], "en": "a disciple of the Perfectly Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:4.3", "PA_thag_5.11:4.4"], "en": "Soṇa spoke the true Dhamma in the presence of the Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:5.1"], "en": "having fully understood the five aggregates.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:5.2", "PA_thag_5.11:5.3"], "en": "Having cultivated the straight path and attained supreme peace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:5.4"], "en": "he shall attain final nibbāna, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.11:5.5"], "en": "… the Elder Soṇa Kuṭikaṇṇa …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
