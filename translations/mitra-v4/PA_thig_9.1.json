[
{"segs": ["PA_thig_9.1:0.1", "PA_thig_9.1:0.2"], "en": "Therīgāthā 9.1 Navakanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:0.3"], "en": "The Verses of the Elder Nun Vaḍḍhamātā", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:1.1", "PA_thig_9.1:1.2"], "en": "“O elder, may you never have any forest-thicket of craving in this world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:1.3"], "en": "O son, may it not arise again and again.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:1.4"], "en": "They have become sharers in suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:2.1"], "en": "But the sages, O Vaḍḍha, are happy—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:2.2"], "en": "unshaken, with their doubts severed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:2.3"], "en": "Having become cool and attained self-mastery,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:2.4"], "en": "they dwell free from taints;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:3.1"], "en": "that which was practiced by those seers—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:3.2"], "en": "The path for attaining vision;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:3.3"], "en": "for the making of an end to suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:3.4"], "en": "O Vaḍḍha, you must cultivate it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:4.1"], "en": "“You speak with confidence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:4.2"], "en": "giving rise to this meaning for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:4.3"], "en": "I think so indeed, O dear lady.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:4.4"], "en": "“No forest exists for you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:5.1"], "en": "“Whatever conditioned phenomena there are,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:5.2"], "en": "whether inferior, superior, or middling;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:5.3", "PA_thig_9.1:5.4"], "en": "Not even an atom, not even the slightest, of the forest-thicket of craving exists within me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:6.1"], "en": "all my taints are exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:6.2"], "en": "For one who meditates with diligence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:6.3"], "en": "the three true insights have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:6.4"], "en": "the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:7.1", "PA_thig_9.1:7.2"], "en": "“Exalted indeed was the goad my mother uttered to me—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:7.3"], "en": "verses endowed with the ultimate goal.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:7.4"], "en": "Just as she was compassionate,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:8.1", "PA_thig_9.1:8.2"], "en": "having heard those words of instruction from my mother, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:8.3", "PA_thig_9.1:8.4"], "en": "I experienced a sense of spiritual urgency for the sake of attaining security from bondage. Thus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:9.1"], "en": "with my mind intent on exertion, I strove.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:9.2"], "en": "Unwearied by day and night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:9.3"], "en": "urged on by my mother,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:9.4"], "en": "I attained supreme peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_9.1:10.1", "PA_thig_9.1:11.1"], "en": "… The Elder Nun Vaḍḍhamātā … The Ninth Chapter is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"}
]
