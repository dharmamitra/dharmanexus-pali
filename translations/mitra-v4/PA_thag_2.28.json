{"segs": ["PA_thag_2.28:0.1"], "en": "Theragāthā 2.28 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.28:0.2", "PA_thag_2.28:0.3"], "en": "Tatiyavagga (The Third Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.28:0.4"], "en": "Bharata Thera’s Verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.28:1.1", "PA_thag_2.28:1.2"], "en": "“Come, Nandaka, let us go into the presence of our preceptor.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.28:1.3", "PA_thag_2.28:1.4"], "en": "We shall roar the lion’s roar in the presence of the Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.28:2.1"], "en": "out of the compassion he has for us.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.28:2.2"], "en": "“The Sage has caused us to go forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.28:2.3"], "en": "that goal of ours has been attained:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.28:2.4"], "en": "the destruction of all fetters.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.28:2.5"], "en": "… the Elder Bharata …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
