[
{"segs": ["PA_bv_29:0.1"], "en": "Buddhavamsa 29.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:0.2"], "en": "The Discourse on the Distribution of Relics.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:1.1"], "en": "The supreme Victor, Mahāgotama,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:1.2"], "en": "He attained Parinibbāna at Kusinārā;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:1.3", "PA_bv_29:1.4"], "en": "his relics were distributed throughout various regions.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:2.1"], "en": "One [was] at Ajātasattu’s [court],", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:2.2"], "en": "one in the city of Vesālī;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:2.3"], "en": "one in Kapilavatthu.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:2.4", "PA_bv_29:3.1"], "en": "One at Allakappa, one at Rāmagāma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:3.2"], "en": "and one at Veṭhadīpa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:3.3", "PA_bv_29:3.4", "PA_bv_29:4.1"], "en": "One Mallan from Pāvā and one from Kosinārā erected a stupa for Kumba.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:4.2"], "en": "The brahmin named Doṇa and the Moriyas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:4.3", "PA_bv_29:4.4"], "en": "with joyful minds, caused the Aṅgārathūpa to be built.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:5.1"], "en": "There are eight relic stūpas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:5.2"], "en": "the ninth is the Kumbha-cetiya,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:5.3"], "en": "and the tenth is the Aṅgāra-stūpa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:5.4"], "en": "At that very time he was established [in the fruit].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:6.1"], "en": "There are the uṣṇīṣa, four fangs,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:6.2"], "en": "and two eye-ball relics.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:6.3"], "en": "These seven elements are inseparable;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:6.4"], "en": "the remaining elements are indeed distinct.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:7.1"], "en": "They are large, the size of a mung bean.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:7.2"], "en": "The middling ones are split grains of rice;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:7.3"], "en": "the small ones are the size of mustard seeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:7.4"], "en": "and there are relics of various colors.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:8.1"], "en": "The large ones are golden-colored,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:8.2"], "en": "the medium-sized ones are the color of pearls,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:8.3"], "en": "and the small ones are the color of buds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:8.4"], "en": "Sixteen *doṇa* measures of clay [make one].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:9.1"], "en": "Five large *nāḷi* measures,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:9.2"], "en": "five medium *nāḷi* measures;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:9.3", "PA_bv_29:9.4", "PA_bv_29:10.1"], "en": "The six small tubes and all these elements are present on the island of Sri Lanka at the Uṇhīsa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:10.2"], "en": "Vāmaka in the Brahma-world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:10.3"], "en": "and Dakkhiṇañña in Siṃhala—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:10.4"], "en": "all these have been firmly established.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:11.1"], "en": "One tooth was in the city of the Thirty-three,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:11.2"], "en": "one was in the city of the Nagas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:11.3"], "en": "and one was in the realm of Gandhara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:11.4", "PA_bv_29:12.1"], "en": "One [tooth] belonged to the King of Kaliṅga. Forty teeth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:12.2"], "en": "along with all the hair of the head and body, were entirely [taken].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:12.3"], "en": "The gods seized each one [of the hairs],", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:12.4"], "en": "extending as far as the successive world-systems (cakkavāḷa).", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:13.1"], "en": "This was the diamond-like [resolve] of the Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:13.2"], "en": "The staff, the robe,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:13.3", "PA_bv_29:13.4"], "en": "the lower garment, and the rug in the house of the Kapila clan were obtained.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:14.1"], "en": "In the city of Pāṭaliputta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:14.2"], "en": "a legal document and a waist-band;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:14.3"], "en": "in Campā, a water-strainer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:14.4"], "en": "And woolen cloth in Kosala,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:15.1"], "en": "the saffron robe in the Brahma-world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:15.2"], "en": "and the turban in the city of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:15.3"], "en": "The sitting mat was in the Avanti country,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:15.4"], "en": "and the rug was then in the kingdom;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:16.1"], "en": "the fire-drills were in Mithilā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:16.2"], "en": "In Videha, he gave a fan;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:16.3"], "en": "and in Indapatthapura,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:16.4"], "en": "he then gave a needle-case.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:17.1", "PA_bv_29:17.2", "PA_bv_29:17.3"], "en": "The remaining requisites in the western country were used by the Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:17.4"], "en": "Thus did the people act at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:18.1", "PA_bv_29:18.2"], "en": "The relics of the Great Sage Gotama became widely distributed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:18.3"], "en": "\"Out of compassion for living beings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_29:18.4"], "en": "there was that ancient [custom],\" so it is said.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
