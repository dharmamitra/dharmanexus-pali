[
{"segs": ["PA_thig_7.1:0.1", "PA_thig_7.1:0.2", "PA_thig_7.1:0.3"], "en": "Therīgāthā 7.1 Sattakanipāta Uttarātherīgāthā The Verses of the Elder Nun Uttarā, from the Seventh Chapter (Sattaka-nipāta) of the *Therīgāthā*.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:1.1"], "en": "“Taking up pestles,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:1.2"], "en": "young men pound grain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:1.3"], "en": "supporting their wives and children.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:1.4"], "en": "Young men acquire wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:2.1"], "en": "Strive in the teaching of the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:2.2"], "en": "having done so, one does not regret it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:2.3", "PA_thig_7.1:2.4"], "en": "Quickly wash your feet and sit down to one side;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:3.1"], "en": "having established mindfulness, [sit there].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:3.2"], "en": "With a one-pointed and well-concentrated mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:3.3", "PA_thig_7.1:3.4"], "en": "examine conditioned phenomena as \"other\" and not as \"self.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:4.1"], "en": "“Having heard her words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:4.2"], "en": "the instruction of Paṭācārā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:4.3"], "en": "and having washed my feet, I— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:4.4"], "en": "I sat down to one side.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:5.1"], "en": "During the first watch of the night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:5.2"], "en": "I recollected my former births.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:5.3"], "en": "During the middle watch of the night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:5.4"], "en": "I purified the divine eye;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:6.1"], "en": "during the final watch of the night,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:6.2"], "en": "I shattered the mass of darkness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:6.3"], "en": "having attained the threefold knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:6.4"], "en": "I have arisen, and your instruction has been fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:7.1", "PA_thig_7.1:7.2", "PA_thig_7.1:7.3"], "en": "Surrounded by them, I shall dwell like Sakka, unconquered in battle, amidst the gods of the Thirty-Three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:7.4"], "en": "“I am possessed of the three knowledges and free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_7.1:8.1"], "en": "… The Elder Nun Uttarā …", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"}
]
