{"segs": ["PA_ja_17:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_17:0.2", "PA_ja_17:0.3"], "en": "Ekakanipāta, Sīlavagga (The Chapter on Virtue)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_17:0.4"], "en": "7. The Mālutajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_17:1.1", "PA_ja_17:1.2"], "en": "“Whether it be dark or bright, whenever the wind blows;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_17:1.3"], "en": "\"For things born of wind are cold;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_17:1.4"], "en": "both [trees] stand undefeated.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_17:2.1"], "en": "Thus ends the seventh Jātaka, the Māluṭa-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
