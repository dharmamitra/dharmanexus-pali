    {
        "segmentnr": "PA_pp_1.3:1.1",
        "original": "Tayo puggalā—",
        "analyzed": "tayo puggalā ",
        "folio": "1",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#1.1"
    },
    {
        "segmentnr": "PA_pp_1.3:2.1",
        "original": "Nirāso, āsaṁso, vigatāso.",
        "analyzed": "nirāsaḥ āsasaḥ vigatāsaḥ ",
        "folio": "2",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#2.1"
    },
    {
        "segmentnr": "PA_pp_1.3:3.1",
        "original": "Tayo gilānūpamā puggalā.",
        "analyzed": "tayaḥ gilāna upamā puggalā ",
        "folio": "3",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#3.1"
    },
    {
        "segmentnr": "PA_pp_1.3:4.1",
        "original": "Kāyasakkhī, diṭṭhippatto, saddhāvimutto.",
        "analyzed": "kāya sakkhī diṭṭhi ppatto saddhā vimutto ",
        "folio": "4",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#4.1"
    },
    {
        "segmentnr": "PA_pp_1.3:5.1",
        "original": "Gūthabhāṇī, pupphabhāṇī, madhubhāṇī.",
        "analyzed": "gūtha bhāṇī puppha bhāṇī madhu bhāṇī ",
        "folio": "5",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#5.1"
    },
    {
        "segmentnr": "PA_pp_1.3:6.1",
        "original": "Arukūpamacitto puggalo, vijjūpamacitto puggalo, vajirūpamacitto puggalo.",
        "analyzed": "arukū upama cittaḥ puggalaḥ vijju upama cittaḥ puggalaḥ vajirūpama cittaḥ puggalaḥ ",
        "folio": "6",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#6.1"
    },
    {
        "segmentnr": "PA_pp_1.3:7.1",
        "original": "Andho, ekacakkhu, dvicakkhu.",
        "analyzed": "andhaḥ eka cakkhu dvi cakkhu ",
        "folio": "7",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#7.1"
    },
    {
        "segmentnr": "PA_pp_1.3:8.1",
        "original": "Avakujjapañño puggalo, ucchaṅgapañño puggalo, puthupañño puggalo.",
        "analyzed": "avakujja pañño puggalo ucchaṅga pañño puggalo puthu pañño puggalo ",
        "folio": "8",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#8.1"
    },
    {
        "segmentnr": "PA_pp_1.3:9.1",
        "original": "Atthekacco puggalo kāmesu ca bhavesu ca avītarāgo, atthekacco puggalo kāmesu vītarāgo bhavesu avītarāgo, atthekacco puggalo kāmesu ca bhavesu ca vītarāgo.",
        "analyzed": "attha ekaccaḥ puggalo kāmesu ca bhavesu ca avīta rāgaḥ attha ekaccaḥ puggalo kāmesu vīta rāgaḥ bhavesu avīta rāgaḥ attha ekaccaḥ puggalo kāmesu ca bhavesu ca vīta rāgaḥ ",
        "folio": "9",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#9.1"
    },
    {
        "segmentnr": "PA_pp_1.3:10.1",
        "original": "Pāsāṇalekhūpamo puggalo, pathavilekhūpamo puggalo, udakalekhūpamo puggalo.",
        "analyzed": "pāsāṇa lekhu upamaḥ puggalaḥ pathavi lekhu upamaḥ puggalaḥ udaka lekhu upamaḥ puggalaḥ ",
        "folio": "10",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#10.1"
    },
    {
        "segmentnr": "PA_pp_1.3:11.1",
        "original": "Tayo potthakūpamā puggalā.",
        "analyzed": "tayo potthakū upamā puggalā ",
        "folio": "11",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#11.1"
    },
    {
        "segmentnr": "PA_pp_1.3:12.1",
        "original": "Tayo kāsikavatthūpamā puggalā.",
        "analyzed": "tayo kāsika vatthu upamā puggalā ",
        "folio": "12",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#12.1"
    },
    {
        "segmentnr": "PA_pp_1.3:13.1",
        "original": "Suppameyyo, duppameyyo, appameyyo.",
        "analyzed": "suppameyyaḥ duppameyyaḥ appameyyaḥ ",
        "folio": "13",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#13.1"
    },
    {
        "segmentnr": "PA_pp_1.3:14.1_0",
        "original": "Atthekacco puggalo na sevitabbo na bhajitabbo na payirupāsitabbo, atthekacco puggalo",
        "analyzed": "attha ekaccaḥ puggalaḥ na sevitabbaḥ na bhajitabbaḥ na payirupāsitabbaḥ attha ekaccaḥ puggalo ",
        "folio": "14",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#14.1_0"
    },
    {
        "segmentnr": "PA_pp_1.3:14.1_1",
        "original": "sevitabbo bhajitabbo payirupāsitabbo, atthekacco puggalo sakkatvā garuṁ katvā sevitabbo",
        "analyzed": "sevitabbaḥ bhajitabbaḥ payirupāsitabbaḥ attha ekaccaḥ puggalo sakkatvā garum katvā sevitabbo ",
        "folio": "14",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#14.1_1"
    },
    {
        "segmentnr": "PA_pp_1.3:14.1_2",
        "original": "bhajitabbo payirupāsitabbo.",
        "analyzed": "bhajitabbo payirupāsitabbo ",
        "folio": "14",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#14.1_2"
    },
    {
        "segmentnr": "PA_pp_1.3:15.1",
        "original": "Atthekacco puggalo jigucchitabbo na sevitabbo na bhajitabbo na payirupāsitabbo, atthekacco puggalo ajjhupekkhitabbo na sevitabbo na bhajitabbo na payirupāsitabbo;",
        "analyzed": "attha ekaccaḥ puggalaḥ jigucchitabbaḥ na sevitabbaḥ na bhajitabbaḥ na payirupāsitabbaḥ attha ekaccaḥ puggalaḥ ajjhupekkhitabbaḥ na sevitabbaḥ na bhajitabbaḥ na payirupāsitabbaḥ ",
        "folio": "15",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#15.1"
    },
    {
        "segmentnr": "PA_pp_1.3:15.2",
        "original": "atthekacco puggalo sevitabbo bhajitabbo payirupāsitabbo.",
        "analyzed": "attha ekaccaḥ puggalo sevitabbaḥ bhajitabbaḥ payirupāsitabbaḥ ",
        "folio": "15",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#15.2"
    },
    {
        "segmentnr": "PA_pp_1.3:16.1",
        "original": "Atthekacco puggalo sīlesu paripūrakārī, samādhismiṁ mattaso kārī, paññāya mattaso kārī;",
        "analyzed": "attha ekaccaḥ puggalo sīlesu paripūra kārī samādhismim mattasas kārī paññāya mattasas kārī ",
        "folio": "16",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#16.1"
    },
    {
        "segmentnr": "PA_pp_1.3:16.2",
        "original": "atthekacco puggalo sīlesu ca paripūrakārī, samādhismiñca paripūrakārī, paññāya mattaso kārī;",
        "analyzed": "attha ekacco puggalo sīlesu ca paripūra kārī samādhismiñca paripūra kārī paññāya mattasaḥ kārī ",
        "folio": "16",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#16.2"
    },
    {
        "segmentnr": "PA_pp_1.3:16.3",
        "original": "atthekacco puggalo sīlesu ca paripūrakārī, samādhismiñca paripūrakārī, paññāya ca paripūrakārī.",
        "analyzed": "attha ekaccaḥ puggalo sīlesu ca paripūra kārī samādhismiñca paripūra kārī paññāya ca paripūra kārī ",
        "folio": "16",
        "suttacentral_link": "https://suttacentral.net/pp1.3/pli/ms#16.3"
    },
    {
