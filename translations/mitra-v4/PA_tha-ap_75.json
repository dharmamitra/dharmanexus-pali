[
{"segs": ["PA_tha-ap_75:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:0.2"], "en": "The Section on the Nāgasamāla Chapter, 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:0.3"], "en": "The Apadāna of the Elder Buddhasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:1.1", "PA_tha-ap_75:1.2"], "en": "Seeing a rag-robe clinging to the Teacher’s hem on the dusty road,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:1.3"], "en": "he then pressed his palms together in reverence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:1.4"], "en": "I paid homage to a rag-robe wearer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:2.1"], "en": "Ninety-two aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:2.2"], "en": "that deed which I performed then—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:2.3"], "en": "I do not recall ever being born in an unhappy state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:2.4"], "en": "this is the fruit of perceiving the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:3.1"], "en": "In the fourth aeon from now...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:3.2"], "en": "You are a Khattiya of pure lineage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:3.3"], "en": "you are a conqueror of the four quarters,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:3.4"], "en": "a wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:4.1", "PA_tha-ap_75:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:5.1"], "en": "Thus indeed the venerable elder Buddhasaññaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_75:6.1"], "en": "This is the third legend of the elder Buddhasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
