[
{"segs": ["PA_thag_10.5:0.1", "PA_thag_10.5:0.2", "PA_thag_10.5:0.3"], "en": "Theragāthā 10.5 Dasaka-nipāta Paṭhama-vagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:0.4"], "en": "The Verses of the Elder Kappa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:1.1"], "en": "“Filled with various kinds of filth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:1.2"], "en": "produced from a great mass of excrement;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:1.3"], "en": "Like a ripe *candana* fruit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:1.4"], "en": "it is a great boil, a great ulcer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:2.1"], "en": "filled with pus and blood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:2.2", "PA_thag_10.5:2.3"], "en": "The body is submerged in a pit of excrement;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:2.4"], "en": "it is a flowing stream of water that constantly drips with putridity.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:3.1"], "en": "Connected by sixty tendons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:3.2"], "en": "plastered with a coating of flesh,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:3.3"], "en": "and bound by the sheath of skin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:3.4"], "en": "This putrid body is utterly useless;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:4.1", "PA_thag_10.5:4.2"], "en": "it is constructed as a framework of bones and bound together by cords of sinews.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:4.3"], "en": "Through the convergence of many factors,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:4.4"], "en": "one fashions the postures;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:5.1"], "en": "one is constantly proceeding toward death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:5.2"], "en": "In the presence of the King of Death;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:5.3"], "en": "having cast it right here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:5.4"], "en": "a person goes wherever they wish.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:6.1"], "en": "The body is shrouded by ignorance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:6.2"], "en": "bound by the four ties;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:6.3"], "en": "the body is sinking in the flood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:6.4"], "en": "Enmeshed in the net of underlying tendencies,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:7.1"], "en": "intent upon the five hindrances,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:7.2"], "en": "and absorbed in discursive thought;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:7.3"], "en": "Followed by the root of craving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:7.4"], "en": "covered by the veil of delusion—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:8.1"], "en": "thus does this body proceed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:8.2"], "en": "Driven by the machinery of karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:8.3"], "en": "prosperity ends in misfortune,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:8.4"], "en": "and diversity leads to ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:9.1", "PA_thag_10.5:9.2", "PA_thag_10.5:9.3"], "en": "Those blind fools, worldlings, who claim this body as \"mine,\" only increase the terrible charnel ground.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:9.4"], "en": "They take up renewed existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:10.1", "PA_thag_10.5:10.2"], "en": "Those who cast off this body as one would a snake smeared with filth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:10.3"], "en": "“Having vomited up the root of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:10.4"], "en": "they will attain final nibbāna, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.5:10.5"], "en": "… [Thus spoke] the Elder Kappa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
