[
{"segs": ["PA_tha-ap_317:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:0.2", "PA_tha-ap_317:0.3"], "en": "The Chapter on the Giver of Protection (Ārakkhadāyakavagga), Number 5: The Apadāna of the Elder Pupphāsanadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:1.1", "PA_tha-ap_317:1.2"], "en": "“The Sambuddha, golden-hued like the sun with its yellow rays,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:1.3"], "en": "was walking not far away.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:1.4"], "en": "To the invincible Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:2.1", "PA_tha-ap_317:2.2"], "en": "having gone out to meet him and led him into the hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:2.3", "PA_tha-ap_317:2.4"], "en": "With a mind full of serene confidence, I offered a seat of flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:3.1"], "en": "having raised my hands in reverent salutation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:3.2"], "en": "Then, having been born as a Veda-learned brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:3.3"], "en": "I, having inspired confidence in my mind toward the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:3.4"], "en": "dedicated that kamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:4.1", "PA_tha-ap_317:4.2"], "en": "Whatever merit I have performed, O Self-Existent One, unconquered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:4.3"], "en": "by all that wholesome deed, may I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:4.4"], "en": "I became pure in the Teaching.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:5.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:5.2"], "en": "I then offered a seat of flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:5.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:5.4"], "en": "this is the fruit of the flower-seat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:6.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:7.1"], "en": "Thus indeed did the Venerable Elder Pupphāsanadāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_317:8.1"], "en": "The legend of the Elder Pupphāsanadāyaka is the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
