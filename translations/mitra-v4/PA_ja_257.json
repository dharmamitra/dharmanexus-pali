[
{"segs": ["PA_ja_257:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_257:0.2", "PA_ja_257:0.3"], "en": "Tikanipāta, Saṅkappavagga (The Chapter on Intention)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_257:0.4"], "en": "7. The Gāmaṇicanda Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_257:1.1"], "en": "“This man is not skilled in household affairs;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_257:1.2"], "en": "he is fickle and wrinkled-faced.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_257:1.3"], "en": "What that has been done could corrupt;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_257:1.4"], "en": "such is the nature of this family.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_257:2.1"], "en": "This does not move even a hair on one who possesses mindfulness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_257:2.2"], "en": "This deer is not one who can be comforted;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_257:2.3", "PA_ja_257:2.4"], "en": "I have heard from the crowd of people that he understands nothing at all.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_257:3.1", "PA_ja_257:3.2", "PA_ja_257:3.3"], "en": "Such a person would not support his mother or father, nor his brother or sister.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_257:3.4"], "en": "“Thus it was told to me by Daśaratha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_257:4.1"], "en": "The seventh Jātaka, the Gāmaṇicanda Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
