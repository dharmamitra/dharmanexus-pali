[
{"segs": ["PA_iti_2:0.1"], "en": "Itivuttaka 2:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:0.2", "PA_iti_2:0.3"], "en": "Ekakanipāta, First Chapter (Paṭhamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:0.4"], "en": "The Discourse on Faults.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:1.1"], "en": "This was said by the Blessed One, said by the Arahant, so I have heard:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:2.1"], "en": "“Bhikkhus, abandon one thing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:2.2"], "en": "I am your guarantor for non-returning.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:2.3"], "en": "What is that one thing?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:2.4"], "en": "Abandon hatred, monks; that is the one thing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:2.5"], "en": "“I am your guarantor for non-returning.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:2.6"], "en": "This is what the Blessed One said.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:2.7"], "en": "Regarding this, it is said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:3.1", "PA_iti_2:3.2", "PA_iti_2:3.3"], "en": "“Having fully understood that hatred by which beings, corrupted by hatred, go to an evil destination— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:3.4"], "en": "Those who possess insight abandon them;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:3.5", "PA_iti_2:3.6"], "en": "having abandoned them, they never again return to this world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:4.1"], "en": "\"This matter too was spoken by the Blessed One; thus have I heard.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_2:4.2"], "en": "The second [sutta].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
