[
{"segs": ["PA_tha-ap_152:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:0.2", "PA_tha-ap_152:0.3"], "en": "Chapter on the Umbrella (Chattavagga), Number 10: The Apadāna of the Elder Pallaṅkadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:1.1"], "en": "“To the Blessed One Sumedha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:1.2"], "en": "the Elder of the World, the Neutral One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:1.3"], "en": "I indeed gave a couch.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:1.4"], "en": "It was adorned with a hundred and one coverings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:2.1", "PA_tha-ap_152:2.2"], "en": "At that time, there was a couch endowed with the seven precious gems.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:2.3"], "en": "Knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:2.4"], "en": "it always arises for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:3.1"], "en": "throughout thirty thousand kappas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:3.2"], "en": "I gave a couch back then;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:3.3"], "en": "I do not know any state of misery—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:3.4"], "en": "this is the fruit of that couch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:4.1"], "en": "In the twenty thousandth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:4.2"], "en": "three persons with golden radiance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:4.3"], "en": "endowed with the seven treasures, [will appear].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:4.4"], "en": "Universal monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:5.1", "PA_tha-ap_152:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:6.1"], "en": "It is said that the venerable elder Pallaṅkadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:7.1"], "en": "This is the tenth legend of the elder Pallaṅkadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:8.1"], "en": "The fifteenth chapter: the Chapter on the Parasol.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:9.1", "PA_tha-ap_152:10.1"], "en": "Its summary verse: The parasol, the pillar, and the altar;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:10.2", "PA_tha-ap_152:10.3"], "en": "Parivāra, Pupphiya; Anulepa, Magga,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:10.4"], "en": "Phalaka, and Vaṭaṃsaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_152:10.5", "PA_tha-ap_152:10.6"], "en": "And fifty-six verses on the giver of the palanquin have been recited.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
