[
{"segs": ["PA_tha-ap_343:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:0.2"], "en": "Ekapadumiyavagga 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:0.3"], "en": "The Apadāna of the Elder Ekapadumiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:1.2"], "en": "who has gone beyond all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:1.3"], "en": "revealing the nature of existence and non-existence— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:1.4"], "en": "I ferried across many people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:2.1"], "en": "At that time I was a king of swans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:2.2"], "en": "the most excellent among the twice-born.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:2.3"], "en": "Having entered the Jātassara lake,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:2.4"], "en": "I sported with the play of a swan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:3.1"], "en": "Padumuttara, the Knower of the World—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:3.2"], "en": "The recipient of the oblations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:3.3", "PA_tha-ap_343:3.4"], "en": "the Conqueror, arrived right then over the lake that had just been born.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:4.1"], "en": "Having seen the God of Gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:4.2"], "en": "the Self-Existent One, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:4.3"], "en": "I cut the stalk of the lotus.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:4.4"], "en": "A hundred-petaled, mind-delighting lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:5.1"], "en": "having picked it up with his snout,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:5.2"], "en": "he offered it with faith to the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:5.3"], "en": "Having tossed it into the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:5.4"], "en": "I made an offering to the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:6.1"], "en": "Padumuttara, the Knower of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:6.2", "PA_tha-ap_343:6.3"], "en": "The Teacher, stationed in the sky, the recipient of the offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:6.4"], "en": "bestowed upon me his expression of appreciation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:7.1"], "en": "“By means of this single lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:7.2"], "en": "and through my volitions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:7.3"], "en": "for a hundred thousand eons,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:7.4"], "en": "\"You shall not go to a state of ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:8.1"], "en": "Having said this, the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:8.2"], "en": "whose name is the Supreme among those born from the Waters;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:8.3"], "en": "Having proclaimed my deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:8.4"], "en": "he went to where he had aspired.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:9.1"], "en": "One hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:9.2"], "en": "Whatever deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:9.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:9.4"], "en": "this is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:10.1"], "en": "The four analytical knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:10.2"], "en": "these eight liberations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:10.3"], "en": "and the six direct knowledges have been realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:10.4"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:11.1"], "en": "Thus indeed did the venerable elder Ekapadumiya recite these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_343:12.1"], "en": "This is the first legend of the elder Ekapadumiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
