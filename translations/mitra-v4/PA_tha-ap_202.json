[
{"segs": ["PA_tha-ap_202:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:0.2"], "en": "The Chapter on the Tamāla Flower, Number Ten:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:0.3"], "en": "The Apadāna of the Elder Yūthikapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:1.2"], "en": "the recipient of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:1.3"], "en": "having gone forth from the forest,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:1.4"], "en": "The One with Vision goes to the monastery,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:2.1", "PA_tha-ap_202:2.2"], "en": "taking up with both hands the most excellent *yūthikā* flower.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:2.3"], "en": "I offered it to the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:2.4"], "en": "the Tathāgata of loving heart;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:3.1"], "en": "by that clarity of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:3.2"], "en": "Having experienced such success,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:3.3"], "en": "for a hundred thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:3.4"], "en": "I did not fall into an unhappy destination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:4.1"], "en": "Within these fifty aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:4.2", "PA_tha-ap_202:4.3"], "en": "I was once a lord of men named Samittanandana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:4.4"], "en": "A wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:5.1", "PA_tha-ap_202:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:5.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:6.1"], "en": "Thus indeed did the venerable elder Yūthikapupphiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:7.1"], "en": "This is the tenth legend of the elder Yūthikapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:7.2"], "en": "The twentieth chapter, the Tamālapupphiya-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:8.1"], "en": "Its summary (uddāna) is:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:9.1"], "en": "Tamāla, tiṇa, santhāra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:9.2"], "en": "Khaṇḍaphullī and Asokī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:9.3"], "en": "Aṅkolakī and Kisalayā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:9.4"], "en": "Tindukī and Nelapupphikā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:9.5"], "en": "Kiṅkaṇika and Yūthika,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:9.6"], "en": "and fifty-eight verses;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:10.1"], "en": "this is the summary of the Vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:11.1"], "en": "Bhikkhādāyī, Parivāra,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:11.2"], "en": "Sereyya, and Sobhita;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:11.3"], "en": "Chatta and Bandhujīvī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:11.4", "PA_tha-ap_202:12.1"], "en": "And Supāricariya as well. Kumuda, Kuṭaja,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:12.2"], "en": "and Tamāli was made the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:12.3", "PA_tha-ap_202:12.4"], "en": "Sixty-six and more verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:13.1"], "en": "The decade on the Chapter of Monks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_202:14.1"], "en": "The second hundred is completed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
