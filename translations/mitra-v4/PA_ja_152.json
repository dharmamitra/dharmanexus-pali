[
{"segs": ["PA_ja_152:0.1", "PA_ja_152:0.2", "PA_ja_152:0.3"], "en": "Jātaka: The Second Book of Birth Stories (Dukanipāta), Chapter on the Firm (Daḷhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_152:0.4"], "en": "2. The Siṅgālajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_152:1.1", "PA_ja_152:1.2"], "en": "“To one who has not examined his own actions, who acts with hasty precipitation;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_152:1.3"], "en": "“Those deeds burn him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_152:1.4"], "en": "like hot food placed in the mouth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_152:2.1"], "en": "“And the lion, with his lion’s roar...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_152:2.2"], "en": "He made the daddara tree resound;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_152:2.3"], "en": "having heard the roar of the lion,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_152:2.4"], "en": "the jackal fell under the daddara's control.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_152:2.5"], "en": "Terrified, he fell into a state of panic,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_152:2.6"], "en": "and his heart failed him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_152:3.1"], "en": "Thus ends the second Jātaka, the Siṅgāla Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
