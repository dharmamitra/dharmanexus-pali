[
{"segs": ["PA_thig_3.2:0.1", "PA_thig_3.2:0.2", "PA_thig_3.2:0.3"], "en": "Therīgāthā 3.2, Tikanipāta, Uttamā Therīgāthā The Verses of the Elder Nun Uttamā, from the Third Book (Tikanipāta) of the *Therīgāthā*.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.2:1.1", "PA_thig_3.2:1.2"], "en": "Four times and five times I went out from my dwelling;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.2:1.3"], "en": "not finding peace of mind, I left.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.2:1.4"], "en": "She had no mastery over her mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.2:2.1", "PA_thig_3.2:2.2"], "en": "She approached a bhikkhunī who was my source of faith.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.2:2.3"], "en": "She taught me the Dhamma:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.2:2.4"], "en": "the aggregates, the sense bases, and the elements.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.2:3.1"], "en": "Having heard her Dhamma, I...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.2:3.2"], "en": "Just as she instructed me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.2:3.3"], "en": "I sat for seven days in a single cross-legged posture,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.2:3.4"], "en": "absorbed in the bliss of rapture.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.2:3.5", "PA_thig_3.2:3.6"], "en": "\"On the eighth day I stretched out my feet, having shattered the mass of darkness. ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_3.2:4.1"], "en": "[Thus spoke] the Elder Nun Uttamā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"}
]
