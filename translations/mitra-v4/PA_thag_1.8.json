[
{"segs": ["PA_thag_1.8:0.1", "PA_thag_1.8:0.2"], "en": "Theragāthā 1.8 Ekakanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.8:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.8:0.4"], "en": "The Verses of Vīra Thera:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.8:1.1"], "en": "“He who was difficult to tame has been tamed by self-mastery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.8:1.2"], "en": "the hero is contented, having crossed over doubt.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.8:1.3"], "en": "“Vijitāvī, with his hair and down gone,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.8:1.4"], "en": "that hero has attained final nibbāna, established in himself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.8:1.5"], "en": "Thus indeed did the venerable elder Vīra speak this verse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
