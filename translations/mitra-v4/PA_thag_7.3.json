[
{"segs": ["PA_thag_7.3:0.1", "PA_thag_7.3:0.2", "PA_thag_7.3:0.3"], "en": "Theragāthā 7.3 Sattaka-nipāta Paṭhama-vagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:0.4"], "en": "The Verses of Bhadda Thera:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:1.1"], "en": "“I was an only son,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:1.2"], "en": "dear to my mother and dear to my father.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:1.3", "PA_thag_7.3:1.4"], "en": "\"Indeed, through many practices of self-restraint and through repeated supplications, they obtained [it];", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:2.1"], "en": "and out of compassion for me,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:2.2"], "en": "Desiring his welfare and seeking his benefit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:2.3", "PA_thag_7.3:2.4"], "en": "both his father and mother presented [the offering] to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:3.1"], "en": "\"This son was obtained with great difficulty;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:3.2"], "en": "he is delicate and has been raised in comfort.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:3.3"], "en": "We give him to you, O Lord.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:3.4"], "en": "“...the attendant of the Victor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:4.1"], "en": "And the Teacher, having accepted me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:4.2"], "en": "said this to Ānanda:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:4.3"], "en": "“Ordain him quickly;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:4.4"], "en": "he will become a noble steed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:5.1"], "en": "Having ordained me, the Teacher—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:5.2"], "en": "The Conqueror entered his dwelling;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:5.3"], "en": "before the sun had set,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:5.4"], "en": "my mind was then liberated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:6.1", "PA_thag_7.3:6.2"], "en": "Then the Teacher, having dismissed them and emerged from seclusion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:6.3"], "en": "said to me, \"Come, Bhaddā.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:6.4"], "en": "That was my full ordination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:7.1"], "en": "Having reached seven years of age,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:7.2"], "en": "I received the full ordination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:7.3"], "en": "“The three true insights have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:7.4"], "en": "oh, how well-proclaimed is the Dhamma!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.3:7.5"], "en": "… Thus spoke the elder Bhadda.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
