[
{"segs": ["PA_tha-ap_13:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:0.2", "PA_tha-ap_13:0.3"], "en": "The Chapter on the Lion Throne (Sīhāsaniyavagga) 1. The Apadāna of the Elder Sīhāsanadāyaka (The Giver of the Lion Throne)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:1.1", "PA_tha-ap_13:1.2"], "en": "“When Siddhattha, the supreme among bipeds, the protector of the world, has attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:1.3"], "en": "and the holy teaching has been spread abroad;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:1.4"], "en": "In the teaching known by its great power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:2.1"], "en": "with a clear mind and joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:2.2"], "en": "I fashioned a lion throne.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:2.3"], "en": "Having fashioned a lion throne,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:2.4"], "en": "I made a footstool;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:3.1"], "en": "and while it was raining upon the lion throne,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:3.2"], "en": "I had a house built there;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:3.3"], "en": "through that clarity of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:3.4"], "en": "I was reborn in Tusita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:4.1", "PA_tha-ap_13:4.2", "PA_tha-ap_13:4.3"], "en": "At that time, my well-constructed celestial mansion was twenty-four yojanas in length.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:4.4", "PA_tha-ap_13:5.1", "PA_tha-ap_13:5.2"], "en": "In detail, there are fourteen hundred thousand maidens who always attend upon me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:5.3", "PA_tha-ap_13:5.4"], "en": "And a couch made of gold was well-fashioned in the sky;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:6.1"], "en": "there were elephant-vehicles and horse-vehicles.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:6.2"], "en": "Divine vehicles appear;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:6.3", "PA_tha-ap_13:6.4"], "en": "palaces and palanquins arise according to one's wish.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:7.1", "PA_tha-ap_13:7.2"], "en": "And many thrones made of jewels and others made of precious materials—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:7.3"], "en": "all these are produced for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:7.4"], "en": "This is the fruit of the lion throne:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:8.1"], "en": "[seats] made of gold, silver,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:8.2"], "en": "crystal, and beryl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:8.3"], "en": "I ascend the sandals;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:8.4"], "en": "this is the fruit of the footstool.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:9.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:9.2"], "en": "Whatever deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:9.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:9.4"], "en": "this is the fruit of meritorious action.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:10.1"], "en": "In the seventy-third aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:10.2"], "en": "three persons named Indra;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:10.3"], "en": "in the seventy-second aeon—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:10.4"], "en": "Three named Sumanas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:11.1"], "en": "seventy-three aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:11.2"], "en": "three named Varuṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:11.3"], "en": "Possessing the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:11.4"], "en": "lords over the four continents,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:12.1"], "en": "they have attained the four analytical knowledges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:12.2", "PA_tha-ap_13:12.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:12.4"], "en": "and the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:13.1"], "en": "Thus indeed the venerable elder Sīhāsanadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_13:14.1"], "en": "This is the first legend of the elder Sīhāsanadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
