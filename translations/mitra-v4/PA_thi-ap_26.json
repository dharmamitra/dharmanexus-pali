[
{"segs": ["PA_thi-ap_26:0.1", "PA_thi-ap_26:0.2"], "en": "Therīapadāna Kuṇḍalakesīvagga 6.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:0.3"], "en": "Soṇātherīapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:1.2"], "en": "who has gone beyond all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:1.3"], "en": "[lived] one hundred thousand aeons ago from now.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:1.4"], "en": "The Leader appeared in that eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:2.1"], "en": "At that time, she was born into a guild-president’s family,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:2.2"], "en": "happy, honored, and beloved.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:2.3"], "en": "Having approached that best of sages,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:2.4"], "en": "I heard his sweet speech,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:3.1"], "en": "which was the foremost of all those who have aroused their energy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:3.2"], "en": "The Victor praised the bhikkhunī;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:3.3"], "en": "having heard this and become joyful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:3.4"], "en": "she performed an act of service for the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:4.1"], "en": "Having paid homage to the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:4.2"], "en": "I then aspired for that state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:4.3"], "en": "the Great Hero rejoiced [in my aspiration].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:4.4"], "en": "“Your aspiration shall be fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:5.1"], "en": "One hundred thousand aeons hence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:5.2"], "en": "you will be born into the lineage of Okkāka.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:5.3", "PA_thi-ap_26:5.4"], "en": "One named Gotama by clan will become a teacher in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:6.1"], "en": "he will have heirs in his teachings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:6.2"], "en": "\"Born from the breast, fashioned by the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:6.3"], "en": "she shall be known by the name Soṇā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:6.4"], "en": "a female disciple of the Teacher.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:7.1"], "en": "Having heard that, being filled with joy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:7.2", "PA_thi-ap_26:7.3"], "en": "I then served the Jina for as long as I lived with a mind of loving-kindness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:7.4"], "en": "The Guide, free from conditions—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:8.1", "PA_thi-ap_26:8.2"], "en": "by that well-performed karma and by my intentions and aspirations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:8.3"], "en": "Having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:8.4"], "en": "I went to the realm of the Thirty-three;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:9.1"], "en": "and now, in my final existence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:9.2", "PA_thi-ap_26:9.3"], "en": "I was born into a merchant family in Sāvatthī, the preeminent city,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:9.4"], "en": "which was prosperous, flourishing, and possessed of great wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:10.1", "PA_thi-ap_26:10.2"], "en": "And when I had reached youth and gone to my husband’s family,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:10.3"], "en": "I gave birth to ten sons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:10.4"], "en": "They were especially handsome;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:11.1", "PA_thi-ap_26:11.2"], "en": "all of them were nurtured in happiness and were enchanting to the eyes of people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:11.3"], "en": "They are pleasing even to my enemies,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:11.4"], "en": "let alone dear to me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:12.1"], "en": "therefore, against my will, they [are dear].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:12.2"], "en": "Honored by his ten sons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:12.3", "PA_thi-ap_26:12.4"], "en": "my husband went forth into homelessness in the teaching of the God of Gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:13.1"], "en": "I reflected all alone:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:13.2"], "en": "\"Enough of this life for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:13.3"], "en": "I have had enough of these four stepsons.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:13.4"], "en": "\"And for that wretched woman who has grown old.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:14.1"], "en": "I too shall go there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:14.2"], "en": "to where my husband has arrived.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:14.3"], "en": "Having reflected thus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:14.4"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:15.1"], "en": "Then the bhikkhunīs [approached] me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:15.2", "PA_thi-ap_26:15.3"], "en": "Leaving one nun’s quarters behind, they went away,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:15.4"], "en": "saying, “Heat some water.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:16.1", "PA_thi-ap_26:16.2"], "en": "Then, having poured water and filled the pot,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:16.3"], "en": "she placed it on the hearth and sat down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:16.4"], "en": "Then I concentrated my mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:17.1"], "en": "having seen the aggregates as impermanent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:17.2"], "en": "as suffering, and as non-self.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:17.3"], "en": "Having discarded all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:17.4"], "en": "I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:18.1"], "en": "Then, the bhikkhunīs arrived;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:18.2"], "en": "They asked for hot water;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:18.3"], "en": "having resolved upon the fire element,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:18.4"], "en": "I quickly heated the water.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:19.1", "PA_thi-ap_26:19.2"], "en": "Filled with wonder, they addressed this matter to the Best of Jinas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:19.3"], "en": "having heard it, the Protector was gladdened.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:19.4"], "en": "He spoke this verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:20.1"], "en": "“Though one should live for a hundred years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:20.2"], "en": "lazy and lacking in energy;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:20.3", "PA_thi-ap_26:20.4"], "en": "\"A single day of life for one who exerts firm energy is better.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:21.1"], "en": "Thus was the Great Hero propitiated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:21.2", "PA_thi-ap_26:21.3", "PA_thi-ap_26:21.4"], "en": "\"By my excellent practice,\" said that Great Sage, \"I am the foremost among those who have aroused energy.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:22.1"], "en": "The defilements have been incinerated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:22.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:22.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:23.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:23.2", "PA_thi-ap_26:23.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:24.1", "PA_thi-ap_26:24.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:24.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:25.1"], "en": "Thus indeed did the bhikkhunī Soṇā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_26:26.1"], "en": "This is the sixth legend of the Elder Nun Soṇā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
