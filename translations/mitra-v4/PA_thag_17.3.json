[
{"segs": ["PA_thag_17.3:0.1"], "en": "Theragāthā 17.3,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:0.2", "PA_thag_17.3:0.3"], "en": "Tiṁsanipāta, Paṭhamavagga (The First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:0.4"], "en": "Ānanda Thera’s Verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:1.1"], "en": "“By one who is malicious, wrathful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:1.2"], "en": "stingy, and delighting in ostentation;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:1.3"], "en": "A wise person should not form a friendship with a wicked man;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:1.4"], "en": "association with an evil person is [like] association with a fool.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:2.1"], "en": "But with one who has faith and is virtuous, [one may associate].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:2.2", "PA_thag_17.3:2.3"], "en": "A wise person should form friendship with one who is wise and learned;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:2.4"], "en": "for association with a superior person is auspicious.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:3.1", "PA_thag_17.3:3.2"], "en": "Behold this figure fashioned by the mind...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:3.4"], "en": "[and so on] ...for which there is no permanent stability.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:4.1", "PA_thag_17.3:4.2"], "en": "Behold this figure fashioned by the mind...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:4.4"], "en": "it shines with garments.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:5.1", "PA_thag_17.3:5.2"], "en": "Those who have crossed over the mud...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:5.4"], "en": "yet are not seekers of the further shore.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:6.1", "PA_thag_17.3:6.2"], "en": "They have laid out the eightfold path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:6.4"], "en": "yet they do not seek the further shore.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:7.1", "PA_thag_17.3:7.2"], "en": "Like a fresh collyrium box, ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:7.4"], "en": "yet they do not seek the further shore.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:8.1"], "en": "Learned and eloquent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:8.2"], "en": "an attendant of the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:8.3"], "en": "one who has laid down the burden and is liberated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:8.4"], "en": "Gotama spreads his bedding;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:9.1"], "en": "he whose taints are destroyed, who is detached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:9.2"], "en": "who has transcended attachment, and who is perfectly quenched.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:9.3"], "en": "He bears his final body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:9.4"], "en": "having gone beyond birth and death;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:10.1"], "en": "in him are established all phenomena.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:10.2", "PA_thag_17.3:10.3"], "en": "On the path leading to Nibbāna for the Buddha, the Kinsman of the Sun,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:10.4"], "en": "here stands Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:11.1"], "en": "From the Buddha I received eighty-two thousand [verses],", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:11.2"], "en": "two thousand from the bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:11.3"], "en": "and eighty-four thousand [others].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:11.4"], "en": "Those teachings that have been set in motion by me—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:12.1", "PA_thag_17.3:12.2"], "en": "this person of little learning grows old like a bullock.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:12.3"], "en": "His flesh increases,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:12.4"], "en": "but his wisdom does not increase;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:13.1"], "en": "the one of great learning [overcomes] the one of little learning.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:13.2", "PA_thag_17.3:13.3"], "en": "He who looks down upon what has been heard is like a blind man carrying a lamp;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:13.4"], "en": "such a person appears to me in that very way.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:14.1", "PA_thag_17.3:14.2"], "en": "One should attend upon one who is learned and not let what has been heard perish;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:14.3"], "en": "for that is the root of the holy life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:14.4"], "en": "Therefore, one should be a bearer of the Dhamma—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:15.1"], "en": "one who knows what precedes and follows, who knows the meaning,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:15.2"], "en": "and who is skilled in grammar and phrases.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:15.3", "PA_thag_17.3:15.4"], "en": "He grasps what has been well-grasped and examines the meaning;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:16.1"], "en": "through patience he becomes desirous [of the Dhamma].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:16.2"], "en": "Having exerted himself, he weighs it;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:16.3", "PA_thag_17.3:16.4"], "en": "at the proper time, being well-composed within, he strives.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:17.1", "PA_thag_17.3:17.2"], "en": "One who desires knowledge of the Dhamma should [rely on] a disciple of the Buddha who is learned, a bearer of the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:17.3"], "en": "and possessed of wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:17.4"], "en": "One should associate with such a person as that:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:18.1"], "en": "one who is learned, a bearer of the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:18.2"], "en": "and a guardian of the treasury of the Great Seer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:18.3"], "en": "The eye of the entire world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:18.4"], "en": "the learned one worthy of honor;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:19.1"], "en": "delighting in the Dhamma, rejoicing in the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:19.2", "PA_thag_17.3:19.3"], "en": "Reflecting upon the Dhamma and recollecting the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:19.4"], "en": "a bhikkhu does not fall away from the true Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:20.1"], "en": "Heavy with stinginess regarding the body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:20.2"], "en": "one does not exert oneself when it is wasting away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:20.3"], "en": "for one who is greedy for bodily comfort, [the body perishes].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:20.4"], "en": "Whence comes the well-being of a recluse?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:21.1"], "en": "All directions do not appear to me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:21.2"], "en": "and the teachings do not manifest to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:21.3"], "en": "When one has departed from a spiritual friend,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:21.4", "PA_thag_17.3:22.1"], "en": "it appears like darkness to one whose companion has passed away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:22.2"], "en": "Of the Teacher who has gone beyond;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:22.3", "PA_thag_17.3:22.4"], "en": "there is no friend such as this as mindfulness directed toward the body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:23.1", "PA_thag_17.3:23.2"], "en": "Those who were ancient and have passed away do not accord with the new ones for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:23.3"], "en": "today I meditate all alone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:23.4"], "en": "“Like a bird that has entered the rains,” [he said].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:24.1", "PA_thag_17.3:24.2"], "en": "“Many people from various kingdoms have come forward to see him.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:24.3"], "en": "“Do not stop the listeners;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:24.4"], "en": "let them see me at this time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:25.1"], "en": "As they were approaching to see him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:25.2", "PA_thag_17.3:25.3"], "en": "The Teacher, the Visionary One, grants space to those from various kingdoms and different regions;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:25.4"], "en": "he does not forbid them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:26.1"], "en": "For twenty-five years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:26.2"], "en": "while I was still a trainee,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:26.3"], "en": "no perception of sensual desire arose in me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:26.4"], "en": "Behold the excellence of the Dhamma!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:27.1"], "en": "For twenty-five years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:27.2"], "en": "while I was still a trainee;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:27.3"], "en": "No perception of fault arose;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:27.4"], "en": "behold the excellence of the Dhamma!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:28.1"], "en": "For twenty-five years...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:28.2"], "en": "I attended upon the Blessed One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:28.3"], "en": "with loving physical action,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:28.4"], "en": "I was like a shadow that never departs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:29.1"], "en": "For twenty-five years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:29.2", "PA_thag_17.3:29.3"], "en": "I attended upon the Blessed One with loving verbal action.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:29.4"], "en": "Like a shadow that never departs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:30.1"], "en": "For twenty-five years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:30.2"], "en": "I attended upon the Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:30.3"], "en": "Through a mental action imbued with loving-kindness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:30.4"], "en": "one follows like a shadow that never departs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:31.1"], "en": "as the Buddha walks to and fro.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:31.2"], "en": "I followed behind him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:31.3"], "en": "while the Dhamma was being taught,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:31.4"], "en": "knowledge arose within me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:32.1"], "en": "I still have tasks to perform;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:32.2"], "en": "I am a trainee who has not yet attained the goal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:32.3"], "en": "And now the Teacher’s final passing—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:32.4"], "en": "He who was compassionate toward us.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:33.1"], "en": "That which occurred then was terrifying;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:33.2"], "en": "that which occurred then made the hair stand on end.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:33.3", "PA_thag_17.3:33.4"], "en": "“When the Perfectly Awakened One, endowed with the excellence of all modes, has attained final Nibbāna—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:34.1"], "en": "[I am] one who has heard much and who upholds the Dhamma.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:34.2"], "en": "The guardian of the treasure of the Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:34.3"], "en": "the eye of the entire world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:34.4"], "en": "Ānanda has attained final Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:35.1"], "en": "One who is learned and a bearer of the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:35.2"], "en": "a guardian of the treasure of the Great Seer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:35.3"], "en": "the eye of the entire world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:35.4"], "en": "The dispeller of darkness in the gloom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:36.1", "PA_thag_17.3:36.2"], "en": "the seer who possesses insight, mindfulness, and fortitude.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:36.3", "PA_thag_17.3:36.4"], "en": "“The Elder Ānanda is a bearer of the True Dhamma, a treasury of jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:37.1"], "en": "The Teacher has been served by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:37.2"], "en": "The teaching of the Buddha has been accomplished;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:37.3"], "en": "the heavy burden has been laid down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:37.4"], "en": "and there is now no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:37.5", "PA_thag_17.3:37.6"], "en": "… The Elder Ānanda … The Book of Thirty is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:38.0"], "en": "Herein is the summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:38.1"], "en": "Phussa, Patissa, and Ānanda—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:38.2"], "en": "these three are celebrated there;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:38.3"], "en": "the verses therein are fully enumerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.3:38.4"], "en": "\"And five more than a hundred.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
