[
{"segs": ["PA_tha-ap_62:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:0.2"], "en": "Bījanī Vagga 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:0.3"], "en": "The Apadāna of the Elder Asanabodhiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:1.1"], "en": "“In my seventh year from birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:1.2"], "en": "I saw the Leader of the World;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:1.3"], "en": "with a clear mind and joyful heart, I paid homage to him.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:1.4"], "en": "I approached the Supreme among Men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:2.1"], "en": "To Tissa, the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:2.2"], "en": "the Eldest in the World, the Neutral One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:2.3"], "en": "Joyful with a joyful mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:2.4"], "en": "I planted this supreme Bodhi tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:3.1"], "en": "My name was Asana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:3.2"], "en": "A tree growing from the earth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:3.3", "PA_tha-ap_62:3.4"], "en": "for five years I attended upon the supreme Bodhi tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:4.1"], "en": "Seeing a flowering tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:4.2"], "en": "wonderful and hair-raising,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:4.3"], "en": "he proclaimed his own karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:4.4"], "en": "I approached the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:5.1", "PA_tha-ap_62:5.2"], "en": "Then that Sambuddha, the Self-Existent One, the Supreme Person, named Tissa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:5.3"], "en": "Having sat down in the community of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:5.4"], "en": "he spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:6.1"], "en": "“By whom this Bodhi tree was planted...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:6.2"], "en": "And the worship of the Buddha is honored;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:6.3"], "en": "I shall praise that,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:6.4"], "en": "so listen as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:7.1", "PA_tha-ap_62:7.2"], "en": "For thirty eons he will exercise sovereignty among the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:7.3"], "en": "sixty-four times he will [rule as a wheel-turning monarch].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:7.4"], "en": "He will become a wheel-turning monarch,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:8.1"], "en": "for having passed away from Tusita,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:8.2"], "en": "he was impelled by the root of his white merit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:8.3"], "en": "Having experienced two attainments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:8.4"], "en": "he will delight in human existence; he,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:9.1"], "en": "with his self dedicated to striving, will find joy there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:9.2"], "en": "Peaceful and free from acquisitions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:9.3"], "en": "having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:9.4"], "en": "he will attain Nibbāna, being without taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:10.1"], "en": "Devoted to discernment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:10.2"], "en": "peaceful and free from acquisitions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:10.3"], "en": "like an elephant that has severed its bonds, I am released.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:10.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:11.1"], "en": "Ninety-two eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:11.2"], "en": "I then planted the seed for enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:11.3"], "en": "I do not recall ever being born in an evil state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:11.4"], "en": "this is the fruit of planting a Bodhi tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:12.1"], "en": "In the seventy-fourth aeon...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:12.2"], "en": "Known as Daṇḍasena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:12.3", "PA_tha-ap_62:12.4"], "en": "I was then a wheel-turning monarch endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:13.1"], "en": "In the seventy-third aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:13.2", "PA_tha-ap_62:13.3"], "en": "there were seven lords of the earth named Samantanemi.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:13.4", "PA_tha-ap_62:14.1", "PA_tha-ap_62:14.2"], "en": "In the twenty-fifth aeon ago, there was a kshatriya named Puṇṇaka who was a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:14.3"], "en": "Possessing the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:14.4"], "en": "a wheel-turning monarch of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:15.1"], "en": "the four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:15.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:15.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:16.1"], "en": "Thus indeed did the venerable elder Asanabodhiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:17.1"], "en": "The legend of the Elder Āsanabodhiya is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:18.1"], "en": "The sixth chapter, the Bījanī-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:19.1"], "en": "Its summary (uddāna):", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:20.1", "PA_tha-ap_62:20.2"], "en": "A fan, a sunshade, a bed, water-carriers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:20.3"], "en": "attendants, and a lamp.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:20.4"], "en": "Dhaja, Padumapūjaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:20.5"], "en": "and Bodhi is said to be the tenth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_62:20.6"], "en": "likewise, there are ninety-two verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
