[
{"segs": ["PA_ja_323:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:0.2", "PA_ja_323:0.3"], "en": "Catukkanipāta, Kuṭidūsakavagga (The Chapter on the House-Spoiler)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:0.4", "PA_ja_323:1.1", "PA_ja_323:1.2"], "en": "3. The Brahmadatta Jātaka “O King Brahmadatta, a petitioner incurs two things:”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:1.3"], "en": "Whether there is loss or gain of wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:1.4"], "en": "such indeed are the conditions of begging;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:2.1"], "en": "they say that begging is weeping.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:2.2"], "en": "O bull among charioteers of the Pañcālas:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:2.3", "PA_ja_323:2.4"], "en": "he who rejects a request is called one who cries out in protest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:3.1", "PA_ja_323:3.2"], "en": "Let not the well-assembled Pañcālas see me weeping,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:3.3"], "en": "nor you in turn weeping in response.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:3.4"], "en": "\"Therefore, I desire this in private.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:4.1"], "en": "\"I give you, O brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:4.2"], "en": "a thousand Rohiṇī cows together with a bull.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:4.3"], "en": "\"For a noble one would not fail to speak to another noble one,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:4.4"], "en": "having heard your verses endowed with the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_323:5.1"], "en": "Thus ends the third Jātaka, the Brahmadatta Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
