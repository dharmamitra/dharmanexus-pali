[
{"segs": ["PA_thi-ap_35:0.1"], "en": "Therīapadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:0.2"], "en": "Khattiyāvagga 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:0.3"], "en": "The Apadāna of the Elder Nun Sukkā", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:1.1"], "en": "“Ninety-one aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:1.2"], "en": "a leader named Vipassī arose,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:1.3"], "en": "one of beautiful appearance.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:1.4"], "en": "A penetrator of all phenomena.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:2.1", "PA_thi-ap_35:2.2"], "en": "At that time, I was born in Bandhumatī into a certain family;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:2.3"], "en": "Having heard the Dhamma from the Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:2.4"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:3.1"], "en": "I am one of great learning, a bearer of the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:3.2"], "en": "Likewise, she was possessed of ready wit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:3.3"], "en": "a speaker of diverse discourses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:3.4"], "en": "and a promoter of the Victor’s teaching.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:4.1", "PA_thi-ap_35:4.2"], "en": "Then, having delivered a discourse on the Dhamma for the benefit of many people,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:4.3"], "en": "I passed away from there and was reborn in the Tusita heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:4.4"], "en": "The illustrious one was reborn.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:5.1"], "en": "In the thirty-first aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:5.2"], "en": "the Conqueror Sikhī will be like the fire-crested [Sikhī].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:5.3"], "en": "Shining with glory in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:5.4"], "en": "the best of speakers appeared.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:6.1"], "en": "Then too, having gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:6.2"], "en": "Skilled in the Buddha’s teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:6.3"], "en": "having illuminated the words of the Victor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:6.4"], "en": "they have gone from there to the triple heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:7.1"], "en": "In the thirty-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:7.2"], "en": "a leader named Vessabhū,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:7.3"], "en": "a possessor of great wisdom, appeared.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:7.4"], "en": "And even then, in that very same way,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:8.1"], "en": "having gone forth as a bearer of the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:8.2"], "en": "I illumined the teaching of the Conqueror.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:8.3"], "en": "Having gone to the delightful city of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:8.4"], "en": "I experienced great bliss.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:9.1"], "en": "In this auspicious eon, ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:9.2"], "en": "Kakusandha, the supreme Victor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:9.3"], "en": "the refuge for men, arose;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:9.4"], "en": "and at that time, too, I was exactly as I am now.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:10.1", "PA_thi-ap_35:10.2"], "en": "Having gone forth and illuminated the Sage’s teaching for as long as my life lasted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:10.3"], "en": "I passed away from there and reached the Heaven of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:10.4"], "en": "Just as [the sun] enters its own abode,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:11.1"], "en": "so too, in this very eon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:11.2"], "en": "was the Leader named Koṇāgamana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:11.3"], "en": "The refuge of the world arose,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:11.4"], "en": "free from conflict, having reached the deathless;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:12.1"], "en": "even then, having gone forth, [he practiced].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:12.2"], "en": "In the teaching of that Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:12.3", "PA_thi-ap_35:12.4"], "en": "those who were learned and bearers of the Dhamma caused the Conqueror’s dispensation to shine.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:13.1"], "en": "In this very aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:13.2"], "en": "Kassapa, the supreme sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:13.3"], "en": "arose as a refuge for the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:13.4"], "en": "Free from passion, he has reached the end of death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:14.1", "PA_thi-ap_35:14.2"], "en": "Having gone forth in the teaching of that hero among men as well;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:14.3"], "en": "Having mastered the true Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:14.4"], "en": "confident in their inquiries,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:15.1"], "en": "virtuous, and possessed of a sense of shame.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:15.2"], "en": "Skilled in the three trainings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:15.3", "PA_thi-ap_35:15.4"], "en": "they delivered many discourses on the Dhamma throughout their lives, O Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:16.1"], "en": "By the ripening of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:16.2"], "en": "and through his volitions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:16.3"], "en": "having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:16.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:17.1"], "en": "And now, in my final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:17.2"], "en": "in the most excellent city of Giribbaja;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:17.3"], "en": "Born into a prosperous family of merchants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:17.4"], "en": "amidst a vast accumulation of great treasures;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:18.1"], "en": "when, together with a thousand bhikkhus—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:18.2", "PA_thi-ap_35:18.3"], "en": "Surrounded [by his retinue], the Leader of the World arrived at Rājagaha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:18.4"], "en": "praised by the Thousand-Eyed One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:19.1"], "en": "Tamed together with those formerly matted-hair ascetics who were tamed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:19.2"], "en": "liberated together with those who were liberated—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:19.3"], "en": "[he whose] color is like the glow of refined gold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:19.4"], "en": "The Blessed One entered Rājagaha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:20.1", "PA_thi-ap_35:20.2"], "en": "Having seen that majesty of a Buddha and having heard of his accumulation of virtues, [the people were inspired].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:20.3"], "en": "Having inspired confidence in my mind toward the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:20.4"], "en": "I made offerings to him according to my ability.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:21.1"], "en": "And at another time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:21.2"], "en": "In the presence of Dhammadinnā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:21.3"], "en": "having gone forth from the home,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:21.4"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:22.1"], "en": "While my hair was being cut off,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:22.2"], "en": "I burned away my defilements;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:22.3"], "en": "I mastered the entire teaching.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:22.4"], "en": "Having gone forth after a long time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:23.1", "PA_thi-ap_35:23.2"], "en": "I then taught the Dhamma in an assembly of great crowds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:23.3"], "en": "While the Dhamma was being taught,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:23.4", "PA_thi-ap_35:24.1"], "en": "there was a penetration of the Dhamma for many thousands of living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:24.2"], "en": "Having understood that, I was utterly amazed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:24.3", "PA_thi-ap_35:24.4"], "en": "\"The yakkha who roamed through Giribbaja has gained deep confidence in me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:25.1"], "en": "What have the people in Rājagaha done to me?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:25.2"], "en": "They are like nymphs who have drunk honey,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:25.3"], "en": "who do not wait upon the white [robe].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:25.4"], "en": "Descending upon the deathless state—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:26.1", "PA_thi-ap_35:26.2"], "en": "indeed, that which is irresistible, and possesses an invigorating essence that is most delightful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:26.3"], "en": "The wise ones drink [of me], I think,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:26.4"], "en": "as travelers [drink from] a cloud;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:27.1"], "en": "I have mastery over the supernormal powers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:27.2", "PA_thi-ap_35:27.3"], "en": "With the divine ear-element and the knowledge of penetrating the minds of others,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:27.4"], "en": "I have attained mastery, O Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:28.1"], "en": "I know my former abodes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:28.2"], "en": "the divine eye is purified,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:28.3"], "en": "and all taints are utterly destroyed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:28.4"], "en": "Now there is no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:29.1"], "en": "In the meanings, the phenomena, the linguistic expressions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:29.2"], "en": "and likewise in inspired eloquence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:29.3", "PA_thi-ap_35:29.4"], "en": "Knowledge has arisen in me, O Great Hero, in your presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:30.1"], "en": "My defilements have been incinerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:30.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:30.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:31.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:31.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:31.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:32.1"], "en": "The four analytical knowledges (paṭisambhidā) have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:32.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:32.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:33.1"], "en": "Thus indeed did the bhikkhunī Sukkā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:34.1"], "en": "The legend of Sukkātherī is the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_35:34.2"], "en": "This is the fifth section for recitation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
