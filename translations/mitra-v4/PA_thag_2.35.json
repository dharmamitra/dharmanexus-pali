{"segs": ["PA_thag_2.35:0.1"], "en": "Theragāthā 2.35 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.35:0.2", "PA_thag_2.35:0.3"], "en": "Catutthavagga (The Fourth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.35:0.4"], "en": "The Verses of the Elder Sambula-Kaccāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.35:1.1"], "en": "“The sky is raining, the sky is thundering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.35:1.2"], "en": "and I dwell alone in a terrifying cave.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.35:1.3", "PA_thag_2.35:1.4"], "en": "As I dwelt alone in that terrifying cave, there was no fear, nor trepidation, nor horripilation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.35:2.1"], "en": "This is my natural disposition: that for me—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.35:2.2", "PA_thag_2.35:2.3"], "en": "For one dwelling alone in a fearsome cave, there is no fear,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.35:2.4"], "en": "nor trembling, nor horripilation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.35:2.5"], "en": "… the elder Sambulakaccāna …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
