[
{"segs": ["PA_ja_226:0.1", "PA_ja_226:0.2", "PA_ja_226:0.3"], "en": "Jātaka: The Second Book of Birth Stories (Dukanipāta), Chapter on the Yellow Robe (Kāsāvavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_226:0.4"], "en": "6. The Kosiya Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_226:1.1"], "en": "“It is good to depart at the right time;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_226:1.2"], "en": "it is not good to depart at the wrong time.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_226:1.3", "PA_ja_226:1.4"], "en": "For many people, having gone forth at an improper time, even if they are alone,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_226:1.5"], "en": "do not illuminate any purpose whatsoever.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_226:1.6"], "en": "Dhaṅkasenāva Kosiya was wise,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_226:2.1", "PA_ja_226:2.2"], "en": "skilled in various methods, and one who sought out the vulnerabilities of others.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_226:2.3"], "en": "“Having brought all friends under his control,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_226:2.4"], "en": "one may be happy like Kosiya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_226:3.1"], "en": "Thus ends the sixth Jātaka, the Kosiya-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
