[
{"segs": ["PA_ja_346:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:0.2"], "en": "The Collection of Fours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:0.3"], "en": "Chapter on Cūḷakuṇāla", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:0.4"], "en": "6. The Kesava Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:1.1", "PA_ja_346:1.2"], "en": "“Having abandoned the lordship of men, which is so successful in all its desires;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:1.3", "PA_ja_346:1.4"], "en": "“How is it that the Blessed One Kesī delights in the hermitage of Kappa?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:2.1"], "en": "“It is sweet and delightful.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:2.2"], "en": "“There are delightful discourses on the eon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:2.3", "PA_ja_346:2.4"], "en": "O Nārada; these well-spoken words bring me joy.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:3.1"], "en": "“I eat fine rice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:3.2"], "en": "pure, with meat as a sauce;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:3.3"], "en": "how [could I eat] millet and wild rice?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:3.4"], "en": "They cover that which is saltless.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:4.1"], "en": "Whether it be sweet or not sweet,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:4.2"], "en": "whether it be little or much;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:4.3"], "en": "“One may eat where one feels confident;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:4.4"], "en": "confidence is the highest of flavors.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_346:5.1"], "en": "Thus ends the sixth Jātaka, the Kesava-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
