[
{"segs": ["PA_tha-ap_16:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:0.2"], "en": "Sīhāsaniya-vagga 4:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:0.3"], "en": "The Apadāna of the Elder Cūḷapanthaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:1.2"], "en": "the recipient of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:1.3"], "en": "has withdrawn from the assembly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:1.4"], "en": "He was dwelling then in the Himalayas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:2.1", "PA_tha-ap_16:2.2"], "en": "I too was dwelling then in a hermitage in the Himalayas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:2.3"], "en": "I approached the Great Hero who had recently arrived,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:2.4"], "en": "the Leader of the World;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:3.1"], "en": "having taken up a flower parasol, I stood before him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:3.2", "PA_tha-ap_16:3.3"], "en": "I approached the bull among men as he was entering into meditative absorption,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:3.4"], "en": "and I created an obstacle for him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:4.1", "PA_tha-ap_16:4.2"], "en": "Taking up the flower parasol with both hands, I offered it;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:4.3"], "en": "the Blessed One accepted it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:4.4"], "en": "Padumuttara, the Great Sage—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:5.1"], "en": "then all the gods, delighted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:5.2"], "en": "approached the Himavat mountains.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:5.3"], "en": "They uttered cries of \"Well done!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:5.4"], "en": "and the One with Vision will rejoice.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:6.1"], "en": "Having said this, those gods—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:6.2", "PA_tha-ap_16:6.3", "PA_tha-ap_16:6.4"], "en": "They approached the Supreme among Men as he held aloft in the sky a most excellent lotus parasol.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:7.1"], "en": "Taking up a hundred-petaled white lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:7.2"], "en": "the ascetic gave it to me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:7.3"], "en": "saying: \"I shall praise you.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:7.4"], "en": "Listen to me as I speak:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:8.1", "PA_tha-ap_16:8.2"], "en": "for twenty-five eons he shall exercise sovereignty over the devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:8.3", "PA_tha-ap_16:8.4"], "en": "And thirty-four times he will become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:9.1"], "en": "Whichever womb he transmigrates into,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:9.2"], "en": "Whether in the realm of the gods or among humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:9.3", "PA_tha-ap_16:9.4"], "en": "he will hold a lotus as it stands in the open air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:10.1"], "en": "In a hundred thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:10.2"], "en": "one born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:10.3"], "en": "known by the family name Gotama, will appear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:10.4"], "en": "The Teacher will appear in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:11.1"], "en": "when his teaching has been proclaimed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:11.2"], "en": "one will obtain human birth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:11.3"], "en": "In a mind-made body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:11.4"], "en": "he will become supreme.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:12.1"], "en": "There will be two brothers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:12.2"], "en": "Both of them, called Panthaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:12.3"], "en": "having realized the supreme goal,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:12.4"], "en": "will illuminate the Teaching.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:13.1"], "en": "Thus, at the age of eighteen,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:13.2"], "en": "I went forth into the homeless life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:13.3"], "en": "yet I found no distinction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:13.4"], "en": "In the teaching of the Son of the Sakyan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:14.1"], "en": "my progress was slow;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:14.2"], "en": "formerly, I was one who was held in contempt.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:14.3"], "en": "My brother dismissed me, saying,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:14.4"], "en": "\"Go now to your own home.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:15.1"], "en": "Being thus dismissed, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:15.2"], "en": "At the gateway of the monastery,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:15.3"], "en": "I stood there dejected,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:15.4"], "en": "longing for the state of a recluse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:16.1", "PA_tha-ap_16:16.2"], "en": "The Blessed One came there and stroked my head;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:16.3"], "en": "taking me by the arm, he said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:16.4"], "en": "He led him into the monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:17.1"], "en": "Out of compassion for me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:17.2"], "en": "the Teacher gave me a foot-wiping cloth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:17.3"], "en": "Resolve thus upon purity;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:17.4"], "en": "resolve upon solitude alone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:18.1"], "en": "Having grasped you with my hands, I shall lead you forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:18.2"], "en": "I saw a red lotus there;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:18.3"], "en": "my mind was liberated therein,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:18.4"], "en": "and I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:19.1", "PA_tha-ap_16:19.2"], "en": "Having reached perfection in all respects regarding mind-made bodies,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:19.3"], "en": "and having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:19.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:20.1", "PA_tha-ap_16:20.2"], "en": "The four analytical knowledges and these eight liberations—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:20.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:20.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:21.1"], "en": "Thus indeed did the Venerable Elder Cūḷapanthaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_16:22.1"], "en": "The legend of the Elder Cūḷapanthaka is the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
