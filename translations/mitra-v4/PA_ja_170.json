{"segs": ["PA_ja_170:4.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_170:5.1"], "en": "Then Indasamāna, Sapaṇṇakuṭi,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_170:5.2"], "en": "Susīma the supreme, Gijjhajalābuja,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_170:5.3"], "en": "Upasāḷaka, and Salāpavara the bhikkhu—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
