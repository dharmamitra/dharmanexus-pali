[
{"segs": ["PA_tha-ap_435:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:0.2", "PA_tha-ap_435:0.3"], "en": "Pāṭihīrasaññaka Thera Apadāna, Number Three in the Ekavihārivagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:1.2"], "en": "the recipient of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:1.3"], "en": "together with one hundred thousand seers, [dwelt there].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:1.4"], "en": "Then he entered the city.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:2.1", "PA_tha-ap_435:2.2"], "en": "As he, the tranquil and steadfast one, was entering the city;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:2.3"], "en": "The jewels blazed with light,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:2.4", "PA_tha-ap_435:3.1"], "en": "and there was a great sound at that time through the power of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:3.2"], "en": "The kettledrums resounded without being struck;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:3.3", "PA_tha-ap_435:3.4"], "en": "the lutes played of their own accord as the Buddha entered the city.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:4.1"], "en": "I pay homage to the Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:4.2"], "en": "the Great Sage Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:4.3"], "en": "after having witnessed his miraculous feat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:4.4"], "en": "Therein I gladdened my heart:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:5.1"], "en": "\"O wonderful are the Buddhas! O wonderful are the Dhammas!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:5.2"], "en": "O wonderful is our accomplishment of a Teacher!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:5.3", "PA_tha-ap_435:5.4"], "en": "Even the insentient musical instruments sounded of their own accord.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:6.1"], "en": "A hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:6.2"], "en": "Whatever perception I obtained then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:6.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:6.4"], "en": "this is the fruit of the perception of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:7.1", "PA_tha-ap_435:7.2"], "en": "The defilements have been burnt away by me; ... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:7.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:8.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:8.2", "PA_tha-ap_435:8.3"], "en": "[as before] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:9.1", "PA_tha-ap_435:9.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:9.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:10.1"], "en": "Thus indeed did the venerable elder known as Pāṭihīrasaññaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_435:11.1"], "en": "This is the third legend of the elder Pāṭihīrasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
