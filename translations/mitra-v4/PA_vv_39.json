[
{"segs": ["PA_vv_39:0.1", "PA_vv_39:0.2", "PA_vv_39:0.3"], "en": "Vimānavatthu: The Chapter on the Mañjiṭṭhaka Mansion in the Section on Female Celestial Mansions (Itthivimāna)", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:0.4", "PA_vv_39:1.1"], "en": "1. The Mansion of Mañjiṭṭhaka “In the mañjiṭṭhaka mansion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:1.2"], "en": "strewn with golden sand;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:1.3", "PA_vv_39:1.4"], "en": "You delight in the well-sounded fivefold musical ensemble;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:2.1"], "en": "descending from that celestial mansion, [you come to me].", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:2.2"], "en": "Fashioned from jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:2.3"], "en": "you enter the sāla grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:2.4"], "en": "which is in full bloom at all times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:3.1", "PA_vv_39:3.2"], "en": "O deity, at whichever sal tree you stand at its root,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:3.3"], "en": "that very tree releases its flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:3.4"], "en": "Having bowed down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:4.1"], "en": "the Supreme Tree [beheld] the sāla grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:4.2"], "en": "shaken by the wind and frequented by birds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:4.3"], "en": "The fragrance wafts in all directions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:4.4"], "en": "like that of the mañjūsaka tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:5.1"], "en": "you smell that pure scent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:5.2"], "en": "\"You see a form that is not human;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:5.3"], "en": "O deity, being asked, tell me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:5.4"], "en": "of what karma is this the fruit?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:6.1"], "en": "“Having been born among humans as a human being,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:6.2"], "en": "I was a slave in a noble family;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:6.3"], "en": "having seen the Buddha seated, I— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:6.4"], "en": "I scattered *sāla* flowers [over him].", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:7.1", "PA_vv_39:7.2"], "en": "And I fashioned a well-crafted ear-ornament made of *sāla* flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:7.3", "PA_vv_39:7.4"], "en": "With my own hands, full of faith, I offered it to the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:8.1"], "en": "having performed that deed, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:8.2"], "en": "It is wholesome and praised by the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:8.3"], "en": "free from sorrow, happy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:8.4"], "en": "joyful, and free from illness.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_39:9.1"], "en": "The Mañjiṭṭhaka Vimāna is the first.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"}
]
