[
{"segs": ["PA_ja_278:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_278:0.2", "PA_ja_278:0.3"], "en": "Tikanipāta, Udapānavagga (The Chapter on the Well)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_278:0.4"], "en": "8. The Mahimsarāja Jātaka “For what purpose,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_278:1.1", "PA_ja_278:1.2"], "en": "with what intent, did you act thus toward one of light mind and treacherous nature?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_278:1.3"], "en": "Even for one who grants all desires,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_278:1.4"], "en": "you must endure this suffering;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_278:2.1"], "en": "strike it down with your tusks.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_278:2.2"], "en": "And stand firm on foot; otherwise,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_278:2.3"], "en": "fools will become even more enraged,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_278:2.4"], "en": "and there would be no one to restrain them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_278:3.1", "PA_ja_278:3.2"], "en": "“Thinking, ‘He thinks only of me,’ others will likewise act toward him;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_278:3.3"], "en": "they will kill him there.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_278:3.4"], "en": "\"That shall be my liberation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_278:4.1"], "en": "Thus ends the eighth Jātaka, the Mahiṁsarāja Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
