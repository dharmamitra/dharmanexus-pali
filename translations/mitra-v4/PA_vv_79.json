[
{"segs": ["PA_vv_79:0.1", "PA_vv_79:0.2"], "en": "Vimānavatthu: The Mansion of the Man,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:0.3"], "en": "Chapter on Well-Placed [Offerings]", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:0.4", "PA_vv_79:1.1"], "en": "5. The Story of the Mango Mansion “High is this celestial mansion with its jeweled pillars,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:1.2"], "en": "extending twelve yojanas in every direction.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:1.3"], "en": "There are seven hundred magnificent gabled halls,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:1.4"], "en": "beautiful with pillars of beryl and adorned with golden ornaments;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:2.1"], "en": "there you eat, drink, and feast.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:2.2"], "en": "Divine lutes resound with sweet melodies; here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:2.3"], "en": "divine flavors and the five strands of sensual pleasure abound,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:2.4"], "en": "and women adorned in gold dance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:3.1", "PA_vv_79:3.2"], "en": "“By what means do you have such a complexion...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:3.3"], "en": "[and so on] ...and your complexion illuminates all directions?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:4.1", "PA_vv_79:4.2"], "en": "Thus that son of the gods was delighted...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:4.3"], "en": "[as before] ...the fruit of which action this is.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:5.1"], "en": "In the last month of summer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:5.2"], "en": "when the sun blazes fiercely,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:5.3"], "en": "a man who lives as a hireling for others—", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:5.4", "PA_vv_79:6.1"], "en": "He was watering a mango grove when a monk arrived there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:6.2"], "en": "renowned as Sāriputta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:6.3"], "en": "Worn out in body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:6.4"], "en": "yet unwearied in mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:7.1"], "en": "and seeing him approaching, [he said:]", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:7.2"], "en": "I said, \"O water-sprinkler,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:7.3"], "en": "it would be well, Venerable Sir, if you would bathe me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:7.4"], "en": "which would bring me happiness.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:8.1"], "en": "Out of compassion for me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:8.2", "PA_vv_79:8.3"], "en": "he set aside his bowl and robes and sat down at the foot of a tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:8.4"], "en": "In the shade, wearing a single robe,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:9.1", "PA_vv_79:9.2"], "en": "a person with a serene mind [should bathe] with clear water.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:9.3"], "en": "He bathed at the foot of a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:9.4"], "en": "clad in a single robe in the shade.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:10.1"], "en": "The mango tree was watered, and the ascetic was bathed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:10.2"], "en": "And by me, no small merit has been performed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:10.3", "PA_vv_79:10.4"], "en": "thus, with joy, he suffuses his entire body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:11.1", "PA_vv_79:11.2"], "en": "That was the extent of the karma I performed in that birth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:11.3"], "en": "having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:11.4"], "en": "I have been reborn in the Nandana grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:12.1"], "en": "in that delightful Nandana forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:12.2"], "en": "which is filled with various flocks of birds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:12.3"], "en": "\"I delight in dance and song,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:12.4"], "en": "honored by the celestial nymphs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_79:13.1"], "en": "Thus ends the fifth, the Amba-vimāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"}
]
