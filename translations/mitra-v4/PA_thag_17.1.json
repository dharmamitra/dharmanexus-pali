[
{"segs": ["PA_thag_17.1:0.1"], "en": "Theragāthā 17.1,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:0.2", "PA_thag_17.1:0.3"], "en": "Tiṁsanipāta, Paṭhamavagga (The First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:0.4", "PA_thag_17.1:1.1"], "en": "Having seen many who are inspiring,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:1.2"], "en": "whose minds are developed and well-restrained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:1.3", "PA_thag_17.1:1.4"], "en": "Isi Paṇḍarasagotta asked the one named Phussa: “What are their inclinations?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:2.1"], "en": "What are their intentions?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:2.2"], "en": "\"What will their conduct be?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:2.3", "PA_thag_17.1:2.4"], "en": "Tell me that when asked, concerning the time yet to come.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:3.1"], "en": "“Listen to my words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:3.2"], "en": "O you who are called the Sage of the Pale Hue;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:3.3"], "en": "attend to them with careful attention.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:3.4"], "en": "I shall declare the future:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:4.1", "PA_thag_17.1:4.2"], "en": "many will be wrathful and resentful, slanderous, stubborn, and deceitful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:4.3", "PA_thag_17.1:4.4"], "en": "In the future, there will be those who are eager for gain and proponents of various doctrines,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:5.1"], "en": "who imagine they have realized the Dhamma when they have not.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:5.2"], "en": "Roaming the shores of the deep,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:5.3"], "en": "they are light and disrespectful toward the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:5.4"], "en": "showing no mutual reverence for one another.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:6.1", "PA_thag_17.1:6.2"], "en": "Many dangers will arise in the world in the future;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:6.3"], "en": "[yet] this Dhamma has been well-taught.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:6.4"], "en": "The foolish-minded will defile [the Saṅgha];", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:7.1", "PA_thag_17.1:7.2"], "en": "even those devoid of virtue, when speaking confidently within the Saṅgha, [will cause trouble].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:7.3"], "en": "There will be those who are powerful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:7.4"], "en": "talkative, and unlearned;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:8.1"], "en": "yet there will also be those endowed with virtues within the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:8.2"], "en": "Speaking according to the true meaning,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:8.3"], "en": "they will be weak, modest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:8.4"], "en": "and indifferent to worldly gain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:9.1"], "en": "Silver and gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:9.2"], "en": "fields and land, goats and sheep,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:9.3"], "en": "and female and male slaves— the foolish [desire these].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:9.4", "PA_thag_17.1:10.1"], "en": "In the future, fools will accept [offerings] while harboring resentment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:10.2"], "en": "being unconcentrated in their moral virtues.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:10.3"], "en": "The birds, delighting in quarrels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:10.4"], "en": "will wander about with their necks upraised;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:11.1"], "en": "they will become arrogant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:11.2"], "en": "Clad in blue robes, deceitful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:11.3"], "en": "stubborn, prattling, and hypocritical,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:11.4"], "en": "they will wander about like noble ones.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:12.1"], "en": "With hair matted in thirteen ways,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:12.2"], "en": "fickle and with eyes like collyrium,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:12.3"], "en": "they will go along the street.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:12.4"], "en": "Clad in garments the color of ivory,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:13.1", "PA_thag_17.1:13.2"], "en": "they wear the deep red banner of the Arahants, which is free from all loathsomeness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:13.3", "PA_thag_17.1:13.4"], "en": "Attached to white robes, they will loathe the saffron robe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:14.1"], "en": "they will become desirous of gain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:14.2"], "en": "Lazily and lacking in energy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:14.3"], "en": "distressed by the forest retreats,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:14.4"], "en": "they will dwell among the villages.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:15.1", "PA_thag_17.1:15.2"], "en": "Those who always delight in wrong livelihood will receive whatever gains they obtain;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:15.3"], "en": "by training themselves accordingly, they [will suffer].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:15.4"], "en": "The unrestrained will resort to them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:16.1", "PA_thag_17.1:16.2"], "en": "Those who do not obtain what they seek will not be honored.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:16.3"], "en": "Even though you are wise,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:16.4"], "en": "they will not serve you then;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:17.1"], "en": "they will serve the red-skinned barbarian people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:17.2"], "en": "Censuring their own banner,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:17.3", "PA_thag_17.1:17.4"], "en": "some will carry the pure white banner of the sectarians.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:18.1", "PA_thag_17.1:18.2"], "en": "Then there will be a lack of respect for the saffron robe among them,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:18.3"], "en": "as well as a lack of reflective discernment regarding the saffron robe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:18.4", "PA_thag_17.1:19.1"], "en": "It shall not be for the monks. For one overcome by suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:19.2"], "en": "pierced by the arrow and tormented;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:19.3"], "en": "Reflecting upon that great terror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:19.4"], "en": "the Naga’s thought was inconceivable;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:20.1"], "en": "for then, having seen [the elephant], the Six-Tusked One—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:20.2"], "en": "When the elephant had well-pleased the banner of the Arhat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:20.3", "PA_thag_17.1:20.4"], "en": "the poet immediately spoke verses endowed with meaning.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:21.1", "PA_thag_17.1:21.2"], "en": "He who, being impure, shall wear the saffron robe,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:21.3"], "en": "devoid of self-control and truth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:21.4", "PA_thag_17.1:22.1", "PA_thag_17.1:22.2"], "en": "He does not deserve the saffron robe who has not vomited out impurities and is not well-composed in his moral virtues.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:22.3"], "en": "Endowed with self-control and truthfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:22.4"], "en": "he indeed is worthy of the saffron robe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:23.1"], "en": "But the one of failed virtue and dull wit—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:23.2"], "en": "Evident, acting according to his own whims,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:23.3"], "en": "with a distracted mind and devoid of energy—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:23.4"], "en": "he does not deserve the saffron robe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:24.1"], "en": "But he who is endowed with virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:24.2"], "en": "free from passion, concentrated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:24.3"], "en": "and whose mental intentions are pure—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:24.4"], "en": "He indeed is worthy of the saffron robe:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:25.1"], "en": "the fool who is restless and arrogant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:25.2"], "en": "in whom virtue does not exist.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:25.3"], "en": "The white robe is what he deserves;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:25.4"], "en": "what will the saffron robe do?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:26.1"], "en": "Both the monks and the nuns...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:26.2"], "en": "With wicked minds and lacking respect,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:26.3", "PA_thag_17.1:26.4"], "en": "they will in the future suppress those who possess a mind of loving-kindness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:27.1", "PA_thag_17.1:27.2"], "en": "Even when being instructed by the elders in the wearing of robes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:27.3"], "en": "the foolish and dull-witted will not listen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:27.4"], "en": "They act according to their own whims.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:28.1"], "en": "Those fools, having trained in such a way,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:28.2"], "en": "show no respect for one another.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:28.3"], "en": "They will not heed their preceptors,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:28.4"], "en": "like a wild colt its driver;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:29.1"], "en": "thus, regarding the future time...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:29.2", "PA_thag_17.1:29.3", "PA_thag_17.1:29.4"], "en": "There will be the practice of the monks and the nuns when the final time has come.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:30.1", "PA_thag_17.1:30.2"], "en": "Before this great danger that has not yet come arrives,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:30.3"], "en": "be gentle-spoken and friendly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:30.4"], "en": "Respectful toward one another,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:31.1"], "en": "with hearts of loving-kindness and compassion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:31.2"], "en": "be restrained in your virtuous conduct.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:31.3"], "en": "Arousing energy, resolute,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:31.4"], "en": "always firm in their exertion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:32.1"], "en": "they see negligence as a danger.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:32.2"], "en": "And cultivate heedfulness as security,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:32.3"], "en": "developing the Eightfold Path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:32.4"], "en": "thereby touching the deathless state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.1:32.5"], "en": "… the Elder Phussa …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
