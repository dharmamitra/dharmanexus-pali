[
{"segs": ["PA_tha-ap_404:0.1", "PA_tha-ap_404:0.2", "PA_tha-ap_404:0.3"], "en": "The Apadāna of the Elder Puṇṇaka From the Metteyya Chapter of the Therāpadāna, Number Two.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:1.1"], "en": "“Relying on Pabbhārakūṭa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:1.2"], "en": "the Self-Existent One, the Unconquered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:1.3"], "en": "that Buddha was afflicted with illness.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:1.4"], "en": "He dwelt within the mountain range.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:2.1", "PA_tha-ap_404:2.2"], "en": "For a time, there was a great clamor in the vicinity of my hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:2.3"], "en": "While the Buddha was attaining Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:2.4", "PA_tha-ap_404:3.1"], "en": "a light arose throughout the entire grove.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:3.2"], "en": "Tigers, hyenas, and jackals,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:3.3"], "en": "as well as all the maned lions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:3.4"], "en": "let out their roars at that very moment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:4.1"], "en": "Having seen that portent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:4.2"], "en": "I went to a mountain slope;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:4.3"], "en": "there I saw the Fully Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:4.4"], "en": "Extinguished and unconquered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:5.1"], "en": "like a fully blossomed king of sāl trees,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:5.2"], "en": "or like the risen thousand-rayed sun.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:5.3"], "en": "Like a charcoal fire from which the sparks have vanished,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:5.4"], "en": "extinguished and unconquered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:6.1"], "en": "having filled it with grass and wood—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:6.2"], "en": "I had a funeral pyre prepared there;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:6.3"], "en": "having constructed a well-made pyre,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:6.4"], "en": "I cremated the body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:7.1"], "en": "Having cremated the body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:7.2"], "en": "I sprinkled it with scented water;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:7.3"], "en": "while standing in the sky, a yakkha—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:7.4"], "en": "He then took his name:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:8.1", "PA_tha-ap_404:8.2"], "en": "\"Whatever duty was fulfilled by you for the Self-Existent Great Sage,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:8.3", "PA_tha-ap_404:8.4"], "en": "\"O Sage, may you always be known by the name Puṇṇaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:9.1"], "en": "Having passed away from that body, [he was reborn].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:9.2"], "en": "I went to the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:9.3", "PA_tha-ap_404:9.4"], "en": "there, divine fragrances rained down from the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:10.1", "PA_tha-ap_404:10.2"], "en": "Even there, my name was Puṇṇaka at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:10.3"], "en": "whether as a god or as a human.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:10.4"], "en": "I shall fulfill my intention.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:11.1"], "en": "This is my final one;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:11.2"], "en": "my last existence is now proceeding.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:11.3", "PA_tha-ap_404:11.4"], "en": "Here too, the name Puṇṇaka is proclaimed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:12.1"], "en": "having satisfied the Fully Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:12.2", "PA_tha-ap_404:12.3", "PA_tha-ap_404:12.4"], "en": "Having fully understood all taints, I dwell free from taints, having approached Gotama, the bull among the Sakyans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:13.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:13.2"], "en": "because of the deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:13.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:13.4"], "en": "This is the fruit of my bodily service:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:14.1", "PA_tha-ap_404:14.2"], "en": "the defilements have been burnt away by me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:14.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:15.1", "PA_tha-ap_404:15.2"], "en": "Welcome indeed has come to me... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:15.3"], "en": "The Buddha’s teaching has been proclaimed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:16.1", "PA_tha-ap_404:16.2"], "en": "the four analytical knowledges, and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:16.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:17.1"], "en": "In this way, it is said, the venerable elder Puṇṇaka recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_404:18.1"], "en": "This is the second *apadāna* of the elder Puṇṇaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
