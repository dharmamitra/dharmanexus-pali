[
{"segs": ["PA_tha-ap_37:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:0.2"], "en": "The Section on Kuṇḍadhāna, No. 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:0.3"], "en": "The Legend of the Elder Mogharāja.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:1.1"], "en": "But the Blessed One Atthadassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:1.2"], "en": "the self-become, the unconquered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:1.3"], "en": "surrounded by the community of monks—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:1.4"], "en": "Set out upon the road.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:2.1"], "en": "Surrounded by my disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:2.2"], "en": "I went forth from home.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:2.3"], "en": "Having gone forth there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:2.4"], "en": "I beheld the Leader of the World;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:3.1"], "en": "having paid homage to the Fully Awakened One, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:3.2", "PA_tha-ap_37:3.3"], "en": "Having placed my hands together in añjali and having gladdened my own heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:3.4"], "en": "I praised the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:4.1", "PA_tha-ap_37:4.2"], "en": "All beings whatsoever, whether possessing form or formless, or even those without perception—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:4.3"], "en": "all of them are within your knowledge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:4.4"], "en": "They become submerged within.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:5.1", "PA_tha-ap_37:5.2"], "en": "One who casts a net with fine mesh over the water;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:5.3", "PA_tha-ap_37:5.4"], "en": "Whatever living beings there are in the water that come within the net,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:6.1"], "en": "and those who possess consciousness—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:6.2"], "en": "Both those with form and those without form—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:6.3", "PA_tha-ap_37:6.4"], "en": "all of them are contained within your knowledge, submerged therein.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:7.1"], "en": "You have rescued this world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:7.2"], "en": "which was overwhelmed by darkness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:7.3"], "en": "having heard your Dhamma, [we are liberated].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:7.4", "PA_tha-ap_37:8.1", "PA_tha-ap_37:8.2"], "en": "They cross over the stream of doubt in this world that is shrouded by ignorance and enveloped in darkness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:8.3"], "en": "While your wisdom shines,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:8.4"], "en": "the darknesses are dispelled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:9.1"], "en": "you are the eye for all.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:9.2"], "en": "Dispelling the great darkness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:9.3", "PA_tha-ap_37:9.4"], "en": "many people, having heard your Dhamma, attain Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:10.1"], "en": "Having filled a basket with honey,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:10.2"], "en": "molasses, and parched grain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:10.3"], "en": "and taking it up with both hands, he said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:10.4"], "en": "I brought it to the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:11.1", "PA_tha-ap_37:11.2"], "en": "The Great Hero, the Great Seer, accepted it with his own hand.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:11.3", "PA_tha-ap_37:11.4"], "en": "Having eaten that, the All-Knowing One rose up into the air through the sky;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:12.1"], "en": "standing in the firmament, the Teacher—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:12.2"], "en": "Atthadassī, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:12.3", "PA_tha-ap_37:12.4"], "en": "spoke these verses, gladdening my heart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:13.1"], "en": "“By that knowledge which has been established here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:13.2"], "en": "and by the praise of the Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:13.3"], "en": "through that clarity of mind, [may I attain the same state].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:13.4"], "en": "He does not go to an evil destination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:14.1", "PA_tha-ap_37:14.2"], "en": "Fourteen times he shall exercise sovereignty over the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:14.3", "PA_tha-ap_37:14.4"], "en": "He will dwell upon the earth, ruling over the kingdom of the land for eight hundred times,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:15.1"], "en": "and five hundred times more.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:15.2"], "en": "He will become a wheel-turning monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:15.3", "PA_tha-ap_37:15.4"], "en": "he will exercise regional sovereignty over the earth for an incalculable period.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:16.1"], "en": "A reciter, a bearer of the mantras,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:16.2"], "en": "one who has mastered the three Vedas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:16.3"], "en": "of the Blessed One Gotama, [he was a disciple].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:16.4"], "en": "He will go forth in the Dispensation;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:17.1", "PA_tha-ap_37:17.2"], "en": "with wisdom, he will investigate the profound and subtle meaning.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:17.3"], "en": "By the name Mogharāja,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:17.4"], "en": "he will become a disciple of the Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:18.1"], "en": "endowed with the three types of higher knowledge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:18.2"], "en": "“Having accomplished his task and being free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:18.3"], "en": "Gotama, the supreme leader of caravans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:18.4"], "en": "will place me at the very head of this list.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:19.1"], "en": "Having abandoned human attachment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:19.2"], "en": "having severed the bond of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:19.3"], "en": "and having fully understood all taints—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:19.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:20.1", "PA_tha-ap_37:20.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:20.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:21.1"], "en": "In this way, it is said, the venerable elder Mogharāja recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_37:22.1"], "en": "This is the fifth legend (apadāna) of the elder Mogharāja.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
