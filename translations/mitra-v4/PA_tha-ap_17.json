[
{"segs": ["PA_tha-ap_17:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:0.2"], "en": "The Chapter on the Lion Throne (Sīhāsaniyavagga),", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:0.3"], "en": "Pilindavaccha Thera Apadāna, Number 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:1.1", "PA_tha-ap_17:1.2"], "en": "“When the Protector of the World, Sumedha, the Supreme Person, had attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:1.3"], "en": "with a clear heart and a joyful mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:1.4"], "en": "I performed an offering at the stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:2.1"], "en": "And those there who had exhausted the taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:2.2"], "en": "possessing the six direct knowledges and great psychic power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:2.3"], "en": "Having gathered them there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:2.4", "PA_tha-ap_17:3.1"], "en": "I provided a meal for the Saṅgha for the Blessed One Sumedha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:3.2"], "en": "At that time, he was the attendant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:3.3"], "en": "known by the name Sumedha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:3.4"], "en": "he then offered his words of appreciation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:4.1"], "en": "Through that clarity of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:4.2"], "en": "I was reborn in a celestial mansion;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:4.3"], "en": "eighty-six thousand [beings were there].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:4.4"], "en": "The nymphs delighted me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:5.1", "PA_tha-ap_17:5.2"], "en": "they always attended to me alone with every kind of sensual pleasure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:5.3"], "en": "I surpass other devas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:5.4"], "en": "this is the fruit of meritorious karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:6.1"], "en": "In the twenty-fifth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:6.2"], "en": "I was then a kshatriya named Varuṇa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:6.3", "PA_tha-ap_17:6.4"], "en": "a wheel-turning monarch whose food was pure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:7.1"], "en": "They do not sow seed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:7.2"], "en": "nor are plows led forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:7.3"], "en": "they enjoy rice that ripens without being tilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:7.4"], "en": "Human beings enjoy [these pleasures].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:8.1"], "en": "Having ruled there as king,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:8.2"], "en": "I shall go once again to the state of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:8.3", "PA_tha-ap_17:8.4"], "en": "Even then, such was the perfection of wealth that arose for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:9.1"], "en": "neither friends nor enemies could affect me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:9.2"], "en": "They harm all living beings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:9.3"], "en": "yet I am dear to everyone—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:9.4"], "en": "this is the fruit of meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:10.1"], "en": "In thirty thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:10.2"], "en": "whatever gift I gave at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:10.3"], "en": "I do not know a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:10.4"], "en": "This is the fruit of anointing with perfume.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:11.1"], "en": "In this auspicious aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:11.2"], "en": "I was once a sole ruler of men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:11.3"], "en": "\"I am a king of great power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:11.4"], "en": "a wheel-turning monarch of mighty strength.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:12.1"], "en": "I [abide] in the five precepts.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:12.2"], "en": "Setting aside the vast multitude of people,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:12.3", "PA_tha-ap_17:12.4"], "en": "he caused them to reach only happy destinies and became beloved by the deities.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:13.1"], "en": "The four analytical knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:13.2"], "en": "the eight liberations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:13.3"], "en": "and the six direct knowledges have been realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:13.4"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:14.1"], "en": "In this way, it is said, the venerable elder Pilindavaccha recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_17:15.1"], "en": "This is the fifth *apadāna* of the elder Pilindavaccha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
