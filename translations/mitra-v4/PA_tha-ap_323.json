[
{"segs": ["PA_tha-ap_323:0.1", "PA_tha-ap_323:0.2"], "en": "The Apadāna of the Elder Umāpupphiya Umāpupphiyavagga 1:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:0.3"], "en": "The Apadāna of the Elder Umāpupphiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:1.1", "PA_tha-ap_323:1.2"], "en": "“Siddhattha, the unconquered, absorbed in meditative attainment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:1.3"], "en": "seated in concentration;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:1.4"], "en": "I saw the Supreme among Men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:2.1"], "en": "Taking an umā flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:2.2"], "en": "I offered it to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:2.3"], "en": "All the flowers have a single stem;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:2.4"], "en": "their stalks point upward and their faces downward.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:3.1"], "en": "They stand there as if beautifully adorned.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:3.2"], "en": "There were flower-strewn carpets in the sky;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:3.3"], "en": "through that clarity of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:3.4"], "en": "I was reborn in Tusita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:4.1"], "en": "For ninety-four eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:4.2"], "en": "because I offered that flower in worship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:4.3"], "en": "I have not known a state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:4.4"], "en": "This is the fruit of worshiping the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:5.1"], "en": "in the fifty-fifth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:5.2"], "en": "I was once a lord of the earth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:5.3", "PA_tha-ap_323:5.4"], "en": "There was a wheel-turning monarch named Samantacchadana, possessed of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:6.1"], "en": "he attained the four analytical knowledges (paṭisambhidā).", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:6.2", "PA_tha-ap_323:6.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:6.4"], "en": "the Buddha’s teaching has been accomplished.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:7.1"], "en": "Thus indeed the Venerable Elder Umāpupphiya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_323:8.1"], "en": "This is the first legend of the Elder Umāpupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
