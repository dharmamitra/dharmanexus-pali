[
{"segs": ["PA_tha-ap_25:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:0.2"], "en": "Subhūti Chapter 3:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:0.3"], "en": "The Apadāna of the Elder Tisaraṇagamaniya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:1.1"], "en": "“In the city of Candavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:1.2"], "en": "I was the attendant to my mother;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:1.3"], "en": "both my mother and father were blind.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:1.4"], "en": "I then nourished them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:2.1"], "en": "Sitting down in seclusion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:2.2"], "en": "I then reflected thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:2.3"], "en": "Supporting my mother and father,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:2.4"], "en": "I did not obtain the going forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:3.1"], "en": "Enveloped in great darkness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:3.2"], "en": "When one is consumed by the three kinds of fires,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:3.3"], "en": "and such a state of existence has arisen,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:3.4"], "en": "there is no leader whatsoever.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:4.1"], "en": "A Buddha has arisen in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:4.2"], "en": "and now the Teaching shines forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:4.3"], "en": "it is possible to uplift oneself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:4.4"], "en": "A person desiring merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:5.1"], "en": "having taken up the three refuges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:5.2"], "en": "should guard them completely.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:5.3"], "en": "By that well-performed deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:5.4"], "en": "I escape from an evil rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:6.1"], "en": "There was a monk named Nisabha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:6.2"], "en": "The foremost disciple of the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:6.3"], "en": "having approached him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:6.4"], "en": "I took refuge in him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:7.1"], "en": "For a hundred thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:7.2"], "en": "such a lifespan exists;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:7.3"], "en": "for that long, one goes for refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:7.4"], "en": "I protected it until it was complete.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:8.1"], "en": "When my final moment arrived,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:8.2"], "en": "I recollected that refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:8.3"], "en": "By that well-performed kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:8.4"], "en": "I went to the Tāvatiṃsa heaven;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:9.1"], "en": "having reached the world of the gods, I remained there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:9.2"], "en": "Established in meritorious deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:9.3"], "en": "whatever region I am reborn in,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:9.4"], "en": "I obtain eight causes.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:10.1"], "en": "I am honored in all directions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:10.2"], "en": "I possess sharp wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:10.3"], "en": "and all the devas follow me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:10.4"], "en": "May I obtain immeasurable wealth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:11.1", "PA_tha-ap_25:11.2"], "en": "may I be golden-hued everywhere and be pleasing to behold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:11.3"], "en": "I am unshakable among my friends;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:11.4"], "en": "my fame has spread abroad.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:12.1"], "en": "Eighty times as the lord of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:12.2"], "en": "I exercised sovereignty over the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:12.3", "PA_tha-ap_25:12.4"], "en": "honored by apsarases, I experienced divine bliss.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:13.1", "PA_tha-ap_25:13.2"], "en": "And seventy-five times I was a universal monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:13.3"], "en": "I possessed extensive sovereignty over various regions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:13.4"], "en": "Incalculable by calculation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:14.1"], "en": "When his final existence has been reached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:14.2"], "en": "he is established in meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:14.3"], "en": "Born pure in Sāvatthī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:14.4"], "en": "in a very wealthy great mansion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:15.1"], "en": "having departed from the city—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:15.2", "PA_tha-ap_25:15.3"], "en": "Surrounded by children who were full of laughter and play,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:15.4"], "en": "I approached the monastery of the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:16.1"], "en": "There I saw a recluse,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:16.2"], "en": "completely liberated and free from acquisitions;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:16.3"], "en": "he taught the Dhamma to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:16.4"], "en": "And he granted me refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:17.1"], "en": "Having heard that refuge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:17.2"], "en": "I recollected that refuge as my own.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:17.3"], "en": "Sitting on a single seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:17.4", "PA_tha-ap_25:18.1"], "en": "I attained arahantship in my seventh year from birth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:18.2"], "en": "I attained arahantship;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:18.3", "PA_tha-ap_25:18.4"], "en": "the Buddha, the Seer, having recognized my virtues, granted me full ordination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:19.1"], "en": "In an immeasurable aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:19.2"], "en": "I went for refuge;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:19.3"], "en": "therefore, that deed was well-performed by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:19.4"], "en": "It has shown me its fruit here:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:20.1"], "en": "my refuge is well-guarded,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:20.2"], "en": "and my mind is well-directed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:20.3"], "en": "Having experienced all that glory,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:20.4"], "en": "I have attained the unshakable state—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:21.1"], "en": "for those who possess the ear for listening.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:21.2"], "en": "Listen as I speak;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:21.3", "PA_tha-ap_25:21.4"], "en": "I shall tell you of the state I have seen for myself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:22.1"], "en": "“A Buddha has arisen in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:22.2"], "en": "the Victor’s dispensation proceeds;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:22.3"], "en": "the drum of the Deathless is sounded.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:22.4"], "en": "The dispelling of the dart of sorrow.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:23.1"], "en": "According to one's own power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:23.2"], "en": "in this unsurpassed field of merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:23.3"], "en": "Exert yourselves;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:23.4"], "en": "you shall behold Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:24.1"], "en": "Having taken up the three refuges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:24.2", "PA_tha-ap_25:24.3"], "en": "Guarding the five precepts and having inspired confidence in the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:24.4"], "en": "you shall make an end of suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:25.1", "PA_tha-ap_25:25.2"], "en": "Having rightly developed the Dhamma and guarded the precepts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:25.3"], "en": "before long you will attain Arhatship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:25.4"], "en": "\"You shall all attain it as well.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:26.1"], "en": "I am one possessed of the threefold knowledge, attained to supernormal powers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:26.2"], "en": "and skilled in discerning the minds of others.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:26.3", "PA_tha-ap_25:26.4"], "en": "“O Great Hero, your disciple Saraṇa pays homage to the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:27.1"], "en": "In an incalculable eon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:27.2"], "en": "I go for refuge to the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:27.3"], "en": "I do not recognize a miserable rebirth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:27.4"], "en": "this is the fruit of going for refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:28.1"], "en": "The four analytical knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:28.2"], "en": "these eight liberations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:28.3"], "en": "and the six direct knowledges have been realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:28.4"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:29.1"], "en": "Thus indeed did the venerable elder Tisaraṇagamaniya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_25:30.1"], "en": "This is the third legend of the elder Tisaraṇagamaniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
