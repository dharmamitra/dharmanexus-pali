[
{"segs": ["PA_thig_4.1:0.1", "PA_thig_4.1:0.2"], "en": "Therīgāthā 4.1 Catukkanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:0.3"], "en": "The Verses of the Elder Nun Bhaddākāpilānī", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:1.1"], "en": "“The son and heir of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:1.2"], "en": "Kassapa, who is well-composed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:1.3"], "en": "knows his former abodes.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:1.4"], "en": "He sees both heaven and the states of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:2.1"], "en": "moreover, having reached the destruction of birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:2.2"], "en": "the sage is perfected through direct knowledge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:2.3"], "en": "By these three knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:2.4"], "en": "a Brahmin becomes one possessed of the threefold knowledge (tevijjo).", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:3.1"], "en": "Just so was Bhaddā Kāpilānī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:3.2"], "en": "Possessing the threefold knowledge, she has abandoned death;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:3.3", "PA_thig_4.1:3.4"], "en": "having conquered Māra and his host, she bears her final body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:4.1"], "en": "Having seen the peril in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:4.2"], "en": "we both have gone forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:4.3"], "en": "we are tamed ones whose taints are exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:4.4"], "en": "“We have become cooled; we are extinguished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:5.1"], "en": "… Thus spoke the Elder Nun Bhaddā Kāpilānī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_4.1:6.1"], "en": "The Fourth Chapter is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
