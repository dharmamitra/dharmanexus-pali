[
{"segs": ["PA_tha-ap_347:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:0.2"], "en": "Ekapadumiya-vagga 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:0.3"], "en": "The Apadāna of the Elder Naḷāgārika", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:1.1"], "en": "Not far from the Himālaya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:1.2"], "en": "there is a mountain named Hārita;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:1.3"], "en": "[there dwells] the Self-Existent One named Nārada.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:1.4"], "en": "At that time, I lived at the foot of a tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:2.1"], "en": "having constructed a reed hut,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:2.2"], "en": "I covered it with grass.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:2.3"], "en": "Having cleansed the walking path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:2.4"], "en": "I gave it to the Self-Existent One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:3.1"], "en": "For fourteen eons...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:3.2"], "en": "I took delight in the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:3.3", "PA_tha-ap_347:3.4"], "en": "seventy-four times I exercised sovereignty over the devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:4.1", "PA_tha-ap_347:4.2"], "en": "And seventy-four times I was a wheel-turning monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:4.3"], "en": "I also held extensive regional sovereignty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:4.4"], "en": "In number, it is incalculable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:5.1"], "en": "My palace rises aloft,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:5.2"], "en": "towering like Indra’s pillar.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:5.3", "PA_tha-ap_347:5.4", "PA_tha-ap_347:6.1"], "en": "Having enjoyed two kinds of excellence— a peerless mansion with a thousand pillars, radiant and luminous—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:6.2"], "en": "Urged on by the root of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:6.3", "PA_tha-ap_347:6.4"], "en": "I went forth in the teaching of the Blessed One Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:7.1"], "en": "I am devoted to striving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:7.2"], "en": "peaceful, and free from acquisitions;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:7.3"], "en": "like a naga who has severed its bonds, I have broken through.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:7.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:8.1", "PA_tha-ap_347:8.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:8.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:9.1"], "en": "In this way, it is said, the venerable elder Naḷāgārika recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_347:10.1"], "en": "This is the fifth legend of the elder Naḷāgārika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
