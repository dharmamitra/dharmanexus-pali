{"segs": ["PA_thag_1.73:0.1", "PA_thag_1.73:0.2", "PA_thag_1.73:0.3"], "en": "Theragāthā 1.73 Ekakanipāta Aṭṭhamavagga (The Eighth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.73:0.4"], "en": "The Verses of the Elder Māṇava:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.73:1.1"], "en": "“Having seen one who is aged and one who is suffering from illness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.73:1.2"], "en": "and having seen one who is dead, their life-span exhausted;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.73:1.3", "PA_thag_1.73:1.4"], "en": "Then, having gone forth from there, I went into homelessness, abandoning delightful sensual pleasures. ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.73:1.5"], "en": "[Thus spoke] the Elder Māṇava.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
