{"segs": ["PA_ja_212:0.4"], "en": "2. The Ucchiṭṭhabhatta Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_212:1.1", "PA_ja_212:1.2"], "en": "“The upper complexion is one thing, and the lower complexion is another.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_212:1.3"], "en": "\"But, O Brahmin, I ask you this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_212:1.4"], "en": "what is below and what is above?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_212:2.1"], "en": "\"I am a dancer, venerable sir.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_212:2.2"], "en": "“I am a mendicant who has come here;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_212:2.3", "PA_ja_212:2.4"], "en": "for this one has descended from the peak— this is he whom you seek.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_212:3.1"], "en": "The Ucchiṭṭhabhattajātaka is the second.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
