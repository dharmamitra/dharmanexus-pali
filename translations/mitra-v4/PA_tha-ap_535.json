[
{"segs": ["PA_tha-ap_535:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:0.2"], "en": "Kaccāyanavagga 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:0.3"], "en": "The Apadāna of the Elder Mahākappina", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:1.2"], "en": "who has gone beyond all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:1.3"], "en": "has arisen like the sun in a cloudless sky.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:1.4"], "en": "Like the sun in the autumn sky,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:2.1", "PA_tha-ap_535:2.2"], "en": "he awakens the lotuses of those to be trained through his speech.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:2.3", "PA_tha-ap_535:2.4"], "en": "The Leader dries up the mire of defilements with the rays of his wisdom;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:3.1"], "en": "he destroys the fame of the sectarians.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:3.2"], "en": "Like the sun dispelling the glow of fireflies,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:3.3"], "en": "he illuminates the light of truth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:3.4"], "en": "like the sun revealing a jewel.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:4.1"], "en": "He is the source of all virtues,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:4.2"], "en": "like the ocean is of jewels;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:4.3"], "en": "he is like the rain-cloud Parjanya to all living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:4.4"], "en": "It rained with a cloud of Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:5.1", "PA_tha-ap_535:5.2"], "en": "At that time, I was Akkhadassa in the city called Haṃsa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:5.3", "PA_tha-ap_535:5.4"], "en": "With equanimity, I listened to the Dhamma from the one named Jalajuttama,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:6.1"], "en": "the instructor of the bhikkhus.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:6.2", "PA_tha-ap_535:6.3", "PA_tha-ap_535:6.4"], "en": "It distresses my mind to see a disciple who has accomplished his task proclaiming his own virtues.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:7.1"], "en": "Having heard this, he was thrilled and joyful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:7.2", "PA_tha-ap_535:7.3"], "en": "having invited the Tathāgata along with his disciples, he fed them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:7.4"], "en": "I aspired for that state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:8.1"], "en": "At that time, I was equal in appearance to a swan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:8.2"], "en": "with a voice like the drumming of a swan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:8.3"], "en": "“Behold this great minister,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:8.4"], "en": "skilled in legal adjudication,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:9.1"], "en": "fallen at my feet.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:9.2"], "en": "With his body hair standing on end,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:9.3"], "en": "cloud-colored, broad-shouldered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:9.4"], "en": "and with a serene face and eyes.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:10.1"], "en": "With a great retinue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:10.2", "PA_tha-ap_535:10.3"], "en": "he stands in the place of one who has accomplished what was to be done— the station of the highly renowned King’s Son.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:10.4"], "en": "One who has a heart full of gladness makes an aspiration.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:11.1"], "en": "By means of this prostration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:11.2"], "en": "through generosity, and by means of aspirations;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:11.3"], "en": "For a hundred thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:11.4"], "en": "he does not fall into an evil rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:12.1"], "en": "among the gods, he enjoys divine splendor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:12.2"], "en": "Having experienced greatness among human beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:12.3", "PA_tha-ap_535:12.4"], "en": "he will attain Nibbāna with what remains.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:13.1"], "en": "In a hundred thousand aeons hence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:13.2"], "en": "one born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:13.3"], "en": "known by the family name Gotama, will appear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:13.4"], "en": "A Teacher shall appear in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:14.1"], "en": "His heir in the teachings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:14.2"], "en": "his own legitimate son, fashioned from the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:14.3", "PA_tha-ap_535:14.4"], "en": "‘One named Kappina shall be a disciple of the Teacher. Then I,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:15.1"], "en": "having performed that well-done deed, [continued:]", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:15.2"], "en": "Having acted thus in the teaching of the Victor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:15.3"], "en": "and having cast off my human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:15.4"], "en": "I went to the Tusita heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:16.1", "PA_tha-ap_535:16.2"], "en": "Having ruled over the realms of gods and men for a hundred years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:16.3"], "en": "[he dwelt] near Bārāṇasī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:16.4"], "en": "I was born into the Keniya clan;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:17.1"], "en": "accompanied by a thousand followers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:17.2"], "en": "I was together with my wife.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:17.3", "PA_tha-ap_535:17.4"], "en": "I attended upon five hundred paccekabuddhas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:18.1"], "en": "having fed them for three months, I...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:18.2"], "en": "We gave him a triple robe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:18.3"], "en": "then, passing away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:18.4"], "en": "we all went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:19.1", "PA_tha-ap_535:19.2"], "en": "Again, having passed away from there, we all came to human birth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:19.3"], "en": "we were born in the city of Kukkuṭa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:19.4"], "en": "On the slopes of the Himalayas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:20.1"], "en": "I was known as Kappina,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:20.2"], "en": "a prince of great renown.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:20.3", "PA_tha-ap_535:20.4"], "en": "Those born into the families of my ministers surrounded me alone;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:21.1"], "en": "I attained the bliss of great sovereignty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:21.2"], "en": "Possessing the fulfillment of all desires,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:21.3", "PA_tha-ap_535:21.4"], "en": "I heard from the merchants the proclamation of the Great Festival of the Buddha’s Appearance in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:22.1"], "en": "“A Buddha has arisen in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:22.2"], "en": "the peerless, singular person;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:22.3"], "en": "he proclaims the true Dhamma.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:22.4"], "en": "The deathless, the supreme bliss.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:23.1", "PA_tha-ap_535:23.2"], "en": "His disciples are well-yoked and well-liberated, free from taints.’\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:23.3", "PA_tha-ap_535:23.4"], "en": "Having heard their well-spoken words and having honored those merchants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:24.1"], "en": "he abandoned his kingdom along with his ministers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:24.2"], "en": "I departed, devoted to the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:24.3"], "en": "seeing the great river Mahācanda,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:24.4"], "en": "filled to the brim.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:25.1"], "en": "Without a footing, without support,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:25.2"], "en": "difficult to cross, and flowing swiftly—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:25.3"], "en": "by recollecting the virtue of the Buddha, [one crosses it].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:25.4"], "en": "I crossed over in safety.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:26.1", "PA_tha-ap_535:26.2"], "en": "“If the Buddha, the wise one who has reached the end of the world, has crossed the stream of existence;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:26.3"], "en": "By this utterance of truth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:26.4"], "en": "may my journey be successful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:27.1"], "en": "if it is indeed the path leading to peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:27.2"], "en": "Liberation is ultimate happiness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:27.3"], "en": "by this utterance of truth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:27.4"], "en": "may my journey be successful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:28.1"], "en": "If the Sangha has crossed the wilderness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:28.2"], "en": "the unsurpassed field of merit—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:28.3"], "en": "by this utterance of truth, may...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:28.4"], "en": "\"May my journey be successful!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:29.1"], "en": "As soon as this supreme truth was uttered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:29.2"], "en": "the water vanished from the path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:29.3"], "en": "Then, having crossed over with ease,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:29.4", "PA_tha-ap_535:30.1"], "en": "I saw the Buddha seated on a delightful riverbank.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:30.2"], "en": "Like the rising sun that radiates light,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:30.3"], "en": "like a blazing mountain of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:30.4"], "en": "or like a lamp-tree set aflame.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:31.1"], "en": "Like the moon accompanied by stars,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:31.2"], "en": "honored by his disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:31.3"], "en": "like Vāsava raining down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:31.4", "PA_tha-ap_535:32.1"], "en": "Having paid homage at the edge of the ocean of the teaching, together with my companions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:32.2"], "en": "I sat down to one side.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:32.3"], "en": "Then, having known our disposition,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:32.4"], "en": "the Buddha taught the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:33.1"], "en": "Having heard the stainless Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:33.2"], "en": "We said to the Jina:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:33.3"], "en": "“Let us go forth, O Great Hero;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:33.4"], "en": "we are weary of existence.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:34.1", "PA_tha-ap_535:34.2"], "en": "“Monks, the Dhamma is well-expounded for bringing about the end of suffering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:34.3"], "en": "lead the holy life.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:34.4"], "en": "Thus spoke the Best of Sages.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:35.1"], "en": "At that very word,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:35.2"], "en": "we all assumed the appearance of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:35.3", "PA_tha-ap_535:35.4"], "en": "We have received full ordination and become stream-enterers in the Teaching. Then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:36.1"], "en": "having gone to Jetavana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:36.2"], "en": "The Guide gave me instruction;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:36.3"], "en": "instructed by the Conqueror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:36.4"], "en": "I attained Arhatship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:37.1"], "en": "Then I instructed thousands of bhikkhus;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:37.2", "PA_tha-ap_535:37.3"], "en": "they were those who carried out my instruction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:37.4"], "en": "They too were free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:38.1", "PA_tha-ap_535:38.2"], "en": "Pleased with that quality, the Victor placed me in this foremost position.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:38.3", "PA_tha-ap_535:38.4"], "en": "Kappina was foremost among those who exhort the bhikkhus in the great assembly;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:39.1"], "en": "he performed this deed during one hundred thousand [aeons].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:39.2"], "en": "It showed me its fruit right here:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:39.3"], "en": "like an arrow released from a bow,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:39.4"], "en": "it consumed my defilements.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:40.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:40.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:40.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:41.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:41.2", "PA_tha-ap_535:41.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:42.1", "PA_tha-ap_535:42.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:42.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:43.1"], "en": "Thus indeed did the venerable elder Mahākappina speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_535:44.1"], "en": "This is the third legend of the elder Mahākappina.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
