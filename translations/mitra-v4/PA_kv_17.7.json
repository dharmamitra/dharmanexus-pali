[
{"segs": ["PA_kv_17.7:0.1"], "en": "Points of Controversy,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:0.2"], "en": "Great Fifty,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:0.3"], "en": "Seventeenth Chapter", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:0.4", "PA_kv_17.7:1.1", "PA_kv_17.7:1.2"], "en": "The Discussion on Whether It Should Not Be Said That the Sangha Purifies the Offering: Should it not be said that \"the Sangha purifies the offering\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:1.3"], "en": "“Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:1.4"], "en": "“Is it not true that the Saṅgha is worthy of offerings, worthy of hospitality, worthy of gifts, worthy of reverential salutation, and is an unsurpassed field of merit for the world?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:1.5"], "en": "“Yes.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:1.6"], "en": "If the Saṅgha is worthy of offerings … [and so on] … an unsurpassed field of merit for the world, then indeed, sir, you ought to say:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:1.7"], "en": "“The Saṅgha purifies the gift.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:2.1"], "en": "It should not be said that it does not.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:2.2"], "en": "“Does the Saṅgha purify the offering?”—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:2.3"], "en": "“Yes.”—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:2.4"], "en": "“But have not four pairs of persons, eight individual beings, been declared by the Blessed One to be worthy of offerings?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:2.5"], "en": "“Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:2.6"], "en": "[The opponent asks: “If it is true that four pairs of persons, eight individual types of persons, have been declared by the Blessed One to be worthy of offerings, then indeed, sir, it must be said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:2.7"], "en": "‘The Saṅgha purifies the offering.’”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:3.1", "PA_kv_17.7:3.2"], "en": "Is it not to be said that \"the Saṅgha purifies the offering\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:3.3"], "en": "Yes, it is.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:3.4"], "en": "Is it not the case that there are some who, having given a gift to the Saṅgha, fulfill the merit of the offering?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:3.5"], "en": "Yes, they do.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:3.6"], "en": "If indeed there are some who, having given a gift to the Saṅgha, fulfill the merit of the offering, then surely, sir, it must be said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:3.7"], "en": "“The Saṅgha purifies the offering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:4.1", "PA_kv_17.7:4.2"], "en": "Is it not the case that there are some who, having given robe-cloth to the Saṅgha …pe… having given almsfood to the Saṅgha …pe…?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:4.3"], "en": "Having given a dwelling place...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:4.4"], "en": "having given medicinal requisites as support for the sick...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:4.5"], "en": "having given solid food...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:4.6"], "en": "\"Having given solid food...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:4.7"], "en": "having given a drink, one 'fulfills the merit of the offering'?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:4.8"], "en": "\"Yes.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:4.9"], "en": "If there are some who, by giving drinking water to the Saṅgha, fulfill their offering, then indeed it should be said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:4.10"], "en": "\"The Saṅgha purifies the offering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:5.1"], "en": "Does the Saṅgha purify the offering?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:5.2"], "en": "“Yes,” you say.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:5.3"], "en": "“The path purifies; the fruit purifies”?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:5.4"], "en": "You should not speak thus … [as before] … .", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.7:5.5"], "en": "The discussion on whether it should be said that the Saṅgha purifies the offering is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
