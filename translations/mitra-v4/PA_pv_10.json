[
{"segs": ["PA_pv_10:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:0.2"], "en": "Uragavagga, 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:0.3"], "en": "The Story of the Petī Khalḷāṭikā", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:1.1", "PA_pv_10:1.2"], "en": "“Who is this standing within the celestial palace who has not come out?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:1.3"], "en": "Come out, O blessed lady!”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:1.4"], "en": "“Let us see you standing outside!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:2.1", "PA_pv_10:2.2"], "en": "“I am ashamed and abashed to go out naked.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:2.3", "PA_pv_10:2.4"], "en": "\"How is it that my merit is so small, though it was performed in secret?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:3.1"], "en": "\"Then I shall give you an upper garment.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:3.2", "PA_pv_10:3.3"], "en": "Put on this cloth; having put on this cloth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:3.4"], "en": "come forth, O beautiful one!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:3.5"], "en": "“Come out, lady;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:3.6"], "en": "let us see you standing outside.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:4.1"], "en": "“Your hand has been placed in mine.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:4.2"], "en": "It does not benefit me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:4.3"], "en": "this is a faithful lay follower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:4.4"], "en": "a disciple of the Perfectly Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:5.1"], "en": "Having covered yourself with this,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:5.2"], "en": "offer it as a gift to me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:5.3"], "en": "in that way, I shall be made happy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:5.4"], "en": "\"Granting the fulfillment of all desires.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:6.1", "PA_pv_10:6.2"], "en": "And having bathed him and anointed him, those merchants—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:6.3"], "en": "Having covered her with garments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:6.4", "PA_pv_10:7.1"], "en": "they dedicated the offering to her; immediately after it was dedicated, [she attained the fruit of stream-entry].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:7.2", "PA_pv_10:7.3"], "en": "The fruit of this offering arose as food, clothing, and drink.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:7.4"], "en": "This is the result of that donation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:8.1"], "en": "Then, pure and dressed in clean garments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:8.2"], "en": "wearing the finest Kāsī cloth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:8.3"], "en": "she emerged from her celestial mansion smiling.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:8.4"], "en": "This is the fruit of the sacrificial gift:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:9.1", "PA_pv_10:9.2"], "en": "\"A celestial mansion, beautifully adorned and radiant, shines forth for you.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:9.3"], "en": "“O deity, being questioned, tell us:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:9.4"], "en": "of what karma is this the fruit?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:10.1"], "en": "“Of a bhikkhu who was walking for alms...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:10.2", "PA_pv_10:10.3"], "en": "I gave a wooden bathing tub to one who had become upright,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:10.4"], "en": "with a mind full of serene confidence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:11.1", "PA_pv_10:11.2", "PA_pv_10:11.3"], "en": "I experience the ripening of that wholesome karma for a long duration within this celestial mansion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:11.4"], "en": "And now that [life] is but brief:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:12.1"], "en": "within four months,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:12.2"], "en": "his passing away will take place.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:12.3", "PA_pv_10:12.4"], "en": "I shall fall into a terrible hell, utterly bitter,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:13.1"], "en": "with four corners and four gates.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:13.2"], "en": "Divided into sections and measured out,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:13.3", "PA_pv_10:13.4"], "en": "it was surrounded by an iron wall and covered over with iron.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:14.1"], "en": "For him, the ground is made of iron,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:14.2"], "en": "blazing and filled with heat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:14.3"], "en": "extending for a hundred yojanas on all sides.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:14.4"], "en": "It remains pervading [the body] at all times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:15.1"], "en": "Therein, for a very long duration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:15.2"], "en": "I have experienced painful feeling.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:15.3"], "en": "\"And this is the fruit of evil karma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:15.4"], "en": "therefore, I grieve intensely.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_10:16.1"], "en": "The tenth story: The Petavatthu of Khalatiyā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
