[
{"segs": ["PA_ja_256:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:0.2", "PA_ja_256:0.3"], "en": "Tikanipāta, Saṅkappavagga (The Chapter on Intentions)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:0.4"], "en": "6. The Jarūdapāna Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:1.1", "PA_ja_256:1.2"], "en": "“Merchants seeking water were digging at Jarūdapāna;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:1.3", "PA_ja_256:1.4"], "en": "The merchants obtained tin, copper, lead, and zinc,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:1.5"], "en": "as well as silver and gold.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:1.6"], "en": "There were many pearls and beryl stones;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:2.1"], "en": "yet, not satisfied with those,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:2.2"], "en": "they sought more and more.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:2.3"], "en": "There a terrible, venomous snake,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:2.4"], "en": "full of fiery power, would strike him with its own fiery energy.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:3.1"], "en": "Therefore, do not dig too deeply at that moment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:3.2"], "en": "For excessive digging is evil;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:3.3", "PA_ja_256:3.4"], "en": "wealth gained by digging has been lost through excessive digging.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_256:4.1"], "en": "The Jarūdapāna Jātaka, the sixth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
