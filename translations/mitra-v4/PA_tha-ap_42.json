[
{"segs": ["PA_tha-ap_42:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:0.2"], "en": "Kuṇḍadhānavagga 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:0.3"], "en": "The Apadāna of the Elder Kapparukkhiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:1.1", "PA_tha-ap_42:1.2", "PA_tha-ap_42:1.3"], "en": "Having fastened a multicolored cloth before the most excellent stupa of the Blessed One Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:1.4"], "en": "I established a wish-fulfilling tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:2.1"], "en": "Whichever womb I was reborn into—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:2.2"], "en": "whether as a deity or a human—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:2.3"], "en": "Adorning my gateway,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:2.4"], "en": "the wish-fulfilling tree stands firm;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:3.1"], "en": "both I and my assembly—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:3.2"], "en": "Whoever has lived there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:3.3"], "en": "having taken cloth from them,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:3.4"], "en": "we shall always wear it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:4.1", "PA_tha-ap_42:4.2"], "en": "For ninety-four eons since I planted that tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:4.3"], "en": "I have never known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:4.4"], "en": "\"This is the fruit of the wish-fulfilling tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:5.1"], "en": "And in the seventh aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:5.2"], "en": "there will be eight kṣatriyas named Suceḷa.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:5.3"], "en": "Possessing the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:5.4"], "en": "wheel-turning monarchs of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:6.1"], "en": "the four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:6.3"], "en": "the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:7.1"], "en": "Thus indeed did the venerable elder Kapparukkhiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:8.1"], "en": "The legend of the Elder Kapparukkhiya is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:9.1", "PA_tha-ap_42:10.1"], "en": "The fourth chapter, the Kuṇḍadhāna Chapter. Its summary verse (uddāna) is as follows:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:11.1"], "en": "Kuṇḍa, Sāgata, Kaccāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:11.2"], "en": "Udāyī, Mogharāja,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:11.3"], "en": "Adhimutta, and Lasuṇada.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:11.4"], "en": "Āyāgī, Dhammacakkika,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:11.5"], "en": "and Kapparukkhi as the tenth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_42:11.6"], "en": "these are one thousand two hundred verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
