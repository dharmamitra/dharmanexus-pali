[
{"segs": ["PA_ja_414:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:0.2"], "en": "The Seventh Chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:0.3"], "en": "the Gandhāra Section", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:0.4"], "en": "9. The Jāgarajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:1.1"], "en": "“Anger is asleep while those who are awake are sleeping;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:1.2"], "en": "anger is awake among those who are asleep.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:1.3"], "en": "\"Who understands this of mine?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:1.4"], "en": "Who will respond to me?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:2.1"], "en": "\"I am asleep while you are awake.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:2.2"], "en": "I am awake among those who sleep;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:2.3"], "en": "I alone understand this,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:2.4"], "en": "and I alone can explain it to you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:3.1"], "en": "“How is it that you sleep while others are awake?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:3.2"], "en": "How is it that you are awake among those who sleep?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:3.3"], "en": "How do you understand this?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:3.4"], "en": "\"How do you respond to me?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:4.1"], "en": "\"Those who do not understand the Dhamma—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:4.2"], "en": "what is called restraint and what is called self-taming;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:4.3"], "en": "While they were sleeping,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:4.4"], "en": "O deity, I remained awake.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:5.1"], "en": "Those for whom passion and hatred [persist]—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:5.2"], "en": "And ignorance has been dispelled;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:5.3"], "en": "while they are awake,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:5.4"], "en": "O deity, I am asleep.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:6.1"], "en": "Thus one who is awake among those who sleep,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:6.2"], "en": "thus one who is awake among those who are asleep—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:6.3"], "en": "thus do I understand this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:6.4"], "en": "Thus do I respond to you:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:7.1", "PA_ja_414:7.2"], "en": "\"It is good for one who is awake to be among those who sleep; it is good for one who is asleep to be among those who are awake.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:7.3"], "en": "\"You have understood this well;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:7.4"], "en": "you have answered me well.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_414:8.1"], "en": "Thus ends the ninth Jātaka, the Jāgara-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
