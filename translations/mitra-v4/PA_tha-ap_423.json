[
{"segs": ["PA_tha-ap_423:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:0.2"], "en": "Chapter on the Once-Sweeper (Sakiṃsammajjakavagga) 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:0.3"], "en": "The Apadāna of the Elder Sakiṃsammajjaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:1.1", "PA_tha-ap_423:1.2"], "en": "Having seen that supreme Pāṭali Bodhi tree of the Blessed One Vipassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:1.3"], "en": "that most excellent of trees,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:1.4"], "en": "There I gladdened my heart;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:2.1"], "en": "taking up a broom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:2.2"], "en": "I swept the Bodhi tree at that very moment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:2.3"], "en": "Having swept that Bodhi tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:2.4"], "en": "I paid homage to the Pāṭali tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:3.1"], "en": "having brought peace to my mind there, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:3.2"], "en": "Having placed my hands together in añjali,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:3.3", "PA_tha-ap_423:3.4"], "en": "I paid homage to that Bodhi tree and departed for Paṭikuṭi.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:4.1"], "en": "I was traveling along that path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:4.2"], "en": "recollecting supreme enlightenment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:4.3"], "en": "when a python crushed me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:4.4"], "en": "Of terrible form and great strength.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:5.1", "PA_tha-ap_423:5.2"], "en": "An action performed by me in the past has brought its fruit to satisfy me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:5.3"], "en": "It swallows my physical body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:5.4"], "en": "yet I delight in the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:6.1"], "en": "my mind is unperturbed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:6.2"], "en": "Always pure and bright,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:6.3", "PA_tha-ap_423:6.4"], "en": "I know not the sting of sorrow that torments the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:7.1"], "en": "I have no leprosy, no boils,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:7.2", "PA_tha-ap_423:7.3"], "en": "no skin rashes, no consumption, no scabies, no ringworm, and no itch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:7.4"], "en": "This is the fruit of sweeping:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:8.1", "PA_tha-ap_423:8.2"], "en": "neither sorrow nor lamentation exists within my heart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:8.3"], "en": "The mind is now undiverted and upright;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:8.4"], "en": "this is the fruit of sweeping.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:9.1"], "en": "I do not revel in meditative absorptions (samādhi).", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:9.2"], "en": "The mind becomes clear;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:9.3"], "en": "whatever concentration I desire,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:9.4"], "en": "each one is successfully attained by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:10.1"], "en": "I do not become impassioned by what is provocative to passion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:10.2", "PA_tha-ap_423:10.3"], "en": "nor by what is provocative to aversion; I do not become deluded by what is provocative to delusion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:10.4"], "en": "This is the fruit of sweeping.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:11.1", "PA_tha-ap_423:11.2"], "en": "That deed which I performed back in the ninety-first aeon—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:11.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:11.4"], "en": "this is the fruit of sweeping.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:12.1"], "en": "The defilements have been burnt away by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:12.2"], "en": "All states of existence have been utterly eradicated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:12.3"], "en": "like an elephant that has severed its bonds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:12.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:13.1", "PA_tha-ap_423:13.2"], "en": "Welcome indeed has come to me in the presence of the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:13.3"], "en": "the three knowledges have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:13.4"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:14.1", "PA_tha-ap_423:14.2"], "en": "the four analytical knowledges and these eight liberations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:14.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:14.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:15.1"], "en": "Thus indeed did the elder Sakiṃsammajjaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_423:16.1"], "en": "The legend of the Elder Sakiṃsammajjaka is first.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
