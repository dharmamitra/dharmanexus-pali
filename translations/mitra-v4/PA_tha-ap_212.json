[
{"segs": ["PA_tha-ap_212:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:0.2"], "en": "The Section on the Kaṇikāra Flower, Number Ten:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:0.3"], "en": "The Apadāna of the Elder Pāpanivāriya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:1.1"], "en": "“To Tissa, the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:1.2"], "en": "the god of gods, the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:1.3"], "en": "I gave a single white parasol.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:1.4"], "en": "With a mind serene,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:2.1", "PA_tha-ap_212:2.2"], "en": "my evil is shrouded by the attainment of what is wholesome.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:2.3"], "en": "They hold a parasol in the sky;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:2.4"], "en": "this is the fruit of a former deed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:3.1"], "en": "My final existence is now unfolding.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:3.2"], "en": "All states of existence have been utterly eradicated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:3.3", "PA_tha-ap_212:3.4"], "en": "I bear my final body within the teaching of the Perfectly Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:4.1"], "en": "In the ninety-second aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:4.2"], "en": "because I gave that parasol at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:4.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:4.4"], "en": "This is the fruit of the gift of a parasol.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:5.1"], "en": "For seventy-two eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:5.2"], "en": "they stood as lords of men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:5.3"], "en": "By the name of the Mahānidāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:5.4"], "en": "there were universal monarchs;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:6.1"], "en": "[therein are] the four analytical knowledges (paṭisambhidā).", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:6.3"], "en": "the Buddha’s teaching has been fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:7.1"], "en": "Thus indeed did the venerable elder Pāpanivāriya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:8.1"], "en": "The legend of the Elder Pāpanivāriya is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:9.1"], "en": "The twenty-first chapter, the Kaṇikārapupphiya-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:10.1"], "en": "Its summary (uddāna):", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:11.1", "PA_tha-ap_212:11.2"], "en": "Kaṇikāra, minela, kiṅkaṇi, taraṇa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:11.3"], "en": "nigguṇḍipupphī, and dakada.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:11.4"], "en": "Salala and Kuraṇḍaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:11.5"], "en": "Ādhāraka and Pāpavārī—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_212:11.6"], "en": "these are the forty-eight verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
