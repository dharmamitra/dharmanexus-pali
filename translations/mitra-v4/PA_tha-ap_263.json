[
{"segs": ["PA_tha-ap_263:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:0.2"], "en": "The Chapter on Throwing the Lotus (Padumukkhipavagga) 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:0.3"], "en": "The Apadāna of the Elder Ākāsukkhipiya (He Who Throws into the Sky)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:1.1"], "en": "“Seeing Siddhattha, who was golden-hued,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:1.2"], "en": "walking through the marketplace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:1.3"], "en": "[the two] took hold of two lotus buds.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:1.4"], "en": "I approached the bull among men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:2.1", "PA_tha-ap_263:2.2"], "en": "I placed a single flower at the feet of the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:2.3"], "en": "Having taken a single flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:2.4"], "en": "I threw it into the air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:3.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:3.2"], "en": "The flower that I offered—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:3.3", "PA_tha-ap_263:3.4"], "en": "of this gift of flowers, I do not know a state of woe; this is its fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:4.1"], "en": "In this thirty-sixth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:4.2"], "en": "I was once a lord of the earth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:4.3"], "en": "named Antalikkhakara.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:4.4"], "en": "A wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:5.1", "PA_tha-ap_263:5.2"], "en": "There are the four analytical knowledges and also these eight liberations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:5.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:5.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:6.1"], "en": "Thus indeed did the venerable elder Ākāsukkhipiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_263:7.1"], "en": "The legend of the Elder Ākāsukkhipiya is first.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
