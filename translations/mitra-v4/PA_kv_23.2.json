[
{"segs": ["PA_kv_23.2:0.1", "PA_kv_23.2:0.2", "PA_kv_23.2:0.3"], "en": "Points of Controversy (Kathāvatthu) The Great Fifty-Section (Mahāpaṇṇāsaka) The Twenty-third Chapter (Tevīsatimavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:0.4"], "en": "The Discourse on the Description of Arahants:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.1", "PA_kv_23.2:1.2"], "en": "Do non-human beings engage in sexual intercourse because of the appearance of Arahants? Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.3"], "en": "Because of their praise of the Arahants, non-human beings kill living beings...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.4"], "en": "[and so on] ...they take what is not given,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.5"], "en": "and they speak falsehoods.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.6"], "en": "They speak maliciously,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.7"], "en": "they speak harshly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.8"], "en": "and they utter idle chatter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.9"], "en": "They break into houses,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.10"], "en": "they carry off plunder,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.11"], "en": "and they commit burglaries.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.12"], "en": "They stand in ambush,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.13"], "en": "they commit adultery with another's wife,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.14"], "en": "they carry out village raids... [and so on] ...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.15"], "en": "\"Do they commit the destruction of a city?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.16"], "en": "One should not say so... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_23.2:1.17"], "en": "The Discussion on the Appearance of an Arahant is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"}
]
