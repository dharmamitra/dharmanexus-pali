[
{"segs": ["PA_tha-ap_251:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:0.2", "PA_tha-ap_251:0.3"], "en": "Bimbijāliya Thera Apadāna, the Ninth in the Tuvaradāyaka Vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:1.2"], "en": "the Self-Become One, the Supreme Person,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:1.3"], "en": "proclaims the Four Truths.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:1.4"], "en": "I illuminated the deathless state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:2.1", "PA_tha-ap_251:2.2"], "en": "Having then scattered bimbijālaka flowers here and there, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:2.3"], "en": "I offered it to the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:2.4"], "en": "the Lord of bipeds, the Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:3.1"], "en": "Sixty-eight aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:3.2"], "en": "With four whorls of hair at the navel,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:3.3", "PA_tha-ap_251:3.4"], "en": "they were wheel-turning monarchs of great power, endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:4.1", "PA_tha-ap_251:4.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:5.1"], "en": "Thus indeed the venerable elder Bimbijāliya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_251:6.1"], "en": "This is the ninth legend of the elder Bimbijāliya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
