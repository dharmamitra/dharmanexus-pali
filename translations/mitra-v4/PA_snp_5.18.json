[
{"segs": ["PA_snp_5.18:0.1", "PA_snp_5.18:0.2"], "en": "Sutta Nipāta 5.18 Pārāyanatthutigāthā:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:1.1"], "en": "This the Blessed One spoke while dwelling among the Magadhans at the Pāsāṇaka Cetiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:1.2"], "en": "Being requested and questioned by each of the sixteen attendant brahmins, he answered their questions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:1.3"], "en": "If one were to understand the meaning and the Dhamma of each question and practice in accordance with the Dhamma, one would surely go to the further shore of aging and death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:1.4"], "en": "\"These teachings lead to the further shore\"—therefore, \"Pārāyana\" (The Way to the Further Shore) is the designation for this discourse on the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:2.1"], "en": "Ajita, Tissa-Metteyya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:2.2"], "en": "Puṇṇaka, and Mettagū;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:2.3"], "en": "Dhotaka and Upasīva.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:2.4"], "en": "And Nanda, then Hemaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:3.1"], "en": "both Todeyya and Kappa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:3.2"], "en": "and the wise Jatukannī;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:3.3"], "en": "Bhadrāvudha and Udaya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:3.4"], "en": "the brahmin Posāla,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:3.5"], "en": "and the wise Mogharāja.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:3.6"], "en": "And Piṅgiya, the great seer—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:4.1"], "en": "these approached the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:4.2"], "en": "the seer whose conduct was perfected.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:4.3"], "en": "Asking subtle questions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:4.4"], "en": "they approached the Best of Buddhas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:5.1"], "en": "the Buddha gave them an explanation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:5.2"], "en": "Being questioned on these matters, the Sage answered them exactly as they are,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:5.3"], "en": "and by his exposition of the questions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:5.4"], "en": "he satisfied the brahmins.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:6.1"], "en": "Satisfied by the Visionary One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:6.2"], "en": "the Buddha, the Kinsman of the Sun,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:6.3"], "en": "they practiced the holy life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:6.4"], "en": "In the presence of the one of supreme wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:7.1"], "en": "regarding each and every question,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:7.2"], "en": "just as it was taught by the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:7.3", "PA_snp_5.18:7.4"], "en": "Likewise, whoever should practice thus would go from the hither shore to the further shore;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:8.1"], "en": "he would go from the hither shore to the further shore.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:8.2"], "en": "Cultivating the supreme path;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:8.3"], "en": "that path leads to the further shore,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.18:8.4"], "en": "therefore it is called \"The Way to the Further Shore.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
