[
{"segs": ["PA_ja_334:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:0.2", "PA_ja_334:0.3"], "en": "Catukkanipāta, Kokilavagga (The Chapter on the Cuckoo)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:0.4"], "en": "4. The Jātaka of the Advice to the King:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:1.1", "PA_ja_334:1.2"], "en": "“If, among cattle crossing over, the lead bull goes astray;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:1.3", "PA_ja_334:1.4"], "en": "All of them go crookedly when the leader has gone crookedly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:2.1"], "en": "Even so among human beings...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:2.2", "PA_ja_334:2.3"], "en": "If even he who is considered the best practices what is contrary to the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:2.4"], "en": "how much more so the rest of the people?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:2.5", "PA_ja_334:2.6"], "en": "The entire kingdom lies in suffering if the king is unrighteous,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:3.1"], "en": "just as when cattle are crossing a ford.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:3.2"], "en": "The bull goes straight;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:3.3", "PA_ja_334:3.4"], "en": "all the cows go straight when the leader has gone straight.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:4.1"], "en": "In the same way, among human beings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:4.2"], "en": "whoever is regarded as the best—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:4.3"], "en": "if that person practices the Dhamma—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:4.4"], "en": "How much more so the rest of the people;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:4.5", "PA_ja_334:4.6"], "en": "the entire kingdom sleeps in happiness if the king is righteous.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_334:5.1"], "en": "The Fourth Jātaka: The Discourse of Advice to the King.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
