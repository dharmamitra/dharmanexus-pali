[
{"segs": ["PA_tha-ap_55:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:0.2"], "en": "Bījanīvagga 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:0.3"], "en": "The Apadāna of the Elder Sayanadāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:1.1"], "en": "“To Padumuttara Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:1.2", "PA_tha-ap_55:1.3"], "en": "who has compassion for all the world, I gave a bed.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:1.4"], "en": "With a serene mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:2.1"], "en": "By that gift of a bed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:2.2"], "en": "it is like the excellence of seed sown in a good field.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:2.3"], "en": "Enjoyments arise for him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:2.4"], "en": "this is the fruit of that bed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:3.1"], "en": "I make my bed in the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:3.2"], "en": "I uphold this earth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:3.3"], "en": "I have mastery over living beings—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:3.4"], "en": "this is the fruit of my bed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:4.1"], "en": "In the fifth millennium,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:4.2"], "en": "there were eight of great majesty;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:4.3"], "en": "in the thirty-fourth century [of the aeon],...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:4.4"], "en": "And the four great powers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:5.1", "PA_tha-ap_55:5.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:6.1"], "en": "In this way, it is said, the venerable elder Sayanadāyaka recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_55:7.1"], "en": "This is the third legend of the elder Sayanadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
