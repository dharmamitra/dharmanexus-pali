[
{"segs": ["PA_tha-ap_267:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:0.2"], "en": "The Chapter on the Throwing of the Lotus (Padumukkhipavagga) 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:0.3"], "en": "The Apadāna of the Elder Biḷālidāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:1.1", "PA_tha-ap_267:1.2"], "en": "\"Not far from the Himavat mountain is a peak named Romasa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:1.3"], "en": "at the foot of that mountain,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:1.4"], "en": "The ascetic had cultivated his faculties.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:2.1"], "en": "Having caught the kittens,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:2.2"], "en": "I gave them to the ascetic.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:2.3", "PA_tha-ap_267:2.4"], "en": "The Great Hero, the Self-Existent One, the Unconquered, gave his approval:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:3.1"], "en": "\"Bilālī has been given by you to me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:3.2"], "en": "With a mind that is perfectly serene,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:3.3", "PA_tha-ap_267:3.4"], "en": "may the fruit be produced for you as you are being reborn into existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:4.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:4.2"], "en": "because I gave a cat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:4.3"], "en": "I have not known a miserable rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:4.4"], "en": "This fruit belongs to Biḷārī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:5.1", "PA_tha-ap_267:5.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:6.1"], "en": "In this way, indeed, the venerable elder Biḷālidāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_267:7.1"], "en": "This is the fifth legend of the elder Biḷālidāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
