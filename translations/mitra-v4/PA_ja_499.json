[
{"segs": ["PA_ja_499:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:0.2", "PA_ja_499:0.3"], "en": "The Collection of Twenty [Birth Stories], Chapter on Mātaṅga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:0.4"], "en": "3. The Sivi Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:1.1", "PA_ja_499:1.2"], "en": "“Though seeing from afar, the elder has come to beg for my eye.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:1.3"], "en": "“We shall become one-eyed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:1.4"], "en": "give me an eye as I have requested.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:2.1"], "en": "“By whom were you instructed that you have come here?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:2.2"], "en": "\"O mendicant, you ask for eyes within the range of my sight;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:2.3"], "en": "you ask for that most difficult thing to give,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:2.4"], "en": "the supreme limb which they call the eye, so hard for a man to surrender.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:3.1"], "en": "“He whom they call Sujampati among the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:3.2"], "en": "and whom they call Maghavan in the world of men—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:3.3"], "en": "I have come here instructed by him.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:3.4"], "en": "\"O beggar, come to ask for the range of my vision.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:4.1", "PA_ja_499:4.2"], "en": "To me, a beggar, grant the unsurpassed boon that I requested when I was a beggar.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:4.3"], "en": "“Grant me the unsurpassed range of vision,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:4.4"], "en": "which is called by men the eye so difficult to relinquish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:5.1"], "en": "“For whatever purpose you have come,” [he replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:5.2"], "en": "Whatever purpose you have aspired to,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:5.3"], "en": "may those intentions of yours be fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:5.4"], "en": "obtain eyes, O Brahmin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:6.1"], "en": "To you who asks me for one thing,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:6.2"], "en": "I shall give both;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:6.3"], "en": "go forth with sight before the people as they gaze upon you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:6.4"], "en": "“Whatever you desire, may that be fulfilled for you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:7.1"], "en": "“O Lord, do not take away our sight;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:7.2"], "en": "do not cast us all aside.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:7.3"], "en": "Give wealth, O Great King;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:7.4"], "en": "give many pearls and beryl gems.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:8.1"], "en": "Give yoked chariots, O Lord.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:8.2", "PA_ja_499:8.3"], "en": "Give, O Great King, this noble steed, adorned with trappings, to Nāga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:8.4"], "en": "who is clothed in golden robes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:9.1", "PA_ja_499:9.2"], "en": "Just as all the Śivis, with their horses, chariots, and banners,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:9.3"], "en": "would surround him on every side.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:9.4"], "en": "\"Give thus, O bull among charioteers!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:10.1", "PA_ja_499:10.2"], "en": "For he who, having said 'I will give,' sets his mind on not giving...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:10.3", "PA_ja_499:10.4", "PA_ja_499:11.1"], "en": "He who, having said \"I will give,\" then does not give, fastens the snare that fell upon the ground around his own neck.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:11.2"], "en": "If one sets the mind on not giving,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:11.3"], "en": "one becomes more evil than the evil themselves,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:11.4"], "en": "having fallen into the power of Yama.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:12.1"], "en": "For whatever one asks for, that one should give;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:12.2"], "en": "what one does not ask for, that one should not give;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:12.3"], "en": "I myself shall give only that.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:12.4"], "en": "“‘What does this brahmin ask of me?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:13.1"], "en": "‘Is it life, or beauty, or happiness, or strength?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:13.2"], "en": "Desiring what, O Lord of Men, do you give?’”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:13.3", "PA_ja_499:13.4"], "en": "\"How indeed could the unsurpassed King Sivi give away his eyes for the sake of the next world?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:14.1"], "en": "\"I do not give this away for the sake of fame,\" he said.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:14.2"], "en": "\"I desire neither son nor wealth nor kingdom;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:14.3"], "en": "rather, the ancient Dhamma practiced by the virtuous—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:14.4"], "en": "this alone delights my mind in giving.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:15.1"], "en": "“Sīvaka, you have been my friend and companion;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:15.2"], "en": "being well-trained, do well what I say.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:15.3"], "en": "Having plucked out my eyes, which desire to see, [give them to me].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:15.4"], "en": "“Place it in the hands of the mendicant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:16.1"], "en": "Thus urged by the King of the Śivis,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:16.2"], "en": "Sīvika, who was ever obedient to his word, acted accordingly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:16.3"], "en": "Having plucked out the king's eyes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:16.4"], "en": "he presented them to the brahmin;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:16.5"], "en": "the brahmin became possessed of sight.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:16.6"], "en": "The blind king sat down.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:17.1"], "en": "Then, after a few days,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:17.2"], "en": "when his eyes had grown back;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:17.3", "PA_ja_499:17.4"], "en": "The King, the prosperer of the realm of the Sivis, addressed the charioteer:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:18.1"], "en": "\"Harness the vehicle, charioteer.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:18.2"], "en": "And it is fitting that you inform us;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:18.3"], "en": "let us go to the pleasure groves,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:18.4"], "en": "the lotus ponds, and the forests.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:19.1"], "en": "And there, on the bank of the lotus pond,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:19.2"], "en": "he sat down cross-legged;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:19.3"], "en": "then Sakka appeared before him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:19.4"], "en": "The king of gods, Sujampati, said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:20.1"], "en": "\"I am Sakka, the lord of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:20.2"], "en": "I have come into your presence.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:20.3"], "en": "“Choose a boon, O King of Kings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:20.4"], "en": "whatever you desire in your mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:21.1"], "en": "“I have abundant wealth, Sakka;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:21.2"], "en": "My strength and my store are now but slight;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:21.3"], "en": "for me who am now blind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:21.4"], "en": "death alone is pleasing.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:22.1", "PA_ja_499:22.2"], "en": "“O Kshatriya, Lord of Bipeds, speak those truths which are yours;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:22.3"], "en": "as you speak the truth, [may it be so].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:22.4"], "en": "\"And yet my eye shall exist again.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:23.1", "PA_ja_499:23.2"], "en": "\"Those mendicants of various clans who come to me with requests,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:23.3"], "en": "Whoever there entreats me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:23.4"], "en": "he too is dear to my heart;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:23.5"], "en": "by this utterance of truth, may [my foot] be restored.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:23.6"], "en": "\"My eye has appeared!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:24.1", "PA_ja_499:24.2"], "en": "That brahmin who came to ask of me, saying 'Give me your eye,' [has been granted his wish].\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:24.3", "PA_ja_499:24.4"], "en": "I gave my eyes to that brahmin who was a mendicant;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:25.1"], "en": "even more did rapture take possession of me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:25.2"], "en": "And my joy was not small;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:25.3"], "en": "by this utterance of truth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:25.4"], "en": "may my second [rebirth] come to pass.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:26.1"], "en": "“Verses spoken in accordance with the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:26.2"], "en": "O increaser of the Śivi kingdom;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:26.3"], "en": "these are your guides.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:26.4"], "en": "Divine forms appeared.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:27.1"], "en": "Piercing through walls and through rocks,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:27.2"], "en": "they passed over even mountains.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:27.3", "PA_ja_499:27.4"], "en": "\"May they enjoy the sight of you for a hundred leagues all around! \"Who here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:28.1"], "en": "when asked, would not give their wealth?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:28.2"], "en": "Even though it is most excellent and beautiful to me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:28.3"], "en": "come now, all you Śivis,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:28.4"], "en": "assemble and behold my divine eyes today!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:29.1"], "en": "Passing through walls and passing through rocks,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:29.2"], "en": "having crossed over the mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:29.3"], "en": "for a hundred leagues all around—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:29.4"], "en": "They experience my vision.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:30.1", "PA_ja_499:30.2"], "en": "Yet there is nothing beyond the mere arrival of death for mortals here in this life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:30.3"], "en": "Having given away human vision,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:30.4"], "en": "I have obtained superhuman vision.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:31.1"], "en": "Having seen this too, O Śivis, [I am content].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:31.2"], "en": "\"Give gifts and enjoy [them];", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:31.3"], "en": "having given and enjoyed according to your means,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:31.4"], "en": "being blameless, go to the heavenly realm.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_499:32.1"], "en": "The Sivi Jātaka, the third.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
