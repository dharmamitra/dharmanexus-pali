[
{"segs": ["PA_cp_10:0.1"], "en": "The Basket of Conduct (Cariyāpiṭaka),", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:0.2"], "en": "Chapter on Akitti,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:0.3"], "en": "The Perfection of Giving (Dānapāramī) 10", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:0.4"], "en": "The Deed of the Wise Hare:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:1.1", "PA_cp_10:1.2"], "en": "\"Furthermore, when I was a hare wandering in the forest...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:1.3", "PA_cp_10:1.4"], "en": "Subsisting on grass, leaves, vegetables, and fruits, avoiding the harming of others—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:2.1"], "en": "such as the monkey and the jackal.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:2.2"], "en": "I was then a young partridge;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:2.3"], "en": "we lived as neighbors,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:2.4"], "en": "visible to one another morning and evening.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:3.1"], "en": "I shall instruct you regarding actions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:3.2"], "en": "both wholesome and evil:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:3.3"], "en": "\"One should avoid all evil deeds.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:3.4"], "en": "Devote yourselves to what is wholesome.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:4.1"], "en": "On the day of the Uposatha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:4.2"], "en": "having seen the full moon;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:4.3"], "en": "There I announced to them:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:4.4"], "en": "\"Today is the Uposatha day.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:5.1"], "en": "Prepare gifts.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:5.2"], "en": "To one worthy of offerings;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:5.3"], "en": "having given a gift to one worthy of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:5.4"], "en": "observe the Uposatha fast.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:6.1"], "en": "Having said to me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:6.2", "PA_cp_10:6.3"], "en": "\"So be it,\" they prepared gifts according to their means and according to their power.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:6.4"], "en": "They searched for one worthy of offerings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:7.1", "PA_cp_10:7.2"], "en": "Seated there, I reflected upon a gift that was suitable for such an offering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:7.3"], "en": "“If I do not obtain one worthy of offerings here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:7.4"], "en": "what gift will there be for me?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:8.1"], "en": "I have no sesame or mung beans.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:8.2"], "en": "\"Whether it be months, rice, or ghee;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:8.3"], "en": "I subsist on grass,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:8.4"], "en": "so it is not possible for you to give me grass.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:9.1", "PA_cp_10:9.2"], "en": "If anyone who is worthy of offerings should come to me for alms,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:9.3"], "en": "I would give my very self.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:9.4"], "en": "\"He will not depart empty-handed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:10.1"], "en": "Perceiving my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:10.2"], "en": "Sakka, in the guise of a brahmin, [approached].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:10.3", "PA_cp_10:10.4"], "en": "My intention was directed toward testing his generosity;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:11.1"], "en": "having seen that, I was satisfied.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:11.2"], "en": "I spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:11.3", "PA_cp_10:11.4"], "en": "“It is well that you have come into my presence for the sake of food.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:12.1", "PA_cp_10:12.2"], "en": "Today I shall give you that supreme gift never given before;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:12.3"], "en": "you are endowed with the virtue of moral conduct.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:12.4"], "en": "It is improper for you to harm others.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:13.1", "PA_cp_10:13.2"], "en": "Come, light a fire and gather various pieces of wood.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:13.3"], "en": "“I will cook myself;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:13.4"], "en": "you shall eat me when I am cooked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:14.1"], "en": "“Very well,” he replied, his mind delighted.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:14.2", "PA_cp_10:14.3"], "en": "He gathered various kinds of wood and constructed a great funeral pyre,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:14.4"], "en": "making it a hollow chamber of embers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:15.1"], "en": "He lit a fire there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:15.2"], "en": "so that he might quickly become great;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:15.3"], "en": "having shaken his limbs covered in dust, he [shone forth].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:15.4"], "en": "I sat down to one side.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:16.1", "PA_cp_10:16.2"], "en": "When a great heap of wood was burning and crackling, I approached it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:16.3", "PA_cp_10:16.4"], "en": "Having risen up, I fell into the midst of the mass of flames,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:17.1"], "en": "just as if into cool water.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:17.2"], "en": "For whomever it has entered,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:17.3"], "en": "it allays distress and feverish agitation,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:17.4"], "en": "and bestows gratification and rapture.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:18.1", "PA_cp_10:18.2"], "en": "In that very same way, when I had entered the blazing fire,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:18.3"], "en": "it entirely calmed all my distress.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:18.4"], "en": "Just like cold water.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:19.1"], "en": "Skin, hide, flesh, sinew,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:19.2"], "en": "bone, and the binding of the heart;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:19.3", "PA_cp_10:19.4"], "en": "“I gave my entire body in its entirety to the brahmin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:20.1"], "en": "The tenth: The Deeds of the Wise Hare.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:21.1"], "en": "The first chapter, the Akittivagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:22.1"], "en": "Its summary verse (uddāna):", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:23.1"], "en": "Akitti, the brahmin, and Saṅkha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:23.2"], "en": "Dhanañjaya, king of the Kurus;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:23.3"], "en": "King Mahāsudassana;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:23.4"], "en": "and the brahmin Mahāgovinda.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:24.1"], "en": "Nimi, Canda-kumāra,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:24.2"], "en": "Sivi, Vessantara, and the hare—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:24.3"], "en": "I myself was each of them at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:24.4"], "en": "\"O best of givers, he who gave to you—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:25.1"], "en": "these are the requisites of giving;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:25.2"], "en": "these are the perfections of giving.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:25.3"], "en": "Having given my life to a beggar,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:25.4"], "en": "I fulfilled this perfection.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:26.1"], "en": "Seeing one who had approached for alms, I gave it to him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:26.2"], "en": "I sacrificed my own self;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:26.3"], "en": "there is no one equal to me in giving—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:26.4"], "en": "this is my perfection of giving.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_10:27.1"], "en": "The Exposition of the Perfection of Giving is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
