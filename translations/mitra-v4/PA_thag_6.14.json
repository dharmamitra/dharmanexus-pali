[
{"segs": ["PA_thag_6.14:0.1"], "en": "Theragāthā 6.14 Chakkanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:0.2", "PA_thag_6.14:0.3"], "en": "Paṭhamavagga (The First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:0.4"], "en": "The Verse of the Elder Sabbakāmi:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:1.1"], "en": "“This two-legged impurity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:1.2"], "en": "foul-smelling and loathsome, is being carried away.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:1.3"], "en": "Filled with various kinds of corpses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:1.4"], "en": "oozing from here and there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:2.1"], "en": "[he saw] a deer hidden by a snare.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:2.2"], "en": "Just as a fisherman with a hook,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:2.3"], "en": "or as one with glue catches a monkey,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:2.4"], "en": "they torment the worldling.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:3.1"], "en": "Forms, sounds, tastes, smells,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:3.2"], "en": "and delightful tangibles—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:3.3"], "en": "these are the five strands of sensual pleasure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:3.4"], "en": "They are seen in the form of women.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:4.1", "PA_thag_6.14:4.2"], "en": "Those worldlings who serve them with minds full of passion—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:4.3", "PA_thag_6.14:4.4"], "en": "They increase the terrible cemetery and accumulate renewed existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:5.1"], "en": "But he who avoids these—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:5.2"], "en": "Like a snake’s head trodden by the foot,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:5.3", "PA_thag_6.14:5.4"], "en": "one who is mindful overcomes the attachment to existence in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:6.1", "PA_thag_6.14:6.2"], "en": "Having seen the danger in sensual pleasures and having seen renunciation as safety,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:6.3"], "en": "he has emerged from all sensual desires.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:6.4"], "en": "“I have attained the destruction of the taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:6.5"], "en": "… [Thus spoke] the Elder Sabbakāmī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:6.6"], "en": "The Sixth Chapter is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:7.0"], "en": "In this regard,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:7.1"], "en": "the summary verse is: Uruvelakassapa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:7.2"], "en": "the Elder, and Tekicchakāri;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:7.3"], "en": "Mahānāga and Kulla,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:7.4"], "en": "Māluṅkyaputta and Sappadāsa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:7.5"], "en": "Kātiyāna and Migajāla.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:7.6"], "en": "Jenta, Sumanasavhaya;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:7.7"], "en": "Nhātamuni, Brahmadatta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:7.8"], "en": "Sirimaṇḍa, and Sabbakāmī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:7.9"], "en": "There are eighty-four verses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_6.14:7.10"], "en": "and there are fourteen elders therein.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
