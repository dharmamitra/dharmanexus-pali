[
{"segs": ["PA_ja_430:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:0.2", "PA_ja_430:0.3"], "en": "The Ninth Chapter, The Section on Vultures (Gijjhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:0.4"], "en": "4. The Cūḷasuvajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:1.1", "PA_ja_430:1.2"], "en": "“There are trees with green leaves, many trees with abundant fruit;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:1.3", "PA_ja_430:1.4"], "en": "\"Why is your mind so delighted with this dry, hollow gourd?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:2.1"], "en": "\"We were enjoying its fruit.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:2.2", "PA_ja_430:2.3"], "en": "\"Even though many groups of years have passed and [the practice] has been seen to be fruitless,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:2.4"], "en": "let there be that same loving-kindness as before.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:3.1"], "en": "“Leaving a tree that is withered and hollow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:3.2"], "en": "a trunk that is leafless and fruitless,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:3.3"], "en": "the birds depart.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:3.4"], "en": "\"What fault do you see, O Brahmin?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:4.1", "PA_ja_430:4.2"], "en": "\"That those who shared for the sake of fruit abandon him when he bears no fruit.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:4.3", "PA_ja_430:4.4"], "en": "“Those of dull wit who seek their own welfare fall into partiality.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:5.1"], "en": "“Well done; a witness has been established.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:5.2"], "en": "There is friendship through conversation and intimacy;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:5.3"], "en": "if you find this Dhamma pleasing,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:5.4"], "en": "you are praised by those who understand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:6.1", "PA_ja_430:6.2"], "en": "Therefore, O bird that flies with wings, I grant you a boon;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:6.3"], "en": "choose a boon, O Vakkaṅga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:6.4"], "en": "\"Whatever you desire in your mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:7.1"], "en": "\"I would indeed see him as a rival,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:7.2"], "en": "like a tree bearing fruit.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:7.3"], "en": "\"Having found a treasure even while being poor,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:7.4"], "en": "I would rejoice again and again. Then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:8.1"], "en": "taking the Deathless, [he said:]", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:8.2", "PA_ja_430:8.3"], "en": "He sprinkled the tree; its branches grew forth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:8.4"], "en": "providing cool shade and delighting the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:9.1", "PA_ja_430:9.2"], "en": "“Thus, Sakka, may you be happy together with all your kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:9.3"], "en": "just as I am happy today.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:9.4"], "en": "Having seen the tree bearing fruit,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:10.1"], "en": "and having granted a boon to the parrot,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:10.2"], "en": "he made the tree fruitful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:10.3", "PA_ja_430:10.4"], "en": "He set out together with his wife for the Nandana grove of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_430:11.1"], "en": "Thus ends the fourth Jātaka, the Cūḷasuvajātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
