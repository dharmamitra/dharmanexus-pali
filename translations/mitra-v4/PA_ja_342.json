[
{"segs": ["PA_ja_342:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:0.2"], "en": "The Collection of Fours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:0.3"], "en": "Chapter on Cūḷakuṇāla.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:0.4"], "en": "2. The Monkey Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:1.1", "PA_ja_342:1.2"], "en": "“I was indeed able to lift myself out of the water onto dry land.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:1.3", "PA_ja_342:1.4"], "en": "I shall not again come under your power, O lotus-born one;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:2.1"], "en": "enough with these mangoes!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:2.2"], "en": "Of rose-apples and jackfruits;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:2.3"], "en": "yet even those that are on the far shore of the ocean,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:2.4"], "en": "the udumbara is better to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:3.1", "PA_ja_342:3.2", "PA_ja_342:3.3"], "en": "But he who does not quickly comprehend a matter that has arisen falls under the power of his enemies.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:3.4"], "en": "And later he regrets it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:4.1", "PA_ja_342:4.2"], "en": "But he who quickly understands a matter that has arisen—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:4.3", "PA_ja_342:4.4"], "en": "“One is released from the oppression of enemies and does not later regret it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_342:5.1"], "en": "Thus ends the second Jātaka, the Monkey Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
