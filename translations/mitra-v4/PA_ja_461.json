[
{"segs": ["PA_ja_461:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:0.2", "PA_ja_461:0.3"], "en": "The Section of Eleven, Chapter on the Supporter of His Mother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:0.4"], "en": "7. The Daśaratha Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:1.1", "PA_ja_461:1.2"], "en": "“Come, Lakṣaṇa and Sītā, both of you descend into the water.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:1.3"], "en": "Thus spoke this Bharata:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:1.4"], "en": "\"King Daśaratha has died.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:2.1"], "en": "\"By what power of Rāma...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:2.2"], "en": "Though there is reason for sorrow, you do not grieve;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:2.3"], "en": "having heard that your father has passed away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:2.4"], "en": "suffering does not overcome you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:3.1"], "en": "\"What cannot be guarded by a person,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:3.2"], "en": "though he prattle much—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:3.3"], "en": "why would a wise and intelligent man [guard it]?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:3.4"], "en": "One would cause oneself to suffer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:4.1"], "en": "For both the young and the old,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:4.2"], "en": "both the foolish and the wise—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:4.3"], "en": "Both the wealthy and the poor,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:4.4"], "en": "all have death as their final destination.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:5.1"], "en": "Like fruits that have ripened, they must fall.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:5.2"], "en": "There is constant fear from falling;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:5.3"], "en": "likewise, for mortals who are born,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:5.4"], "en": "there is constant fear of death.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:6.1"], "en": "Some are not seen in the evening,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:6.2", "PA_ja_461:6.3"], "en": "yet many are seen in the morning; some are not seen in the morning, yet many are seen in the evening.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:6.4"], "en": "Many people were seen that evening.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:7.1"], "en": "If, while lamenting,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:7.2"], "en": "one could achieve any benefit, [it would be so].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:7.3", "PA_ja_461:7.4"], "en": "One who is deluded and harms himself might do that which one with clear vision would not;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:8.1"], "en": "he becomes emaciated and discolored.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:8.2", "PA_ja_461:8.3"], "en": "Those who harm themselves do not protect themselves by that [lamentation];", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:8.4"], "en": "their wailing is useless.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:9.1", "PA_ja_461:9.2"], "en": "Just as one would extinguish a burning house with water,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:9.3"], "en": "so too does the wise person who has heard much.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:9.4", "PA_ja_461:9.5"], "en": "A wise and learned person quickly disperses arisen sorrow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:9.6"], "en": "as the wind blows away a tuft of cotton.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:10.1"], "en": "The fool alone suffers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:10.2"], "en": "alone is born into a family;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:10.3"], "en": "indeed, union is the ultimate [state].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:10.4"], "en": "The enjoyment of all living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:11.1", "PA_ja_461:11.2"], "en": "Therefore, for the wise and learned one who clearly perceives this world and the world beyond;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:11.3"], "en": "Having understood the Dhamma, both heart and mind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:11.4"], "en": "even great sorrows do not torment me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:12.1"], "en": "Such as I am, regarding both seeing and eating—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:12.2"], "en": "I shall support my relatives,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:12.3"], "en": "and I shall protect the rest;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:12.4"], "en": "this is the duty of one who understands.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:13.1", "PA_ja_461:13.2"], "en": "For ten thousand years and six hundred years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:13.3"], "en": "the long-armed one with the conch-like neck [reigned].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:13.4"], "en": "Rāma ruled the kingdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_461:14.1"], "en": "Thus ends the seventh Jātaka, the Daśaratha Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
