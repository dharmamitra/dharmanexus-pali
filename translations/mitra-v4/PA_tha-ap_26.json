[
{"segs": ["PA_tha-ap_26:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:0.2"], "en": "Subhūti Chapter, 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:0.3"], "en": "The Apadāna of the Elder Pañcasīlasamādāniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:1.1", "PA_tha-ap_26:1.2"], "en": "“At that time, in the city of Candavatī, I was a hired laborer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:1.3"], "en": "engaged in the work of others.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:1.4"], "en": "I do not obtain the going forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:2.1"], "en": "Enveloped in great darkness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:2.2"], "en": "I am scorched by the three fires.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:2.3", "PA_tha-ap_26:2.4"], "en": "By what means indeed might I become disjoined from existence?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:3.1"], "en": "And I have no wealth to give as a gift.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:3.2"], "en": "I am a wretched hireling;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:3.3"], "en": "what if I were now to observe the five precepts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:3.4"], "en": "keeping them perfectly fulfilled?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:4.1", "PA_tha-ap_26:4.2"], "en": "To that disciple of the sage Anomadassi named Nisabha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:4.3"], "en": "I approached.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:4.4"], "en": "I undertook the five precepts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:5.1"], "en": "For a hundred thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:5.2"], "en": "such was the lifespan that existed then.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:5.3", "PA_tha-ap_26:5.4"], "en": "For that long I guarded the five precepts in their full perfection;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:6.1"], "en": "and when the time of death arrived,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:6.2"], "en": "The gods comfort me, saying:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:6.3", "PA_tha-ap_26:6.4"], "en": "\"My dear sir, this chariot yoked with a thousand [horses] has been presented to you.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:7.1"], "en": "While my final consciousness was still proceeding,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:7.2"], "en": "I recollected my virtue;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:7.3"], "en": "by that well-performed kamma, [the fruit of] my merit has been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:7.4"], "en": "I went to the Tāvatiṃsa heaven;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:8.1", "PA_tha-ap_26:8.2"], "en": "thirty times I exercised sovereignty as the lord of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:8.3"], "en": "I experienced divine bliss,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:8.4"], "en": "honored by celestial nymphs;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:9.1"], "en": "and seventy-five times, too—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:9.2"], "en": "I was a universal monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:9.3", "PA_tha-ap_26:9.4"], "en": "my regional sovereignty was vast and beyond counting.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:10.1"], "en": "Having passed away from the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:10.2"], "en": "impelled by the root of his wholesome merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:10.3"], "en": "he was born in the city of Vesālī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:10.4"], "en": "At Mahāsāla, very wealthy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:11.1"], "en": "during the time of the rains-retreat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:11.2"], "en": "while the teaching of the Victor was shining forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:11.3", "PA_tha-ap_26:11.4"], "en": "Both my mother and my father took up the five precepts;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:12.1"], "en": "having heard [of] virtue, I too [took them up].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:12.2"], "en": "I recollected my own virtue;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:12.3"], "en": "sitting upon a single seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:12.4"], "en": "I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:13.1"], "en": "Having reached the age of five,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:13.2"], "en": "I attained arahantship;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:13.3"], "en": "the Buddha ordained me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:13.4"], "en": "Recognizing their virtues, the Visionary One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:14.1", "PA_tha-ap_26:14.2"], "en": "having protected the five precepts in their entirety, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:14.3"], "en": "In immeasurable eons from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:14.4"], "en": "I have not gone to the lower realms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:15.1"], "en": "Thus have I experienced glory.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:15.2", "PA_tha-ap_26:15.3"], "en": "Even if one were to spend ten million eons praising those virtues,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:15.4"], "en": "one could only describe a mere fraction of them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:16.1"], "en": "Having guarded the five precepts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:16.2"], "en": "I obtain three fruits:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:16.3"], "en": "long life and great wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:16.4"], "en": "May I possess sharp wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:17.1", "PA_tha-ap_26:17.2"], "en": "and may I be one who summarizes for all [beings] that which is the most excellent state of a person.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:17.3"], "en": "Having wandered through existence after existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:17.4", "PA_tha-ap_26:18.1"], "en": "I have attained these states through immeasurable virtues.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:18.2"], "en": "If the disciples of the Conqueror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:18.3", "PA_tha-ap_26:18.4"], "en": "while living in the world, were to become attached to states of existence, what would the result be?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:19.1"], "en": "The five precepts were well-practiced by me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:19.2"], "en": "a practitioner who lived as a mendicant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:19.3"], "en": "by virtue of that morality, today—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:19.4"], "en": "I liberated [them] from all bonds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:20.1"], "en": "In immeasurable eons past,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:20.2"], "en": "I guarded the five precepts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:20.3"], "en": "I do not know a miserable rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:20.4"], "en": "this is the fruit of the five precepts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:21.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:21.2", "PA_tha-ap_26:21.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:21.4"], "en": "the Buddha’s teaching has been accomplished.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:22.1"], "en": "Thus indeed the elder Pañcasīlasamādāniya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_26:23.1"], "en": "This is the fourth legend of the elder Pañcasīlasamādāniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
