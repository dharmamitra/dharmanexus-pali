[
{"segs": ["PA_ja_347:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:0.2"], "en": "The Collection of Fours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:0.3"], "en": "The Minor Kuṇāla Chapter", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:0.4"], "en": "7. The Ayakūṭa Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:1.1", "PA_ja_347:1.2"], "en": "“You who stand in the sky, grasping a hammer made entirely of iron that is of excessive size;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:1.3"], "en": "“Have you been appointed by me for my protection,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:1.4"], "en": "or do you intend to bring about my death? “O King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:2.1"], "en": "I am a messenger here of the Rākṣasas.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:2.2"], "en": "\"I have been sent to you for execution;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:2.3"], "en": "yet Indra, the king of the gods, protects you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:2.4"], "en": "and therefore I do not cleave your head.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:3.1", "PA_ja_347:3.2"], "en": "“If the King of the Gods, Maghavā, Sujampati, the Lord of the Devas, protects me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:3.3"], "en": "let all the piśācas cry out as they please.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:3.4"], "en": "Do not be afraid of the race of ogresses.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:4.1", "PA_ja_347:4.2"], "en": "Let the kumbhaṇḍas and all the dust-demons cry out as they wish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:4.3"], "en": "“Piśācas are not fit for battle;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:4.4"], "en": "that was a great deception.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_347:5.1"], "en": "Thus ends the seventh Jātaka, the Aya-kūṭa Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
