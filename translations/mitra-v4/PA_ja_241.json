{"segs": ["PA_ja_241:0.4"], "en": "1. The Sabbadāṭhi Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_241:1.1", "PA_ja_241:1.2"], "en": "“The jackal, arrogant and stubborn, desiring a retinue;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_241:1.3"], "en": "He attained the great state,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_241:1.4"], "en": "becoming the king of all thorny creatures;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_241:2.1"], "en": "even so among humans.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_241:2.2", "PA_ja_241:2.3"], "en": "He who has a retinue is indeed great in that regard,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_241:2.4"], "en": "like a jackal among those with fangs.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_241:3.1"], "en": "The Sabbadāṭhi Jātaka is first.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
