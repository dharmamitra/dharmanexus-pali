[
{"segs": ["PA_tha-ap_551:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:0.2"], "en": "Bhaddiyavagga 9.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:0.3"], "en": "The Apadāna of the Elder Vanavaccha", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:1.1"], "en": "“In this auspicious aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:1.2"], "en": "there was one of great renown, a kinsman of Brahmā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:1.3"], "en": "Kassapa by clan.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:1.4"], "en": "The best among those who speak arose.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:2.1", "PA_tha-ap_551:2.2"], "en": "Then, having gone forth in the teaching of that Buddha, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:2.3"], "en": "Having practiced the holy life for as long as life lasts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:2.4"], "en": "when one passes away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:3.1"], "en": "by that well-performed karma—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:3.2"], "en": "And through my volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:3.3"], "en": "having cast off this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:3.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:4.1"], "en": "Passing away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:4.2"], "en": "I was born as a pigeon in a forest;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:4.3"], "en": "there I dwelt, endowed with virtuous qualities.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:4.4"], "en": "The bhikkhu always delights in meditative absorption;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:5.1"], "en": "with a mind of loving-kindness and compassion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:5.2"], "en": "his face is always joyful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:5.3"], "en": "The Great Hero is equanimous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:5.4"], "en": "skilled in the immeasurables,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:6.1"], "en": "with his thoughts free from hindrances.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:6.2"], "en": "Intent upon the welfare of all beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:6.3", "PA_tha-ap_551:6.4"], "en": "I soon became a devoted follower of that disciple of the Sugata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:7.1", "PA_tha-ap_551:7.2"], "en": "While he was sitting at the foot of the tree near that hermitage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:7.3"], "en": "someone would occasionally give him material gifts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:7.4"], "en": "And taught the Dhamma at one time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:8.1", "PA_tha-ap_551:8.2"], "en": "Then, having attended upon the Conqueror’s son with vast affection;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:8.3"], "en": "Having passed away from there, he went to heaven,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:8.4"], "en": "as if returning home from abroad;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:9.1"], "en": "having passed away from heaven, he was born among humans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:9.2"], "en": "Reborn through meritorious deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:9.3", "PA_tha-ap_551:9.4"], "en": "I abandoned the household life and went forth many times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:10.1"], "en": "Having been a śramaṇa, an ascetic, a brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:10.2"], "en": "and likewise a wandering mendicant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:10.3"], "en": "I dwelt in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:10.4"], "en": "For many hundreds of times,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:11.1"], "en": "and now in this final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:11.2"], "en": "in delightful Kapilavatthu;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:11.3"], "en": "Vacchagotta said to him:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:11.4", "PA_tha-ap_551:12.1"], "en": "\"I approached my wife because I had a longing for my mother.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:12.2"], "en": "While I was still within my mother’s womb,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:12.3", "PA_tha-ap_551:12.4"], "en": "the resolve to dwell in the forest arose in me as I drew near to birth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:13.1", "PA_tha-ap_551:13.2", "PA_tha-ap_551:13.3"], "en": "Then my mother gave birth to me in a delightful forest glade as I emerged from the womb.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:13.4"], "en": "He accepted it in his saffron robe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:14.1"], "en": "Then Prince Siddhattha was born,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:14.2"], "en": "the banner of the Śākya clan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:14.3"], "en": "I was his friend, dear to him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:14.4"], "en": "trusted and well-esteemed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:15.1"], "en": "When the seven precious treasures had emerged,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:15.2"], "en": "Having abandoned extensive fame,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:15.3"], "en": "I too, having gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:15.4"], "en": "approached the Himalayas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:16.1"], "en": "Having seen and heard of the arising of the Conqueror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:16.2"], "en": "one should cultivate a forest-dwelling life under Kassapa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:16.3"], "en": "the proponent of the ascetic practices.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:16.4"], "en": "I approached the Charioteer of Men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:17.1"], "en": "He taught me the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:17.2"], "en": "illuminating it in its entirety.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:17.3"], "en": "Then, having gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:17.4"], "en": "I returned once more to the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:18.1"], "en": "dwelling there with heedfulness, I remained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:18.2"], "en": "I have realized the six direct knowledges;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:18.3"], "en": "oh, what a gain I have obtained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:18.4"], "en": "for I have been shown compassion by my good friend!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:19.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:19.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:19.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:20.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:20.2", "PA_tha-ap_551:20.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:21.1", "PA_tha-ap_551:21.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:21.3"], "en": "[and so forth] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:22.1"], "en": "Thus indeed the venerable elder Vanavaccha spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_551:23.1"], "en": "This is the ninth legend of the elder Vanavaccha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
