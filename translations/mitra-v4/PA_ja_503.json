[
{"segs": ["PA_ja_503:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:0.2", "PA_ja_503:0.3"], "en": "The Collection of Twenty, Chapter on Mātaṅga", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:0.4"], "en": "7. The Sattigumba Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:1.1", "PA_ja_503:1.2"], "en": "The Great King Migaludda, the bull among charioteers of the Pañcālas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:1.3"], "en": "Having set out with his army,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:1.4"], "en": "he entered the forest alone.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:2.1"], "en": "There in the wilderness, he saw—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:2.2"], "en": "A hut has been built for hunters;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:2.3"], "en": "having emerged from that hut,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:2.4"], "en": "the bird cries out harshly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:3.1"], "en": "“A man with a well-equipped vehicle,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:3.2"], "en": "young, with earrings properly set,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:3.3"], "en": "shines with a red turban.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:3.4"], "en": "By day he shines like the sun;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:4.1"], "en": "at the hour of midday,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:4.2"], "en": "the king sleeps together with his charioteer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:4.3", "PA_ja_503:4.4"], "en": "Let us all seize her hand-ornaments by force;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:5.1"], "en": "even now, let us do so in secret at nightfall.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:5.2"], "en": "The king was asleep along with his charioteer;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:5.3"], "en": "taking the cloth, the jewel, and the earring,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:5.4"], "en": "let us kill him and cover him over with branches.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:6.1", "PA_ja_503:6.2"], "en": "“Why do you speak thus like one who is mad, O Sattigumba?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:6.3"], "en": "For kings are indeed difficult to approach.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:6.4"], "en": "“Like a blazing fire,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:7.1"], "en": "you, O hollow pillar,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:7.2"], "en": "being intoxicated, roar loudly.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:7.3", "PA_ja_503:7.4"], "en": "\"Why do you feel such disgust toward my naked mother?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:8.1"], "en": "\"Arise quickly, my friend!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:8.2"], "en": "\"Yoke the chariot, charioteer;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:8.3"], "en": "Sakuṇa does not please me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:8.4"], "en": "Let us go to another hermitage.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:9.1"], "en": "“The chariot is harnessed, O Great King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:9.2"], "en": "and the draft animals are yoked;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:9.3"], "en": "mount it, O Great King.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:9.4"], "en": "“Let us go to another hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:10.1"], "en": "“Who indeed has gone away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:10.2"], "en": "all those who were my attendants here?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:10.3"], "en": "\"There goes Pañcāla,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:10.4"], "en": "released from their sight.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:11.1"], "en": "Take up your bows!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:11.2"], "en": "Spears and javelins;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:11.3"], "en": "this Pañcāla is coming—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:11.4"], "en": "do not let him escape alive!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:12.1"], "en": "Then another, a red-beaked bird,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:12.2"], "en": "replied in welcome:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:12.3"], "en": "\"Welcome to you, O Great King!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:12.4"], "en": "Thus, your arrival is welcome;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:12.5"], "en": "you are a lord who has come,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:12.6"], "en": "so declare whatever you have here.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:13.1"], "en": "Tinduka fruits, piyāla fruits,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:13.2"], "en": "madhuka, and kāsumārī;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:13.3"], "en": "these are small fruits.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:13.4"], "en": "\"O King, enjoy the most excellent of delicacies.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:14.1"], "en": "This too is cool water,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:14.2"], "en": "brought from the heart of the mountains.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:14.3"], "en": "Therefore drink from it, O Great King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:14.4"], "en": "if you so desire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:15.1"], "en": "We have gone to the forest for gleaning.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:15.2"], "en": "“Those who are my attendants here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:15.3"], "en": "rise up yourselves and take [what you need];", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:15.4"], "en": "I have no hands with which to give.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:16.1"], "en": "“Truly fortunate is this bird,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:16.2"], "en": "a twice-born one most righteous in dharma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:16.3"], "en": "alas for that other bird!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:16.4"], "en": "The hawk cries out its fierce cries:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:17.1"], "en": "“Seize him! Bind him!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:17.2"], "en": "Do not let him escape alive!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:17.3"], "en": "While I was lamenting in this way,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:17.4"], "en": "I reached my hermitage in safety.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:18.1"], "en": "\"We are brothers, O Great King.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:18.2"], "en": "Sisters with the same mother,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:18.3", "PA_ja_503:18.4"], "en": "both raised on a single tree, yet both have gone to different fields.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:19.1"], "en": "Sattigumba was among the thieves,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:19.2"], "en": "and I here among the seers;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:19.3"], "en": "he was among the wicked, and I among the virtuous.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:19.4"], "en": "“Without that Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:20.1", "PA_ja_503:20.2"], "en": "there is for us neither death nor imprisonment, nor deceit and trickery. “In that regard, there is killing and binding, as well as fraud and deception.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:20.3"], "en": "Morsels of food taken with violence—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:20.4"], "en": "these he trains himself in there; here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:21.1"], "en": "however, are truth and the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:21.2"], "en": "Non-violence, self-restraint, and self-control;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:21.3", "PA_ja_503:21.4"], "en": "I was raised in the lap of those who provide seats and water, O Bhāradvāja.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:22.1"], "en": "“Whatever person a king associates with,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:22.2"], "en": "whether they be virtuous or not,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:22.3"], "en": "whether they be moral or immoral— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:22.4"], "en": "One comes under the very sway of that [friend].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:23.1"], "en": "Whatever kind of friend one makes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:23.2"], "en": "and whatever kind one serves;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:23.3"], "en": "He too becomes like that,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:23.4"], "en": "for such is the nature of living together;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:24.1"], "en": "by associating with one who associates, [one becomes like him].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:24.2"], "en": "Touched, yet touching another,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:24.3"], "en": "like a poisoned arrow striking a bundle of reeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:24.4"], "en": "it defiles that which is undefiled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:24.5", "PA_ja_503:24.6"], "en": "Out of fear of being defiled, the wise person should never have evil friends.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:25.1"], "en": "[It would be better] to carry a rotting fish on the tip of a blade of kusa grass...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:25.2", "PA_ja_503:25.3"], "en": "The person who associates with the wicked emits a foul stench, even as reeds do;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:25.4"], "en": "such is the result of associating with fools.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:26.1", "PA_ja_503:26.2"], "en": "The man who wraps tagara with palāśa leaves—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:26.3"], "en": "its fragrance wafts even from the petals.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:26.4"], "en": "Such is the cultivation of wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:27.1", "PA_ja_503:27.2"], "en": "Therefore, having understood the ripening of oneself, just like a leaf-bag, [one should act accordingly].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:27.3", "PA_ja_503:27.4"], "en": "A wise person should not associate with the wicked, but should associate with the virtuous;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:27.5"], "en": "for the wicked lead one to hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:27.6"], "en": "“The virtuous lead to a happy destination.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_503:28.1"], "en": "Thus ends the seventh Jātaka, the Sattigumba Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
