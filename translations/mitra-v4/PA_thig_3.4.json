[
{"segs": ["PA_thig_3.4:0.1", "PA_thig_3.4:0.2", "PA_thig_3.4:0.3"], "en": "Therīgāthā 3.4 Tikanipāta Dantikā Therīgāthā", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.4:1.1", "PA_thig_3.4:1.2"], "en": "Having emerged from his midday rest on Vulture Peak Mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.4:1.3"], "en": "he saw the nāga emerging from the water.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.4:1.4", "PA_thig_3.4:2.1"], "en": "On the riverbank I saw a man who, taking up a hook,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.4:2.2"], "en": "begged, \"Give me your foot!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.4:2.3"], "en": "The elephant extended its foot,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.4:2.4"], "en": "and the man mounted the elephant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.4:3.1"], "en": "seeing it tamed when it was untamed, he was amazed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.4:3.2"], "en": "Having fallen under the power of human beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.4:3.3"], "en": "I then composed my mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.4:3.4"], "en": "indeed, I had gone to that forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.4:4.1"], "en": "… the elder nun Dantikā …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
