[
{"segs": ["PA_tha-ap_32:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:0.2"], "en": "Subhūti Chapter 10:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:0.3"], "en": "The Apadāna of the Elder Khomadāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:1.1", "PA_tha-ap_32:1.2"], "en": "“At that time, in the city of Bandhumatī, I was a merchant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:1.3"], "en": "with that very [wealth], I supported my wife.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:1.4", "PA_tha-ap_32:2.1", "PA_tha-ap_32:2.2"], "en": "I plant the excellence of the seed for the Great Seer Vipassi, who has set out upon the royal road.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:2.3", "PA_tha-ap_32:2.4"], "en": "A single linen garment was given by me to the Teacher for the sake of his welfare;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:3.1"], "en": "ninety-one eons ago, it was offered.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:3.2"], "en": "Because I gave that linen cloth at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:3.4"], "en": "this is the fruit of giving linen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:4.1"], "en": "Seventeen kalpas ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:4.2"], "en": "there was one named Sindhava-sandhana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:4.3"], "en": "who was endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:4.4"], "en": "Lord over the four continents.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:5.1", "PA_tha-ap_32:5.2"], "en": "The four analytical knowledges (paṭisambhidā) and these eight liberations (vimokkha);", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:5.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:5.4"], "en": "the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:6.1"], "en": "Thus indeed did the venerable elder Khomadāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:7.1"], "en": "The legend of the Elder Khomadāyaka is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:8.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:9.1"], "en": "Subhūti and Upavāna, and...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:9.2"], "en": "Saraṇa, Sīlagāhaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:9.3"], "en": "Annasaṃsāvaka, Dhūpa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:9.4"], "en": "Pulina, and Uttiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:10.1"], "en": "Añjali and Khomadāyī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:10.2"], "en": "and ten more in the third group;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:10.3"], "en": "five hundred and eighty are thus stated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:10.4"], "en": "All the verses combined.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:11.1"], "en": "The third chapter, the Subhūti-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_32:12.1"], "en": "The fourth recitation section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
