[
{"segs": ["PA_thag_1.16:0.1", "PA_thag_1.16:0.2", "PA_thag_1.16:0.3"], "en": "Theragāthā 1.16 Ekakanipāta Dutiyavagga (The Second Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.16:0.4"], "en": "The Verses of the Elder Belaṭṭhasīsa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.16:1.1"], "en": "“Just as a noble thoroughbred horse,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.16:1.2"], "en": "like a plow-turning firebrand;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.16:1.3", "PA_thag_1.16:1.4"], "en": "Thus my days and nights pass away without difficulty;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.16:1.5"], "en": "they pass away without difficulty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.16:1.6"], "en": "“When spiritual happiness has been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.16:1.7"], "en": "... Thus spoke the Elder Belaṭṭhasīsa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
