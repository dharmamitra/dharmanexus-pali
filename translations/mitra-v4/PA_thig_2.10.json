[
{"segs": ["PA_thig_2.10:0.1", "PA_thig_2.10:0.2", "PA_thig_2.10:0.3"], "en": "Therīgāthā 2.10 Dukanipāta Sāmā Therīgāthā", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.10:1.1", "PA_thig_2.10:1.2"], "en": "Four times and five times I went out from my dwelling;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.10:1.3"], "en": "not having attained peace of mind, I departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.10:1.4"], "en": "I have no mastery over my mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.10:1.5", "PA_thig_2.10:1.6"], "en": "for me, this is the eighth night since craving was utterly uprooted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.10:2.1"], "en": "Through many states of suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.10:2.2"], "en": "by my delight in heedfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.10:2.3"], "en": "the destruction of craving has been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.10:2.4"], "en": "“Thus was the Buddha’s teaching proclaimed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.10:3.1"], "en": "… Thus spoke the elder nun Sāmā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.10:4.1"], "en": "The Second Book is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
