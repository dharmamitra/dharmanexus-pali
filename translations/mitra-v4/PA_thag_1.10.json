[
{"segs": ["PA_thag_1.10:0.1", "PA_thag_1.10:0.2"], "en": "Theragāthā 1.10 Ekakanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:0.3"], "en": "First Chapter (Paṭhamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:0.4"], "en": "The Verse of the Elder Puṇṇamāsa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:1.1", "PA_thag_1.10:1.2"], "en": "“Let one who has attained knowledge, who is stilled and self-controlled, dwell here or in the world beyond without longing.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:1.3"], "en": "“Unstained by any phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:1.4"], "en": "one should know the arising and passing away of the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:1.5"], "en": "Thus indeed did the venerable elder Puṇṇamāsa speak this verse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:1.6"], "en": "The first chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:2.0"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:2.1"], "en": "Subhūti, the Elder Koṭṭhika,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:2.2"], "en": "Kaṅkhārevata, who was highly esteemed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:2.3"], "en": "Dabba, the son of Mantāṇī;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:2.4"], "en": "and Bhalliya of the Cool Grove.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:2.5"], "en": "Vīra, Pilindavaccha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.10:2.6"], "en": "Puṇṇamāsa, and Tamonuda.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
