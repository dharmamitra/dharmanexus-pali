[
{"segs": ["PA_tha-ap_460:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:0.2"], "en": "The Chapter on the Givers of the Earth (Jagatidāyakavagga) 8.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:0.3"], "en": "The Apadāna of the Elder Jātipupphiya (The One with the Birth-Flower)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:1.1", "PA_tha-ap_460:1.2"], "en": "“When the Blessed One Padumuttara of great fame had attained final Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:1.3"], "en": "having fashioned a flower-ornament for his head— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:1.4"], "en": "I ascended into the body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:2.1"], "en": "Having gladdened my mind therein,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:2.2"], "en": "I went to the realm of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:2.3"], "en": "Having gone to the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:2.4"], "en": "I remember my meritorious deed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:3.1"], "en": "for me there is a rain of celestial flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:3.2"], "en": "It rains at all times;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:3.3"], "en": "if I am reborn among humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:3.4"], "en": "I become a king of great renown.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:4.1", "PA_tha-ap_460:4.2"], "en": "There, a rain of flowers falls upon me at all times;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:4.3"], "en": "it is for that very offering of flowers—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:4.4"], "en": "By the power of the All-Seeing One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:5.1"], "en": "This is my final one;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:5.2"], "en": "my last existence is now unfolding.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:5.3", "PA_tha-ap_460:5.4"], "en": "Even today, a rain of flowers rains down upon me at all times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:6.1"], "en": "A hundred thousand aeons ago—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:6.2"], "en": "The flower that I offered—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:6.3", "PA_tha-ap_460:6.4"], "en": "of this bodily worship, I do not know a state of misery as its fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:7.1", "PA_tha-ap_460:7.2"], "en": "The defilements have been burnt away by me; ... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:7.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:8.1"], "en": "\"Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:8.2", "PA_tha-ap_460:8.3"], "en": "[as before] ...the Buddha’s teaching has been accomplished.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:9.1", "PA_tha-ap_460:9.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:9.3"], "en": "[and so forth] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:10.1"], "en": "Thus indeed the venerable elder Jātipupphiya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_460:11.1"], "en": "This is the eighth legend of the elder Jātipupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
