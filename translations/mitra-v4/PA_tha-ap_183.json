[
{"segs": ["PA_tha-ap_183:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:0.2"], "en": "The Chapter on the Kuṭaja Flower, 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:0.3"], "en": "The Apadāna of the Elder Kuṭajapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:1.1"], "en": "“The Sambuddha, golden-hued,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:1.2"], "en": "risen like the sun with its hundred rays,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:1.3"], "en": "surveying all directions— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:1.4"], "en": "While traveling along the path of the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:2.1"], "en": "he saw a *kuṭaja* tree in full bloom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:2.2"], "en": "its branches wide-spreading and evenly covered with flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:2.3"], "en": "Having plucked [a flower] from a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:2.4"], "en": "I offered it to Phussa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:3.1"], "en": "Ninety-two aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:3.2"], "en": "Because I offered that flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:3.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:3.4"], "en": "this is the fruit of worshiping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:4.1"], "en": "In this seventeenth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:4.2"], "en": "there were three [kings] in full bloom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:4.3"], "en": "endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:4.4"], "en": "The wheel-turning monarchs of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:5.1", "PA_tha-ap_183:5.2"], "en": "the four analytical knowledges and these eight liberations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:5.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:5.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:6.1"], "en": "Thus indeed did the Venerable Elder Kuṭajapupphiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_183:7.1"], "en": "The legend of the Elder Kuṭajapupphiya is first.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
