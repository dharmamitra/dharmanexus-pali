[
{"segs": ["PA_tha-ap_542:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:0.2"], "en": "The Section on Kaccāyana, 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:0.3"], "en": "The Apadāna of the Elder Mogharāja", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:1.2"], "en": "the Sage who knows all the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:1.3"], "en": "[appeared] one hundred thousand aeons from now.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:1.4"], "en": "In this eon, the Visionary One appeared.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:2.1"], "en": "He is the advisor, the inspirer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:2.2"], "en": "the guide for all living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:2.3"], "en": "The Buddha, skilled in teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:2.4"], "en": "delivered many people across;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:3.1"], "en": "he is compassionate and merciful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:3.2"], "en": "Seeking the welfare of all living beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:3.3", "PA_tha-ap_542:3.4"], "en": "he established all the heretics who arrived there in the five precepts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:4.1", "PA_tha-ap_542:4.2"], "en": "Thus it was free from confusion and empty of non-Buddhist sectarians;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:4.3"], "en": "it was made radiant by Arhats.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:4.4", "PA_tha-ap_542:5.1", "PA_tha-ap_542:5.2"], "en": "By those who have attained mastery and reached the state of the \"Tādi,\" that Great Sage has risen up, possessing eighty-four thousand jewels of wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:5.3"], "en": "Resembling a priceless golden ornament,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:5.4"], "en": "endowed with the thirty-two excellent marks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:6.1"], "en": "for one hundred thousand years—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:6.2"], "en": "As long as life remained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:6.3", "PA_tha-ap_542:6.4"], "en": "for that long he stayed and delivered many people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:7.1"], "en": "At that time, in Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:7.2"], "en": "I was born into a certain family,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:7.3"], "en": "engaged in working for others.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:7.4"], "en": "I have no wealth at all.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:8.1", "PA_tha-ap_542:8.2"], "en": "Dwelling in a rest-house on prepared ground;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:8.3"], "en": "There I kindled a fire,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:8.4"], "en": "and that great earth became intensely black.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:9.1"], "en": "Then the Protector [spoke] in the assembly...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:9.2", "PA_tha-ap_542:9.3", "PA_tha-ap_542:9.4"], "en": "The proclaimer of the Four Truths praised his disciple as one who wore coarse robes.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:10.1"], "en": "Delighted by that quality of his,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:10.2"], "en": "having prostrated to the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:10.3"], "en": "[he requested] the foremost practice of wearing coarse robes.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:10.4"], "en": "I aspired for that supreme state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:11.1", "PA_tha-ap_542:11.2"], "en": "Then the Blessed One Padumuttara spoke to his disciples:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:11.3"], "en": "“Behold this man,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:11.4"], "en": "poorly clothed and thin of body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:12.1"], "en": "yet with a face brightened by joy.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:12.2"], "en": "Endowed with the wealth of faith,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:12.3"], "en": "joyful, born of gladness, delighted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:12.4"], "en": "immovable, and firm as a cluster of sal flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:13.1", "PA_tha-ap_542:13.2"], "en": "This place is aspired to by the bhikkhu Saccasena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:13.3"], "en": "who wears coarse robes.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:13.4"], "en": "His heart was inclined toward that excellence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:14.1"], "en": "Having heard this, he became joyful and,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:14.2"], "en": "bowing his head to the Conqueror, paid homage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:14.3", "PA_tha-ap_542:14.4"], "en": "Having performed beautiful deeds throughout one's life in the teaching of the Victor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:15.1"], "en": "by that well-performed karma—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:15.2"], "en": "And through my volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:15.3"], "en": "having cast off this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:15.4"], "en": "I have gone to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:16.1"], "en": "In the hall of retreat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:16.2"], "en": "by the act of burning the ground,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:16.3"], "en": "one dwells in hell for ten thousand years.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:16.4"], "en": "Afflicted by painful sensations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:17.1"], "en": "because of the remainder of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:17.2"], "en": "I have undergone five hundred births here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:17.3"], "en": "Having been born as a human being,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:17.4"], "en": "marked by the characteristics of his birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:18.1"], "en": "for exactly five hundred births,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:18.2"], "en": "Afflicted with the disease of leprosy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:18.3", "PA_tha-ap_542:18.4"], "en": "I experienced great suffering as the consequence of that karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:19.1"], "en": "In this auspicious aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:19.2", "PA_tha-ap_542:19.3"], "en": "I satisfied the illustrious Upāriṭṭha with almsfood.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:19.4"], "en": "With a mind full of serene confidence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:20.1", "PA_tha-ap_542:20.2"], "en": "by that specific deed and through my volitions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:20.3"], "en": "Having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:20.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:21.1"], "en": "When my final existence was reached, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:21.2"], "en": "I was born into a khattiya family;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:21.3"], "en": "upon my father’s passing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:21.4"], "en": "I was installed in the great sovereignty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:22.1"], "en": "Overcome by the disease of leprosy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:22.2"], "en": "I find neither delight nor happiness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:22.3"], "en": "since my sovereignty and pleasure are now in vain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:22.4"], "en": "Then, O Mogharāja,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:23.1"], "en": "having seen the fault in the body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:23.2"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:23.3", "PA_tha-ap_542:23.4"], "en": "I entered into discipleship under the brahmin Bāvari,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:24.1"], "en": "who was accompanied by a great retinue.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:24.2"], "en": "Having approached the Leader of Men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:24.3"], "en": "I asked that skillful question of the Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:24.4"], "en": "the crusher of disputants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:25.1"], "en": "\"This world and the other world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:25.2"], "en": "the Brahma-world together with its devas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:25.3"], "en": "I do not recognize any view [of mine].\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:25.4"], "en": "Of the illustrious Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:26.1", "PA_tha-ap_542:26.2"], "en": "Having come with a question to one who possesses such sublime vision, I have approached you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:26.3", "PA_tha-ap_542:26.4", "PA_tha-ap_542:27.1"], "en": "\"How beholding the world does the King of Death not see him? \"Behold the world as empty; [behold it as devoid of self and what belongs to self].\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:27.2"], "en": "O Mogharāja, always mindful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:27.3"], "en": "having uprooted the view of a self,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:27.4"], "en": "one may thus be a crosser over death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:28.1", "PA_tha-ap_542:28.2"], "en": "‘The King of Death does not see one who thus contemplates the world’—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:28.3"], "en": "thus did the Buddha speak to me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:28.4"], "en": "The healer of all diseases.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:29.1"], "en": "At the conclusion of the verse,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:29.2"], "en": "he was shorn of his hair and beard.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:29.3"], "en": "Clad in saffron robes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:29.4"], "en": "I was a bhikkhu worthy of the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:30.1"], "en": "dwelling in monasteries belonging to the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:30.2"], "en": "Oppressed by disease, I was not in control;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:30.3"], "en": "\"May the monastery not be defiled,\" [I thought],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:30.4"], "en": "while being tormented by wind-diseases.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:31.1"], "en": "Having taken [rags] from heaps of refuse,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:31.2"], "en": "from cemeteries, and from streets;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:31.3"], "en": "having then fashioned them into a saṅghāṭī robe,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:31.4"], "en": "I wore coarse robes.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:32.1"], "en": "The Great Physician,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:32.2"], "en": "the Guide, was pleased with me for that quality.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:32.3", "PA_tha-ap_542:32.4"], "en": "He placed me at the very head of those who wear coarse robes.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:33.1"], "en": "With merit and evil entirely exhausted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:33.2"], "en": "Free from all diseases,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:33.3"], "en": "like a flame without fuel,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:33.4"], "en": "he will attain Nibbāna, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:34.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:34.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:34.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:35.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:35.2", "PA_tha-ap_542:35.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:36.1", "PA_tha-ap_542:36.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:36.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:37.1"], "en": "Thus indeed the venerable elder Mogharāja spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:38.1"], "en": "This is the tenth *apadāna* of the elder Mogharāja.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:39.1"], "en": "The fifty-fourth chapter, the Kaccāyana-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:40.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:41.1"], "en": "The Elder Kaccāna, Vakkali,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:41.2"], "en": "and he known as Mahākappina;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:41.3"], "en": "Dabba, named Kumāra,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:41.4"], "en": "and Bāhiya Koṭṭhika who had attained mastery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:42.1"], "en": "Uruvelakassapa and Rādha—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:42.2"], "en": "And the wise Mogharāja;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_542:42.3", "PA_tha-ap_542:42.4"], "en": "here, three hundred and sixty-two verses are combined.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
