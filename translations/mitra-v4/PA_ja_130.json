{"segs": ["PA_ja_130:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_130:0.2", "PA_ja_130:0.3"], "en": "Ekakanipāta, Kusanāḷivagga (The Chapter on the Kusa Reed)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_130:0.4"], "en": "10. The Kosiya Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_130:1.1"], "en": "“Just as you speak, so should you eat;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_130:1.2"], "en": "and just as you have eaten, so should you speak.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_130:1.3"], "en": "“Both do not agree for you:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_130:1.4"], "en": "your words and what you have eaten, O Kosiya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_130:2.1"], "en": "The Kosiya Jātaka, the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_130:2.2"], "en": "The Thirteenth Chapter: The Kusa-reed Section.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_130:3.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_130:4.1"], "en": "Kusanāḷi, Sirivhayana, and Yasa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_130:4.2"], "en": "Dadhi, Mamba, Kaṭāhaka as the fifth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_130:4.3"], "en": "then Pāpaka, Khīra, Biḷāravata,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_130:4.4"], "en": "Sīkhi, and Kosiya— these are the ten.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
