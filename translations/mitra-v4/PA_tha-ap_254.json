[
{"segs": ["PA_tha-ap_254:0.1", "PA_tha-ap_254:0.2", "PA_tha-ap_254:0.3"], "en": "The Apadāna of the Elder Ekāsanadāyaka, from the Thomaka Chapter, Second.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:1.1"], "en": "“Having abandoned my celestial form,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:1.2"], "en": "I have come here with my consort,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:1.3"], "en": "desiring to perform a service.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:1.4"], "en": "In the teaching of the Supreme Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:2.1", "PA_tha-ap_254:2.2"], "en": "there was a disciple of Padumuttara known by the name Devala.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:2.3", "PA_tha-ap_254:2.4"], "en": "To him alms were given by me with a serene mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:3.1"], "en": "One hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:3.2"], "en": "Whatever deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:3.4"], "en": "this is the fruit of that alms-food.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:4.1", "PA_tha-ap_254:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:4.3"], "en": "[and so forth] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:5.1"], "en": "Thus indeed the venerable elder Ekāsanadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_254:6.1"], "en": "This is the second *apadāna* of the elder Ekāsanadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
