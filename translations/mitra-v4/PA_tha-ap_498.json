[
{"segs": ["PA_tha-ap_498:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:0.2"], "en": "The Chapter on Kiṅkaṇī Flowers, 6.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:0.3"], "en": "The Apadāna of the Elder Ghatamaṇḍadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:1.1"], "en": "“Well-considered is the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:1.2"], "en": "the Eldest in the World, the Bull among Men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:1.3"], "en": "having entered the great forest,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:1.4"], "en": "Seeing him oppressed by the affliction of wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:2.1", "PA_tha-ap_498:2.2"], "en": "I gladdened his mind and offered him ghee and cream.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:2.3"], "en": "Because it has been accumulated and built up,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:2.4"], "en": "this Ganges Bhāgīrathī [flows];", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:3.1"], "en": "so too do the four great oceans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:3.2"], "en": "They would fill my jar;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:3.3"], "en": "yet this earth is vast,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:3.4"], "en": "immeasurable, and incalculable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:4.1"], "en": "Knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:4.2", "PA_tha-ap_498:4.3"], "en": "these honey-sugar trees from the four continents have appeared for you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:4.4"], "en": "Trees are things that grow from the earth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:5.1"], "en": "yet, knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:5.2"], "en": "they become wish-fulfilling trees for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:5.3", "PA_tha-ap_498:5.4"], "en": "Fifty times I exercised sovereignty over the gods as the Lord of Devas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:6.1"], "en": "and fifty-one times—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:6.2"], "en": "I was a universal monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:6.3"], "en": "my regional sovereignty was vast,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:6.4"], "en": "beyond all counting.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:7.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:7.2"], "en": "whatever gift I gave at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:7.3"], "en": "I do not know a state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:7.4"], "en": "This is the fruit of the Ghaṭamaṇḍa [Sutta]:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:8.1", "PA_tha-ap_498:8.2"], "en": "the defilements have been burnt away by me... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:8.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:9.1", "PA_tha-ap_498:9.2"], "en": "Welcome indeed has come to me... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:9.3"], "en": "This is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:10.1", "PA_tha-ap_498:10.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:10.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:11.1"], "en": "In this way, it is said, the venerable elder Ghatamaṇḍadāyaka recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_498:12.1"], "en": "This is the sixth legend of the elder Ghatamaṇḍadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
