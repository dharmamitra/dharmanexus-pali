[
{"segs": ["PA_ja_437:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:0.2", "PA_ja_437:0.3"], "en": "The Ninth Chapter, The Section on Vultures (Gijjhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:0.4", "PA_ja_437:1.1"], "en": "11. The Pūtimamsa Jātaka “I do not like this fence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:1.2"], "en": "nor do I like looking at putrid flesh.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:1.3", "PA_ja_437:1.4"], "en": "“One should avoid such a disposition from afar.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:2.1"], "en": "“This woman is truly like a madwoman;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:2.2"], "en": "She praised her friend’s husband;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:2.3"], "en": "she grieved as she sent him back,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:2.4"], "en": "having brought Meṇḍakamātā to her.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:3.1"], "en": "“You are indeed mad, friend,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:3.2"], "en": "foolish and lacking in discernment,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:3.3"], "en": "you who have made a dwelling out of the dead.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:3.4"], "en": "“You look about at the wrong time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:4.1", "PA_ja_437:4.2"], "en": "“A wise person should not look about at the wrong time; he should look about at the right time.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:4.3", "PA_ja_437:4.4"], "en": "\"He who looks at things out of season will stew like putrid meat.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:5.1"], "en": "\"May my dear friend indeed be mine,\" [he said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:5.2"], "en": "\"Give me a full bowl;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:5.3"], "en": "my husband has been restored to life by me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:5.4"], "en": "so come as one who asks after his beloved.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:6.1"], "en": "“May it be dear to you, Āḷī;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:6.2"], "en": "I give this full bowl to you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:6.3"], "en": "together with a great retinue.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:6.4"], "en": "“Prepare food for such as these.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:7.1"], "en": "“What kind of retinue do you have,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:7.2"], "en": "for whom I shall prepare food?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:7.3"], "en": "\"And what are the names of them all?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:7.4"], "en": "Tell me that when you are asked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:8.1"], "en": "\"Māliya and Caturakkha,\" he replied.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:8.2"], "en": "Piṅgiya and Jambuka—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:8.3"], "en": "such is my retinue;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:8.4"], "en": "you should provide food for them.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:9.1"], "en": "“When one has gone forth from the home life,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:9.2"], "en": "even one’s belongings are lost; for Āḷina,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:9.3"], "en": "health itself became a fault.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:9.4"], "en": "“Dwell right here; do not come.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_437:10.1"], "en": "Thus ends the eleventh Jātaka, the Pūtimamsa-jātaka (The Jackal’s Story).", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
