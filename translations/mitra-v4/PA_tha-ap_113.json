[
{"segs": ["PA_tha-ap_113:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:0.2"], "en": "The Chapter on the Great Retinue (Mahāparivāravagga) 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:0.3"], "en": "The Apadāna of the Elder Mahāparivāraka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:1.1"], "en": "“The Blessed One named Vipassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:1.2"], "en": "the eldest in the world, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:1.3"], "en": "together with sixty-eight thousand [monks]...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:1.4"], "en": "He then entered Bandhumatī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:2.1"], "en": "Having departed from the city,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:2.2"], "en": "he went to the Dīpa Cetiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:2.3"], "en": "I saw the stainless Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:2.4"], "en": "the recipient of offerings—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:3.1"], "en": "eighty-four thousand [in number].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:3.2", "PA_tha-ap_113:3.3"], "en": "Yakkhas attend upon me with great care,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:3.4"], "en": "just as the hosts of the Thirty-three attend upon Indra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:4.1", "PA_tha-ap_113:4.2"], "en": "Having gone forth from my dwelling and taken up a robe,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:4.3"], "en": "I then paid homage with my head.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:4.4"], "en": "And I took it from the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:5.1"], "en": "\"O, the Buddhas! O, the Dhamma!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:5.2"], "en": "O, the excellence of our Teacher!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:5.3"], "en": "Through the power of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:5.4"], "en": "the earth trembles;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:6.1"], "en": "and having seen that marvel, [the people were filled with wonder].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:6.2"], "en": "It is wonderful and hair-raising;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:6.3"], "en": "I clarify my mind toward the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:6.4"], "en": "the Lord of bipeds, the Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:7.1", "PA_tha-ap_113:7.2"], "en": "Thus, having gladdened my mind and offered cloth to the Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:7.3"], "en": "I went for refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:7.4"], "en": "Together with my companions and retinue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:8.1", "PA_tha-ap_113:8.2"], "en": "I performed that deed at that time ninety-one aeons ago.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:8.3"], "en": "I do not recall being born in an evil state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:8.4"], "en": "this is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:9.1"], "en": "Fifteen aeons from now...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:9.2"], "en": "There were sixteen excellent charioteers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:9.3", "PA_tha-ap_113:9.4"], "en": "wheel-turning monarchs of great power, endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:10.1"], "en": "The four analytical knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:10.2"], "en": "these eight liberations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:10.3"], "en": "and the six direct knowledges have been realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:10.4"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:11.1"], "en": "In this way, it is said, the Venerable Mahāparivāraka Thera recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_113:12.1"], "en": "This is the first apadāna of the Venerable Mahāparivāraka Thera.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
