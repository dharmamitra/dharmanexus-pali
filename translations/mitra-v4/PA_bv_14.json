[
{"segs": ["PA_bv_14:0.1"], "en": "Buddhavamsa 14.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:0.2"], "en": "The Lineage of Sujāta Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:1.1"], "en": "“In that very same aeon of adornment (maṇḍakappa),”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:1.2"], "en": "The Leader named Sujāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:1.3"], "en": "with the jaw of a lion and the shoulders of a bull,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:1.4"], "en": "is immeasurable and difficult to approach.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:2.1"], "en": "Like the moon, stainless and pure;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:2.2"], "en": "like the sun, full of radiance—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:2.3"], "en": "thus does the Perfectly Awakened One shine.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:2.4"], "en": "Always shining with glory,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:3.1", "PA_bv_14:3.2"], "en": "having attained the perfect and supreme enlightenment of a Sambuddha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:3.3"], "en": "In the city of Sumaṅgala,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:3.4"], "en": "he set the Wheel of Dhamma in motion;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:4.1"], "en": "while teaching the sublime Dhamma, he—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:4.2", "PA_bv_14:4.3", "PA_bv_14:4.4"], "en": "O Sujātā, when the Leader of the World first taught the Dhamma, eighty koṭis attained realization.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:5.1"], "en": "When Sujāta, of immeasurable fame,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:5.2"], "en": "entered upon the rains retreat among the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:5.3"], "en": "there were seven million three hundred thousand [beings].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:5.4", "PA_bv_14:6.1"], "en": "The second realization occurred when Sujāta, the peerless one,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:6.2"], "en": "approached his father’s presence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:6.3", "PA_bv_14:6.4"], "en": "There was a third realization for six hundred thousand [beings].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:7.1"], "en": "There were three assemblies.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:7.2"], "en": "Of the well-born Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:7.3"], "en": "of those whose taints are exhausted, who are stainless,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:7.4"], "en": "whose minds are peaceful, and who are steadfast.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:8.1", "PA_bv_14:8.2"], "en": "Sixty hundred thousand [births] for those who have attained the power of direct knowledge, and for those who have not,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:8.3"], "en": "in various states of existence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:8.4"], "en": "They first assembled together.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:9.1", "PA_bv_14:9.2"], "en": "Again, they assembled when the Conqueror descended from the triple heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:9.3", "PA_bv_14:9.4", "PA_bv_14:10.1"], "en": "There was a second assembly of fifty hundred thousand [beings] as they approached the Bull among Men.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:10.2", "PA_bv_14:10.3", "PA_bv_14:10.4"], "en": "His chief disciple approached the Fully Enlightened One together with four hundred thousand followers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:11.1"], "en": "At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:11.2"], "en": "I was the lord of the four continents,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:11.3"], "en": "traveling through the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:11.4"], "en": "A wheel-turning monarch of great power,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:12.1"], "en": "having seen a marvel in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:12.2"], "en": "a wonder that makes the hair stand on end;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:12.3"], "en": "Having approached, he paid homage to Sujāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:12.4"], "en": "the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:13.1"], "en": "[He offered] the great sovereignty over the four continents.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:13.2", "PA_bv_14:13.3"], "en": "Having offered the seven supreme jewels to the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:13.4"], "en": "I went forth into homelessness in his presence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:14.1"], "en": "The monastery attendants in the countryside,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:14.2"], "en": "having gathered provisions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:14.3"], "en": "bring them to the community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:14.4"], "en": "As a condition for my dwelling and bedding,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:15.1", "PA_bv_14:15.2"], "en": "that Buddha, the Lord of the ten thousand worlds, made a prediction concerning me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:15.3"], "en": "\"In thirty thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:15.4"], "en": "this one will become a Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:16.1"], "en": "Having exerted himself in the supreme effort,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:16.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:16.3"], "en": "we shall be face to face with this one.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:17.1"], "en": "Having heard those words as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:17.2"], "en": "I produced even greater joy;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:17.3", "PA_bv_14:17.4"], "en": "indeed, I undertook a formidable vow for the fulfillment of the ten perfections.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:18.1", "PA_bv_14:18.2", "PA_bv_14:18.3"], "en": "Having mastered all of the Suttanta and the Vinaya— the ninefold teaching of the Teacher—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:18.4"], "en": "I adorned the teaching of the Jina.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:19.1"], "en": "Dwelling there with diligence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:19.2"], "en": "having cultivated the sublime meditation;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:19.3"], "en": "Having reached the perfection of direct knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:19.4"], "en": "I went to the path of the Brahma-world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:20.1"], "en": "There is a city named Sumaṅgala.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:20.2"], "en": "The Kṣatriya was named Uggata;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:20.3", "PA_bv_14:20.4"], "en": "the mother of the Great Seer Sujāta was named Pabhāvatī.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:21.1", "PA_bv_14:21.2"], "en": "For nine thousand years he dwelt in the household; [his sons were] Sirī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:21.3"], "en": "Upasirī, and Nanda.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:21.4"], "en": "There were three supreme palaces.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:22.1", "PA_bv_14:22.2"], "en": "Twenty-three thousand women were beautifully adorned.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:22.3", "PA_bv_14:22.4"], "en": "A woman named Sirinanda and a son named Upasena;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:23.1"], "en": "having seen four omens, [he departed].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:23.2"], "en": "He went forth by means of a good vehicle;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:23.3"], "en": "for nine full months,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:23.4"], "en": "the Conqueror exerted himself in striving.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:24.1"], "en": "Being entreated by Brahmā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:24.2"], "en": "the Well-Born One, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:24.3"], "en": "the Great Hero, set the Wheel of Dhamma in motion.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:24.4"], "en": "In the supreme Sumaṅgala Garden,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:25.1", "PA_bv_14:25.2"], "en": "Sudassana and Sudeva were his chief disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:25.3", "PA_bv_14:25.4"], "en": "Nārada was the attendant of the Great Sage Sujāta;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:26.1"], "en": "so too were the Nāgas and the Nāgasamālas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:26.2"], "en": "were his chief female disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:26.3", "PA_bv_14:26.4"], "en": "the Bodhi tree of that Blessed One is called Mahāveḷu.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:27.1"], "en": "And that tree has a thick trunk,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:27.2"], "en": "it is without gaps and full of leaves;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:27.3"], "en": "its bamboo-stem is straight and tall.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:27.4"], "en": "Beautiful and delightful to behold.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:28.1"], "en": "Having grown as a single trunk,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:28.2"], "en": "from that the branches then break forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:28.3"], "en": "Just as a well-tied peacock-feather fan,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:28.4"], "en": "so does that tree shine;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:29.1"], "en": "it has no thorns.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:29.2"], "en": "Nor was there any gap in it;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:29.3"], "en": "with its wide-spreading branches and no spaces between them,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:29.4"], "en": "it cast a dense shade and was delightful.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:30.1", "PA_bv_14:30.2"], "en": "Sudatta and Citta were their chief attendants;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:30.3"], "en": "Subhaddā and Padumā likewise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:30.4"], "en": "They were his foremost attendants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:31.1", "PA_bv_14:31.2"], "en": "That Victor was fifty ratanas in height.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:31.3"], "en": "Endowed with the excellence of every aspect,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:31.4"], "en": "having attained all virtues—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:32.1"], "en": "his radiance is unequaled by any equal.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:32.2"], "en": "It flows forth on every side;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:32.3"], "en": "immeasurable, incomparable,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:32.4"], "en": "and beyond all similes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:33.1"], "en": "For ninety thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:33.2"], "en": "the lifespan exists for that long;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:33.3"], "en": "remaining for that duration, he—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:33.4"], "en": "You have ferried across the multitude of people,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:34.1", "PA_bv_14:34.2"], "en": "like waves upon the ocean or stars in the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:34.3", "PA_bv_14:34.4"], "en": "Thus was the teaching then composed by the Arahants;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:35.1"], "en": "and he was the Buddha, the peerless among the peerless.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:35.2"], "en": "And those qualities were incomparable;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:35.3", "PA_bv_14:35.4"], "en": "all that has vanished. Are not all conditioned things indeed empty?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:36.1"], "en": "The Well-Born, the Supreme Victor, the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:36.2"], "en": "attained Nibbāna at Sīlārāma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:36.3"], "en": "right there stands his stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:36.4"], "en": "“Three gavutas in height.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bv_14:37.1"], "en": "This is the twelfth lineage of the Blessed One Sujāta.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
