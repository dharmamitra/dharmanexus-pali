[
{"segs": ["PA_ja_468:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:0.2"], "en": "The Twelfth Chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:0.3"], "en": "The Section on Cūḷakuṇāla", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:0.4"], "en": "5. The Janasandha Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:1.1", "PA_ja_468:1.2"], "en": "“Indeed, there are these ten points, Which one must not fail to perform beforehand;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:1.3", "PA_ja_468:1.4"], "en": "\"He regrets it afterwards,\" so says the Leader of the People.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:2.1"], "en": "\"Not having obtained wealth, he suffers.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:2.2"], "en": "\"Not having accumulated it in the past,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:2.3"], "en": "I did not seek wealth before\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:2.4"], "en": "thus one regrets later.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:3.1"], "en": "Having previously possessed the capacity for it,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:3.2"], "en": "I did not train in a craft;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:3.3"], "en": "for one without a craft, life is difficult.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:3.4"], "en": "Thus one regrets later:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:4.1"], "en": "\"In the past I was a speaker of falsehoods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:4.2"], "en": "a slanderer, and a backbiter.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:4.3", "PA_ja_468:4.4"], "en": "\"Both fierce and harsh,\" he later regrets,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:5.1"], "en": "\"I was formerly a killer of living beings.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:5.2"], "en": "And the hunter, being ignoble,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:5.3", "PA_ja_468:5.4"], "en": "later regrets it, thinking: \"I shall not show reverence toward living beings.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:6.1", "PA_ja_468:6.2"], "en": "While indeed many women exist who are blameless,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:6.3"], "en": "I have pursued the wives of others.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:6.4"], "en": "Thus one regrets later:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:7.1", "PA_ja_468:7.2"], "en": "\"Alas, while there was much food and drink available!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:7.3"], "en": "Not having given gifts in the past,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:7.4"], "en": "one regrets it later;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:8.1"], "en": "as does one who [neglects] mother and father.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:8.2"], "en": "\"Old, with youth gone;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:8.3"], "en": "though capable, I did not support him\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:8.4"], "en": "thus one regrets it later.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:9.1", "PA_ja_468:9.2", "PA_ja_468:9.3"], "en": "One who would despise their father— the teacher and instructor who brings all the flavors of sensual pleasure— would be acting wrongly.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:9.4"], "en": "Thus one regrets later:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:10.1", "PA_ja_468:10.2"], "en": "\"Toward recluses and brahmins who are virtuous and learned...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:10.3"], "en": "\"I did not attend upon him before\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:10.4"], "en": "thus one regrets later.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:11.1"], "en": "It is good that austerity has been practiced.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:11.2", "PA_ja_468:11.3"], "en": "Having failed to attend upon the virtuous and having failed to practice austerity in the past,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:11.4"], "en": "one later regrets it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:12.1", "PA_ja_468:12.2"], "en": "But whoever practices these points with wise attention,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:12.3"], "en": "performing the duties of a man,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:12.4"], "en": "“He does not regret it afterwards.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_468:13.1"], "en": "Thus ends the fifth Jātaka, the Janasandha Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
