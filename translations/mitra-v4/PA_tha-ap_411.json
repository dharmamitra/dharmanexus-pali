[
{"segs": ["PA_tha-ap_411:0.1", "PA_tha-ap_411:0.2", "PA_tha-ap_411:0.3"], "en": "The Apadāna of the Elder Jatukaṇṇi Metteyyavagga 9. Jatukaṇṇittheraapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:1.1"], "en": "“In the city of Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:1.2"], "en": "I was the son of a merchant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:1.3"], "en": "I was fully provided with the strands of sensual pleasure.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:1.4"], "en": "I would then attend upon him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:2.1"], "en": "Then, having ascended the palace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:2.2"], "en": "I was the enjoyer of great wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:2.3", "PA_tha-ap_411:2.4"], "en": "There, I then entertained myself with dances and songs;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:3.1"], "en": "musical instruments were struck for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:3.2", "PA_tha-ap_411:3.3"], "en": "All these women, skilled in rhythmic clapping and perfectly composed, as they dance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:3.4"], "en": "truly captivate my mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:4.1"], "en": "Celāpikā, Vāmanikā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:4.2"], "en": "Kuñjavāsī, Timajjhikā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:4.3"], "en": "Laṅghikā, and Sokajjhāyī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:4.4"], "en": "They always attend upon me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:5.1"], "en": "vetāḷas, kumbha-thūnis,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:5.2"], "en": "and many actors and dancers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:5.3", "PA_tha-ap_411:5.4"], "en": "Actors and dancers always surround me; so too do barbers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:6.1"], "en": "bath-attendants, and cooks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:6.2", "PA_tha-ap_411:6.3"], "en": "Gardeners, excellent lay disciples, wrestlers, and boxers—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:6.4"], "en": "all of them always attend upon me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:7.1", "PA_tha-ap_411:7.2"], "en": "While they were playing, having been well-trained and skilled in their practice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:7.3"], "en": "I did not know day from night.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:7.4"], "en": "Like Indra in the assembly of the thirty-three gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:8.1"], "en": "[he was surrounded by] all travelers and wayfarers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:8.2"], "en": "many supplicants and seekers of boons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:8.3", "PA_tha-ap_411:8.4", "PA_tha-ap_411:9.1"], "en": "Ascetics and brahmins alike constantly come to my house seeking alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:9.2"], "en": "Unsurpassed fields of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:9.3"], "en": "increasing my merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:9.4"], "en": "they come to my house.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:10.1"], "en": "The Paṭagas, the Laṭukas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:10.2"], "en": "all the Nigaṇṭhas, the Pupphasāṭakas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:10.3"], "en": "the Tedaṇḍikas, and the Ekasīkhās.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:10.4"], "en": "They come to my house—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:11.1"], "en": "Ājīvakas, plunderers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:11.2"], "en": "those who follow the \"cow-dharma\" and the \"god-dharma.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:11.3"], "en": "Covered in dust and dirt,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:11.4"], "en": "these men come to my house;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:12.1"], "en": "they have arrived with only meager provisions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:12.2", "PA_tha-ap_411:12.3", "PA_tha-ap_411:12.4"], "en": "Many people prone to anger come to my house, as do ascetics who wander in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:13.1"], "en": "The Oḍḍakas and the Damīlas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:13.2"], "en": "the Sākuḷas and the Malavālakas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:13.3"], "en": "the Savaras and the Yonakas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:13.4"], "en": "They come to my house—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:14.1"], "en": "all of them Andhakas and Muṇḍakas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:14.2"], "en": "Koṭalas and Hanuvindas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:14.3", "PA_tha-ap_411:14.4"], "en": "And those from the kingdom of Ārāvacīna come to my house;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:15.1"], "en": "those from Alasanda and those from Pallava.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:15.2"], "en": "Followers of the Dhamma and Nigganthas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:15.3"], "en": "householders and sons of merchants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:15.4"], "en": "come to my house.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:16.1"], "en": "The Mādhurakas, the Kosalakas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:16.2"], "en": "the Kaliṅgas, the Hatthiporikas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:16.3"], "en": "the Isiṇḍas, and the Makkalas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:16.4"], "en": "They come to my house:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:17.1", "PA_tha-ap_411:17.2"], "en": "many Celāvakas, Ārabbhas, Oghuḷhas, and Meghalas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:17.3", "PA_tha-ap_411:17.4"], "en": "Small horses and purebred ones alike come to my house;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:18.1"], "en": "as well as those from Rohaṇa and Sindhava.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:18.2"], "en": "The Citakas and Ekakaṇṇikas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:18.3"], "en": "the Suraṭṭhas and the Aparantas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:18.4"], "en": "come to my house.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:19.1"], "en": "The princes of Suppāraka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:19.2"], "en": "the Mallas of Soṇṇabhūmi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:19.3"], "en": "and all those Vajjians— taṅgas— were there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:19.4"], "en": "They come to my house:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:20.1"], "en": "reed-workers, weavers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:20.2"], "en": "leather-workers, and carpenters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:20.3", "PA_tha-ap_411:20.4"], "en": "Blacksmiths and potters come to my house;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:21.1"], "en": "so too do jewel-workers and metal-smiths.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:21.2"], "en": "Goldsmiths, cloth merchants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:21.3"], "en": "and glass-blowers—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:21.4"], "en": "all of them come to my house.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:22.1"], "en": "Ivory-workers, turners,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:22.2"], "en": "weavers, and perfumers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:22.3"], "en": "dyers and tailors, too.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:22.4"], "en": "They come to my house:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:23.1"], "en": "oil-vendors, wood-gatherers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:23.2"], "en": "water-carriers, and female messengers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:23.3", "PA_tha-ap_411:23.4"], "en": "Soup-makers and soup-wardens come to my house;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:24.1"], "en": "so do gatekeepers and soldiers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:24.2"], "en": "The bandhikas and flower-scavengers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:24.3"], "en": "the elephant-riders and elephant-keepers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:24.4"], "en": "come to my house.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:25.1"], "en": "To King Ānanda,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:25.2", "PA_tha-ap_411:25.3"], "en": "for my sake, I gave a jewel of seven colors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:25.4"], "en": "I shall fulfill what was deficient.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:26.1", "PA_tha-ap_411:26.2"], "en": "All those many people of various complexions whom I have praised—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:26.3"], "en": "Understanding their thoughts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:26.4", "PA_tha-ap_411:27.1"], "en": "I gratified them with jewels while they were speaking in groups.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:27.2", "PA_tha-ap_411:27.3"], "en": "While the drums are being beaten and the conchs are being blown,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:27.4"], "en": "I take my delight in my own home.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:28.1"], "en": "At that time, the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:28.2"], "en": "the Leader Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:28.3"], "en": "together with one hundred thousand masters (vasī), [was present].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:28.4", "PA_tha-ap_411:29.1"], "en": "Accompanied by those bhikkhus whose taints were utterly destroyed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:29.2"], "en": "the Visionary set out upon the road.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:29.3"], "en": "Illuminating all directions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:29.4"], "en": "he shines like a lamp-tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:30.1"], "en": "all the drums resound.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:30.2"], "en": "As the Leader of the World was walking,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:30.3", "PA_tha-ap_411:30.4"], "en": "his radiance shone forth like the risen sun with its hundred rays.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:31.1"], "en": "Even through the gap between door-panels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:31.2"], "en": "and by the ray that has entered;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:31.3"], "en": "within the houses, it is vast.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:31.4"], "en": "There was light at that moment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:32.1"], "en": "Having seen the radiance of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:32.2"], "en": "I spoke to the assembly:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:32.3", "PA_tha-ap_411:32.4"], "en": "\"Without a doubt, the Supreme Buddha has come along this street.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:33.1"], "en": "Quickly descending from the palace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:33.2"], "en": "I went to the marketplace;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:33.3"], "en": "having paid homage to the Perfectly Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:33.4"], "en": "I spoke these words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:34.1"], "en": "\"May the Buddha have compassion for me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:34.2"], "en": "the Leader supreme among those born from the lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:34.3"], "en": "together with his hundred thousand masters.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:34.4"], "en": "The Sage consented.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:35.1"], "en": "Having invited the Perfectly Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:35.2"], "en": "I led him to my own home.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:35.3", "PA_tha-ap_411:35.4"], "en": "There I satisfied the Great Sage with food and drink;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:36.1"], "en": "knowing he had finished his meal, I [waited] for the proper time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:36.2", "PA_tha-ap_411:36.3", "PA_tha-ap_411:36.4"], "en": "With a hundredfold musical instruments, I attended upon the Best of Buddhas, the Neutral One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:37.1"], "en": "Padumuttara, the Knower of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:37.2"], "en": "the recipient of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:37.3"], "en": "sat within the house.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:37.4"], "en": "He spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:38.1", "PA_tha-ap_411:38.2"], "en": "“He who attended upon me with music and gave me food and drink;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:38.3"], "en": "I shall praise him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:38.4"], "en": "listen as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:39.1"], "en": "Having become one who has abundant food,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:39.2"], "en": "Possessing gold and food,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:39.3", "PA_tha-ap_411:39.4"], "en": "this man shall exercise sovereign rule over the four continents.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:40.1"], "en": "Having undertaken the five precepts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:40.2"], "en": "and then the ten courses of action;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:40.3"], "en": "practicing while having undertaken them,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:40.4"], "en": "He will train the assembly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:41.1", "PA_tha-ap_411:41.2"], "en": "There are hundreds of thousands of musical instruments and well-adorned drums.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:41.3"], "en": "I shall always be victorious;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:41.4"], "en": "this is the fruit of my attendance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:42.1"], "en": "For thirty thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:42.2"], "en": "He will delight in the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:42.3", "PA_tha-ap_411:42.4"], "en": "sixty-four times he will exercise sovereignty as a lord of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:43.1"], "en": "Sixty-four times he will be a king,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:43.2"], "en": "a wheel-turning monarch;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:43.3"], "en": "he will possess extensive sovereignty over various regions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:43.4"], "en": "Incalculable by calculation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:44.1"], "en": "In a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:44.2"], "en": "he will be born in the Okkāka clan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:44.3", "PA_tha-ap_411:44.4"], "en": "One named Gotama by clan will become a teacher in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:45.1"], "en": "whatever womb he is reborn into, [he will emerge from it].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:45.2"], "en": "Having enjoyed both divine and human states,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:45.3"], "en": "and possessing full abundance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:45.4"], "en": "he will return to the human realm.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:46.1"], "en": "Having become a reciter,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:46.2"], "en": "one who has mastered the three Vedas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:46.3"], "en": "and seeking the supreme goal—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:46.4"], "en": "He will travel across this earth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:47.1"], "en": "Having later gone forth into homelessness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:47.2"], "en": "urged on by the power of his wholesome roots;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:47.3", "PA_tha-ap_411:47.4"], "en": "He will take delight in the teaching of the Blessed One Gotama;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:48.1"], "en": "having gratified the Perfectly Enlightened One, he will attain his goal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:48.2", "PA_tha-ap_411:48.3"], "en": "“Having extinguished all defilements, this bull of the Sakyas, Gotama,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:48.4"], "en": "will become an Arhat.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:49.1"], "en": "Like the king of tigers in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:49.2"], "en": "like the maned lion, the king of beasts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:49.3"], "en": "we dwell today without fear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:49.4"], "en": "In the teaching of the Son of the Sakyan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:50.1"], "en": "whether in the world of the gods or among humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:50.2"], "en": "or in poverty or in an unfortunate rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:50.3"], "en": "I do not see my own rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:50.4"], "en": "this is the fruit of my attendance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:51.1"], "en": "I am devoted to seclusion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:51.2"], "en": "Tranquil and free from acquisitions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:51.3"], "en": "like a nāga who has severed its bonds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:51.4"], "en": "I dwell without taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:52.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:52.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:52.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:53.1"], "en": "Welcome indeed has come to me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:53.2", "PA_tha-ap_411:53.3"], "en": "… [as above] … the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:54.1", "PA_tha-ap_411:54.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:54.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:55.1"], "en": "Thus indeed the venerable elder Jatukaṇṇī spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_411:56.1"], "en": "This is the ninth legend of the elder Jatukaṇṇī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
