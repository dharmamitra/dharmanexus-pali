[
{"segs": ["PA_ja_326:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:0.2"], "en": "The Collection of Fours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:0.3"], "en": "Chapter on the House-Spoiler (Kuṭidūsakavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:0.4"], "en": "6. The Kakkāru Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:1.1", "PA_ja_326:1.2"], "en": "“He who would not take by way of the body, nor speak falsehood by way of speech;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:1.3"], "en": "Having gained fame, one should not become intoxicated;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:1.4"], "en": "such a person indeed deserves the *kakkāru* punishment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:2.1"], "en": "One should acquire wealth through righteousness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:2.2"], "en": "One should not take wealth by deceit;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:2.3"], "en": "having obtained enjoyments, one should not become intoxicated;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:2.4"], "en": "such a person indeed deserves the gallows.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:3.1", "PA_ja_326:3.2"], "en": "“One whose mind is not greedy and whose faith does not waver—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:3.3"], "en": "such a person should not eat delicious food alone.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:3.4"], "en": "He indeed deserves the *kakkāru* fruit:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:4.1"], "en": "\"Whether face-to-face or behind one's back,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:4.2"], "en": "he who does not revile those who are virtuous.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:4.3", "PA_ja_326:4.4"], "en": "\"One who acts as they speak is indeed worthy of praise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_326:5.1"], "en": "Thus ends the sixth Jātaka, the Kakkāru-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
