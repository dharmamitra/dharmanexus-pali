[
{"segs": ["PA_vv_51:0.1", "PA_vv_51:0.2"], "en": "Vimānavatthu: The Mansion of the Man,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:0.3"], "en": "Chapter on the Great Chariot (Mahārathavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:0.4", "PA_vv_51:1.1"], "en": "1. The Story of the Celestial Mansion of the Devaputta Maṇḍūka “Who is it that worships my feet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:1.2"], "en": "shining with supernatural power and glory?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:1.3", "PA_vv_51:1.4"], "en": "\"With a most excellent complexion, illuminating all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:2.1"], "en": "\"Formerly, I was a frog; [I am now a deva named Maṇikaṇṭha].\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:2.2"], "en": "While you were in the water,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:2.3", "PA_vv_51:2.4"], "en": "feeding on its contents, a cowherd killed you as you were listening to the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:3.1", "PA_vv_51:3.2"], "en": "Behold for a moment the success and the glory resulting from my clarity of mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:3.3"], "en": "behold also my majestic power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:3.4"], "en": "Behold my complexion and my radiance!", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:4.1"], "en": "And those who, throughout the long course of time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:4.2"], "en": "have heard the Dhamma from Gotama;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:4.3"], "en": "\"You have reached that immovable state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:4.4"], "en": "having gone to which you shall no longer grieve.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_51:5.1"], "en": "Thus ends the first Vimāna, the Maṇḍūkadevaputta-vimāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"}
]
