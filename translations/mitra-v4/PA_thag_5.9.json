[
{"segs": ["PA_thag_5.9:0.1", "PA_thag_5.9:0.2", "PA_thag_5.9:0.3"], "en": "Theragāthā 5.9 Pañcakanipāta First Chapter (Paṭhamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:0.4"], "en": "Vijitasena Thera’s Verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:1.1"], "en": "“I shall restrain your mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:1.2"], "en": "as one restrains an elephant at the gate of its stall.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:1.3"], "en": "I will not employ you in evil,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:1.4"], "en": "you web of desire born of the body;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:2.1"], "en": "clinging to me, you do not go away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:2.2"], "en": "Like an elephant that cannot find the opening of a door,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:2.3"], "en": "you shall not, O evil-minded one,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:2.4"], "en": "continue to advance and wander about delighting in wickedness again and again.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:3.1", "PA_thag_5.9:3.2"], "en": "Just as a strong elephant-trainer with a goad-hook turns back a wild, untamed elephant against its will,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:3.3"], "en": "so does the wise man turn back the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:3.4"], "en": "In this way I shall turn you back,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:4.1", "PA_thag_5.9:4.2"], "en": "just as an excellent charioteer, skilled in taming noble steeds, tames a thoroughbred.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:4.3"], "en": "Thus will I tame you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:4.4"], "en": "established in the five powers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:5.1"], "en": "I shall bind you with mindfulness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:5.2"], "en": "\"I shall give you discipline;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:5.3"], "en": "held by the yoke of energy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:5.4"], "en": "O mind, you shall not go far from here.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.9:5.5"], "en": "… the elder Vijitasena …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
