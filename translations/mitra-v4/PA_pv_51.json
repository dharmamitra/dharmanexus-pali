[
{"segs": ["PA_pv_51:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:0.2"], "en": "Mahāvagga 16.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:0.3"], "en": "The Story of the Ghost with Sixty Peaks (Saṭṭhikūṭapetavatthu)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:1.1"], "en": "\"Why do you run about like one who is mad,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:1.2"], "en": "like a bewildered deer?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:1.3"], "en": "Without a doubt, you are one of evil deeds.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:1.4"], "en": "\"Why do you cry out? \"I am a peta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:2.1", "PA_pv_51:2.2"], "en": "venerable sir, one who has gone to a miserable state in the world of Yama.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:2.3"], "en": "Having committed an evil deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:2.4"], "en": "he has gone from here to the world of the departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:3.1"], "en": "Sixty thousand peaks—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:3.2"], "en": "They are entirely complete;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:3.3", "PA_pv_51:3.4"], "en": "they fall upon my head and pierce through my skull.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:4.1", "PA_pv_51:4.2"], "en": "“What evil deed have you committed by body, speech, or mind?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:4.3"], "en": "Through the ripening of what karma...?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:4.4"], "en": "Thus you undergo this suffering:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:5.1"], "en": "sixty thousand peaks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:5.2"], "en": "complete in every respect.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:5.3", "PA_pv_51:5.4"], "en": "“They fall upon your head and pierce through your skull.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:6.1"], "en": "Then I saw the Perfectly Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:6.2"], "en": "With beautiful eyes and developed faculties,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:6.3"], "en": "he sat at the foot of a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:6.4"], "en": "meditating, free from fear from any quarter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:7.1"], "en": "By the blow of a salt-grain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:7.2", "PA_pv_51:7.3"], "en": "I shall split his head; through the ripening of that karma, [I shall experience the result].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:7.4"], "en": "I shall undergo this suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:8.1"], "en": "Sixty thousand peaks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:8.2"], "en": "complete in every respect;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:8.3", "PA_pv_51:8.4"], "en": "“They fall upon my head and they pierce my skull.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:9.1"], "en": "“By right, O base man,” [he said].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:9.2"], "en": "Sixty thousand peaks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:9.3"], "en": "completely full in every way,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:9.4"], "en": "fall down upon your head.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:9.5"], "en": "\"And they split open their skulls.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:10.1"], "en": "This is the sixteenth story, the *Ṣaṣṭikūṭa-petavatthu*.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:11.1"], "en": "The fourth Great Chapter (*Mahāvagga*) is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:12.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:13.1"], "en": "Ambasakkara, Serīsaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:13.2"], "en": "Piṅgala, Revatī, and Ucchu.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:13.3"], "en": "Two princes, two kinds of dung,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:13.4", "PA_pv_51:14.1"], "en": "the Gaṇa, Pāṭali, and Amba groves; the letters, the tree, the enjoyment, and the withdrawal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:14.2"], "en": "The merchant’s son and the sixty peaks;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:14.3", "PA_pv_51:14.4"], "en": "thus these sixteen topics are called a chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:15.1"], "en": "Now, the summary of the chapters:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:16.1"], "en": "the Uraga Chapter and the Upari Chapter;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:16.2"], "en": "the Cūḷa and Mahā [Chapters]—thus it is fourfold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:16.3"], "en": "There are fifty-one stories,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:16.4"], "en": "divided into four recitation sections.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_51:17.1"], "en": "The Peta-vatthu-pāḷi is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
