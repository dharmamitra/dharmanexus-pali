[
{"segs": ["PA_ja_267:0.1", "PA_ja_267:0.2", "PA_ja_267:0.3"], "en": "Jātaka Tikanipāta, Padumavagga (The Lotus Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_267:0.4"], "en": "7. The Kakkhaṭaka Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_267:1.1", "PA_ja_267:1.2"], "en": "“The horned deer, with long eyes and pupils, bone-skinned, water-dwelling, and hairless;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_267:1.3"], "en": "\"Overwhelmed by him, I weep piteously;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_267:1.4"], "en": "do not indeed abandon me, who am as dear to you as life itself.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_267:2.1"], "en": "\"Noble lady, I shall not abandon you.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_267:2.2"], "en": "An elephant sixty years of age;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_267:2.3", "PA_ja_267:2.4"], "en": "you, Suppiya, were mine for the entire earth bounded by its four oceans.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_267:3.1"], "en": "“Of all the crabs in the ocean,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_267:3.2"], "en": "in the Ganges, and in the Yamunā—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_267:3.3"], "en": "you are the best among those born of water.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_267:3.4"], "en": "\"Release the husband of her who weeps.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_267:4.1"], "en": "Thus ends the seventh Jātaka, the Kakkaṭaka-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
