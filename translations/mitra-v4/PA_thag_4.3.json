[
{"segs": ["PA_thag_4.3:0.1", "PA_thag_4.3:0.2", "PA_thag_4.3:0.3"], "en": "Theragāthā 4.3 Catukkanipāta Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:0.4"], "en": "Sabhiya Thera’s Verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:1.1", "PA_thag_4.3:1.2"], "en": "“Others do not understand that we here are exercising self-restraint.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:1.3"], "en": "And those who understand therein,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:1.4"], "en": "from that their disputes are stilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:2.1"], "en": "but when they do not understand—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:2.2"], "en": "They move about like the immortals;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:2.3", "PA_thag_4.3:2.4"], "en": "they who understand the Dhamma remain undistressed amidst those who are distressed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:3.1"], "en": "Whatever action is lax,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:3.2"], "en": "whatever vow is defiled,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:3.3"], "en": "and the holy life that is dubious—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:3.4", "PA_thag_4.3:4.1", "PA_thag_4.3:4.2"], "en": "That is not of great fruit for one in whom reverence toward fellow practitioners of the holy life is not found.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:4.3"], "en": "“He is far from the true Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:4.4"], "en": "as the sky is from the earth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.3:4.5"], "en": "… Thus spoke the elder Sabhiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
