[
{"segs": ["PA_thi-ap_18:0.1", "PA_thi-ap_18:0.2"], "en": "Therī-apadāna Ekūposathika-vagga 8.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:0.3"], "en": "The Apadāna of the Elder Nun Khemā", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:1.2"], "en": "the one with vision regarding all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:1.3"], "en": "[appeared] one hundred thousand aeons hence.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:1.4"], "en": "The Leader appeared in that eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:2.1"], "en": "At that time, I was born in Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:2.2"], "en": "having been born into a family of merchants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:2.3"], "en": "Blazing with various jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:2.4"], "en": "endowed with great bliss,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:3.1"], "en": "they approached that Great Hero.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:3.2"], "en": "I heard the teaching of the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:3.3"], "en": "then, with faith born within me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:3.4"], "en": "I went for refuge to the Victor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:4.1"], "en": "Having requested my mother and father,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:4.2", "PA_thi-ap_18:4.3"], "en": "and having invited the Guide for seven days, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:4.4"], "en": "I fed him along with his retinue of disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:5.1"], "en": "And when seven days had passed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:5.2"], "en": "[I honored] the one supreme among those of great wisdom;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:5.3", "PA_thi-ap_18:5.4"], "en": "The Charioteer of Men placed that bhikkhunī at the very forefront;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:6.1"], "en": "having heard this, they became joyful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:6.2", "PA_thi-ap_18:6.3"], "en": "Again, having performed that service for the Great Seer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:6.4"], "en": "I prostrated myself and made a solemn aspiration.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:7.1"], "en": "Then the Jina said to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:7.2"], "en": "“Your aspiration shall be fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:7.3"], "en": "you have performed service for me together with the Saṅgha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:7.4"], "en": "The fruit of your [offering] is immeasurable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:8.1"], "en": "One hundred thousand eons hence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:8.2"], "en": "you will be born into the Okkāka clan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:8.3", "PA_thi-ap_18:8.4"], "en": "One named Gotama by clan will become a teacher in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:9.1"], "en": "he will have heirs in his teachings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:9.2", "PA_thi-ap_18:9.3"], "en": "“Born from her own breast, fashioned by Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:9.4"], "en": "she shall attain this supreme state and be known as Khemā.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:10.1", "PA_thi-ap_18:10.2"], "en": "By that well-performed kamma and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:10.3"], "en": "having cast off this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:10.4"], "en": "I went to the realm of the Thirty-three;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:11.1"], "en": "passing away from there, I went to Yāma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:11.2"], "en": "and from there I went to Tusita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:11.3"], "en": "And from there, to Nimmānarati,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:11.4"], "en": "and from there to Vasavatti’s city;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:12.1"], "en": "wherever I am reborn, [there I go].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:12.2"], "en": "By the power of that deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:12.3", "PA_thi-ap_18:12.4"], "en": "in various places I served as the chief queen to kings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:13.1"], "en": "Then, passing away from the human state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:13.2"], "en": "[they are reborn] among universal monarchs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:13.3"], "en": "regional kings, and local rulers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:13.4"], "en": "I exercised supreme sovereignty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:14.1", "PA_thi-ap_18:14.2"], "en": "Having experienced prosperity among both gods and humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:14.3"], "en": "Having been happy everywhere,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:14.4"], "en": "I wandered through many eons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:15.1"], "en": "Ninety-one eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:15.2"], "en": "Vipassī, the leader of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:15.3"], "en": "arose— beautiful to behold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:15.4"], "en": "possessing insight into all phenomena.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:16.1", "PA_thi-ap_18:16.2"], "en": "Having approached that Leader of the World, the Charioteer of Men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:16.3"], "en": "and having heard the Dhamma spoken, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:16.4"], "en": "I went forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:17.1"], "en": "For ten thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:17.2"], "en": "under the teaching of that Hero;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:17.3"], "en": "Having practiced the holy life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:17.4"], "en": "being disciplined in yoga and learned,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:18.1"], "en": "they are skilled in the nature of conditions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:18.2"], "en": "Confident in the Four Truths,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:18.3"], "en": "skilled in discourse on the mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:18.4"], "en": "they carry out the Teacher’s instruction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:19.1"], "en": "Having passed away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:19.2"], "en": "I was reborn in the Tusita heaven,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:19.3"], "en": "illustrious; there I surpassed all others.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:19.4"], "en": "By the fruit of my life as a celibate student,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:20.1"], "en": "wherever I am reborn,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:20.2"], "en": "may I possess great wealth and great riches.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:20.3"], "en": "I shall be wise and beautiful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:20.4"], "en": "and my retinue shall be well-disciplined;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:21.1"], "en": "by that kamma, I shall become so.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:21.2"], "en": "Through yoga in the teaching of the Jina,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:21.3", "PA_thi-ap_18:21.4"], "en": "all prosperities dear to my heart have become easy for me to obtain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:22.1"], "en": "Whosoever may be my husband,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:22.2"], "en": "wherever I may go,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:22.3"], "en": "no one shall ever treat me with contempt.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:22.4"], "en": "By the power of my practice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:23.1"], "en": "in this auspicious aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:23.2"], "en": "I was a highly renowned kinsman of Brahmā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:23.3"], "en": "By name Koṇāgamana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:23.4"], "en": "the best among those who speak, arose;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:24.1"], "en": "at that time, in Bārāṇasī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:24.2"], "en": "Susamiddha, Kulappajā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:24.3"], "en": "Dhanañjānī, Sumedhā, and I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:24.4"], "en": "these three persons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:25.1", "PA_thi-ap_18:25.2"], "en": "In the past, I was a female donor who assisted in giving at the monastery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:25.3"], "en": "I also gave a dwelling for the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:25.4"], "en": "We were those who acted for his sake.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:26.1"], "en": "Having passed away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:26.2"], "en": "we all went to the Tāvatiṃsa heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:26.3", "PA_thi-ap_18:26.4"], "en": "She attained preeminence in fame among humans as well; indeed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:27.1"], "en": "within this very eon—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:27.2"], "en": "A kinsman of Brahmā, of great renown,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:27.3"], "en": "named Kassapa by clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:27.4"], "en": "arose as the best among those who speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:28.1", "PA_thi-ap_18:28.2", "PA_thi-ap_18:28.3"], "en": "At that time, the lord of men, the King of Kāsi named Kikī, was the attendant of the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:28.4"], "en": "In the supreme city of Vārāṇasī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:29.1"], "en": "I was his eldest daughter,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:29.2"], "en": "renowned as a female ascetic (samaṇī).", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:29.3"], "en": "Having heard the Dhamma from the Conqueror’s chief,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:29.4"], "en": "I resolved upon going forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:30.1"], "en": "yet our father did not grant us permission.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:30.2", "PA_thi-ap_18:30.3", "PA_thi-ap_18:30.4"], "en": "At that time, we wandered tirelessly for twenty thousand years, as if within a house.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:31.1", "PA_thi-ap_18:31.2"], "en": "A princess raised in luxury, devoted to serving the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:31.3"], "en": "lived the celibate life of a maiden.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:31.4"], "en": "Muditā had seven daughters:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:32.1", "PA_thi-ap_18:32.2"], "en": "Samaṇī, Samaṇaguttā, Bhikkhunī, and Bhikkhudāyikā; [and three others].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:32.3"], "en": "Dhammā and Sudhammā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:32.4"], "en": "and Saṅghadāyikā as the seventh;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:33.1"], "en": "myself and Uppalavaṇṇā—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:33.2"], "en": "Paṭācārā and Kuṇḍalā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:33.3"], "en": "Kisāgotamī, Dhammadinnā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:33.4"], "en": "and Visākhā is the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:34.1", "PA_thi-ap_18:34.2"], "en": "Once that Sun among Men taught the wonderful Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:34.3"], "en": "the Mahānidāna Sutta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:34.4"], "en": "Having heard it, I mastered it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:35.1", "PA_thi-ap_18:35.2"], "en": "By those well-performed deeds and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:35.3"], "en": "Having cast off the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:35.4"], "en": "I went to the realm of the Thirty-three;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:36.1"], "en": "and now, in this final existence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:36.2"], "en": "To Sākala, the most excellent city;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:36.3"], "en": "I am the daughter of King Madda,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:36.4"], "en": "pleasing, beloved, and dear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:37.1"], "en": "As soon as I was born,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:37.2"], "en": "that city became secure;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:37.3"], "en": "therefore, my name was Khema.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:37.4"], "en": "Be reborn according to your virtues.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:38.1"], "en": "When I had reached youth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:38.2"], "en": "adorned with beauty and charm;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:38.3", "PA_thi-ap_18:38.4"], "en": "Then my father gave me to King Bimbisāra;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:39.1"], "en": "I was his beloved Suppiyā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:39.2"], "en": "Delighting in the wearing of ornaments and in bathing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:39.3", "PA_thi-ap_18:39.4"], "en": "I did not approach that Greatly Compassionate One, who spoke of the defects of forms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:40.1"], "en": "Then King Bimbisāra,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:40.2"], "en": "with the intention of favoring me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:40.3"], "en": "having praised Veḷuvana, [gave it to me].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:40.4"], "en": "He had me sing to the singer:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:41.1"], "en": "\"By whom the delightful Bamboo Grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:41.2"], "en": "the abode of the Sugata, has not been seen;\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:41.3", "PA_thi-ap_18:41.4", "PA_thi-ap_18:42.1"], "en": "We consider that by him who has seen Veḷuvana, the Nandana Grove has been seen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:42.2"], "en": "The delighter of the delighters of men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:42.3"], "en": "well-seen is that delight,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:42.4"], "en": "the excellent joy of the lord of the immortals.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:43.1"], "en": "Leaving the Nandana grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:43.2"], "en": "the gods descended to the surface of the earth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:43.3"], "en": "seeing the delightful Veḷuvana, they [arrived].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:43.4"], "en": "They do not burn, being well-purified.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:44.1", "PA_thi-ap_18:44.2"], "en": "It is produced by the merit of kings and adorned by the merit of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:44.3", "PA_thi-ap_18:44.4"], "en": "Who can describe the entirety of that forest’s accumulation of virtues?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:45.1"], "en": "Having heard of that flourishing grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:45.2", "PA_thi-ap_18:45.3"], "en": "Desiring to see that garden which was so pleasing to my ear,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:45.4"], "en": "I then informed the king.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:46.1", "PA_thi-ap_18:46.2"], "en": "Then that lord of the earth, with a great retinue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:46.3"], "en": "sent me to that garden.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:46.4", "PA_thi-ap_18:47.1", "PA_thi-ap_18:47.2"], "en": "“Go and see for yourself that forest, which is full of great splendor and is an elixir for the eyes.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:47.3"], "en": "\"That which always shines with splendor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:47.4"], "en": "colored by the radiance of the Sugata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:48.1"], "en": "And when the Sage, for alms, [went forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:48.2"], "en": "I entered Giribbaja, the supreme city,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:48.3"], "en": "and at that very moment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:48.4"], "en": "I approached the forest to see it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:49.1", "PA_thi-ap_18:49.2", "PA_thi-ap_18:49.3"], "en": "Then, that forest in full bloom, resounding with the warbling of various bees and accompanied by the songs of cuckoos—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:49.4"], "en": "Danced upon by flocks of peacocks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:50.1"], "en": "quiet and uncrowded,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:50.2"], "en": "adorned with various walking-paths;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:50.3", "PA_thi-ap_18:50.4"], "en": "Crowded with small pavilions and graced by the most excellent of yogis,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:51.1"], "en": "as I wandered there, I thought:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:51.2"], "en": "“‘My eyes have borne fruit!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:51.3", "PA_thi-ap_18:51.4"], "en": "Thinking thus, I saw a young bhikkhu there who was well-suited [to my purpose].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:52.1"], "en": "“Standing here in such a delightful forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:52.2"], "en": "in the prime of youth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:52.3"], "en": "like a springtime flower with its beloved...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:52.4"], "en": "Endowed with beauty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:53.1"], "en": "seated at the foot of a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:53.2"], "en": "shaven-headed and clad in the outer robe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:53.3"], "en": "This bhikkhu indeed meditates,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:53.4"], "en": "having abandoned the delight born of sense objects.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:54.1"], "en": "Is it not so for one who is a householder?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:54.2"], "en": "Having enjoyed sensual pleasures as you wish,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:54.3", "PA_thi-ap_18:54.4"], "en": "this Dhamma should later be practiced by one who is aged, Subhadda.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:55.1", "PA_thi-ap_18:55.2"], "en": "Having understood it as \"empty,\" yet [knowing] the \"fragrant house\" is the abode of the Victor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:55.3"], "en": "I approached and beheld the Victor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:55.4"], "en": "Like the rising sun,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:56.1"], "en": "he sat alone in happiness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:56.2"], "en": "being fanned by a beautiful woman.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:56.3"], "en": "Having seen him, I thought thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:56.4"], "en": "\"This bull among men is not coarse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:57.1"], "en": "That maiden, with a golden radiance...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:57.2"], "en": "Her face and eyes are like lotuses;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:57.3"], "en": "her lips are like the bimba fruit and her teeth are like jasmine;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:57.4"], "en": "she is a nectar for the eyes of the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:58.1"], "en": "Her forest-like groins have the luster of gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:58.2"], "en": "her breasts have the shape of buds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:58.3"], "en": "and her hips are well-formed like the middle of a sacrificial altar.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:58.4"], "en": "With thighs like plantain stalks and beautiful ornaments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:59.1", "PA_thi-ap_18:59.2"], "en": "she was clothed in a red silk upper garment and a smooth blue lower robe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:59.3", "PA_thi-ap_18:59.4"], "en": "Possessing a form beyond reproach and endowed with a joyful disposition—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:60.1"], "en": "seeing her, I thought thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:60.2"], "en": "‘Oh, how beautiful she is!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:60.3", "PA_thi-ap_18:60.4"], "en": "Never before have I seen her with these eyes.’", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:61.1"], "en": "Then, overcome by old age,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:61.2"], "en": "she was discolored and with a distorted face;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:61.3"], "en": "her teeth were broken and her hair was white.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:61.4"], "en": "With saliva and impurity from her mouth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:62.1"], "en": "with ears tucked back and white eyes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:62.2"], "en": "she has large and unattractive breasts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:62.3"], "en": "With all her limbs covered by a creeper,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:62.4"], "en": "her body spread with veins,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:63.1"], "en": "she moved with bent limbs, the staff being her only companion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:63.2"], "en": "Emaciated with protruding ribs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:63.3"], "en": "she fell trembling,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:63.4"], "en": "gasping again and again.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:64.1"], "en": "Then a sense of urgency arose within me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:64.2"], "en": "extraordinary and hair-raising:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:64.3"], "en": "\"Fie on this impure form!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:64.4"], "en": "Wherein the foolish take their delight—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:65.1"], "en": "then the Greatly Compassionate One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:65.2"], "en": "seeing him with a mind full of agitation, [spoke].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:65.3"], "en": "With an uplifted mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:65.4"], "en": "the Sugata spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:66.1"], "en": "“[Behold] the diseased, impure, and putrid...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:66.2"], "en": "Behold, Khema, this heap of filth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:66.3"], "en": "oozing and trickling,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:66.4"], "en": "which fools delight in.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:67.1"], "en": "Develop the mind through foulness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:67.2"], "en": "one-pointed and well-concentrated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:67.3"], "en": "let mindfulness directed to the body be yours.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:67.4"], "en": "Abide with abundant disenchantment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:68.1", "PA_thi-ap_18:68.2"], "en": "As this is, so is that; as that is, so is this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:68.3"], "en": "Within and without,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:68.4"], "en": "cause desire for the body to fade away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:69.1"], "en": "cultivate the signless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:69.2"], "en": "Abandon the underlying tendency to conceit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:69.3"], "en": "then, through the full comprehension of conceit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:69.4"], "en": "you will wander at peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:70.1"], "en": "Those who are stained by passion follow the stream,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:70.2"], "en": "like a spider following the web it has spun itself;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:70.3"], "en": "having cut even this asunder, they go forth as wanderers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:70.4"], "en": "\"Free from longing, having abandoned sensual pleasure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:71.1"], "en": "Then, knowing that my mind was ready,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:71.2"], "en": "the Charioteer of Men—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:71.3", "PA_thi-ap_18:71.4"], "en": "He taught the Mahānidāna Sutta for my training in the Vinaya;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:72.1"], "en": "having heard that most excellent of discourses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:72.2"], "en": "I recollected my former perceptions;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:72.3"], "en": "abiding there in peace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:72.4"], "en": "I purified the Dhamma-eye.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:73.1", "PA_thi-ap_18:73.2"], "en": "Having then fallen at the feet of the Great Seer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:73.3"], "en": "for the purpose of confessing his transgression,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:73.4"], "en": "I spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:74.1"], "en": "“Homage to you, O All-Seeing One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:74.2"], "en": "homage to you, O Maker of Compassion.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:74.3"], "en": "Homage to you who have crossed over saṃsāra;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:74.4"], "en": "homage to you, the giver of the deathless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:75.1"], "en": "Those who have plunged into the thicket of views—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:75.2", "PA_thi-ap_18:75.3"], "en": "Deluded by sensual desire, they were properly disciplined by her through skillful means,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:75.4"], "en": "becoming devoted to the discipline.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:76.1", "PA_thi-ap_18:76.2"], "en": "Through failing to see such great seers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:76.3"], "en": "people suffer great misery when their possessions are lost.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:76.4"], "en": "Beings in the ocean of saṃsāra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:77.1"], "en": "When I [attain] the refuge of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:77.2"], "en": "the one free from conflict who has reached the end of conflict;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:77.3"], "en": "I did not see you standing nearby;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:77.4"], "en": "I confess that transgression to you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:78.1"], "en": "the giver of boons and the great benefactor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:78.2"], "en": "Fearing it as harmful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:78.3"], "en": "I did not approach those who delight in form;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:78.4"], "en": "I confess that transgression.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:79.1", "PA_thi-ap_18:79.2"], "en": "Then the Conqueror, the Greatly Compassionate One, with a sweet voice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:79.3"], "en": "said: \"Stay, O you who are secure!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:79.4"], "en": "Sprinkling me with the Deathless,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:80.1", "PA_thi-ap_18:80.2"], "en": "I then bowed my head in homage and circumambulated him three times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:80.3"], "en": "Having gone and seen the lord of men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:80.4"], "en": "I spoke these words: \"O,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:81.1"], "en": "how excellent is your stratagem!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:81.2"], "en": "O subduer of enemies, this was what she thought:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:81.3", "PA_thi-ap_18:81.4"], "en": "\"The Sage has been seen by me, who desired to see the forest, as being like Nirvana.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:82.1"], "en": "If it pleases you, O King,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:82.2", "PA_thi-ap_18:82.3"], "en": "I shall go forth in the form of a monk within the teaching of that Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:82.4"], "en": "Disgusted by the words of the Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:83.1"], "en": "[End of] the second recitation section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:84.1"], "en": "Having raised their joined palms in reverence...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:84.2"], "en": "Then that lord of the earth said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:84.3"], "en": "“I grant you permission, blessed lady;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:84.4"], "en": "may your going forth be successful.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:85.1"], "en": "Then, having gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:85.2"], "en": "when half a month had passed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:85.3"], "en": "[I saw] both the rising of the island and its dissolution.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:85.4"], "en": "Having seen this, their minds were filled with agitation;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:86.1"], "en": "they became weary of all conditioned phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:86.2"], "en": "being skilled in the nature of causal conditions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:86.3"], "en": "Having transcended the four floods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:86.4"], "en": "I attained arahantship;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:87.1"], "en": "I became masterful in the supernormal powers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:87.2"], "en": "With the divine ear-element,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:87.3", "PA_thi-ap_18:87.4"], "en": "and I am also a master of the knowledge of others' minds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:88.1"], "en": "I know my former abodes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:88.2"], "en": "the divine eye is purified,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:88.3"], "en": "and all taints are utterly destroyed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:88.4"], "en": "Now there is no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:89.1"], "en": "Regarding the meaning, the Dhamma, the grammar,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:89.2"], "en": "and likewise regarding inspired eloquence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:89.3"], "en": "My knowledge is completely pure,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:89.4"], "en": "having arisen within the Buddha’s teaching;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:90.1"], "en": "I am skilled in the purifications.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:90.2", "PA_thi-ap_18:90.3"], "en": "Skilled in the Kathāvatthu and knowing the methods of the Abhidhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:90.4"], "en": "I have attained mastery in the Teaching.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:91.1"], "en": "Then, at the site of the gateway,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:91.2"], "en": "the King, the Lord of Kosala,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:91.3"], "en": "questioned them with subtle questions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:91.4"], "en": "Explaining it exactly as it is,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:92.1", "PA_thi-ap_18:92.2"], "en": "the king then approached the Sugata and questioned him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:92.3"], "en": "In that very way the Buddha declared,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:92.4"], "en": "just as they were declared by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:93.1"], "en": "The Victor was pleased with that quality.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:93.2", "PA_thi-ap_18:93.3", "PA_thi-ap_18:93.4"], "en": "The Supreme among Men placed me at the head of those with great wisdom among the bhikkhunīs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:94.1"], "en": "The defilements have been incinerated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:94.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:94.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:95.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:95.2", "PA_thi-ap_18:95.3"], "en": "[and so on] ...the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:96.1", "PA_thi-ap_18:96.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:96.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:97.1"], "en": "Thus indeed did the bhikkhunī Khemā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_18:98.1"], "en": "This is the eighth legend of the Elder Nun Khemā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
