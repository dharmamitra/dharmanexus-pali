[
{"segs": ["PA_tha-ap_400:0.1", "PA_tha-ap_400:0.2", "PA_tha-ap_400:0.3"], "en": "The Legend of the Elder Saḷalamaṇḍapiya From the Pilindavaccha Chapter of the Therāpadāna, the Eighth Legend.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:1.1", "PA_tha-ap_400:1.2"], "en": "“When Kakusandha, the brahmin of consummate conduct, had attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:1.3"], "en": "[I] took a *saḷala* flower garland— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:1.4"], "en": "I had a pavilion constructed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:2.1"], "en": "Having gone to the Realm of the Thirty-three,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:2.2"], "en": "I obtained a supreme celestial mansion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:2.3"], "en": "I shine forth among other gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:2.4"], "en": "this is the fruit of meritorious deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:3.1"], "en": "whether by day or by night.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:3.2"], "en": "Whether walking or standing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:3.3"], "en": "I am covered with *saḷala* flowers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:3.4"], "en": "this is the fruit of meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:4.1"], "en": "In this very eon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:4.2"], "en": "because I worshipped the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:4.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:4.4"], "en": "This is the fruit of worshiping the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:5.1", "PA_tha-ap_400:5.2"], "en": "the defilements have been incinerated by me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:5.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:6.1", "PA_tha-ap_400:6.2"], "en": "Welcome indeed has come to me... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:6.3"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:7.1", "PA_tha-ap_400:7.2"], "en": "the four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:7.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:8.1"], "en": "Thus indeed did the venerable elder Saḷalamaṇḍapiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_400:9.1"], "en": "This is the eighth apadāna of the elder Saḷalamaṇḍapiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
