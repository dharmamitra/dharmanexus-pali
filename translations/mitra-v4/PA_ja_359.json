[
{"segs": ["PA_ja_359:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:0.2"], "en": "The Fifth Chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:0.3"], "en": "the Section on the Jeweled Earrings (Maṇikuṇḍalavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:0.4", "PA_ja_359:1.1"], "en": "9. The Suvaṇṇamiga Jātaka “Step back, O golden-footed one!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:1.2"], "en": "Step back, O great deer!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:1.3"], "en": "“Cut the snare of Vārattaka;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:1.4"], "en": "I do not delight in being alone in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:2.1"], "en": "“I am struggling, I cannot prevail;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:2.2"], "en": "\"I am digging up the ground with great force;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:2.3", "PA_ja_359:2.4"], "en": "the firm Vārattika snare is gnawing at my foot.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:3.1"], "en": "“Spread out the leaves,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:3.2"], "en": "hunter, draw forth the sword;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:3.3"], "en": "having first struck me down, [then strike the deer].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:3.4"], "en": "“Kill the great deer afterwards.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:4.1", "PA_ja_359:4.2"], "en": "“I have never heard or seen a human female deer speaking thus;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:4.3"], "en": "“May you also be happy, O Bhaddā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:4.4"], "en": "as well as this great deer.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:5.1"], "en": "“Thus, hunter, may you rejoice!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:5.2"], "en": "Together with all my kinsmen;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:5.3"], "en": "just as I rejoice today,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:5.4"], "en": "having seen the great deer set free.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_359:6.1"], "en": "The Ninth: The Suvaṇṇamiga Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
