[
{"segs": ["PA_ja_288:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_288:0.2", "PA_ja_288:0.3"], "en": "The Collection of Threes, Chapter on the Internal (Abbhantaravagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_288:0.4", "PA_ja_288:1.1"], "en": "8. The Fish-Donation Jātaka “Fish are worth more than a thousand [pieces of gold];", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_288:1.2"], "en": "there is no one who would believe this.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_288:1.3"], "en": "\"And may I have seven months here;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_288:1.4"], "en": "I too would buy that fish-flesh.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_288:2.1"], "en": "\"Having given food to the fish,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_288:2.2", "PA_ja_288:2.3"], "en": "You assigned me as the recipient of that offering; remembering that gift,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_288:2.4"], "en": "you have rendered me this honor.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_288:3.1"], "en": "“For one with a corrupt mind there is no prosperity,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_288:3.2"], "en": "nor do the deities honor him—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_288:3.3"], "en": "[he who] [seizes] his paternal brother’s inherited property.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_288:3.4"], "en": "“The doer of evil deeds has deceived me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_288:4.1"], "en": "Thus ends the eighth Jātaka, the Fish-Eating Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
