{"segs": ["PA_ja_43:0.2", "PA_ja_43:0.3"], "en": "Ekakanipāta, Atthakāmavagga (The Chapter on Those Who Desire Welfare)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_43:0.4"], "en": "3. The Veḷuka Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
