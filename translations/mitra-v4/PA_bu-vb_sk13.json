[
{"segs": ["PA_bu-vb_sk13:0.1"], "en": "The Theravāda Vinaya Mahāvibhaṅga:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:0.2", "PA_bu-vb_sk13:0.3"], "en": "The Section on the Training Rules (Sekhiyakaṇḍa)", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:0.4"], "en": "Ujjagghikavagga 13.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:0.5"], "en": "The Training Rule on Loud Voices.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:1.1"], "en": "At that time, the Buddha, the Blessed One, was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:1.2"], "en": "Now at that time, the group-of-six monks were walking through inhabited areas making loud noises and great clamor... [omission].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:1.3.1"], "en": "\"The training is to be observed: 'I shall walk through inhabited areas making little noise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:1.4"], "en": "One should walk through inhabited areas with little noise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:1.5"], "en": "Whoever, out of disrespect, goes through an inhabited area making loud noises and a great clamor, commits an offense of wrong-doing (dukkaṭa).", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:1.6.1", "PA_bu-vb_sk13:1.7"], "en": "There is no offense if it was unintentional.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:1.8"], "en": "For one who is lacking mindfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:1.9"], "en": "for one who is unaware,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:1.10"], "en": "and for one who is ill.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:1.11"], "en": "In times of distress,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:1.12"], "en": "for one who is insane,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:1.13"], "en": "and for the first offender.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk13:1.14"], "en": "The third training rule is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
