{"segs": ["PA_ja_292:0.2", "PA_ja_292:0.3"], "en": "The Third Collection, The Chapter on the Water-Jar (Kumbhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_292:0.4"], "en": "2. The Supatta Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_292:1.1", "PA_ja_292:1.2"], "en": "“In Benares, O Great King, there lived a king of crows;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_292:1.3"], "en": "Surrounded by eighty thousand followers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_292:1.4"], "en": "Supatta was well-attended.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_292:2.1"], "en": "His wife was pregnant with longing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_292:2.2", "PA_ja_292:2.3"], "en": "He desires to eat the food cooked in the king’s kitchen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_292:2.4"], "en": "that most precious meal fit for a king.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_292:3.1"], "en": "Sent as their messenger,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_292:3.2"], "en": "I have come here from the king;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_292:3.3"], "en": "I perform service for my master.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_292:3.4"], "en": "\"This is no wound, it is a nose.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_292:4.1"], "en": "The Second Supatta Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
