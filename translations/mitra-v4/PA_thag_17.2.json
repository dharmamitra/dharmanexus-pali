[
{"segs": ["PA_thag_17.2:0.1", "PA_thag_17.2:0.2", "PA_thag_17.2:0.3"], "en": "Theragāthā 17.2 Tiṁsanipāta Paṭhamavagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:0.4"], "en": "Sāriputta Thera’s Verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:1.1"], "en": "“Acting as he does, mindful and alert,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:1.2"], "en": "Intent upon his purpose, meditative and heedful;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:1.3"], "en": "Delighting in the internal, with a concentrated mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:1.4"], "en": "solitary and contented— him they call a bhikkhu.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:2.1"], "en": "Whether eating what is moist or dry, he...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:2.2"], "en": "One should not be overly well-fed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:2.3"], "en": "with a moderate stomach and measured food,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:2.4"], "en": "a mindful bhikkhu should wander.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:3.1"], "en": "Having eaten four or five mouthfuls,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:3.2"], "en": "one should drink water;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:3.3"], "en": "this is sufficient for dwelling in comfort.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:3.4", "PA_thag_17.2:4.1"], "en": "If that which is allowable covers the robe of a bhikkhu who is resolute,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:4.2"], "en": "this robe is for that purpose.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:4.3", "PA_thag_17.2:4.4"], "en": "It is sufficient for the comfortable dwelling of a bhikkhu who is resolute,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:5.1"], "en": "as he sits cross-legged.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:5.2"], "en": "The rain does not fall upon one's knees;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:5.3", "PA_thag_17.2:5.4"], "en": "this is sufficient for the comfortable dwelling of a bhikkhu who is resolute in self-exertion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:6.1"], "en": "He who saw pleasure as suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:6.2"], "en": "and saw suffering as a dart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:6.3"], "en": "did not exist in the interval between the two.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:6.4"], "en": "By what means might one be [freed] in this world?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:7.1"], "en": "May I never be one who has evil desires,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:7.2"], "en": "nor be lazy or of inferior energy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:7.3", "PA_thag_17.2:7.4"], "en": "What can one who has heard little and lacks respect achieve in this world?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:8.1"], "en": "But one who is learned and wise—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:8.2", "PA_thag_17.2:8.3"], "en": "Well-composed in the precepts and devoted to mental tranquility—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:8.4"], "en": "let him stand even upon the summit of a mountain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:9.1", "PA_thag_17.2:9.2", "PA_thag_17.2:9.3"], "en": "The fool who is devoted to conceptual proliferation and delights in conceptual proliferation has missed out on Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:9.4"], "en": "The unsurpassed security from bondage. And he who,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:10.1"], "en": "having abandoned conceptual proliferation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:10.2"], "en": "delights in the path free from proliferation;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:10.3"], "en": "He attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:10.4"], "en": "the unsurpassed security from bondage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:11.1"], "en": "whether in the village or in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:11.2"], "en": "Whether in the forest or on the dry land,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:11.3"], "en": "wherever the Arahants dwell,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:11.4"], "en": "that ground is delightful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:12.1", "PA_thag_17.2:12.2"], "en": "Delightful are the forests where people do not find pleasure;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:12.3"], "en": "those free from passion will find delight there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:12.4"], "en": "They do not seek after sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:13.1", "PA_thag_17.2:13.2"], "en": "Just as one who sees flaws [would avoid] the one who reveals hidden treasures, so too [should one avoid those who point out faults].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:13.3"], "en": "One should associate with such a wise person who speaks with restraint;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:13.4", "PA_thag_17.2:13.5"], "en": "for one who associates with such a person, [there is benefit].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:13.6"], "en": "One becomes better, not worse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:14.1"], "en": "One should advise and instruct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:14.2"], "en": "and restrain one from what is unwholesome.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:14.3"], "en": "For he is dear to the virtuous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:14.4"], "en": "but disliked by the wicked;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:15.1"], "en": "the Blessed One is a Buddha unto others.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:15.2"], "en": "The One with Vision taught the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:15.3"], "en": "while the Dhamma was being taught,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:15.4"], "en": "the seeker awakened his ear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:16.1"], "en": "My hearing of that was not in vain;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:16.2"], "en": "I am liberated and free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:17.1"], "en": "Neither for the sake of past lives...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:17.2"], "en": "Nor of the divine eye;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:17.3"], "en": "nor of the supernormal power of penetrating others' minds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:17.4"], "en": "or of [knowing] death and rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:17.5", "PA_thag_17.2:17.6"], "en": "I have no aspiration for the purification of the ear-element.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:18.1"], "en": "Relying, as it were, on the foot of a tree...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:18.2"], "en": "Shaven-headed and clad in the outer robe,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:18.3", "PA_thag_17.2:18.4"], "en": "the Elder Upatissa, supreme in wisdom, meditates.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:19.1"], "en": "Having attained the state free from directed thought,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:19.2", "PA_thag_17.2:19.3"], "en": "the disciple of the Perfectly Enlightened One abides in noble silence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:19.4"], "en": "He remains thus for a while,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:20.1"], "en": "like a rocky mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:20.2"], "en": "immovable and firmly established.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:20.3", "PA_thag_17.2:20.4"], "en": "Thus, through the destruction of delusion, a bhikkhu does not tremble, like a mountain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:21.1"], "en": "For a person free from blemish, [there is no fear].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:21.2"], "en": "For one who constantly seeks purity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:21.3", "PA_thag_17.2:21.4"], "en": "even a hair’s tip of evil appears as large as a cloud.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:22.1"], "en": "I do not rejoice in death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:22.2"], "en": "nor do I rejoice in life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:22.3"], "en": "I shall cast off this body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:22.4"], "en": "Mindful and clearly comprehending:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:23.1"], "en": "I do not delight in death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:23.2"], "en": "nor do I delight in life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:23.3"], "en": "I await my time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:23.4"], "en": "just as a servant awaits his wages.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:24.1"], "en": "By both [of these], this is indeed death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:24.2"], "en": "Whether it be after death or before,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:24.3"], "en": "practice the path; do not perish,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:24.4"], "en": "lest the opportune moment pass you by.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:25.1", "PA_thag_17.2:25.2"], "en": "Just as a frontier city is guarded both within and without,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:25.3"], "en": "so should you guard yourselves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:25.4"], "en": "Let not the opportune moment pass you by;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:25.5", "PA_thag_17.2:25.6"], "en": "for those who have let the moment pass grieve when they are delivered over to hell.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:26.1"], "en": "“Peaceful, restrained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:26.2"], "en": "speaking with measured words, and unagitated—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:26.3"], "en": "he shakes off evil states.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:26.4"], "en": "Like the wind [shaking] a tree leaf—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:27.1"], "en": "calm, restrained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:27.2"], "en": "measured in speech, and unagitated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:27.3"], "en": "He has shaken off evil states,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:27.4"], "en": "as the wind shakes a leaf from a tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:28.1"], "en": "he is peaceful and free from distress.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:28.2"], "en": "“Clear and undisturbed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:28.3"], "en": "virtuous in conduct and wise—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:28.4"], "en": "one may become an ender of suffering.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:29.1"], "en": "“One should not place trust in any individuals in this way,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:29.2"], "en": "whether among householders or those who have gone forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:29.3"], "en": "for even those who were virtuous may become non-virtuous.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:29.4"], "en": "Having been unwholesome, they become wholesome again.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:30.1"], "en": "Sensual desire, ill will,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:30.2"], "en": "and sloth-and-torpor in a bhikkhu—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:30.3"], "en": "Restlessness and doubt—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:30.4"], "en": "these five are stains upon the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:31.1"], "en": "For one who is being honored, [they arise].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:31.2", "PA_thag_17.2:31.3", "PA_thag_17.2:31.4"], "en": "Neither by honor nor by lack thereof does the concentration of one who dwells in heedfulness waver.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:32.1"], "en": "To that meditator who is constant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:32.2"], "en": "who possesses subtle vision and insight,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:32.3"], "en": "and who delights in the destruction of clinging—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:32.4"], "en": "They say, \"He is a true man\":", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:33.1"], "en": "the great ocean, the earth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:33.2"], "en": "the mountain, and the wind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:33.3", "PA_thag_17.2:33.4"], "en": "They do not serve as a fitting analogy for the Teacher’s supreme liberation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:34.1"], "en": "The Elder who follows the Wheel—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:34.2"], "en": "The one of great wisdom, established in concentration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:34.3"], "en": "is like the earth and fire:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:34.4"], "en": "he is neither attached nor repelled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:35.1"], "en": "He who has reached the perfection of wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:35.2"], "en": "of great intelligence and great mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:35.3"], "en": "though not dull-witted, appears as if dull-witted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:35.4"], "en": "He always lives extinguished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:36.1", "PA_thag_17.2:36.2"], "en": "The Teacher has been served by me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:36.4"], "en": "The conduit to existence has been uprooted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:37.1"], "en": "Accomplish this through diligence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:37.2"], "en": "this is my instruction to you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:37.3"], "en": "“Now I shall attain final Nibbāna;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:37.4"], "en": "I am completely liberated from everything.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_17.2:37.5"], "en": "… Thus spoke the Elder Sāriputta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
