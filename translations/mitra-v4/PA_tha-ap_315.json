[
{"segs": ["PA_tha-ap_315:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:0.2"], "en": "Ārakkhadāyakavagga 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:0.3"], "en": "The Apadāna of the Elder Gatasaññaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:1.1"], "en": "\"Just as there is no footprint in the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:1.2"], "en": "nor in the wind that moves through the atmosphere,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:1.3"], "en": "so did I behold the Victorious One, Siddhattha.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:1.4", "PA_tha-ap_315:2.1", "PA_tha-ap_315:2.2"], "en": "Seeing the robe of the Perfectly Enlightened One, stirred by the wind, traveling through the courtyard of the triple heaven;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:2.3", "PA_tha-ap_315:2.4"], "en": "Having seen the Sage’s departure, they said to me, “Understand this!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:3.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:3.2"], "en": "Whatever perception I obtained then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:3.3"], "en": "I do not know any state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:3.4"], "en": "this is the fruit of the perception of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:4.1", "PA_tha-ap_315:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:5.1"], "en": "Thus indeed the venerable elder Gatasaññaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_315:6.1"], "en": "This is the third legend of the elder Gatasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
