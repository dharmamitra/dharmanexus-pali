[
{"segs": ["PA_ja_400:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:0.2", "PA_ja_400:0.3"], "en": "The Section of Sevens, Chapter on the Hen-Fowl (Kukkuvagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:0.4", "PA_ja_400:1.1"], "en": "5. The Dabbhapuppha Jātaka “O worthy one who roams the riverbank,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:1.2"], "en": "run after me, your companion!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:1.3"], "en": "\"A great fish has been caught by me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:1.4"], "en": "it is carrying me away with great speed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:2.1"], "en": "\"He moves in the deep, O venerable sir.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:2.2"], "en": "Grasp it firmly with strength;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:2.3"], "en": "I shall pull you out,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:2.4"], "en": "as a garuḍa pulls out a serpent.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:3.1"], "en": "“A dispute has arisen between us;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:3.2"], "en": "O Dabbhapuppha, listen to me!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:3.3"], "en": "Settle this conflict properly.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:3.4"], "en": "“The dispute has been settled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:4.1"], "en": "“In the past I was established in the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:4.2"], "en": "many legal cases were adjudicated by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:4.3"], "en": "I have properly cooled my fever;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:4.4"], "en": "the dispute has been stilled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:5.1"], "en": "Like a fish that wanders along the shore, its tail is exposed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:5.2"], "en": "The head of those who move in the deep;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:5.3"], "en": "this middle section, which has transcended [the world],", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:5.4"], "en": "will be for one established in the Dhamma.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:6.1"], "en": "“Even for a long time there would have been food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:6.2", "PA_ja_400:6.3"], "en": "had we not quarreled; [a meal] without heads and without thumbs.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:6.4"], "en": "A jackal carries off the rohita fish.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:7.1", "PA_ja_400:7.2"], "en": "Just as a kshatriya king would rejoice upon gaining his kingdom, so too does one rejoice when one has attained the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:7.3"], "en": "Thus do I rejoice today,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:7.4"], "en": "having seen my husband with his face full of joy.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:8.1"], "en": "How indeed could one who is born on dry land...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:8.2"], "en": "\"You grasp a fish in the water;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:8.3"], "en": "tell me truly, friend,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:8.4"], "en": "how was it attained by you?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:9.1"], "en": "“By dispute they become emaciated;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:9.2"], "en": "by dispute their wealth is exhausted;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:9.3"], "en": "by dispute they are defeated and driven out.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:9.4"], "en": "Eat the Rohita fish, O illusionist!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:10.1"], "en": "Even so among humans,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:10.2"], "en": "wherever a dispute arises;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:10.3", "PA_ja_400:10.4"], "en": "They run back to the one established in Dhamma, for he is their leader;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:10.5"], "en": "even their wealth is lost there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:10.6"], "en": "“The royal treasury increases.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_400:11.1"], "en": "This is the fifth Jātaka, the Dabbhapuppha Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
