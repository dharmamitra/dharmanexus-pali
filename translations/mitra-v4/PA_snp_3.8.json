[
{"segs": ["PA_snp_3.8:0.1", "PA_snp_3.8:0.2"], "en": "Sutta Nipāta 3.8 Sallasutta The signless,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:1.1"], "en": "not yet fully understood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:1.2", "PA_snp_3.8:1.3"], "en": "The life of mortals here is meager and brief,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:1.4"], "en": "and it is joined with suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:2.1", "PA_snp_3.8:2.2"], "en": "For there is no means by which those who are born do not die;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:2.3"], "en": "having reached old age, they meet with death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:2.4"], "en": "For living beings are of such a nature:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:3.1"], "en": "just as for ripe fruits,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:3.2"], "en": "there is the fear of falling at any moment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:3.3"], "en": "Thus for mortals who have been born,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:3.4"], "en": "there is constant fear of death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:4.1"], "en": "just as for a potter [of his pots].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:4.2", "PA_snp_3.8:4.3"], "en": "All clay vessels are destined for breaking;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:4.4"], "en": "such is the life of mortals.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:5.1"], "en": "Both the small and the great,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:5.2"], "en": "both the foolish and the wise—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:5.3"], "en": "all go under the power of death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:5.4"], "en": "All have death as their ultimate destination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:6.1", "PA_snp_3.8:6.2"], "en": "For those who are overtaken by death as they depart for the next world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:6.3"], "en": "A father does not protect his son,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:6.4", "PA_snp_3.8:7.1"], "en": "nor do kinsmen protect their kin; while the kinsmen look on, [death carries one away].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:7.2"], "en": "Behold how they chatter away in crowds;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:7.3"], "en": "yet for each individual among mortals,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:7.4"], "en": "life is led away like an ox to the slaughter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:8.1", "PA_snp_3.8:8.2"], "en": "Thus is the world assailed by death and by old age;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:8.3"], "en": "therefore, the wise do not grieve.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:8.4"], "en": "Having understood the way of the world—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:9.1"], "en": "that for whom you do not know the path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:9.2"], "en": "whether coming or going—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:9.3"], "en": "Not seeing either extreme,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:9.4", "PA_snp_3.8:10.1"], "en": "you lament in vain. If, while lamenting, you...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:10.2"], "en": "One should extract even a small amount of evil;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:10.3"], "en": "for one who is deluded and harms oneself might do it,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:10.4"], "en": "but a wise person would not.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:11.1"], "en": "For by weeping and grieving,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:11.2"], "en": "one does not attain peace of mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:11.3"], "en": "rather, suffering arises even more.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:11.4"], "en": "The body is struck down;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:12.1"], "en": "one becomes emaciated and discolored,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:12.2"], "en": "harming oneself by one's own hand.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:12.3"], "en": "By that, the departed do not sustain themselves;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:12.4"], "en": "lamentation is useless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:13.1"], "en": "A person who does not abandon sorrow—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:13.2"], "en": "He encounters even greater suffering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:13.3"], "en": "lamenting for the deceased,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:13.4"], "en": "he falls under the power of grief.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:14.1"], "en": "And see others too, O traveler,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:14.2"], "en": "men who have gone according to their deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:14.3"], "en": "having fallen under the power of Death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:14.4"], "en": "Even while living beings are struggling,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:15.1", "PA_snp_3.8:15.2"], "en": "whatever they conceive of turns out to be otherwise than that.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:15.3"], "en": "Such is this separation;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:15.4"], "en": "behold the way of the world!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:16.1"], "en": "Even if one were to live for a hundred years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:16.2"], "en": "Or even more so, the young man,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:16.3"], "en": "separated from his circle of kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:16.4"], "en": "gives up his life here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:17.1"], "en": "Therefore, having heard from the Arahant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:17.2", "PA_snp_3.8:17.3"], "en": "one should dispel lamentation upon seeing a deceased person who has passed away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:17.4"], "en": "\"This cannot be obtained by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:18.1", "PA_snp_3.8:18.2"], "en": "Just as one would extinguish a burning house with water, so should one act.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:18.3"], "en": "In this way, the wise, discerning,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:18.4", "PA_snp_3.8:18.5"], "en": "learned, and skillful person quickly overcomes arisen sorrow.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:18.6", "PA_snp_3.8:19.1", "PA_snp_3.8:19.2"], "en": "The wind shall blow away one's lamentation, yearning, and personal dejection, just as it scatters a tuft of cotton.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:19.3"], "en": "Seeking his own happiness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:19.4", "PA_snp_3.8:20.1"], "en": "one should pull out one's own arrow; having pulled out the arrow, one is no longer dependent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:20.2"], "en": "Having attained peace of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:20.3"], "en": "having transcended all sorrow,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:20.4"], "en": "he becomes sorrowless and extinguished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_3.8:20.5"], "en": "The Discourse on the Arrow, the Eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
