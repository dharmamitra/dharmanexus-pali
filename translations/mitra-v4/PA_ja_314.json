[
{"segs": ["PA_ja_314:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:0.2", "PA_ja_314:0.3"], "en": "Catukkanipāta, Pucimandavagga (The Chapter on the Nimba Tree)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:0.4"], "en": "4. The Lohakumbhi Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:1.1", "PA_ja_314:1.2"], "en": "“We have lived a life ill-lived, we who, though possessing means, did not give.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:1.3"], "en": "\"While wealth was still available,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:1.4"], "en": "we did not make an island for ourselves.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:2.1"], "en": "\"For sixty thousand years...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:2.2"], "en": "Are entirely complete;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:2.3"], "en": "for those being cooked in hell,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:2.4"], "en": "when will there be an end?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:3.1"], "en": "“There is no end; whence could there be an end?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:3.2"], "en": "No end is perceived;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:3.3"], "en": "for then, evil has been committed.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:3.4"], "en": "“...for you and me, dear sir.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:4.1", "PA_ja_314:4.2"], "en": "“Having surely gone from here and obtained a human birth, I— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:4.3"], "en": "“Generous and perfected in virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:4.4"], "en": "I shall perform much wholesome merit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_314:5.1"], "en": "The Lohakumbhi Jātaka, the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
