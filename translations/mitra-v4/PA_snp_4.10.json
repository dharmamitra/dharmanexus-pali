[
{"segs": ["PA_snp_4.10:0.1", "PA_snp_4.10:0.2"], "en": "Sutta Nipāta 4.10 Purābhedasutta: “Of what kind should one be in view,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:1.1"], "en": "and of what kind in conduct?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:1.2"], "en": "\"One who is called 'peaceful'—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:1.3"], "en": "tell me that, O Gotama,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:1.4"], "en": "you who have been asked, O supreme man.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:2.1"], "en": "“Free from craving before his dissolution,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:2.2", "PA_snp_4.10:2.3"], "en": "(thus said the Blessed One,) not dependent on the past;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:2.4"], "en": "He is not to be reckoned among the middle;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:2.5"], "en": "for him there is no precedence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:3.1"], "en": "Free from anger and without fear,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:3.2"], "en": "One who does not boast, who is free from remorse,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:3.3"], "en": "who speaks with deliberation and is not agitated—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:3.4"], "en": "he indeed is a sage restrained in speech.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:4.1"], "en": "Free from attachment to the future,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:4.2"], "en": "he does not grieve for the past;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:4.3"], "en": "seeing solitude amidst sense-contacts, he dwells detached.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:4.4"], "en": "And he is not led away by views.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:5.1"], "en": "Withdrawn, free from deceit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:5.2"], "en": "without envy, and without stinginess;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:5.3"], "en": "Free from immodesty, free from disgust,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:5.4", "PA_snp_4.10:6.1"], "en": "and not addicted to slander; one who does not hanker after sensual pleasures—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:6.2"], "en": "He is not addicted to conceit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:6.3"], "en": "he is gentle and eloquent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:6.4"], "en": "yet neither full of faith nor devoid of passion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:7.1"], "en": "One who desires gain does not train,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:7.2"], "en": "nor is one disturbed by lack of gain;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:7.3"], "en": "such a person is not at odds with craving.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:7.4"], "en": "He does not crave for flavors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:8.1"], "en": "Always equanimous and mindful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:8.2"], "en": "he does not conceive of anything as equal in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:8.3"], "en": "Neither superior nor inferior,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:8.4", "PA_snp_4.10:9.1"], "en": "he has no mental excitements; for him there is no dependence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:9.2"], "en": "Having understood the Dhamma and being independent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:9.3", "PA_snp_4.10:9.4"], "en": "for whom no craving exists for either becoming or non-becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:10.1", "PA_snp_4.10:10.2"], "en": "Him I call \"peaceful,\" who has no longing for sensual pleasures; for him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:10.3"], "en": "the fetters do not exist.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:10.4"], "en": "He has crossed over the clinging to existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:11.1"], "en": "For him there are no children or cattle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:11.2"], "en": "nor does he possess fields or land.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:11.3", "PA_snp_4.10:11.4"], "en": "Neither self nor non-self is found therein;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:12.1"], "en": "by which means ordinary people might describe it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:12.2"], "en": "And likewise as for recluses and brahmins:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:12.3"], "en": "since he does not place them before him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:12.4"], "en": "he is not led astray by their doctrines.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:13.1"], "en": "Free from grasping and without envy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:13.2"], "en": "the sage does not speak in praise of those who excel him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:13.3"], "en": "nor of those who are his equals, nor of those who are inferior.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:13.4"], "en": "The unrighteous man leads himself through an eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:14.1", "PA_snp_4.10:14.2"], "en": "He who has nothing of his own in the world does not grieve over what is non-existent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:14.3"], "en": "And he does not go among phenomena;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:14.4"], "en": "he indeed is called \"peaceful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_4.10:14.5"], "en": "Thus ends the tenth discourse, the *Purābheda Sutta*.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
