[
{"segs": ["PA_anya-e06_03n:0"], "en": "Homage to that Blessed One, the Worthy One, the Perfectly Self-Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:1", "PA_anya-e06_03n:2"], "en": "Verses in Praise of the Buddha According to His Characteristics.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:4"], "en": "In many existences, one after another,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:5"], "en": "you fulfilled the thirty perfections;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:6"], "en": "and through such conduct, you became a Perfectly Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:7"], "en": "In the state of existence as Vessantara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:9"], "en": "while established in renunciation,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:10"], "en": "I gave even Maddi away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:11"], "en": "Having descended from the Tuṣita heaven to the mountain Vaṅkaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:12", "PA_anya-e06_03n:14"], "en": "which was like a mass of his own black antelope skin, he then appeared.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:15"], "en": "Possessing merit that arises purely,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:16", "PA_anya-e06_03n:17"], "en": "he surpassed other devas by means of ten qualities, beginning with form.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:19"], "en": "From ten thousand world-systems,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:20"], "en": "entirely from the ten great cities,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:21"], "en": "he was entreated by gods and Brahmas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:22"], "en": "From the pride of his Buddha-nature,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:24", "PA_anya-e06_03n:25"], "en": "Sirindharo, having performed the fivefold survey, looked out.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:26"], "en": "Then, having cast off her māyā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:27", "PA_anya-e06_03n:29"], "en": "she was reborn in the Sākiya clan on the most excellent full moon day of the month of Visākha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:30"], "en": "In the Lumbinī grove where he was born,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:31", "PA_anya-e06_03n:32"], "en": "he then took seven steps while letting out a lion’s roar.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:34"], "en": "Then the sun, the moon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:35"], "en": "and the stars shone in the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:36"], "en": "and the jewels upon the earth gleamed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:37"], "en": "There are heaps of various flowers and showers of blossoms.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:39"], "en": "The fires of Avīci blaze coldly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:40"], "en": "and hunger and thirst are its provisions.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:41", "PA_anya-e06_03n:42"], "en": "With great radiance reaching to the ends of the world, even the blind can see;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:44"], "en": "musical instruments play without being struck.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:45", "PA_anya-e06_03n:46", "PA_anya-e06_03n:47"], "en": "In the sky, celestial musical instruments resounded sweetly as long as Yasa was wandering through the world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:49"], "en": "Singing songs of praise,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:50"], "en": "the gods seated upon lotus-thrones stood there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:51"], "en": "greeting one another with joyful conversation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:52"], "en": "In the presence of the Buddha-seedling,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:54", "PA_anya-e06_03n:55"], "en": "in the royal palace, the prince was delighted by his beautiful nurses.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:56"], "en": "Among the Sakyan maidens was a great happiness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:57", "PA_anya-e06_03n:59"], "en": "security, and peace; the Sakyan youth was sixteen years of age.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:60"], "en": "In the Nandana grove, you were the father of Rāsa;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:61", "PA_anya-e06_03n:62"], "en": "you were consecrated in kingship over the three worlds, O Lord of the Modas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:64", "PA_anya-e06_03n:65"], "en": "O you whose body is like the color of the Nandana grove, who preserve the splendor of beauty,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:66"], "en": "we entreat you for the great sovereignty over sorrow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:67"], "en": "The Elixir for the Guide of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:69"], "en": "In the twenty-ninth year,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:70"], "en": "on the full moon day of Visākha;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:71"], "en": "Accompanied by his army,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:72"], "en": "he went forth to the procession circle;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:74"], "en": "having observed the omens in the four directions, he departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:75"], "en": "Having heard of the birth of one who would fulfill his father’s hopes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:76", "PA_anya-e06_03n:77"], "en": "the men and women in the city were filled with anxiety in their hearts.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:79"], "en": "Having returned from the city,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:80"], "en": "he reached the circle of the palace;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:81"], "en": "there the king of gods lay down as it were.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:82"], "en": "In that place most worthy of the Soma sacrifice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:84", "PA_anya-e06_03n:85"], "en": "they honored Sundarī with dance and song as she stood before them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:86", "PA_anya-e06_03n:87"], "en": "Even so, having gone forth as a renunciant with a mind intent on making an offering,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:89"], "en": "he first [ordained] his son Rāhula.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:90", "PA_anya-e06_03n:91"], "en": "Thinking, \"I shall depart after passing by,\" while he was thus reflecting,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:92"], "en": "he came to my dwelling.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:94"], "en": "Setting aside the foot-stakes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:95"], "en": "he entered the neck-mantra;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:96"], "en": "looking about, he saw nothing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:97"], "en": "If I were to seize the arm of that queen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:99", "PA_anya-e06_03n:100"], "en": "having pulled away her son who had just been born from her mother’s side.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:101", "PA_anya-e06_03n:102"], "en": "Having awakened, Yasodharā saw the space where the Buddha had gone out for alms;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:104"], "en": "she would have seen him as if he were right before her eyes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:105"], "en": "Thinking thus of Rāhula,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:106", "PA_anya-e06_03n:107"], "en": "he mounted Kaṇḍaka and departed from that place by way of the gate.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:109", "PA_anya-e06_03n:110"], "en": "The deities opened the circle of gates,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:111"], "en": "with thousands of jewel-lamps.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:112"], "en": "They bound him with cords of lotus fibers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:114"], "en": "O Siddhattha, do not go out;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:115"], "en": "on the seventh day from now, you shall depart.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:116", "PA_anya-e06_03n:117", "PA_anya-e06_03n:119"], "en": "\"You shall become a wheel-turning monarch,\" so indeed did the Evil One say. Truly, O Māra, I know this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:120"], "en": "\"This is the way to overcome Māra\";", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:121"], "en": "having thus driven away Māra,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:122"], "en": "he advanced with confidence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:124"], "en": "Having reached the bank of the Anoma River,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:125"], "en": "he turned his horse back again;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:126"], "en": "Bimbā remained in the city of Channā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:127"], "en": "To inform Devī: \"The wreath,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:129"], "en": "perfumed with sweet fragrances,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:130"], "en": "which was bound for Yasodharā...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:131"], "en": "Having severed with a sharp sword,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:132", "PA_anya-e06_03n:134"], "en": "he tossed into the sky the eight most excellent requisites.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:135"], "en": "Having received these from Brahmā, the King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:136", "PA_anya-e06_03n:137"], "en": "worthy of offerings, abandoned his difficult royal state and attained the goal of a recluse.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:139"], "en": "Performing difficult deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:140", "PA_anya-e06_03n:141"], "en": "he exerted himself for six years with coarse food and drink.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:142", "PA_anya-e06_03n:144"], "en": "He had his body cremated on the full moon day of the month of Visākha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:145"], "en": "with an alms-bowl filled with milk-rice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:146"], "en": "Having taken what was brought by Sujātā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:147"], "en": "he approached the Nerañjarā River;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:149"], "en": "at the bank of the Nerañjarā, he arrived.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:150"], "en": "Having heard of the unsurpassed freedom from fear,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:151", "PA_anya-e06_03n:152"], "en": "he approached the seat of enlightenment by way of the excellent path of preparedness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:154"], "en": "Seated upon my victory throne,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:155"], "en": "standing firm with resolute mind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:156"], "en": "I shall not abandon my ninefold vigor.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:157"], "en": "He attained the state of Buddhahood.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:159"], "en": "The Lord of Devas offered him the conch of Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:160"], "en": "and the Grandfather offered him the white parasol.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:161"], "en": "Holding and playing the lute,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:162"], "en": "Pañcasikha stood there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:164"], "en": "singing songs of praise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:165", "PA_anya-e06_03n:166", "PA_anya-e06_03n:167"], "en": "The goddess Aṭṭhāsudevasundarī took a golden casket filled with celestial flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:169"], "en": "While the sun had not yet risen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:170", "PA_anya-e06_03n:171"], "en": "he put to flight Māra’s army at the time of dawn’s appearance.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:172"], "en": "As he contemplated the *Paṭṭhāna*,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:174", "PA_anya-e06_03n:175"], "en": "the excellent beauty of the Lord’s body [shone forth] from his own state of enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:176"], "en": "Desiring the six-colored rays,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:177"], "en": "they run hither and thither—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:179"], "en": "blue and non-blue, white and non-white.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:180"], "en": "Red and crimson-colored rays emerged;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:181"], "en": "white and ash-colored rays remained,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:182"], "en": "each shining with its own radiance from its respective source.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:184", "PA_anya-e06_03n:185", "PA_anya-e06_03n:186"], "en": "The Victor, having realized the depth of the Dhamma, would have taught it after reflecting upon his attainment of Buddhahood.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:187"], "en": "Having approached me with earnestness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:189", "PA_anya-e06_03n:190"], "en": "Brahmā Sahampati then entreated me for the teaching.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:191"], "en": "Then, in the first month of that year,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:192"], "en": "he set in motion the Wheel of Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:194"], "en": "he was a Fully Awakened One for only one year.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:195"], "en": "On the full moon day of the month of Phagguna,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:196"], "en": "he went to the city of the Sakyans,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:197"], "en": "preceded by his disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:199"], "en": "At the gathering of his kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:200", "PA_anya-e06_03n:201"], "en": "he caused a cool rain to fall and sent down a great cloud.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:202"], "en": "The Vessantara Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:204", "PA_anya-e06_03n:205"], "en": "Having gone with his pair of disciples to the palace of Yasodharā;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:206"], "en": "Having satisfied him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:207"], "en": "he taught the Canda-kinnara-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:209"], "en": "Having dwelt for seven years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:210"], "en": "On the stone throne in the Tāvatiṃsa heaven,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:211", "PA_anya-e06_03n:212"], "en": "he delighted the vast multitude of gods and brahmas with the Abhidhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:214"], "en": "With the net of knowledge of the stone slab,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:215", "PA_anya-e06_03n:216"], "en": "the Teacher of the World always awakens the world to the light of enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:217"], "en": "He beheld the lotus-like people capable of being awakened,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:219", "PA_anya-e06_03n:220"], "en": "and the succession of world-systems extending as far as the horizon.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:221"], "en": "Having gone there, the Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:222"], "en": "possessed of excellent awakening,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:224"], "en": "awakened the Brahmās, beginning with Baka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:225"], "en": "Yakkhas such as Āḷavaka and others;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:226"], "en": "deities such as Purindada and others;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:227"], "en": "and rakkhasas such as Sūciloma and others.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:229"], "en": "Jāṇusoṇa and others,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:230"], "en": "many brāhmaṇas and avikkhaḷas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:231"], "en": "Cūḷodara and other snakes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:232"], "en": "Dhanapāla and others, as well as the elephant-king;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:234"], "en": "those who consider the Buddha to be a mere mortal,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:235"], "en": "and the various sectarians with their single-sided views.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:236"], "en": "The best among those who possess the marks of a woman,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:237"], "en": "the crusher of opposing doctrines,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:239"], "en": "perfected in every minor characteristic.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:240"], "en": "Possessing these thirty-two marks,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:241"], "en": "he is encircled by a fathom-wide radiance,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:242"], "en": "from his crest-jewel to his rocky throne.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:244", "PA_anya-e06_03n:245", "PA_anya-e06_03n:246"], "en": "He taught eighty-four thousand sections of the Dhamma over the course of five thousand four hundred and fifty years.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:247"], "en": "For the sake of the welfare of the three worlds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:249"], "en": "performing the work of a Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:250"], "en": "he carries forth the supreme benefit for the world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:251"], "en": "While liberating beings from their bonds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:252", "PA_anya-e06_03n:254"], "en": "he always passes away at whatever place his protector Āsītika may be.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:255"], "en": "In the excellent grove of Nibbūta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:256"], "en": "in the delightful Mahāsāla forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:257"], "en": "there was the town of the Mallas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:259"], "en": "Having kindled the mass of fire in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:260", "PA_anya-e06_03n:261"], "en": "that disciple has extinguished it among all conditioned things.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:262"], "en": "Proclaiming impermanence:", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:263"], "en": "“Homage to the Blessed One, the Protector;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:264"], "en": "homage to the Victor among the victorious.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:265"], "en": "\"Homage to the one endowed with glory!", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:266"], "en": "Homage to the delight of the world!\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:267"], "en": "Buddha-vandanā (Homage to the Buddha).", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:269"], "en": "Having descended from the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:270", "PA_anya-e06_03n:271"], "en": "he was conceived in the womb of Mahāmāyā during her fertile period.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:272"], "en": "Worship this bull of the Sakyas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:274", "PA_anya-e06_03n:275"], "en": "This tenth [son] was not born from his mother's womb through the power of truth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:276"], "en": "On a Friday, at Lumbinī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:277"], "en": "I pay homage to him who is honored by the world;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:279"], "en": "having renounced the glory of a wheel-turning monarch, he was born.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:280"], "en": "I bow to that elephant among sages,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:281", "PA_anya-e06_03n:282"], "en": "who wisely undertook the Great Renunciation and went forth under the moonlit door.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:284"], "en": "At the foot of the Assattha Bodhi tree,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:285"], "en": "upon the invincible cross-legged seat,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:286"], "en": "the Protector attained omniscience.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:287"], "en": "Name that on Wednesday.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:289", "PA_anya-e06_03n:290"], "en": "[It was given] to the leaders of the group of five in the Deer Park at Isipatana.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:291", "PA_anya-e06_03n:292", "PA_anya-e06_03n:294"], "en": "I pay homage to that Conqueror who, at the Deer Park, set in motion the Wheel of Dhamma concerning all conditioned phenomena.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:295"], "en": "Having proclaimed impermanence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:296"], "en": "I bow to the one who has attained Nibbāna in the Aṅgavāra chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:297"], "en": "who is free from sloth and negligence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:299", "PA_anya-e06_03n:300"], "en": "On a Sunday, the image of the Conqueror was placed in a golden bowl;", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:301"], "en": "fire blazed up from it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:302"], "en": "The Name Dhātusarīrakaṃ.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:303"], "en": "Homage to the Lord with the Ūrṇā-hair:", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:304"], "en": "to the Lord who possesses the ūrṇā-hair.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:305"], "en": "Between his eyebrows,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:306"], "en": "the ūrṇā hair shines like a diamond,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:307"], "en": "emerging exceedingly bright and pure.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:308", "PA_anya-e06_03n:309"], "en": "From the beautiful body of the Protector, who possesses a body as precious as a diamond,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:310"], "en": "diamonds stream forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:311"], "en": "Like lightning in the midst of the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:312", "PA_anya-e06_03n:313"], "en": "the radiance of the tusk issued forth with a gentle laugh of derision.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:314"], "en": "Spreading through all directions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"},
{"segs": ["PA_anya-e06_03n:315"], "en": "they shine white like diamonds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:18:13Z"}
]
