[
{"segs": ["PA_thag_8.2:0.1", "PA_thag_8.2:0.2", "PA_thag_8.2:0.3"], "en": "Theragāthā 8.2 Aṭṭhaka-nipāta Paṭhama-vagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:0.4"], "en": "The Verses of the Elder Sirimitta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:1.1"], "en": "“Free from anger, free from resentment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:1.2"], "en": "without guile, devoid of backbiting;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:1.3"], "en": "Such indeed is that bhikkhu;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:1.4"], "en": "having passed away, he does not grieve in this way—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:2.1"], "en": "free from anger and free from resentment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:2.2"], "en": "Free from deceit, empty of slander,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:2.3", "PA_thag_8.2:2.4"], "en": "with guarded sense-doors, a bhikkhu never grieves after passing away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:3.1"], "en": "Free from anger, free from resentment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:3.2"], "en": "without guile, devoid of backbiting—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:3.3"], "en": "that bhikkhu is one of virtuous conduct.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:3.4"], "en": "Thus, having passed away, one does not grieve:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:4.1"], "en": "free from anger, without resentment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:4.2"], "en": "without deceit, and devoid of slander.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:4.3", "PA_thag_8.2:4.4"], "en": "That bhikkhu who has virtuous friends does not grieve after passing away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:5.1"], "en": "he is free from anger and free from resentment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:5.2"], "en": "Free from deceit and devoid of slander,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:5.3", "PA_thag_8.2:5.4"], "en": "that monk of noble wisdom does not grieve after passing away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:6.1", "PA_thag_8.2:6.2"], "en": "He whose faith in the Tathāgata is unshakable and well-established,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:6.3"], "en": "and whose virtue is noble—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:6.4"], "en": "Beloved by the Noble Ones and praised.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:7.1", "PA_thag_8.2:7.2"], "en": "Whoever has confidence in the Saṅgha and whose vision is upright;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:7.3"], "en": "‘The wealthy one,’ they say of him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:7.4"], "en": "his life is not in vain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:8.1"], "en": "Therefore, faith and virtue—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:8.2"], "en": "Faith and the vision of the Dhamma—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:8.3"], "en": "the wise person should devote themselves to these,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:8.4"], "en": "remembering the teaching of the Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_8.2:8.5"], "en": "… the elder Sirimitta …", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
