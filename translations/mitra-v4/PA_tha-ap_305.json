[
{"segs": ["PA_tha-ap_305:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:0.2", "PA_tha-ap_305:0.3"], "en": "The Chapter on the Lotus Filaments (Padumakesaravagga) 3. The Apadāna of the Elder Paramannadāyaka (The Giver of Supreme Food)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:1.1", "PA_tha-ap_305:1.2", "PA_tha-ap_305:1.3"], "en": "I saw the Buddha Vipassī, shining like a kaṇikāra flower, like the rising sun.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:1.4"], "en": "To the Eldest in the World, the Bull among Men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:2.1", "PA_tha-ap_305:2.2"], "en": "I raised my hands in salutation and led him to my own home.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:2.3"], "en": "Having honored the Fully Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:2.4"], "en": "I gave him the finest food.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:3.1"], "en": "Ninety-one aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:3.2"], "en": "I ate that supreme rice at that time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:3.3"], "en": "I do not recall ever falling into an evil rebirth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:3.4"], "en": "this is the fruit of that supreme rice.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:4.1", "PA_tha-ap_305:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:5.1"], "en": "Thus indeed the venerable elder Paramannadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_305:6.1"], "en": "This is the third legend of the elder Paramannadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
