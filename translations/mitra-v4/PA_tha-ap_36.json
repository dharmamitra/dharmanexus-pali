[
{"segs": ["PA_tha-ap_36:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:0.2"], "en": "The Section on the Venerable Kuṇḍadhāna, 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:0.3"], "en": "The Apadāna of the Venerable Kāḷudāyi", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:1.1"], "en": "“Of the Buddha Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:1.2"], "en": "the World’s Elder, the Neutral One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:1.3"], "en": "while he was proceeding on his journey...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:1.4"], "en": "While wandering on my journey at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:2.1"], "en": "I gathered a full-blown lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:2.2"], "en": "as well as blue water-lilies and jasmine flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:2.3"], "en": "Having taken that supreme food,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:2.4"], "en": "I gave it to the Teacher;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:3.1"], "en": "the Great Hero consumed it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:3.2"], "en": "It was excellent food, a fine meal;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:3.3"], "en": "and having taken that flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:3.4"], "en": "he showed it to the people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:4.1"], "en": "That which is desirable, lovely, and dear in the world—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:4.2"], "en": "the supreme water-born flower—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:4.3"], "en": "has been produced by him with great difficulty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:4.4"], "en": "He who gave me this flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:5.1"], "en": "he who offered me flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:5.2"], "en": "and he who gave me excellent rice—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:5.3"], "en": "I shall praise him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:5.4"], "en": "listen as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:6.1"], "en": "Eighteen times did he...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:6.2"], "en": "He will exercise sovereignty over the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:6.3"], "en": "he will be like the blue lotus, the red lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:6.4"], "en": "and the jasmine, and even more so.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:7.1"], "en": "As the result of that merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:7.2", "PA_tha-ap_36:7.3"], "en": "having fashioned a canopy in the sky endowed with celestial fragrance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:7.4"], "en": "He will maintain it for that long.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:8.1", "PA_tha-ap_36:8.2"], "en": "And twenty-five times he will become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:8.3", "PA_tha-ap_36:8.4", "PA_tha-ap_36:9.1"], "en": "He will rule over the kingdom of the earth for five hundred years and shall dwell upon the earth for one hundred thousand eons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:9.2"], "en": "Born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:9.3", "PA_tha-ap_36:9.4"], "en": "he whose lineage is Gotama will become a teacher in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:10.1", "PA_tha-ap_36:10.2"], "en": "Delighted by his own deeds and impelled by the root of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:10.3"], "en": "he was the one who brought joy to the Śākyas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:10.4"], "en": "He will become a kinsman and relative.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:11.1"], "en": "Having gone forth later on,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:11.2"], "en": "urged on by the root of his wholesome merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:11.3"], "en": "Having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:11.4", "PA_tha-ap_36:12.1"], "en": "he will attain Nibbāna, free from taints; having reached the analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:12.2", "PA_tha-ap_36:12.3"], "en": "One who has done what was to be done and is free from taints— Gautama, the Kinsman of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:12.4"], "en": "will place such a person in this foremost position.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:13.1", "PA_tha-ap_36:13.2", "PA_tha-ap_36:13.3"], "en": "He, named Udāyī, was resolute in his exertion, peaceful, and free from acquisitions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:13.4"], "en": "“He will become a disciple of the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:14.1"], "en": "Lust, hatred, and delusion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:14.2"], "en": "as well as pride and hypocrisy, have been destroyed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:14.3"], "en": "Having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:14.4"], "en": "I dwell free from taints;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:15.1"], "en": "I have also satisfied the Fully Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:15.2"], "en": "Ardent and discerning am I;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:15.3"], "en": "the Sambuddha, being pleased,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:15.4"], "en": "has placed me at the very foremost.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:16.1", "PA_tha-ap_36:16.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:16.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:17.1"], "en": "Thus indeed did the venerable elder Kāḷudāyī speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_36:18.1"], "en": "This is the fourth legend of the elder Kāḷudāyī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
