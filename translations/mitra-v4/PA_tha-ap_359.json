[
{"segs": ["PA_tha-ap_359:0.1", "PA_tha-ap_359:0.2", "PA_tha-ap_359:0.3"], "en": "The Apadāna of the Elder Supuṭakapūjaka, from the Saddasaññaka Chapter, Number Seven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:1.1"], "en": "“Having emerged from his midday rest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:1.2"], "en": "Vipassī, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:1.3"], "en": "wandered about for alms.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:1.4"], "en": "He approached my presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:2.1"], "en": "Then, joyful and glad of heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:2.2"], "en": "he [approached] the Best of Buddhas, the Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:2.3"], "en": "Having given a packet of salt,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:2.4"], "en": "may I rejoice in heaven for an eon;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:3.1"], "en": "ninety-one eons ago...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:3.2"], "en": "The packet that I gave away—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:3.3"], "en": "I do not recognize any state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:3.4"], "en": "this is the fruit of that packet.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:4.1", "PA_tha-ap_359:4.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:5.1"], "en": "Thus indeed the venerable elder Supuṭakapūjaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_359:6.1"], "en": "This is the seventh legend of the elder Supuṭakapūjaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
