[
{"segs": ["PA_tha-ap_293:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:0.2", "PA_tha-ap_293:0.3"], "en": "The Chapter on Those Who Honored the Pyre (Citakapūjakavagga) 1. The Apadāna of the Elder Citakapūjaka (The One Who Honored the Pyre)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:1.1", "PA_tha-ap_293:1.2"], "en": "“At that time, I was a brahmin named Ajita;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:1.3"], "en": "I desired to offer a sacrifice.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:1.4"], "en": "I gathered various flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:2.1"], "en": "Seeing the blazing funeral pyre of Sikhin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:2.2"], "en": "the Kinsman of the World, I brought them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:2.3"], "en": "Having gathered that flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:2.4"], "en": "I scattered it upon the funeral pyre.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:3.1"], "en": "Thirty-one eons ago from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:3.2"], "en": "Because I offered that flower in worship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:3.3"], "en": "I have not known a miserable rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:3.4"], "en": "this is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:4.1"], "en": "In the twenty-seventh aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:4.2", "PA_tha-ap_293:4.3"], "en": "there were seven lords of men named Supajjalita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:4.4"], "en": "The wheel-turning monarchs of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:5.1", "PA_tha-ap_293:5.2"], "en": "the four analytical knowledges and these eight liberations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:5.3"], "en": "“The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:5.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:6.1"], "en": "Thus indeed did the Venerable Citakapūjaka Thera speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_293:7.1"], "en": "The legend of the Elder Citakapūjaka is the first.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
