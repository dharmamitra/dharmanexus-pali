[
{"segs": ["PA_tha-ap_532:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:0.2"], "en": "The Chapter on the Giver of Grass, 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:0.3"], "en": "The Apadāna of the Elder Sugandha", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:1.1"], "en": "“In this auspicious aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:1.2"], "en": "there was one of great renown, a kinsman of Brahmā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:1.3"], "en": "known by the clan name Kassapa.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:1.4"], "en": "The best among those who speak arose,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:2.1", "PA_tha-ap_532:2.2"], "en": "endowed with the excellence of secondary marks and possessing the thirty-two supreme characteristics.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:2.3"], "en": "Surrounded by a fathom-wide radiance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:2.4"], "en": "covered by a web of rays,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:3.1"], "en": "he is like the moon that brings comfort.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:3.2"], "en": "Like the sun that brings forth light,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:3.3"], "en": "like a rain-cloud that extinguishes heat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:3.4"], "en": "and like the ocean, a mine of virtues.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:4.1"], "en": "Like the earth in virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:4.2"], "en": "like the Himalayas in concentration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:4.3"], "en": "and like space in wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:4.4"], "en": "Like the unattached wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:5.1", "PA_tha-ap_532:5.2"], "en": "that great hero, confident amidst the assemblies, at one time—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:5.3"], "en": "He fully reveals the truths,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:5.4"], "en": "uplifting the great multitude;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:6.1"], "en": "for at that time, in Bārāṇasī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:6.2"], "en": "I was the son of a wealthy merchant of great renown;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:6.3", "PA_tha-ap_532:6.4"], "en": "at that time, I possessed abundant and vast quantities of wealth and grain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:7.1"], "en": "While wandering on my walking tour,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:7.2"], "en": "I approached the Deer Park;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:7.3"], "en": "there I saw the stainless Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:7.4"], "en": "He was proclaiming the deathless state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:8.1", "PA_tha-ap_532:8.2"], "en": "with his charming speech as melodious as the song of the karavīka bird.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:8.3", "PA_tha-ap_532:8.4", "PA_tha-ap_532:9.1"], "en": "Seeing that God beyond gods, who was making himself known to the great multitude with the cries of swans, I approached him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:9.2"], "en": "Having heard those sweet words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:9.3", "PA_tha-ap_532:9.4"], "en": "I abandoned even small possessions and went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:10.1"], "en": "Having thus gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:10.2", "PA_tha-ap_532:10.3"], "en": "before long I became one of great learning and a teacher of the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:10.4"], "en": "Possessing brilliant eloquence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:11.1"], "en": "with a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:11.2"], "en": "I spoke again and again in the midst of the great assembly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:11.3", "PA_tha-ap_532:11.4"], "en": "Skilled in praise, I praised the one of golden hue:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:12.1"], "en": "\"This is the Buddha whose taints are destroyed.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:12.2"], "en": "Free from distress, with doubts severed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:12.3", "PA_tha-ap_532:12.4"], "en": "he has attained the destruction of all kamma and is liberated through the exhaustion of the substrata of existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:13.1"], "en": "He is that Blessed One, the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:13.2", "PA_tha-ap_532:13.3"], "en": "he is the unsurpassed lion of the world together with its devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:13.4"], "en": "The turner of the Brahma-wheel,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:14.1"], "en": "tamed, a tamer, peaceful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:14.2"], "en": "a peacemaker, extinguished, the seer;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:14.3"], "en": "The quencher and the one who has found comfort,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:14.4"], "en": "the consoler of the great multitude;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:15.1"], "en": "the hero, the brave, and the triumphant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:15.2"], "en": "Wise, compassionate, and masterful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:15.3"], "en": "victorious and a conqueror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:15.4"], "en": "he is free from arrogance and without attachment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:16.1"], "en": "Unshakeable, immovable, wise,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:16.2"], "en": "undeluded, peerless, the Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:16.3"], "en": "a bearer of burdens, a bull, an elephant—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:16.4"], "en": "Sīha, Sakka, and even toward his teachers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:17.1"], "en": "Virāga, Vimala, Brahmā, the Orator,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:17.2"], "en": "the Hero, the Vanquisher of Battle;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:17.3"], "en": "Wholly healed and free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:17.4"], "en": "peerless, self-restrained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:18.1"], "en": "and pure— the brahmin, the ascetic, the protector.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:18.2"], "en": "The physician, the surgeon;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:18.3"], "en": "the warrior, the Buddha, the learned and the well-trained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:18.4"], "en": "the immovable, the joyful, and the cool.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:19.1"], "en": "The Ordainer, the Sustainer, and those who exist;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:19.2"], "en": "the Maker, the Leader, and the Proclaimer;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:19.3"], "en": "the Gladdener and the Divider.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:19.4"], "en": "The cutter of the streams is praised:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:20.1"], "en": "one who is free from harshness, free from the dart [of craving],", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:20.2"], "en": "free from distress, and free from doubt.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:20.3"], "en": "Unshaken, stainless, the doer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:20.4"], "en": "the one who turns away from fragrances, the praised one,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:21.1"], "en": "the deliverer, the benefactor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:21.2", "PA_tha-ap_532:21.3"], "en": "One who causes [others] to act, one who has attained perfection; one who leads to evil, one who is associated with what is pleasant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:21.4"], "en": "a slayer, one who exerts himself, an ascetic.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:22.1"], "en": "Even-minded and equanimous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:22.2"], "en": "without companion, an abode of compassion;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:22.3"], "en": "a being of wonders, free from guile.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:22.4"], "en": "The seventh among the seers has accomplished his task.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:23.1"], "en": "Having crossed over doubt, free from conceit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:23.2"], "en": "he is immeasurable and incomparable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:23.3"], "en": "The Victor has transcended the path of all speech;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:23.4", "PA_tha-ap_532:24.1"], "en": "he is the one who has reached the end of what can be known through truth. In that most excellent essence of beings—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:24.2"], "en": "Confidence brings the deathless;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:24.3"], "en": "therefore, faith in the Buddha, the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:24.4"], "en": "and the Sangha is of great benefit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:25.1", "PA_tha-ap_532:25.2", "PA_tha-ap_532:25.3"], "en": "Praising him, the supreme refuge of the three worlds, with such qualities as these in the midst of the assembly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:25.4"], "en": "I gave a discourse on the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:26.1"], "en": "Having passed away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:26.2"], "en": "I experienced great happiness in the Tusita heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:26.3"], "en": "Passing away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:26.4"], "en": "I was born among humans as one who is fragrant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:27.1"], "en": "both my breath and the scent of my mouth [are sweet].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:27.2"], "en": "So too is the scent of my body;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:27.3"], "en": "there is always the scent of perspiration, yet for me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:27.4"], "en": "it becomes the scent of all fragrances.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:28.1"], "en": "The fragrance of my mouth is always like that of the lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:28.2"], "en": "the water-lily, and the campaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:28.3"], "en": "it wafts forth, ever serene.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:28.4"], "en": "And my body is likewise so.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:29.1"], "en": "The entirety of its purpose lies in its qualities,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:29.2"], "en": "while its fruit is most wonderful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:29.3"], "en": "With one-pointed minds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:29.4", "PA_tha-ap_532:30.1"], "en": "all of you listen to me as I describe the virtues of the Buddha. Having spoken of the Buddha’s qualities, [I shall speak further].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:30.2"], "en": "And there is nothing equal for one’s welfare;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:30.3"], "en": "I am happy everywhere,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:30.4"], "en": "where the Saṅgha is joined with heroes.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:31.1"], "en": "Famous, happy, beloved,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:31.2"], "en": "radiant, and pleasant to behold;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:31.3"], "en": "one who speaks well and is never despised.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:31.4"], "en": "Thus, one who is faultless and wise—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:32.1", "PA_tha-ap_532:32.2"], "en": "when life is exhausted, Nibbāna is easily attained by the devotee of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:32.3"], "en": "I shall explain the cause for them;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:32.4"], "en": "listen to it as it truly is.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:33.1"], "en": "Of the Blessed One’s peaceful glory,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:33.2"], "en": "By saluting according to the rule,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:33.3"], "en": "wherever I am reborn,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:33.4"], "en": "I become illustrious because of that.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:34.1"], "en": "Praising the Buddha, who brings an end to suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:34.2"], "en": "and the peaceful, unconditioned Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:34.3"], "en": "I was a giver of happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:34.4"], "en": "He was happier than all beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:35.1"], "en": "Praising the virtues of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:35.2"], "en": "he was filled with joy in the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:35.3"], "en": "He produced his own beauty and the beauty of others;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:35.4"], "en": "therefore he is \"Possessed of Beauty\" (Kantimā).", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:36.1"], "en": "O Victor, amidst those crowded with followers of other sects—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:36.2"], "en": "Having overcome the false teachers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:36.3", "PA_tha-ap_532:36.4"], "en": "I, the radiant one, then illumined the Leader by proclaiming his virtues.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:37.1"], "en": "Doing what is pleasing to people,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:37.2"], "en": "proclaiming the virtues of the Perfectly Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:37.3"], "en": "like the autumn moon together with its halo.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:37.4"], "en": "Because of that, I was beloved to behold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:38.1"], "en": "According to my own disposition,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:38.2"], "en": "I praised him with all my words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:38.3"], "en": "Therefore, you are a master of speech, O Sugata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:38.4"], "en": "possessed of manifold eloquence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:39.1"], "en": "for those fools who have fallen into doubt, [you provide the remedy].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:39.2"], "en": "They insulted the Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:39.3"], "en": "I restrained them with the True Dharma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:39.4"], "en": "yet I was not insulted by that.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:40.1"], "en": "By praising the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:40.2"], "en": "I dispel the defilements of beings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:40.3"], "en": "thus, my mind becomes free from defilement.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:40.4"], "en": "By the power of that deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:41.1", "PA_tha-ap_532:41.2"], "en": "I brought about the growth of those who heard [the teaching], as one who teaches the recollection of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:41.3"], "en": "Therefore I was wise,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:41.4"], "en": "possessing subtle insight into the meaning;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:42.1"], "en": "with all taints completely destroyed, I remained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:42.2"], "en": "Having crossed the ocean of saṃsāra,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:42.3"], "en": "like a cresting flame free from fuel,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:42.4"], "en": "I shall attain extinction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:43.1"], "en": "In this very eon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:43.2"], "en": "I praised the Conqueror;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:43.3"], "en": "I do not know any state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:43.4"], "en": "This is the fruit of praising the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:44.1", "PA_tha-ap_532:44.2"], "en": "my defilements have been incinerated... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:44.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:45.1", "PA_tha-ap_532:45.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:45.3"], "en": "The Buddha’s teaching has been proclaimed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:46.1", "PA_tha-ap_532:46.2"], "en": "the four analytical knowledges, and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:46.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:47.1"], "en": "In this way, it is said, the venerable elder Sugandha recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:48.1"], "en": "The legend of the elder Sugandha is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:49.1"], "en": "The fifty-third chapter: The Section on the Giver of Grass.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:50.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:51.1"], "en": "The giver of grass, and the bed, indeed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:51.2"], "en": "Saraṇabbhañjanappada,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:51.3"], "en": "Supaṭa, Daṇḍadāyin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:51.4"], "en": "and likewise Nelapūjin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:52.1"], "en": "The *Bodhisammajjaka*, the *Maṇḍa*,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:52.2"], "en": "and the *Sugandha* as the tenth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:52.3"], "en": "these comprise one hundred and twenty-seven verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_532:52.4"], "en": "And here, calculation is entirely complete.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
