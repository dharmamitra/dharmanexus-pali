{"segs": ["PA_ja_196:0.3"], "en": "Chapter on Ruhaka (Ruhakavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_196:0.4"], "en": "6. The Valāhakassa Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_196:1.1", "PA_ja_196:1.2"], "en": "“Those men who do not follow the instruction taught by the Buddha;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_196:1.3"], "en": "Those who do not follow this advice will meet with disaster,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_196:1.4"], "en": "like merchants at the hands of ogresses;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_196:2.1"], "en": "whereas those who do follow this advice...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_196:2.2", "PA_ja_196:2.3"], "en": "\"Those people who have been taught by the Buddha will reach safety on the further shore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_196:2.4"], "en": "just as merchants do with a cloud.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_196:3.1"], "en": "The Valāhaka Assa Jātaka is the sixth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
