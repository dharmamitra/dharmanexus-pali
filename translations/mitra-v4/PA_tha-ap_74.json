[
{"segs": ["PA_tha-ap_74:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:0.2"], "en": "Nāgasamāla Chapter 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:0.3"], "en": "The Apadāna of the Elder Padasaññaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:1.1"], "en": "“Having seen the footprint of Tissa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:1.2"], "en": "the kinsman of the Sun,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:1.3"], "en": "he was joyful with a joyful heart.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:1.4"], "en": "I gladdened my mind at his feet.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:2.1"], "en": "Ninety-two aeons ago from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:2.2"], "en": "that merit which I then obtained—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:2.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:2.4"], "en": "this is the fruit of mindfulness of the footprints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:3.1"], "en": "In the seventh aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:3.2"], "en": "A noble kshatriya named Sumedha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:3.3", "PA_tha-ap_74:3.4"], "en": "a wheel-turning monarch of great power, endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:4.1", "PA_tha-ap_74:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:5.1"], "en": "Thus indeed the venerable elder Padasaññaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_74:6.1"], "en": "This is the second legend of the elder Padasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
