[
{"segs": ["PA_ja_249:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_249:0.2", "PA_ja_249:0.3"], "en": "The Second Book of Pairs, The Chapter on the Jackal (Siṅgālavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_249:0.4"], "en": "9. The Sālakajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_249:1.1", "PA_ja_249:1.2"], "en": "\"You shall have an only son, and you shall be the master in our family.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_249:1.3"], "en": "“Descend from the tree, Sālaka;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_249:1.4"], "en": "come now, let us go to our home.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_249:2.1"], "en": "“Do you not think of me as one who is well-disposed?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_249:2.2"], "en": "\"And though you strike me with a bamboo staff,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_249:2.3", "PA_ja_249:2.4"], "en": "we still delight in the Pakkamba forest; go home as you please.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_249:3.1"], "en": "The Sālakajātakam, the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
