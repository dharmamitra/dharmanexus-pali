{"segs": ["PA_thag_1.43:0.4"], "en": "The Verses of the Elder Sumaṅgala:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.43:1.1"], "en": "“Truly liberated, truly liberated!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.43:1.2"], "en": "It is well that I am truly liberated from the three hunchbacks!”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.43:1.3"], "en": "\"By me were black plows used;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.43:1.4", "PA_thag_1.43:1.5"], "en": "by me were small hoes used. Even if it were just this, even just this,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.43:1.6"], "en": "\"Or rather, it is indeed enough, it is indeed enough!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.43:1.7"], "en": "Meditate, Sumaṅgala, meditate, Sumaṅgala!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.43:1.8"], "en": "Dwell heedfully, Sumaṅgala!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.43:1.9"], "en": "… the Elder Sumaṅgala …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
