[
{"segs": ["PA_iti_1:0.1"], "en": "Itivuttaka 1:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:0.2", "PA_iti_1:0.3"], "en": "The First Chapter of the Single-Verse Collection (Ekakanipāta)", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:0.4"], "en": "The Discourse on Greed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:1.1"], "en": "Thus it was said by the Blessed One, so I have heard:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:2.1"], "en": "\"Bhikkhus, abandon one thing.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:2.2"], "en": "I am your guarantor for non-returning.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:2.3"], "en": "What is that one thing?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:2.4"], "en": "Monks, abandon greed, which is that one thing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:2.5"], "en": "“I am your guarantor for non-returning.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:2.6", "PA_iti_1:2.7"], "en": "Thus spoke the Blessed One. Regarding this, it is said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:3.1", "PA_iti_1:3.2", "PA_iti_1:3.3"], "en": "“Having fully understood that greed by which beings, being greedy, go to an evil destination— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:3.4"], "en": "Those who possess insight abandon them;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:3.5", "PA_iti_1:3.6"], "en": "having abandoned them, they never again return to this world.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:4.1"], "en": "This matter too was spoken by the Blessed One; thus have I heard.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_1:4.2"], "en": "The first.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
