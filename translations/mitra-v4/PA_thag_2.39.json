[
{"segs": ["PA_thag_2.39:0.1", "PA_thag_2.39:0.2"], "en": "Theragāthā 2.39 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.39:0.3"], "en": "Catutthavagga (The Fourth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.39:0.4"], "en": "The Verse of the Elder Usabha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.39:1.1", "PA_thag_2.39:1.2"], "en": "“Having placed my robe, which resembles the young shoots of the *ambapalla* tree, upon my shoulder;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.39:1.3"], "en": "Seated upon the neck of the elephant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.39:1.4"], "en": "I entered the village for alms; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.39:2.1"], "en": "having descended from the elephant's back, I proceeded on foot.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.39:2.2"], "en": "I then attained a sense of spiritual urgency;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.39:2.3"], "en": "though I was then intoxicated with pride,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.39:2.4"], "en": "the destruction of the taints has now been reached by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.39:2.5"], "en": "… the Elder Usabha …", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
