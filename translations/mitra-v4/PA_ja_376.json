[
{"segs": ["PA_ja_376:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:0.2", "PA_ja_376:0.3"], "en": "The Sixth Book, Chapter on the Unobstructed (Avāriyavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:0.4"], "en": "1. The Avāriya Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:1.1"], "en": "\"Do not be angry, O Lord of the Earth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:1.2"], "en": "do not be angry, O Bull among Charioteers.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:1.3"], "en": "Not retaliating against one who is angry,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:1.4"], "en": "the king is honored by the realm,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:2.1"], "en": "whether in the village or in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:2.2"], "en": "Whether in a low place or on high ground,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:2.3"], "en": "I instruct you everywhere;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:2.4"], "en": "do not be angry, O bull among charioteers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:3.1", "PA_ja_376:3.2"], "en": "“In the past, there was a ferryman on the Ganges named Avāriyapitā;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:3.3"], "en": "having ferried people across before, [he later fell into the water].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:3.4"], "en": "Later he asks for his wages;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:3.5"], "en": "because of that, there is quarreling with him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:3.6"], "en": "and he does not increase in wealth.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:4.1", "PA_ja_376:4.2"], "en": "“O ferryman, my dear, ask only for one who has not yet crossed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:4.3"], "en": "for the mind of one who has crossed is indeed different.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:4.4"], "en": "Another belongs to others.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:5.1"], "en": "Whether in a village or in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:5.2"], "en": "whether in the lowlands or on high ground;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:5.3"], "en": "“I instruct you in all matters;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:5.4"], "en": "do not be angry, O boatman.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:6.1"], "en": "“By that very instruction...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:6.2"], "en": "The king gave him an excellent cow;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:6.3"], "en": "by that very instruction,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:6.4"], "en": "the boatman struck his own face.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:7.1"], "en": "The alms-food is broken, the wife is slain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:7.2"], "en": "and the fetus has fallen to the ground;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:7.3"], "en": "like a deer lured by gold, [I am caught].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:7.4"], "en": "\"He did not bind him for that purpose.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_376:8.1"], "en": "Thus ends the first Jātaka, the Avāriya Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
