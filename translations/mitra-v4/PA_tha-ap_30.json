[
{"segs": ["PA_tha-ap_30:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:0.2"], "en": "Subhūti Chapter 8:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:0.3"], "en": "The Apadāna of the Elder Uttiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:1.1"], "en": "“On the bank of the Candabhāgā River,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:1.2"], "en": "I was then a crocodile;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:1.3"], "en": "I was intent upon my own prey.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:1.4"], "en": "I went to a river crossing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:2.1"], "en": "At that time, Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:2.2"], "en": "the Self-Existent One, the Supreme Person;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:2.3"], "en": "Desiring to cross the river,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:2.4"], "en": "he approached a river-ford;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:3.1"], "en": "and when the Perfectly Enlightened One had arrived,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:3.2"], "en": "I also went there;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:3.3"], "en": "having approached the Fully Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:3.4"], "en": "I uttered these words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:4.1"], "en": "\"Ascend, O Great Hero;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:4.2", "PA_tha-ap_30:4.3"], "en": "I shall carry you across to my own ancestral realm.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:4.4"], "en": "\"Have compassion, O Great Sage!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:5.1"], "en": "Having heard my loud lamentation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:5.2"], "en": "the Great Sage ascended.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:5.3"], "en": "Joyful with a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:5.4", "PA_tha-ap_30:6.1"], "en": "I ferried the Leader of the World across to the further bank of the river.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:6.2"], "en": "Siddhattha, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:6.3"], "en": "comforted me there, saying:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:6.4"], "en": "\"You shall attain the Deathless.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:7.1"], "en": "Having passed away from that body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:7.2", "PA_tha-ap_30:7.3"], "en": "I came to the world of the gods and experienced divine bliss.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:7.4"], "en": "Honored by the celestial nymphs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:8.1", "PA_tha-ap_30:8.2"], "en": "I exercised the sovereignty of the gods seven times as the Lord of Devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:8.3"], "en": "Three times I was a wheel-turning monarch,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:8.4"], "en": "a lord of the earth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:9.1"], "en": "devoted to seclusion, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:9.2"], "en": "Discerning and well-restrained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:9.3", "PA_tha-ap_30:9.4"], "en": "I bear my final body within the teaching of the Perfectly Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:10.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:10.2"], "en": "I rescued that Bull among Men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:10.3"], "en": "I have not known a miserable rebirth since.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:10.4"], "en": "This fruit is for the sake of crossing over.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:11.1", "PA_tha-ap_30:11.2"], "en": "The four analytical knowledges and these eight liberations—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:11.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:11.4"], "en": "the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:12.1"], "en": "Thus indeed did the venerable elder Uttiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_30:13.1"], "en": "The legend of the Elder Uttiya is the eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
