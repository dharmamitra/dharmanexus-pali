[
{"segs": ["PA_kp_5:0.1", "PA_kp_5:0.2", "PA_kp_5:1.1"], "en": "Khuddakapāṭha 5 Maṅgalasutta Thus have I heard—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:1.2"], "en": "On one occasion the Blessed One was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:1.3"], "en": "Then a certain deity, in the deep of night, having illuminated the entire Jeta’s Grove with his surpassing beauty, approached the Blessed One. Having approached and paid homage to the Blessed One, he stood to one side.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:1.4"], "en": "Standing to one side, that deity addressed the Blessed One in verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:2.1", "PA_kp_5:2.2"], "en": "“Many gods and humans have pondered over auspicious signs,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:2.3"], "en": "desiring safety and well-being.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:2.4"], "en": "\"Tell me the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:3.1"], "en": "\"Not associating with fools,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:3.2"], "en": "but associating with the wise;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:3.3"], "en": "And honoring those worthy of honor—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:3.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:4.1"], "en": "And dwelling in a suitable locality—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:4.2"], "en": "Having performed merit in the past,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:4.3"], "en": "and right resolve for oneself—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:4.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:5.1"], "en": "Great learning and craft,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:5.2"], "en": "well-trained discipline,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:5.3"], "en": "and speech that is well-spoken—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:5.4"], "en": "This is the supreme blessing:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:6.1"], "en": "honoring one’s mother and father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:6.2"], "en": "and providing for one’s wife and children.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:6.3"], "en": "And orderly occupations—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:6.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:7.1"], "en": "Generosity and righteous conduct, and...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:7.2", "PA_kp_5:7.3"], "en": "Supporting one's relatives and performing blameless deeds—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:7.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:8.1"], "en": "Abstaining from evil,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:8.2"], "en": "refraining from intoxicants,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:8.3"], "en": "and heedfulness regarding all wholesome qualities.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:8.4"], "en": "This is the supreme blessing:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:9.1"], "en": "reverence, humility,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:9.2"], "en": "contentment, and gratitude.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:9.3"], "en": "Listening to the Dhamma at the proper time—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:9.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:10.1"], "en": "So too are patience and being easy to speak with.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:10.2", "PA_kp_5:10.3"], "en": "Beholding ascetics and discussing the Dhamma at the proper time—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:10.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:11.1"], "en": "Austerity and the holy life,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:11.2"], "en": "the vision of the noble truths,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:11.3"], "en": "and the realization of Nibbāna—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:11.4"], "en": "This is the supreme blessing:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:12.1", "PA_kp_5:12.2"], "en": "that the mind of one who is touched by the worldly conditions does not waver.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:12.3"], "en": "Sorrowless, stainless, and secure—", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:12.4"], "en": "this is the supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:13.1"], "en": "Having performed such deeds as these,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:13.2"], "en": "Unconquered everywhere,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:13.3"], "en": "they go everywhere in safety;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:13.4"], "en": "that is their supreme blessing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kp_5:14.1"], "en": "The Discourse on Blessings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"}
]
