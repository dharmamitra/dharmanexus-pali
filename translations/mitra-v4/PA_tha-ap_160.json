[
{"segs": ["PA_tha-ap_160:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:0.2"], "en": "Bandhujīvakavagga 8.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:0.3"], "en": "The Apadāna of the Elder Nāgapupphiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:1.1", "PA_tha-ap_160:1.2"], "en": "“A brahmin named Suvaccha, a master of the mantras,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:1.3"], "en": "was preceded by his disciples.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:1.4"], "en": "He dwelt within the mountain range.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:2.1", "PA_tha-ap_160:2.2"], "en": "The Victor named Padumuttara was the recipient of offerings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:2.3"], "en": "Desiring to lift me up,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:2.4"], "en": "he came into my presence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:3.1"], "en": "he walks back and forth in the air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:3.2"], "en": "It smoked and likewise blazed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:3.3"], "en": "having perceived my smile,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:3.4"], "en": "he departed facing the east.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:4.1"], "en": "Having seen that marvel,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:4.2"], "en": "that wonderful and hair-raising sight,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:4.3"], "en": "he took a nāgapuṣpa flower.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:4.4"], "en": "I scattered flowers upon the path he had traveled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:5.1"], "en": "In a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:5.2"], "en": "because of those flowers which I scattered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:5.3"], "en": "Through that clarity of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:5.4", "PA_tha-ap_160:6.1"], "en": "I did not fall into an evil rebirth for one hundred and thirty-one aeons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:6.2"], "en": "He was a king of great splendor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:6.3", "PA_tha-ap_160:6.4"], "en": "a wheel-turning monarch of mighty power, endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:7.1", "PA_tha-ap_160:7.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:7.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:8.1"], "en": "Thus indeed the venerable elder Nāgapupphiya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_160:9.1"], "en": "This is the eighth legend of the elder Nāgapupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
