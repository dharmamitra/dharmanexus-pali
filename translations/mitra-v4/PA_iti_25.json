[
{"segs": ["PA_iti_25:0.1", "PA_iti_25:0.2"], "en": "Itivuttaka 25 Ekakanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_25:0.3"], "en": "Third Chapter (Tatiyavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_25:0.4"], "en": "The Discourse on False Speech.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_25:1.1"], "en": "This was said by the Blessed One, said by the Arahant; thus have I heard:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_25:2.1"], "en": "\"Monks, for a person who has transgressed in one thing, I say there is no evil deed that he would not do.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_25:2.2"], "en": "\"What is that one thing?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_25:2.3"], "en": "It is this, monks: deliberate lying.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_25:2.4"], "en": "Thus the Blessed One spoke this matter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_25:2.5"], "en": "In this regard, it is said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_25:3.1", "PA_iti_25:3.2"], "en": "\"For a person who has transgressed against this one thing, the speaker of falsehood,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_25:3.3", "PA_iti_25:3.4"], "en": "“For one who has abandoned the world beyond, there is no evil that should not be done.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_25:4.1"], "en": "This matter was also spoken by the Blessed One; thus have I heard.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_iti_25:4.2"], "en": "The fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
