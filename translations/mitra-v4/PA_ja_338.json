[
{"segs": ["PA_ja_338:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:0.2", "PA_ja_338:0.3"], "en": "Catukkanipāta, Kokilavagga (The Chapter on the Cuckoo)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:0.4", "PA_ja_338:1.1"], "en": "8. The Thusa Jātaka “The husk is known to mice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:1.2"], "en": "but the grain within is not.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:1.3"], "en": "Having discarded husk after husk,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:1.4"], "en": "they eat the grain within;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:2.1"], "en": "such is the deliberation in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:2.2", "PA_ja_338:2.3"], "en": "And whatever secret whispering there is in the village, and this \"thus\" and \"so\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:2.4"], "en": "all that too is known by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:3.1"], "en": "According to the Dhamma, indeed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:3.2"], "en": "the father of this boy born was a monkey;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:3.3"], "en": "while he was still but a child, [the mother was a human].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:3.4"], "en": "You have bitten off the fruit with your teeth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:4.1"], "en": "As you crawl about here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:4.2"], "en": "you are like a one-eyed goat among mustard seeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:4.3"], "en": "\"And that which lies below—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:4.4"], "en": "this too is known by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_338:5.1"], "en": "Thus ends the eighth Jātaka, the Thusa-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
