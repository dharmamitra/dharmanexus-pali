[
{"segs": ["PA_ja_529:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:0.2"], "en": "The Sixty-Nipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:0.3"], "en": "the Soṇaka Chapter", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:0.4"], "en": "1. The Soṇaka Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:1.1"], "en": "“Having heard of him, I give a hundred;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:1.2"], "en": "having seen Soṇaka, I give a thousand.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:1.3", "PA_ja_529:1.4"], "en": "“Who will tell me of that friend with whom I played in the dust?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:2.1"], "en": "Then the young man spoke:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:2.2"], "en": "\"A young boy with five tufts of hair;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:2.3"], "en": "having heard me, give a hundred;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:2.4"], "en": "having seen Soṇaka, give a thousand.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:2.5", "PA_ja_529:2.6"], "en": "“I am that Soṇakakkhi, your friend with whom you played in the dust.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:3.1"], "en": "“In which country was he?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:3.2", "PA_ja_529:3.3"], "en": "In kingdoms and in market towns; where did you see Soṇaka?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:3.4"], "en": "Tell me that when asked.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:4.1"], "en": "“Right here in Your Majesty’s own realm,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:4.2"], "en": "right here on Your Majesty’s own park grounds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:4.3"], "en": "stand these great sal trees with straight trunks.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:4.4"], "en": "Blue-hued and delightful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:5.1"], "en": "they stand like clouds—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:5.2"], "en": "charming, leaning one upon another.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:5.3", "PA_ja_529:5.4"], "en": "At their root, Soṇaka meditates without clinging,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:5.5"], "en": "amidst the worlds of clinging.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:5.6"], "en": "While they were burning, he remained extinguished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:6.1", "PA_ja_529:6.2"], "en": "Then King Pāyāsi set out with his fourfold army.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:6.3"], "en": "Having had the road leveled,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:6.4", "PA_ja_529:7.1"], "en": "he went toward Soṇaka; having reached the park grounds, he proceeded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:7.2"], "en": "Wandering through the great forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:7.3"], "en": "he saw Soṇaka sitting there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:7.4"], "en": "extinguished even as the world was burning.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:8.1"], "en": "“Alas, this bhikkhu is truly pitiable;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:8.2"], "en": "shaven-headed and clad in the outer robe,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:8.3"], "en": "he has neither mother nor father.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:8.4"], "en": "“He meditates at the foot of a tree.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:9.1"], "en": "Having heard these words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:9.2"], "en": "Soṇaka spoke as follows:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:9.3"], "en": "“A king does not become a pauper, O King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:9.4"], "en": "by practicing the Dhamma with his body;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:10.1"], "en": "but he who, having rejected the Dhamma— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:10.2", "PA_ja_529:10.3"], "en": "He follows what is contrary to the Dhamma; that king is wretched,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:10.4"], "en": "an evildoer whose destiny is evil.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:11.1"], "en": "“My name is Arindama,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:11.2"], "en": "and I am known as the King of Kāsi;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:11.3"], "en": "I hope you have slept well, sir?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:11.4"], "en": "\"O Soṇaka, for one who has attained this here:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:12.1", "PA_ja_529:12.2"], "en": "'For the bhikkhu who is always without wealth, who is homeless,' \"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:12.3"], "en": "They do not store it in granaries,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:12.4", "PA_ja_529:12.5"], "en": "nor in jars, nor in pits; seeking what has been prepared by others, they live on alms.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:12.6"], "en": "By that, those of good vows maintain themselves.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:13.1", "PA_ja_529:13.2"], "en": "This, too, is for the bhikkhu who has gone forth, the fortunate one who is homeless.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:13.3"], "en": "One should eat blameless alms-food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:13.4"], "en": "so that no one is obstructed. This,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:14.1"], "en": "O Bhadda, is the third [virtue] of one who possesses little.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:14.2"], "en": "For the homeless monk,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:14.3"], "en": "the alms-food should be eaten as one who is extinguished,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:14.4"], "en": "and no one shall obstruct him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:15.1"], "en": "For a fourth time, for the fortunate one,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:15.2", "PA_ja_529:15.3"], "en": "the homeless monk who wanders through the kingdom free from attachment, [there is no fear].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:15.4"], "en": "For one in whom attachment does not exist—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:16.1", "PA_ja_529:16.2"], "en": "this is the fifth blessing for the houseless bhikkhu who possesses nothing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:16.3"], "en": "While the city was burning,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:16.4"], "en": "nothing belonging to him burned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:17.1"], "en": "this was the sixth blessing of Bhaddamāṇava.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:17.2"], "en": "For the homeless bhikkhu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:17.3"], "en": "when the kingdom is being plundered,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:17.4"], "en": "there is nothing for which he feels shame.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:18.1"], "en": "Even for the seventh time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:18.2", "PA_ja_529:18.3"], "en": "this path guarded by thieves belongs to the fortunate one, the homeless bhikkhu.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:18.4"], "en": "And whatever other highway robbers there may be,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:18.5"], "en": "taking his bowl and robe,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:18.6"], "en": "the one of good vows goes safely.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:19.1", "PA_ja_529:19.2"], "en": "For the eighth time, this is the blessing for the one who has no wealth, the homeless monk:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:19.3"], "en": "in whichever direction he sets out, [there he finds happiness].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:19.4"], "en": "“He goes indeed without longing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:20.1"], "en": "“Many are the blessings of the recluse,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:20.2"], "en": "O bhikkhu, which you praise;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:20.3"], "en": "And I am greedy for sensual pleasures;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:20.4"], "en": "how shall I act, Soṇaka?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:21.1"], "en": "Human pleasures are dear to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:21.2"], "en": "And even the divine realms are dear to me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:21.3"], "en": "by what means, then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:21.4"], "en": "may we obtain both worlds?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:22.1"], "en": "“Greedy for sensual pleasures, delighting in sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:22.2"], "en": "and infatuated with sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:22.3"], "en": "people, having committed evil deeds, [fall into hell].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:22.4"], "en": "They are reborn in an evil destination.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:23.1"], "en": "But those who, having abandoned sensual desires,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:23.2"], "en": "have gone forth, are free from fear from every quarter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:23.3"], "en": "Having attained one-pointedness of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:23.4"], "en": "they do not go to an evil destination.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:24.1"], "en": "I shall give you a simile.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:24.2"], "en": "Listen to that, O subduer of enemies;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:24.3", "PA_ja_529:24.4"], "en": "for in this world, some wise people understand the meaning through a simile.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:25.1", "PA_ja_529:25.2"], "en": "Seeing a corpse being carried away by the current in the great ocean upon the Ganges,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:25.3"], "en": "a crow reflected:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:25.4"], "en": "“Of little wisdom and no mind, [he thinks]:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:26.1"], "en": "‘Indeed, this vehicle has been obtained,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:26.2"], "en": "and this food is no small amount.’”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:26.3"], "en": "There by night, there by day,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:26.4"], "en": "the mind is devoted to that very place,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:27.1"], "en": "eating the flesh of the naga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:27.2", "PA_ja_529:27.3"], "en": "Drinking the water of the Bhāgīrathī and observing the sacred shrines in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:27.4"], "en": "the bird did not flee.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:28.1"], "en": "And that Ganges, which was easy to descend,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:28.2", "PA_ja_529:28.3"], "en": "seized the negligent one who delighted in the corpse and carried him into the ocean.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:28.4"], "en": "Where there is no path for birds, that bird,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:29.1"], "en": "his food exhausted, having flown up,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:29.2"], "en": "became a sky-dweller.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:29.3"], "en": "Neither behind nor before,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:29.4"], "en": "neither above nor to the right—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:30.1"], "en": "such an island he did not find, nor did he go to one.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:30.2"], "en": "Where there is no refuge for birds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:30.3"], "en": "he fell right there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:30.4"], "en": "just like the weakling.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:31.1"], "en": "And the sea fish,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:31.2"], "en": "crocodiles, sharks, and susūs,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:31.3"], "en": "as well as the pasayhakāras, devoured him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:31.4"], "en": "Just as a struggling opponent,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:32.1"], "en": "even so are you, O King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:32.2"], "en": "and others who enjoy sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:32.3"], "en": "If they do not vomit out their greed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:32.4"], "en": "those wise ones are like crows in their discernment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:33.1"], "en": "This, O King, is the simile for you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:33.2"], "en": "The demonstration of the goal has been made;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:33.3"], "en": "you yourself will be known by it,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:33.4"], "en": "whether you act upon it or not.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:34.1", "PA_ja_529:34.2"], "en": "An empathetic person may speak once or twice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:34.3"], "en": "but should not speak more than that.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:34.4"], "en": "“Go to the presence of Dāsaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:35.1", "PA_ja_529:35.2"], "en": "Having said this, Soṇaka of immeasurable wisdom departed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:35.3", "PA_ja_529:35.4"], "en": "Having instructed the khattiya from the sky while hovering in the air, he said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:36.1"], "en": "\"Who indeed are my king-makers?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:36.2"], "en": "The Suddas have attained proficiency;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:36.3"], "en": "I shall hand over the kingdom,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:36.4"], "en": "for I am not one who seeks sovereignty.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:37.1"], "en": "I shall go forth this very day;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:37.2"], "en": "who knows if death will come tomorrow?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:37.3"], "en": "Lest I be like a witless crow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:37.4"], "en": "“Having come under the sway of sensual desires.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:38.1"], "en": "“You have a young son,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:38.2"], "en": "Dīghāvu, the increaser of the kingdom;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:38.3"], "en": "“Consecrate him in the kingdom;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:38.4", "PA_ja_529:39.1"], "en": "he shall be our king. “Bring the prince here quickly!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:39.2"], "en": "Dīghāvu, the increaser of the kingdom—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:39.3"], "en": "him I shall consecrate in the kingship;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:39.4"], "en": "he shall be your king.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:40.1", "PA_ja_529:40.2"], "en": "Then they brought the prince Dīghāvu, the increaser of the kingdom;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:40.3"], "en": "seeing him, the king addressed him:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:40.4"], "en": "A single son, delightful to the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:41.1"], "en": "\"Sixty thousand villages,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:41.2"], "en": "complete in every respect;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:41.3"], "en": "Follow that path, my son;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:41.4"], "en": "I entrust the kingdom to you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:42.1"], "en": "This very day I shall go forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:42.2"], "en": "Who knows that death may come tomorrow?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:42.3"], "en": "Let me not, like a foolish crow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:42.4"], "en": "fall under the power of sensual desires.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:43.1"], "en": "Sixty thousand elephants,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:43.2"], "en": "adorned with every ornament,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:43.3"], "en": "noble tuskers with golden girths—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:43.4"], "en": "Clad in golden-colored garments,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:44.1", "PA_ja_529:44.2"], "en": "they were mounted by village chiefs who held spears and goads in their hands.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:44.3"], "en": "\"O son, follow this practice;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:44.4"], "en": "I entrust the kingdom to you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:45.1"], "en": "This very day I shall go forth.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:45.2"], "en": "Who knows that death may come tomorrow?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:45.3"], "en": "Let me not, like a witless crow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:45.4"], "en": "fall under the power of sensual desires.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:46.1"], "en": "Sixty thousand horses,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:46.2"], "en": "adorned with every ornament,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:46.3"], "en": "noble by birth like thoroughbreds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:46.4", "PA_ja_529:47.1", "PA_ja_529:47.2"], "en": "The swift-moving horses from Sindhu were mounted by village chiefs bearing quivers and bows.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:47.3"], "en": "\"O son, follow this path;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:47.4"], "en": "I entrust the kingdom to you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:48.1"], "en": "This very day, I shall go forth.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:48.2"], "en": "Who knows that death may come tomorrow?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:48.3"], "en": "Let me not, like a witless crow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:48.4"], "en": "fall under the power of sensual desires.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:49.1"], "en": "Sixty thousand chariots,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:49.2"], "en": "armored and with banners raised—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:49.3"], "en": "some adorned with elephants' skins and others with tiger skins.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:49.4"], "en": "Adorned with every ornament,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:50.1", "PA_ja_529:50.2"], "en": "they were mounted by village chiefs who carried bows in their hands and wore armor.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:50.3"], "en": "\"O son, follow this path;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:50.4"], "en": "I entrust the kingdom to you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:51.1"], "en": "This very day I shall go forth.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:51.2"], "en": "Who knows that death will come tomorrow?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:51.3"], "en": "Let me not, like a witless crow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:51.4"], "en": "fall under the power of sensual desires.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:52.1"], "en": "Sixty thousand milch cows,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:52.2"], "en": "with Rohaṇa bulls as their leaders—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:52.3"], "en": "O son, attend to them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:52.4"], "en": "I hand over the kingdom to you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:53.1"], "en": "I shall go forth this very day,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:53.2"], "en": "for who knows if death will come tomorrow?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:53.3"], "en": "May I not, like a foolish crow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:53.4"], "en": "fall under the power of sensual desires.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:54.1"], "en": "[There were] sixteen thousand women...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:54.2"], "en": "Adorned with every ornament,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:54.3"], "en": "wearing variegated garments and jewelry,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:54.4"], "en": "and having donned jeweled earrings;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:54.5"], "en": "Therefore, my son, follow this path;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:54.6"], "en": "I entrust the kingdom to you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:55.1"], "en": "This very day, I shall go forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:55.2"], "en": "Who knows that death may come tomorrow?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:55.3"], "en": "Let me not, like a witless crow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:55.4"], "en": "fall under the power of sensual desires.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:56.1"], "en": "“While I was still very young, father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:56.2"], "en": "I heard that my mother had died;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:56.3"], "en": "without you, father, I— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:56.4"], "en": "I would not even dare to live.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:57.1", "PA_ja_529:57.2"], "en": "Just as a young calf follows behind a forest elephant, so do I follow you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:57.3"], "en": "Whether on mountain passes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:57.4", "PA_ja_529:58.1"], "en": "in rugged terrain, or on even and uneven ground— thus do I follow you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:58.2"], "en": "Taking up my bowl from behind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:58.3"], "en": "I shall be easy to support for you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:58.4"], "en": "I will not be difficult to support for you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:59.1", "PA_ja_529:59.2", "PA_ja_529:59.3"], "en": "“Just as a merchant seeking wealth might take up his business on a sea-going ship;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:59.4"], "en": "A merchant might meet with misfortune;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:60.1", "PA_ja_529:60.2"], "en": "even so, this wretched son of mine is an obstacle to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:60.3", "PA_ja_529:60.4"], "en": "\"Lead this prince to the palace that increases delight; there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:61.1"], "en": "with water-jars in hand,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:61.2"], "en": "Just as Apsarases delight Sakka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:61.3"], "en": "so they will delight him there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:61.4"], "en": "and he will delight with them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:62.1", "PA_ja_529:62.2"], "en": "Then they led the prince to the pleasure-increasing palace;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:62.3"], "en": "seeing him, the maidens spoke.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:62.4"], "en": "Long-lived one, increaser of the kingdom!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:63.1"], "en": "Are you a deity, or a gandhabba,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:63.2"], "en": "or perhaps Sakka Purindada?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:63.3"], "en": "“Who are you, or whose son are you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:63.4"], "en": "How may we know you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:64.1"], "en": "“I am neither a deva nor a gandhabba.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:64.2"], "en": "Nor am I Purindada, Sakka;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:64.3"], "en": "I am the son of the King of Kāsi,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:64.4"], "en": "Dīghāvu, the increaser of the realm.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:64.5", "PA_ja_529:64.6"], "en": "“Support me; may it be well with you; I shall be your husband.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:65.1"], "en": "To him there, the maidens said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:65.2", "PA_ja_529:65.3"], "en": "“Where has King Dīghāvu, the increaser of the kingdom, arrived?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:65.4"], "en": "Where has the king gone from here?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:66.1"], "en": "“The king has crossed over the mire;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:66.2"], "en": "the king is established on firm ground;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:66.3"], "en": "he is free from thorns and free from thickets.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:66.4"], "en": "I am practicing the great path;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:67.1", "PA_ja_529:67.2"], "en": "yet I am also practicing the path that leads to an evil destination.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:67.3", "PA_ja_529:67.4"], "en": "Thorny and overgrown, by which they go to a miserable destination.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:68.1"], "en": "“Welcome to you, O King! [he said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:68.2"], "en": "Like a lion from Giribbaja;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:68.3"], "en": "instruct us, O Great King,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:68.4"], "en": "for you are the lord of us all.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_529:69.1"], "en": "The Soṇaka Jātaka is the first.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
