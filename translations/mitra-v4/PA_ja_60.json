[
{"segs": ["PA_ja_60:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_60:0.2", "PA_ja_60:0.3"], "en": "Ekakanipāta, Āsīsavagga (The Chapter on Aspirations)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_60:0.4"], "en": "10. The Saṅkhadhamajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_60:1.1"], "en": "“Blow, blow, but do not overblow;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_60:1.2"], "en": "for overblowing is indeed evil.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_60:1.3"], "en": "“Riches were acquired by me through blowing [the conch];", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_60:1.4"], "en": "those I am now blowing away, Father.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_60:2.1"], "en": "Thus ends the tenth Jātaka, the Saṅkhadhamajātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_60:2.2"], "en": "The sixth chapter: The Chapter on Aspiration.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_60:3.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_60:4.1"], "en": "\"Just as I wished, so it was; from water and from land.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_60:4.2"], "en": "Sura, Sāduphala, and Alīnamana;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_60:4.3"], "en": "Sampahaṭṭhamana, Caturo, and Tayo;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_60:4.4"], "en": "and Sataladdhaka—these ten by means of wealth and property.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
