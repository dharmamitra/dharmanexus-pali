[
{"segs": ["PA_bu-vb_sk31:0.1"], "en": "The Theravāda Vinaya Mahāvibhaṅga:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:0.2", "PA_bu-vb_sk31:0.3"], "en": "The Section on Training Rules (Sekhiyakaṇḍa)", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:0.4"], "en": "Sakkaccavagga 31.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:0.5"], "en": "The Training Rule on Thoroughness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:1.1"], "en": "At that time the Buddha, the Blessed One, was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:1.2"], "en": "Now at that time, the group-of-six monks ate almsfood disrespectfully, as if they did not wish to eat... [etc.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:1.3.1"], "en": "\"The training is to be observed: 'I will eat almsfood respectfully.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:1.4"], "en": "Almsfood is to be eaten respectfully.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:1.5"], "en": "Whoever, out of disrespect, eats almsfood without due care, commits an offense of wrong-doing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:1.6.1", "PA_bu-vb_sk31:1.7"], "en": "There is no offense if it was unintentional.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:1.8", "PA_bu-vb_sk31:1.9", "PA_bu-vb_sk31:1.10"], "en": "In the case of one who is lacking mindfulness, one who is unaware, or one who is ill.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:1.11"], "en": "In cases of misfortune,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:1.12"], "en": "for one who is insane,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:1.13"], "en": "and for the first offender.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk31:1.14"], "en": "The first training rule is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
