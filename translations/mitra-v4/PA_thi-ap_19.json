[
{"segs": ["PA_thi-ap_19:0.1", "PA_thi-ap_19:0.2"], "en": "Therīapadāna Ekūposathikavagga 9.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:0.3"], "en": "Uppalavaṇṇātherīapadāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:1.1"], "en": "“The bhikkhunī Uppalavaṇṇā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:1.2"], "en": "who had reached perfection in psychic power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:1.3"], "en": "having paid homage at the feet of the Teacher, [spoke thus].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:1.4"], "en": "He spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:2.1"], "en": "\"I have crossed over the cycle of birth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:2.2"], "en": "I have attained the unshakable state.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:2.3"], "en": "\"All suffering has been exhausted by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:2.4"], "en": "I announce this, O Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:3.1"], "en": "to as great an assembly as there is.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:3.2"], "en": "They have faith in the teaching of the Jina;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:3.3"], "en": "and whoever has committed an offense against me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:3.4"], "en": "may they forgive me in the presence of the Jina.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:4.1"], "en": "If, as I wander through saṃsāra,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:4.2"], "en": "I have committed any lapse,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:4.3"], "en": "I confess it, O Great Hero.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:4.4"], "en": "\"Forgive that transgression of mine.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:5.1"], "en": "\"And demonstrate your supernormal power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:5.2"], "en": "O follower of my teaching!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:5.3", "PA_thi-ap_19:5.4"], "en": "\"Today, O Great Hero, cut through the doubt of the four assemblies as far as they extend:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:6.1"], "en": "'She is your daughter, O Great Hero.'\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:6.2"], "en": "O wise one, bearer of radiance;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:6.3"], "en": "much difficult work has been done by me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:6.4"], "en": "exceedingly difficult to perform.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:7.1"], "en": "My complexion is like that of a blue lotus;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:7.2"], "en": "my name is Uppalavaṇṇā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:7.3"], "en": "I am your disciple, O Great Hero.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:7.4"], "en": "I pay homage at the feet of the One with Vision.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:8.1"], "en": "Both Rāhula and I,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:8.2"], "en": "through many hundreds of numerous births;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:8.3"], "en": "Born from a single source,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:8.4"], "en": "with identical inclinations and minds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:9.1"], "en": "their rebirth occurs together as one.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:9.2"], "en": "And though they were of the same birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:9.3"], "en": "when their final existence was reached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:9.4"], "en": "both arose from different origins.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:10.1"], "en": "My son is named Rāhula,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:10.2"], "en": "and my daughter is called Uppalavaṇṇā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:10.3"], "en": "behold, O Hero, my supernatural power!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:10.4"], "en": "\"I shall demonstrate my power to the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:11.1", "PA_thi-ap_19:11.2"], "en": "He cast four [fists] from his cupped hands into the great ocean.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:11.3"], "en": "Like a child at play,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:11.4", "PA_thi-ap_19:12.1"], "en": "he has turned over the earth as if it were a ball held in his hand.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:12.2"], "en": "He placed it in his hand-palm;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:12.3", "PA_thi-ap_19:12.4"], "en": "just as a young man might pluck a tuft of *citta* grass.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:13.1", "PA_thi-ap_19:13.2"], "en": "Having covered his head with a hand the size of a world-system,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:13.3"], "en": "he caused a single drop of rain to fall.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:13.4"], "en": "Repeatedly of various colors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:14.1"], "en": "Having made the earth a mortar,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:14.2"], "en": "and having made grain sugar-candy;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:14.3"], "en": "“Having made Mount Sineru a pestle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:14.4"], "en": "just as Maddi the young maiden did;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:15.1"], "en": "I am the daughter of the Best of Buddhas.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:15.2", "PA_thi-ap_19:15.3", "PA_thi-ap_19:15.4"], "en": "Named Uppalā, she has attained mastery over the higher knowledges and carries out your teaching.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:16.1", "PA_thi-ap_19:16.2"], "en": "Having performed various transformations and shown himself to the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:16.3"], "en": "he announced his name and lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:16.4"], "en": "I pay homage at the feet of the One with Vision.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:17.1", "PA_thi-ap_19:17.2"], "en": "I am a master of the supernormal powers and of the divine ear-element.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:17.3", "PA_thi-ap_19:17.4"], "en": "I am a master of the knowledge of the minds of others, O Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:18.1"], "en": "I know my former births.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:18.2"], "en": "The divine eye has been purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:18.3"], "en": "all taints are utterly destroyed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:18.4"], "en": "there is now no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:19.1"], "en": "In the meanings, the phenomena, the definitions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:19.2"], "en": "and likewise in inspired eloquence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:19.3"], "en": "my knowledge is stainless and pure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:19.4", "PA_thi-ap_19:20.1", "PA_thi-ap_19:20.2"], "en": "By his very nature, the Great Sage has demonstrated his meeting with the previous Conquerors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:20.3", "PA_thi-ap_19:20.4"], "en": "O Great Sage, for your sake I have fulfilled a great office;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:21.1"], "en": "whatever karma was performed by me, [it was for you].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:21.2"], "en": "O Sage, remember my wholesome deed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:21.3"], "en": "for your sake, O Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:21.4"], "en": "merit has been accumulated by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:22.1", "PA_thi-ap_19:22.2"], "en": "Avoiding what is impossible and restraining improper conduct—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:22.3"], "en": "for your sake, O Great Hero—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:22.4"], "en": "I have renounced my supreme life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:23.1"], "en": "For ten thousand times ten million,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:23.2"], "en": "I gave away my very life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:23.3", "PA_thi-ap_19:23.4"], "en": "\"And I am surrendered to you for your sake, O Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:24.1"], "en": "Then they were all utterly amazed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:24.2"], "en": "With his head bowed and palms joined in reverence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:24.3"], "en": "he said: “Tell me, Noble Lady, how it was for you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:24.4"], "en": "who possessed incomparable psychic power and prowess.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:25.1"], "en": "One hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:25.2"], "en": "I was then a Naga maiden,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:25.3"], "en": "Vimalā by name.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:25.4"], "en": "Highly esteemed among maidens;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:26.1"], "en": "a great naga, a mighty serpent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:26.2"], "en": "full of faith in the Conqueror’s teaching.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:26.3", "PA_thi-ap_19:26.4"], "en": "He invited the one of great majesty, Padumuttara, together with his disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:27.1"], "en": "to a pavilion made of jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:27.2"], "en": "A throne made of jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:27.3"], "en": "strewn with jeweled sand,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:27.4"], "en": "and a couch made of jewels for his enjoyment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:28.1", "PA_thi-ap_19:28.2"], "en": "He prepared a path adorned with the banner of jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:28.3"], "en": "and having gone out to meet the Fully Awakened One, he...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:28.4", "PA_thi-ap_19:29.1"], "en": "Accompanied by musical instruments and surrounded by the fourfold assembly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:29.2"], "en": "the Leader of the World proceeded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:29.3"], "en": "In the abode of the mahoraga,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:29.4"], "en": "he sat upon a supreme throne.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:30.1"], "en": "Food, drink, and solid refreshment—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:30.2"], "en": "And he gave him costly food;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:30.3", "PA_thi-ap_19:30.4"], "en": "the highly renowned Naga king bestowed upon him the very best of gifts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:31.1"], "en": "Having eaten, the Sambuddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:31.2"], "en": "having properly washed his bowl,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:31.3"], "en": "performed an act of thanksgiving.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:31.4"], "en": "The Naga maidens of great psychic power,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:32.1"], "en": "seeing the All-Knowing One in full bloom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:32.2"], "en": "[beheld] the Naga maidens of great renown.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:32.3"], "en": "The Teacher’s mind is serene,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:32.4"], "en": "and his mental faculty is well-restrained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:33.1"], "en": "having understood my own mind as well, [he spoke].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:33.2"], "en": "Named Jalajuttama;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:33.3", "PA_thi-ap_19:33.4"], "en": "at that moment, the Great Hero displayed his supernormal power to the bhikkhunī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:34.1", "PA_thi-ap_19:34.2"], "en": "That confident bhikkhunī displayed manifold supernormal powers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:34.3"], "en": "she was filled with joy and inspired by rapture.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:34.4"], "en": "He said this to the Teacher:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:35.1"], "en": "“I have seen this psychic power of Sumana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:35.2"], "en": "and that of the other as well.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:35.3", "PA_thi-ap_19:35.4"], "en": "\"How did she become so confident in her psychic power, O Hero?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:36.1"], "en": "Born from your own breast, born from your mouth...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:36.2"], "en": "My daughter possesses great supernormal power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:36.3", "PA_thi-ap_19:36.4"], "en": "she follows my instructions and is highly proficient in psychic powers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:37.1"], "en": "Having heard the Buddha’s word,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:37.2"], "en": "I then made this aspiration:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:37.3"], "en": "“May I too become such as he.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:37.4"], "en": "Highly proficient in supernormal powers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:38.1"], "en": "joyful and well-disposed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:38.2"], "en": "with my mind set on the supreme goal, I made this aspiration.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:38.3"], "en": "\"In a future time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:38.4"], "en": "may I become such a leader,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:39.1"], "en": "seated upon a couch made of jewels.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:39.2"], "en": "In a radiant pavilion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:39.3", "PA_thi-ap_19:39.4"], "en": "having satisfied the Leader of the World together with his Saṅgha with food and drink.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:40.1", "PA_thi-ap_19:40.2"], "en": "The preeminent flower of the nāgas is the blue lotus named Aruṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:40.3"], "en": "\"May my complexion be like this,\" [he thought].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:40.4"], "en": "I worshipped the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:41.1"], "en": "By that well-performed deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:41.2"], "en": "and by my volition and aspiration;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:41.3"], "en": "Having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:41.4"], "en": "I went to the realm of the Thirty-three; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:42.1"], "en": "passing away from there, I was born among humans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:42.2"], "en": "The Self-Existent Ones were reborn there;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:42.3", "PA_thi-ap_19:42.4"], "en": "I gave them almsfood covered with lotuses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:43.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:43.2"], "en": "a leader named Vipassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:43.3"], "en": "of beautiful appearance, arose.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:43.4"], "en": "The one with eyes regarding all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:44.1", "PA_thi-ap_19:44.2"], "en": "having then been the daughter of a wealthy merchant in the supreme city of Bārāṇasī;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:44.3"], "en": "Having invited the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:44.4"], "en": "the Leader of the World, together with the Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:45.1"], "en": "and having bestowed a great gift,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:45.2", "PA_thi-ap_19:45.3"], "en": "Having worshipped the Guide with lotuses through my mind alone,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:45.4"], "en": "I aspired for the splendor of beauty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:46.1"], "en": "In this auspicious eon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:46.2"], "en": "there was one of great renown, a kinsman of Brahmā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:46.3"], "en": "known by the clan name Kassapa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:46.4"], "en": "The best among those who debate was born.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:47.1", "PA_thi-ap_19:47.2"], "en": "At that time, the lord of men was the attendant of the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:47.3", "PA_thi-ap_19:47.4"], "en": "In the supreme city of Bārāṇasī, there was a king of Kāsi named Kikī;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:48.1"], "en": "I was his second daughter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:48.2"], "en": "Known by the name Samaṇagutta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:48.3"], "en": "having heard the Dhamma from the Conqueror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:48.4"], "en": "I resolved to go forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:49.1"], "en": "Our father did not grant us permission then;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:49.2", "PA_thi-ap_19:49.3"], "en": "we remained right there in the home for twenty thousand years.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:49.4"], "en": "We practiced diligently,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:50.1", "PA_thi-ap_19:50.2"], "en": "O princess raised in luxury, in the celibate life of a maiden.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:50.3", "PA_thi-ap_19:50.4"], "en": "The seven daughters were devoted to attending upon the Buddha, joyful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:51.1"], "en": "the female ascetic (samaṇī) and Samaṇaguttā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:51.2"], "en": "The nun Bhikkhudāyikā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:51.3"], "en": "and both Dhammā and Sudhammā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:51.4"], "en": "the seventh was Saṅghadāyikā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:52.1"], "en": "I, Khemā, and Sappaññā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:52.2"], "en": "Paṭācārā and Kuṇḍalā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:52.3"], "en": "Kisāgotamī and Dhammadinnā—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:52.4"], "en": "Visākhā was the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:53.1", "PA_thi-ap_19:53.2"], "en": "By those well-performed deeds and by her intentions and aspirations, [she attained this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:53.3"], "en": "Having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:53.4"], "en": "I went to the realm of the Thirty-three; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:54.1"], "en": "passing away from there, I was born among humans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:54.2"], "en": "I was reborn in a great family;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:54.3", "PA_thi-ap_19:54.4"], "en": "I gave a fine, polished, excellent cloth to an Arahant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:55.1"], "en": "Having passed away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:55.2", "PA_thi-ap_19:55.3"], "en": "I was born in Ariṭṭhapura into a brahmin family as the daughter of Tiriṭivaccha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:55.4"], "en": "I was Ummadantī, so enchanting.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:56.1"], "en": "Having passed away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:56.2"], "en": "I was born in a certain family in a particular country.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:56.3"], "en": "Having recently given birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:56.4"], "en": "I was not yet fully recovered when I was guarding the rice at that time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:57.1"], "en": "then, I saw a Paccekabuddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:57.2", "PA_thi-ap_19:57.3"], "en": "Having given five hundred handfuls of parched grain covered with lotuses here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:57.4"], "en": "I have now obtained five hundred sons here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:58.1"], "en": "I made a wish, and they too made wishes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:58.2"], "en": "having given honey to the Self-Existent One; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:58.3"], "en": "passing away from there, I was born in a forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:58.4"], "en": "I was born within the heart of a lotus;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:59.1", "PA_thi-ap_19:59.2"], "en": "having become the chief queen of the King of Kāsi, I was honored and revered.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:59.3"], "en": "I gave birth to five hundred sons of princes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:59.4"], "en": "not lacking in number;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:60.1"], "en": "when they had reached their youth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:60.2"], "en": "While playing at water-sports,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:60.3", "PA_thi-ap_19:60.4"], "en": "they saw a fallen lotus and became individual leaders (paccekanāyaka).", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:61.1", "PA_thi-ap_19:61.2"], "en": "Deprived of those heroes who had heard the Dhamma, I am sorrowful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:61.3"], "en": "having passed away from the slopes of Isigili, I am now here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:61.4", "PA_thi-ap_19:62.1", "PA_thi-ap_19:62.2"], "en": "I was born in a village when the Buddhas were wise in what they had heard, and so were their disciples and even their husbands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:62.3"], "en": "Taking rice gruel,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:62.4", "PA_thi-ap_19:63.1"], "en": "she went [to meet] the eight individual leaders (paccekabuddhas) as they were going to the village for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:63.2"], "en": "Having seen him, I remembered my sons;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:63.3", "PA_thi-ap_19:63.4"], "en": "then, out of love for my sons, streams of milk flowed forth from me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:64.1", "PA_thi-ap_19:64.2"], "en": "Then, with my own hands, I gave them that rice gruel with a devout mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:64.3"], "en": "having passed away from there, I went to the Heaven of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:64.4"], "en": "I was reborn in Nandana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:65.1"], "en": "Having experienced pleasure and pain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:65.2"], "en": "and having wandered through various states of existence, I have come here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:65.3"], "en": "For your sake, O Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:65.4"], "en": "even my life was surrendered.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:66.1"], "en": "Such manifold suffering—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:66.2"], "en": "And his attainments were manifold;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:66.3"], "en": "when his final existence was reached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:66.4"], "en": "he was born in the city of Sāvatthī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:67.1"], "en": "In the family of the wealthy merchant Mahādhanaseṭṭhi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:67.2"], "en": "which was thus happy, adorned,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:67.3"], "en": "and radiant with various jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:67.4"], "en": "With all desires fulfilled,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:68.1"], "en": "they were honored, revered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:68.2"], "en": "esteemed, and likewise respected.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:68.3"], "en": "Endowed with the perfection of physical beauty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:68.4"], "en": "highly honored among noble families,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:69.1"], "en": "and exceedingly desired.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:69.2"], "en": "And by means of the splendor of their physical forms and enjoyments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:69.3", "PA_thi-ap_19:69.4"], "en": "she was sought after by many hundreds of sons of wealthy merchants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:70.1"], "en": "Having abandoned the household life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:70.2"], "en": "I went forth into homelessness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:70.3"], "en": "before even half a month had passed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:70.4"], "en": "I attained the Four Noble Truths.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:71.1", "PA_thi-ap_19:71.2"], "en": "Having fashioned a four-wheeled chariot through my supernormal power, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:71.3"], "en": "I shall worship the feet of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:71.4"], "en": "the Tathāgata, the Lord of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:72.1"], "en": "Approaching a tree with its finest blossoms—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:72.2"], "en": "\"You stand all alone at the foot of the sal tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:72.3"], "en": "you have no companion whatsoever.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:72.4"], "en": "O foolish woman, do you not fear the scoundrels?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:73.1", "PA_thi-ap_19:73.2"], "en": "\"Even if a hundred thousand rogues were to assemble, all being just like this,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:73.3"], "en": "my hair would not quiver, nor would it tremble.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:73.4"], "en": "What can you do to me alone, O Māra?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:74.1", "PA_thi-ap_19:74.2"], "en": "I shall either vanish from sight or enter into your belly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:74.3"], "en": "Even in the space between my eyebrows,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:74.4"], "en": "you will not see me standing there;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:75.1"], "en": "for I have attained mastery over the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:75.2"], "en": "The bases of psychic power have been well-developed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:75.3"], "en": "I am freed from all bonds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:75.4"], "en": "friend, and I do not fear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:76.1"], "en": "Sensual pleasures are like a spear and stake,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:76.2"], "en": "a hammering upon the aggregates;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:76.3"], "en": "that which you call the delight of sensual pleasure—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:76.4"], "en": "Now I have no more aversion;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:77.1"], "en": "everywhere delight has been destroyed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:77.2"], "en": "and the mass of darkness has been shattered.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:77.3"], "en": "\"Know this, O Evil One:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:77.4"], "en": "you are defeated, O End-maker!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:78.1"], "en": "The Conqueror is pleased with that quality.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:78.2", "PA_thi-ap_19:78.3", "PA_thi-ap_19:78.4"], "en": "The Leader placed me at the forefront among the assemblies as the foremost of those possessing psychic power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:79.1"], "en": "The Teacher has been served by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:79.2"], "en": "the Buddha’s instruction has been fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:79.3"], "en": "the heavy burden has been laid down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:79.4"], "en": "The uprooting of the conduit to existence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:80.1", "PA_thi-ap_19:80.2"], "en": "for that purpose for which they have gone forth from the home life into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:80.3"], "en": "Thus has my goal been attained:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:80.4"], "en": "the destruction of all fetters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:81.1"], "en": "Robes and almsfood—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:81.2"], "en": "They bring forth bedding and seats as a requisite,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:81.3", "PA_thi-ap_19:81.4"], "en": "thousands of them from all sides, in an instant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:82.1"], "en": "The defilements have been incinerated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:82.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:82.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:83.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:83.2", "PA_thi-ap_19:83.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:84.1", "PA_thi-ap_19:84.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:84.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:85.1"], "en": "Thus indeed did the bhikkhunī Uppalavaṇṇā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_19:86.1"], "en": "The legend of the Elder Nun Uppalavaṇṇā is the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
