{"segs": ["PA_ja_41:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_41:0.2", "PA_ja_41:0.3"], "en": "Ekakanipāta, Atthakāmavagga (The Chapter on Those Desiring Welfare)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_41:0.4"], "en": "1. The Losaka Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_41:1.1", "PA_ja_41:1.2"], "en": "“He who, when being exhorted by one who desires his welfare and feels compassion for him, does not follow the instruction;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_41:1.3"], "en": "\"Ajiya hangs down by his feet,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_41:1.4"], "en": "grieving like Mittaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_41:2.1"], "en": "Thus ends the first Jātaka, the Losaka-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
