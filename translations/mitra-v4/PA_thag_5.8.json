[
{"segs": ["PA_thag_5.8:0.1", "PA_thag_5.8:0.2", "PA_thag_5.8:0.3"], "en": "Theragāthā 5.8 Pañcaka-nipāta First Chapter (Paṭhama-vagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:0.4"], "en": "The Verses of the Elder Vakkali:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:1.1"], "en": "“Afflicted by a wind-disease,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:1.2"], "en": "you dwell in the forest grove;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:1.3", "PA_thag_5.8:1.4"], "en": "When your range for alms is restricted and coarse, how will you fare, O monk?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:2.1"], "en": "\"With abundant rapture and bliss...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:2.2"], "en": "Overcoming the multitude of worldly concerns,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:2.3"], "en": "and enduring even what is coarse,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:2.4"], "en": "I shall dwell in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:3.1"], "en": "Developing the foundations of mindfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:3.2"], "en": "the faculties, and the powers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:3.3"], "en": "and developing the factors of enlightenment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:3.4"], "en": "I shall dwell in the forest—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:4.1"], "en": "energetic, resolute,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:4.2"], "en": "and always firm in my exertion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:4.3"], "en": "Seeing them united and in harmony,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:4.4"], "en": "I shall dwell in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:5.1"], "en": "recollecting the Fully Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:5.2"], "en": "With my mind supreme and concentrated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:5.3", "PA_thag_5.8:5.4"], "en": "untiringly I shall dwell day and night in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.8:5.5"], "en": "… the Elder Vakkali …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
