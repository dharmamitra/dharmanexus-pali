[
{"segs": ["PA_tha-ap_390:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:0.2"], "en": "The Chapter on the Avaṭaphala Group (8).", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:0.3"], "en": "The Apadāna of the Elder Panasaphaladāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:1.1", "PA_tha-ap_390:1.2"], "en": "“The Fully Awakened One named Ajjuna then dwelt in the Himalayas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:1.3"], "en": "he was perfected in conduct.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:1.4"], "en": "The Sage, skilled in meditative concentration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:2.1", "PA_tha-ap_390:2.2"], "en": "having taken a panasa fruit and a jīvajīvaka bird, each the size of a jar;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:2.3"], "en": "Having placed them upon a *chattapaṇṇa* leaf,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:2.4"], "en": "I gave them to the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:3.1"], "en": "Thirty-one eons ago from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:3.2"], "en": "Whatever fruit I gave back then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:3.4"], "en": "this is the fruit of giving fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:4.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:4.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:4.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:5.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:5.2", "PA_tha-ap_390:5.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:6.1", "PA_tha-ap_390:6.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:6.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:7.1"], "en": "Thus indeed the venerable elder Panasaphaladāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_390:8.1"], "en": "This is the eighth legend (apadāna) of the elder Panasaphaladāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
