[
{"segs": ["PA_tha-ap_103:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:0.2"], "en": "Bhikkhadāyivagga 1,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:0.3"], "en": "The Apadāna of the Elder Bhikkhadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:1.1"], "en": "“The golden-hued Sambuddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:1.2"], "en": "the recipient of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:1.3"], "en": "has gone forth as one most excellent.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:1.4"], "en": "To him who had come from the forest to the state beyond the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:2.1", "PA_tha-ap_103:2.2"], "en": "I gave a spoonful of alms-food to Siddhattha, the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:2.3", "PA_tha-ap_103:2.4"], "en": "For the Great Hero, the Neutral One, who is stilled through wisdom—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:3.1"], "en": "following his track step by step.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:3.2"], "en": "Extinguishing the great multitude,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:3.3", "PA_tha-ap_103:3.4"], "en": "a sublime joy has arisen in me toward the Buddha, the Kinsman of the Sun.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:4.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:4.2"], "en": "whatever gift I gave at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:4.3"], "en": "I have not known a state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:4.4"], "en": "This is the fruit of giving alms to a bhikkhu.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:5.1"], "en": "In the eighty-seventh aeon hence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:5.2"], "en": "those named Mahāreṇu;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:5.3"], "en": "Endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:5.4"], "en": "these seven were wheel-turning monarchs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:6.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:6.2", "PA_tha-ap_103:6.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:6.4"], "en": "the Buddha’s teaching has been accomplished.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:7.1"], "en": "Thus indeed the venerable elder Bhikkhadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_103:8.1"], "en": "This is the first legend of the elder Bhikkhadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
