[
{"segs": ["PA_thag_2.32:0.1", "PA_thag_2.32:0.2"], "en": "Theragāthā 2.32 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.32:0.3"], "en": "Catutthavagga (The Fourth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.32:0.4"], "en": "The Verses of the Elder Sivaka:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.32:1.1"], "en": "“Houses are impermanent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.32:1.2"], "en": "again and again in this place and that;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.32:1.3"], "en": "Seeking the house-builder,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.32:1.4"], "en": "one undergoes suffering through birth again and again.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.32:2.1"], "en": "House-builder, you are seen!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.32:2.2"], "en": "You shall build no house again;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.32:2.3"], "en": "all your rafters are broken,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.32:2.4"], "en": "and the ridgepole is shattered.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.32:2.5", "PA_thag_2.32:2.6"], "en": "“A mind freed from the boundaries of the world will be dispersed right here. ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.32:2.7"], "en": "Thus spoke the Elder Sivaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
