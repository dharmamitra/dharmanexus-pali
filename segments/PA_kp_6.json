        "folio": "7",
        "suttacentral_link": "https://suttacentral.net/kp6/pli/ms#7.4"
    },
    {
        "segmentnr": "PA_kp_6:7.5",
        "original": "Idampi saṅghe ratanaṁ paṇītaṁ,",
