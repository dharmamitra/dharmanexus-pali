[
{"segs": ["PA_kv_2.6:0.1", "PA_kv_2.6:0.2", "PA_kv_2.6:0.3"], "en": "Points of Controversy The Great Fifty-Section The Second Chapter", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:0.4"], "en": "The Discourse on the Conveyance of Suffering:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:1.1", "PA_kv_2.6:1.2"], "en": "Is the conveyance of suffering a factor of the path and included within the path? Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:1.3"], "en": "Is it the case that all those who utter the words \"it is suffering\" are all developing the path?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:1.4"], "en": "One should not say so.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:2.1"], "en": "Are all those who utter the words \"it is suffering\" developing the path? One should not say so.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:2.2"], "en": "“Yes,” you say.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:2.3"], "en": "But then, do foolish worldlings utter the words, ‘We suffer,’ and do foolish worldlings cultivate the path?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:2.4"], "en": "You should not say so.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:2.5"], "en": "A matricide...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:2.6"], "en": "a patricide...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:2.7"], "en": "a murderer of an arahant...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:2.8"], "en": "\"One who causes the shedding of blood...", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:2.9"], "en": "one who causes a schism in the Saṅgha speaks the words 'it is suffering,' yet a schismatic develops the Path\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:2.10"], "en": "One should not say so... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_kv_2.6:2.11"], "en": "The Discussion on the Bringer of Suffering is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"}
]
