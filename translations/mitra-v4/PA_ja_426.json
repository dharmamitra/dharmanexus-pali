[
{"segs": ["PA_ja_426:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:0.2", "PA_ja_426:0.3"], "en": "The Eighth Chapter, The Section on Kaccāyana (Aṭṭhakanipāta Kaccānivagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:0.4"], "en": "10. The Dīpijātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:1.1"], "en": "“Is it endurable? Is it sustainable?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:1.2"], "en": "I hope you are well, my uncle?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:1.3"], "en": "“‘Mother, speak what is pleasant;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:1.4"], "en": "we too desire only your happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:2.1"], "en": "‘Then enter my tail!’”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:2.2"], "en": "Having struck her, O Eḷikā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:2.3", "PA_ja_426:2.4"], "en": "do you think she should now be released merely by being called \"uncle\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:3.1"], "en": "“You are sitting facing the east,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:3.2"], "en": "while I have come before your face;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:3.3"], "en": "behind you is my tail.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:3.4"], "en": "\"How indeed did I descend?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:4.1"], "en": "\"As far as the four continents,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:4.2"], "en": "together with the oceans and the mountains,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:4.3"], "en": "\"To that extent my tail remains;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:4.4"], "en": "how indeed did you avoid it?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:5.1"], "en": "\"They had already told me this before.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:5.2"], "en": "Mother, father, and brothers—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:5.3"], "en": "though the wicked one’s tail was long—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:5.4"], "en": "I have come through the air.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:6.1", "PA_ja_426:6.2"], "en": "And seeing her approaching in the midst of the sky, O Eḷikā,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:6.3"], "en": "the herd of deer fled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:6.4"], "en": "“‘My food has been destroyed by you!’—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:7.1", "PA_ja_426:7.2"], "en": "thus lamented Eḷakī as Ruhagghasa [the wolf]— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:7.3"], "en": "I have crushed the throat;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:7.4"], "en": "there is no well-spoken word for the wicked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:8.1"], "en": "There is no way for the wicked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:8.2"], "en": "There is no Dhamma, no well-spoken word;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:8.3"], "en": "one should apply oneself with diligence toward the wicked,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:8.4"], "en": "for such a person does not please the virtuous.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:9.1"], "en": "The Dīpijātaka is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:10.1"], "en": "The Aṭṭhakanipāta is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:11.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:12.1"], "en": "Pure and unstained, wearing their robes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:12.2"], "en": "they offered a bracelet and a noble staff to Bakabrahmā; then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:12.3"], "en": "at the Aṅgāracaitya, they offered a devīla flower.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_426:12.4"], "en": "Then the ten fishermen saw the Ganges ablaze.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
