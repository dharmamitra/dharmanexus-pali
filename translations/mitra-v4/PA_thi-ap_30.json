[
{"segs": ["PA_thi-ap_30:0.1"], "en": "The Therī-apadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:0.2"], "en": "Kuṇḍalakesīvagga 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:0.3"], "en": "The Apadāna of the Eighteen Thousand Bhikkhunīs Headed by Yasodharā", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:1.1", "PA_thi-ap_30:1.2"], "en": "Eighteen thousand bhikkhunīs born of the Sakyans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:1.3"], "en": "headed by Yasodharā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:1.4"], "en": "They approached the Fully Enlightened One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:2.1"], "en": "they were eighteen thousand in number,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:2.2"], "en": "all possessed of great psychic power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:2.3", "PA_thi-ap_30:2.4"], "en": "Worshipping the feet of the sages, they declare according to their strength:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:3.1"], "en": "\"Birth is exhausted; old age and disease are gone.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:3.2"], "en": "And death, O Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:3.3", "PA_thi-ap_30:3.4"], "en": "let us go, O Leader, to that taintless, peaceful, and immortal state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:4.1", "PA_thi-ap_30:4.2"], "en": "O Great Sage, even if there was some transgression in the past, may you not consider it as an offense,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:4.3"], "en": "for we were unaware of it all.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:4.4"], "en": "“Forgive us, O Leader!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:5.1"], "en": "Show forth your supernormal power as well,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:5.2"], "en": "you who carry out my teaching!”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:5.3", "PA_thi-ap_30:5.4"], "en": "\"Cut through the doubt of all the assemblies, however many there may be.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:6.1"], "en": "\"O Great Hero, Yasodharā...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:6.2"], "en": "Pleasing and lovely to behold—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:6.3", "PA_thi-ap_30:6.4"], "en": "these were all your wives in the household, O Great Hero.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:7.1", "PA_thi-ap_30:7.2"], "en": "For ninety-six million and sixty thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:7.3"], "en": "O Hero, we lived as householders.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:7.4"], "en": "They were all preeminent and sovereign,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:8.1"], "en": "endowed with beauty, conduct, and virtue;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:8.2"], "en": "though in the prime of youth, they were pleasant of speech.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:8.3"], "en": "All honor us,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:8.4"], "en": "as humans do for deities;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:9.1"], "en": "eighteen thousand [of them].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:9.2"], "en": "All those born of the Sakyas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:9.3"], "en": "thousands of Yasodharās—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:9.4"], "en": "were then the foremost and most powerful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:10.1", "PA_thi-ap_30:10.2"], "en": "Having transcended the realm of desire and established themselves in the realm of form,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:10.3"], "en": "there is nothing equal to them in beauty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:10.4"], "en": "Of thousands, O Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:11.1"], "en": "Having paid homage to the Fully Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:11.2"], "en": "they displayed their supernormal powers before the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:11.3", "PA_thi-ap_30:11.4"], "en": "They displayed many various forms and even great supernormal powers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:12.1"], "en": "they manifested a body as vast as a world-system.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:12.2"], "en": "Place the head to the north;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:12.3"], "en": "both wings are the two continents,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:12.4"], "en": "and Jambudvīpa is from the body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:13.1"], "en": "The southern lake is his tail-feather,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:13.2"], "en": "the various branches are his leaves,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:13.3"], "en": "and the moon and sun are his eyes.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:13.4"], "en": "The peak from Mount Meru,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:14.1"], "en": "the Cakkavāḷa mountain as the beak,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:14.2"], "en": "and the Jambu tree together with its roots;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:14.3"], "en": "Coming while being fanned,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:14.4"], "en": "they paid homage to the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:15.1"], "en": "[who appeared] in the form of an elephant and likewise as a horse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:15.2"], "en": "They showed a mountain and likewise the ocean;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:15.3"], "en": "they showed the moon, the sun, Mount Meru,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:15.4"], "en": "and the form of Sakka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:16.1"], "en": "“O Hero, O One with Vision, we, Yasodharā and the others,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:16.2", "PA_thi-ap_30:16.3"], "en": "pay homage at your feet through the long-lasting power of your majesty.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:16.4"], "en": "O Leader of Men, you have attained perfection.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:17.1", "PA_thi-ap_30:17.2"], "en": "You possess mastery over the supernormal powers and the divine ear-element.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:17.3", "PA_thi-ap_30:17.4"], "en": "O Great Sage, we have mastery over the knowledge of the minds of others;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:18.1"], "en": "we know our former births.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:18.2"], "en": "The divine eye has been purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:18.3"], "en": "all taints are utterly destroyed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:18.4"], "en": "and now there is no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:19.1", "PA_thi-ap_30:19.2", "PA_thi-ap_30:19.3"], "en": "O Great Hero, our knowledge regarding the meanings, the phenomena, the definitions, and likewise regarding inspired eloquence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:19.4"], "en": "Has arisen in your presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:20.1", "PA_thi-ap_30:20.2"], "en": "You have shown us the meeting with the World-Protectors of the past.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:20.3", "PA_thi-ap_30:20.4"], "en": "Our obligations are many for your sake, O Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:21.1"], "en": "whatever work we have fulfilled, [it is for you].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:21.2"], "en": "O Sage, you who possess the essence of the wholesome;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:21.3", "PA_thi-ap_30:21.4"], "en": "O Great Hero, these merits have been accumulated by us for your sake.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:22.1"], "en": "Having avoided what is impossible,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:22.2", "PA_thi-ap_30:22.3"], "en": "we have restrained improper conduct for your sake, O Great Hero.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:22.4"], "en": "We have not lived for ourselves alone;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:23.1", "PA_thi-ap_30:23.2"], "en": "thousands of millions were given by us to be our wives.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:23.3", "PA_thi-ap_30:23.4"], "en": "We are not despondent in this matter for your sake, O Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:24.1"], "en": "[we have spent] many thousands of millions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:24.2", "PA_thi-ap_30:24.3"], "en": "Since you have come to serve us for our benefit, we shall not be dejected there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:24.4"], "en": "O Great Sage, for it was for our sake that you came.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:25.1", "PA_thi-ap_30:25.2"], "en": "Many thousands of crores were given to us for the sake of food;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:25.3"], "en": "we did not feel dejected on that account.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:25.4"], "en": "For your sake, O Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:26.1", "PA_thi-ap_30:26.2"], "en": "we have sacrificed thousands of millions of lives.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:26.3"], "en": "We shall effect our release from fear;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:26.4", "PA_thi-ap_30:27.1"], "en": "we shall give up our lives for the sake of the ornaments on our limbs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:27.2", "PA_thi-ap_30:27.3"], "en": "We do not conceal these many various garments and women’s ornaments for our own sake,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:27.4"], "en": "O Great Sage, but for your sake.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:28.1"], "en": "The relinquishing of wealth and grain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:28.2"], "en": "villages and towns,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:28.3"], "en": "fields, sons, and daughters—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:28.4"], "en": "They were renounced by the Great Sage:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:29.1"], "en": "elephants, horses, and cattle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:29.2"], "en": "as well as female slaves and attendants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:29.3"], "en": "For your sake, O Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:29.4"], "en": "that which was relinquished by us is incalculable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:30.1"], "en": "As for what you have addressed to us—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:30.2", "PA_thi-ap_30:30.3", "PA_thi-ap_30:30.4"], "en": "‘We shall give gifts to those who ask,’ yet we do not see any dejection in us as we bestow this supreme gift.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:31.1", "PA_thi-ap_30:31.2", "PA_thi-ap_30:31.3"], "en": "The manifold and abundant suffering within the many forms of saṃsāra is for your sake, O Great Hero.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:31.4"], "en": "An incalculable amount has been experienced.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:32.1"], "en": "We rejoice in those who have attained happiness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:32.2"], "en": "and we are not dejected by those in suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:32.3", "PA_thi-ap_30:32.4"], "en": "We are weighed in every respect for your sake, O Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:33.1"], "en": "the Perfectly Awakened One follows the path accordingly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:33.2"], "en": "The Dhamma which he brought forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:33.3"], "en": "having experienced both pleasure and pain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:33.4"], "en": "the Great Sage attained enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:34.1", "PA_thi-ap_30:34.2"], "en": "To Brahmādeva and the Sambuddha Gotama, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:34.3"], "en": "and to other Protectors of the World—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:34.4"], "en": "Our meeting with them was not frequent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:35.1", "PA_thi-ap_30:35.2"], "en": "We have performed many services for your sake, O Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:35.3"], "en": "As you seek the qualities of a Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:35.4", "PA_thi-ap_30:36.1"], "en": "we shall be your attendants for a hundred thousand aeons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:36.2"], "en": "And after four incalculable eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:36.3"], "en": "the Great Hero Dīpaṅkara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:36.4"], "en": "the Leader of the World, appeared.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:37.1", "PA_thi-ap_30:37.2"], "en": "Having invited the Tathāgata to a border region,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:37.3"], "en": "[they prepared] the path for his arrival.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:37.4", "PA_thi-ap_30:38.1"], "en": "They purified themselves with joyful minds. At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:38.2"], "en": "there was a brahmin named Sumedha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:38.3", "PA_thi-ap_30:38.4"], "en": "And he prepared the path for the All-Seeing One, who was coming from afar.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:39.1"], "en": "At that time, we were...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:39.2", "PA_thi-ap_30:39.3"], "en": "All these flowers, born of brahmins and sprung from the earth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:39.4"], "en": "we have brought for the assembly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:40.1"], "en": "At that time, the Buddha Dīpaṅkara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:40.2", "PA_thi-ap_30:40.3"], "en": "of great renown, the Great Hero, made this prediction:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:40.4"], "en": "With a mind free from pride,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:41.1"], "en": "the earth trembles and resounds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:41.2"], "en": "shaking along with the world of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:41.3"], "en": "As they proclaimed his deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:41.4"], "en": "the sage’s mind rose high;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:42.1"], "en": "both celestial maidens and human beings [were moved].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:42.2"], "en": "And we too, together with the devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:42.3", "PA_thi-ap_30:42.4"], "en": "having worshipped various articles worthy of worship, made our aspirations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:43.1", "PA_thi-ap_30:43.2"], "en": "The Buddha named Jotidīpa gave them this prediction:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:43.3"], "en": "“Whatever aspirations have been made today, [they shall be fulfilled].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:43.4"], "en": "They will appear before us.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:44.1"], "en": "In an immeasurable eon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:44.2"], "en": "that which the Buddha has prophesied for us—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:44.3"], "en": "Rejoicing in those words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:44.4"], "en": "we acted accordingly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:45.1"], "en": "Of that well-performed deed, [the fruit is this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:45.2"], "en": "They gladdened his heart;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:45.3", "PA_thi-ap_30:45.4"], "en": "having experienced countless births among gods and humans, they attained peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:46.1", "PA_thi-ap_30:46.2"], "en": "Having experienced both pleasure and pain among gods and humans,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:46.3"], "en": "when his final existence has arrived,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:46.4"], "en": "We were born in the Sakyan clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:47.1"], "en": "endowed with beauty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:47.2"], "en": "wealth, fame, and virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:47.3"], "en": "May we be endowed with all good qualities,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:47.4"], "en": "highly honored among families,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:48.1"], "en": "and receive gain, fame, and respect.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:48.2"], "en": "Though the worldly conditions have come together,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:48.3"], "en": "our minds are not afflicted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:48.4"], "en": "we dwell without fear from any quarter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:49.1"], "en": "For this was said by the Blessed One:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:49.2"], "en": "“At that time, in the king’s inner palace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:49.3"], "en": "in the city of the kshatriyas, O Hero...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:49.4"], "en": "And he pointed out the benefactor:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:50.1"], "en": "\"The woman who is a benefactor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:50.2"], "en": "and the woman in happiness or in sorrow;\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:50.3"], "en": "The woman who explains the meaning,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:50.4"], "en": "the woman who is compassionate,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:51.1"], "en": "and she who practices the Dhamma with well-conducted conduct—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:51.2"], "en": "One should not engage in misconduct;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:51.3"], "en": "one who lives according to the Dhamma sleeps happily,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:51.4"], "en": "both in this world and in the next.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:52.1"], "en": "Having abandoned the household life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:52.2"], "en": "I went forth into homelessness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:52.3"], "en": "before even half a month had passed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:52.4"], "en": "We have touched the Four Noble Truths.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:53.1"], "en": "We have robes, almsfood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:53.2"], "en": "requisites, and lodgings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:53.3"], "en": "Many defilements carry us away,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:53.4"], "en": "like waves upon the ocean;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:54.1"], "en": "our defilements have been incinerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:54.2"], "en": "All states of existence have been utterly eradicated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:54.3"], "en": "like a serpent that has severed its bonds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:54.4"], "en": "we dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:55.1", "PA_thi-ap_30:55.2"], "en": "Welcome indeed has come to us in the presence of my Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:55.3"], "en": "the three knowledges have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:55.4"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:56.1", "PA_thi-ap_30:56.2"], "en": "the four analytical knowledges and these eight liberations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:56.3"], "en": "The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:56.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:57.1"], "en": "Thus, manifold suffering—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:57.2"], "en": "And success is of many kinds;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:57.3"], "en": "having attained a state of purity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:57.4"], "en": "may we obtain every form of prosperity.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:58.1", "PA_thi-ap_30:58.2"], "en": "Those who give themselves away for the sake of merit to the Great Seers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:58.3"], "en": "possess the perfection of companionship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:58.4", "PA_thi-ap_30:59.1"], "en": "The unconditioned state of Nibbāna is completely exhausted of the past,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:59.2"], "en": "the present, and the future.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:59.3"], "en": "\"All our karma is exhausted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:59.4"], "en": "we pay homage at your feet, O Visionary One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:60.1"], "en": "\"For us who speak for the sake of Nibbāna,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:60.2"], "en": "What more shall we say to you? For,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:60.3"], "en": "having transcended the fault of the conditioned,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:60.4"], "en": "you have reached the deathless state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:61.1"], "en": "Thus, indeed, eighteen thousand bhikkhunīs headed by Yasodharā recited these verses in the presence of the Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:62.1"], "en": "This concludes the tenth *apadāna* of the eighteen thousand bhikkhunīs headed by Yasodharā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:63.1"], "en": "The third chapter, the *Kuṇḍalakesī-vagga*, is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:64.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:65.1"], "en": "Kuṇḍalā, Gotamī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:65.2"], "en": "Dhammadinnā, and Sakulā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:65.3"], "en": "Varaṇandā and Soṇā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:65.4"], "en": "Kāpilānī and Yasodharā—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:66.1"], "en": "these ten thousand bhikkhunīs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:66.2"], "en": "Eighteen thousand [verses];", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thi-ap_30:66.3", "PA_thi-ap_30:66.4"], "en": "four hundred and seventy-six stanzas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
