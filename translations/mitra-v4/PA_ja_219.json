[
{"segs": ["PA_ja_219:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_219:0.2", "PA_ja_219:0.3"], "en": "The Second Book of Pairs (Dukanipāta), Chapter on the Bīraṇa-Stalks (Bīraṇathambhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_219:0.4", "PA_ja_219:1.1"], "en": "9. The Garahitajātaka “Gold for me! Wealth for me!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_219:1.2"], "en": "Such is my talk by night and by day.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_219:1.3", "PA_ja_219:1.4"], "en": "Of foolish people who do not see the noble Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_219:2.1"], "en": "there are two householders in every house.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_219:2.2"], "en": "There was one there who was hairless;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_219:2.3"], "en": "he had hanging lips, a braided topknot,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_219:2.4"], "en": "and moreover, pierced ears.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_219:2.5"], "en": "\"The cricket, with its great wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_219:2.6", "PA_ja_219:3.1"], "en": "annoys that person. Thus ends the ninth Jātaka, the Garahitajātakam.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
