[
{"segs": ["PA_vv_47:0.1"], "en": "Vimānavatthu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:0.2", "PA_vv_47:0.3"], "en": "The Chapter on the Mañjiṭṭhaka Female Devas in the Itthivimāna Section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:0.4", "PA_vv_47:1.1"], "en": "9. The Story of the Yellow Mansion “Clad in yellow garments, with a yellow banner,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:1.2"], "en": "and adorned with yellow ornaments;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:1.3"], "en": "With her limbs anointed with yellow sandalwood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:1.4"], "en": "wearing a garland of yellow lotuses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:2.1"], "en": "she was upon a yellow palace couch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:2.2"], "en": "On a yellow seat, with a yellow vessel;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:2.3"], "en": "under a yellow parasol, in a yellow chariot;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:2.4"], "en": "with a yellow horse, with a yellow fan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:3.1"], "en": "What deed did you perform, O Bhaddā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:3.2"], "en": "in your previous human existence?", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:3.3"], "en": "O deity, being questioned, tell us.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:3.4"], "en": "“Of what action is this the fruit?", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:4.1"], "en": "“There is a creeper called kosātakī, venerable sir,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:4.2"], "en": "which is bitter and undesirable.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:4.3"], "en": "I brought four flowers for her,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:4.4", "PA_vv_47:5.1"], "en": "offering them to the stupa dedicated to the Teacher’s body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:5.2"], "en": "With a mind that is serene,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:5.3"], "en": "I shall not look for his path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:5.4"], "en": "nor shall I be mindful with the intent of following it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:6.1", "PA_vv_47:6.2"], "en": "Then a cow killed me before my mind had reached the stupa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:6.3"], "en": "and I would have directed that [merit] toward it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:6.4"], "en": "\"Surely there would be even more than this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:7.1"], "en": "By that deed, O Lord of Devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:7.2"], "en": "Maghavan, the elephant among gods,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:7.3"], "en": "\"Having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:7.4"], "en": "she has come to your companionship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:8.1"], "en": "Having heard this, the Lord of the Thirty-three,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:8.2"], "en": "Maghavā, the elephant among gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:8.3"], "en": "gladdening the inhabitants of Tāvatiṃsa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:8.4"], "en": "spoke thus to Mātali:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:9.1"], "en": "“Behold, Mātali, this marvel:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:9.2"], "en": "this fruit of karma!", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:9.3"], "en": "Even a small gift that has been given—”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:9.4"], "en": "Merit becomes of great fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:10.1"], "en": "When the mind is serene,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:10.2"], "en": "there is no such thing as a small gift.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:10.3", "PA_vv_47:10.4"], "en": "Whether it be toward the Tathāgata, the Fully Awakened One, or toward his disciple:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:11.1"], "en": "\"Come, Mātali, let us also [go] there.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:11.2"], "en": "We honor them more and more;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:11.3", "PA_vv_47:11.4"], "en": "the relics of the Tathāgata are a blissful accumulation of merit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:12.1"], "en": "Whether [the Buddha] is present or has attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:12.2"], "en": "the fruit is the same for one whose mind is equanimous;", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:12.3"], "en": "for it is due to the aspiration of the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:12.4"], "en": "Beings go to a happy destination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:13.1"], "en": "Truly, for the benefit of many,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:13.2"], "en": "Tathāgatas arise.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:13.3"], "en": "\"Having performed service there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:13.4"], "en": "the donors go to heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_47:14.1"], "en": "Thus ends the ninth [discourse], the Yellow Mansion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"}
]
