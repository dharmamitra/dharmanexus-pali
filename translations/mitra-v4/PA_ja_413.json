[
{"segs": ["PA_ja_413:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:0.2"], "en": "The Seventh Chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:0.3"], "en": "the Gandhāra Section", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:0.4"], "en": "8. The Dhūmakāri Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:1.1", "PA_ja_413:1.2"], "en": "“King Yudhiṭṭhila, who desired the Dhamma, questioned Vidhūra;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:1.3"], "en": "“Do you know, brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:1.4"], "en": "who it is that grieves alone?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:2.1"], "en": "“A brahmin, separated from the herd of goats...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:2.2"], "en": "Dwelling in the forest for many days,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:2.3"], "en": "Vāseṭṭha made smoke there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:2.4"], "en": "untiring day and night.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:3.1"], "en": "Attracted by the scent of that smoke,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:3.2", "PA_ja_413:3.3"], "en": "cranes and mosquitoes in great numbers came to him for the rainy-season residence.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:3.4"], "en": "In the presence of Dhūmakāri,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:4.1"], "en": "having set his mind on the deer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:4.2"], "en": "that goat did not understand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:4.3"], "en": "Whether coming or going,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:4.4", "PA_ja_413:5.1"], "en": "those deer of his perished during the autumn season at the time of the Sarabhū River.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:5.2", "PA_ja_413:5.3"], "en": "Having abandoned the heights, they entered the forests, the mountain fastnesses,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:5.4"], "en": "and the sources of rivers.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:6.1", "PA_ja_413:6.2"], "en": "Having seen that Sarabha had departed and that Ajā had met her end,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:6.3"], "en": "you became emaciated and pale.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:6.4"], "en": "And there was a brahmin suffering from jaundice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:7.1"], "en": "Thus, having rejected him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:7.2"], "en": "he made a newcomer his friend.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:7.3"], "en": "Thus, alone, he grieves greatly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:7.4"], "en": "like the smoke-making brahmin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_413:8.1"], "en": "The Dhūmakāri Jātaka, the eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
