    },
    {
        "segmentnr": "PA_ne_31:5.1",
        "original": "Tāni yeva pañcindriyāni saṅkhārapariyāpannāni.",
        "analyzed": "tāni yā iva pañca indriyāni saṅkhāra pariyāpannāni ",
