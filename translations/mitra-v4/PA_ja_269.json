[
{"segs": ["PA_ja_269:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_269:0.2", "PA_ja_269:0.3"], "en": "Tikanipāta, Padumavagga (The Chapter on the Lotus)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_269:0.4"], "en": "9. The Sujāta Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_269:1.1", "PA_ja_269:1.2"], "en": "“Indeed, those who are endowed with beauty, sweet-voiced, and pleasant to behold;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_269:1.3", "PA_ja_269:1.4"], "en": "Even one of harsh speech becomes beloved in this world and in the next.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_269:2.1"], "en": "Do we not see this in the case of Kāḷī?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_269:2.2"], "en": "Though disfigured and scarred by moles,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_269:2.3", "PA_ja_269:2.4"], "en": "the kokila bird is dear to many living beings because of its gentle voice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_269:3.1"], "en": "Therefore, one who speaks kindly,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_269:3.2"], "en": "who is measured in speech and composed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_269:3.3"], "en": "illuminates both the meaning and the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_269:3.4"], "en": "“Sweet was his speech.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_269:4.1"], "en": "Thus ends the ninth Jātaka, the Sujāta-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
