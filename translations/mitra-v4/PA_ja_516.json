[
{"segs": ["PA_ja_516:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:0.2", "PA_ja_516:0.3"], "en": "The Collection of Thirty Birth Stories, Chapter on Kiṁchanda.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:0.4"], "en": "6. The Mahākapi Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:1.1", "PA_ja_516:1.2"], "en": "In Benares there was a king, the increaser of the realm of Kāsi.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:1.3"], "en": "Surrounded by his friends and ministers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:1.4"], "en": "he went to Migājina.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:2.1"], "en": "There he saw a brahmin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:2.2"], "en": "Pale, variegated, and leprous;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:2.3"], "en": "withered like a *kovidāra* tree,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:2.4"], "en": "emaciated and covered with visible veins.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:3.1", "PA_ja_516:3.2", "PA_ja_516:3.3"], "en": "Seeing a man fallen into distress, the king, having attained supreme compassion, spoke in amazement:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:3.4"], "en": "“Of what kind of yakkha are you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:4.1"], "en": "Your hands and feet are white,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:4.2"], "en": "and your head is whiter still.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:4.3"], "en": "Your body is the color of rust,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:4.4"], "en": "you are full of leprosy,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:5.1"], "en": "and you resemble a string of beads.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:5.2"], "en": "Your back is uneven, with depressions and elevations;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:5.3"], "en": "your limbs are like black bamboo— indeed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:5.4"], "en": "I see nothing else like this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:6.1"], "en": "With feet sore from walking, parched,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:6.2"], "en": "emaciated, and with veins standing out;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:6.3"], "en": "you are hungry and your form is withered.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:6.4"], "en": "\"Where have you come from? Where are you going?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:7.1", "PA_ja_516:7.2"], "en": "You are difficult to look upon, of little service, ill-favored, and terrifying to behold.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:7.3"], "en": "Even your own mother, Janetti,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:7.4"], "en": "would not wish to see you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:8.1"], "en": "What deed did you perform in the past?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:8.2"], "en": "Whom did he execute who was not deserving of death?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:8.3", "PA_ja_516:8.4"], "en": "Having committed what evil deed has he come to this suffering?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:9.1"], "en": "“Truly, I shall declare it to you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:9.2"], "en": "just as one who is skilled;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:9.3"], "en": "for in this world, one who speaks the truth— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:9.4"], "en": "The wise here praise this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:10.1"], "en": "\"Wandering alone like one seeking a lost cow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:10.2"], "en": "I was deluded and strayed in the forest.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:10.3"], "en": "In the forest, in the desolate wilderness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:10.4", "PA_ja_516:11.1"], "en": "frequented by various elephants and haunted by wild beasts.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:11.2"], "en": "I was lost in the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:11.3"], "en": "there I wandered for seven days,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:11.4"], "en": "overcome by hunger and thirst.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:12.1", "PA_ja_516:12.2"], "en": "There, hungry, I saw a *tinduka* fruit lying unevenly on the ground,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:12.3"], "en": "hanging over a precipice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:12.4", "PA_ja_516:13.1"], "en": "I ate fruits that had fallen by the wind from those who possessed the fruit of their practice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:13.2"], "en": "and they were very pleasing to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:13.3", "PA_ja_516:13.4"], "en": "Unsatisfied, I climbed a tree, thinking, \"I shall rest there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:14.1"], "en": "One [fruit] was eaten by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:14.2"], "en": "A second time she made her aspiration;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:14.3"], "en": "then that branch broke,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:14.4"], "en": "as if cut by an axe.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:15.1"], "en": "Thus, with my feet upwards and my head downwards,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:15.2"], "en": "I hung from the branches,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:15.3"], "en": "without support and without a foothold.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:15.4"], "en": "I fell from a mountain precipice;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:16.1"], "en": "because the water was deep,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:16.2"], "en": "I did not meet my end.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:16.3", "PA_ja_516:16.4"], "en": "There I lay for ten full nights without joy.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:17.1"], "en": "Then a monkey came there;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:17.2"], "en": "Gonangula, who dwells in the caves,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:17.3"], "en": "moves from branch to branch,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:17.4"], "en": "eating the fruit of the trees.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:18.1"], "en": "Thus, seeing me emaciated and pale,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:18.2"], "en": "he felt compassion for me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:18.3"], "en": "saying: \"O, who indeed is this person here?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:18.4"], "en": "Thus, being tormented by suffering—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:19.1"], "en": "whether you be a human or a non-human—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:19.2"], "en": "reveal yourself to me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:19.3"], "en": "Having bowed with palms joined in reverence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:19.4"], "en": "I spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:20.1"], "en": "\"I am a human being who has arrived here.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:20.2"], "en": "I have no other refuge but you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:20.3", "PA_ja_516:20.4"], "en": "I tell you this: may it be well with you, and may you be my refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:21.1"], "en": "Taking up a heavy rock,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:21.2"], "en": "the monkey roamed about on the mountain;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:21.3"], "en": "having fashioned a seat from the stone, he sat down.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:21.4"], "en": "Nisabha said this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:22.1", "PA_ja_516:22.2"], "en": "\"Come, climb upon my back and grasp my neck with your arms.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:22.3", "PA_ja_516:22.4"], "en": "\"I shall rescue you swiftly from this mountain precipice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:23.1"], "en": "Having heard those words of his,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:23.2", "PA_ja_516:23.3"], "en": "Having climbed onto the back of that glorious and wise lord of monkeys,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:23.4"], "en": "I grasped his neck with my arms.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:24.1", "PA_ja_516:24.2"], "en": "Then a powerful, fiery monkey rose up from there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:24.3"], "en": "causing me distress with great difficulty.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:24.4", "PA_ja_516:25.1"], "en": "Having quickly pulled me up from the mountain precipice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:25.2"], "en": "the virtuous Nisabha spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:25.3"], "en": "\"Come now, friend,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:25.4"], "en": "protect me for a moment while I tend my cattle;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:26.1"], "en": "there are lions, tigers, and leopards.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:26.2"], "en": "The bears, hyenas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:26.3"], "en": "and jackals might harm me while I am heedless;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:26.4"], "en": "seeing them, do you ward them off.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:27.1", "PA_ja_516:27.2"], "en": "\"May he protect me for a moment,\" thus [I thought];", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:27.3"], "en": "at that time, I held a wicked view.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:27.4"], "en": "I grasped at it unskillfully:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:28.1"], "en": "\"This is food for humans,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:28.2"], "en": "just like other deer in the forest.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:28.3"], "en": "\"What if, having killed this [monkey],", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:28.4"], "en": "I, being hungry, were to eat the monkey?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:29.1"], "en": "Then I shall go forth as an ascetic.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:29.2"], "en": "Taking this flesh as my provision,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:29.3"], "en": "I shall cross the wilderness;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:29.4"], "en": "it will serve as my travel rations.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:30.1"], "en": "Then, having taken up my sword,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:30.2"], "en": "I struck the crown of his head;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:30.3"], "en": "for my limbs were exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:30.4"], "en": "The blow was weak,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:31.1"], "en": "yet he, having arrived with great speed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:31.2"], "en": "the monkey, was smeared with blood.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:31.3"], "en": "With eyes full of tears,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:31.4"], "en": "he gazes at me weeping:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:32.1"], "en": "\"Do not cause us grief, O Blessed One.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:32.2", "PA_ja_516:32.3"], "en": "And you would not have done such a thing; indeed, you, O long-lived one,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:32.4"], "en": "ought to have restrained the others.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:33.1", "PA_ja_516:33.2"], "en": "Aho! O man, you who perform such difficult deeds;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:33.3"], "en": "such are these treacherous and perilous paths.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:33.4"], "en": "I have brought him down from his haughtiness;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:34.1"], "en": "he was led here from the other world—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:34.2"], "en": "do not think that he could deceive me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:34.3", "PA_ja_516:34.4"], "en": "That evil deed was thought out by that one of evil nature; do not,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:35.1"], "en": "O you who stand upon unrighteousness, [be like him].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:35.2"], "en": "A bitter sensation has touched me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:35.3", "PA_ja_516:35.4"], "en": "let not that evil deed strike you down like the fruit of a bamboo.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:36.1"], "en": "There is no trust in these three:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:36.2"], "en": "one of evil nature, one who is unrestrained,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:36.3"], "en": "and one who says, \"Come, follow behind me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:36.4"], "en": "While still being seen in their presence,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:37.1", "PA_ja_516:37.2"], "en": "you have escaped from the hands of the wild beasts and have reached the human state.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:37.3"], "en": "“This is the path established by non-Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:37.4"], "en": "go along it as you please.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:38.1"], "en": "Having said this, the mountain-dweller—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:38.2", "PA_ja_516:38.3"], "en": "Having washed his head in the lake and wiped away his tears,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:38.4"], "en": "he then ascended the mountain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:39.1"], "en": "Thus am I tormented by that,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:39.2"], "en": "distressed by the fever;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:39.3"], "en": "with my limbs burning, I am consumed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:39.4"], "en": "I approached to drink the water.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:40.1", "PA_ja_516:40.2"], "en": "The lake, smeared with blood, was as if scorched by fire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:40.3", "PA_ja_516:40.4"], "en": "Everything became like pus and blood for me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:41.1"], "en": "as many drops of water as there were—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:41.2"], "en": "They fell upon my body;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:41.3"], "en": "as many boils as there were [of drops] arose,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:41.4"], "en": "resembling large beluva fruits.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:42.1", "PA_ja_516:42.2"], "en": "Carcases, pus, and blood flowed out from me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:42.3"], "en": "wherever I went, they followed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:42.4"], "en": "In villages and market towns,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:43.1", "PA_ja_516:43.2"], "en": "men and women with sticks in their hands ward me off.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:43.3"], "en": "Struck by this foul stench,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:43.4"], "en": "do not come back again;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:44.1"], "en": "such is this suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:44.2", "PA_ja_516:44.3"], "en": "Now for seven years I have been experiencing my own karma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:44.4"], "en": "the evil deed I committed in the past.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:45.1"], "en": "I tell you this, O blessed ones,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:45.2"], "en": "as many as are gathered here:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:45.3"], "en": "do not be treacherous toward your friends.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:45.4"], "en": "For he who betrays his friends is an evil person;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:46.1"], "en": "he who betrays his friends in this world becomes a leper,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:46.2"], "en": "afflicted with skin disease.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:46.3", "PA_ja_516:46.4"], "en": "“Upon the breakup of the body, that betrayer of friends is reborn in hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_516:47.1"], "en": "Thus ends the sixth Jātaka, the Mahākapi-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
