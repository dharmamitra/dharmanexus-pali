[
{"segs": ["PA_ja_318:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:0.2", "PA_ja_318:0.3"], "en": "Catukkanipāta, Pucimandavagga (The Chapter on the Nimba Tree)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:0.4", "PA_ja_318:1.1"], "en": "8. The Kaṇavera Jātaka “That which [was seen] in the spring season,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:1.2"], "en": "upon the lovely kaṇavera flowers;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:1.3", "PA_ja_318:1.4"], "en": "He pressed her with his arm, and she declared him to be healthy. \"Alas!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:2.1"], "en": "This cannot be believed,\" [he thought].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:2.2"], "en": "Or if the wind were to carry away a mountain;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:2.3"], "en": "if the wind were to carry away a mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:2.4"], "en": "it might even carry away the entire earth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:2.5"], "en": "“Wherever my sister has passed away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:2.6"], "en": "she told me that I would be well.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:3.1"], "en": "“She has not passed away at all.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:3.2"], "en": "And she does not desire another;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:3.3", "PA_ja_318:3.4"], "en": "being a woman who eats but one meal a day, Sāmā longs for him alone.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:4.1"], "en": "“Sāmā has bartered me, whom she had known for so long,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:4.2"], "en": "for one she has not known, exchanging the unstable for the stable.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:4.3"], "en": "Sāmā might have traded me for someone else as well.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:4.4"], "en": "\"From here I shall go even further away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_318:5.1"], "en": "Thus ends the eighth Jātaka, the Kaṇavera-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
