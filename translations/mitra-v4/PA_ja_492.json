[
{"segs": ["PA_ja_492:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:0.2"], "en": "Miscellaneous Section,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:0.3"], "en": "Chapter on the Rice Field of Śāli Rice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:0.4"], "en": "9. The Tachchasūkara Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:1.1", "PA_ja_492:1.2"], "en": "“When we wandered about searching, through mountains and forests;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:1.3"], "en": "Seeking and wandering among my kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:1.4"], "en": "these two have been attained by me:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:2.1"], "en": "much indeed of this root and fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:2.2"], "en": "And this food is not meager;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:2.3"], "en": "these mountain peaks are delightful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:2.4"], "en": "and there will be a comfortable dwelling.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:3.1"], "en": "Right here I shall dwell,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:3.2"], "en": "together with all my kinsmen;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:3.3"], "en": "free from anxiety and without fear.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:3.4"], "en": "“O Asoka, free from fear from every side!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:4.1", "PA_ja_492:4.2"], "en": "[The king replied: “Seek another refuge, for our enemy exists here.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:4.3"], "en": "\"Thus he kills the boars,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:4.4"], "en": "coming here to choose one after another.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:5.1"], "en": "Who indeed is our enemy here?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:5.2", "PA_ja_492:5.3"], "en": "Who is it that destroys well-gathered kinsmen— those who are difficult to subdue?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:5.4"], "en": "Tell me this when you are asked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:6.1"], "en": "The king of beasts has an upraised mane;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:6.2", "PA_ja_492:6.3"], "en": "he is a powerful beast whose weapons are his tusks. He slaughters the boars.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:6.4"], "en": "“Come here and choose a boon after boon.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:7.1"], "en": "“We have no fangs, nor do they exist in us;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:7.2"], "en": "yet strength is established within our bodies.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:7.3"], "en": "“Having become all in harmony,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:7.4"], "en": "we shall bring him under our sole control.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:8.1"], "en": "[He spoke] words that were heart-pleasing and pleasant to the ear.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:8.2"], "en": "You speak these words, O Śakra:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:8.3"], "en": "\"Even he who might flee from battle,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:8.4"], "en": "him too we shall slay afterwards.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:9.1"], "en": "“Have you today abstained from taking life?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:9.2"], "en": "Have you granted fearlessness to all beings?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:9.3"], "en": "Do you no longer possess tusks for the slaughter of deer?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:9.4"], "en": "“You who have attained the Saṅgha, yet meditate like a pauper.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:10.1"], "en": "“My fangs do not exist,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:10.2"], "en": "and strength is established within my body.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:10.3"], "en": "Having seen my kinsmen gathered together in harmony,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:10.4"], "en": "I therefore meditate alone in the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:11.1"], "en": "for formerly they used to go here and there from this place.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:11.2"], "en": "Driven by fear, many people seek refuge;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:11.3"], "en": "now they have gathered and dwell together,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:11.4"], "en": "established where they are, difficult for me to overcome.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:12.1"], "en": "Endowed with leaders,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:12.2"], "en": "united, and speaking with one voice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:12.3"], "en": "they, being in harmony, might indeed harm me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:12.4"], "en": "Therefore, one should not long for these things.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:13.1"], "en": "\"Indra alone conquers the Asuras;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:13.2"], "en": "Sena alone strikes down the birds by force.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:13.3", "PA_ja_492:13.4"], "en": "\"A single tiger, having entered the herd of deer, kills the best of the best; for such is its strength.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:14.1"], "en": "\"Neither Indra nor Sena [is as powerful as this].\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:14.2"], "en": "Nor is he a tiger, the lord of beasts;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:14.3", "PA_ja_492:14.4"], "en": "for even a tiger cannot bring his kinsmen, who are united and harmonious, under his control.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:15.1"], "en": "“Like the kumbhīlaka birds,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:15.2"], "en": "living in groups and moving in flocks,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:15.3"], "en": "they take delight together in one place.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:15.4"], "en": "They spring up and fly about;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:16.1"], "en": "and as they are flying,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:16.2"], "en": "one among them retreats from that place.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:16.3"], "en": "And a hawk strikes it down;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:16.4"], "en": "that is the fate of one who belongs to the tiger’s prey.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:17.1"], "en": "Thus incited by the matted-hair ascetic,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:17.2"], "en": "With his eye for worldly gain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:17.3"], "en": "Daṭṭhi leapt upon Daṭṭhi,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:17.4"], "en": "imagining her to be as she was before.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:18.1"], "en": "“Excellent, O many kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:18.2"], "en": "even as trees born in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:18.3"], "en": "[you have acted] with harmony toward the swine.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:18.4"], "en": "The tiger was killed on the narrow path;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:19.1", "PA_ja_492:19.2"], "en": "having slain both the brahmin and the tiger, the pigs [prevailed].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:19.3"], "en": "Joyful and delighted,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:19.4", "PA_ja_492:20.1"], "en": "they let out a great roar at the foot of the Udumbara tree. They...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:20.2", "PA_ja_492:20.3"], "en": "The pigs gathered together and consecrated Tacchaka, saying,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:20.4"], "en": "\"You shall be our king and our lord.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_492:21.1"], "en": "The Ninth Jātaka: The Birth Story of the Carpenter and the Boar.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
