[
{"segs": ["PA_thag_1.36:0.1", "PA_thag_1.36:0.2", "PA_thag_1.36:0.3"], "en": "Theragāthā 1.36 Ekakanipāta Catutthavagga (The Fourth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.36:0.4"], "en": "The Verse of the Elder Kumāputta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.36:1.1"], "en": "“Excellent is learning, excellent is good conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.36:1.2"], "en": "excellent is always dwelling without a home.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.36:1.3"], "en": "“Seeking the goal and acting with circumspection—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.36:1.4"], "en": "this is the asceticism of one who possesses nothing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.36:1.5"], "en": "… Thus spoke the Elder Kumāputta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
