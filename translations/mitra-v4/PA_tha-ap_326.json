[
{"segs": ["PA_tha-ap_326:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:0.2"], "en": "Umāpupphiyavagga, 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:0.3"], "en": "The Apadāna of the Elder Yaññasāmika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:1.1"], "en": "“In my seventh year,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:1.2"], "en": "I had mastered the mantras;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:1.3"], "en": "I maintained the family traditions.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:1.4"], "en": "The sacrifice was undertaken by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:2.1", "PA_tha-ap_326:2.2"], "en": "At that time, eighty-four thousand animals were slaughtered for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:2.3"], "en": "Brought by the pillars of the chariot,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:2.4"], "en": "they stood ready for the sake of sacrifice;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:3.1"], "en": "like one struck by the mouth of a furnace, [he was consumed].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:3.2"], "en": "Resembling glowing embers of khadira wood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:3.3"], "en": "like the rising sun,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:3.4"], "en": "and like the full moon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:4.1"], "en": "Siddhattha, the one for whom all aims are accomplished,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:4.2"], "en": "honored by the three worlds, the benefactor;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:4.3"], "en": "having approached, the Perfectly Enlightened One—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:4.4"], "en": "He spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:5.1"], "en": "“Non-violence toward all living beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:5.2"], "en": "O prince, is pleasing to me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:5.3"], "en": "Abstinence from theft and transgression,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:5.4"], "en": "abstinence from drinking intoxicants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:6.1"], "en": "and delight in righteous conduct.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:6.2"], "en": "Erlernung of the scriptures and gratitude—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:6.3", "PA_tha-ap_326:6.4"], "en": "these qualities are praised both in this present life and in the life to come.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:7.1"], "en": "Having cultivated these qualities,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:7.2"], "en": "delighting in the welfare of all beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:7.3"], "en": "and having inspired confidence in the mind toward the Buddha—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:7.4"], "en": "“Cultivate the supreme path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:8.1"], "en": "Having said this, the All-Knowing One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:8.2"], "en": "the Eldest in the World, the Bull among Men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:8.3"], "en": "Having thus instructed me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:8.4"], "en": "he rose up and departed through the air;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:9.1"], "en": "having previously purified his mind, he went.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:9.2"], "en": "Afterwards, I gladdened my mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:9.3"], "en": "through that gladness of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:9.4"], "en": "I was reborn in the Tusita heaven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:10.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:10.2"], "en": "when I gladdened my mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:10.3"], "en": "I do not recall ever being born in an evil state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:10.4"], "en": "This is the fruit of the perception of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:11.1", "PA_tha-ap_326:11.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:11.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:12.1"], "en": "It was in this way that the venerable elder Yaññasāmika spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_326:13.1"], "en": "This is the fourth *apadāna* of the elder Yaññasāmika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
