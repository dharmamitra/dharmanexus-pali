[
{"segs": ["PA_tha-ap_308:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:0.2"], "en": "The Chapter on the Lotus Filaments (Padumakesaravagga),", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:0.3"], "en": "The Deeds of the Elder Sampasādaka (Sampasādakattherāpadāna)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:1.1"], "en": "“Homage to you, O Buddha, O Hero!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:1.2"], "en": "You are utterly liberated in every respect;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:1.3"], "en": "even when fallen into misfortune, [you remain steadfast].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:1.4", "PA_tha-ap_308:2.1", "PA_tha-ap_308:2.2"], "en": "“Be my refuge. Siddhattha, the peerless one in the world, gave him this prediction:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:2.3"], "en": "“The Saṅgha is like the great ocean,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:2.4"], "en": "immeasurable and unsurpassed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:3.1"], "en": "Therein, in that field free from dust, you [should sow].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:3.2", "PA_tha-ap_308:3.3"], "en": "Having inspired confidence in the Saṅgha, which bestows infinite fruit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:3.4"], "en": "sow the seed of virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:4.1"], "en": "Having said this, the All-Knowing One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:4.2"], "en": "the Eldest in the World, the Bull among Men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:4.3"], "en": "instructed me alone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:4.4"], "en": "He rose into the air and ascended into the sky.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:5.1", "PA_tha-ap_308:5.2"], "en": "Not long after the All-Knowing One, the Bull among Men, had departed, [the earth shook].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:5.3"], "en": "Having encountered death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:5.4"], "en": "I was reborn in Tuṣita; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:6.1"], "en": "in that stainless field, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:6.2", "PA_tha-ap_308:6.3"], "en": "Having inspired confidence in the Sangha, which bestows infinite fruit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:6.4"], "en": "may I rejoice in heaven for an eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:7.1"], "en": "In the ninety-fourth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:7.2"], "en": "I then obtained faith;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:7.3"], "en": "I do not recall ever being born in an unhappy state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:7.4"], "en": "This is the fruit of serene confidence:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:8.1", "PA_tha-ap_308:8.2"], "en": "the four analytical knowledges, and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:8.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:9.1"], "en": "It was in this way that the venerable elder Sampasādaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_308:10.1"], "en": "This is the sixth legend of the elder Sampasādaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
