[
{"segs": ["PA_cp_34:0.1", "PA_cp_34:0.2"], "en": "The Basket of Conduct (Cariyāpiṭaka), Chapter on Yudhañjaya,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:0.3"], "en": "Perfection of Loving-kindness (Mettāpāramī) 2", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:0.4", "PA_cp_34:1.1"], "en": "The Conduct of Ekarāja: \"Furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:1.2"], "en": "when I was known as Ekarāja...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:1.3"], "en": "Having resolved upon the supreme virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:1.4"], "en": "I rule the great earth;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:2.1"], "en": "[I establish] the ten paths of wholesome action.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:2.2"], "en": "I act without remainder;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:2.3"], "en": "with the four bases of sympathy,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:2.4"], "en": "I gather the great multitude.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:3.1"], "en": "Thus, for me who am heedful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:3.2"], "en": "both in this world and the next,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:3.3"], "en": "Dabbasena approached.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:3.4"], "en": "Not plundering my city—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:4.1"], "en": "those who live off the king in the towns,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:4.2"], "en": "together with the army, the staff, and the provincial officials.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:4.3"], "en": "Having brought everything under his control,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:4.4"], "en": "he buried me in a pit of kāsū grass,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:5.1"], "en": "along with my circle of ministers and my kingdom.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:5.2"], "en": "My harem was once flourishing;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:5.3"], "en": "having been seized after being snatched away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:5.4"], "en": "I see it as if it were my own beloved son.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:5.5"], "en": "“There is no one equal to me in loving-kindness;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:5.6"], "en": "this is my perfection of loving-kindness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_34:6.1"], "en": "Thus ends the fourteenth chapter, the Conduct of Ekarāja.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
