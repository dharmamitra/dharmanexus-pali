[
{"segs": ["PA_tha-ap_549:0.1", "PA_tha-ap_549:0.2"], "en": "The Legends of the Elders (Therāpadāna) Chapter on Bhaddiya (Bhaddiyavagga) 7.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:0.3"], "en": "The Legend of the Elder Abhaya (Abhayattheraapadāna)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:1.2"], "en": "the one with vision regarding all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:1.3"], "en": "[appeared] one hundred thousand aeons hence.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:1.4"], "en": "In that eon, the Leader appeared.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:2.1", "PA_tha-ap_549:2.2"], "en": "The Tathāgata established someone in the taking of refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:2.3"], "en": "That Hero established someone in virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:2.4"], "en": "the supreme tenfold path of action;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:3.1"], "en": "he gives to someone...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:3.2"], "en": "He bestows the supreme fruit of recluseship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:3.3", "PA_tha-ap_549:3.4"], "en": "as well as the eight attainments and the three types of higher knowledge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:4.1", "PA_tha-ap_549:4.2", "PA_tha-ap_549:4.3"], "en": "The Supreme among Men, the Protector, applied some beings to the six direct knowledges and bestowed [attainments] upon others.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:4.4"], "en": "The four analytical knowledges (paṭisambhidā).", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:5.1"], "en": "Having seen people capable of being awakened,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:5.2"], "en": "[one travels] even an incalculable number of yojanas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:5.3"], "en": "Having approached in an instant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:5.4"], "en": "the Charioteer of Men leads them away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:6.1"], "en": "At that time, in Haṃsavatī, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:6.2"], "en": "I was born into a lineage of brahmins;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:6.3", "PA_tha-ap_549:6.4"], "en": "I had mastered all the Vedas and was esteemed as an expert in grammatical exposition.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:7.1"], "en": "Skilled in etymology,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:7.2"], "en": "confident in the glossary,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:7.3"], "en": "a master of word-definitions and the ritual manuals.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:7.4"], "en": "An expert in prosody,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:8.1"], "en": "while wandering on a walking tour,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:8.2"], "en": "I approached the Haṃsārāma park.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:8.3"], "en": "I saw the supreme giver of boons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:8.4"], "en": "honored by the great multitude,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:9.1"], "en": "teaching the stainless Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:9.2"], "en": "I went against the current;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:9.3"], "en": "having approached that noble one,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:9.4"], "en": "I heard his stainless teaching.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:10.1", "PA_tha-ap_549:10.2", "PA_tha-ap_549:10.3"], "en": "I did not see in that Sage anything redundant, repetitive, superfluous, or purposeless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:10.4"], "en": "Then I went forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:11.1"], "en": "In no long time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:11.2"], "en": "I became confident among all beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:11.3", "PA_tha-ap_549:11.4"], "en": "I was skilled in the Buddha’s word and esteemed for my virtues.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:12.1"], "en": "At that time, [I recited] four verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:12.2"], "en": "Having composed it with beautiful phrasing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:12.3"], "en": "and having established the Supreme One of the Three Worlds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:12.4"], "en": "I shall teach it day by day.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:13.1"], "en": "“The Great Hero has become dispassionate,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:13.2"], "en": "dwelling amidst the fearful cycle of existence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:13.3"], "en": "yet out of compassion, he did not enter final Nibbāna.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:13.4"], "en": "Then the compassionate Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:14.1"], "en": "though still an ordinary person,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:14.2"], "en": "was no longer under the sway of the defilements.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:14.3"], "en": "Fully aware and endowed with mindfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:14.4"], "en": "therefore he is inconceivable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:15.1"], "en": "The defilements are weak;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:15.2", "PA_tha-ap_549:15.3"], "en": "That which had entered my heart was consumed by the fire of knowledge;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:15.4"], "en": "that it did not perish— this was a marvel.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:16.1"], "en": "He who is honored by the entire world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:16.2"], "en": "and by whom the world is likewise honored—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:16.3"], "en": "even so is he the Teacher of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:16.4"], "en": "\"The world follows after him\"—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:17.1", "PA_tha-ap_549:17.2"], "en": "thus praising the Fully Enlightened One and his teaching of the Dhamma with such words as these;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:17.3"], "en": "Having practiced this for as long as life lasted,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:17.4"], "en": "he went to heaven; passing away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:18.1"], "en": "after a hundred thousand aeons—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:18.2"], "en": "Because I praised the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:18.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:18.4"], "en": "this is the fruit of that praise.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:19.1"], "en": "In the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:19.2"], "en": "I exercised great sovereignty over the golden mountain;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:19.3"], "en": "as a wheel-turning monarch, I exercised great sovereignty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:19.4"], "en": "I have experienced this many times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:20.1"], "en": "I take birth in two states of existence:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:20.2"], "en": "among the gods and among humans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:20.3"], "en": "I know no other destination;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:20.4"], "en": "what is the fruit of this praise?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:21.1"], "en": "I am reborn into two families.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:21.2"], "en": "Neither among the Khattiyas nor the Brāhmaṇas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:21.3"], "en": "nor am I born into a low family;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:21.4"], "en": "this is the fruit of praise.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:22.1"], "en": "And now, in my final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:22.2"], "en": "in the supreme city of Giribbaja,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:22.3"], "en": "I was the son of King Bimbisāra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:22.4"], "en": "My son, named Abhaya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:23.1"], "en": "having fallen under the influence of evil friends,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:23.2"], "en": "was deluded by a Nigaṇṭha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:23.3", "PA_tha-ap_549:23.4"], "en": "Having approached the Best of Buddhas, I was questioned by Nātaputta;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:24.1"], "en": "having asked a subtle question, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:24.2"], "en": "Having heard this supreme exposition,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:24.3"], "en": "and not long after going forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:24.4"], "en": "I attained arhatship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:25.1"], "en": "Having praised the Supreme Victor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:25.2"], "en": "may I always be one who is praised;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:25.3"], "en": "may my body and face be fragrant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:25.4"], "en": "I was endowed with happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:26.1"], "en": "Possessing sharp laughter and quick wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:26.2"], "en": "I likewise possessed great wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:26.3"], "en": "And with inspired eloquence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:26.4"], "en": "by the power of that deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:27.1"], "en": "I praised Padumuttara.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:27.2"], "en": "With a serene mind toward the Unequaled Self-Existent One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:27.3", "PA_tha-ap_549:27.4"], "en": "he did not go to the states of misery for a hundred thousand aeons by virtue of that power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:28.1", "PA_tha-ap_549:28.2"], "en": "The defilements have been incinerated by me; ... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:28.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:29.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:29.2", "PA_tha-ap_549:29.3"], "en": "[as before] ...the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:30.1", "PA_tha-ap_549:30.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:30.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:31.1"], "en": "Thus indeed the venerable elder Abhaya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_549:32.1"], "en": "This is the seventh legend of the elder Abhaya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
