[
{"segs": ["PA_ja_502:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:0.2", "PA_ja_502:0.3"], "en": "The Collection of Twenty, Chapter on Mātaṅga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:0.4", "PA_ja_502:1.1"], "en": "6. The Cūḷahaṁsa Jātaka “These swans are flying away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:1.2"], "en": "their limbs trembling with fear;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:1.3"], "en": "O green-hued one, golden-colored,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:1.4"], "en": "O fair-faced one, depart as you wish!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:2.1"], "en": "Leaving me behind, the host of kinsmen—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:2.2"], "en": "One has fallen under the power of the snare;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:2.3"], "en": "others go on without looking back—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:2.4"], "en": "why do you alone lag behind?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:3.1"], "en": "Of those who fall, the winged are best;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:3.2"], "en": "there is no companionship for the bound.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:3.3"], "en": "Do not let yourself be lost to that which is free from distress.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:3.4"], "en": "\"By all means, Sumukha, you may depart.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:4.1", "PA_ja_502:4.2"], "en": "\"I am not one overcome by suffering, Dhatarattha; do not abandon me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:4.3"], "en": "“Whether life or death shall be mine,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:4.4"], "en": "it shall be together with you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:5.1"], "en": "“This is auspicious for a noble one,” [he said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:5.2"], "en": "\"O Sumukha, regarding that which you have spoken,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:5.3"], "en": "as I was investigating it,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:5.4"], "en": "I released the thought: 'Let this one fall!'\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:6.1"], "en": "“Footless he goes upon foot,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:6.2"], "en": "a bird that moves through the sky;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:6.3"], "en": "you did not perceive the snare from afar.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:6.4"], "en": "The most excellent among swans.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:7.1", "PA_ja_502:7.2"], "en": "When a person’s downfall occurs at the exhaustion of life—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:7.3"], "en": "Yet, having encountered the net and the snare,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:7.4"], "en": "he does not even realize it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:8.1"], "en": "These swans are now departing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:8.2", "PA_ja_502:8.3"], "en": "The limbs of the body are driven by fear; O golden-hued one,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:8.4"], "en": "you alone remain undaunted.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:9.1"], "en": "Having eaten and drunk,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:9.2"], "en": "these birds depart,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:9.3"], "en": "O Vakkaṅga, without looking back.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:9.4"], "en": "You alone pay homage to him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:10.1"], "en": "Why indeed is this man a brahmin?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:10.2"], "en": "You, being yourself free, pay homage to one who is bound.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:10.3"], "en": "\"The birds are departing;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:10.4"], "en": "why are you left behind alone?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:11.1"], "en": "\"That king is my friend, the brahmin.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:11.2", "PA_ja_502:11.3"], "en": "He is my friend and as dear to me as my own life;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:11.4"], "en": "I shall not abandon him until the time of his passing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:12.1", "PA_ja_502:12.2"], "en": "“Since you wish to sacrifice your own life for the sake of your friend,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:12.3"], "en": "I shall release that companion of yours.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:12.4", "PA_ja_502:13.1"], "en": "“Let the king be your follower. “So be it, hunter;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:13.2"], "en": "may you rejoice together with all your kinsmen.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:13.3"], "en": "\"Just as I rejoice today,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:13.4"], "en": "having seen the king of birds set free.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:14.1"], "en": "\"Is all well with you, sir?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:14.2"], "en": "I hope you are free from illness;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:14.3"], "en": "I hope this kingdom is prosperous,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:14.4"], "en": "and that you govern it with righteousness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:15.1"], "en": "“O swan, there is indeed what is wholesome for me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:15.2"], "en": "and also, O swan, freedom from illness;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:15.3"], "en": "and furthermore, this kingdom is prosperous.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:15.4"], "en": "“While instructing them according to the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:16.1", "PA_ja_502:16.2"], "en": "“I trust that no fault whatsoever exists among your ministers;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:16.3"], "en": "“Are your enemies far from you,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:16.4"], "en": "like a shadow to the south?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:17.1"], "en": "“And as for my ministers...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:17.2"], "en": "No fault whatsoever exists;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:17.3"], "en": "moreover, my enemies are far away,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:17.4"], "en": "like a shadow to the south.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:18.1"], "en": "“I hope your wife is your equal,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:18.2"], "en": "obedient, and sweet-spoken;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:18.3"], "en": "endowed with children, beauty, and fame.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:18.4"], "en": "“Following your will and pleasure.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:19.1"], "en": "“Moreover, my wife is my equal—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:19.2"], "en": "obedient and sweet-spoken.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:19.3"], "en": "“Endowed with sons, beauty, and fame,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:19.4"], "en": "they follow my will and desire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:20.1"], "en": "“I trust you have many sons?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:20.2"], "en": "Sujātā, the prosperer of the kingdom,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:20.3"], "en": "endowed with the swiftness of wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:20.4"], "en": "greets people from here and there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:21.1", "PA_ja_502:21.2"], "en": "“I have heard, Dhatarattha, that I have one hundred and one sons;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:21.3"], "en": "tell me what their duty is.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:21.4"], "en": "They do not disregard your words.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:22.1"], "en": "Even if one has been reborn,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:22.2"], "en": "whether by birth or by discipline;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:22.3"], "en": "But if one practices yoga only later,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:22.4"], "en": "one sinks into distress and misfortune.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:23.1"], "en": "For that person of feeble wisdom, [the goal is lost].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:23.2"], "en": "A great fissure arises;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:23.3", "PA_ja_502:23.4"], "en": "at night, as if blind, one perceives only gross forms.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:24.1", "PA_ja_502:24.2"], "en": "One who knows how to find the essence in the essenceless finds no wisdom at all;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:24.3"], "en": "like the Śarabha deer in a mountain fastness, he wanders in vain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:24.4"], "en": "He sinks away even in the midst of his efforts.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:25.1"], "en": "But even if he is of low birth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:25.2"], "en": "the man who is industrious and resolute;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:25.3"], "en": "Endowed with conduct and virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:25.4"], "en": "he shines like a fire at night.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:26.1"], "en": "Having made this my simile, [I speak].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:26.2"], "en": "\"Teach your sons the sciences;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:26.3"], "en": "let the wise one flourish,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:26.4"], "en": "like seed in a field through rain.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_502:27.1"], "en": "The Cūḷahaṁsa Jātaka, the sixth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
