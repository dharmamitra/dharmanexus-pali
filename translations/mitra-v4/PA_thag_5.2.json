[
{"segs": ["PA_thag_5.2:0.1", "PA_thag_5.2:0.2", "PA_thag_5.2:0.3"], "en": "Theragāthā 5.2 Pañcaka-nipāta First Chapter (Paṭhamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:0.4"], "en": "The Verse of the Elder Subhūti:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:1.1", "PA_thag_5.2:1.2"], "en": "“A man who desires his own welfare, Applying himself to what is not the proper application, ... [is acting wrongly].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:1.3", "PA_thag_5.2:1.4"], "en": "If I were not to attain it, I would think: \"That is an inauspicious mark for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:2.1"], "en": "But it has been pulled out, gone beyond suffering, and conquered.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:2.2"], "en": "If one were to let go of one [sense], it would be like a dice-game;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:2.3"], "en": "but if one were to let go of all of them, one would indeed be blind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:2.4"], "en": "because of not seeing the even and the uneven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:3.1"], "en": "Speak only what you would do;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:3.2", "PA_thag_5.2:3.3"], "en": "do not speak what you would not do. One who speaks without acting—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:3.4"], "en": "The wise understand it thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:4.1", "PA_thag_5.2:4.2"], "en": "just as a beautiful flower may be colorful yet lacking fragrance.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:4.3", "PA_thag_5.2:4.4"], "en": "Thus well-spoken words are fruitless for one who does not act upon them,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:5.1"], "en": "just like a beautiful flower [that is not used].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:5.2"], "en": "“Beautiful and fragrant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:5.3", "PA_thag_5.2:5.4"], "en": "thus well-spoken speech is fruitful for the one who acts.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_5.2:5.5"], "en": "… the Elder Subhūti …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
