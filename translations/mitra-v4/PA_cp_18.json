[
{"segs": ["PA_cp_18:0.1"], "en": "Cariyāpiṭaka, Hatthināgavagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:0.2", "PA_cp_18:0.3"], "en": "Sīlapāramī 8: The Perfection of Virtue in the Story of the Elephant King.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:0.4", "PA_cp_18:1.1"], "en": "The Deity Dhammadeva’s Conduct: “Furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:1.2"], "en": "when I was one of great following and great psychic power;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:1.3"], "en": "The Dhamma is indeed a great yakṣa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:1.4"], "en": "compassionate toward the entire world;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:2.1"], "en": "it is the ten paths of wholesome action.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:2.2"], "en": "Exhorting the great multitude,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:2.3"], "en": "I wander through villages and market towns,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:2.4"], "en": "accompanied by my friends and my retinue.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:3.1"], "en": "The wicked, stingy yakkha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:3.2"], "en": "proclaiming ten evils—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:3.3"], "en": "he indeed wanders here upon this earth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:3.4"], "en": "Together with my friends and followers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:4.1"], "en": "we both speak according to the Dhamma and yet act contrary to it;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:4.2"], "en": "we are both adversaries.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:4.3"], "en": "Clashing pole against pole on a narrow path,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:4.4"], "en": "we both met on the way;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:5.1"], "en": "a terrifying quarrel ensued.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:5.2"], "en": "And for one who has done both good and evil,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:5.3", "PA_cp_18:5.4"], "en": "a great battle stands ready for the purpose of entering the path.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:6.1"], "en": "If I were to become angry with him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:6.2"], "en": "or if I were to break my ascetic virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:6.3"], "en": "[I would bring ruin] upon him together with his retinue.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:6.4"], "en": "I would act as a king;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:7.1", "PA_cp_18:7.2"], "en": "yet, by guarding my virtue and having stilled my mind, I shall attain Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:7.3"], "en": "Having descended from the path together with people,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:7.4"], "en": "I became a servant of evil.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:8.1"], "en": "When I had departed from the path, along with them...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:8.2"], "en": "Having brought about the peace of his mind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:8.3", "PA_cp_18:8.4"], "en": "the earth immediately opened up for that evil yakkha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_18:9.1"], "en": "The eighth: The Deeds of Dhammadevaputta.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
