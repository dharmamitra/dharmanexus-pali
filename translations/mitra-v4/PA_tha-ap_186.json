[
{"segs": ["PA_tha-ap_186:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:0.2"], "en": "The Chapter on the Kuṭaja Flower (Kuṭajapupphiyavagga), No. 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:0.3"], "en": "The Apadāna of the Elder Pañcahatthiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:1.1"], "en": "“The Blessed One named Tissa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:1.2"], "en": "the eldest in the world, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:1.3"], "en": "was preceded by his disciples.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:1.4"], "en": "Enter the street.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:2.1", "PA_tha-ap_186:2.2"], "en": "Four handfuls of blue lotuses have been placed there by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:2.3", "PA_tha-ap_186:2.4"], "en": "Desiring to offer an oblation for the sake of fulfilling my vow,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:3.1"], "en": "I approached the Sambuddha, who was the color of gold.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:3.2"], "en": "As I was walking through the marketplace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:3.3"], "en": "I was touched by the rays of the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:3.4"], "en": "I paid homage to the Supreme among Bipeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:4.1"], "en": "In the ninety-two aeons since then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:4.2"], "en": "because I offered that flower in worship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:4.3"], "en": "I have not known a state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:4.4"], "en": "This is the fruit of worshiping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:5.1"], "en": "Thirteen eons from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:5.2"], "en": "five who are highly esteemed as Susabha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:5.3"], "en": "Possessing the seven jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:5.4"], "en": "they are wheel-turning monarchs of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:6.1"], "en": "[they possess] the four analytical knowledges.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:6.3"], "en": "the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:7.1"], "en": "Thus indeed did the venerable elder Pañcahatthiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_186:8.1"], "en": "The legend of the Elder Pañcahatthiya is the fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
