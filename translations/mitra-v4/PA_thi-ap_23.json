[
{"segs": ["PA_thi-ap_23:0.1"], "en": "The Therī-Apadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:0.2"], "en": "Kuṇḍalakesīvagga 3.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:0.3"], "en": "The Apadāna of the Elder Nun Dhammadinnā", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:1.2"], "en": "who had reached the further shore of all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:1.3"], "en": "[lived] one hundred thousand aeons ago from here.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:1.4"], "en": "The Leader appeared in that eon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:2.1", "PA_thi-ap_23:2.2"], "en": "At that time, I was born into a certain family in Haṃsavatī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:2.3"], "en": "I was a hired laborer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:2.4"], "en": "diligent and restrained by virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:3.1"], "en": "under the Buddha Padumuttara.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:3.2"], "en": "Sujāta, the foremost disciple,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:3.3"], "en": "having departed from the monastery,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:3.4"], "en": "goes for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:4.1", "PA_thi-ap_23:4.2", "PA_thi-ap_23:4.3"], "en": "Then, seeing that water-carrier going along carrying a jar, I gave her a cake.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:4.4"], "en": "With his own hands, full of faith,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:5.1"], "en": "he accepted [the food] right there and,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:5.2"], "en": "while remaining seated, he partook of it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:5.3"], "en": "Then, having led him to my home,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:5.4"], "en": "I gave him food;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:6.1"], "en": "thereupon my grandfather was pleased.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:6.2"], "en": "Having made my own daughter-in-law go with me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:6.3", "PA_thi-ap_23:6.4"], "en": "I went together with my mother-in-law and paid homage to the Fully Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:7.1", "PA_thi-ap_23:7.2"], "en": "Then, praising that bhikkhunī who was a preacher of the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:7.3"], "en": "he placed her in the foremost position.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:7.4"], "en": "Having heard that, I was filled with joy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:8.1"], "en": "I invited the Sugata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:8.2"], "en": "the Leader of the World, together with his Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:8.3"], "en": "Having given that great gift,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:8.4"], "en": "I aspired for that state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:9.1"], "en": "Then the Sugata said to me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:9.2"], "en": "With a voice like the deep roar of thunder,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:9.3"], "en": "[he said]: “To those who delight in attending upon me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:9.4"], "en": "and who provide food for the Saṅgha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:10.1", "PA_thi-ap_23:10.2", "PA_thi-ap_23:10.3"], "en": "O Bhaddā, you who are fit to hear the true Dhamma and whose mind is increased by virtue, be joyful!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:10.4"], "en": "You shall attain the fruit of your aspiration.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:11.1"], "en": "One hundred thousand aeons hence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:11.2"], "en": "you will be born in the lineage of Okkāka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:11.3", "PA_thi-ap_23:11.4"], "en": "One named Gotama by clan will become a teacher in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:12.1"], "en": "he will be an heir to his teachings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:12.2"], "en": "“Born from the breast, fashioned by the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:12.3", "PA_thi-ap_23:12.4"], "en": "she shall be a female disciple of the Teacher, known by the name Dhammadinnā.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:13.1"], "en": "Having heard that, I became joyful and,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:13.2", "PA_thi-ap_23:13.3"], "en": "with a mind of loving-kindness, served the Great Sage for as long as I lived.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:13.4", "PA_thi-ap_23:14.1", "PA_thi-ap_23:14.2"], "en": "The Guide, through those well-performed deeds and through his intentions and aspirations;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:14.3"], "en": "Having abandoned my human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:14.4", "PA_thi-ap_23:15.1"], "en": "I went to the Tāvatiṃsa realm in this auspicious aeon.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:15.2"], "en": "A kinsman of Brahmā, of great renown,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:15.3"], "en": "named Kassapa by clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:15.4"], "en": "arose as the best among those who speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:16.1", "PA_thi-ap_23:16.2", "PA_thi-ap_23:16.3"], "en": "At that time, the lord of men, the King of Kāsi named Kikī, was the attendant of the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:16.4"], "en": "In the supreme city of Bārāṇasī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:17.1"], "en": "I was his sixth daughter,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:17.2"], "en": "renowned by the name Sudhammā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:17.3"], "en": "Having heard the Dhamma from the Conqueror’s chief,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:17.4"], "en": "I resolved upon the going-forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:18.1"], "en": "yet our father did not grant us permission.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:18.2"], "en": "At that time, like those in a house,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:18.3", "PA_thi-ap_23:18.4"], "en": "we wandered for twenty thousand years without weariness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:19.1"], "en": "The third recitation section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:20.1"], "en": "The maiden’s holy life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:20.2"], "en": "the princess raised in luxury.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:20.3"], "en": "Delighting in attending upon the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:20.4"], "en": "there were seven joyful daughters:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:21.1"], "en": "Samaṇī and Samaṇaguttā, and...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:21.2"], "en": "The nun Bhikkhudāyikā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:21.3"], "en": "and both Dhammā and Sudhammā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:21.4"], "en": "the seventh was Saṅghadāyikā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:22.1"], "en": "Khemā and Uppalavaṇṇā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:22.2"], "en": "Paṭācārā and Kuṇḍalā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:22.3"], "en": "Gotamī and I myself—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:22.4"], "en": "Visākhā was the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:23.1", "PA_thi-ap_23:23.2"], "en": "By those well-performed deeds and by her intentions and aspirations, [she attained this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:23.3"], "en": "Having cast off the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:23.4"], "en": "I went to the realm of the Thirty-three;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:24.1"], "en": "and now, in my final existence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:24.2"], "en": "In Giribbaja, the most excellent city,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:24.3"], "en": "he was born into a prosperous and wealthy merchant family,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:24.4"], "en": "which was fully endowed with all desirable things.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:25.1", "PA_thi-ap_23:25.2"], "en": "When she is endowed with the qualities of beauty and stands in the first bloom of youth, then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:25.3"], "en": "having gone to another’s family, she [is enjoyed].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:25.4"], "en": "We dwelt established in happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:26.1", "PA_thi-ap_23:26.2"], "en": "Having approached the refuge of the world and heard the teaching of the Dhamma, we remained there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:26.3", "PA_thi-ap_23:26.4"], "en": "My husband, who is possessed of great wisdom, has attained the fruit of non-returning;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:27.1"], "en": "having then given his permission, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:27.2"], "en": "I went forth into homelessness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:27.3"], "en": "and in no long time at all,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:27.4"], "en": "I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:28.1"], "en": "Then that lay follower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:28.2"], "en": "having approached me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:28.3"], "en": "questioned me with profound and subtle questions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:28.4"], "en": "I answered them all.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:29.1"], "en": "The Victor, pleased with that quality,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:29.2"], "en": "placed me in the foremost position.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:29.3", "PA_thi-ap_23:29.4"], "en": "“I see no other bhikkhunī preacher of the Dhamma like this;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:30.1"], "en": "just as the wise Dhammadinnā is.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:30.2"], "en": "\"Thus you should remember it, O monks\";", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:30.3"], "en": "thus do I become wise,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:30.4"], "en": "having been shown compassion by the Leader.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:31.1"], "en": "The Teacher has been served by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:31.2"], "en": "the Buddha’s instruction has been fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:31.3"], "en": "the heavy burden has been laid down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:31.4"], "en": "The conduit to existence has been uprooted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:32.1", "PA_thi-ap_23:32.2"], "en": "That for whose sake one has gone forth from the home life into homelessness— [that goal has been attained].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:32.3"], "en": "Thus has my goal been attained:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:32.4"], "en": "the destruction of all fetters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:33.1"], "en": "I have mastery over the supernormal powers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:33.2"], "en": "With the divine ear-element,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:33.3"], "en": "I know the minds of others,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:33.4"], "en": "fulfilling the Teacher’s instruction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:34.1"], "en": "I know my former abodes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:34.2"], "en": "the divine eye is purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:34.3"], "en": "having exhausted all taints, I am free.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:34.4"], "en": "I was pure and stainless;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:35.1"], "en": "my defilements have been incinerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:35.2"], "en": "…pe…", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:35.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:36.1", "PA_thi-ap_23:36.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:36.3"], "en": "This is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:37.1", "PA_thi-ap_23:37.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:37.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_23:38.1"], "en": "Thus indeed did the bhikkhunī Dhammadinnā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
