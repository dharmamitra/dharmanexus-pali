[
{"segs": ["PA_thag_3.14:0.1", "PA_thag_3.14:0.2"], "en": "Theragāthā 3.14 Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:0.4"], "en": "Gotama Thera’s Verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:1.1"], "en": "“Indeed, wandering through saṃsāra, I would go to hell,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:1.2"], "en": "And I went to the world of petas again and again.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:1.3", "PA_thag_3.14:1.4"], "en": "Indeed, I have dwelt for many long ages in manifold ways even within the painful realm of animal birth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:2.1"], "en": "and even human existence has been sought after by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:2.2"], "en": "I went to the heavenly body again and again;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:2.3"], "en": "I remained in the realms of form and the formless realms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:2.4"], "en": "among those with perception and those without perception.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:3.1"], "en": "Origins are well understood to be pithless,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:3.2"], "en": "conditioned, unstable, and subject to agitation;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:3.3"], "en": "having understood that the origin of great suffering is thus, [one should abandon it].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:3.4"], "en": "“The mindful one has attained peace itself,” said the Elder Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_3.14:3.5"], "en": "… [The Elder] Gotama …", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
