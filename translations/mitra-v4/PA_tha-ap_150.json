[
{"segs": ["PA_tha-ap_150:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:0.2", "PA_tha-ap_150:0.3"], "en": "Chapter on the Parasol (Chattavagga), 8. The Apadāna of the Elder Phalakadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:1.1"], "en": "“In the past, I was a cartwright,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:1.2"], "en": "well-trained in woodwork;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:1.3"], "en": "having fashioned a plank of sandalwood, I— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:1.4"], "en": "I gave [this] to the Kinsman of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:2.1"], "en": "This celestial mansion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:2.2"], "en": "well-fashioned of gold, shines forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:2.3"], "en": "Elephant-vehicles, horse-vehicles,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:2.4"], "en": "and celestial vehicles are provided;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:3.1"], "en": "as well as palaces and palanquins.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:3.2"], "en": "They arise according to my wish;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:3.3", "PA_tha-ap_150:3.4"], "en": "this is the unshakeable jewel that is the fruit of my plank.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:4.1"], "en": "In the ninety-first aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:4.2"], "en": "I gave a wooden plank;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:4.3"], "en": "I do not recall ever being born in an evil state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:4.4"], "en": "This is the fruit of Phalaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:5.1"], "en": "In the fifty-seventh aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:5.2"], "en": "there will be four named Nimmita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:5.3"], "en": "Possessing the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:5.4"], "en": "they are wheel-turning monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:6.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:7.1"], "en": "Thus indeed did the venerable elder Phalakadāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_150:8.1"], "en": "The legend of the Elder Phalakadāyaka is the eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
