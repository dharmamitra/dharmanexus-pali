[
{"segs": ["PA_thi-ap_14:0.1"], "en": "The Therī-apadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:0.2"], "en": "Ekūposathika-vagga 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:0.3"], "en": "The Apadāna of the Elder Nun Ekāsanadāyikā", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:1.1", "PA_thi-ap_14:1.2"], "en": "“At that time, in the city of Haṃsavatī, I was a young girl;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:1.3"], "en": "both my mother and my father— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:1.4"], "en": "They went about their work.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:2.1"], "en": "At midday, when the sun was high,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:2.2"], "en": "I saw a recluse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:2.3"], "en": "As he was following along the path,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:2.4", "PA_thi-ap_14:3.1"], "en": "I prepared a seat for him with woolen rugs and antelope skins.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:3.2"], "en": "Having prepared my seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:3.3"], "en": "with a clear mind and joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:3.4"], "en": "I spoke these words.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:4.1"], "en": "“The ground is heated and steaming,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:4.2"], "en": "the sun stands at midday,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:4.3"], "en": "and the breezes do not blow.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:4.4"], "en": "If it is the right time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:5.1", "PA_thi-ap_14:5.2"], "en": "O Sage, may you sit here; this seat has been prepared for you, Great Muni.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:5.3"], "en": "“Out of compassion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:5.4"], "en": "please sit on my seat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:6.1"], "en": "There the ascetic sat down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:6.2"], "en": "Well-tamed and pure in mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:6.3"], "en": "having taken his bowl,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:6.4"], "en": "I gave him whatever was available.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:7.1", "PA_thi-ap_14:7.2"], "en": "By that well-performed kamma and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:7.3"], "en": "having abandoned this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:7.4"], "en": "I went to the realm of the Thirty-three. There,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:8.1"], "en": "for me, a celestial mansion was well-constructed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:8.2"], "en": "beautifully fashioned with a seat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:8.3", "PA_thi-ap_14:8.4"], "en": "Sixty yojanas in height and thirty yojanas in width,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:9.1"], "en": "made of gold and adorned with jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:9.2", "PA_thi-ap_14:9.3", "PA_thi-ap_14:9.4"], "en": "Furthermore, my various couches were made of crystal, and indeed of ruby.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:10.1", "PA_thi-ap_14:10.2"], "en": "With stuffed cushions, and those made of wickerwork or painted cloth; and with rugs of sheepskin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:10.3"], "en": "either with the wool on one side or on both.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:10.4"], "en": "My couches are well-arranged;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:11.1"], "en": "whenever I desire to go,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:11.2"], "en": "they are provided with laughter and play.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:11.3"], "en": "Together with the most excellent of those on the royal couch,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:11.4"], "en": "I go to my desired destination,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:12.1"], "en": "[to the realm] of the eighty kings of devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:12.2"], "en": "I exercised supreme sovereignty;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:12.3", "PA_thi-ap_14:12.4"], "en": "seventy times I exercised supreme sovereignty as a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:13.1"], "en": "As I wandered through various states of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:13.2"], "en": "I obtained great wealth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:13.3"], "en": "there was no deficiency in my riches.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:13.4"], "en": "This is the fruit of sitting at a single seat:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:14.1"], "en": "I transmigrate through two states of existence—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:14.2"], "en": "among the gods and among humans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:14.3"], "en": "I know no other existence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:14.4"], "en": "this is the fruit of the single seat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:15.1"], "en": "I am reborn into two families.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:15.2"], "en": "Whether among Kṣatriyas or Brāhmaṇas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:15.3"], "en": "one is born into high-born families everywhere:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:15.4"], "en": "this is the fruit of sitting on a single seat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:16.1", "PA_thi-ap_14:16.2"], "en": "I know no mental distress that torments my mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:16.3"], "en": "I know no change in my complexion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:16.4"], "en": "This is the fruit of using a single seat:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:17.1", "PA_thi-ap_14:17.2"], "en": "many hunchbacked female slaves and maidservants attend upon me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:17.3"], "en": "I go from lap to lap;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:17.4"], "en": "this is the fruit of sitting alone.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:18.1"], "en": "Others bathe me and feed me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:18.2"], "en": "Others always delight me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:18.3"], "en": "and others anoint me with perfumes;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:18.4"], "en": "this is the fruit of the single seat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:19.1"], "en": "Whether dwelling in a pavilion, at the foot of a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:19.2"], "en": "or in an empty house,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:19.3"], "en": "she understood my intention.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:19.4"], "en": "A couch appears before me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:20.1", "PA_thi-ap_14:20.2"], "en": "This is my last; my final existence is now unfolding.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:20.3"], "en": "Even today, having renounced my kingdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:20.4"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:21.1"], "en": "One hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:21.2"], "en": "Because I gave that gift at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:21.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:21.4"], "en": "this is the fruit of that single seat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:22.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:22.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:22.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:23.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:23.2", "PA_thi-ap_14:23.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:24.1", "PA_thi-ap_14:24.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:24.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:25.1"], "en": "Thus indeed did the bhikkhunī Ekāsanadāyikā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_14:26.1"], "en": "This is the fourth apadāna of the elder bhikkhunī Ekāsanadāyikā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
