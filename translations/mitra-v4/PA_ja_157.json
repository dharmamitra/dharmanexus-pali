[
{"segs": ["PA_ja_157:0.1", "PA_ja_157:0.2", "PA_ja_157:0.3"], "en": "Jātaka: The Second Book of Birth Stories (Dukanipāta), Chapter on the Firm (Daḷhavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_157:0.4"], "en": "7. The Guṇa Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_157:1.1", "PA_ja_157:1.2"], "en": "“By which [virtue] she sends away her desires at will—such is the Dhamma of the powerful deer.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_157:1.3", "PA_ja_157:1.4"], "en": "\"Know that from birth there arises fear,\" she cried out.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_157:2.1"], "en": "\"Even if a friend is weak...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_157:2.2"], "en": "He stands firm in the duties of friends;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_157:2.3"], "en": "he is my kinsman and relative,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_157:2.4"], "en": "he is my friend and my companion.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_157:2.5"], "en": "“O tusked one, do not despise me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_157:2.6"], "en": "I am a jackal who has given you life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_157:3.1"], "en": "The Guṇa Jātaka, the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
