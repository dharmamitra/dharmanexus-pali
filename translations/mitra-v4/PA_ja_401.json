[
{"segs": ["PA_ja_401:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:0.2", "PA_ja_401:0.3"], "en": "The Section of Sevens, Chapter on the Cocks (Kukkuvagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:0.4"], "en": "6. The Paṇṇaka Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:1.1", "PA_ja_401:1.2"], "en": "“The sharp-edged sword, well-tempered and polished, with its blade keen and its hilt complete—”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:1.3"], "en": "A man swallows it in the midst of an assembly—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:1.4"], "en": "what is more difficult than that?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:1.5"], "en": "Whatever other matter is difficult to do, [it is even harder than that].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:1.6"], "en": "\"Tell me that when you are asked:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:2.1", "PA_ja_401:2.2"], "en": "'Out of greed, a man might drink from a sword-blade with a well-formed cup.'\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:2.3", "PA_ja_401:2.4"], "en": "But for one who says \"I give,\" that is even more difficult than that;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:2.5"], "en": "the state of omniscience is easy to attain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:2.6"], "en": "“Know this, Maddava! Thus did Āyupāla,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:3.1", "PA_ja_401:3.2"], "en": "skilled in the meaning of the Dhamma, answer the question.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:3.3"], "en": "Now I ask you, Pukkusa:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:3.4"], "en": "what is more difficult than that?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:3.5"], "en": "Whatever other state may be difficult to perform, [tell me of it].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:3.6"], "en": "\"Tell me that when you are asked.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:4.1"], "en": "\"They do not live by speech;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:4.2"], "en": "fruitless is the word uttered.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:4.3"], "en": "But for one who, having given, should not speak of it—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:4.4"], "en": "that is more difficult than that;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:4.5"], "en": "the state of omniscience is easy to achieve.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:4.6"], "en": "\"Know this, Maddava!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:5.1"], "en": "Pukkusa has answered the question,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:5.2"], "en": "being skilled in the meaning of the Dhamma.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:5.3"], "en": "Now I ask Senaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:5.4"], "en": "what is more difficult than that?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:5.5"], "en": "Whatever other state is difficult to perform—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:5.6"], "en": "\"Being asked, tell me that.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:6.1"], "en": "\"A person might give a gift,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:6.2"], "en": "whether it be small or great;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:6.3"], "en": "But he who, having given, does not regret it—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:6.4"], "en": "that is even more difficult than that;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:6.5"], "en": "the state of omniscience is easy to achieve.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:6.6"], "en": "“Know this, Maddava!", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:7.1"], "en": "Āyura has answered the question,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:7.2"], "en": "as has the man Pukkusāti.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:7.3"], "en": "\"He surpasses all questions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:7.4"], "en": "just as Senaka speaks.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_401:8.1"], "en": "Thus ends the sixth Jātaka, the Paṇṇaka-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
