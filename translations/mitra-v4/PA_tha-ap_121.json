[
{"segs": ["PA_tha-ap_121:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:0.2"], "en": "Mahāparivāravagga 9:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:0.3"], "en": "The Apadāna of the Elder Paccupaṭṭhānasaññaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:1.1", "PA_tha-ap_121:1.2"], "en": "“Immediately after the Sugata Atthadassi had attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:1.3"], "en": "I was reborn in the womb of a yakkha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:1.4"], "en": "When I attained fame at that time, I thought:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:2.1"], "en": "\"Alas, it was a poor gain for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:2.2"], "en": "it was a poorly dawned and poorly arisen fortune.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:2.3"], "en": "While my wealth still remained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:2.4"], "en": "the Visionary One attained final Nibbāna;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:3.1"], "en": "having understood my intention, he passed away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:3.2"], "en": "The disciple named Sāgara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:3.3"], "en": "desiring to uplift me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:3.4"], "en": "came into my presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:4.1"], "en": "Why do you grieve? Do not fear;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:4.2"], "en": "practice the Dhamma, O wise one.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:4.3"], "en": "It has been bestowed by the Buddha—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:4.4"], "en": "All possess the perfection of seeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:5.1"], "en": "Whoever should worship the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:5.2"], "en": "the Leader of the World, while he still dwells;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:5.3", "PA_tha-ap_121:5.4"], "en": "One should worship even a relic the size of a mustard seed of one who has attained Nibbāna;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:6.1"], "en": "for the clarity of the mind is the same [in both cases].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:6.2"], "en": "Merit is equal and sublime;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:6.3"], "en": "therefore, having constructed a stupa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:6.4"], "en": "worship the relics of the Victor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:7.1"], "en": "Having heard the words of Sāgara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:7.2"], "en": "I built a stupa for the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:7.3"], "en": "for five years, I rendered service there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:7.4"], "en": "To the Sage’s supreme stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:8.1"], "en": "By that deed, O Best of Bipeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:8.2"], "en": "Foremost in the World, Bull among Men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:8.3"], "en": "Having experienced prosperity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:8.4"], "en": "I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:9.1"], "en": "Possessing vast wisdom, I [attained] the four...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:9.2"], "en": "Seven hundred eons from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:9.3", "PA_tha-ap_121:9.4"], "en": "there will be wheel-turning monarchs of great power, endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:10.1", "PA_tha-ap_121:10.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:10.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:11.1"], "en": "Thus indeed the venerable elder Paccupaṭṭhānasaññaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_121:12.1"], "en": "This is the ninth legend of the elder Paccupaṭṭhānasaññaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
