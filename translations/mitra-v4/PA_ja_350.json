[
{"segs": ["PA_ja_350:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:0.2", "PA_ja_350:0.3"], "en": "Catukkanipāta, Cūḷakuṇālavagga (The Minor Section on Kuṇāla)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:0.4"], "en": "10. The Devatāpañha Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:1.1", "PA_ja_350:1.2"], "en": "“He strikes with his hands and feet, and he bites with his mouth;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:1.3"], "en": "\"He indeed becomes dear to the king;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:1.4"], "en": "what do you see in him that you look upon him thus?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:2.1"], "en": "\"He reviles me as he pleases.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:2.2"], "en": "He desires his arrival;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:2.3"], "en": "indeed, such a person is dear to the king—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:2.4"], "en": "what do you see in him that you look upon him so?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:3.1"], "en": "“He who accuses another with what is untrue and false,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:3.2"], "en": "and who pursues him with malice—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:3.3"], "en": "he indeed becomes dear to the king.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:3.4"], "en": "“What do you see in him?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:4.1"], "en": "“Food and drink,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:4.2"], "en": "clothing and lodgings— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:4.3"], "en": "Those who take away what belongs to others,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:4.4"], "en": "O King, are indeed beloved;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:4.5"], "en": "why do you look upon such a person with favor?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:5.1"], "en": "The Devatāpañha Jātaka, the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:5.2"], "en": "The fifth chapter, the Cūḷakuṇāla-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:6.1"], "en": "Its summary verse (uddāna):", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:7.1"], "en": "The excellent lion among men,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:7.2"], "en": "then the excellent blue fire,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:7.3"], "en": "and again the excellent mountain of elixir.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:7.4"], "en": "\"Likewise, the forest charioteer kills ten.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:8.1", "PA_ja_350:9.1"], "en": "Then follows the summary of the sections: Kāliṅga and Pucimanda.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:9.2"], "en": "The \"Cuckoo\" chapter on the defiler of the hut;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:9.3", "PA_ja_350:9.4"], "en": "this fifth chapter, the \"Minor Kuṇāla,\" has been well-expounded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_350:10.1"], "en": "The Catukkanipāta (The Book of Fours) is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
