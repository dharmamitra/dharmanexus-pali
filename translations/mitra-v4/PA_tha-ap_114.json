[
{"segs": ["PA_tha-ap_114:0.1", "PA_tha-ap_114:0.2", "PA_tha-ap_114:0.3"], "en": "The Apadāna of the Elder Sumaṅgala From the Mahāparivāra Chapter of the Therāpadāna, Number Two.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:1.1"], "en": "“Atthadassī, the supreme Victor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:1.2"], "en": "the eldest in the world, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:1.3"], "en": "having gone forth from his dwelling,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:1.4", "PA_tha-ap_114:2.1"], "en": "The Fully Awakened One approached a pond; having bathed and drunk,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:2.2"], "en": "he emerged and put on his single robe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:2.3"], "en": "The Blessed One stood there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:2.4"], "en": "surveying every direction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:3.1"], "en": "I was seated within my dwelling.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:3.2"], "en": "I saw the Leader of the World;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:3.3"], "en": "joyful with a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:3.4"], "en": "I then clapped my hands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:4.1"], "en": "Like a four-rayed sun shining,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:4.2"], "en": "like gleaming gold,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:4.3"], "en": "I was devoted to dance and song.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:4.4", "PA_tha-ap_114:5.1"], "en": "And amidst the fivefold musical instruments— whichever womb I was reborn into,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:5.2"], "en": "whether as a deity or a human.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:5.3"], "en": "I overcome all beings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:5.4"], "en": "my fame is vast.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:6.1"], "en": "Homage to you, O noble steed among men!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:6.2"], "en": "Homage to you, O Supreme among Men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:6.3"], "en": "having brought satisfaction to yourself, you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:6.4"], "en": "O Sage, have brought satisfaction to others.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:7.1"], "en": "Having sat down in the assembly hall,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:7.2"], "en": "O venerable one, and having shown a smile,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:7.3"], "en": "he waited upon the Fully Awakened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:7.4"], "en": "I was reborn in Tusita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:8.1"], "en": "In sixteen hundred aeons, [there were] two,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:8.2"], "en": "nine, and one who attained the state of thoughtlessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:8.3"], "en": "Possessing the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:8.4"], "en": "they are wheel-turning monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:9.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:9.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:9.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:10.1"], "en": "Thus indeed did the venerable elder Sumaṅgala speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_114:11.1"], "en": "The legend of the Elder Sumaṅgala is the second.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
