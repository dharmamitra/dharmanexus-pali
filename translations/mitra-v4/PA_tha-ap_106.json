[
{"segs": ["PA_tha-ap_106:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:0.2"], "en": "Bhikkhadāyivagga 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:0.3"], "en": "The Apadāna of the Elder Padapūjaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:1.1"], "en": "“To the Blessed One Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:1.2"], "en": "I offered jasmine flowers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:1.3"], "en": "seven flowers upon his feet.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:1.4", "PA_tha-ap_106:2.1"], "en": "They were scattered upon me by her with a laugh. By that deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:2.2"], "en": "today I surpass both men and gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:2.3", "PA_tha-ap_106:2.4"], "en": "I bear my final body within the teaching of the Perfectly Enlightened One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:3.1"], "en": "ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:3.2"], "en": "The flower that I offered—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:3.4"], "en": "this is the fruit of that flower-offering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:4.1", "PA_tha-ap_106:4.2", "PA_tha-ap_106:4.3"], "en": "There were thirteen wheel-turning monarchs named Samantagandha in the fifth aeon ago from this one.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:4.4"], "en": "The rulers of the four quarters;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:5.1", "PA_tha-ap_106:5.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:5.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:6.1"], "en": "In this way, it is said, the venerable elder Padapūjaka recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_106:7.1"], "en": "This is the fourth *apadāna* of the elder Padapūjaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
