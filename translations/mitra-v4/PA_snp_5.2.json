[
{"segs": ["PA_snp_5.2:0.1", "PA_snp_5.2:0.2", "PA_snp_5.2:1.1"], "en": "Sutta Nipāta 5.2 Ajitamāṇavapucchā “By what is the world enveloped? ... [The rest of the verse follows] ...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:1.2"], "en": "(Thus spoke the Venerable Ajita:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:1.3"], "en": "\"By what does it not shine forth?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:1.4"], "en": "What do you say is its defilement?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:1.5"], "en": "“What is his greatest fear?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:2.1", "PA_snp_5.2:2.2"], "en": "“The world is shrouded by ignorance,” said the Blessed One, “O Ajita.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:2.3"], "en": "Through deceit and negligence, it does not shine forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:2.4"], "en": "I say that craving is its smearing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:2.5"], "en": "and suffering is its great terror.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:3.1", "PA_snp_5.2:3.2"], "en": "“Streams flow everywhere,” said the Venerable Ajita,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:3.3"], "en": "“what is the damming of those streams?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:3.4"], "en": "\"Tell me of the restraint of streams;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:3.5"], "en": "by what are the streams closed?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:4.1"], "en": "Whatever streams there are in the world,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:4.2"], "en": "“O Ajita,” said the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:4.3"], "en": "“mindfulness is their warding off;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:4.4"], "en": "I call it the restraint of the streams.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:4.5", "PA_snp_5.2:5.1"], "en": "“Both wisdom and mindfulness are covered up,” said the Venerable Ajita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:5.2"], "en": "(Thus spoke the Venerable Ajita.)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:5.3"], "en": "\"And name-and-form, dear sir—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:5.4"], "en": "being asked this by me, please tell me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:5.5"], "en": "where does this come to an end?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:6.1"], "en": "“Regarding this question you asked,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:6.2"], "en": "Ajita, I shall explain it to you:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:6.3"], "en": "that wherein both name-and-form— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:6.4"], "en": "It ceases without remainder;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:6.5"], "en": "with the cessation of consciousness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:6.6"], "en": "this here ceases.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:7.1", "PA_snp_5.2:7.2"], "en": "“Both those who have fully understood the Dhamma and the many trainees here—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:7.3"], "en": "of their conduct, may I, being wise, [know].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:7.4"], "en": "\"Being asked, speak, O venerable sir.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:8.1"], "en": "\"One should not covet sensual pleasures;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:8.2"], "en": "one should be undisturbed in mind.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:8.3"], "en": "“Skilled in all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:8.4"], "en": "let the mindful bhikkhu wander forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_5.2:8.5"], "en": "Thus ends the first inquiry of the young brahmin Ajita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
