[
{"segs": ["PA_vv_27:0.1"], "en": "Vimānavatthu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:0.2", "PA_vv_27:0.3"], "en": "The Chapter on the Cittalatā Grove, within the Section on Female Vimānas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:0.4"], "en": "10. The Mansion Story of the First Almsgiver “O deity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:1.1", "PA_vv_27:1.2"], "en": "you who stand there with such exquisite beauty;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:1.3", "PA_vv_27:1.4"], "en": "Illuminating all directions like a star among the herbs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:2.1"], "en": "by what means do you possess such a complexion?", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:2.2", "PA_vv_27:2.3"], "en": "\"...and your radiance illuminates all directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:3.1"], "en": "That deity was uplifted in mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:3.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:3.3"], "en": "the fruit of which action is this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:4.1"], "en": "\"When I was among humans, having become human...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:4.2"], "en": "In a previous birth in the human world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:5.1"], "en": "I saw the stainless Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:5.2"], "en": "serene and undisturbed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:5.3"], "en": "To him I gave alms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:5.4"], "en": "with my own hands, full of faith.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:6.1"], "en": "Because of that, such is my complexion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:6.2", "PA_vv_27:6.3"], "en": "\"...and my radiance shines in all directions. Thus ends the tenth *vimaṇa*,", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"},
{"segs": ["PA_vv_27:7.1"], "en": "the First *Vimāna* of the Almsgiver of Food.", "model": "mitra-v4", "translated_at": "2026-11-27T13:59:09Z"}
]
