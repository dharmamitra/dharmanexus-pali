[
{"segs": ["PA_thig_13.4:0.1", "PA_thig_13.4:0.2"], "en": "Therīgāthā 13.4 Vīsatinipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:0.3"], "en": "The Verses of the Elder Nun Sundarī", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:1.1", "PA_thig_13.4:1.2"], "en": "“In the past, O lady, you were eating your own children as peta-s;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:1.3"], "en": "both by day and by night, you— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:1.4"], "en": "You are suffering exceedingly.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:2.1"], "en": "Having now devoured all [your sons],", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:2.2"], "en": "O Brahmin woman, you who had a hundred sons;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:2.3", "PA_thig_13.4:2.4"], "en": "“Vāseṭṭhī, for what reason do you not grieve so intensely?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:3.1"], "en": "“I have many hundreds of sons,” she replied.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:3.2", "PA_thig_13.4:3.3", "PA_thig_13.4:3.4"], "en": "And hundreds of kinsmen were devoured in the past, both mine and yours, O brahmin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:4.1", "PA_thig_13.4:4.2"], "en": "Having understood the escape from birth and death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:4.3"], "en": "I neither grieve nor weep.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:4.4"], "en": "“Nor did I feel any distress.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:5.1"], "en": "“It is wonderful indeed, Vāseṭṭhī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:5.2"], "en": "that you speak such words!”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:5.3", "PA_thig_13.4:5.4"], "en": "“Having understood whose Dhamma do you speak such words? “This one,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:6.1"], "en": "O Brahmin, is the Fully Awakened One.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:6.2", "PA_thig_13.4:6.3", "PA_thig_13.4:6.4"], "en": "He went toward the city of Mithilā and taught the Dhamma to living beings for the sake of abandoning all suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:7.1"], "en": "Having heard from that Brahmā, the Arahant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:7.2"], "en": "the Dhamma free from acquisitions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:7.3"], "en": "those who have understood the true Dhamma there—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:7.4"], "en": "I dispelled my grief for my son.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:8.1", "PA_thig_13.4:8.2"], "en": "\"Therefore, I too shall go toward the city of Mithilā.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:8.3", "PA_thig_13.4:8.4"], "en": "“Perhaps that Blessed One might release me from all suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:9.1"], "en": "Thus the brahmin saw the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:9.2", "PA_thig_13.4:9.3", "PA_thig_13.4:9.4"], "en": "The Sage, who has gone beyond suffering, taught him the Dhamma— liberated and free from acquisitions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:10.1"], "en": "Suffering, the origin of suffering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:10.2"], "en": "and the transcendence of suffering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:10.3"], "en": "and the Noble Eightfold Path—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:10.4"], "en": "which leads to the subsiding of suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:11.1"], "en": "There, having understood the true Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:11.2"], "en": "he chose the life of renunciation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:11.3", "PA_thig_13.4:11.4"], "en": "Sujāta attained the threefold knowledge in three nights.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:12.1"], "en": "\"Come, charioteer, go; [bring back the prince].\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:12.2"], "en": "\"Bring out this chariot;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:12.3"], "en": "let the brahmin lady know that she is safe,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:12.4"], "en": "for the brahmin has now gone forth.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:12.5", "PA_thig_13.4:12.6"], "en": "“Sujāta attained the three knowledges in three nights. Then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:13.1"], "en": "taking the chariot, [he departed].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:13.2", "PA_thig_13.4:13.3"], "en": "And the charioteer Sahassa said to the brahmin lady Ārogyā:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:13.4"], "en": "“The brahmin has now gone forth into homelessness.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:13.5", "PA_thig_13.4:13.6"], "en": "Sujāta attained the three knowledges in three nights.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:14.1"], "en": "And this horse-chariot—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:14.2"], "en": "And a thousand [pieces of gold], O charioteer;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:14.3"], "en": "having heard that you are a brahmin possessing the threefold knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:14.4"], "en": "I give this bowl full [of gold] to you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:15.1"], "en": "“Let the chariot be yours alone,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:15.2"], "en": "O Brahmin lady, and the thousand coins as well;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:15.3"], "en": "I too shall go forth.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:15.4"], "en": "“In the presence of one of excellent wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:16.1", "PA_thig_13.4:16.2"], "en": "“Having abandoned elephants, cattle, jewels, earrings, and this abundant household wealth;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:16.3"], "en": "\"Your father has gone forth into homelessness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:16.4"], "en": "enjoy these riches, Sundarī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:16.5"], "en": "for you are the heiress in this family.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:17.1", "PA_thig_13.4:17.2"], "en": "“Having abandoned elephants, cattle, jewels, earrings, and this delightful household wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:17.3"], "en": "my father has gone forth.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:17.4"], "en": "“Afflicted by grief for my son,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:17.5"], "en": "I too shall go forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:17.6"], "en": "afflicted by grief for my brother.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:18.1"], "en": "“Thus may your intention be fulfilled,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:18.2"], "en": "Sundarī, which you have desired:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:18.3"], "en": "the alms-gathering of those who stand up and the picking up of gleanings.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:18.4"], "en": "And the rag-robe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:18.5", "PA_thig_13.4:18.6"], "en": "those who endure these things will be free from taints in the world beyond.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:19.1"], "en": "“O Noble Lady, through my training as a probationer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:19.2"], "en": "the divine eye has been purified;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:19.3"], "en": "I know my former births.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:19.4"], "en": "Where I formerly dwelt, O noble lady,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:20.1"], "en": "it was by relying on you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:20.2"], "en": "O Elder, who beautifies the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:20.3"], "en": "The three true insights have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:20.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:21.1"], "en": "Grant me permission, noble lady.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:21.2"], "en": "I wish to go to Sāvatthī;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:21.3", "PA_thig_13.4:21.4"], "en": "I shall roar the lion’s roar in the presence of the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:22.1"], "en": "“Behold, O beautiful one, the Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:22.2"], "en": "golden-hued with greenish skin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:22.3"], "en": "the tamer of those who are untamed.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:22.4"], "en": "\"The perfectly enlightened one, fearless from all sides.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:23.1"], "en": "\"Behold Sundarī approaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:23.2"], "en": "utterly liberated and free from acquisitions.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:23.3"], "en": "Free from passion, detached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:23.4"], "en": "having done what was to be done, and free from taints—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:24.1"], "en": "having departed from Benares, [he went forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:24.2"], "en": "I have come into your presence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:24.3", "PA_thig_13.4:24.4"], "en": "O Great Hero, this beautiful female disciple bows at your feet.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:25.1"], "en": "\"You are the Buddha, you are the Teacher;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:25.2"], "en": "I am your daughter, O Brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:25.3"], "en": "born from your own breast, born from your mouth.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:25.4", "PA_thig_13.4:26.1"], "en": "“Having done what was to be done, free from taints. “Welcome to you, O Bhaddā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:26.2"], "en": "it is not far for you to have come from there.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:26.3"], "en": "Thus indeed do those who are tamed come,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:26.4"], "en": "to pay homage at the feet of the Teacher—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:26.5"], "en": "those free from passion, detached from bonds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:26.6"], "en": "“Having done what was to be done, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_13.4:27.1"], "en": "… The Elder Nun Sundarī …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
