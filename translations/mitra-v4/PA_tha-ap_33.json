[
{"segs": ["PA_tha-ap_33:0.1", "PA_tha-ap_33:0.2"], "en": "The Legend of the Elder Kuṇḍadhāna Kuṇḍadhānavagga 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:0.3"], "en": "The Legend of the Elder Kuṇḍadhāna", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:1.1", "PA_tha-ap_33:1.2", "PA_tha-ap_33:1.3"], "en": "With a clear mind and joyful heart, [I approached] the Self-Existent One, the Supreme Person, who had been in seclusion for seven days.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:1.4"], "en": "I attended upon the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:2.1"], "en": "Knowing that the time had come for him to rise,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:2.2"], "en": "I served the Great Sage Padumuttara.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:2.3", "PA_tha-ap_33:2.4"], "en": "Taking a large plantain leaf, I approached;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:3.1"], "en": "the Blessed One, having accepted it, [received it].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:3.2"], "en": "The All-Knowing One, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:3.3", "PA_tha-ap_33:3.4"], "en": "the Great Sage, partook [of the meal], gladdening my heart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:4.1"], "en": "Having partaken [of the meal], the Perfectly Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:4.2"], "en": "the unsurpassed leader of the caravan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:4.3"], "en": "sat down upon his own seat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:4.4"], "en": "He spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:5.1", "PA_tha-ap_33:5.2"], "en": "“And those yakkhas who dwell on this mountain, who have attained peace...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:5.3", "PA_tha-ap_33:5.4"], "en": "Let all beings, past and future, in the forest hear my words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:6.1"], "en": "he who served the Buddha—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:6.2"], "en": "Like a lion, the king of beasts—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:6.3"], "en": "I shall praise him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:6.4"], "en": "listen as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:7.1", "PA_tha-ap_33:7.2"], "en": "Eleven times he will be a king of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:7.3"], "en": "and thirty-four times...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:7.4"], "en": "He will become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:8.1"], "en": "In a hundred thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:8.2"], "en": "he will be born in the Okkāka clan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:8.3", "PA_tha-ap_33:8.4"], "en": "\"One named Gotama by clan will become a teacher in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:9.1"], "en": "Having thus reviled the ascetics, [he departed].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:9.2"], "en": "To those virtuous ones free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:9.3", "PA_tha-ap_33:9.4"], "en": "he will acquire a name through the ripening of his evil karma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:10.1"], "en": "He is a true heir to the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:10.2"], "en": "a son born from the Dhamma, fashioned by the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:10.3"], "en": "he is known by the name Kuṇḍadhāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:10.4"], "en": "He will become my disciple.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:11.1"], "en": "Devoted to solitude,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:11.2"], "en": "a meditator who delights in jhāna, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:11.3"], "en": "Having gladdened the Teacher,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:11.4"], "en": "I dwell free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:12.1"], "en": "surrounded by disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:12.2"], "en": "Honored by the community of monks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:12.3", "PA_tha-ap_33:12.4"], "en": "the Victor sat down among the assembly of monks and had them draw lots.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:13.1", "PA_tha-ap_33:13.2"], "en": "Having arranged his robe over one shoulder and paid homage to the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:13.3"], "en": "[he stood] before the Best of Speakers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:13.4"], "en": "I took [the vow] for the first time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:14.1"], "en": "By that kamma, O Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:14.2"], "en": "you who cause the ten-thousandfold world-system to tremble;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:14.3"], "en": "Having sat within the Saṅgha of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:14.4"], "en": "he placed me in the foremost position;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:15.1"], "en": "my energy is the yoke-bearer of the burden.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:15.2"], "en": "Bringing about the security of yoga,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:15.3", "PA_tha-ap_33:15.4"], "en": "I bear my final body within the teaching of the Perfectly Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:16.1"], "en": "The four analytical knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:16.2"], "en": "these eight liberations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:16.3"], "en": "and the six direct knowledges have been realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:16.4"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:17.1"], "en": "Thus indeed did the venerable elder Kuṇḍadhāna speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_33:18.1"], "en": "This is the first legend of the elder Kuṇḍadhāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
