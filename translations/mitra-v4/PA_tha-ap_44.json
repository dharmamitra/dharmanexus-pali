[
{"segs": ["PA_tha-ap_44:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:0.2"], "en": "Upālivagga 2:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:0.3"], "en": "The Apadāna of the Elder Soṇakoḷivisa", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:1.1", "PA_tha-ap_44:1.2", "PA_tha-ap_44:1.3"], "en": "“Having applied a coating of lime to the shrine of the Sage Anomadassi, the World’s Elder, the Neutral One;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:1.4"], "en": "I had a walking path constructed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:2.1"], "en": "With flowers of various colors,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:2.2"], "en": "I spread over that walking path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:2.3"], "en": "Having spread a canopy in the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:2.4"], "en": "I fed the Supreme Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:3.1"], "en": "having raised my hands in reverential salutation, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:3.2"], "en": "Having paid homage to the one of excellent vows,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:3.3", "PA_tha-ap_44:3.4"], "en": "I then presented Dīghasāla to the Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:4.1"], "en": "Knowing my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:4.2"], "en": "the Teacher, the unsurpassed one in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:4.3"], "en": "the Blessed One, accepted it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:4.4"], "en": "Out of compassion, the All-Seeing One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:5.1", "PA_tha-ap_44:5.2"], "en": "the Fully Awakened One worthy of offerings in the world with its devas, accepted it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:5.3"], "en": "Sitting in the community of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:5.4"], "en": "he spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:6.1"], "en": "“He who, with a joyful heart...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:6.2"], "en": "He gave me the Dīghasāla grove;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:6.3"], "en": "I shall praise it,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:6.4"], "en": "so listen as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:7.1", "PA_tha-ap_44:7.2"], "en": "At the time of death for this person who is endowed with meritorious deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:7.3"], "en": "there appears a chariot yoked with a thousand [horses].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:7.4"], "en": "It will wait for him right then.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:8.1"], "en": "By means of that vehicle,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:8.2"], "en": "this person will go to the world of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:8.3", "PA_tha-ap_44:8.4"], "en": "The gods will rejoice when one has attained a state of wholesome existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:9.1"], "en": "[reborn] in a most precious and excellent celestial mansion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:9.2", "PA_tha-ap_44:9.3"], "en": "With a floor plastered with jewels and adorned with a magnificent gabled chamber,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:9.4"], "en": "he shall dwell in that celestial mansion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:10.1", "PA_tha-ap_44:10.2"], "en": "For thirty thousand aeons he will delight in the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:10.3"], "en": "for twenty-five aeons—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:10.4"], "en": "He will become a king of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:11.1", "PA_tha-ap_44:11.2"], "en": "And seventy-seven times he will become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:11.3"], "en": "All of them were named Yasodhara;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:11.4", "PA_tha-ap_44:12.1"], "en": "having experienced two prosperities, they all shared the same name.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:12.2"], "en": "Having increased his accumulation of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:12.3", "PA_tha-ap_44:12.4"], "en": "in the twenty-eighth aeon he will become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:13.1"], "en": "There too was a most excellent celestial mansion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:13.2"], "en": "constructed by Vissakamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:13.3"], "en": "resounding with ten kinds of sounds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:13.4"], "en": "He will dwell in the midst of the city.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:14.1"], "en": "In an incalculable eon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:14.2"], "en": "he will be a powerful protector of the earth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:14.3", "PA_tha-ap_44:14.4"], "en": "A king named Okkāka will arise in the realm;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:15.1"], "en": "he [will rule] over sixteen thousand women.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:15.2"], "en": "She is the most excellent of all;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:15.3"], "en": "a noble Kṣatriya lady,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:15.4"], "en": "she shall give birth to nine sons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:16.1"], "en": "Having given birth to nine sons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:16.2"], "en": "the Kṣatriya lady will die;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:16.3"], "en": "she was young and beloved, a maiden.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:16.4"], "en": "She will exercise the sovereignty of a queen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:17.1"], "en": "Having gratified Okkāka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:17.2"], "en": "she will obtain a boon as a maiden.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:17.3"], "en": "Having obtained this boon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:17.4"], "en": "that maiden will cause her sons to go forth into homelessness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:18.1"], "en": "and once they have all gone forth, [she will do so].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:18.2"], "en": "They shall go to the best of cities;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:18.3"], "en": "out of fear of the distinctions of birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:18.4"], "en": "they all shall dwell together with their sisters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:19.1"], "en": "And one maiden shall be completely overcome by diseases;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:19.2", "PA_tha-ap_44:19.3"], "en": "\"May our lineage not be broken! [they thought].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:19.4"], "en": "The kṣatriyas will bury her;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:20.1", "PA_tha-ap_44:20.2"], "en": "having dug her up, the kṣatriya will live with her.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:20.3", "PA_tha-ap_44:20.4"], "en": "Then there will be a schism arising from the Okkāka clan;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:21.1"], "en": "their offspring will come to be.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:21.2"], "en": "He will be of the Koliya clan;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:21.3", "PA_tha-ap_44:21.4"], "en": "there he will enjoy no small human wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:22.1"], "en": "Having passed away from that body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:22.2"], "en": "he will go to the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:22.3"], "en": "there too, he will attain a most excellent celestial mansion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:22.4"], "en": "He will obtain that which is mind-delighting.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:23.1"], "en": "Having passed away from the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:23.2"], "en": "impelled by the root of his wholesome merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:23.3"], "en": "Having come to the human state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:23.4"], "en": "he will be named Soṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:24.1"], "en": "one who has aroused energy and is resolute.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:24.2", "PA_tha-ap_44:24.3"], "en": "Having practiced in the Teacher’s dispensation and fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:24.4"], "en": "I shall be extinguished, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:25.1"], "en": "The Blessed One, Anantadassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:25.2"], "en": "Gotama, the bull of the Sakyas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:25.3"], "en": "the great hero who discerns distinctions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:25.4"], "en": "“He will place me in the foremost position.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:26.1"], "en": "When the rain has fallen four finger-breadths deep,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:26.2"], "en": "and the grass on the courtyard has been stirred by the wind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:26.3"], "en": "For one who has stood firm in the application of yoga and so forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:26.4"], "en": "there exists no further state beyond that.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:27.1"], "en": "Tamed in the supreme taming, [he is at peace].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:27.2"], "en": "My mind is well-directed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:27.3"], "en": "all my burden has been laid down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:27.4"], "en": "and I am extinguished, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:28.1"], "en": "Aṅgīrasa, the great nāga,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:28.2"], "en": "like a noble lion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:28.3"], "en": "sat down amidst the community of bhikkhus.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:28.4"], "en": "He placed me in this foremost position:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:29.1", "PA_tha-ap_44:29.2"], "en": "\"The four analytical knowledges... [and so forth].\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:29.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:30.1"], "en": "Thus indeed did the venerable elder Soṇa Koḷivisa recite these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_44:31.1"], "en": "This is the second legend of the elder Soṇa Koḷivisa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
