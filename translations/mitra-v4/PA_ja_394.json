[
{"segs": ["PA_ja_394:0.1", "PA_ja_394:0.2"], "en": "Jātaka: The Sixth Book of Birth Stories,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:0.3"], "en": "Chapter on the Son Kharaputta", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:0.4", "PA_ja_394:1.1"], "en": "9. The Vaṭṭaka Jātaka “You eat choice food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:1.2"], "en": "my maternal uncle, along with ghee and oil.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:1.3", "PA_ja_394:1.4"], "en": "\"Now, by what reason are you so thin, O crow?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:2.1"], "en": "\"Because I dwell in the midst of enemies,\" [the crow replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:2.2", "PA_ja_394:2.3"], "en": "Among those, for a crow whose heart is constantly anxious for the sake of food,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:2.4"], "en": "how can there be steadfastness?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:3.1", "PA_ja_394:3.2"], "en": "The crows and vultures are constantly agitated by their evil karma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:3.3"], "en": "even when they obtain alms-food, it does not satisfy them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:3.4"], "en": "I am thin, O Vaddhaka;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:4.1", "PA_ja_394:4.2"], "en": "you eat coarse seeds of grass that are devoid of moisture.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:4.3"], "en": "\"Now, by what quality,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:4.4"], "en": "O quail, are you so fat?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:5.1"], "en": "\"By having few desires and little anxiety.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:5.2"], "en": "And by not traveling far;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:5.3"], "en": "subsisting on whatever is obtained or unobtained,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:5.4"], "en": "I am fat, O crow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:6.1"], "en": "For the person of few desires,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:6.2", "PA_ja_394:6.3"], "en": "who finds happiness in having little to think about, and whose mind is well-restrained—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:6.4"], "en": "“Livelihood well-accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_394:7.1"], "en": "Thus ends the ninth Jātaka, the Quail Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
