[
{"segs": ["PA_tha-ap_537:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:0.2"], "en": "Kaccāyanavagga 5.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:0.3"], "en": "The Apadāna of the Elder Kumārakassapa", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:1.1"], "en": "“In this hundred-thousandth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:1.2", "PA_tha-ap_537:1.3"], "en": "the Hero, the Leader, who brings benefit to the entire world, appeared.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:1.4"], "en": "Named Padumuttara.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:2.1"], "en": "At that time, having become a brahmin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:2.2"], "en": "renowned and a master of the Vedas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:2.3"], "en": "While wandering for my midday rest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:2.4"], "en": "I saw the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:3.1"], "en": "proclaiming the Four Noble Truths.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:3.2"], "en": "Awakening the world together with its gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:3.3", "PA_tha-ap_537:3.4"], "en": "he was extolled by the great multitude as the foremost of those who deliver diverse discourses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:4.1"], "en": "Then, with a joyful heart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:4.2"], "en": "having invited the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:4.3"], "en": "[I honored him] with garments of various colors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:4.4"], "en": "Having adorned the pavilion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:5.1"], "en": "which was radiant with various jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:5.2"], "en": "I fed the Saṅgha there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:5.3", "PA_tha-ap_537:5.4"], "en": "Having fed them for seven days with food of various excellent flavors,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:6.1"], "en": "[he honored them] with flowers of various colors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:6.2"], "en": "Having paid homage to him along with his disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:6.3", "PA_tha-ap_537:6.4"], "en": "I prostrated at the soles of his feet and aspired for that very state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:7.1", "PA_tha-ap_537:7.2"], "en": "Then the excellent sage, whose heart was the very essence of compassion, said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:7.3"], "en": "\"Behold this most noble brahmin!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:7.4"], "en": "With eyes like lotus petals,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:8.1"], "en": "he was filled with intense rapture and joy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:8.2"], "en": "and his hair stood on end.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:8.3"], "en": "With wide eyes full of laughter,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:8.4"], "en": "longing for my teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:9.1"], "en": "he fell at the soles of my feet.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:9.2"], "en": "With a mind focused on a single theme,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:9.3"], "en": "he aspires to that state:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:9.4"], "en": "being a speaker of diverse and wonderful discourses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:10.1"], "en": "In a hundred thousand aeons hence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:10.2"], "en": "one born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:10.3"], "en": "known by the family name Gotama, shall appear.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:10.4"], "en": "A Teacher shall appear in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:11.1"], "en": "His heir in the Dhammas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:11.2"], "en": "his own legitimate son, fashioned from the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:11.3", "PA_tha-ap_537:11.4"], "en": "There will be a disciple of the Teacher named Kumārakassapa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:12.1"], "en": "[who will offer] variegated flowers and garments.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:12.2"], "en": "And by means of a multitude of jewels,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:12.3", "PA_tha-ap_537:12.4"], "en": "he shall attain preeminence among those who deliver diverse discourses.’", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:13.1", "PA_tha-ap_537:13.2"], "en": "By that well-performed karma and by his intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:13.3"], "en": "having cast off the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:13.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:14.1", "PA_tha-ap_537:14.2"], "en": "Wandering through various states of existence like an actor on a stage, I roamed from birth to birth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:14.3"], "en": "Having become the offspring of a deer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:14.4"], "en": "I entered the womb of a doe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:15.1"], "en": "at that time, while I was dwelling in her womb,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:15.2"], "en": "The executioners were standing ready;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:15.3"], "en": "by Sākha my mother was saved,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:15.4"], "en": "for she had gone for refuge to Nigrodha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:16.1", "PA_tha-ap_537:16.2"], "en": "Thus she was liberated from death by that king of beasts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:16.3"], "en": "who sacrificed his own life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:16.4"], "en": "Then he exhorted me thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:17.1"], "en": "“One should resort only to the banyan tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:17.2"], "en": "one should not dwell among the branches.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:17.3", "PA_tha-ap_537:17.4"], "en": "\"Death in the Nigrodha tree is better than life in the branch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:18.1"], "en": "Thus instructed by the leader of the deer herd,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:18.2"], "en": "I, my mother, and the others likewise—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:18.3"], "en": "having come from the delightful abode of Tusita,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:18.4"], "en": "we have gone abroad as if to our own home.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:19.1", "PA_tha-ap_537:19.2"], "en": "Again, when the teaching of the Hero Kassapa was coming to its end,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:19.3"], "en": "he ascended the mountain peak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:19.4"], "en": "Having applied myself to the teaching of the Conqueror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:20.1", "PA_tha-ap_537:20.2"], "en": "I was now born in Rājagaha into a family of wealthy merchants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:20.3", "PA_tha-ap_537:20.4"], "en": "My mother had conceived a child when she went forth into homelessness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:21.1"], "en": "having realized she was pregnant, [he took her back].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:21.2"], "en": "They brought Devadatta [to her],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:21.3", "PA_tha-ap_537:21.4"], "en": "and he said, “Destroy this wicked nun!”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:22.1", "PA_tha-ap_537:22.2"], "en": "Even now, having been shown compassion by the Lord of Sages, the Conqueror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:22.3"], "en": "I have become happy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:22.4"], "en": "My mother was in the nuns' quarters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:23.1"], "en": "Having learned of this,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:23.2"], "en": "the Kosalan protector of the earth nourished me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:23.3", "PA_tha-ap_537:23.4"], "en": "I am known by the name Kassapa, raised with the care due to a prince;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:24.1"], "en": "it was by relying upon Mahākassapa—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:24.2"], "en": "I am Kumārakassapa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:24.3", "PA_tha-ap_537:24.4"], "en": "having heard from the Buddha the teaching that the body is like an anthill.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:25.1"], "en": "Then my mind was liberated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:25.2"], "en": "entirely without clinging;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:25.3"], "en": "having tamed Pāyāsi, I departed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:25.4"], "en": "I have attained this foremost state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:26.1"], "en": "My defilements have been incinerated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:26.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:26.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:27.1", "PA_tha-ap_537:27.2"], "en": "Welcome indeed has come to me... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:27.3"], "en": "The Buddha’s teaching has been declared:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:28.1", "PA_tha-ap_537:28.2"], "en": "the four analytical knowledges, and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:28.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:29.1"], "en": "In this way, it is said, the Elder Thera Kumārakassapa spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:30.1"], "en": "This is the fifth legend of the Elder Thera Kumārakassapa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_537:30.2"], "en": "The twenty-fourth recitation section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
