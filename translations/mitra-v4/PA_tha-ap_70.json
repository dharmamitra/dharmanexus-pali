[
{"segs": ["PA_tha-ap_70:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:0.2"], "en": "Sakacintaniyavagga 8.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:0.3"], "en": "The Apadāna of the Elder Ambadāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:1.1"], "en": "The Blessed One Anomadassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:1.2"], "en": "seated in the midst of the mountains,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:1.3"], "en": "suffused the world with loving-kindness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:1.4"], "en": "Immeasurable and free from worldly attachments.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:2.1", "PA_tha-ap_70:2.2"], "en": "Who was I then? I was a monkey in the Himavat, the best of mountains.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:2.3"], "en": "Having seen that Anomadassi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:2.4"], "en": "I inspired confidence in the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:3.1"], "en": "Not far from the Himalayas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:3.2"], "en": "At that time, the mango trees were laden with fruit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:3.3"], "en": "then, having taken a ripe mango,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:3.4"], "en": "I gave it along with madhuka flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:4.1", "PA_tha-ap_70:4.2", "PA_tha-ap_70:4.3"], "en": "The Buddha Anomadassi, the Great Sage, gave me this explanation regarding this gift of honey.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:4.4"], "en": "Through the gift of mangoes, he will enjoy both worlds;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:5.1"], "en": "for fifty-seven eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:5.2"], "en": "he will delight in the world of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:5.3"], "en": "In the remaining aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:5.4"], "en": "he will wander through the cycle of existence in a mixed fashion;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:6.1"], "en": "having exhausted his evil karma, [he will attain liberation].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:6.2"], "en": "With fully matured wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:6.3"], "en": "without going to a state of ruin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:6.4"], "en": "he will consume the defilements.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:7.1"], "en": "By the highest self-control,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:7.2"], "en": "I have been tamed by the Great Seer;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:7.3"], "en": "I have attained the immovable state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:7.4"], "en": "Having abandoned victory and defeat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:8.1"], "en": "for seven hundred and seventy aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:8.2"], "en": "those named Ambaṭṭha and Jasa—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:8.3", "PA_tha-ap_70:8.4"], "en": "Those fourteen kings were wheel-turning monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:9.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:9.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:9.3"], "en": "the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:10.1"], "en": "Thus indeed did the venerable elder Ambadāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_70:11.1"], "en": "The legend of the Elder Ambadāyaka is the eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
