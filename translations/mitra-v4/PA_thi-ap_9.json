[
{"segs": ["PA_thi-ap_9:0.1"], "en": "The Therī-apadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:0.2"], "en": "Sumedhāvagga 9.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:0.3"], "en": "The Apadāna of the Elder Nun Pañcadīpikā", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:1.1", "PA_thi-ap_9:1.2", "PA_thi-ap_9:1.3"], "en": "“At that time, I was wandering from park to park in the city of Haṃsavatī.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:1.4"], "en": "Seeking what is wholesome, I was wandering when,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:2.1"], "en": "on a day of the dark fortnight,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:2.2"], "en": "I saw the supreme Bodhi tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:2.3"], "en": "Having inspired confidence in my mind there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:2.4"], "en": "I sat at the foot of the Bodhi tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:3.1"], "en": "maintaining a heart of deep reverence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:3.2", "PA_thi-ap_9:3.3"], "en": "Having placed his palms together in reverence and proclaimed his joy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:3.4"], "en": "he then thought as follows.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:4.1", "PA_thi-ap_9:4.2"], "en": "“If the Buddha possesses immeasurable qualities and is the peerless person,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:4.3"], "en": "may he show a miracle to me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:4.4"], "en": "\"May this Bodhi tree be illumined!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:5.1"], "en": "As soon as I directed my attention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:5.2"], "en": "the Bodhi tree was instantly set ablaze.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:5.3", "PA_thi-ap_9:5.4"], "en": "It was made entirely of gold and shone in all directions;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:6.1"], "en": "for seven days and nights there, it remained so.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:6.2"], "en": "I sat at the foot of the Bodhi tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:6.3"], "en": "when the seventh day had arrived,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:6.4"], "en": "I performed an offering of lamps.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:7.1"], "en": "Having surrounded the seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:7.2", "PA_thi-ap_9:7.3"], "en": "they lit five lamps until the sun rose.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:7.4"], "en": "Then my lamps were lit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:8.1"], "en": "By that well-performed deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:8.2"], "en": "and by my volition and aspiration, [I have attained this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:8.3"], "en": "Having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:8.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:9.1"], "en": "There, a well-constructed celestial mansion was mine.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:9.2"], "en": "It is called the Five Islands;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:9.3", "PA_thi-ap_9:9.4"], "en": "it is sixty yojanas in height and thirty yojanas in width.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:10.1", "PA_thi-ap_9:10.2"], "en": "Innumerable islands surround me as they blaze;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:10.3"], "en": "as far as the abode of the gods, [they shine].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:10.4"], "en": "It shines by the light of a lamp.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:11.1"], "en": "Sitting with my back turned,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:11.2"], "en": "if I wish to see [it], [I can do so].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:11.3"], "en": "Above, below, and across,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:11.4", "PA_thi-ap_9:12.1"], "en": "I see everything with my eye as far as I desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:12.2", "PA_thi-ap_9:12.3"], "en": "There is no obstruction there for seeing those who have fared well or poorly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:12.4"], "en": "whether among trees or mountains.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:13.1", "PA_thi-ap_9:13.2"], "en": "I exercised the sovereignty of a great queen over eighty kings of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:13.3"], "en": "and [the rule] over hundreds of universal monarchs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:13.4"], "en": "I exercised the sovereignty of a queen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:14.1"], "en": "Whichever womb I was reborn in—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:14.2"], "en": "whether among the gods or among humans—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:14.3", "PA_thi-ap_9:14.4"], "en": "A hundred thousand lamps surround me as they burn;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:15.1"], "en": "having passed away from the world of the gods, I have come here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:15.2"], "en": "I was born from my mother’s womb;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:15.3"], "en": "while remaining within my mother’s womb,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:15.4"], "en": "my eye did not close.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:16.1", "PA_thi-ap_9:16.2", "PA_thi-ap_9:16.3"], "en": "Hundreds of thousands of lamps burn in the birth-chamber due to her possession of meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:16.4"], "en": "This is the fruit of the five lamps.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:17.1"], "en": "When my final existence was reached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:17.2"], "en": "I turned back my mind [from rebirth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:17.3", "PA_thi-ap_9:17.4"], "en": "I touched the deathless, the state of coolness, Nibbāna;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:18.1"], "en": "at seven years of age, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:18.2"], "en": "I attained arahantship;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:18.3", "PA_thi-ap_9:18.4"], "en": "the Buddha Gotama, recognizing my virtues, granted me full ordination.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:19.1"], "en": "Whether in a pavilion, at the foot of a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:19.2"], "en": "in palaces, or in caves;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:19.3"], "en": "dwelling in an empty house, she—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:19.4"], "en": "The five lamps shine for me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:20.1"], "en": "my divine eye is purified,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:20.2"], "en": "and I am skilled in meditative concentration.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:20.3"], "en": "Having attained perfection in direct knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:20.4"], "en": "this is the fruit of the Five Islands;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:21.1"], "en": "all have reached the final consummation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:21.2"], "en": "Having accomplished their task and free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:21.3"], "en": "O Great Hero, Five-Lamp One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:21.4"], "en": "I bow at your feet, O Visionary One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:22.1"], "en": "In a hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:22.2"], "en": "when I gave that lamp at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:22.3"], "en": "I have not known a state of woe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:22.4"], "en": "This is the fruit of the five lamps:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:23.1", "PA_thi-ap_9:23.2"], "en": "the defilements have been incinerated by me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:23.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:24.1", "PA_thi-ap_9:24.2"], "en": "Welcome indeed has come to me... [and so on].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:24.3"], "en": "The Buddha’s teaching has been proclaimed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:25.1", "PA_thi-ap_9:25.2"], "en": "the four analytical knowledges, and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:25.3"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:26.1"], "en": "Thus indeed did the bhikkhunī Pañcadīpikā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_9:27.1"], "en": "This is the ninth legend of the elder nun Pañcadīpikā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
