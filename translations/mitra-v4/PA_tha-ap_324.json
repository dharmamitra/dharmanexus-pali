[
{"segs": ["PA_tha-ap_324:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:0.2"], "en": "Umāpupphiya Chapter 2:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:0.3"], "en": "The Apadāna of the Elder Pulinapūjaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:1.1", "PA_tha-ap_324:1.2"], "en": "“Like a bull with humps shining like a noble steed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:1.3"], "en": "or like a medicinal herb radiating light;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:1.4"], "en": "To the Bull among Men who was radiating light,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:2.1", "PA_tha-ap_324:2.2"], "en": "I raised my joined palms in reverence and paid homage to the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:2.3", "PA_tha-ap_324:2.4"], "en": "I praised the Teacher and satisfied him with my own deed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:3.1"], "en": "taking up pure sand, I offered it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:3.2"], "en": "I scattered it upon the path he had traveled,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:3.3", "PA_tha-ap_324:3.4"], "en": "having taken it up in my lap for Vipassi, the Great Seer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:4.1", "PA_tha-ap_324:4.2", "PA_tha-ap_324:4.3"], "en": "Then, with a serene mind, I sprinkled half of the sandy bank during my midday rest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:4.4"], "en": "Of the Lord of Bipeds, the Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:5.1"], "en": "Ninety-one eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:5.2"], "en": "I offered sand to him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:5.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:5.4"], "en": "this is the fruit of the sand.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:6.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:6.3"], "en": "the Buddha's teaching has been fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:7.1"], "en": "Thus indeed did the Venerable Elder Pulinapūjaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_324:8.1"], "en": "The legend of the Elder Pulinapūjaka is the second.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
