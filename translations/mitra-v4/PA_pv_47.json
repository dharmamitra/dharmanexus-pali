[
{"segs": ["PA_pv_47:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:0.2"], "en": "Mahāvagga 12.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:0.3"], "en": "The Story of the Ghost in the Mango Grove (Ambavanapetavatthu)", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:1.1"], "en": "“And this lotus pond of yours is very beautiful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:1.2"], "en": "level, with fine landing-stairs and abundant water;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:1.3"], "en": "it is in full bloom and swarming with flocks of bees.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:1.4", "PA_pv_47:2.1"], "en": "How was this delightful mango grove obtained by you?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:2.2"], "en": "It is most pleasant and bears fruit in every season.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:2.3"], "en": "“Blooming and swarming with flocks of bees,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:2.4"], "en": "how was this celestial mansion obtained by you?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:3.1"], "en": "“A mango fruit, water, and rice-gruel— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:3.2"], "en": "The cool shade is delightful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:3.3"], "en": "through the gift given by my daughter,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:3.4"], "en": "it is for that reason that I obtain this here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:4.1"], "en": "“Behold this visible fruit of action:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:4.2"], "en": "the ripening of generosity, self-control, and restraint.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:4.3"], "en": "Having been a maidservant, I have now come to be born in noble families.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:4.4"], "en": "“I am the daughter-in-law, the mistress of the household.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_47:5.1"], "en": "The twelfth story: The Petavatthu of the Mango Grove.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
