[
{"segs": ["PA_thag_2.26:0.1", "PA_thag_2.26:0.2", "PA_thag_2.26:0.3"], "en": "Theragāthā 2.26 Dukanipāta, Tatiyavagga I am one who has crossed over the flood; I have reached the further shore. I am free from fear, without sorrow; I have attained the destruction of all suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.26:0.4"], "en": "The Verses of the Elder Puṇṇamāsa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.26:1.1"], "en": "“Having abandoned the five hindrances,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.26:1.2"], "en": "for the sake of attaining security from bondage;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.26:1.3"], "en": "Having taken up the mirror of the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.26:1.4"], "en": "my own knowledge and vision,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.26:2.1"], "en": "I reflected upon this body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.26:2.2"], "en": "“Everything, both inside and out;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.26:2.3"], "en": "internally and externally—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.26:2.4"], "en": "the body appeared empty.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.26:2.5"], "en": "… the Elder Puṇṇamāsa …", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
