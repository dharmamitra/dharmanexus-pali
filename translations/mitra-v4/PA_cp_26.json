[
{"segs": ["PA_cp_26:0.1", "PA_cp_26:0.2"], "en": "The Basket of Conduct (Cariyāpiṭaka), Chapter on Yudhañjaya:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:0.3"], "en": "The Perfection of Non-Despair (Adiṭṭhānapāramī) 1", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:0.4"], "en": "The Conduct of Temiya:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:1.1", "PA_cp_26:1.2"], "en": "“Furthermore, when I was the son of the King of Kāsi;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:1.3"], "en": "By name I am Mūgapakkha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:1.4"], "en": "though they call me Temiya;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:2.1"], "en": "I [was the husband] of sixteen thousand women.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:2.2"], "en": "At that time, no other man was found;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:2.3"], "en": "at the passing of days and nights,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:2.4"], "en": "I alone was reborn.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:3.1", "PA_cp_26:3.2", "PA_cp_26:3.3"], "en": "Having held the white parasol over his beloved son, who was obtained with great difficulty, of noble birth, and a bearer of splendor—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:3.4"], "en": "My father nourished me while lying on a magnificent bed;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:4.1"], "en": "then, having awakened from sleep,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:4.2"], "en": "I rose from that excellent couch.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:4.3"], "en": "I saw a white parasol,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:4.4"], "en": "by which I went to hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:5.1"], "en": "As soon as that parasol was seen by me, [it vanished].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:5.2", "PA_cp_26:5.3"], "en": "A terrifying fear arose within him as he fell into deliberation,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:5.4"], "en": "thinking, \"How shall I release this?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:6.1"], "en": "My former blood-relative,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:6.2"], "en": "a deity desiring my welfare,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:6.3"], "en": "seeing me thus afflicted with suffering—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:6.4"], "en": "He applied [this] in three places:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:7.1"], "en": "“Do not display your cleverness;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:7.2"], "en": "be considered a fool by all living beings.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:7.3"], "en": "\"Let all those people gather it;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:7.4"], "en": "in this way, your welfare will be secured.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:8.1"], "en": "When she had spoken thus to me, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:8.2"], "en": "I spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:8.3", "PA_cp_26:8.4"], "en": "“I shall do that which you say, O deity.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:8.5"], "en": "\"You desire my welfare, mother;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:8.6"], "en": "you desire my benefit, O goddess.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:9.1"], "en": "Having heard her words, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:9.2"], "en": "Like one who has reached dry land from the ocean,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:9.3"], "en": "joyful and with a mind full of spiritual urgency,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:9.4"], "en": "I resolved upon the three factors.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:10.1"], "en": "I was mute and deaf,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:10.2"], "en": "one-sided and deprived of movement;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:10.3"], "en": "having resolved upon these conditions, [I attained this state].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:10.4"], "en": "I dwelt there for sixteen years.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:11.1"], "en": "Then, having crushed my hands,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:11.2"], "en": "feet, tongue, and ears, [they threw me into a pit].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:11.3"], "en": "Seeing my lack of deficiency,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:11.4"], "en": "they reviled me as \"ill-omened.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:12.1"], "en": "Then all the people of the countryside...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:12.2"], "en": "The commander-in-chief and the chaplain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:12.3"], "en": "all having become of one mind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:12.4"], "en": "rejoiced in the act of relinquishment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:13.1"], "en": "Having heard their counsel,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:13.2"], "en": "joyful and with a stirred mind, [I thought]:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:13.3"], "en": "\"For what purpose was this austerity practiced?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:13.4"], "en": "“Thus may my purpose be fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:14.1"], "en": "Having bathed him, anointed him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:14.2"], "en": "and wrapped him in the royal turban;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:14.3"], "en": "Having consecrated him with the royal parasol,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:14.4"], "en": "they caused him to perform a circumambulation of the city;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:15.1"], "en": "and having maintained it for seven days, they...", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:15.2"], "en": "When the solar disc had risen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:15.3", "PA_cp_26:15.4"], "en": "the charioteer, having led me out in a chariot, arrived at the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:16.1"], "en": "Having prepared a chariot in a secluded place,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:16.2"], "en": "with my hand raised to grasp the reins,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:16.3"], "en": "the charioteer digs a pit.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:16.4"], "en": "To drive me into the earth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:17.1", "PA_cp_26:17.2"], "en": "he challenged my established resolve with various means.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:17.3"], "en": "I did not break that resolve,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:17.4"], "en": "solely for the sake of enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:18.1"], "en": "My mother and father were not to be given up by me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:18.2"], "en": "My self is not to be given away;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:18.3"], "en": "omniscience is dear to me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:18.4"], "en": "therefore I resolved upon this vow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:19.1"], "en": "Having resolved upon these factors,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:19.2"], "en": "I lived for sixteen years;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:19.3"], "en": "there is none equal to me in resolution.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:19.4"], "en": "“This is my perfection of resolution.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_26:20.1"], "en": "Thus ends the sixth chapter, the Temiya Cariyā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
