[
{"segs": ["PA_thi-ap_2:0.1"], "en": "The Therī-apadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:0.2"], "en": "Sumedhāvagga 2:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:0.3"], "en": "The Apadāna of the Elder Nun Mekhalādāyikā", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:1.1", "PA_thi-ap_2:1.2"], "en": "“I was the one who had the stupa built for the Blessed One Siddhattha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:1.3"], "en": "a girdle was given by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:1.4"], "en": "For the construction-work of the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:2.1"], "en": "And when the Great Thūpa was completed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:2.2"], "en": "I gave him a girdle once again.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:2.3", "PA_thi-ap_2:2.4"], "en": "With their own hands, they offered [flowers] with faith to the Sage, the Lord of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:3.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:3.2"], "en": "That belt which I gave at that time—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:3.4"], "en": "this is the fruit of one who built a stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:4.1"], "en": "The defilements have been incinerated by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:4.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:4.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:5.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:5.2", "PA_thi-ap_2:5.3"], "en": "[and so forth] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:6.1", "PA_thi-ap_2:6.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:7.1"], "en": "Thus indeed did the bhikkhunī Mekhalādāyikā speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_2:8.1"], "en": "This is the second legend of the elder bhikkhunī Mekhalādāyikā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
