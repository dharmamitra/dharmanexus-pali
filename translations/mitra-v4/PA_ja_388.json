[
{"segs": ["PA_ja_388:0.1", "PA_ja_388:0.2"], "en": "Jātaka: The Sixth Book of Birth Stories,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:0.3"], "en": "Chapter on the Son of Kharā (Kharaputtavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:0.4"], "en": "3. The Tuṇḍila Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:1.1"], "en": "“Now it is being given to Navachannaka;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:1.2"], "en": "Mistress Puṇṇā stands by the full basket.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:1.3"], "en": "“Many people here carry swords at their sides,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:1.4"], "en": "yet it does not occur to me to eat.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:2.1"], "en": "You are trembling, you are wandering about, and you seek a refuge.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:2.2"], "en": "\"You are defenseless; where will you go?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:2.3", "PA_ja_388:2.4"], "en": "Be unconcerned and eat, O flat-nosed one, for we have been nourished for the sake of your flesh.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:3.1"], "en": "Enter the lake that is free from mud;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:3.2"], "en": "wash away all sweat and grime,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:3.3"], "en": "and take up a fresh unguent.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:3.4"], "en": "“Whose fragrance never fades?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:4.1"], "en": "“What is the lake free from mud?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:4.2"], "en": "What is it that is called ‘free from sweat and dust’?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:4.3"], "en": "And what is the fresh ointment,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:4.4"], "en": "whose fragrance never fades?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:5.1"], "en": "\"The Dhamma is a lake free from mud;...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:5.2"], "en": "Evil is called sweat;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:5.3"], "en": "virtue is a fresh ointment,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:5.4"], "en": "and its fragrance never fades.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:6.1"], "en": "Those who destroy the body rejoice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:6.2"], "en": "but those who preserve the body do not rejoice;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:6.3"], "en": "as on the full moon night of Punnama.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:6.4"], "en": "\"Even those who are enjoying themselves will give up their lives.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_388:7.1"], "en": "Thus ends the third Jātaka, the Tuṇḍila-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
