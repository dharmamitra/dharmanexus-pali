[
{"segs": ["PA_thag_1.105:0.1", "PA_thag_1.105:0.2", "PA_thag_1.105:0.3"], "en": "Theragāthā 1.105 Ekakanipāta Ekādasamavagga (The Eleventh Chapter of the Section on Single Verses)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.105:0.4"], "en": "The Verses of the Elder Malitavambha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.105:1.1"], "en": "“Even if you are dissatisfied, do not stay;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.105:1.2"], "en": "even if you are enjoying yourself, depart.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.105:1.3", "PA_thag_1.105:1.4"], "en": "\"But a wise person does not dwell in a residence that leads to harm. ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.105:1.5"], "en": "[Thus spoke] the Elder Malitavambha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
