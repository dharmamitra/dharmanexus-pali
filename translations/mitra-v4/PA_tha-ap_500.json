[
{"segs": ["PA_tha-ap_500:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:0.2"], "en": "The Chapter on the Kiṅkaṇī Flower, Number Eight:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:0.3"], "en": "The Apadāna of the Elder Pulinathūpiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:1.1", "PA_tha-ap_500:1.2"], "en": "\"Not far from the Himālaya is a mountain named Yamaka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:1.3"], "en": "there my well-constructed hermitage is located.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:1.4"], "en": "A leaf-hut was well-constructed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:2.1", "PA_tha-ap_500:2.2"], "en": "There was a matted-hair ascetic named Nārada, who practiced fierce austerities.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:2.3", "PA_tha-ap_500:2.4"], "en": "Fourteen thousand disciples attend upon me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:3.1"], "en": "I remain in peaceful seclusion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:3.2"], "en": "I thought thus at that time:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:3.3"], "en": "\"Everyone honors me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:3.4"], "en": "yet I do not honor anything.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:4.1"], "en": "I have no instructor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:4.2"], "en": "nor is there anyone to admonish me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:4.3"], "en": "I have neither teacher nor preceptor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:4.4"], "en": "I have entered upon dwelling in the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:5.1", "PA_tha-ap_500:5.2"], "en": "While dwelling there, I shall maintain a mind of reverence toward him whom I serve.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:5.3"], "en": "Thus I have no teacher;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:5.4"], "en": "my dwelling in the forest is in vain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:6.1"], "en": "I shall seek out a worthy recipient for my offering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:6.2"], "en": "“Venerating him as one to be revered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:6.3"], "en": "I shall dwell with a protector;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:6.4"], "en": "no one at all will reproach me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:7.1"], "en": "The river has its banks turned upward,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:7.2", "PA_tha-ap_500:7.3"], "en": "with beautiful landing-stairs and delightful shores strewn with pure sand.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:7.4"], "en": "Not far from my hermitage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:8.1", "PA_tha-ap_500:8.2"], "en": "I then approached a river named Amarikā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:8.3"], "en": "Having built up a sandbank,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:8.4", "PA_tha-ap_500:9.1"], "en": "he made a sand-cetiya for those who were the Fully Enlightened Ones.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:9.2"], "en": "The sages who have brought about the end of becoming—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:9.3"], "en": "for them such is the stupa;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:9.4"], "en": "I am making this a sign for them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:10.1"], "en": "Having made a mound of sand,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:10.2"], "en": "I had a stupa constructed of gold;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:10.3"], "en": "[I offered] golden *kiṅkaṇī* flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:10.4"], "en": "I honored three thousand [monks];", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:11.1"], "en": "evening and morning,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:11.2"], "en": "born of wisdom, I paid homage with palms joined.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:11.3", "PA_tha-ap_500:11.4"], "en": "I paid homage to the Pulina Cetiya as if to the Fully Awakened One face-to-face.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:12.1"], "en": "Whenever defilements arise,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:12.2"], "en": "Thoughts based on the household life arise;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:12.3", "PA_tha-ap_500:12.4"], "en": "I remember the well-constructed stupa and reflect upon it for a while.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:13.1", "PA_tha-ap_500:13.2"], "en": "Dwelling in dependence upon the Charioteer of the Caravan, the Leader,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:13.3"], "en": "you should dwell [only] with the defilements.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:13.4"], "en": "\"It is not fitting for you, dear sir.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:14.1"], "en": "As soon as the stupa was brought to mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:14.2"], "en": "reverence arose within me then.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:14.3"], "en": "I find diversion in doubt,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:14.4"], "en": "like an elephant agitated by a goad;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:15.1"], "en": "while I am dwelling thus—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:15.2", "PA_tha-ap_500:15.3"], "en": "I crushed the King of Death; having passed away there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:15.4"], "en": "I went to the Brahma-world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:16.1"], "en": "Having lived out my full lifespan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:16.2"], "en": "I was reborn among the Thirty-three gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:16.3"], "en": "eighty times I was the lord of the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:16.4"], "en": "I exercised sovereignty over the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:17.1"], "en": "and three hundred times,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:17.2"], "en": "I was a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:17.3"], "en": "A vast regional sovereignty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:17.4"], "en": "beyond counting and incalculable,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:18.1"], "en": "[was gained] from golden *kiṅkaṇī* flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:18.2"], "en": "I experience the result of my deeds;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:18.3", "PA_tha-ap_500:18.4"], "en": "hundreds of thousands of nurses attend upon me in that existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:19.1"], "en": "Because he has honored the stupa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:19.2"], "en": "dust and dirt do not cling to him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:19.3"], "en": "sweat does not break out on his limbs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:19.4"], "en": "\"I shall become exceedingly radiant.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:20.1"], "en": "Oh, how well constructed is my stupa!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:20.2"], "en": "The Marikā River has been clearly seen.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:20.3"], "en": "Having built a stupa from sand,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:20.4"], "en": "I have attained the immovable state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:21.1"], "en": "By one desiring to perform wholesome deeds, [this should be done].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:21.2"], "en": "For a person who grasps the essence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:21.3"], "en": "there is no field that is not a field;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:21.4"], "en": "it is practice alone that brings accomplishment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:22.1"], "en": "Just as a strong man,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:22.2"], "en": "wishing to cross the great ocean,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:22.3"], "en": "might take up a small piece of wood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:22.4"], "en": "One might leap into a great lake.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:23.1"], "en": "Relying on this log,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:23.2"], "en": "I shall cross over the great ocean.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:23.3"], "en": "With resolve and vigor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:23.4"], "en": "a man may cross the ocean;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:24.1"], "en": "even so have I performed my task.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:24.2", "PA_tha-ap_500:24.3"], "en": "Relying upon that small and meager deed as a supporting condition,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:24.4"], "en": "I have transcended saṃsāra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:25.1"], "en": "When his final existence had arrived,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:25.2"], "en": "urged on by the root of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:25.3"], "en": "he was born in the city of Sāvatthī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:25.4"], "en": "In Mahāsāla, which was very wealthy,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:26.1"], "en": "my mother and father, with faith,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:26.2"], "en": "went for refuge to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:26.3"], "en": "Both of these have seen the state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:26.4"], "en": "they follow the teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:27.1"], "en": "having grasped the sprout of enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:27.2"], "en": "They had a golden stupa built;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:27.3"], "en": "evening and morning they paid homage there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:27.4"], "en": "as if in the presence of the Son of the Sakyas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:28.1"], "en": "On the day of the Uposatha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:28.2", "PA_tha-ap_500:28.3"], "en": "they carried forth the golden stupa while praising the virtues of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:28.4"], "en": "I spent three watches of the night.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:29.1"], "en": "Upon seeing the stupa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:29.2"], "en": "I remembered the Pulinacetiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:29.3"], "en": "Sitting upon a single seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:29.4"], "en": "I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:30.1"], "en": "This is the twenty-second recitation section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:31.1"], "en": "Seeking that hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:31.2"], "en": "the General of the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:31.3"], "en": "he went forth from the home.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:31.4"], "en": "I went forth in his presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:32.1"], "en": "At the age of seven,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:32.2"], "en": "I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:32.3", "PA_tha-ap_500:32.4"], "en": "The Buddha, the Seer, having recognized his virtues, ordained him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:33.1"], "en": "he was as peaceful as a child.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:33.2"], "en": "My task is finished;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:33.3", "PA_tha-ap_500:33.4"], "en": "today I have done what was to be done in the teaching of the Son of the Sakyans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:34.1", "PA_tha-ap_500:34.2"], "en": "The seer who has transcended all enmity and fear, and gone beyond all attachments—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:34.3"], "en": "such is your disciple, O Great Hero.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:34.4"], "en": "This is the fruit of the golden stupa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:35.1", "PA_tha-ap_500:35.2"], "en": "my defilements have been incinerated... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:35.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:36.1", "PA_tha-ap_500:36.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:36.3"], "en": "Thus was the teaching of the Buddha spoken:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_500:37.1", "PA_tha-ap_500:37.2"], "en": "the four analytical knowledges, and so forth...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
