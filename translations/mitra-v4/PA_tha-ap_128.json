[
{"segs": ["PA_tha-ap_128:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:0.2"], "en": "Sereyyavagga, 6.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:0.3"], "en": "The Apadāna of the Elder Kusumāsaniya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:1.1"], "en": "“At that time, in the city of Dhaññavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:1.2", "PA_tha-ap_128:1.3"], "en": "I was a brahmin skilled in the science of marks and in ancient lore.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:1.4"], "en": "I am one who knows the Nighaṇḍu and the Keṭubha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:2.1"], "en": "a master of the Padas and grammar,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:2.2"], "en": "and skilled in the science of signs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:2.3"], "en": "I taught the mantras to my students,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:2.4"], "en": "having mastered the three Vedas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:3.1"], "en": "[I gave] five handfuls of blue lotuses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:3.2"], "en": "I placed them upon my back,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:3.3", "PA_tha-ap_128:3.4"], "en": "desiring to offer a sacrifice at the meeting of my father and mother.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:4.1"], "en": "Then the Blessed One Vipassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:4.2"], "en": "honored by the community of monks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:4.3"], "en": "illuminating all directions, [proceeded].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:4.4"], "en": "The bull among men arrived.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:5.1", "PA_tha-ap_128:5.2"], "en": "Having prepared a seat and invited the Great Sage, [he offered him hospitality].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:5.3"], "en": "Having arranged that flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:5.4"], "en": "I brought it to my own home.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:6.1"], "en": "Whatever wealth I had in my own house—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:6.2"], "en": "Food was set before me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:6.3", "PA_tha-ap_128:6.4"], "en": "with a mind full of faith, I gave it to the Buddha with my own hands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:7.1"], "en": "Knowing that he had finished eating,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:7.2"], "en": "I offered him a handful of flowers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:7.3"], "en": "the All-Knowing One, having expressed his appreciation, [accepted them].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:7.4"], "en": "He departed facing north.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:8.1"], "en": "Ninety-one aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:8.2"], "en": "when I gave that flower at that time;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:8.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:8.4"], "en": "this is the fruit of giving flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:9.1"], "en": "In the kalpa immediately following this one,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:9.2"], "en": "I was a king named Varadassana,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:9.3", "PA_tha-ap_128:9.4"], "en": "a wheel-turning monarch of great power, endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:10.1", "PA_tha-ap_128:10.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:10.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:11.1"], "en": "Thus indeed the venerable elder Kusumāsaniyo spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_128:12.1"], "en": "This is the sixth legend of the elder Kusumāsaniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
