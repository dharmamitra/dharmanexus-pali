{"segs": ["PA_ja_30:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_30:0.2", "PA_ja_30:0.3"], "en": "The First Book, The Chapter on the Antelope (Kuruṅgavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_30:0.4"], "en": "10. The Munika Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_30:1.1"], "en": "“Do not envy Munika;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_30:1.2"], "en": "he eats food that is sickly.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_30:1.3"], "en": "“Eat the chaff without anxiety;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_30:1.4"], "en": "this is the mark of long life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_30:2.1"], "en": "The Munika Jātaka, the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_30:2.2"], "en": "The third chapter is the Kuruṅga Chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_30:3.1"], "en": "Its summary (uddāna) is:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_30:4.1"], "en": "Kuruṅga, Kukkuravatika, and Go-vatika.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_30:4.2"], "en": "Furthermore, he who is named Sirivaḷava,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_30:4.3"], "en": "the beloved husband of the woman named Mahilāmukha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_30:4.4"], "en": "carries the burden with ten sages.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
