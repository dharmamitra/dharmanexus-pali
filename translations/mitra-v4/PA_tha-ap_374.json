[
{"segs": ["PA_tha-ap_374:0.1", "PA_tha-ap_374:0.2"], "en": "The Therāpadāna, Bodhivandanavagga: 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:0.3"], "en": "The Apadāna of the Elder Pāṭalipupphiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:1.1"], "en": "“The Blessed One named Vipassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:1.2"], "en": "the self-become, the supreme person,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:1.3"], "en": "was preceded by his disciples.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:1.4"], "en": "The Conqueror entered Bandhumatī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:2.1", "PA_tha-ap_374:2.2"], "en": "Three pāṭali flowers were placed upon my lap;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:2.3"], "en": "Desiring to wash my head,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:2.4"], "en": "I went to a river crossing;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:3.1"], "en": "having departed from Bandhumatī, I went forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:3.2"], "en": "I saw the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:3.3"], "en": "blazing like a blue lotus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:3.4"], "en": "like a kindled sacrificial fire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:4.1"], "en": "Like a preeminent tiger,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:4.2"], "en": "like a noble lion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:4.3"], "en": "he goes, the foremost among ascetics.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:4.4"], "en": "Honored by the community of monks—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:5.1"], "en": "having faith in that Sugata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:5.2"], "en": "who washes away the stains of the defilements;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:5.3"], "en": "Having taken three flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:5.4"], "en": "I worshipped the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:6.1"], "en": "Ninety-one aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:6.2"], "en": "Whatever flower I offered in worship,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:6.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:6.4"], "en": "this is the fruit of worshipping the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:7.1", "PA_tha-ap_374:7.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:7.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:8.1"], "en": "Thus indeed did the venerable elder Pāṭalipupphiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_374:9.1"], "en": "This is the second legend of the elder Pāṭalipupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
