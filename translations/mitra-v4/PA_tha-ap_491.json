[
{"segs": ["PA_tha-ap_491:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:0.2"], "en": "Chapter on the Rag-Robes (Paṁsukūlavagga),", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:0.3"], "en": "Number Nine: The Apadāna of the Elder Dhammaruci.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:1.1", "PA_tha-ap_491:1.2"], "en": "“When the Jina Dīpaṅkara Buddha made this prediction for Sumedha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:1.3"], "en": "‘In an incalculable aeon from now, ...’”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:1.4"], "en": "\"This one will become a Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:2.1", "PA_tha-ap_491:2.2"], "en": "His mother who gives birth to him will be named Māyā.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:2.3"], "en": "His father will be named Suddhodana;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:2.4", "PA_tha-ap_491:3.1"], "en": "he will become Gotama after having exerted himself in striving.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:3.2"], "en": "Having performed difficult austerities,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:3.3", "PA_tha-ap_491:3.4"], "en": "the Greatly Renowned One will awaken as a Perfectly Enlightened One at the foot of the Assattha tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:4.1", "PA_tha-ap_491:4.2"], "en": "Upatissa and Kolita shall be the foremost disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:4.3"], "en": "he who is known by the name Ānanda—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:4.4"], "en": "I shall attend upon this Conqueror.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:5.1", "PA_tha-ap_491:5.2"], "en": "Khemā and Uppalavaṇṇā shall be the foremost among his female disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:5.3"], "en": "Citta and Āḷavaka shall be the foremost among lay disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:5.4", "PA_tha-ap_491:6.1"], "en": "Khujjuttarā, the mother of Nanda, [shall be foremost among female lay disciples].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:6.2"], "en": "\"Shall be the foremost among female lay disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:6.3", "PA_tha-ap_491:6.4"], "en": "the Bodhi tree of this Hero shall be called Assattha.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:7.1", "PA_tha-ap_491:7.2"], "en": "Having heard these words of the Peerless Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:7.3"], "en": "humans and gods were filled with joy.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:7.4"], "en": "They pay homage with palms joined.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:8.1", "PA_tha-ap_491:8.2"], "en": "At that time, I was a young brahmin named Megha, well-trained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:8.3", "PA_tha-ap_491:8.4"], "en": "Having heard the supreme exposition of Sumedha, the Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:9.1"], "en": "I became full of confidence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:9.2"], "en": "O wise one, whose mind is set on compassion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:9.3", "PA_tha-ap_491:9.4"], "en": "I followed right after that hero as he went forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:10.1"], "en": "Restrained by the Pātimokkha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:10.2"], "en": "with the five sense faculties controlled,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:10.3"], "en": "pure in livelihood, mindful, and heroic—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:10.4"], "en": "A builder of the Victor’s dispensation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:11.1"], "en": "While dwelling thus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:11.2"], "en": "I was [assailed] by some evil friend;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:11.3"], "en": "Enjoined to improper conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:11.4"], "en": "he has strayed from the good path;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:12.1"], "en": "having become a slave to his own thoughts, he is lost.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:12.2"], "en": "I departed from the Teaching;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:12.3"], "en": "later, instigated by that evil friend,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:12.4"], "en": "I committed the murder of my mother.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:13.1"], "en": "I committed an act of immediate retribution,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:13.2"], "en": "slaying with a wicked mind;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:13.3"], "en": "having passed away from there, I fell into the Great Avīci hell.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:13.4"], "en": "I was reborn in a most dreadful state;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:14.1"], "en": "having fallen into the abyss,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:14.2"], "en": "I wandered for a long time, afflicted by suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:14.3"], "en": "I did not see the Hero again,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:14.4"], "en": "the wise one, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:15.1"], "en": "within this eon in the ocean.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:15.2"], "en": "I was a fish, a timingala;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:15.3"], "en": "seeing a ship in the ocean,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:15.4"], "en": "I approached it for the sake of food.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:16.1", "PA_tha-ap_491:16.2", "PA_tha-ap_491:16.3"], "en": "Seeing me, the merchants were terrified and called to mind the Best of Buddhas with the great cry, \"Gotama!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:16.4"], "en": "Having heard what was uttered by them,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:17.1"], "en": "and having recollected my former consciousness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:17.2"], "en": "I then passed away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:17.3", "PA_tha-ap_491:17.4"], "en": "Born into a wealthy family in Sāvatthī, I was of brahmin descent;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:18.1"], "en": "my name was Dhammaruci.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:18.2"], "en": "A loather of all evil;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:18.3"], "en": "having seen the Lamp of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:18.4"], "en": "I was seven years of age.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:19.1"], "en": "Having gone to the Great Jeta Grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:19.2"], "en": "I went forth into the homeless life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:19.3"], "en": "I approached the Buddha three times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:19.4", "PA_tha-ap_491:20.1"], "en": "At that time, seeing me after both night and day had passed, the Sage said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:20.2"], "en": "\"Dhammaruci, you have waited long for me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:20.3"], "en": "Then I spoke to the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:20.4"], "en": "who was manifested by his former karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:21.1"], "en": "he whose hundred marks of merit had been perfected for a very long time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:21.2"], "en": "With a purity of conditions from former practice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:21.3", "PA_tha-ap_491:21.4"], "en": "I behold today, O peerless one, your body which is truly worthy of close inspection.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:22.1"], "en": "For a very long time I have dispelled darkness;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:22.2"], "en": "for a very long time, by guarding well, I have dried up the river;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:22.3"], "en": "for a very long time I have purified what is stainless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:22.4", "PA_tha-ap_491:23.1"], "en": "O Great Sage, this eye consisting of wisdom has been possessed by you for a long time; it has not perished,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:23.2"], "en": "and for a further long interval, it remains intact.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:23.3"], "en": "Having come together with you once again,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:23.4"], "en": "O Gotama, those deeds that were done do not perish;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:24.1"], "en": "for my defilements have been incinerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:24.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:24.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:25.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:25.2", "PA_tha-ap_491:25.3"], "en": "... [and so on] ... the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:26.1"], "en": "The four analytical knowledges (paṭisambhidā) have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:26.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:26.3"], "en": "the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:27.1"], "en": "Thus indeed did the Venerable Elder Dhammaruciyo speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_491:28.1"], "en": "The legend of the Elder Dhammaruciya, the ninth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
