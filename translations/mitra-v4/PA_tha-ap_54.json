[
{"segs": ["PA_tha-ap_54:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:0.2", "PA_tha-ap_54:0.3"], "en": "The Section on the Seed (Bījanivagga), Story of the Elder Sataraṁsi (No. 2)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:1.1"], "en": "“Having ascended a lofty rock,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:1.2"], "en": "the Supreme Person sat down;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:1.3"], "en": "not far from the mountain, [he remained].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:1.4"], "en": "The brahmin, a master of the mantras,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:2.1"], "en": "[approached] the Great Hero who was seated—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:2.2"], "en": "the God of Gods, the Bull among Men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:2.3"], "en": "Raising my hands in reverential salutation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:2.4"], "en": "I praised the Leader of the World:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:3.1"], "en": "\"This is the Buddha, the Great Hero.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:3.2"], "en": "Proclaimer of the sublime Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:3.3"], "en": "he shines like a mass of fire,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:3.4"], "en": "seated at the head of the Saṅgha of bhikkhus.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:4.1", "PA_tha-ap_54:4.2"], "en": "Unshakeable like the great ocean, difficult to cross like the sea,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:4.3"], "en": "and fearless like the king of beasts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:4.4"], "en": "The Visionary teaches the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:5.1"], "en": "Having understood my intention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:5.2"], "en": "the Leader Padumuttara—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:5.3"], "en": "Standing before the Saṅgha of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:5.4"], "en": "the Teacher spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:6.1"], "en": "“By whom this salutation with joined palms was given, [to him shall there be great merit].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:6.2"], "en": "And the Best of Buddhas was praised;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:6.3"], "en": "for thirty thousand eons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:6.4"], "en": "he will exercise sovereignty over the gods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:7.1"], "en": "In the hundred-thousandth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:7.2", "PA_tha-ap_54:7.3"], "en": "there was a Fully Enlightened One named Aṅgīrasa, whose canopy was wide open.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:7.4", "PA_tha-ap_54:8.1"], "en": "At that very moment, he will arise as the heir to the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:8.2"], "en": "the legitimate son fashioned by the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:8.3"], "en": "‘By the name Sataraṃsi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:8.4"], "en": "he will become an Arhat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:9.1"], "en": "When I was seven years of age,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:9.2"], "en": "I went forth into the homeless life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:9.3"], "en": "by the name Sataraṁsi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:9.4"], "en": "my radiance shines forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:10.1"], "en": "In a pavilion or at the foot of a tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:10.2"], "en": "I, a meditator devoted to jhāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:10.3"], "en": "maintain this final body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:10.4"], "en": "In the teaching of the Perfectly Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:11.1"], "en": "during the sixty thousandth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:11.2"], "en": "there were four named Rāma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:11.3"], "en": "Possessing the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:11.4"], "en": "they are wheel-turning monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:12.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:12.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:12.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:13.1"], "en": "Thus indeed did the Venerable Sataraṃsi Thera speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_54:14.1"], "en": "The legend of the Elder Sataraṁsi is the second.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
