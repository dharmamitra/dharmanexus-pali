[
{"segs": ["PA_tha-ap_436:0.1", "PA_tha-ap_436:0.2"], "en": "The Apadāna of the Elder Ñāṇatthavika,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:0.3"], "en": "from the Ekavihārivagga, Number Four.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:1.1"], "en": "Like a blooming kaṇikāra tree,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:1.2"], "en": "like a lamp-tree shining brightly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:1.3"], "en": "like gold gleaming with radiance—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:1.4"], "en": "I saw the Supreme among Bipeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:2.1"], "en": "Having set aside my water-pot,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:2.2"], "en": "my bark garment, and my water-strainer, I approached him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:2.3"], "en": "Arranging my deerskin cloak over one shoulder,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:2.4"], "en": "I praised the Best of Buddhas:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:3.1"], "en": "“Dispelling that darkness...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:3.2", "PA_tha-ap_436:3.3"], "en": "Having shown the light of knowledge to those entangled in the net of delusion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:3.4"], "en": "you have crossed over, O Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:4.1"], "en": "You have uplifted this entire world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:4.2", "PA_tha-ap_436:4.3"], "en": "O Unsurpassed One; there is no simile for your wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:4.4"], "en": "To whatever extent there is a destination for the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:5.1"], "en": "he is omniscient through that knowledge;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:5.2"], "en": "thus he is called \"Buddha.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:5.3"], "en": "I pay homage to that Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:5.4"], "en": "whose omniscience is unimpeded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:6.1"], "en": "A hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:6.2"], "en": "I have praised the Best of Buddhas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:6.3"], "en": "I do not know a state of misery—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:6.4"], "en": "this is the fruit of praising with wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:7.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:7.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:7.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:8.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:8.2", "PA_tha-ap_436:8.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:9.1", "PA_tha-ap_436:9.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:9.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:10.1"], "en": "Thus indeed the venerable elder Ñāṇatthavika spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_436:11.1"], "en": "This is the fourth legend of the elder Ñāṇatthavika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
