[
{"segs": ["PA_thag_7.4:0.1", "PA_thag_7.4:0.2", "PA_thag_7.4:0.3"], "en": "Theragāthā 7.4 Sattaka-nipāta Paṭhama-vagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:0.4"], "en": "The Verses of the Elder Sopāka:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:1.1", "PA_thag_7.4:1.2"], "en": "“Having seen the Supreme among Men walking back and forth in the shadow of the palace, I thought:”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:1.3"], "en": "Having approached him there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:1.4"], "en": "I shall pay homage to that Supreme Person;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:2.1"], "en": "having arranged my robe over one shoulder, I shall do so.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:2.2"], "en": "Having withdrawn my hands,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:2.3"], "en": "I shall walk about the dustless one,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:2.4"], "en": "the supreme among all beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:3.1", "PA_thag_7.4:3.2"], "en": "Then he, the wise one skilled in questions, asked me questions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:3.3"], "en": "being himself undaunted and fearless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:3.4"], "en": "I answered for the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:4.1"], "en": "When the questions had been answered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:4.2"], "en": "the Tathāgata expressed his approval.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:4.3"], "en": "Looking over the community of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:4.4"], "en": "he spoke this matter:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:5.1"], "en": "“It is a gain for the people of Aṅga and Magadha!”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:5.2", "PA_thag_7.4:5.3", "PA_thag_7.4:5.4"], "en": "Whatever robes, almsfood, requisites, and lodgings he makes use of;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:5.5"], "en": "\"And rising to greet them with proper courtesy—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:5.6"], "en": "these, he declared, are their gains.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:6.1"], "en": "From this day forward, Sopāka, for me...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:6.2"], "en": "\"Come for the sake of seeing [me];", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:6.3"], "en": "let this, Sopaka,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:6.4"], "en": "be your full ordination.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:7.1", "PA_thag_7.4:7.2"], "en": "Having received full ordination at the age of seven,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:7.3"], "en": "I now bear my final body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:7.4"], "en": "“Oh, how well-proclaimed is the Dhamma!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_7.4:7.5"], "en": "… Thus spoke the Elder Sopāka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
