[
{"segs": ["PA_thag_2.49:0.1"], "en": "Theragāthā 2.49 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:0.2", "PA_thag_2.49:0.3"], "en": "Pañcamavagga (The Fifth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:0.4"], "en": "The Verses of the Elder Sandhita:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:1.1"], "en": "“In the Assattha tree, shining with greenness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:1.2"], "en": "where the foliage has grown thick;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:1.3", "PA_thag_2.49:1.4"], "en": "Mindful, he attained a single perception directed toward the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:2.1"], "en": "Thirty-one eons ago from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:2.2"], "en": "The perception that I then obtained—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:2.3"], "en": "by the power of that perception,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:2.4"], "en": "the destruction of the taints was attained by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:2.5"], "en": "... The Elder Sandhita ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:2.6"], "en": "The fifth chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:3.0"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:3.1"], "en": "The Elder Kumārakassapa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:3.2"], "en": "Dhammapāla, and Brahmāli;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:3.3"], "en": "Mogharāja and Visākha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:3.4"], "en": "And Cūḷaka, Anūpama,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:3.5", "PA_thag_2.49:3.6"], "en": "Vajjita, Sandhita, and the Elder Kilesarajavāhana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:3.7"], "en": "The Second Book of Twos is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:4.0", "PA_thag_2.49:4.1"], "en": "Herein is the summary verse for the Gāthādukanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:4.2"], "en": "Ninety-eight [verses] indeed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_2.49:4.3", "PA_thag_2.49:4.4"], "en": "forty-nine stanzas were spoken by those skilled in the methods.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
