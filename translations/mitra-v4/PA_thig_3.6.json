[
{"segs": ["PA_thig_3.6:0.1", "PA_thig_3.6:0.2", "PA_thig_3.6:0.3"], "en": "Therīgāthā 3.6 Tikanipāta Sukkātherīgāthā The Verses of the Elder Nun Sukkā, from the Third Book (Tikanipāta) of the *Therīgāthā*.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.6:1.1"], "en": "“What have the people in Rājagaha done to me?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.6:1.2"], "en": "They act like those who have drunk honey and are leaping about,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.6:1.3"], "en": "they who do not wait upon the White One.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.6:1.4"], "en": "Entering the teaching of the Buddha—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.6:2.1", "PA_thig_3.6:2.2"], "en": "teaching that is irresistible and possesses the invigorating essence that never satiates.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.6:2.3"], "en": "The wise, I think, drink [of the Dhamma],", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.6:2.4"], "en": "just as travelers drink from a cloud;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.6:3.1"], "en": "the pure ones [are purified] by pure qualities.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.6:3.2"], "en": "Free from passion and concentrated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.6:3.3"], "en": "they bear their final body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.6:3.4"], "en": "having conquered Māra and his host.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_3.6:4.1"], "en": "… The Elder Nun Sukkā …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
