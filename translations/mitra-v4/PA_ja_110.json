[
{"segs": ["PA_ja_110:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_110:0.2", "PA_ja_110:0.3"], "en": "Ekakanipāta, Parosatavagga (The Chapter on More than One Hundred)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_110:0.4"], "en": "10. The Jātaka of the All-Gatherer:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_110:1.1"], "en": "“There is no one who gathers everything;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_110:1.2"], "en": "pure *kaṅgu* grain is being winnowed.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_110:1.3"], "en": "\"This harlot is afraid of falsehood;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_110:1.4"], "en": "the old woman speaks the truth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_110:2.1"], "en": "Thus ends the tenth Jātaka, the *Sabbasaṃhāraka-pañha-jātaka*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_110:2.2"], "en": "The eleventh chapter is the Parosata-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_110:3.1"], "en": "Its summary verse (uddāna) is:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_110:4.1"], "en": "Sapara-sata-tāyi-verī puna...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_110:4.2", "PA_ja_110:4.3"], "en": "Bhāmācakkha, Nāgasiri, Vata, Sippaka, Bāhiya, Kuṇḍa, Pūva,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_110:4.4"], "en": "and Mahallika— these are the ten.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
