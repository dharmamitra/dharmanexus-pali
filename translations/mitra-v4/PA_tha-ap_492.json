[
{"segs": ["PA_tha-ap_492:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:0.2", "PA_tha-ap_492:0.3"], "en": "The Chapter on Rags from the Dustheap (Paṁsukūlavagga) 10. The Legend of the Elder Sālamaṇḍapiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:1.1"], "en": "“Having plunged into the sāla grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:1.2", "PA_tha-ap_492:1.3"], "en": "my well-prepared hermitage is covered with sāla blossoms.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:1.4"], "en": "I was dwelling in the forest at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:2.1"], "en": "And the Blessed One Piyadassī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:2.2"], "en": "the Self-Existent, the Supreme Person;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:2.3", "PA_tha-ap_492:2.4"], "en": "Desiring solitude, the Fully Awakened One went to the Sāla grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:3.1"], "en": "departing from his hermitage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:3.2"], "en": "Unable to endure the wind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:3.3", "PA_tha-ap_492:3.4"], "en": "I was then wandering through the forest in search of roots and fruits.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:4.1"], "en": "There I saw the Fully Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:4.2"], "en": "lovely to behold and of great renown,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:4.3"], "en": "seated comfortably and absorbed in meditative attainment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:4.4"], "en": "Shining brightly in the great forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:5.1", "PA_tha-ap_492:5.2"], "en": "I placed four staffs above the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:5.3"], "en": "Having constructed a well-made pavilion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:5.4"], "en": "I covered it with *sāla* flowers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:6.1"], "en": "having maintained this for seven days,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:6.2", "PA_tha-ap_492:6.3", "PA_tha-ap_492:6.4"], "en": "I worshipped the Best of Buddhas there, having inspired confidence in my mind within that pavilion covered with sal trees.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:7.1"], "en": "At that time, the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:7.2"], "en": "having emerged from meditative concentration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:7.3"], "en": "looked ahead a distance of a yoke’s length.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:7.4"], "en": "The Supreme Person sat down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:8.1", "PA_tha-ap_492:8.2"], "en": "There was a disciple named Varuṇa belonging to the Teacher Piyadassi.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:8.3"], "en": "Accompanied by one hundred thousand sages,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:8.4"], "en": "he approached the Leader.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:9.1"], "en": "And the Blessed One Piyadassī—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:9.2"], "en": "The Conqueror, the eldest in the world, the bull among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:9.3"], "en": "having sat down in the community of monks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:9.4"], "en": "manifested a smile.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:10.1", "PA_tha-ap_492:10.2"], "en": "Anuruddha was the attendant of the Teacher Piyadassi;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:10.3"], "en": "having arranged his robe over one shoulder, he—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:10.4"], "en": "He questioned the Great Sage:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:11.1"], "en": "“What indeed, Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:11.2"], "en": "is the cause for the Teacher’s act of smiling?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:11.3"], "en": "When a cause was present,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:11.4"], "en": "the Teacher manifested a smile:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:12.1"], "en": "\"For seven days, under the shelter of a *sāla* tree...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:12.2"], "en": "To that young brahmin who remembered me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:12.3", "PA_tha-ap_492:12.4"], "en": "I manifested a smile after recollecting his deed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:13.1", "PA_tha-ap_492:13.2"], "en": "I see no place where merit ripens,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:13.3"], "en": "whether in the world of the gods or among humans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:13.4", "PA_tha-ap_492:14.1"], "en": "There is no room at all for one who dwells in the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:14.2"], "en": "endowed with meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:14.3"], "en": "To whatever extent his assembly shall be,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:14.4"], "en": "it will be shaded by sāl trees;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:15.1"], "en": "there, with celestial dances,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:15.2"], "en": "With songs and instrumental music,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:15.3", "PA_tha-ap_492:15.4"], "en": "the peaceful one, established in meritorious deeds, will always delight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:16.1"], "en": "To whatever extent there is an assembly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:16.2"], "en": "it will be fragrant with his scent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:16.3"], "en": "like a rain of *sāla* flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:16.4"], "en": "It will rain for that long. Then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:17.1"], "en": "when this person has passed away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:17.2"], "en": "he will come back to the human world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:17.3", "PA_tha-ap_492:17.4"], "en": "Here too, the roof of sala trees shall endure for all time; here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:18.1"], "en": "dance and song [shall continue].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:18.2", "PA_tha-ap_492:18.3"], "en": "Constantly surrounded by those as well-composed as a struck gong—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:18.4"], "en": "this is the fruit of making offerings to the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:19.1"], "en": "And as the sun was rising,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:19.2"], "en": "a shower of sal flowers fell,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:19.3"], "en": "connected with his meritorious deed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:19.4"], "en": "It rains at all times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:20.1"], "en": "In eighteen hundred kappas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:20.2"], "en": "one born of the Okkāka clan [will appear].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:20.3", "PA_tha-ap_492:20.4"], "en": "One named Gotama by clan will become a teacher in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:21.1"], "en": "he will be an heir to his teachings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:21.2"], "en": "Born from the heart, fashioned by the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:21.3"], "en": "having fully understood all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:21.4"], "en": "he will extinguish, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:22.1"], "en": "For one who penetrates the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:22.2", "PA_tha-ap_492:22.3"], "en": "there will be a canopy of sal trees; for one burning on the funeral pyre, there will be a canopy of sal trees.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:22.4"], "en": "\"There shall be a covering there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:23.1"], "en": "Having proclaimed this result,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:23.2"], "en": "the Great Sage Piyadassī—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:23.3"], "en": "He taught the Dhamma to the assembly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:23.4"], "en": "refreshing them with a rain of Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:24.1"], "en": "For thirty eons among the devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:24.2"], "en": "I exercised sovereignty over the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:24.3", "PA_tha-ap_492:24.4"], "en": "and sixty-seven times I was a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:25.1"], "en": "Having come here from the world of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:25.2"], "en": "I obtain abundant happiness; even here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:25.3"], "en": "there is the shade of the *sāla* tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:25.4"], "en": "This is the fruit of the pavilion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:26.1"], "en": "This is my final one;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:26.2"], "en": "my last existence is now unfolding.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:26.3", "PA_tha-ap_492:26.4"], "en": "Here too, there shall be a roof of *sāla* trees for all seasons;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:27.1"], "en": "having pleased the Great Sage, [one will attain this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:27.2", "PA_tha-ap_492:27.3", "PA_tha-ap_492:27.4"], "en": "I have reached the unshakable state, having left behind victory and defeat, under Gotama, the bull of the Sakyas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:28.1"], "en": "In eighteen hundred kappas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:28.2"], "en": "because I worshipped that Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:28.3"], "en": "I have not known a miserable rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:28.4"], "en": "This is the fruit of worshiping the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:29.1", "PA_tha-ap_492:29.2"], "en": "my defilements have been incinerated... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:29.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:30.1", "PA_tha-ap_492:30.2"], "en": "Welcome indeed has come to me... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:30.3"], "en": "The Buddha’s teaching has been proclaimed:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:31.1", "PA_tha-ap_492:31.2"], "en": "the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:31.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:32.1"], "en": "In this way, indeed, the venerable elder Sālamaṇḍapiya recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:33.1"], "en": "This is the tenth legend of the elder Sālamaṇḍapiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:34.1"], "en": "The Fortieth Chapter on Rags from the Dust-Heap.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:35.1"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:36.1"], "en": "Rags from the dust-heap, the perception of the Buddha...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:36.2"], "en": "Bhisado, Ñāṇakittako;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:36.3", "PA_tha-ap_492:36.4"], "en": "Candanī, Dhātupūjī, and Pulinuppādako as well.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:37.1"], "en": "Taraṇo, Dhammaruciko,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:37.2"], "en": "and likewise Sālamaṇḍapiyo;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:37.3"], "en": "there are two hundred verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_492:37.4"], "en": "And indeed, in the nineteenth [chapter].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
