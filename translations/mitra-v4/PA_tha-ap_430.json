[
{"segs": ["PA_tha-ap_430:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:0.2"], "en": "Chapter on Those Who Swept Once (Sakiṃsammajjakavagga) 8.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:0.3"], "en": "The Apadāna of the Elder Sucintita", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:1.1"], "en": "“In the city of Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:1.2"], "en": "I was then a farmer;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:1.3"], "en": "I lived by the work of plowing.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:1.4"], "en": "With that, I nourish my children.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:2.1"], "en": "At that time, the field was perfectly prepared,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:2.2"], "en": "and my grain became fruitful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:2.3"], "en": "And when the time for ripening had arrived,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:2.4"], "en": "I then thought thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:3.1"], "en": "\"This is neither concealed nor appropriate.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:3.2"], "en": "Knowing the merits and demerits,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:3.3", "PA_tha-ap_430:3.4"], "en": "if I were then to eat the finest portion without first giving to the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:4.1"], "en": "This Buddha is peerless and equal to none,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:4.2"], "en": "endowed with the thirty-two excellent marks;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:4.3"], "en": "from him the Saṅgha is produced.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:4.4"], "en": "The unsurpassed field of merit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:5.1"], "en": "Therein I shall give gifts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:5.2"], "en": "fresh grain after every harvest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:5.3"], "en": "Having thought thus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:5.4"], "en": "joyful and with a gladdened mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:6.1"], "en": "I brought grain from the field.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:6.2"], "en": "I approached the Fully Awakened One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:6.3"], "en": "having approached the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:6.4"], "en": "the Eldest in the World, the Bull among Men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:6.5"], "en": "Having bowed at the Teacher’s feet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:6.6"], "en": "I spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:7.1"], "en": "“The new crop has ripened;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:7.2", "PA_tha-ap_430:7.3"], "en": "And you, O Sage, are worthy of offerings; out of compassion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:7.4"], "en": "O Visionary One, please accept [this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:8.1"], "en": "Padumuttara, the knower of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:8.2"], "en": "the receiver of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:8.3"], "en": "having understood my intention—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:8.4"], "en": "He spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:9.1", "PA_tha-ap_430:9.2"], "en": "“There are four who have entered the path and four who are established in the fruit.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:9.3"], "en": "This Saṅgha is upright,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:9.4"], "en": "established in wisdom and virtue;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:9.5"], "en": "among the people who offer sacrifices, [it is the most worthy].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:9.6"], "en": "For living beings seeking merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:10.1", "PA_tha-ap_430:10.2"], "en": "performing meritorious deeds based on material requisites that are given to the Saṅgha yields great fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:10.3"], "en": "It should be given to that very Saṅgha—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:10.4"], "en": "your own crop as well as others.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:11.1"], "en": "Having designated it from the Saṅgha...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:11.2"], "en": "\"Having led the monks to the monastery,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:11.3", "PA_tha-ap_430:11.4"], "en": "give to the community of monks that which is prepared and present in your house.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:12.1", "PA_tha-ap_430:12.2"], "en": "Having designated [the gift] for the Saṅgha and led the monks to the monastery,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:12.3"], "en": "that which was prepared by me in my house—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:12.4"], "en": "I gave it to the community of monks.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:13.1"], "en": "By that well-performed deed and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:13.2"], "en": "[may I attain the fruit of my merit].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:13.3"], "en": "Having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:13.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:14.1"], "en": "There, a well-constructed celestial mansion was mine.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:14.2"], "en": "It was made of gold, radiant and brilliant;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:14.3", "PA_tha-ap_430:14.4"], "en": "sixty yojanas in height and thirty yojanas in width.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:15.1"], "en": "The nineteenth recitation section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:16.1"], "en": "My dwelling is crowded,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:16.2"], "en": "thronged by hosts of women.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:16.3"], "en": "Having eaten and drunk there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:16.4", "PA_tha-ap_430:17.1"], "en": "I dwell among the Thirty-three for three hundred times.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:17.2"], "en": "I exercised the sovereignty of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:17.3"], "en": "and five hundred times,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:17.4"], "en": "I was a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:17.5"], "en": "A vast regional sovereignty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:17.6"], "en": "beyond counting and incalculable;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:18.1"], "en": "wandering through various states of existence, I attained it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:18.2"], "en": "I obtain immeasurable wealth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:18.3"], "en": "there is no deficiency in my enjoyments—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:18.4"], "en": "this is the fruit of the new crop.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:19.1"], "en": "Elephant-vehicles, horse-vehicles,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:19.2"], "en": "palanquins, and chariots—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:19.3"], "en": "I receive all of these indeed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:19.4"], "en": "This is the fruit of new crops:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:20.1"], "en": "new cloth, new fruit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:20.2"], "en": "and food of the finest flavors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:20.3"], "en": "I obtain all of this;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:20.4"], "en": "it is the fruit of this new crop.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:21.1"], "en": "Silken garments and woolen blankets—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:21.2"], "en": "And linen and cotton cloths—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:21.3"], "en": "I obtain all of this;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:21.4"], "en": "it is the fruit of this new crop.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:22.1"], "en": "A multitude of female slaves, a multitude of male slaves,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:22.2"], "en": "and women adorned with ornaments—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:22.3"], "en": "I obtain all of this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:22.4"], "en": "This is the fruit of new crops.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:23.1"], "en": "Neither cold nor heat affects me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:23.2"], "en": "and no feverish distress exists.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:23.3", "PA_tha-ap_430:23.4"], "en": "Furthermore, no mental suffering exists within my heart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:24.1"], "en": "Eat this; enjoy this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:24.2"], "en": "Lying upon this bed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:24.3"], "en": "I obtain all of this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:24.4"], "en": "it is the fruit of this new crop.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:25.1"], "en": "This is now my last,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:25.2"], "en": "my final existence is unfolding;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:25.3"], "en": "even today, there is still a gift to be given by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:25.4"], "en": "He always delighted [the Sangha] with the fruit [of his merit].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:26.1"], "en": "Having given fresh grain to the Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:26.2"], "en": "the most excellent of assemblies;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:26.3", "PA_tha-ap_430:26.4"], "en": "I experience eight benefits that are appropriate for my deeds:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:27.1"], "en": "I am handsome and possessed of fame.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:27.2"], "en": "I am one of great wealth and free from calamity;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:27.3", "PA_tha-ap_430:27.4"], "en": "I always have a great following and my assembly is forever indivisible.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:28.1", "PA_tha-ap_430:28.2"], "en": "All those who dwell upon the earth honor me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:28.3"], "en": "as do all things that may be given as gifts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:28.4"], "en": "\"Pure indeed, pure indeed do I obtain [this],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:29.1", "PA_tha-ap_430:29.2"], "en": "whether in the midst of the Saṅgha of bhikkhus or in the presence of the Buddha, the Best.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:29.3"], "en": "Having surpassed all others,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:29.4"], "en": "the donors give to me alone;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:30.1"], "en": "for this is the first new crop.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:30.2"], "en": "Having given to the Saṅgha, the supreme assembly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:30.3"], "en": "I experience these benefits:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:30.4"], "en": "this is the fruit of new grain.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:31.1"], "en": "In a hundred thousand aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:31.2"], "en": "because of the gift I gave then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:31.3"], "en": "I have never known a miserable rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:31.4"], "en": "This is the fruit of new crops;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:32.1", "PA_tha-ap_430:32.2"], "en": "the defilements have been burnt away by me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:32.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:33.1", "PA_tha-ap_430:33.2"], "en": "Welcome indeed has come to me... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:33.3"], "en": "This is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:34.1", "PA_tha-ap_430:34.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:34.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:35.1"], "en": "In this way, it is said, the venerable elder Sucintita spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_430:36.1"], "en": "This is the eighth legend (apadāna) of the elder Sucintita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
