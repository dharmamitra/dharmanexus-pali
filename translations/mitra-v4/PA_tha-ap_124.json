[
{"segs": ["PA_tha-ap_124:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:0.2"], "en": "Sereyyavagga, 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:0.3"], "en": "The Apadāna of the Elder Pupphathūpiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:1.1", "PA_tha-ap_124:1.2"], "en": "Not far from the Himālaya is a mountain named Kukkura;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:1.3"], "en": "in its midst he dwells.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:1.4"], "en": "A brahmin who has mastered the mantras,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:2.1", "PA_tha-ap_124:2.2"], "en": "five thousand disciples always attend upon me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:2.3", "PA_tha-ap_124:2.4"], "en": "They were early risers and proficient in the mantras;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:3.1"], "en": "then the Buddha appeared in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:3.2"], "en": "Know him as such, sir:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:3.3", "PA_tha-ap_124:3.4"], "en": "he possesses eighty minor marks and thirty-two major characteristics.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:4.1"], "en": "The supreme Victor, with the radiance of his aura,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:4.2"], "en": "shines like the sun;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:4.3"], "en": "having heard the words of his disciples, he spoke.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:4.4"], "en": "The brahmin, who had mastered the mantras,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:5.1"], "en": "having gone forth from the ashram,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:5.2"], "en": "asked his disciples about the directions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:5.3"], "en": "In whichever direction the Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:5.4"], "en": "the Leader of the World, dwells,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:6.1"], "en": "that direction I shall revere.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:6.2"], "en": "The Jina, the peerless one;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:6.3"], "en": "with an uplifted heart and a joyful mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:6.4"], "en": "I worshipped that Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:7.1"], "en": "Come, disciples, we shall go;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:7.2"], "en": "we shall see the Tathāgata;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:7.3"], "en": "having paid homage at the feet of the Teacher, we shall depart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:7.4"], "en": "We shall hear the teaching of the Jina.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:8.1"], "en": "Having gone forth for a single day,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:8.2"], "en": "I contracted a disease.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:8.3"], "en": "Being afflicted by disease,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:8.4"], "en": "I went to dwell in a sal tree;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:9.1"], "en": "having gathered all my disciples together, I said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:9.2", "PA_tha-ap_124:9.3", "PA_tha-ap_124:9.4"], "en": "I asked the Tathāgata about the nature of the qualities of the Supreme Buddha, the Lord of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:10.1", "PA_tha-ap_124:10.2"], "en": "When questioned by me, they answered just as those who see clearly would;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:10.3"], "en": "I have honored that Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:10.4"], "en": "They taught me in my presence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:11.1"], "en": "Having heard their words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:11.2"], "en": "I gladdened my own heart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:11.3"], "en": "Having constructed a stupa with flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:11.4"], "en": "I passed away there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:12.1"], "en": "They cremated my body, and...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:12.2"], "en": "They went into the presence of the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:12.3"], "en": "having raised their joined palms in reverence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:12.4"], "en": "they paid homage to the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:13.1", "PA_tha-ap_124:13.2"], "en": "Having fashioned a stupa for the Sugata, the Great Seer, with flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:13.3"], "en": "for a hundred thousand eons—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:13.4"], "en": "I did not fall into an evil rebirth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:14.1"], "en": "During forty thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:14.2"], "en": "there were sixteen kṣatriyas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:14.3", "PA_tha-ap_124:14.4"], "en": "There were wheel-turning monarchs of great power named Nāmenaggi and Samā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:15.1"], "en": "twenty thousand eons ago.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:15.2", "PA_tha-ap_124:15.3"], "en": "There were thirty-eight wheel-turning monarchs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:15.4"], "en": "all bearing the name Ghaṭāsana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:16.1", "PA_tha-ap_124:16.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:16.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:17.1"], "en": "Thus indeed the venerable elder Pupphathūpiya spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_124:18.1"], "en": "This is the second *apadāna* of the elder Pupphathūpiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
