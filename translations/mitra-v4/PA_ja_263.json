[
{"segs": ["PA_ja_263:0.1"], "en": "Jātaka Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:0.2", "PA_ja_263:0.3"], "en": "Padumavagga (The Chapter on the Lotus)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:0.4"], "en": "3. The Cūḷapalobhanajātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:1.1", "PA_ja_263:1.2"], "en": "“Having come of my own accord by means of psychic power to where the water was not overflowing;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:1.3"], "en": "Having approached a woman who has cultivated the female nature,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:1.4"], "en": "you sink away into the great ocean.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:2.1"], "en": "Mahāmāyā is a whirlpool.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:2.2"], "en": "It is a corruption of the holy life;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:2.3"], "en": "knowing this, they sink down,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:2.4"], "en": "so one should avoid it from afar.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:3.1"], "en": "Whomever they serve,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:3.2"], "en": "whether through desire or with wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:3.3"], "en": "him Fire-like (Jātavedas) consumes. His station—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:3.4"], "en": "\"They quickly burn him up.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_263:4.1"], "en": "Thus ends the third Jātaka, the Cūḷapalobhana-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
