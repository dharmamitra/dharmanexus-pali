[
{"segs": ["PA_ja_261:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:0.2", "PA_ja_261:0.3"], "en": "Tikanipāta, Padumavagga (The Chapter on the Lotus)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:0.4"], "en": "1. The Paduma Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:1.1", "PA_ja_261:1.2"], "en": "\"Just as the hair of the head and the beard grow back again and again whenever they are cut off,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:1.3"], "en": "\"May your nose grow back in this way;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:1.4"], "en": "give me the lotus as I have requested.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:2.1"], "en": "\"Just as an autumn seed...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:2.2"], "en": "What is sown in a field grows;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:2.3"], "en": "so may your nose grow,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:2.4"], "en": "as you have been asked for this lotus.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:3.1"], "en": "“Both of them are merely prattling;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:3.2"], "en": "they might even show you lotuses.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:3.3"], "en": "Whether there is a fault in them or not, it does not matter.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:3.4"], "en": "\"There is no growing of a nose;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:3.5"], "en": "give me the lotuses, my dear,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:3.6"], "en": "for I have been asked by one who asks.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_261:4.1"], "en": "The Paduma Jātaka is first.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
