[
{"segs": ["PA_thag_1.80:0.1", "PA_thag_1.80:0.2", "PA_thag_1.80:0.3"], "en": "Theragāthā 1.80 Ekakanipāta Aṭṭhamavagga (The Eighth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:0.4"], "en": "The Verse of the Elder Uggata:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:1.1"], "en": "“Whatever karma has been performed by me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:1.2"], "en": "whether little or much;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:1.3"], "en": "“All this has been completely exhausted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:1.4"], "en": "now there is no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:1.5"], "en": "… The Elder Ugga …", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:1.6"], "en": "The eighth chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:2.0"], "en": "Its summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:2.1"], "en": "And the Elder Vacchapāla...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:2.2"], "en": "The young brahmin Ātuma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:2.3"], "en": "the seer Suyāma, Susārada,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:2.4"], "en": "and the elder Piyañjahā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:2.5"], "en": "Ārohaputta, Meṇḍasīra,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.80:2.6"], "en": "Rakkhita, and Uggasavhaya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
