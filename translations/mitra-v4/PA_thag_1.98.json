[
{"segs": ["PA_thag_1.98:0.1", "PA_thag_1.98:0.2", "PA_thag_1.98:0.3"], "en": "Theragāthā 1.98 Ekakanipāta Dasamavagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.98:0.4"], "en": "Abhayattheragāthā:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.98:1.1", "PA_thag_1.98:1.2"], "en": "“Having seen a form, mindfulness was lost by one who attends to a pleasing sign;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.98:1.3"], "en": "With a mind full of lust he experiences it,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.98:1.4"], "en": "and he persists by adhering to it;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.98:1.5"], "en": "for him, the taints increase.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.98:1.6"], "en": "“Those who go toward the root of existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.98:1.7"], "en": "… Thus spoke the Elder Abhaya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
