[
{"segs": ["PA_thig_6.7:0.1", "PA_thig_6.7:0.2"], "en": "Therīgāthā 6.7 Chakkanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:0.3"], "en": "The Verses of the Elder Nun Guttā", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:1.1"], "en": "“Son, for what purpose you have gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:1.2"], "en": "having abandoned your son and dear wealth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:1.3"], "en": "cultivate that very purpose.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:1.4"], "en": "Do not fall under the power of the mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:2.1"], "en": "Deceived by the mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:2.2"], "en": "beings delight in the domain of Māra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:2.3", "PA_thig_6.7:2.4"], "en": "The ignorant run on through the saṃsāra of many births;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:3.1"], "en": "sensual desire and ill will—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:3.2"], "en": "Personal-existence view,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:3.3"], "en": "adherence to rules and observances,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:3.4"], "en": "and doubt as the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:4.1", "PA_thig_6.7:4.2", "PA_thig_6.7:4.3"], "en": "Having abandoned these fetters that lead to the lower realms, the bhikkhunī—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:4.4"], "en": "You shall not come here again,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:5.1", "PA_thig_6.7:5.2"], "en": "having abandoned passion, conceit, ignorance, and restlessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:5.3"], "en": "Having severed the fetters,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:5.4"], "en": "you will make an end of suffering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:6.1"], "en": "having exhausted the cycle of birth, you will reach the goal.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:6.2"], "en": "Having fully understood renewed existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:6.3", "PA_thig_6.7:6.4"], "en": "one will wander, free from craving and stilled, in this very life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.7:7.1"], "en": "… The Elder Nun Guttā …", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"}
]
