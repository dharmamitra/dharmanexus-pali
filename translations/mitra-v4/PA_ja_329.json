[
{"segs": ["PA_ja_329:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:0.2"], "en": "The Collection of Fours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:0.3"], "en": "Chapter on the House-Spoiler (Kuṭidūsakavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:0.4", "PA_ja_329:1.1"], "en": "9. The Kāḷabāhu Jātaka “That food and drink which we formerly received,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:1.2"], "en": "now goes only as far as the branches of the trees.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:1.3"], "en": "“Come now, Rādha, let us go to the forest;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:1.4"], "en": "we have not been honored by Dhanañjaya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:2.1"], "en": "“Gain and loss, fame and disrepute,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:2.2", "PA_ja_329:2.3"], "en": "Censure and praise, pleasure and pain—these conditions among humans are impermanent.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:2.4"], "en": "Do not grieve; why do you grieve, Poṭṭhapāda?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:3.1"], "en": "“Truly you are wise, Rādha;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:3.2"], "en": "you know matters yet to come.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:3.3"], "en": "How indeed shall we see the monkey?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:3.4"], "en": "“Like common folk driven out from a royal palace.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:4.1"], "en": "“He winks his ear and frowns his brow;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:4.2"], "en": "again and again he strikes fear into the princes.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:4.3", "PA_ja_329:4.4"], "en": "\"Kāḷabāhu, he himself shall do that by which he will remain in the hells, deprived of food and drink.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_329:5.1"], "en": "Thus ends the ninth Jātaka, the Kāḷabāhu Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
