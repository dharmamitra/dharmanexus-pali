[
{"segs": ["PA_tha-ap_230:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:0.2"], "en": "Ālambaṇadāyakavagga 8.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:0.3"], "en": "The Apadāna of the Elder Miñjavaṭaṁsakiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:1.1", "PA_tha-ap_230:1.2"], "en": "“When Sikhī, the best of speakers, the Protector of the World, had entered Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:1.3"], "en": "[the sky] was strewn with ear-ornaments.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:1.4"], "en": "I performed an offering for enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:2.1", "PA_tha-ap_230:2.2"], "en": "That offering which I made then, in the thirty-first aeon from now;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:2.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:2.4"], "en": "this is the fruit of worshipping the Bodhi tree.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:3.1"], "en": "Twenty-six aeons from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:3.2"], "en": "I was named Meghabbha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:3.3"], "en": "endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:3.4"], "en": "I was a wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:4.1", "PA_tha-ap_230:4.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:4.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:5.1"], "en": "Thus indeed did the Venerable Elder Miñjavaṭaṁsakiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_230:6.1"], "en": "This is the eighth legend of the Elder Miñjavaṭaṁsakiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
