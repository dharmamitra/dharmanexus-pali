[
{"segs": ["PA_vv_29:0.1"], "en": "Vimānavatthu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:0.2", "PA_vv_29:0.3"], "en": "The Chapter on the Pāricchattaka Tree, from the Itthivimāna (The Female Vimānas) section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:0.4", "PA_vv_29:1.1"], "en": "1. The Story of the Exalted Mansion Exalted is your fame and splendor;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:1.2"], "en": "all directions are illuminated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:1.3"], "en": "Women dance and sing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:1.4", "PA_vv_29:2.1"], "en": "and adorned sons of the gods rejoice and attend upon them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:2.2"], "en": "For your worship, O goddess,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:2.3", "PA_vv_29:2.4"], "en": "these golden celestial mansions are yours, O Sudassanā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:3.1"], "en": "You are the mistress of them all,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:3.2"], "en": "with every desire fulfilled;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:3.3"], "en": "you are of noble birth and great.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:3.4"], "en": "\"You rejoice in the company of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:3.5"], "en": "O deity, being questioned, tell me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:3.6"], "en": "of what karma is this the fruit?\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:4.1", "PA_vv_29:4.2"], "en": "“In a former birth, when I was among humans in the human world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:4.3"], "en": "I was a daughter-in-law in a family of immoral people.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:4.4"], "en": "Among those who lack faith and are miserly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:5.1", "PA_vv_29:5.2"], "en": "I am always endowed with faith and virtue, and delight in sharing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:5.3"], "en": "As you were wandering for alms,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:5.4"], "en": "I gave you a cake;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:6.1"], "en": "at that time, I informed my mother-in-law.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:6.2"], "en": "\"A monk has come here;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:6.3", "PA_vv_29:6.4"], "en": "with my own hands, full of faith, I gave him a cake.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:7.1"], "en": "Her mother-in-law reproached her:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:7.2"], "en": "\"You are undisciplined, daughter-in-law;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:7.3"], "en": "you did not wish to inquire after me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:7.4"], "en": "\"I am giving [this] to the ascetic.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:8.1", "PA_vv_29:8.2"], "en": "Thereupon my mother-in-law became angry and struck me with a pestle.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:8.3"], "en": "\"Kūṭaṅgacchi was my limit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:8.4"], "en": "I could not live much longer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:9.1"], "en": "Now, with the breakup of the body,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:9.2"], "en": "Completely liberated, having passed away from there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:9.3", "PA_vv_29:9.4"], "en": "they were reborn in companionship with the Tāvatiṃsa devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:10.1", "PA_vv_29:10.2"], "en": "\"Because of that, my complexion is such as this...", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:10.3"], "en": "and my complexion shines forth in all directions.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_29:11.1"], "en": "The Uḷāravimāna is first.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"}
]
