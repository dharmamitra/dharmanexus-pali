[
{"segs": ["PA_iti_77:0.1"], "en": "Itivuttaka 77:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_77:0.2", "PA_iti_77:0.3"], "en": "Tikanipāta, Tatiyavagga (The Third Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_77:0.4"], "en": "The Bhidura Sutta:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_77:1.1"], "en": "\"This was said by the Blessed One, said by the Arahant, so I have heard:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_77:2.1"], "en": "'Monks, this body is fragile; consciousness is subject to fading away; all acquisitions (upadhi) are impermanent, suffering, and subject to change.'\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_77:2.2"], "en": "The Blessed One spoke this matter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_77:2.3"], "en": "Regarding this, it is said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_77:3.1"], "en": "“Having understood that the body is fragile, ...”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_77:3.2"], "en": "And through the fading away of consciousness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_77:3.3"], "en": "seeing danger in the acquisitions,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_77:3.4"], "en": "he has transcended birth and death.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_77:3.5", "PA_iti_77:3.6"], "en": "“Having attained supreme peace, the one whose self is cultivated awaits his time.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_77:4.1"], "en": "This meaning too was spoken by the Blessed One; thus have I heard.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_iti_77:4.2"], "en": "The eighth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
