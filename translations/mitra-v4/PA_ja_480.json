[
{"segs": ["PA_ja_480:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:0.2"], "en": "Thirteen-Book Collection,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:0.3"], "en": "Amba Chapter", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:0.4"], "en": "7. The Akitti Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:1.1", "PA_ja_480:1.2"], "en": "“Having seen the noble Akitti, Sakka, the Lord of Beings, spoke:”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:1.3", "PA_ja_480:1.4"], "en": "“Great Brahmā, longing for what do you meditate alone in the heat?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:2.1"], "en": "“Rebirth is suffering, Sakka.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:2.2"], "en": "And the breaking up of the body;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:2.3"], "en": "death in confusion is suffering—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:2.4"], "en": "therefore, Vāsava, I pay you homage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:3.1", "PA_ja_480:3.2"], "en": "“Since you have spoken so well and so appropriately,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:3.3"], "en": "Kassapa, I grant you a boon.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:3.4"], "en": "\"Whatever you desire in your mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:4.1"], "en": "\"If you would grant me a boon, O Sakka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:4.2"], "en": "Lord of all beings,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:4.3", "PA_ja_480:4.4", "PA_ja_480:4.5"], "en": "Those people who, having obtained children, wives, wealth, grain, and beloved things, are not satisfied—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:4.6"], "en": "“Thus greed shall not hold sway over me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:5.1"], "en": "“For this well-spoken word of yours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:5.2"], "en": "so fitting and well-articulated;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:5.3"], "en": "“I grant you a boon, Kassapa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:5.4"], "en": "whatever you desire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:6.1"], "en": "“If you would grant me a boon, Sakka,”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:6.2"], "en": "Lord of all beings;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:6.3"], "en": "fields, lands, gold,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:6.4"], "en": "cattle, horses, slaves, and servants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:6.5"], "en": "“That fault by whose birth people are overcome does not dwell within me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:6.6", "PA_ja_480:7.1"], "en": "“Since you have spoken so well on this matter,” [the King said:]", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:7.2", "PA_ja_480:7.3"], "en": "“O Kassapa, you have spoken appropriately and well;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:7.4"], "en": "I grant you whatever boon you desire.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:8.1"], "en": "“If you would grant me a boon, O Sakka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:8.2"], "en": "Lord of all beings:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:8.3"], "en": "may I neither see nor hear a fool.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:8.4"], "en": "One should not dwell with a fool;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:8.5", "PA_ja_480:8.6"], "en": "one should neither engage in conversation or discourse with a fool, nor take pleasure in it.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:9.1"], "en": "“What has this fool done to you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:9.2", "PA_ja_480:9.3"], "en": "Tell me the reason, Kassapa. For what reason, Kassapa, did you strike this fool?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:9.4"], "en": "“He does not desire insight.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:10.1"], "en": "“The fool is led astray by misfortune;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:10.2"], "en": "he yokes himself to what is burdensome.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:10.3"], "en": "One who is difficult to instruct becomes worse;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:10.4"], "en": "when spoken to rightly, he becomes agitated;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:10.5"], "en": "such a person does not understand discipline.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:10.6"], "en": "“It is well that he is not seen.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:11.1"], "en": "“Since you have spoken thus so skillfully,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:11.2"], "en": "appropriately, and well-uttered;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:11.3"], "en": "“I grant you a boon, Kassapa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:11.4"], "en": "whatever you desire.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:12.1"], "en": "“If you will grant me a boon, Sakka,” [Kassapa said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:12.2"], "en": "The Lord of all beings:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:12.3"], "en": "see the wise one, hear the wise one,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:12.4"], "en": "and dwell together with the wise one.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:12.5", "PA_ja_480:12.6"], "en": "“The wise one engages in conversation with you and finds it pleasing.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:13.1"], "en": "“What has that wise one done for you?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:13.2"], "en": "“Tell me the reason, Kassapa: for what reason,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:13.3", "PA_ja_480:13.4"], "en": "Kassapa, do you long for the vision of the Wise One?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:14.1"], "en": "“The wise man does not lead by this way;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:14.2"], "en": "he does not yoke himself to a heavy burden.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:14.3"], "en": "A good way is better.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:14.4"], "en": "One who speaks rightly does not become angry;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:14.5"], "en": "he understands the Discipline—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:14.6"], "en": "meeting with such a person is excellent.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:15.1"], "en": "“Since you have spoken so well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:15.2", "PA_ja_480:15.3"], "en": "Kassapa, with words that are fitting and well-said, I grant you a boon.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:15.4"], "en": "“Whatever you desire in your mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:16.1"], "en": "“If you would grant me a boon, Sakka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:16.2"], "en": "Lord of all beings;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:16.3"], "en": "Then, at the end of the night,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:16.4"], "en": "toward the rising of the sun,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:16.5"], "en": "divine foods would appear.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:16.6"], "en": "May there be virtuous supplicants;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:17.1"], "en": "may my giving never be exhausted,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:17.2"], "en": "and having given, may I have no regret.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:17.3"], "en": "“May I give with a serene mind;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:17.4"], "en": "this, Sakka, is the boon I choose.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:18.1"], "en": "“When you have so well spoken these words, [I grant it].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:18.2"], "en": "“Worthy and well-spoken,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:18.3"], "en": "Kassapa! I grant you a boon,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:18.4"], "en": "whatever you desire in your mind.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:19.1"], "en": "“If you would grant me a boon, O Sakka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:19.2"], "en": "Lord of all beings,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:19.3"], "en": "do not come to me again.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:19.4"], "en": "“Sakka, choose this boon.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:20.1"], "en": "“By means of many practices of austerity,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:20.2"], "en": "both men and women— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:20.3"], "en": "“They long to see you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:20.4"], "en": "what fear could there be for me in seeing you?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:21.1"], "en": "“Such as you are, with the form of a god—”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:21.2"], "en": "\"Having seen the success of all desires,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:21.3", "PA_ja_480:21.4"], "en": "one might neglect asceticism; this is the danger in seeing you.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_480:22.1"], "en": "The Akitti Jātaka is the seventh.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
