[
{"segs": ["PA_tha-ap_309:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:0.2", "PA_tha-ap_309:0.3"], "en": "The Chapter on the Lotus Filaments (Padumakesaravagga) 7. The Legend of the Elder Ārāmadāyaka (The Giver of a Grove)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:1.1", "PA_tha-ap_309:1.2"], "en": "“A grove was planted by me for the Blessed One Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:1.3"], "en": "amidst trees providing dense shade.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:1.4"], "en": "While the birds were waiting upon him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:2.1"], "en": "I saw the stainless Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:2.2"], "en": "the recipient of offerings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:2.3", "PA_tha-ap_309:2.4"], "en": "I directed [the gift] toward the grove for the World’s Eldest, the Bull among Men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:3.1"], "en": "joyful with a joyful heart, I offered it.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:3.2"], "en": "I gave him a flower as a fruit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:3.3"], "en": "then, having conceived faith,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:3.4"], "en": "I dedicated that grove to him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:4.1", "PA_tha-ap_309:4.2"], "en": "Because I gave this gift to the Buddha with a serene mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:4.3"], "en": "as I was being reborn into existence, [I attained this result].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:4.4"], "en": "The fruit is born for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:5.1"], "en": "From ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:5.2"], "en": "that gift of a monastery which I gave then—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:5.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:5.4"], "en": "this is the fruit of the grove.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:6.1"], "en": "In the thirty-seventh aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:6.2"], "en": "They were gentle and cool in their nature;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:6.3"], "en": "endowed with the seven treasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:6.4"], "en": "they were wheel-turning monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:7.1", "PA_tha-ap_309:7.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:7.3"], "en": "[and so forth] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:8.1"], "en": "Thus indeed the venerable elder Ārāmadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_309:9.1"], "en": "This is the seventh legend of the elder Ārāmadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
