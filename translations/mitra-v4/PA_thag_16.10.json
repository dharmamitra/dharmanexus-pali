[
{"segs": ["PA_thag_16.10:0.1", "PA_thag_16.10:0.2", "PA_thag_16.10:0.3"], "en": "Theragāthā 16.10 Vīsatinipāta Paṭhamavagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:0.4", "PA_thag_16.10:1.1", "PA_thag_16.10:1.2"], "en": "A thought arose in the recluse when the great forest was in full bloom:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:1.3"], "en": "To one who is seated alone,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:1.4"], "en": "secluded, and meditating:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:2.1"], "en": "\"Otherwise, regarding the Lord of the World...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:2.2"], "en": "While the Supreme among Men remained present,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:2.3"], "en": "the conduct of the bhikkhus was one way;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:2.4"], "en": "now it is seen to be otherwise.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:3.1"], "en": "It is a protection against cold winds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:3.2"], "en": "a covering for the modesty of the body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:3.3"], "en": "and they ate only as much as was sufficient to sustain them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:3.4"], "en": "Content with whatever they receive—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:4.1"], "en": "whether excellent or coarse,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:4.2"], "en": "whether little or much—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:4.3"], "en": "They ate for the sake of sustenance,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:4.4"], "en": "without greed and without attachment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:5.1"], "en": "regarding the requisites of life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:5.2", "PA_thag_16.10:5.3", "PA_thag_16.10:5.4"], "en": "They were not intensely eager for medicine or requisites as they were for the destruction of the taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:6.1", "PA_thag_16.10:6.2"], "en": "In forests, at the roots of trees, in gorges, and in caves,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:6.3"], "en": "cultivating solitude, they dwell.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:6.4"], "en": "They lived with that as their ultimate goal:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:7.1"], "en": "humble, settled, easy to support,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:7.2"], "en": "gentle, and without arrogance of mind.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:7.3"], "en": "Unstained, not talkative,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:7.4"], "en": "thoughtful of others' welfare, and obedient;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:8.1"], "en": "because of that, he was pleasing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:8.2"], "en": "Whatever was gone through, eaten,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:8.3", "PA_thag_16.10:8.4"], "en": "or consumed, his posture became as smooth as a stream of oil.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:9.1"], "en": "With all taints utterly destroyed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:9.2"], "en": "great meditators and great benefactors,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:9.3"], "en": "those elders have now attained final peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:9.4"], "en": "Now those [qualities] are but meager;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:10.1", "PA_thag_16.10:10.2"], "en": "through the exhaustion of wholesome states and of wisdom, they have perished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:10.3"], "en": "Endowed with the excellence of all modes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:10.4", "PA_thag_16.10:11.1"], "en": "this teaching of the Conqueror is being destroyed by evil states.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:11.2"], "en": "The heat of the defilements,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:11.3"], "en": "those established in seclusion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:11.4"], "en": "and those who remain as the remnants of the true Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:12.1"], "en": "Those defilements, increasing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:12.2"], "en": "invade many people;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:12.3"], "en": "they seem to sport with fools.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:12.4"], "en": "Like demons among their own kin,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:13.1", "PA_thag_16.10:13.2"], "en": "they are overcome by defilements and run hither and thither.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:13.3", "PA_thag_16.10:13.4"], "en": "Men who have heard the proclamation regarding the bases of the defilements,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:14.1"], "en": "having abandoned the true Dhamma, remain full of attachment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:14.2"], "en": "They quarrel with one another,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:14.3"], "en": "pursuing various speculative views and imagining,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:14.4"], "en": "\"This is superior.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:15.1"], "en": "Having abandoned wealth, children, and wife,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:15.2", "PA_thag_16.10:15.3"], "en": "they have gone forth even for the sake of alms in a bowl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:15.4"], "en": "They practice what is difficult to do:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:16.1"], "en": "having eaten until their bellies are full,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:16.2"], "en": "they lie down on their backs to sleep.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:16.3", "PA_thag_16.10:16.4"], "en": "How do those who have awakened conduct themselves regarding speech that censures the Teacher?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:17.1"], "en": "[They avoid] all crafts and skills.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:17.2"], "en": "Having made an effort, one trains;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:17.3"], "en": "as long as one is not inwardly calmed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:17.4"], "en": "one does not attain the goal of recluseship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:18.1"], "en": "They offer clay, oil,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:18.2"], "en": "powder, water, a seat,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:18.3"], "en": "and food to householders.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:18.4"], "en": "Desiring much more:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:19.1"], "en": "tooth-sticks, wood-apples,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:19.2"], "en": "flowers, and various kinds of food.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:19.3"], "en": "When alms-food has been obtained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:19.4"], "en": "as well as mangoes and myrobalans;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:20.1"], "en": "just as physicians [prescribe] among medicines, so [should one act].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:20.2"], "en": "Like householders in their duties and non-duties,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:20.3"], "en": "like courtesans in their adornment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:20.4"], "en": "and like noble warriors in their sovereignty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:21.1"], "en": "Deceitful and fraudulent,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:21.2"], "en": "a false witness and untruthful;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:21.3"], "en": "by means of many stratagems—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:21.4"], "en": "They consume material food;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:22.1", "PA_thag_16.10:22.2"], "en": "they run about, occupied with the practice of grooming and personal adornment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:22.3"], "en": "Seeking a livelihood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:22.4"], "en": "they accumulate great wealth by crafty means;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:23.1"], "en": "they gather a following around themselves.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:23.2", "PA_thag_16.10:23.3", "PA_thag_16.10:23.4"], "en": "They teach the Dhamma to others for the sake of material gain and not for the sake of the goal; they act out of worldly motives and not from the standpoint of the Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:24.1"], "en": "They quarrel over gains belonging to the Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:24.2"], "en": "being excluded from the Saṅgha itself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:24.3"], "en": "yet subsisting on the gains of others.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:24.4"], "en": "Those who lack a sense of shame feel no remorse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:25.1"], "en": "Likewise, some are not devoted [to the training],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:25.2"], "en": "though they are shaven-headed and clad in the saṅghāṭī robe.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:25.3"], "en": "Intoxicated by gain and honor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:25.4"], "en": "they desire only esteem;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:26.1"], "en": "thus it is when things have gone astray in various ways.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:26.2"], "en": "Now it is no longer easy in that way:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:26.3"], "en": "to attain what has not been attained,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:26.4"], "en": "or to preserve what has been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:27.1", "PA_thag_16.10:27.2"], "en": "Just as one would walk barefoot in a place full of thorns,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:27.3"], "en": "having established mindfulness, so should one live.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:27.4"], "en": "Thus should a sage conduct himself in the village.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:28.1"], "en": "Having remembered the ancient yogis,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:28.2"], "en": "he should follow their practice.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:28.3"], "en": "\"Even if it be the last hour,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:28.4"], "en": "one may touch the deathless state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:29.1"], "en": "Having said this in the Sāla grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:29.2"], "en": "The ascetic with developed faculties,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:29.3"], "en": "the brahmin who has attained final Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:29.4"], "en": "the seer whose renewed existence is exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:29.5", "PA_thag_16.10:29.6"], "en": "… The Elder Pārāpariya … The Vīsatinipāta is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:30.0"], "en": "Herein is the summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:30.1"], "en": "Adhimutta, Pārāpariya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:30.2"], "en": "Telakāni, Raṭṭhapāla,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:30.3"], "en": "Māluṅkyasela, and Bhaddiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:30.4"], "en": "Aṅgulimāla, Dibbacakkhu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:30.5", "PA_thag_16.10:30.6"], "en": "and Pārāpariya— these ten are proclaimed among the twenty.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_16.10:30.7", "PA_thag_16.10:30.8"], "en": "There are two hundred and forty-five verses in total.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
