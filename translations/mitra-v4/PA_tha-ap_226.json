[
{"segs": ["PA_tha-ap_226:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:0.2"], "en": "The Chapter on the Giver of a Support (Ālambaṇadāyakavagga) 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:0.3"], "en": "The Legend of the Elder Ārakkhadāyaka (The Giver of Protection)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:1.1"], "en": "“For the Blessed One Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:1.2"], "en": "an altar was caused to be made by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:1.3"], "en": "and protection was granted by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:1.4"], "en": "Of the Sugata, the Great Seer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:2.1"], "en": "By virtue of that distinguished karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:2.2"], "en": "I saw no fear or terror.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:2.3"], "en": "For one reborn anywhere,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:2.4"], "en": "no fear exists for me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:3.1"], "en": "Since ninety-four eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:3.2"], "en": "The altar that I had constructed in the past—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:3.3"], "en": "I do not know a state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:3.4"], "en": "this is the fruit of that railing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:4.1", "PA_tha-ap_226:4.2"], "en": "In this sixth aeon, one named Apassena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:4.3"], "en": "endowed with the seven treasures, [will appear].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:4.4"], "en": "A wheel-turning monarch of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:5.1", "PA_tha-ap_226:5.2"], "en": "The four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:5.3"], "en": "\"Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:6.1"], "en": "In this way, the Venerable Ārakkhadāyaka Thera indeed spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_226:7.1"], "en": "This is the fourth legend of the Elder Ārakkhadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
