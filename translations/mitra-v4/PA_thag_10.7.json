[
{"segs": ["PA_thag_10.7:0.1", "PA_thag_10.7:0.2", "PA_thag_10.7:0.3"], "en": "Theragāthā 10.7 Daśaka-nipāta Paṭhama-vagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:0.4"], "en": "(Apara) Gotama Thera’s Verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:1.1"], "en": "“One should understand one’s own welfare;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:1.2"], "en": "one should look back upon the ancient word.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:1.3", "PA_thag_10.7:1.4"], "en": "And whatever here is fitting for one who has entered upon the life of a recluse—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:2.1"], "en": "a friend who is virtuous in this world—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:2.2", "PA_thag_10.7:2.3"], "en": "The extensive undertaking of the training and the desire to listen to one's teachers—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:2.4"], "en": "this is fitting for a recluse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:3.1"], "en": "Reverence for the Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:3.2"], "en": "honoring the Dhamma as it truly is,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:3.3"], "en": "and esteem for the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:3.4"], "en": "This is fitting for a recluse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:4.1"], "en": "devoted to proper conduct and range of activity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:4.2"], "en": "his livelihood is purified and beyond reproach.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:4.3"], "en": "And the settling of the mind—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:4.4"], "en": "this is fitting for a recluse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:5.1"], "en": "right conduct and restraint.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:5.2"], "en": "Inspiring confidence in one's modes of conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:5.3"], "en": "and application to higher consciousness—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:5.4"], "en": "this is fitting for a recluse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:6.1"], "en": "Forest dwellings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:6.2"], "en": "remote and quiet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:6.3"], "en": "should be frequented by a sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:6.4"], "en": "This is appropriate for a recluse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:7.1"], "en": "virtue, great learning,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:7.2"], "en": "and the investigation of phenomena as they truly are.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:7.3"], "en": "The realization of the truths—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:7.4"], "en": "this is fitting for a recluse—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:8.1"], "en": "and one should cultivate [the perception] that \"it is impermanent.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:8.2"], "en": "The perception of non-self and the perception of foulness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:8.3"], "en": "and disenchantment with the world—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:8.4"], "en": "this is fitting for a recluse.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:9.1"], "en": "One should cultivate the factors of enlightenment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:9.2"], "en": "the bases of psychic power, the faculties, and the powers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:9.3"], "en": "and the noble eightfold path.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:9.4"], "en": "This is worthy of a recluse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:10.1", "PA_thag_10.7:10.2"], "en": "the sage should abandon craving and shatter the taints along with their roots.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:10.3"], "en": "“One should dwell liberated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:10.4", "PA_thag_10.7:10.5"], "en": "this is fitting for a recluse. … Thus spoke the Elder Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:10.6"], "en": "The Tenth Chapter is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:11.0"], "en": "Herein is the summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:11.1"], "en": "And that elder Kāḷudāyī...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:11.2"], "en": "And Kappina, who dwelt alone;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:11.3"], "en": "Cūḷapanthaka, Kappa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:11.4"], "en": "and Upasena the Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:11.5"], "en": "There are seven groups of ten elders,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_10.7:11.6"], "en": "and there are seventy-three verses here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
