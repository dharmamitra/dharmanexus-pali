[
{"segs": ["PA_tha-ap_313:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:0.2"], "en": "Ārakkhadāyakavagga 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:0.3"], "en": "The Apadāna of the Elder Ārakkhadāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:1.1", "PA_tha-ap_313:1.2"], "en": "“A fence was caused to be built by me for the sage Dhammadassi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:1.3"], "en": "and protection was provided by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:1.4"], "en": "Of the Lord of Men, the Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:2.1"], "en": "Eighteen hundred aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:2.2"], "en": "that deed which I performed then—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:2.3"], "en": "By that specific deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:2.4"], "en": "the destruction of the taints was attained by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:3.1"], "en": "the four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:3.2", "PA_tha-ap_313:3.3"], "en": "And these eight liberations have been realized; the six direct knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:3.4"], "en": "the Buddha’s teaching has been accomplished.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:4.1"], "en": "Thus indeed the venerable elder Ārakkhadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_313:5.1"], "en": "This is the first legend of the elder Ārakkhadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
