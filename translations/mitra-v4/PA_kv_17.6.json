[
{"segs": ["PA_kv_17.6:0.1", "PA_kv_17.6:0.2", "PA_kv_17.6:0.3"], "en": "Points of Controversy The Great Fifty-Section The Seventeenth Chapter", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:0.4"], "en": "The Discussion on Whether It Should Not Be Said That the Sangha Accepts an Offering:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:1.1", "PA_kv_17.6:1.2"], "en": "Should it not be said that \"the Sangha accepts an offering\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:1.3"], "en": "“Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:1.4"], "en": "“Is it not the case that the Saṅgha is worthy of offerings, worthy of hospitality, worthy of gifts, worthy of reverential salutation, and is an unsurpassed field of merit for the world?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:1.5"], "en": "“Yes.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:1.6"], "en": "If the Saṅgha is worthy of offerings, worthy of hospitality, worthy of gifts, worthy of reverential salutation, and is an unsurpassed field of merit for the world, then indeed, sir, you ought to say:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:1.7", "PA_kv_17.6:2.1"], "en": "“The Saṅgha accepts a gift. It should not be said [that it does not].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:2.2"], "en": "“Does the Saṅgha accept the offering?”—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:2.3"], "en": "“Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:2.4"], "en": "But has it not been stated by the Blessed One that there are four pairs of persons, eight individual persons, who are worthy of offerings?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:2.5"], "en": "“Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:2.6"], "en": "[The opponent asks: “If it is true that four pairs of persons, eight types of individuals, have been declared by the Blessed One to be worthy of offerings, then indeed, sir, it must be said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:2.7"], "en": "‘The Saṅgha accepts an offering.’”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.1", "PA_kv_17.6:3.2"], "en": "Is it not to be said that \"the Saṅgha accepts the offering\"?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.3"], "en": "Yes, it is.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.4"], "en": "Is it not the case that there are some who give gifts to the Saṅgha?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.5"], "en": "Yes, they do.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.6"], "en": "If indeed there are some who give gifts to the Saṅgha, then, indeed, O friend, you must say this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.7"], "en": "“The Saṅgha accepts the offering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.8", "PA_kv_17.6:3.9"], "en": "Is it not the case that there are some who give robes to the Saṅgha …pe… who give almsfood?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.10"], "en": "They provide lodgings;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.11"], "en": "they provide medicinal requisites for the sick;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.12"], "en": "they provide solid food.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.13"], "en": "\"Do they give solid food... and so on...", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.14"], "en": "do they give drinking water?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.15"], "en": "\"Yes.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.16"], "en": "If there are some who give drinking water to the Saṅgha, then indeed it should be said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:3.17", "PA_kv_17.6:4.1"], "en": "“The Saṅgha accepts the offering. It should not be said [that the Saṅgha does not accept offerings].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:4.2"], "en": "“Does the Saṅgha accept a gift?”—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:4.3"], "en": "“Yes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:4.4"], "en": "But was it not said by the Blessed One:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:5.1"], "en": "“As fire receives an oblation,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:5.2"], "en": "as the earth receives a great rain cloud,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:5.3"], "en": "so does the Saṅgha, perfected in concentration, receive [offerings].”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:5.4"], "en": "“He accepts the offering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:6.1"], "en": "Is this indeed a sutta?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:6.2"], "en": "Yes, it is.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:6.3"], "en": "\"Therefore, the Sangha accepts the offering.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:7.1"], "en": "\"Does the Sangha accept the offering?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:7.2"], "en": "\"Yes.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:7.3"], "en": "“Does the Path accept [the offering]? Does the Fruit accept it?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_kv_17.6:7.4", "PA_kv_17.6:7.5"], "en": "One should not say this… [as before]… The discussion that “the Saṅgha accepts the offering” is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
