[
{"segs": ["PA_snp_1.6:0.1", "PA_snp_1.6:0.2", "PA_snp_1.6:1.1"], "en": "Sutta Nipāta 1.6 Parābhavasutta Thus have I heard:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:1.2"], "en": "On one occasion the Blessed One was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:1.3"], "en": "Then a certain deity, in the deep of night, having illuminated the entirety of Jeta’s Grove with a magnificent radiance, approached the Blessed One. Having approached and paid homage to the Blessed One, he stood to one side.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:1.4"], "en": "Standing to one side, that deity addressed the Blessed One in verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:2.1", "PA_snp_1.6:2.2", "PA_snp_1.6:2.3"], "en": "“We come to question you, Gotama, having approached you who are being defeated by others.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:2.4"], "en": "\"What is the cause of failure?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:3.1", "PA_snp_1.6:3.2"], "en": "\"One who is easy to understand is easy to know; one who is easy to understand is easy to know regarding failure.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:3.3"], "en": "\"One who desires the Dhamma prospers;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:3.4"], "en": "one who shows contempt for the Dhamma comes to ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:4.1"], "en": "\"Thus indeed we understand this.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:4.2"], "en": "This is the first cause of ruin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:4.3"], "en": "O Blessed One, tell me the second:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:4.4"], "en": "what is the gateway to ruin?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:5.1"], "en": "The unvirtuous are dear to one who is unvirtuous,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:5.2"], "en": "but they do not hold the virtuous dear;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:5.3"], "en": "such a person delights in the way of the unvirtuous.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:5.4"], "en": "That is the gateway to ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:6.1"], "en": "\"Thus indeed we understand this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:6.2"], "en": "that is the second cause of ruin.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:6.3"], "en": "\"Thirdly, Blessed One, tell us:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:6.4"], "en": "what is the cause of downfall?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:7.1"], "en": "\"One who is habitually sleepy, one who is habitually social at court,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:7.2"], "en": "And the man who does not exert himself,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:7.3"], "en": "who is lazy and characterized by anger—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:7.4"], "en": "that is the gateway to ruin.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:8.1"], "en": "“Thus indeed we understand this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:8.2"], "en": "that is the third cause of ruin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:8.3"], "en": "please tell us the fourth, O Blessed One.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:8.4"], "en": "\"What is the cause of downfall?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:9.1", "PA_snp_1.6:9.2"], "en": "\"One who [neglects] his mother or father when they are aged and past their youth...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:9.3"], "en": "The wise man does not harbor it;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:9.4"], "en": "that is the gateway to ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:10.1"], "en": "“Thus indeed do we understand this,” they said.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:10.2"], "en": "This is the fourth cause of ruin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:10.3"], "en": "tell me, Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:10.4"], "en": "what is the fifth cause of ruin?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:11.1"], "en": "“Whoever deceives a brahmin or an ascetic,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:11.2"], "en": "or even another mendicant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:11.3"], "en": "by means of false speech, [is a fool].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:11.4"], "en": "That is the cause of one's downfall.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:12.1"], "en": "Thus we understand this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:12.2"], "en": "that is the fifth downfall.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:12.3"], "en": "\"Tell me the sixth, Blessed One:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:12.4"], "en": "what is the cause of ruin?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:13.1"], "en": "\"A man who possesses abundant wealth...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:13.2"], "en": "Together with his king and his retinue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:13.3"], "en": "he eats delicacies all by himself;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:13.4"], "en": "that is a cause of his downfall.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:14.1"], "en": "“Thus indeed we understand this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:14.2"], "en": "that is the sixth cause of ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:14.3"], "en": "May the Blessed One speak of the seventh.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:14.4"], "en": "\"What is the gateway to ruin?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:15.1"], "en": "\"The man who is arrogant because of his birth, arrogant because of his wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:15.2"], "en": "and arrogant because of his lineage;\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:15.3"], "en": "\"He who despises his own reputation—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:15.4"], "en": "that is a cause of his downfall.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:16.1"], "en": "\"Thus indeed we understand this.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:16.2"], "en": "This is the seventh cause of ruin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:16.3"], "en": "O Blessed One, tell me the eighth:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:16.4"], "en": "what is the gateway to ruin?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:17.1", "PA_snp_1.6:17.2"], "en": "“The man who is a gambler with women, a gambler with liquor, and a gambler with dice—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:17.3"], "en": "whatever he gains, he squanders.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:17.4"], "en": "That is the cause of one’s downfall.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:18.1"], "en": "Thus we understand this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:18.2"], "en": "that is the eighth cause of downfall.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:18.3"], "en": "\"Tell me, Blessed One, the ninth [verse]:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:18.4"], "en": "what is the cause of downfall?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:19.1"], "en": "\"Not being content with one's own wife,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:19.2"], "en": "He corrupts himself with courtesans;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:19.3"], "en": "he lusts after the wives of others—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:19.4"], "en": "this is a cause of his downfall.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:20.1"], "en": "“Thus indeed we understand this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:20.2"], "en": "that is the ninth cause of ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:20.3"], "en": "Please tell us the tenth, O Blessed One.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:20.4"], "en": "\"What is the cause of downfall?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:21.1", "PA_snp_1.6:21.2"], "en": "\"A man whose youth has passed brings home a woman with breasts like *timbaru* fruits.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:21.3"], "en": "She does not sleep because of jealousy;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:21.4"], "en": "that is a gateway to ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:22.1"], "en": "Thus indeed do we understand this.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:22.2"], "en": "This is the tenth cause of ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:22.3"], "en": "Please tell me, Blessed One, what is the eleventh:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:22.4"], "en": "what is the gateway to ruin?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:23.1"], "en": "Whether it be a woman who is gluttonous and wasteful,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:23.2"], "en": "or a man of the same sort,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:23.3"], "en": "he establishes them in a position of authority.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:23.4"], "en": "That is the gateway to ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:24.1"], "en": "Thus we understand this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:24.2"], "en": "that is the eleventh cause of ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:24.3"], "en": "\"O Blessed One, tell me the twelfth:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:24.4"], "en": "what is the cause of ruin?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:25.1"], "en": "\"One who has little wealth but great craving,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:25.2"], "en": "He is born into a khattiya family;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:25.3"], "en": "yet he aspires to kingship—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:25.4"], "en": "this is a cause of his downfall.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:26.1", "PA_snp_1.6:26.2"], "en": "Having thoroughly examined these in the world as points of defeat, the wise one,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:26.3"], "en": "noble and endowed with vision, [should avoid them].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:26.4"], "en": "\"He attains a blissful world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.6:26.5"], "en": "Thus ends the sixth discourse, the Parābhava Sutta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
