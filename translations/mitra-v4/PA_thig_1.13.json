[
{"segs": ["PA_thig_1.13:0.1", "PA_thig_1.13:0.2"], "en": "Therīgāthā 1.13 Ekakanipāta Visākhātherīgāthā The Verses of the Elder Nun Visākhā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
