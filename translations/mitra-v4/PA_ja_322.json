[
{"segs": ["PA_ja_322:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:0.2"], "en": "The Section of Fours,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:0.3"], "en": "Chapter on the House-Destroyer (Kuṭidūsakavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:0.4", "PA_ja_322:1.1"], "en": "2. The Duddubha Jātaka “O Venerable One,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:1.2"], "en": "I am terrified in the region where I dwell;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:1.3"], "en": "\"I too do not know this;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:1.4"], "en": "why does it sound like a drum?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:2.1"], "en": "\"Having heard a beluva fruit fall,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:2.2"], "en": "The hare cried out, \"I am swift!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:2.3"], "en": "Hearing the hare's words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:2.4"], "en": "the herd of deer became agitated with fear.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:3.1"], "en": "Failing to reach the consciousness of the path,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:3.2"], "en": "following only the voices of others,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:3.3"], "en": "these fools are intent only on noise.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:3.4"], "en": "They rely on the trust of others.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:4.1", "PA_ja_322:4.2"], "en": "But those who are endowed with virtue and delight in wisdom and tranquility—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:4.3", "PA_ja_322:4.4"], "en": "“Far removed and abstinent, the wise do not rely on the conviction of others.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_322:5.1"], "en": "Thus ends the second Jātaka, the Duddubha-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
