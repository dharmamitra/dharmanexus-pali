[
{"segs": ["PA_thag_7.1:0.1", "PA_thag_7.1:0.2", "PA_thag_7.1:0.3"], "en": "Theragāthā 7.1 Sattaka-nipāta Paṭhama-vagga", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:0.4"], "en": "The Verses of the Elder Sundarasamudda:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:1.1"], "en": "“Adorned, well-dressed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:1.2"], "en": "wearing garlands, and beautifully decorated;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:1.3"], "en": "With feet covered by sandals,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:1.4"], "en": "she was a courtesan wearing shoes;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:2.1"], "en": "having taken off her shoes, she—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:2.2"], "en": "Standing before me with palms joined,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:2.3", "PA_thag_7.1:2.4"], "en": "she spoke to me with gentle and soft words, preceded by a smile.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:3.1"], "en": "\"You are young and have gone forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:3.2"], "en": "remain in my teaching!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:3.3"], "en": "Enjoy human sensual pleasures.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:3.4"], "en": "I shall give you wealth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:3.5"], "en": "I promise you the truth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:3.6"], "en": "or I shall carry fire for you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:4.1", "PA_thag_7.1:4.2"], "en": "When we both have grown old and are leaning on our staffs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:4.3"], "en": "we both shall go forth into homelessness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:4.4"], "en": "There is a victory in both worlds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:5.1", "PA_thag_7.1:5.2"], "en": "And seeing that courtesan with palms joined in reverence as she was entreating him, [he said:]", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:5.3"], "en": "Adorned and well-dressed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:5.4"], "en": "like the snare of Death laid out;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:6.1"], "en": "from that, my attention [turned away].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:6.2", "PA_thag_7.1:6.4"], "en": "... and so on ... dispassion became firmly established.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:7.1"], "en": "Thereupon my mind was liberated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:7.2", "PA_thag_7.1:7.4"], "en": "\"... thus was the teaching of the Buddha accomplished. ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_7.1:7.5"], "en": "Thus spoke the Elder Sundarasamudda.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
