[
{"segs": ["PA_tha-ap_536:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:0.2"], "en": "Kaccāyanavagga 4.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:0.3"], "en": "The Apadāna of the Elder Dabbamallaputta", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:1.2"], "en": "the Sage who knows all the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:1.3"], "en": "[lived] one hundred thousand aeons ago from here.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:1.4"], "en": "In that eon, the Visionary One appeared.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:2.1"], "en": "He was the advisor, the inspirer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:2.2"], "en": "and the deliverer of all living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:2.3"], "en": "The Buddha, skilled in teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:2.4"], "en": "has delivered many people;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:3.1"], "en": "he is compassionate and merciful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:3.2"], "en": "Seeking the welfare of all living beings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:3.3", "PA_tha-ap_536:3.4"], "en": "he established all the ascetics who arrived there in the five precepts.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:4.1", "PA_tha-ap_536:4.2"], "en": "Thus it was free from confusion and empty of non-Buddhist sectarians,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:4.3"], "en": "yet variegated with Arahants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:4.4", "PA_tha-ap_536:5.1", "PA_tha-ap_536:5.2"], "en": "By those who have attained mastery and reached the state of the \"Tādi,\" that Great Sage has risen up with eighty-four thousand jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:5.3"], "en": "Resembling a priceless golden ornament,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:5.4"], "en": "endowed with the thirty-two excellent marks,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:6.1"], "en": "for one hundred thousand years—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:6.2"], "en": "As long as life still existed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:6.3", "PA_tha-ap_536:6.4"], "en": "for that long he remained and delivered many people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:7.1"], "en": "At that time, in Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:7.2"], "en": "I was the son of a wealthy merchant of great renown;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:7.3"], "en": "having approached the Light of the World, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:7.4"], "en": "I heard the teaching of the Dhamma as the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:8.1", "PA_tha-ap_536:8.2"], "en": "together with his disciples, was assigning lodgings to the bhikkhus.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:8.3", "PA_tha-ap_536:8.4"], "en": "Having heard his words as he was praising [the Buddha], I was joyful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:9.1"], "en": "[I offered] service to him together with the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:9.2"], "en": "Having done this for that Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:9.3", "PA_tha-ap_536:9.4"], "en": "I bowed my head at his feet and aspired for that state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:10.1"], "en": "Then that Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:10.2"], "en": "proclaiming my deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:10.3"], "en": "said: \"He who fed the Saṅgha...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:10.4"], "en": "For seven days he served the Leader of the World.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:11.1"], "en": "He, whose eyes are like lotus petals,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:11.2"], "en": "with shoulders like a lion and golden skin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:11.3"], "en": "Falling at my feet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:11.4"], "en": "he aspired for the supreme state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:12.1"], "en": "One hundred thousand aeons hence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:12.2"], "en": "Born of the Okkāka clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:12.3", "PA_tha-ap_536:12.4"], "en": "he will be a teacher in the world named Gotama by lineage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:13.1"], "en": "A disciple of that Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:13.2"], "en": "renowned by the name Dabba,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:13.3"], "en": "was the assigner of lodgings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:13.4"], "en": "\"Then you shall be the foremost.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:14.1", "PA_tha-ap_536:14.2"], "en": "By that well-performed deed and by my intentions and aspirations, [I attained this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:14.3"], "en": "Having abandoned my human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:14.4"], "en": "I went to the realm of the Thirty-three;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:15.1"], "en": "three hundred times indeed, I went there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:15.2"], "en": "I exercised the sovereignty of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:15.3"], "en": "and five hundred times,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:15.4"], "en": "I was a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:16.1"], "en": "I possessed extensive regional sovereignty,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:16.2"], "en": "beyond counting and incalculable;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:16.3"], "en": "I was happy in every respect.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:16.4"], "en": "By the force of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:17.1"], "en": "ninety-one eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:17.2"], "en": "there was a leader named Vipassī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:17.3"], "en": "One of beautiful appearance arose,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:17.4"], "en": "possessing insight into all phenomena;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:18.1"], "en": "yet with a corrupted mind, I reviled him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:18.2", "PA_tha-ap_536:18.3", "PA_tha-ap_536:18.4"], "en": "Having recognized that disciple of the Tathāgata as one whose all taints are utterly destroyed and who is pure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:19.1", "PA_tha-ap_536:19.2", "PA_tha-ap_536:19.3"], "en": "Having taken a voting tally from that very hero among men, the great seer, for his disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:19.4"], "en": "I gave milk-rice as an offering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:20.1"], "en": "In this auspicious eon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:20.2"], "en": "I was a highly renowned relative of Brahmā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:20.3"], "en": "One named Kassapa by clan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:20.4"], "en": "the best among those who speak, arose;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:21.1"], "en": "having illuminated the Dispensation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:21.2"], "en": "Having overcome the false teachers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:21.3"], "en": "and having disciplined those who were to be disciplined,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:21.4"], "en": "he has attained Nibbāna together with his disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:22.1"], "en": "When the Teacher had passed away with his disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:22.2"], "en": "and the Dispensation had come to its end,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:22.3"], "en": "the gods, overcome with agitation, wailed aloud.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:22.4"], "en": "With disheveled hair and tearful faces, [they cried]:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:23.1"], "en": "“The Treasury of Dhamma will pass away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:23.2"], "en": "we shall no longer see the Subhaddas.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:23.3"], "en": "‘We shall not hear the True Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:23.4"], "en": "alas for our meager merit!’—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:24.1"], "en": "then this entire earth, ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:24.2"], "en": "That which was immovable became moving and unsteady;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:24.3"], "en": "and the ocean, as if filled with grief,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:24.4"], "en": "uttered a piteous sound.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:25.1", "PA_tha-ap_536:25.2"], "en": "Celestial drums resounded in the four directions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:25.3"], "en": "and thunderbolts crashed on every side.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:25.4"], "en": "And terrifying portents burst forth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:26.1"], "en": "meteors fell from the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:26.2"], "en": "and a comet was seen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:26.3", "PA_tha-ap_536:26.4"], "en": "The smoke-filled, webbed-footed birds and the deer cried out piteously;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:27.1"], "en": "seeing these dreadful portents, they spoke.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:27.2"], "en": "Indicating the factors for the establishment of the Dispensation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:27.3", "PA_tha-ap_536:27.4"], "en": "we seven bhikkhus were moved with emotion and reflected upon them at that time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:28.1"], "en": "“Without the Teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:28.2"], "en": "there is no use for our lives;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:28.3"], "en": "having entered the great forest,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:28.4", "PA_tha-ap_536:29.1"], "en": "“We shall apply ourselves to the teaching of the Conqueror. Then, in the forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:29.2"], "en": "we saw a magnificent mountain rising up.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:29.3"], "en": "Having climbed up by means of that ladder,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:29.4"], "en": "we caused the ladder to fall down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:30.1"], "en": "At that time, the Elder exhorted us.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:30.2"], "en": "“The arising of a Buddha is very difficult to encounter;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:30.3"], "en": "faith, once obtained, is even more difficult to find;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:30.4"], "en": "and the remainder of the Teaching is but a small portion.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:31.1"], "en": "They fall, having missed the opportune moment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:31.2"], "en": "into the boundless ocean of suffering;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:31.3"], "en": "therefore, effort must be exerted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:31.4"], "en": "As long as he remained, O Sage, he held that view.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:32.1"], "en": "That elder was an arahant,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:32.2"], "en": "while his follower was then a non-returner (anāgāmī).", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:32.3"], "en": "Susīla and the others, being disciplined,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:32.4", "PA_tha-ap_536:33.1"], "en": "have gone to the world of the gods; you, however, are extinguished, having crossed over the cycle of existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:33.2"], "en": "And alone in the Pure Abodes;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:33.3"], "en": "myself, Pakkusāti,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:33.4"], "en": "Sabhiya, and likewise Bāhiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:34.1", "PA_tha-ap_536:34.2"], "en": "Both we and Kumārakassapa have gone to various places;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:34.3"], "en": "we are liberated from the bonds of saṃsāra.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:34.4"], "en": "I was shown compassion by Gotama.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:35.1", "PA_tha-ap_536:35.2"], "en": "While still in the womb, I was born among the Mallas in Kusinārā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:35.3"], "en": "My mother died and ascended the funeral pyre;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:35.4", "PA_tha-ap_536:36.1"], "en": "then I fell down, and having fallen, I landed upon a heap of grass.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:36.2"], "en": "Then I was known as Dabba;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:36.3", "PA_tha-ap_536:36.4"], "en": "at seven years of age, through the power of my holy life, I was liberated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:37.1"], "en": "Through the strength of the milk-rice offering,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:37.2", "PA_tha-ap_536:37.3"], "en": "I have attained five qualities; by the reproach of one whose taints are exhausted, [I am further established].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:37.4"], "en": "Though much urged by my evil deeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:38.1", "PA_tha-ap_536:38.2"], "en": "I have now transcended both merit and demerit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:38.3"], "en": "Having attained supreme peace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:38.4"], "en": "I dwell free from taints;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:39.1"], "en": "I prepared my dwelling.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:39.2"], "en": "Having made me laugh, O Subhadda,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:39.3"], "en": "the Jina, pleased with that quality,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:39.4"], "en": "placed me in this foremost position.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:40.1", "PA_tha-ap_536:40.2"], "en": "The defilements have been burnt away by me; ... [as before] ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:40.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:41.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:41.2", "PA_tha-ap_536:41.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:42.1", "PA_tha-ap_536:42.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:42.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:43.1"], "en": "Thus indeed the venerable elder Dabba Mallaputta spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_536:44.1"], "en": "This is the fourth legend of the elder Dabba Mallaputta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
