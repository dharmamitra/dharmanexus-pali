[
{"segs": ["PA_cp_31:0.1", "PA_cp_31:0.2"], "en": "The Basket of Conduct (Cariyāpiṭaka), Chapter on Yudhañjaya,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:0.3"], "en": "Perfection of Truth (Saccapāramī) 5", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:0.4", "PA_cp_31:1.1"], "en": "The Life of Kaṇhadīpāyana: “Furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:1.2"], "en": "when I was the seer Kaṇhadīpāyana;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:1.3"], "en": "For more than fifty years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:1.4"], "en": "I lived without joy;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:2.1"], "en": "no one knew this.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:2.2"], "en": "I have a mind that finds no delight;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:2.3"], "en": "for I have not told this to anyone,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:2.4"], "en": "as a lack of joy wanders within my mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:3.1", "PA_cp_31:3.2"], "en": "My fellow-celibate Maṇḍavya was my companion, a great seer;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:3.3"], "en": "he was joined with his past karma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:3.4", "PA_cp_31:4.1"], "en": "He received the punishment of being impaled on a stake. Having attended upon him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:4.2"], "en": "I restored him to health.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:4.3"], "en": "Having taken my leave,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:4.4"], "en": "I returned to my own hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:5.1"], "en": "there was a brahmin who was my companion.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:5.2"], "en": "Taking his wife and his young son,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:5.3", "PA_cp_31:5.4"], "en": "the three people came together and approached the guest who had arrived.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:6.1", "PA_cp_31:6.2"], "en": "Greeting them, he sat with them in his own hermitage;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:6.3"], "en": "like a child, he was tossing a ball.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:6.4"], "en": "He provoked the venomous serpent.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:7.1", "PA_cp_31:7.2"], "en": "Then that boy, searching for a path leading back to the wheel, [proceeded].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:7.3"], "en": "He stroked the head of a venomous snake with his hand;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:7.4", "PA_cp_31:8.1"], "en": "enraged by that touch, [the snake bit him].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:8.2"], "en": "The serpent, empowered by its venom,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:8.3"], "en": "enraged with supreme fury,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:8.4"], "en": "bit the boy in an instant.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:9.1"], "en": "Having been bitten by a venomous snake,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:9.2"], "en": "the child fell to the ground;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:9.3"], "en": "because of that, I was afflicted with pain.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:9.4"], "en": "I bore that suffering for you;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:10.1", "PA_cp_31:10.2"], "en": "having comforted them when they were pained and pierced by the dart of grief, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:10.3"], "en": "I performed the first deed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:10.4"], "en": "the foremost truth, the most excellent.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:11.1"], "en": "“For seven days alone, with a mind full of faith, I gave alms.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:11.2"], "en": "Seeking merit, I practiced the holy life;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:11.3", "PA_cp_31:11.4"], "en": "furthermore, this conduct of mine has continued for more than fifty years.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:12.1"], "en": "Indeed, I wander about without desire;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:12.2"], "en": "by this truth may there be well-being!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:12.3"], "en": "May the poison be destroyed and Yaññadatta live!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:13.1"], "en": "As soon as the truth was spoken by me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:13.2"], "en": "he was pierced by the force of the poison;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:13.3"], "en": "without waking up, he rose.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:13.4"], "en": "And the young man was free from disease;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:13.5"], "en": "there is none equal to me in truth—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:13.6"], "en": "this is my perfection of truth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_31:14.1"], "en": "The eleventh: The Life Story of Kaṇhadīpāyana.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
