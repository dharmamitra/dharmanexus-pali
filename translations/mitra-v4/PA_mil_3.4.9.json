{"segs": ["PA_mil_3.4.9:0.1"], "en": "The Questions of King Milinda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.4.9:0.2"], "en": "Chapter on Nibbāna, 9.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.4.9:0.3"], "en": "The Question on the Attainment of Nibbāna", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.4.9:1.1"], "en": "The King said:", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.4.9:1.2"], "en": "\"Venerable Nāgasena, do all obtain Nibbāna?", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.4.9:1.3_0"], "en": "\"Indeed not, Great King, do all obtain Nibbāna; rather, Great King, it is he who has practiced rightly.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.4.9:1.3_1"], "en": "“He directly knows the states that should be directly known; he fully understands the states that should be fully understood; he abandons the states that should be abandoned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.4.9:1.3_2"], "en": "he develops the states that should be developed; he realizes the states that should be realized;", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.4.9:2.1"], "en": "he attains Nibbāna. “Excellent, Bhante Nāgasena!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"},
{"segs": ["PA_mil_3.4.9:3.1"], "en": "The ninth question: On the Attainment of Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T12:59:40Z"}
]
