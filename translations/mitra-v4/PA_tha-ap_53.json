[
{"segs": ["PA_tha-ap_53:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:0.2"], "en": "Bījanīvagga 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:0.3"], "en": "The Apadāna of the Elder Vidhūpanadāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:1.1"], "en": "“To Padumuttara Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:1.2"], "en": "the World’s Elder, the Neutral One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:1.3"], "en": "a seed-corn was given by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:1.4", "PA_tha-ap_53:2.1"], "en": "Having inspired confidence in his own mind toward the Lord of Men, the Tathāgata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:2.2"], "en": "and having raised his hands in reverent salutation;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:2.3"], "en": "Having paid homage to the Fully Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:2.4"], "en": "I set out facing north,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:3.1"], "en": "taking hold of a fan.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:3.2"], "en": "The Teacher, the leader of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:3.3"], "en": "standing amidst the community of bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:3.4"], "en": "spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:4.1"], "en": "\"By means of this seed as a cause,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:4.2"], "en": "and through the aspirations of my mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:4.3"], "en": "for a hundred thousand eons,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:4.4"], "en": "He does not go to a state of ruin.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:5.1"], "en": "With energy aroused and resolute,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:5.2"], "en": "his mind is concentrated through its own qualities.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:5.3"], "en": "In my seventh year from birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:5.4"], "en": "I attained arahantship;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:6.1"], "en": "sixty thousand eons ago—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:6.2", "PA_tha-ap_53:6.3"], "en": "There were sixteen kings named Bījamānasa,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:6.4"], "en": "wheel-turning monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:7.1"], "en": "The four analytical knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:7.2"], "en": "these eight liberations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:7.3"], "en": "and the six direct knowledges have been realized.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:7.4"], "en": "“Such is the teaching of the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:8.1"], "en": "Thus indeed the Venerable Elder Vidhūpanadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_53:9.1"], "en": "This is the first apadāna of the Elder Vidhūpanadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
