[
{"segs": ["PA_thag_6.6:0.1", "PA_thag_6.6:0.2"], "en": "Theragāthā 6.6 Chakkanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:0.4"], "en": "The Verses of the Elder Sappadāsa:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:1.1", "PA_thag_6.6:1.2"], "en": "“Twenty-five years have passed since I went forth;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:1.3", "PA_thag_6.6:1.4"], "en": "Without attaining even for the duration of a finger-snap the peace of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:2.1"], "en": "and failing to achieve one-pointedness of consciousness, I wandered.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:2.2"], "en": "Afflicted by sensual lust,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:2.3", "PA_thag_6.6:2.4"], "en": "I emerged from the monastery, wailing and raising my arms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:3.1"], "en": "I shall take up the blade;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:3.2"], "en": "what is the use of life to me?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:3.3"], "en": "For how can I abandon the training?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:3.4"], "en": "One such as I should pass away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:4.1"], "en": "Then, taking my razor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:4.2"], "en": "I sat down upon my couch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:4.3", "PA_thag_6.6:4.4"], "en": "The razor was whetted for the purpose of cutting my own veins; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:5.1"], "en": "my attention [was focused].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:5.2"], "en": "Through systematic attention, it arose in him;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:5.3"], "en": "the danger became manifest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:5.4"], "en": "and disenchantment took firm root.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:6.1"], "en": "Then my mind was liberated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:6.2"], "en": "behold the excellence of the Dhamma!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:6.3"], "en": "The three knowledges have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:6.4"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_6.6:6.5"], "en": "... Thus spoke the Elder Sappadāsa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
