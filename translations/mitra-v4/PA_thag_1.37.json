[
{"segs": ["PA_thag_1.37:0.1", "PA_thag_1.37:0.2", "PA_thag_1.37:0.3"], "en": "Theragāthā 1.37 Ekakanipāta Catutthavagga (The Fourth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.37:0.4"], "en": "The Stanzas of the Elder Kumāputtasahāyaka:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.37:1.1", "PA_thag_1.37:1.2"], "en": "“Wandering about unrestrained, they go to various countries;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.37:1.3"], "en": "They fail in concentration;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.37:1.4"], "en": "what will the practice of royal conduct avail them?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.37:1.5"], "en": "Therefore, having removed all agitation, [one should dwell in solitude].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.37:1.6"], "en": "“One should meditate without being preoccupied.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_1.37:1.7"], "en": "… This was said by the elder who was a companion to the elder Kumāputta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
