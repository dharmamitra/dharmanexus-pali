[
{"segs": ["PA_tha-ap_223:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:0.2"], "en": "The Chapter on the Giver of a Support (Ālambaṇadāyakavagga) 1.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:0.3"], "en": "The Apadāna of the Elder Ālambaṇadāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:1.1"], "en": "“To the Blessed One Atthadassi,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:1.2"], "en": "the World’s Best, the Neutral One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:1.3"], "en": "an alms-bowl was given by me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:1.4", "PA_tha-ap_223:2.1", "PA_tha-ap_223:2.2"], "en": "I take refuge in the vast earth, bounded by the ocean, which belongs to the Lord of Men, the Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:2.3", "PA_tha-ap_223:2.4"], "en": "I exercise sovereignty over living beings and over the earth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:3.1"], "en": "the defilements have been burnt away by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:3.2"], "en": "All states of existence have been utterly eradicated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:3.3"], "en": "the threefold knowledge has been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:3.4"], "en": "the teaching of the Buddha has been fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:4.1"], "en": "In this sixty-second aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:4.2"], "en": "there were three kṣatriyas;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:4.3"], "en": "they were all named Ekāpassita.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:4.4"], "en": "And world-turning monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:5.1"], "en": "The four analytical knowledges,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:5.2"], "en": "and also these eight liberations;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:5.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:5.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:6.1"], "en": "Thus indeed did the venerable elder Ālambanadāyaka speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_223:7.1"], "en": "The legend of the Elder Ālambanadāyaka is the first.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
