[
{"segs": ["PA_tha-ap_504:0.1", "PA_tha-ap_504:0.2", "PA_tha-ap_504:0.3"], "en": "The Apadāna of the Elder Ekapattadāyaka, from the Kaṇikāra Chapter, Number Two.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:1.1"], "en": "“In the city of Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:1.2"], "en": "I was a potter;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:1.3"], "en": "there I saw the stainless Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:1.4"], "en": "To him who has crossed the flood and is free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:2.1", "PA_tha-ap_504:2.2"], "en": "I gave a well-fashioned clay bowl to the Best of Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:2.3"], "en": "Having given a bowl to the Blessed One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:2.4"], "en": "who was upright and poised, may I,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:3.1"], "en": "when being reborn in existence, [be born]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:3.2"], "en": "I receive golden bowls,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:3.3", "PA_tha-ap_504:3.4"], "en": "as well as those made of silver, gold, and jewels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:4.1"], "en": "I enjoy these bowls;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:4.2"], "en": "this is the fruit of meritorious deeds:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:4.3"], "en": "of fame and of wealth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:4.4"], "en": "And I shall become preeminent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:5.1", "PA_tha-ap_504:5.2"], "en": "Just as even a small seed sown in a fertile field,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:5.3", "PA_tha-ap_504:5.4"], "en": "Just as the fruit satisfies the farmer who bestows the seed upon the well-prepared soil,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:6.1"], "en": "so too does this gift of a bowl [bring satisfaction].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:6.2"], "en": "Planted within the field of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:6.3"], "en": "as the showers of joy rain down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:6.4"], "en": "its fruit will bring me satisfaction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:7.1"], "en": "However many fields there may be,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:7.2"], "en": "whether they be monastic communities or assemblies,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:7.3"], "en": "there is none equal to the field of a Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:7.4"], "en": "The giver of happiness to all living beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:8.1"], "en": "Homage to you, O noble steed among men;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:8.2"], "en": "homage to you, O supreme among men.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:8.3"], "en": "Having given a single bowl,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:8.4"], "en": "I have attained the unshakable state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:9.1"], "en": "Ninety-one eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:9.2"], "en": "Because I gave that alms-bowl back then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:9.3"], "en": "I do not know any state of misery;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:9.4"], "en": "this is the fruit of the gift of the bowl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:10.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:10.2", "PA_tha-ap_504:10.3"], "en": "…pe… I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:11.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:11.2", "PA_tha-ap_504:11.3"], "en": "[as before] ...the teaching of the Buddha has been fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:12.1", "PA_tha-ap_504:12.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:12.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:13.1"], "en": "Thus indeed the venerable elder Ekapattadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_504:14.1"], "en": "This is the second legend of the elder Ekapattadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
