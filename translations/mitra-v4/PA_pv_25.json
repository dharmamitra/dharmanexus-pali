[
{"segs": ["PA_pv_25:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:0.2"], "en": "Ubbarivagga 13.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:0.3"], "en": "The Story of the Ghost of Ubbarī", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:1.1"], "en": "King Brahmadatta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:1.2"], "en": "the bull among chariot-warriors of the Pañcālas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:1.3"], "en": "passed away with the lapse of days and nights.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:1.4"], "en": "The king passed away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:2.1"], "en": "Having gone to his funeral pyre,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:2.2"], "en": "his wife Ubbarī wept aloud.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:2.3"], "en": "Not seeing Brahmadatta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:2.4"], "en": "she cried out, \"Brahmadatta!", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:3.1"], "en": "And there an ascetic arrived.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:3.2"], "en": "The sage, whose conduct was perfected,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:3.3", "PA_pv_25:3.4"], "en": "took his leave there of those who had gathered together in that place.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:4.1"], "en": "“Whose is this cremation ground,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:4.2"], "en": "filled with various fragrances?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:4.3"], "en": "Whose wife is this that weeps?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:4.4", "PA_pv_25:4.5"], "en": "Not seeing her husband Brahmadatta, who has gone far from here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:4.6"], "en": "she cries out, “Brahmadatta!”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:5.1", "PA_pv_25:5.2"], "en": "And those who were well-gathered there gave their explanation concerning him:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:5.3"], "en": "\"O Venerable One, regarding Brahmadatta...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:5.4"], "en": "Of Brahmadatta, dear sir.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:6.1"], "en": "This is his cremation ground,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:6.2"], "en": "perfumed with various scents.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:6.3"], "en": "His wife is weeping for him,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:6.4"], "en": "her husband who has gone far away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:6.5"], "en": "she does not see Brahmadatta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:6.6"], "en": "“‘Brahmadatta,’ she cried out.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:7.1", "PA_pv_25:7.2"], "en": "“There were eighty-six thousand [beings] named Brahmadatta;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:7.3", "PA_pv_25:7.4"], "en": "\"They have been burnt in this funeral pyre; for whom do you grieve?", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:8.1"], "en": "\"The king who was the son of Cūḷanī—\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:8.2"], "en": "The bull among charioteers of the Pañcālas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:8.3", "PA_pv_25:8.4"], "en": "venerable sir, I grieve for that husband who fulfilled every desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:9.1", "PA_pv_25:9.2", "PA_pv_25:9.3"], "en": "“All those kings who bore the name Brahmadatta were indeed the sons of Cūḷanī.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:9.4"], "en": "The bull among chariot-warriors of the Pañcālas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:10.1", "PA_pv_25:10.2"], "en": "in due course, caused all of them to perform the duties of the Great Queen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:10.3", "PA_pv_25:10.4"], "en": "“Why, having abandoned those of the past, do you grieve for those of the future? [She replied:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:11.1"], "en": "“While I was a woman, my own self—”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:11.2"], "en": "“For a long time, dear sir,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:11.3", "PA_pv_25:11.4"], "en": "you have spoken much to me while I was a woman in the cycle of existence.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:12.1"], "en": "“‘I was a woman, I was a man,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:12.2"], "en": "I even came from a womb of an animal;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:12.3"], "en": "such indeed was the case for those of the past.’”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:12.4"], "en": "“...no end is seen.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:13.1"], "en": "“While I am thus ablaze,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:13.2"], "en": "like a fire fed with ghee;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:13.3"], "en": "Sprinkling it as if with water,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:13.4"], "en": "he extinguishes all distress.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:14.1"], "en": "Truly, the arrow has been pulled out from me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:14.2"], "en": "The sorrow seated within my heart—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:14.3", "PA_pv_25:14.4"], "en": "He who dispelled that sorrow for me when I was overcome by grief.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:15.1"], "en": "I have pulled out the arrow,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:15.2"], "en": "I have become cool and attained Nibbāna;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:15.3"], "en": "I do not grieve, nor do I weep.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:15.4"], "en": "\"Having heard this from you, O Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:16.1", "PA_pv_25:16.2"], "en": "Having heard those well-spoken words of the ascetic, he said:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:16.3"], "en": "Taking her bowl and robes,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:16.4"], "en": "she went forth into the homeless life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:17.1"], "en": "and having gone forth, she became peaceful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:17.2", "PA_pv_25:17.3", "PA_pv_25:17.4"], "en": "He went forth from the household life into homelessness and cultivated a mind of loving-kindness for the sake of rebirth in the Brahma-world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:18.1"], "en": "Wandering from village to village,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:18.2"], "en": "through market towns and royal capitals,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:18.3"], "en": "there was a village named Uruvelā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:18.4"], "en": "Wherever you passed away,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:19.1"], "en": "having cultivated a mind of loving-kindness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:19.2"], "en": "you were reborn in the Brahma-world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:19.3"], "en": "Having dispassionately abandoned the female mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:19.4"], "en": "they have gone to the Brahma world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:20.1"], "en": "Thus ends the thirteenth story, the Ubbari Petavatthu.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:21.1"], "en": "The second chapter, the Ubbarivagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:22.1"], "en": "Its summary (uddāna) is:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:23.1"], "en": "Mocaka, Mātā, and Mattā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:23.2"], "en": "Nandā, Kuṇḍalinī, Ghaṭā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:23.3"], "en": "the two merchants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_pv_25:23.4"], "en": "the tailor, Uttara, Suttakaṇṇa, and Ubbarī.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
