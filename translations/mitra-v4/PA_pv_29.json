[
{"segs": ["PA_pv_29:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:0.2"], "en": "Cūḷavagga, 4.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:0.3"], "en": "Bhusapetavatthu (The Story of the Dust-Petal Ghost)", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:1.1"], "en": "“One person gathers rice, another gathers husks;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:1.2"], "en": "this woman gathers her own flesh and blood;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:1.3"], "en": "and you gather feces—impure and loathsome.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:1.4"], "en": "“Whose ripening of karma is this that you enjoy?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:2.1"], "en": "“This one formerly harmed his mother,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:2.2"], "en": "and this one was a fraudulent merchant.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:2.3"], "en": "Having eaten this flesh,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:2.4"], "en": "she deceives me with a lie.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:3.1"], "en": "I was among humans, having become human.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:3.2"], "en": "I am a housewife, the mistress of the entire household;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:3.3"], "en": "while there are things here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:3.4"], "en": "I shall keep them hidden and give nothing away from this place.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:4.1"], "en": "\"I conceal it with a lie:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:4.2"], "en": "'This is not in my house';", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:4.3"], "en": "if I hide what exists,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:4.4"], "en": "\"May excrement be my food!\"—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:5.1", "PA_pv_29:5.2"], "en": "as the ripening of that karma, and of both [the karma] of false speech, [this result came to pass].", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:5.3", "PA_pv_29:5.4"], "en": "The fragrant rice-food turns for me into excrement;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:6.1"], "en": "yet my karmic deeds are never barren.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:6.2"], "en": "For indeed, karma does not perish;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:6.3", "PA_pv_29:6.4"], "en": "I eat and I drink foul-smelling, worm-infested filth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_29:7.1"], "en": "The Story of Bhusapuṭa, the Fourth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"}
]
