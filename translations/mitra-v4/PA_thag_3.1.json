[
{"segs": ["PA_thag_3.1:0.1"], "en": "Theragāthā 3.1 Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:0.2", "PA_thag_3.1:0.3"], "en": "Paṭhamavagga (The First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:0.4"], "en": "The Verse of the Elder Aṅgaṇikabhāradvāja:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:1.1"], "en": "“Seeking purity through improper means,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:1.2"], "en": "I tended the fire in the forest.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:1.3"], "en": "Not knowing the path of purity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:1.4"], "en": "I performed the austerity of immortality;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:2.1"], "en": "thus was that happiness obtained with ease.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:2.2"], "en": "Behold the excellence of the Dhamma!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:2.3"], "en": "The three knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:2.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:3.1"], "en": "Formerly I was a mere kinsman of Brahmins,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:3.2"], "en": "but now I am a true brahmin;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:3.3"], "en": "I am one who possesses the three Vedas and am a purified bath-graduate.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:3.4"], "en": "“I am a learned scholar and one who has attained true knowledge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_3.1:3.5"], "en": "… Thus spoke the Elder Aṅgaṇika-Bhāradvāja.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
