[
{"segs": ["PA_snp_1.11:0.1", "PA_snp_1.11:0.2", "PA_snp_1.11:1.1"], "en": "Whether walking or standing still, Sutta Nipāta 1.11 Vijayasutta (The Discourse on Victory)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:1.2"], "en": "Whether sitting or lying down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:1.3"], "en": "one contracts or extends the limbs;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:1.4"], "en": "this is the movement of the body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:2.1"], "en": "Bound together by bones and sinews,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:2.2"], "en": "smeared with skin and flesh,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:2.3"], "en": "the body is concealed by the outer hide.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:2.4"], "en": "It is not seen as it truly is:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:3.1"], "en": "full of entrails, full of stomach,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:3.2"], "en": "and containing a mass of liver wrapped in membranes.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:3.3"], "en": "Of the heart, of the lungs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:3.4"], "en": "of the kidneys, and of the spleen;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:4.1"], "en": "of mucus and of saliva.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:4.2"], "en": "Of the semen and the marrow;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:4.3"], "en": "of the blood, the synovial fluid,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:4.4"], "en": "the bile, and the fat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:5.1"], "en": "Then from his nine streams,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:5.2"], "en": "impurity flows constantly:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:5.3"], "en": "from the eyes, the eye-secretion;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:5.4"], "en": "Ear-wax from the ear,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:6.1"], "en": "snot from the nose,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:6.2"], "en": "and sometimes vomit from the mouth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:6.3"], "en": "He vomits bile and phlegm,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:6.4"], "en": "and sweat and grime from his body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:7.1"], "en": "Then his head becomes hollow.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:7.2"], "en": "Filled with brain matter,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:7.3", "PA_snp_1.11:7.4"], "en": "the fool— led on by ignorance— regards it as beautiful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:8.1"], "en": "And when he has died and lies there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:8.2"], "en": "swollen and discolored,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:8.3"], "en": "cast away in the cemetery—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:8.4"], "en": "Relatives become indifferent;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:9.1", "PA_snp_1.11:9.2"], "en": "dogs, jackals, crows, and worms devour him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:9.3"], "en": "Crows and vultures devour them,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:9.4"], "en": "as do whatever other living beings are there;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:10.1"], "en": "having heard the word of the Buddha, [one should reflect].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:10.2", "PA_snp_1.11:10.3"], "en": "The wise bhikkhu here indeed thoroughly understands it,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:10.4"], "en": "for he sees it as it truly is.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:11.1", "PA_snp_1.11:11.2"], "en": "As this is, so is that; as that is, so is this;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:11.3"], "en": "both internally and externally.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:11.4", "PA_snp_1.11:12.1"], "en": "One should cause desire for the body to fade away. Free from desire and lust,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:12.2"], "en": "that wise bhikkhu here [is liberated].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:12.3"], "en": "He has attained the deathless peace,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:12.4"], "en": "Nibbāna, the immutable state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:13.1"], "en": "This two-legged being is impure.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:13.2"], "en": "Foul-smelling, it is cast away;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:13.3"], "en": "filled with various kinds of corpses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:13.4"], "en": "it stinks from every side.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:14.1"], "en": "Whoever, on account of such a body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:14.2"], "en": "should think themselves superior,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:14.3"], "en": "or should despise another—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:14.4"], "en": "\"What else but non-seeing?", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_snp_1.11:14.5"], "en": "Thus ends the eleventh discourse, the Vijaya Sutta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
