[
{"segs": ["PA_vv_37:0.1"], "en": "Vimānavatthu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:0.2", "PA_vv_37:0.3"], "en": "The Chapter on the Pāricchattaka Tree in the Itthivimāna (The Female Vimānas)", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:0.4", "PA_vv_37:1.1"], "en": "9. The Mansion of Visālakkhī “Who are you, O large-eyed one,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:1.2"], "en": "in this delightful Cittalatā Grove?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:1.3"], "en": "She wandered all around,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:1.4"], "en": "preceded by a host of women,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:2.1"], "en": "when the Tāvatiṃsa gods—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:2.2"], "en": "They enter this forest; all of them,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:2.3"], "en": "with their mounts and chariots,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:2.4"], "en": "have arrived here in their splendor.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:3.1"], "en": "And as you have arrived here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:3.2"], "en": "wandering in this garden,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:3.3"], "en": "the mind is not seen within the body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:3.4"], "en": "“By what means is your form such as this?", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:3.5"], "en": "O deity, being questioned, tell me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:3.6"], "en": "of what karma is this the fruit?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:4.1"], "en": "“By whatever kamma, O Lord of Devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:4.2"], "en": "my form, my destiny,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:4.3"], "en": "my psychic power, and my majesty [were produced],”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:4.4"], "en": "Listen to that, O Purindada:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:5.1"], "en": "in the delightful city of Rājagaha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:5.2"], "en": "I am a female lay follower named Sunandā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:5.3"], "en": "Endowed with faith and virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:5.4"], "en": "always delighting in sharing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:6.1"], "en": "[giving] clothing and food—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:6.2", "PA_vv_37:6.3"], "en": "I gave a lodging and a lamp to those who have become upright,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:6.4"], "en": "with a mind full of serene confidence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:7.1"], "en": "The fourteenth, the fifteenth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:7.2"], "en": "and the eighth day of the fortnight,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:7.3"], "en": "as well as the fortnight of miracles—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:7.4"], "en": "Endowed with the eight factors,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:8.1"], "en": "I shall observe the Uposatha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:8.2"], "en": "always restrained by virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:8.3"], "en": "Through self-restraint and sharing,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:8.4"], "en": "we dwell in a celestial mansion;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:9.1"], "en": "we abstain from taking life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:9.2"], "en": "Restrained from false speech,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:9.3"], "en": "and far removed from theft, sexual misconduct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:9.4"], "en": "and the drinking of intoxicants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:10.1"], "en": "Delighting in the five precepts,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:10.2"], "en": "skilled in the Noble Truths,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:10.3"], "en": "they are lay disciples of the One with Vision.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:10.4"], "en": "Of Gotama, the illustrious one.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:11.1", "PA_vv_37:11.2"], "en": "From her family, a female slave was always bringing me garlands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:11.3", "PA_vv_37:11.4"], "en": "All of that I offered at the stupa of the Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:12.1"], "en": "And having gone on the Uposatha day,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:12.2", "PA_vv_37:12.3", "PA_vv_37:12.4"], "en": "With my own hands, full of faith, I offered garlands, perfumes, and ointments at the stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:13.1"], "en": "By that kamma, O Lord of Devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:13.2"], "en": "my form, my destiny,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:13.3"], "en": "my psychic power, and my majesty [were produced].", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:13.4"], "en": "The garland that I offered,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:14.1"], "en": "and the fact that I was virtuous—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:14.2"], "en": "this has not yet reached its fruition.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:14.3"], "en": "\"And may I, O Lord of Devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:14.4"], "en": "become a once-returner.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_37:15.1"], "en": "Thus ends the ninth Vimāna, the Visālakkhi-vimāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"}
]
