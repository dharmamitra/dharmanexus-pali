[
{"segs": ["PA_tha-ap_329:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:0.2"], "en": "Umāpupphiyavagga 7.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:0.3"], "en": "The Apadāna of the Elder Nigguṇḍipupphiya", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:1.1", "PA_tha-ap_329:1.2"], "en": "“When a god passes away from the host of gods due to the exhaustion of his lifespan,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:1.3"], "en": "three sounds resound:”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:1.4"], "en": "Rejoicing in the gods:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:2.1"], "en": "\"O sir, go from here to a happy destination,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:2.2"], "en": "to the company of human beings.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:2.3", "PA_tha-ap_329:2.4"], "en": "Having become a human being, obtain unsurpassed faith in the true Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:3.1"], "en": "Let that faith of yours be firmly established.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:3.2"], "en": "Rooted and firmly established,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:3.3", "PA_tha-ap_329:3.4"], "en": "they remain unshakable for as long as life lasts in the well-proclaimed True Dharma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:4.1"], "en": "Having performed wholesome deeds with the body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:4.2"], "en": "having performed much wholesome deeds with speech,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:4.3"], "en": "and having performed wholesome deeds with the mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:4.4"], "en": "Free from ill will and without attachment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:5.1", "PA_tha-ap_329:5.2"], "en": "Then, having performed much merit consisting of worldly acquisitions through giving;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:5.3", "PA_tha-ap_329:5.4"], "en": "Establish other people as well in the true Dhamma and in the holy life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:6.1"], "en": "Out of this compassion, [establish them].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:6.2", "PA_tha-ap_329:6.3"], "en": "When the wise know a god as such while he is passing away, they rejoice, saying:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:6.4"], "en": "\"Come back, O god, again and again!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:7.1", "PA_tha-ap_329:7.2"], "en": "“At that time, when the assembly of gods had gathered, I was filled with a sense of spiritual urgency:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:7.3"], "en": "‘Into what kind of womb shall I be born?’”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:7.4"], "en": "‘Having passed away from here, I shall go [there].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:8.1"], "en": "Perceiving my sense of spiritual urgency,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:8.2"], "en": "the ascetic of developed faculties—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:8.3"], "en": "Desiring to rescue me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:8.4"], "en": "he came into my presence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:9.1"], "en": "his name was Sumanas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:9.2"], "en": "A disciple of Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:9.3"], "en": "having instructed me in the meaning and the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:9.4"], "en": "then inspired me with a sense of spiritual urgency.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:10.1"], "en": "The twelfth recitation section.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:11.1"], "en": "Having heard his words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:11.2"], "en": "I brought forth confidence in my mind toward the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:11.3"], "en": "Having paid homage to that wise one,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:11.4", "PA_tha-ap_329:12.1"], "en": "I passed away there and was reborn right there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:12.2"], "en": "Urged on by the root of merit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:12.3"], "en": "while dwelling within his mother’s womb,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:12.4"], "en": "he again takes up residence in his mother’s womb.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:13.1"], "en": "Having passed away from that body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:13.2"], "en": "I was reborn among the Thirty-three;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:13.3"], "en": "in the interval between these two, I saw nothing.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:13.4"], "en": "I was then overwhelmed by grief.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:14.1"], "en": "Having passed away from the Tāvatiṃsa heaven,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:14.2"], "en": "I entered my mother’s womb.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:14.3"], "en": "Having emerged from the womb,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:14.4"], "en": "I did not know black or white;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:15.1"], "en": "I was only seven years old by birth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:15.2", "PA_tha-ap_329:15.3"], "en": "I entered the grove of the Blessed One Gotama,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:15.4"], "en": "the Sakyan son, the Tathāgata.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:16.1"], "en": "In the extensive word of the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:16.2"], "en": "in the teaching known by many,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:16.3"], "en": "I saw those who carry out the dispensation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:16.4"], "en": "There, the monks were with the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:17.1"], "en": "There was a city named Sāvatthī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:17.2"], "en": "and there the King of Kosala resided.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:17.3", "PA_tha-ap_329:17.4"], "en": "He approached the supreme Bodhi tree by means of a chariot yoked with elephants.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:18.1"], "en": "Having seen his elephant, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:18.2"], "en": "I recollected my past deeds;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:18.3"], "en": "having raised my hands in reverent salutation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:18.4"], "en": "I approached him at the proper time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:19.1"], "en": "Only seven years from my birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:19.2"], "en": "I went forth into the homeless life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:19.3"], "en": "I was he who attended upon the Buddha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:19.4", "PA_tha-ap_329:20.1"], "en": "The disciple named Ānanda was possessed of wisdom, steadfastness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:20.2"], "en": "mindfulness, and great learning.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:20.3"], "en": "Inspiring confidence in the king’s mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:20.4"], "en": "he of great splendor delivered [the teaching].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:21.1"], "en": "Having heard his Dhamma, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:21.2"], "en": "I recollected my past karma;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:21.3"], "en": "while remaining right there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:21.4"], "en": "I attained arahantship.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:22.1", "PA_tha-ap_329:22.2"], "en": "Having arranged his robe over one shoulder and placing his hands together in añjali upon his head,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:22.3"], "en": "he paid homage to the Fully Enlightened One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:22.4"], "en": "I uttered these words:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:23.1"], "en": "“Of the Buddha Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:23.2"], "en": "the Teacher, the Lord of bipeds;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:23.3"], "en": "Having taken a *nigguṇḍi* flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:23.4"], "en": "I placed it upon the lion throne.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:24.1"], "en": "By that deed, O Lord of Bipeds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:24.2"], "en": "O eldest of the world, bull among men!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:24.3"], "en": "I have reached the immovable state,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:24.4"], "en": "having abandoned victory and defeat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:25.1", "PA_tha-ap_329:25.2"], "en": "For twenty-five thousand aeons, O lords of men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:25.3"], "en": "[he dwelt] in the Abbuda and Nirabbuda hells.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:25.4"], "en": "The kṣatriyas stood in groups of eight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:26.1", "PA_tha-ap_329:26.2"], "en": "[He attained] the four analytical knowledges... [and so forth].", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:26.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:27.1"], "en": "In this way, it is said, the Elder Thera Nigguṇḍipupphiya recited these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_329:28.1"], "en": "This is the seventh legend of the Elder Thera Nigguṇḍipupphiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
