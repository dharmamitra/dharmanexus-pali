[
{"segs": ["PA_bv_18:0.1"], "en": "Buddhavamsa 18.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:0.2"], "en": "The Lineage of Buddha Siddhattha:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:1.1"], "en": "After the time of Dhammadassi,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:1.2"], "en": "The Leader named Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:1.3"], "en": "having destroyed all darkness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:1.4"], "en": "has arisen like the sun.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:2.1"], "en": "He too, having attained full enlightenment,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:2.2"], "en": "while ferrying across the world together with its devas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:2.3"], "en": "rained down the rain of Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:2.4"], "en": "Extinguishing [the fires] for the world with its devas,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:3.1", "PA_bv_18:3.2"], "en": "there were three moments of clear realization for that one of incomparable splendor.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:3.3", "PA_bv_18:3.4"], "en": "There was the first realization for one hundred thousand times ten million [beings].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:4.1"], "en": "Furthermore, at Bhīmaratha—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:4.2"], "en": "When he struck the drum,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:4.3", "PA_bv_18:4.4"], "en": "there was a second realization for ninety koṭis of beings.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:5.1"], "en": "When the Buddha taught the Dhamma at Vebhāra,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:5.2"], "en": "that most excellent mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:5.3"], "en": "then for ninety koṭis—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:5.4"], "en": "The third realization occurred.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:6.1", "PA_bv_18:6.2"], "en": "There were three assemblies even during the time of that Best of Bipeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:6.3"], "en": "Of those whose taints were exhausted, stainless,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:6.4"], "en": "peaceful in mind, and steadfast—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:7.1"], "en": "nine billion nine hundred million.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:7.2"], "en": "And there were eighty koṭis as well;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:7.3", "PA_bv_18:7.4"], "en": "these were the three assemblies that occurred when the stainless ones gathered.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:8.1"], "en": "At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:8.2"], "en": "I was an ascetic named Maṅgala;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:8.3"], "en": "possessed of fierce power, I was difficult to overcome.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:8.4"], "en": "Concentrated by the power of supernormal knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:9.1", "PA_bv_18:9.2"], "en": "I brought a jambu fruit and gave it to Siddhattha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:9.3", "PA_bv_18:9.4"], "en": "Having accepted it, the Perfectly Awakened One spoke these words:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:10.1"], "en": "“Behold this ascetic!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:10.2"], "en": "To the matted-hair ascetic Uggatāpana:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:10.3"], "en": "\"In the ninety-fourth aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:10.4"], "en": "this one shall become a Buddha.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:11.1"], "en": "Having exerted ourselves in striving,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:11.2", "PA_bv_18:11.3"], "en": "... we shall stand face to face with this one.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:12.1"], "en": "Having heard her words as well,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:12.2"], "en": "my mind became even more serene;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:12.3"], "en": "I resolved upon a further vow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:12.4"], "en": "For the fulfillment of the ten perfections.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:13.1"], "en": "There was a city named Vebhāra,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:13.2"], "en": "and a kshatriya named Udena;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:13.3", "PA_bv_18:13.4"], "en": "Suphassā was the name of the mother of Siddhattha, the Great Sage;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:14.1"], "en": "for ten thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:14.2"], "en": "He lived in a house,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:14.3", "PA_bv_18:14.4"], "en": "possessing three supreme palaces: Kokā, Suppala, and Kokanada.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:15.1", "PA_bv_18:15.2"], "en": "Sixteen thousand women were beautifully adorned;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:15.3"], "en": "that woman was named Somanassā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:15.4"], "en": "His own son was named Anūpama.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:16.1"], "en": "Having seen the four omens,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:16.2"], "en": "he went forth from home in a palanquin.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:16.3"], "en": "For ten full months,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:16.4"], "en": "the Conqueror exerted himself in striving;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:17.1"], "en": "being entreated by Brahmā, he remained.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:17.2"], "en": "Siddhattha, the Leader of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:17.3", "PA_bv_18:17.4"], "en": "the Great Hero, the Supreme among Men, set the Wheel of Dhamma in motion at Migadāya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:18.1", "PA_bv_18:18.2"], "en": "Sambala and Sumitta were his chief disciples;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:18.3"], "en": "his attendant was named Revata.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:18.4"], "en": "Of Siddhattha, the Great Sage,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:19.1", "PA_bv_18:19.2"], "en": "Sīvalā and Surāmā were the two chief female disciples.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:19.3", "PA_bv_18:19.4"], "en": "The enlightenment of that Blessed One is called Kaṇikāra;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:20.1"], "en": "and Suppiya and Samudda—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:20.2"], "en": "They were the foremost attendants;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:20.3"], "en": "delightful and exceedingly beautiful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:20.4"], "en": "they were the foremost attendants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:21.1"], "en": "Thus the Buddha, sixty cubits in height,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:21.2"], "en": "rose up into the sky,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:21.3"], "en": "resembling a golden casket.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:21.4"], "en": "The ten-thousandfold world system shines forth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:22.1"], "en": "That Buddha too was peerless,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:22.2"], "en": "incomparable, matchless, and without equal.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:22.3"], "en": "For one hundred thousand years,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:22.4"], "en": "the Visionary One remained in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:23.1"], "en": "manifesting vast radiance.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:23.2", "PA_bv_18:23.3"], "en": "Having caused his disciples to bloom like flowers and having gladdened them with meditative attainments, he, together with his disciples,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:23.4"], "en": "has attained final Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:24.1"], "en": "The Buddha, the excellent sage Siddhattha,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:24.2"], "en": "attained Nibbāna at Anomārāma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:24.3"], "en": "right there stands his most excellent stupa.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:24.4"], "en": "“Rising four yojanas high.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_bv_18:25.1"], "en": "This is the sixteenth lineage of the Blessed One Siddhattha.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
