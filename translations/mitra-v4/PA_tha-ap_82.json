[
{"segs": ["PA_tha-ap_82:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:0.2"], "en": "The Section on the Nāgasamāla Group, 10.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:0.3"], "en": "The Apadāna of the Elder Tipadumiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:1.2"], "en": "who has gone beyond all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:1.3"], "en": "is tamed and surrounded by those who are tamed.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:1.4"], "en": "I then departed from the city. At that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:2.1"], "en": "in the city of Haṃsavatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:2.2"], "en": "I was a florist.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:2.3", "PA_tha-ap_82:2.4"], "en": "There, I took three lotus flowers, the most excellent of them all.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:3.1"], "en": "“I saw the stainless Buddha...”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:3.2"], "en": "On the road between the market towns,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:3.3"], "en": "upon seeing the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:3.4"], "en": "I then thought thus:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:4.1", "PA_tha-ap_82:4.2"], "en": "\"What use have I for these flowers brought to me by the king?", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:4.3"], "en": "[I would rather have] a village or a village field.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:4.4"], "en": "I might receive a thousand [coins].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:5.1"], "en": "[But I would rather honor] the Hero who tames the untamed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:5.2"], "en": "the bringer of happiness to all beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:5.3"], "en": "\"Having worshipped the Lord of the World,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:5.4"], "en": "I shall obtain the treasure of the Deathless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:6.1"], "en": "Having thought thus, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:6.2"], "en": "I gladdened my own mind; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:6.3"], "en": "having taken up three red lotuses,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:6.4"], "en": "I tossed them into the air.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:7.1"], "en": "As soon as it was lifted up by me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:7.2"], "en": "they spread out in the sky;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:7.3"], "en": "there, they held it over my head.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:7.4"], "en": "With stalks turned upward and faces downward,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:8.1", "PA_tha-ap_82:8.2"], "en": "whatever people saw them raised a cry of \"Alas! (ukkuṭṭhi).", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:8.3", "PA_tha-ap_82:8.4"], "en": "The deities in the sky raised shouts of \"Excellent!\"—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:9.1"], "en": "a marvel has arisen in the world!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:9.2"], "en": "By the power of the Best of Buddhas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:9.3"], "en": "we shall all hear the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:9.4"], "en": "just as we have gathered these flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:10.1"], "en": "Padumuttara, the knower of the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:10.2"], "en": "the recipient of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:10.3"], "en": "while standing upon the street, being virtuous—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:10.4"], "en": "He spoke these verses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:11.1", "PA_tha-ap_82:11.2"], "en": "“The young man who honored the Buddha with red lotuses— ”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:11.3"], "en": "I shall proclaim his praises;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:11.4"], "en": "listen to me as I speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:12.1"], "en": "For thirty thousand aeons...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:12.2"], "en": "He will delight in the world of the gods;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:12.3"], "en": "for thirty eons, as lord of the gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:12.4"], "en": "he will exercise sovereignty over the devas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:13.1", "PA_tha-ap_82:13.2"], "en": "At that time, the vault of heaven shall become exceedingly vast,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:13.3"], "en": "rising three hundred yojanas in height.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:13.4"], "en": "It was one hundred and fifty cubits wide.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:14.1", "PA_tha-ap_82:14.2"], "en": "Four hundred thousand well-constructed turrets were beautifully arranged.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:14.3"], "en": "Adorned with excellent gabled chambers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:14.4"], "en": "decorated with great couches,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:15.1"], "en": "numbering hundreds of thousands of millions.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:15.2", "PA_tha-ap_82:15.3", "PA_tha-ap_82:15.4"], "en": "Nymphs skilled in dance and song, and likewise adept in instrumental music, will attend upon him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:16.1"], "en": "Upon such a supreme mountain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:16.2"], "en": "crowded with throngs of women,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:16.3"], "en": "a rain of flowers shall fall.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:16.4"], "en": "It is always divine and red.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:17.1"], "en": "[It is found] on the base of a wall, on a bracket,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:17.2"], "en": "on the doorposts, and on the archway.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:17.3"], "en": "Red as much as a wheel,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:17.4"], "en": "they will hang down for that long;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:18.1"], "en": "covered by bowl after bowl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:18.2", "PA_tha-ap_82:18.3"], "en": "Having spread this excellent inner garment and having put it on,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:18.4"], "en": "they will quickly settle down for a while.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:19.1", "PA_tha-ap_82:19.2"], "en": "Surrounding the Bhavana for a hundred yojanas on all sides,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:19.3"], "en": "those lotuses were also red.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:19.4"], "en": "They waft divine fragrances.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:20.1", "PA_tha-ap_82:20.2"], "en": "And seventy-five times he will become a wheel-turning monarch.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:20.3", "PA_tha-ap_82:20.4", "PA_tha-ap_82:21.1"], "en": "Having enjoyed two kinds of prosperity— a vast regional sovereignty and an incalculable number of other riches—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:21.2"], "en": "Free from harm and free from calamity,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:21.3"], "en": "at the conclusion of his attainment,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:21.4"], "en": "he will reach Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:22.1"], "en": "Truly well-seen by me is the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:22.2"], "en": "my trade has been well-conducted;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:22.3"], "en": "having worshipped three lotuses, [I have attained this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:22.4"], "en": "I experienced the threefold perfection.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:23.1", "PA_tha-ap_82:23.2"], "en": "Today, for me who has attained the Dhamma and is entirely liberated, [there is nothing more].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:23.3", "PA_tha-ap_82:23.4", "PA_tha-ap_82:24.1"], "en": "A red lotus in full bloom shall be borne upon his head as he recounts my deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:24.2"], "en": "Under the Teacher Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:24.3", "PA_tha-ap_82:24.4"], "en": "there was the realization of the Dhamma by one hundred thousand beings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:25.1"], "en": "In a hundred thousand aeons past,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:25.2"], "en": "because I worshipped the Buddha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:25.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:25.4"], "en": "This is the fruit of the three lotuses:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:26.1"], "en": "my defilements have been incinerated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:26.2"], "en": "and all states of existence have been uprooted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:26.3"], "en": "All taints are utterly destroyed;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:26.4"], "en": "there is now no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:27.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:27.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:27.3"], "en": "the Buddha's teaching has been fulfilled.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:28.1"], "en": "Thus indeed did the venerable elder Tipadumiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:29.1"], "en": "The legend of the Elder Tipadumiya is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:30.1"], "en": "The eighth chapter, the Nāgasamāla-vagga.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:31.1"], "en": "Its summary (uddāna) is as follows:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:32.1"], "en": "Nāgasamāla was mindful of his footprint,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:32.2"], "en": "Saññaka was a giver of advice,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:32.3"], "en": "and Ekasaññī was one who spread out a mat of grass.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:32.4"], "en": "Sūcipāṭalipupphiya,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:32.5"], "en": "Ṭhitañjalī, and Tipadumī—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_82:32.6"], "en": "these are seventy-five verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
