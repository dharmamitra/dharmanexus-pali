[
{"segs": ["PA_cp_32:0.1", "PA_cp_32:0.2"], "en": "The Basket of Conduct (Cariyāpiṭaka), Chapter on Yudhañjaya:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:0.3"], "en": "The Perfection of Truth (Saccapāramī) 6", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:0.4"], "en": "The Conduct of Sutasoma:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:1.1"], "en": "\"Furthermore, when I was Sutasoma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:1.2"], "en": "the lord of the earth...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:1.3"], "en": "Seized by the man-eater,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:1.4"], "en": "O brahmin, I recalled my promise;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:2.1"], "en": "[I gave] one hundred kṣatriyas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:2.2", "PA_cp_32:2.3"], "en": "Having spun it on the palms of his hands and having caused these [fibers] to intertwine,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:2.4"], "en": "he brought me for the purpose of sacrifice.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:3.1"], "en": "Porisāda asked me,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:3.2"], "en": "“What do you wish for as a ransom?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:3.3"], "en": "I shall do according to your wish.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:3.4"], "en": "\"If you bring me back again.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:4.1"], "en": "Having given him his word,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:4.2"], "en": "he came to my presence regarding the question.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:4.3"], "en": "Having approached the delightful city,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:4.4"], "en": "I then handed over the kingdom,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:5.1"], "en": "recollecting the Dhamma of the Noble Ones.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:5.2", "PA_cp_32:5.3"], "en": "Having given wealth to the brahmin, I approached Porisāda,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:5.4"], "en": "that ancient practice honored by the Victors.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:6.1"], "en": "I have no doubt in that matter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:6.2"], "en": "whether he will kill me or not;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:6.3"], "en": "I shall protect my word of truth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:6.4"], "en": "I came to the point of giving up my life;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:6.5"], "en": "there is nothing equal to my truth—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:6.6"], "en": "this is my perfection of truth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_32:7.1"], "en": "The twelfth is the Sutasoma Cariyā.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
