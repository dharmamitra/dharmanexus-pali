[
{"segs": ["PA_tha-ap_58:0.1", "PA_tha-ap_58:0.2", "PA_tha-ap_58:0.3"], "en": "The Apadāna of the Elder Saparivārāsana, from the Bījanī Chapter, Number Six.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:1.1", "PA_tha-ap_58:1.2"], "en": "“I gave alms-food to Padumuttara Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:1.3"], "en": "having gone to a place that was soiled, [I offered it].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:1.4"], "en": "Surrounded by jasmine flowers,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:2.1", "PA_tha-ap_58:2.2"], "en": "the Buddha, the leader of the world, sat upon that throne.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:2.3"], "en": "He proclaimed the alms-round,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:2.4"], "en": "upright and concentrated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:3.1"], "en": "as if in a fertile field.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:3.2"], "en": "Even a tiny seed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:3.3"], "en": "when sown and provided with proper water,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:3.4"], "en": "yields fruit that satisfies the farmer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:4.1", "PA_tha-ap_58:4.2", "PA_tha-ap_58:4.3"], "en": "In the same way, this alms-food was sown by you in a fertile field when you were being reborn in existence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:4.4"], "en": "\"The fruit will satisfy you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:5.1"], "en": "Having said this, the Fully Awakened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:5.2"], "en": "whose name is the Supreme Lotus;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:5.3"], "en": "Having taken his almsfood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:5.4"], "en": "he departed facing north,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:6.1"], "en": "restrained according to the Pātimokkha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:6.2"], "en": "Regarding the five sense faculties,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:6.3", "PA_tha-ap_58:6.4"], "en": "I dwell devoted to solitude, free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:7.1", "PA_tha-ap_58:7.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:7.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:8.1"], "en": "Thus indeed the venerable Elder Saparivārāsana spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_58:9.1"], "en": "This is the sixth legend of the Elder Saparivārāsana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
