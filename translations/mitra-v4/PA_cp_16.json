[
{"segs": ["PA_cp_16:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:0.2"], "en": "Hatthināgavagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:0.3"], "en": "Sīlapāramī 6", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:0.4", "PA_cp_16:1.1"], "en": "Furthermore, when I was the Ruru-miga king,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:1.2"], "en": "resembling molten gold in hue:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:1.3"], "en": "The king of deer, named Ruru,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:1.4"], "en": "was perfectly established in supreme virtue;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:2.1"], "en": "he dwelt in a delightful and charming region.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:2.2"], "en": "In a secluded place, devoid of humans;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:2.3", "PA_cp_16:2.4"], "en": "there I took up residence on the delightful bank of the Ganges.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:3.1"], "en": "Then, on the upper reaches of the Ganges,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:3.2", "PA_cp_16:3.3"], "en": "a man oppressed by creditors threw himself into the Ganges.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:3.4"], "en": "‘I live, or I die.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:4.1", "PA_cp_16:4.2"], "en": "Day and night, he was being carried along by the great waters of the Ganges.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:4.3"], "en": "Uttering a piteous cry,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:4.4"], "en": "he went into the midst of the Ganges.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:5.1"], "en": "Having heard his sound, I—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:5.2"], "en": "Lamenting piteously,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:5.3", "PA_cp_16:5.4"], "en": "I stood on the bank of the Ganges and asked, \"Who are you, O man?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:6.1", "PA_cp_16:6.2"], "en": "Thus questioned by me, he then explained his own deed:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:6.3"], "en": "\"Terrified and trembling with fear of my creditors,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:6.4"], "en": "I leaped into the great river.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:7.1", "PA_cp_16:7.2"], "en": "Having shown him compassion and sacrificed my own life, I gave it up for him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:7.3", "PA_cp_16:7.4"], "en": "Having entered, I brought him out during the darkness of the night;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:8.1"], "en": "knowing it was time for him to rest, I led him away.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:8.2"], "en": "To her I said this:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:8.3"], "en": "“I ask for one favor:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:8.4"], "en": "do not speak of me to anyone.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:9.1"], "en": "Having gone to the city,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:9.2"], "en": "when questioned regarding the cause of his wealth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:9.3"], "en": "he took the king [with him].", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:9.4"], "en": "He approached me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:10.1", "PA_cp_16:10.2"], "en": "I reported to the king everything that had been done.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:10.3"], "en": "Having heard these words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:10.4"], "en": "the king prepared his arrow, thinking:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:10.5"], "en": "\"I shall have him executed right here.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:10.6"], "en": "A betrayer of friends and ignoble—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:11.1", "PA_cp_16:11.2"], "en": "protecting him, I fashioned him after my own likeness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:11.3"], "en": "“Let it be as you wish, Great King;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:11.4", "PA_cp_16:12.1"], "en": "I shall abide by your command. Thus I guarded my virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:12.2"], "en": "I did not protect my own life;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:12.3", "PA_cp_16:12.4"], "en": "for at that time I was possessed of virtue solely for the sake of enlightenment.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_16:13.1"], "en": "The sixth is the Conduct of the Ruru Deer King.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
