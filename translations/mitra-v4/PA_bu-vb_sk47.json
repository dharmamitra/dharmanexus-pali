[
{"segs": ["PA_bu-vb_sk47:0.1"], "en": "The Theravāda Vinaya Mahāvibhaṅga:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:0.2", "PA_bu-vb_sk47:0.3"], "en": "The Section on the Training Rules (Sekhiyakaṇḍa)", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:0.4", "PA_bu-vb_sk47:0.5"], "en": "The Chapter on Lumps of Food, Section 47: The Training Rule on Shaking the Hand.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.1"], "en": "At that time, the Buddha, the Blessed One, was dwelling at Sāvatthī in Jeta’s Grove, Anāthapiṇḍika’s monastery.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.2"], "en": "Now at that time, the group-of-six monks ate shaking their hands ...", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.3.1"], "en": "[as before] ... \"The training is to be observed: 'I shall not eat shaking my hands.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.4"], "en": "One must not eat shaking one's hands.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.5"], "en": "Whoever, out of disrespect, eats while shaking his hand, commits an offense of wrong-doing (dukkaṭa).", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.6.1", "PA_bu-vb_sk47:1.7"], "en": "There is no offense if it was unintentional.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.8"], "en": "For one who is lacking mindfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.9"], "en": "for one who is unaware,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.10"], "en": "and for one who is ill.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.11"], "en": "Shaking out one's hand while discarding refuse;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.12"], "en": "during times of emergency;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.13"], "en": "for one who is insane.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.14"], "en": "\"For one who is a first offender.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_bu-vb_sk47:1.15"], "en": "The seventh training rule is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
