[
{"segs": ["PA_thi-ap_29:0.1"], "en": "The Apadāna of the Elder Nuns:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:0.2"], "en": "The Section on Kuṇḍalakesī, Number Nine:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:0.3"], "en": "The Apadāna of the Ten Thousand Bhikkhunīs Headed by Yasodharā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:1.1", "PA_thi-ap_29:1.2"], "en": "“One hundred thousand aeons and four incalculable eons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:1.3"], "en": "there was a Victor named Dīpaṅkara.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:1.4"], "en": "The Leader of the World arose.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:2.1"], "en": "Dīpaṅkara, the Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:2.2"], "en": "the Guide, gave this prophecy:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:2.3"], "en": "Beholding Sumedha and Sumitta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:2.4"], "en": "who shared the same joys and sorrows,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:3.1"], "en": "as well as the world with its gods, he—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:3.2"], "en": "Wandering through the world including its devas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:3.3", "PA_thi-ap_29:3.4"], "en": "they approached us and gathered together for our praise.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:4.1", "PA_thi-ap_29:4.2"], "en": "Become the husband of us all in our future meeting;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:4.3"], "en": "let all of us indeed be your wives.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:4.4"], "en": "Pleasing and speaking kindly;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:5.1"], "en": "all giving consisting of virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:5.2"], "en": "and well-developed meditation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:5.3", "PA_thi-ap_29:5.4"], "en": "And for a long time, O Great Sage, we have renounced everything:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:6.1"], "en": "perfumes, ointments, and garlands.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:6.2"], "en": "And the island made of jewels—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:6.3"], "en": "whatever was desired,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:6.4"], "en": "all was relinquished by the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:7.1"], "en": "Or whatever other karma has been done,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:7.2"], "en": "and human enjoyments—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:7.3"], "en": "all these have indeed been ours for a long time.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:7.4"], "en": "It was renounced by the Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:8.1"], "en": "Though we have wandered through many births in saṃsāra,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:8.2"], "en": "we have not performed much merit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:8.3", "PA_thi-ap_29:8.4"], "en": "Having experienced lordship and wandered through various states of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:9.1"], "en": "when his final birth was reached,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:9.2"], "en": "In the dwelling of the Sakyan son,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:9.3"], "en": "there were Apsarases of various noble births,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:9.4"], "en": "possessing the forms of desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:10.1"], "en": "Having attained fame through their excellence in gain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:10.2"], "en": "they were honored and revered by all,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:10.3"], "en": "receiving food and drink as their reward.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:10.4"], "en": "We were always honored by them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:11.1"], "en": "Having abandoned the household life,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:11.2"], "en": "we went forth into the homeless state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:11.3"], "en": "Before half a month had passed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:11.4"], "en": "we all attained Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:12.1"], "en": "being recipients of food and drink.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:12.2"], "en": "And robes, alms-food, and lodgings—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:12.3", "PA_thi-ap_29:12.4"], "en": "all these requisites always approach them, honored and worshipped.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:13.1"], "en": "The defilements have been incinerated by us; ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:13.2"], "en": "pe ...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:13.3"], "en": "we dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:14.1"], "en": "Welcome indeed has come to us...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:14.2", "PA_thi-ap_29:14.3"], "en": "[as before] ...the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:15.1", "PA_thi-ap_29:15.2"], "en": "The four analytical knowledges... [and so on]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:15.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:16.1"], "en": "Thus indeed, ten thousand bhikkhunīs headed by Yasodharā spoke these verses in the presence of the Blessed One.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_29:17.1"], "en": "This concludes the ninth account of the ten thousand bhikkhunīs headed by Yasodharā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
