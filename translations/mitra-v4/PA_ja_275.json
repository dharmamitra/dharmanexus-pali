[
{"segs": ["PA_ja_275:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_275:0.2", "PA_ja_275:0.3"], "en": "The Collection of Threes, Chapter on the Well (Udapānavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_275:0.4"], "en": "5. The Rucirā Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_275:1.1", "PA_ja_275:1.2"], "en": "“The beautiful crane, Rucirā, frequents the crow’s nest.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_275:1.3"], "en": "“The fierce crow is my friend;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_275:1.4"], "en": "he whose nest this is.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_275:2.1"], "en": "“Do you not know me, friend?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_275:2.2"], "en": "I ate a meal of millet;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_275:2.3", "PA_ja_275:2.4"], "en": "see, having not followed your word, I have returned shorn.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_275:3.1"], "en": "“Will you receive it again, my friend?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_275:3.2"], "en": "For such is your virtue;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_275:3.3"], "en": "indeed, human enjoyments—”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_275:3.4"], "en": "“They enjoy themselves together with the birds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_275:4.1"], "en": "Thus ends the fifth Jātaka, the Rucira-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
