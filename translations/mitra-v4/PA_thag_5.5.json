[
{"segs": ["PA_thag_5.5:0.1", "PA_thag_5.5:0.2", "PA_thag_5.5:0.3"], "en": "Theragāthā 5.5 Pañcaka-nipāta First Chapter (Paṭhamavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:0.4"], "en": "The Verses of the Elder Vaḍḍha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:1.1", "PA_thag_5.5:1.2"], "en": "\"It was truly well of my mother that she showed me this goad.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:1.3", "PA_thag_5.5:1.4"], "en": "Having heard the words of my mother, instructed by her,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:1.5"], "en": "I have applied energy and am resolute.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:1.6"], "en": "I have attained supreme enlightenment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:2.1"], "en": "I am an arahant, worthy of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:2.2"], "en": "possessor of the three knowledges, and seer of the deathless.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:2.3"], "en": "Having conquered the army of Namuci,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:2.4"], "en": "I dwell free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:3.1"], "en": "both within and without.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:3.2"], "en": "Those taints that existed within me—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:3.3"], "en": "every one of them has been cut off without remainder,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:3.4"], "en": "and they shall not arise again.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:4.1", "PA_thag_5.5:4.2"], "en": "The Sister Visāradā spoke this matter with confidence:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:4.3"], "en": "“Surely there is no aversion even in me.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:4.4"], "en": "“Forest-dwelling does not exist for you.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:5.1"], "en": "Suffering has been brought to its limit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:5.2"], "en": "this mass of suffering is now at its end.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:5.3"], "en": "“The cycle of birth and death is ended;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:5.4"], "en": "there is now no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_5.5:5.5"], "en": "… Thus spoke the Elder Vaḍḍha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
