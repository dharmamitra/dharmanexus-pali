[
{"segs": ["PA_ja_501:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:0.2", "PA_ja_501:0.3"], "en": "The Collection of Twenty, Chapter on Mātaṅga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:0.4"], "en": "5. The Rohaṇa Deer Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:1.1", "PA_ja_501:1.2"], "en": "“Here these herds are fleeing, terrified of death, O Citta!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:1.3"], "en": "“Go you too, do not be anxious;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:1.4"], "en": "they will live together with you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:2.1"], "en": "“I will not go, Rohaṇa.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:2.2"], "en": "My heart is failing me;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:2.3"], "en": "I shall not abandon him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:2.4"], "en": "for here I will give up my life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:3.1"], "en": "“They will surely die,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:3.2"], "en": "blind and without a guide;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:3.3"], "en": "you too should go, do not hesitate.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:3.4"], "en": "“They shall live together with you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:4.1"], "en": "“I will not go, Rohaṇa;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:4.2"], "en": "my heart is being torn away.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:4.3"], "en": "\"I will not abandon this one who is bound;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:4.4"], "en": "here indeed I shall lay down my life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:5.1"], "en": "\"Go, O timid one, flee away!\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:5.2"], "en": "\"I am bound in an iron cage;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:5.3"], "en": "go away yourself, do not hope for it,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:5.4"], "en": "for they will live along with you.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:6.1"], "en": "“I am not going to Rohaṇa,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:6.2"], "en": "my heart is being torn away;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:6.3"], "en": "I will not abandon you.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:6.4"], "en": "\"Here indeed I shall give up my life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:7.1"], "en": "\"They will surely die,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:7.2"], "en": "blind and without a guide;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:7.3"], "en": "“Go, you too; do not despair;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:7.4"], "en": "they will live along with you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:8.1"], "en": "“I will not go, Rohaṇa.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:8.2"], "en": "My heart is being torn asunder;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:8.3"], "en": "I shall not abandon that which is bound,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:8.4"], "en": "for here I shall lay down my life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:9.1"], "en": "“Here comes that hunter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:9.2"], "en": "with the form of a hunter and bearing his weapons;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:9.3"], "en": "he who will slay us today.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:9.4"], "en": "\"Even with a sword and water.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:10.1"], "en": "Having fled for a moment,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:10.2"], "en": "she was overcome by fear and terrified by the danger.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:10.3"], "en": "“O timid one, you have done what is very difficult to do;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:10.4"], "en": "turn back from death!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:11.1"], "en": "“What kind of deer are these for you?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:11.2"], "en": "They approached him who was bound by pearls;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:11.3"], "en": "they did not wish to abandon him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:11.4"], "en": "even for the sake of their own lives.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:12.1"], "en": "“Ludda, they are my brothers,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:12.2"], "en": "born of the same womb and the same mother;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:12.3"], "en": "they do not wish to abandon me.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:12.4"], "en": "\"Even for the sake of life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:13.1"], "en": "\"Indeed, they will surely die,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:13.2"], "en": "blind and without a leader;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:13.3"], "en": "\"Give life to these five;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:13.4"], "en": "release my brother, hunter!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:14.1"], "en": "\"I shall release you all.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:14.2"], "en": "The deer who supports his mother and father—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:14.3", "PA_ja_501:14.4"], "en": "may his parents rejoice upon seeing the great deer set free!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:15.1", "PA_ja_501:15.2"], "en": "“Thus, hunter, may you rejoice together with all your kinsmen,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:15.3"], "en": "just as I rejoice today.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:15.4"], "en": "Having seen the great deer who had passed away:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:16.1", "PA_ja_501:16.2"], "en": "\"How were you liberated when your life was brought to its end?\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:16.3", "PA_ja_501:16.4"], "en": "“How did you release my son from the hunter’s snare?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:17.1"], "en": "“By speaking words that were pleasant to the ear,” he replied.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:17.2"], "en": "The heart-limbs are dependent on the heart;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:17.3"], "en": "with well-spoken words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:17.4"], "en": "Cittaka has released me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:18.1"], "en": "Speaking words that are pleasant to the ear,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:18.2"], "en": "heart-pleasing and heart-endearing,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:18.3"], "en": "with well-spoken speech—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:18.4"], "en": "Suta has liberated me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:19.1"], "en": "Having heard words that are pleasant to the ear,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:19.2"], "en": "heart-moving, and dear to the heart;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:19.3"], "en": "“Having heard these well-spoken words,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:19.4"], "en": "the hunter released me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:20.1"], "en": "“May he be thus delighted, Ānanda.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:20.2"], "en": "Together with my wife, I am a hunter;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:20.3"], "en": "today we rejoice,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:20.4"], "en": "having seen Rohaṇa come here.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:21.1"], "en": "“Did you not say, hunter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:21.2"], "en": "‘I have brought deer-skins’?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:21.3"], "en": "Now, by what reason— ”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:21.4"], "en": "He did not bring back the deer-skins.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:22.1", "PA_ja_501:22.2"], "en": "That deer had already come within reach of his hand and into the snare.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:22.3"], "en": "The king of beasts was captured,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:22.4"], "en": "and pearls were scattered about; at that,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:23.1"], "en": "a sense of spiritual urgency arose within me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:23.2"], "en": "It is wonderful and hair-raising!", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:23.3"], "en": "If I were to kill this deer,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:23.4"], "en": "I would grant him his life today.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:24.1"], "en": "“Of what kind are those deer, hunter?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:24.2"], "en": "Of what kind are the righteous deer?", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:24.3"], "en": "What is their appearance, and what is their conduct?”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:24.4"], "en": "“You praise them indeed excessively.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:25.1"], "en": "“With white horns and pure tails,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:25.2"], "en": "resembling skins of gold;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:25.3"], "en": "Their feet are red,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:25.4"], "en": "their eyes are anointed, and they are beautiful to behold.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:26.1"], "en": "\"Such are those deer, O King.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:26.2", "PA_ja_501:26.3"], "en": "\"O King, such deer are righteous and support their mothers and fathers;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:26.4"], "en": "they should not be carried off by you.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:27.1"], "en": "“Give me a hundred nikkhas, O hunter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:27.2"], "en": "and a large jeweled earring,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:27.3"], "en": "and a four-legged couch.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:27.4"], "en": "Resembling the *umā* flower,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:28.1"], "en": "he had two wives of equal beauty,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:28.2"], "en": "and a bull together with a hundred cows.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:28.3"], "en": "\"I shall rule the kingdom according to the Dhamma;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:28.4"], "en": "you have been very helpful to me, hunter.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:29.1"], "en": "[I shall provide for] agriculture, trade, and the granting of loans.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:29.2"], "en": "And the hunter who lives by gleaning:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:29.3"], "en": "with these support your wife;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:29.4"], "en": "do not commit evil again.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_501:30.1"], "en": "The Rohaṇamiga Jātaka is the fifth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
