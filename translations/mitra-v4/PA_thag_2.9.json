[
{"segs": ["PA_thag_2.9:0.1", "PA_thag_2.9:0.2"], "en": "Theragāthā 2.9 Dukanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.9:0.3"], "en": "Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.9:0.4"], "en": "The Verses of the Elder Gotama:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.9:1.1"], "en": "“Happy sleep the sages,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.9:1.2"], "en": "who are not bound by women;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.9:1.3"], "en": "\"Indeed, among those things that must always be guarded,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.9:1.4"], "en": "truth is very difficult to find.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.9:2.1"], "en": "We have practiced slaughter for the sake of sensual pleasures.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.9:2.2"], "en": "\"Now we are free from debt;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.9:2.3"], "en": "let us now go to Nibbāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.9:2.4"], "en": "having gone where one does not grieve.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_2.9:2.5"], "en": "… the Elder Gotama …", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
