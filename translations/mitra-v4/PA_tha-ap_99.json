[
{"segs": ["PA_tha-ap_99:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:0.2"], "en": "Sudhāvagga 7.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:0.3"], "en": "The Apadāna of the Elder Madhupiṇḍika", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:1.1", "PA_tha-ap_99:1.2", "PA_tha-ap_99:1.3"], "en": "“Having seen Siddhattha, the best of sages, in the forest grove, quiet and undisturbed;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:1.4"], "en": "The receiver of offerings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:2.1", "PA_tha-ap_99:2.2"], "en": "like a great bull elephant who has attained nibbāna, like a noble stallion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:2.3", "PA_tha-ap_99:2.4"], "en": "Shining like a medicinal herb and being honored by the hosts of gods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:3.1"], "en": "at that moment I experienced a sense of well-being.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:3.2", "PA_tha-ap_99:3.3", "PA_tha-ap_99:3.4"], "en": "At that very moment, knowledge arose for the Teacher who had emerged from meditative absorption after he had given the honey.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:4.1"], "en": "Having paid homage at the Teacher’s feet,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:4.2"], "en": "I departed facing the east;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:4.3"], "en": "in the thirty-fourth aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:4.4"], "en": "I was King Sudassana.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:5.1", "PA_tha-ap_99:5.2"], "en": "At that time, honey flowed from the lotus stalks as food.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:5.3"], "en": "Honeyed rain poured down;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:5.4"], "en": "this is the fruit of a former deed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:6.1"], "en": "Ninety-four eons ago...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:6.2"], "en": "Since I gave that honey back then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:6.3"], "en": "I have not known a miserable rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:6.4"], "en": "this is the fruit of giving honey.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:7.1"], "en": "In the thirty-fourth aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:7.2"], "en": "there were four Sudassanas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:7.3"], "en": "endowed with the seven treasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:7.4"], "en": "Universal monarchs of great power.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:8.1", "PA_tha-ap_99:8.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:8.3"], "en": "“Thus was the teaching of the Buddha spoken.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:9.1"], "en": "In this way, indeed, the venerable elder Madhupiṇḍika spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_99:10.1"], "en": "This is the seventh legend of the elder Madhupiṇḍika.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
