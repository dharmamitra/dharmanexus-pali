[
{"segs": ["PA_ja_286:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:0.2"], "en": "Tikanipāta,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:0.3"], "en": "Abbhantaravagga (The Section on Inner Circles)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:0.4"], "en": "6. The Sālūka Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:1.1"], "en": "\"Do not envy the sālūka;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:1.2"], "en": "it feeds on sickly food.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:1.3"], "en": "\"Eat the husk without anxiety;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:1.4"], "en": "this is the mark of long life.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:2.1"], "en": "Now he will come here,\" [he said].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:2.2"], "en": "A guest who serves with diligence—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:2.3", "PA_ja_286:2.4"], "en": "then you shall see the lotus-leaf sleeping with the pestle as its pillow.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:3.1"], "en": "Seeing the boar, who was exhausted,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:3.2"], "en": "lying down with the pestle above him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:3.3"], "en": "the old oxen reflected:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:3.4"], "en": "\"It would be better for us to eat [the lotus roots] whole.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_286:4.1"], "en": "This is the sixth Jātaka, the Sālūka-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
