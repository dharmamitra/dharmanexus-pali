[
{"segs": ["PA_tha-ap_105:0.1", "PA_tha-ap_105:0.2", "PA_tha-ap_105:0.3"], "en": "The Apadāna of the Elder Uppalahatthiya, from the Bhikkhadāyivagga of the Therāpadāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:1.1", "PA_tha-ap_105:1.2"], "en": "“At that time, I was a gardener living in Tivarā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:1.3"], "en": "I saw the stainless Buddha.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:1.4"], "en": "To Siddhattha, honored by the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:2.1"], "en": "with a clear heart and joyful mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:2.2"], "en": "I offered a handful of flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:2.3"], "en": "Wherever I am reborn,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:2.4"], "en": "by the force of that karma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:3.1"], "en": "I experience its desirable fruit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:3.2", "PA_tha-ap_105:3.3", "PA_tha-ap_105:3.4"], "en": "This is the fruit of giving flowers, for one has been well-fortified with good garlands by one's own previous good deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:4.1"], "en": "In ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:4.2"], "en": "because I offered that flower,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:4.3"], "en": "I have not known a state of misery.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:4.4"], "en": "This is the fruit of an offering of flowers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:5.1", "PA_tha-ap_105:5.2"], "en": "Excluding the present, [it lasts] for ninety-four aeons.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:5.3", "PA_tha-ap_105:5.4"], "en": "Therein, five hundred kings named Nacca-samasa [resided];", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:6.1"], "en": "[there also arose] the four analytical knowledges (paṭisambhidā).", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:6.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:6.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:7.1"], "en": "Thus indeed did the venerable elder Uppalahatthiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_105:8.1"], "en": "The legend of the Elder Uppalahatthiya is the third.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
