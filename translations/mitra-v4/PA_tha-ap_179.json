[
{"segs": ["PA_tha-ap_179:0.1", "PA_tha-ap_179:0.2", "PA_tha-ap_179:0.3"], "en": "The Apadāna of the Elder Ekadīpiya, from the Kumuda Chapter, Number Seven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:1.1"], "en": "“Toward the sage Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:1.2"], "en": "at the supreme Bodhi tree of *saḷala* wood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:1.3"], "en": "with a clear mind and a joyful heart, [I paid homage].”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:1.4"], "en": "I gave a single lamp.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:2.1"], "en": "While being reborn in existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:2.2"], "en": "and once reborn, my store of merit was accumulated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:2.3"], "en": "I do not know a state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:2.4"], "en": "this is the fruit of giving a lamp.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:3.1"], "en": "In sixteen thousand aeons,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:3.2"], "en": "From here these four persons shall arise,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:3.3"], "en": "known by the name Candābhā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:3.4"], "en": "mighty wheel-turning monarchs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:4.1", "PA_tha-ap_179:4.2"], "en": "The four analytical knowledges... [and so forth]...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:4.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:5.1"], "en": "Thus indeed did the venerable elder Ekadīpiya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:6.1"], "en": "This is the seventh legend of the elder Ekadīpiya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_179:6.2"], "en": "The ninth section for recitation is concluded.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
