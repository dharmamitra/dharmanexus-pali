[
{"segs": ["PA_snp_4.15:0.1", "PA_snp_4.15:0.2", "PA_snp_4.15:1.1"], "en": "Sutta Nipāta 4.15 Attadaṇḍasutta “Fear has arisen from the self as its staff;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:1.2"], "en": "Behold people as a mere heap of dust;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:1.3"], "en": "I shall proclaim my sense of urgency,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:1.4"], "en": "just as it was stirred within me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:2.1", "PA_snp_4.15:2.2"], "en": "Seeing the world struggling like fish in shallow water,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:2.3"], "en": "mutually hostile toward one another—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:2.4"], "en": "Upon seeing this, fear took possession of me:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:3.1"], "en": "\"The world is entirely without essence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:3.2"], "en": "all directions are trembling.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:3.3"], "en": "Desiring my own existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:3.4"], "en": "I did not see that it was unestablished;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:4.1"], "en": "for at the very end, it is indeed hostile.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:4.2"], "en": "Upon seeing it, aversion arose in me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:4.3"], "en": "then I beheld the dart here,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:4.4"], "en": "difficult to see, lodged within the heart.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:5.1"], "en": "Pierced by that dart,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:5.2"], "en": "one runs in all directions;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:5.3"], "en": "having extracted that very dart, [one should not run].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:5.4"], "en": "It does not run, nor does it sink.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:6.1"], "en": "Therein, the trainings are sung forth—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:6.2"], "en": "those things which are clung to in the world.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:6.3"], "en": "One should not be devoted to those things,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:6.4"], "en": "but having become completely disillusioned with all sensual pleasures,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:6.5"], "en": "one should train for one's own Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:7.1"], "en": "One may indeed be modest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:7.2"], "en": "free from deceit, devoid of slander,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:7.3"], "en": "without anger, and free from the evil of greed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:7.4"], "en": "The sage should cross over doubt;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:8.1"], "en": "he should endure sleepiness, lethargy, and sloth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:8.2"], "en": "and not dwell in negligence.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:8.3", "PA_snp_4.15:8.4"], "en": "A person whose mind is set on Nibbāna should not stand in pride,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:9.1"], "en": "nor should they be led away by false speech.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:9.2"], "en": "One should not form attachment to form;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:9.3", "PA_snp_4.15:9.4"], "en": "one should thoroughly understand conceit and live free from rashness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:10.1"], "en": "One should not rejoice in the past,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:10.2"], "en": "nor should one take pleasure in the new;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:10.3"], "en": "one should not grieve over what has passed away.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:10.4"], "en": "One should not be attached to space.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:11.1"], "en": "I call greed the great flood;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:11.2"], "en": "I call hankering the rushing current.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:11.3", "PA_snp_4.15:11.4"], "en": "The mental construction of an object is the mire of sensual desire, so difficult to cross;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:12.1"], "en": "yet the sage has emerged from it by transcending all truths.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:12.2"], "en": "The brahmin stands firm on dry land;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:12.3"], "en": "having relinquished everything,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:12.4"], "en": "he is indeed called \"peaceful.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:13.1"], "en": "He is indeed wise, he is a master of knowledge;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:13.2"], "en": "having understood the Dhamma, he is independent.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:13.3"], "en": "Conducting himself rightly in the world, he...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:13.4", "PA_snp_4.15:14.1"], "en": "No one here envies anyone else who has transcended the desires of this world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:14.2"], "en": "that attachment so difficult to overcome.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:14.3"], "en": "He does not grieve, nor does he yearn;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:14.4"], "en": "his stream is cut, he is without bonds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:15.1"], "en": "Dry up that which was in the past.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:15.2"], "en": "Let there be nothing for you afterwards;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:15.3"], "en": "if you do not grasp at anything in between,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:15.4"], "en": "you will wander in peace.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:16.1", "PA_snp_4.15:16.2"], "en": "He for whom there is no sense of \"mine\" at all regarding name-and-form,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:16.3"], "en": "and who does not grieve over what is non-existent—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:16.4"], "en": "He indeed is not overcome in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:17.1", "PA_snp_4.15:17.2"], "en": "for whom there is no sense of \"this is mine,\" nor anything belonging to others.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:17.3", "PA_snp_4.15:17.4"], "en": "Not finding anything to call \"mine,\" he does not grieve, thinking, \"It is not mine.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:18.1"], "en": "Without harshness and without greed, he dwells.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:18.2"], "en": "Unshaken, equal toward all things—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:18.3"], "en": "this, I declare to be the benefit,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:18.4"], "en": "when asked, of one who is unshakable.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:19.1"], "en": "For one who is unagitated and discerning,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:19.2"], "en": "there is no further conceptualization;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:19.3"], "en": "he has desisted from all exertion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:19.4"], "en": "The sage sees security everywhere;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:20.1", "PA_snp_4.15:20.2"], "en": "he does not speak of equals, nor of inferiors, nor of superiors.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:20.3"], "en": "“Being holy and free from stinginess,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:20.4"], "en": "he neither exalts himself nor disparages others.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_snp_4.15:20.5"], "en": "Thus ends the fifteenth discourse, the Attadaṇḍa Sutta.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
