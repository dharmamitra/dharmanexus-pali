[
{"segs": ["PA_pv_41:0.1"], "en": "Petavatthu,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:0.2"], "en": "Mahāvagga 6.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:0.3"], "en": "The Story of the Young Boy’s Ghost (Kumārapetavatthu)", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:1.1"], "en": "“There was a city named Sāvatthī,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:1.2"], "en": "facing the Himalayas;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:1.3"], "en": "there lived two young princes.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:1.4"], "en": "\"O Prince, thus have I heard:", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:2.1"], "en": "those who are intoxicated by things that provoke passion,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:2.2"], "en": "and who delight in the gratification of sensual desires;\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:2.3"], "en": "Greedy for present pleasure,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:2.4"], "en": "they do not see what is to come;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:3.1"], "en": "having passed away from the human state, they fall into hell.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:3.2"], "en": "Having gone from here to the other world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:3.3"], "en": "they cry out there,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:3.4"], "en": "seeing [their own] past misdeeds.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:4.1", "PA_pv_41:4.2"], "en": "\"Alas, although many things worthy of being given were present before us,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:4.3"], "en": "we were unable to offer ourselves.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:4.4"], "en": "To perform a protective chant brings happiness.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:5.1"], "en": "What evil could there be in that,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:5.2"], "en": "since we have passed away from the royal family?", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:5.3"], "en": "Having been reborn in the realm of hungry ghosts,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:5.4"], "en": "they are afflicted by hunger and thirst;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:6.1"], "en": "having once been masters here, [they now suffer].", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:6.2"], "en": "There they are without mastery;", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:6.3"], "en": "driven by hunger and thirst,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:6.4"], "en": "humans wander about, rising and falling.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:7.1", "PA_pv_41:7.2"], "en": "Having understood this danger arising from the intoxication of lordship,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:7.3"], "en": "one should abandon the intoxication of lordship.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:7.4"], "en": "A person who has gone to heaven in this very life—", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:7.5"], "en": "when the body breaks up,", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:7.6"], "en": "that wise one is reborn in heaven.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"},
{"segs": ["PA_pv_41:8.1"], "en": "The Sixth Story of the Young Petas.", "model": "mitra-v4", "translated_at": "2026-11-27T12:58:15Z"}
]
