[
{"segs": ["PA_thag_4.1:0.1", "PA_thag_4.1:0.2", "PA_thag_4.1:0.3"], "en": "Theragāthā 4.1 Catukkanipāta Paṭhamavagga (First Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:0.4"], "en": "The Verses of the Elder Nāgasamāla:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:1.1"], "en": "“Adorned, well-dressed, wearing garlands,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:1.2"], "en": "and anointed with sandalwood paste;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:1.3"], "en": "In the middle of the great road,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:1.4"], "en": "a female dancer was dancing to the music;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:2.1"], "en": "I had entered for alms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:2.2"], "en": "As I was going along, I beheld him—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:2.3"], "en": "adorned and well-dressed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:2.4"], "en": "like the snare of Death laid out.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:3.1"], "en": "Then, through proper attention,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:3.2"], "en": "there arose in me a thorough comprehension;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:3.3"], "en": "the danger became manifest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:3.4"], "en": "Disenchantment took firm root.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:4.1"], "en": "Then my mind was liberated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:4.2"], "en": "behold the excellence of the Dharma!", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:4.3"], "en": "“The three knowledges have been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:4.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_4.1:4.5"], "en": "… Thus spoke the Elder Nāgasamāla.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
