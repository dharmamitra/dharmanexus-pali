[
{"segs": ["PA_tha-ap_525:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:0.2", "PA_tha-ap_525:0.3"], "en": "The Chapter on the Giver of Grass (Tiṇadāyakavagga), Number 3: The Apadāna of the Elder Saraṇagamaniya.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:1.1", "PA_tha-ap_525:1.2"], "en": "“Then we three— the bhikkhu, the Ājīvika, and I— embarked upon a boat.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:1.3"], "en": "As the boat was breaking apart,”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:1.4"], "en": "The bhikkhu gave me refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:2.1"], "en": "In the thirty-first aeon from now,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:2.2"], "en": "he gave me that refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:2.3"], "en": "I do not know a miserable rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:2.4"], "en": "this is the fruit of going for refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:3.1"], "en": "My defilements have been incinerated.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:3.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:3.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:4.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:4.2", "PA_tha-ap_525:4.3"], "en": "... [as before] ... the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:5.1"], "en": "The four analytical knowledges—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:5.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:5.3"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:6.1"], "en": "Thus indeed did the venerable elder Saraṇagamaniya speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_525:7.1"], "en": "The legend of the Elder Saraṇagamaniya, the third.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
