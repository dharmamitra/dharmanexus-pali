[
{"segs": ["PA_cp_15:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:0.2"], "en": "Hatthināgavagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:0.3"], "en": "Sīlapāramī 5", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:0.4", "PA_cp_15:1.1"], "en": "The Conduct of the King of Deer: \"Furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:1.2"], "en": "when I was a wild buffalo roaming the forest,\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:1.3"], "en": "With a burgeoning body, powerful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:1.4"], "en": "great, and of terrifying appearance,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:2.1"], "en": "[he dwelt] in mountain caves and in difficult mountain passes.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:2.2"], "en": "At the foot of a tree, by a water source—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:2.3", "PA_cp_15:2.4"], "en": "there were places there for buffaloes, here and there in various spots.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:3.1"], "en": "Wandering in the great forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:3.2"], "en": "he saw an auspicious spot;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:3.3"], "en": "having approached that place, he stood there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:3.4"], "en": "I stand and I lie down.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:4.1", "PA_cp_15:4.2"], "en": "Then a monkey, wicked, ignoble, and light-minded, came there.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:4.3"], "en": "On the shoulders, the forehead, and the eyebrows;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:4.4"], "en": "he sprinkles that [water) on the penis.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:5.1"], "en": "Once more during the day, a second time—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:5.2"], "en": "A third and even a fourth time;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:5.3"], "en": "he defiles me at all times,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:5.4"], "en": "and because of that, I am afflicted.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:6.1"], "en": "Seeing me distressed,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:6.2"], "en": "a yakkha said this to me:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:6.3"], "en": "“Destroy this wretched, evil corpse!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:6.4"], "en": "\"And with their horns and hooves.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:7.1", "PA_cp_15:7.2"], "en": "When this was said, I then spoke these words to that yakkha:", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:7.3", "PA_cp_15:7.4"], "en": "\"Why do you smear me with this foul, wicked, and ignoble corpse?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:8.1"], "en": "If I were to become angry at him here...\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:8.2"], "en": "Then I would become inferior;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:8.3"], "en": "my virtue would be broken,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:8.4"], "en": "and the wise would censure me.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:9.1"], "en": "Even if life is despised,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:9.2"], "en": "death is better for one who is pure; why should I,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:9.3"], "en": "even for the sake of life, [commit an evil deed]?", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:9.4"], "en": "\"I shall cause him harm.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:10.1"], "en": "Thinking thus of me alone,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:10.2"], "en": "he will act in this same way toward others as well.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:10.3"], "en": "They alone shall slay him;", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:10.4"], "en": "that will be my liberation.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:11.1"], "en": "Whether low, middling, or superior—", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:11.2"], "en": "Enduring an insult,", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:11.3", "PA_cp_15:11.4"], "en": "the wise person thus obtains exactly what they have desired in their mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"},
{"segs": ["PA_cp_15:12.1"], "en": "The fifth is the conduct of the King of Elephants.", "model": "mitra-v4", "translated_at": "2026-11-27T12:46:26Z"}
]
