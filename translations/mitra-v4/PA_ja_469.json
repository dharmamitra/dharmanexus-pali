[
{"segs": ["PA_ja_469:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:0.2"], "en": "The Twelfth Chapter,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:0.3"], "en": "The Minor Section on Kuṇāla.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:0.4"], "en": "6. The Mahākaṇha Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:1.1", "PA_ja_469:1.2"], "en": "“Kaṇha and Ghora, Sukkadāṭha and Pabhāsava;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:1.3"], "en": "“Bound by five ropes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:1.4"], "en": "why do you bark at me, dog?", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:2.1"], "en": "“This is not for the sake of deer,” [he replied].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:2.2"], "en": "It will become parched with heat;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:2.3"], "en": "when misfortune has come upon mankind,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:2.4"], "en": "then Kaṇha shall deliver them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:3.1"], "en": "“With bowls in hand,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:3.2"], "en": "shaven-headed, and clad in the saṅghāṭī robes,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:3.3"], "en": "these little ascetics will plow with plows.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:3.4"], "en": "Then Kaṇha will deliver them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:4.1"], "en": "These female ascetics who have gone forth,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:4.2"], "en": "shaven-headed and clad in saṅghāṭī robes;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:4.3"], "en": "When they go forth into the world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:4.4"], "en": "then Kaṇha will deliver them—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:5.1"], "en": "those with long hair and protruding lips, wearing matted locks.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:5.2"], "en": "With mud-stained teeth and veins showing from dust,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:5.3"], "en": "they go about burdened by debt;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:5.4"], "en": "at that time, Kaṇha will deliver them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:6.1", "PA_ja_469:6.2", "PA_ja_469:6.3"], "en": "The Brahmins, having learned the Veda by chance, will perform sacrifices according to the ritual manual of the Sāvitrī and the sacrificial thread for the sake of a wage.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:6.4", "PA_ja_469:7.1"], "en": "Then Kaṇha will deliver his mother and father,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:7.2"], "en": "who are aged and whose youth has passed.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:7.3"], "en": "When the powerful ones do not protect him,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:7.4"], "en": "then Kaṇha will deliver him—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:8.1"], "en": "even his mother and father.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:8.2", "PA_ja_469:8.3"], "en": "When you are worn out and your youth has passed, the fools will say, \"You are old\";", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:8.4"], "en": "at that time, Kaṇha will deliver you.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:9.1"], "en": "When the teacher’s wife, the female friend,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:9.2", "PA_ja_469:9.3"], "en": "the maternal uncle’s wife, and the paternal aunt go about in the world, [they will be honored].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:9.4"], "en": "Then Kaṇha will deliver him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:10.1"], "en": "Having taken up a sword and shield,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:10.2"], "en": "O brahmins, and having grasped a blade—", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:10.3"], "en": "When they shall commit highway robbery,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:10.4"], "en": "then Kaṇha will deliver them;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:11.1"], "en": "those of fair complexion who have been pierced by enmity.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:11.2"], "en": "Thūlabāhu will not appear;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:11.3"], "en": "they will cause a schism among friends,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:11.4"], "en": "but then Kaṇha will deliver them.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:12.1"], "en": "When there will be those who are deceitful,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:12.2", "PA_ja_469:12.3"], "en": "double-tongued, and thinkers like unworthy persons in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:12.4"], "en": "“Then Kaṇha will deliver us.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_469:13.1"], "en": "Thus ends the sixth Jātaka, the Mahākaṇha Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
