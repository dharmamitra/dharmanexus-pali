[
{"segs": ["PA_cp_13:0.1"], "en": "Cariyāpiṭaka,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:0.2"], "en": "Hatthināgavagga,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:0.3"], "en": "Sīlapāramī 3", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:0.4", "PA_cp_13:1.1"], "en": "The Conduct of the Naga Campeyya: “Furthermore,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:1.2"], "en": "when I was the powerful Naga Campeyya;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:1.3"], "en": "Even then I was righteous,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:1.4"], "en": "endowed with virtue and observances.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:2.1"], "en": "Even then, while I was practicing the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:2.2"], "en": "Having observed the Uposatha fast,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:2.3", "PA_cp_13:2.4"], "en": "a snake charmer took him and played with him at the king’s gate.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:3.1"], "en": "Whatever color he thought of—", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:3.2", "PA_cp_13:3.3"], "en": "blue, yellow, or red— the [light] followed his mind.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:3.4"], "en": "I become just as I have thought.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:4.1"], "en": "I could turn dry land into water,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:4.2"], "en": "and I could turn water into dry land.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:4.3"], "en": "If I were to become angry with him here,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:4.4"], "en": "I could reduce him to ashes in an instant. Yet,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:5.1"], "en": "if I am one who has mastery over my mind, [I shall remain patient].", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:5.2"], "en": "I shall fall away from virtue;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:5.3"], "en": "for one fallen from virtue,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:5.4"], "en": "the supreme goal is not accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:6.1"], "en": "Let this body break asunder,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:6.2"], "en": "let it fall apart right here;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:6.3"], "en": "yet I shall never violate my virtue.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:6.4"], "en": "They scatter soil everywhere.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_cp_13:7.1"], "en": "Thus ends the third chapter, the *Campeyyanāgacarita*.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
