[
{"segs": ["PA_ja_272:0.1"], "en": "Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_272:0.2", "PA_ja_272:0.3"], "en": "The Collection of Threes, Chapter on the Well (Udapānavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_272:0.4"], "en": "2. The Birth Story of the Tiger:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_272:1.1", "PA_ja_272:1.2"], "en": "“From association with that friend by whom security from bondage is lost;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_272:1.3"], "en": "A wise person should avoid that friend,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_272:1.4"], "en": "as one avoids a tree with a hollow trunk,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_272:2.1"], "en": "because of the association with such a friend.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_272:2.2"], "en": "The security of yoga increases;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_272:2.3", "PA_ja_272:2.4"], "en": "the wise person should conduct themselves with equanimity in all their affairs.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_272:3.1"], "en": "“Come, tigers, you must turn back;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_272:3.2"], "en": "enter the great forest.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_272:3.3"], "en": "Do not cut down the forest that has been cleared of tigers.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_272:3.4"], "en": "“Tigers among men, you have attained Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_272:4.1"], "en": "Thus ends the second Jātaka, the Byaggha-jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
