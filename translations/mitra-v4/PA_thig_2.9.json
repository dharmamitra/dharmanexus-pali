[
{"segs": ["PA_thig_2.9:0.1", "PA_thig_2.9:0.2", "PA_thig_2.9:0.3"], "en": "Therīgāthā 2.9 Dukanipāta The Verses of the Elder Nun Abhayā", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.9:1.1"], "en": "“The body is fragile in what is not secure,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.9:1.2"], "en": "wherein ordinary people are attached;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.9:1.3"], "en": "I shall cast off this physical frame.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.9:1.4"], "en": "Possessing clear comprehension and mindfulness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.9:2.1", "PA_thig_2.9:2.2"], "en": "through my delight in heedfulness, I have been freed from many states of suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.9:2.3"], "en": "“Destruction of craving has been attained;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.9:2.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thig_2.9:3.1"], "en": "… Thus spoke the elder nun Abhayā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
