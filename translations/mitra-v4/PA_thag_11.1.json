[
{"segs": ["PA_thag_11.1:0.1", "PA_thag_11.1:0.2", "PA_thag_11.1:0.3"], "en": "Theragāthā 11.1 Ekādasakanipāta Paṭhamavagga (The First Chapter of the Eleven)", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:0.4"], "en": "The Verses of the Elder Saṅkicca:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:1.1"], "en": "“What purpose do you have in the forest, dear one,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:1.2"], "en": "like a bamboo tree in the rainy season?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:1.3"], "en": "\"Verambhā is delightful to you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:1.4"], "en": "for it is indeed solitude for those who meditate.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:2.1"], "en": "\"Just as the Verambha wind [dispels] the clouds,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:2.2"], "en": "The wind blows with the rain;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:2.3"], "en": "perceptions overwhelm me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:2.4"], "en": "though they are associated with seclusion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:3.1"], "en": "Not white, born from an egg,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:3.2"], "en": "dwelling in the charnel ground as his home—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:3.3"], "en": "he indeed arouses mindfulness in me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:3.4"], "en": "In doubt, one relies on dispassion.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:4.1", "PA_thag_11.1:4.2"], "en": "That which others do not protect, and that which one does not protect others from;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:4.3"], "en": "Truly, that bhikkhu sleeps in happiness,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:4.4"], "en": "having no longing for sensual pleasures.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:5.1"], "en": "[He dwells] on a broad stone slab with clear water.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:5.2"], "en": "Abounding in oxen, elephants,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:5.3"], "en": "and deer, and covered with water-moss,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:5.4"], "en": "those mountains delight me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:6.1"], "en": "I am at ease in the forests,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:6.2"], "en": "in the ravines and caves,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:6.3"], "en": "and in remote lodgings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:6.4"], "en": "Inhabited by predatory beasts:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:7.1"], "en": "\"May these living beings be slain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:7.2"], "en": "may they be executed, may they encounter suffering!\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:7.3", "PA_thag_11.1:7.4"], "en": "I do not recognize any ignoble intention associated with hatred;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:8.1"], "en": "I have served the Teacher.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:8.2"], "en": "The teaching of the Buddha has been accomplished;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:8.3"], "en": "the heavy burden has been laid down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:8.4"], "en": "and the conduit to existence has been uprooted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:9.1", "PA_thag_11.1:9.2"], "en": "That goal for the sake of which I went forth from the home life into homelessness—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:9.3"], "en": "that purpose of mine has been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:9.4"], "en": "The destruction of all fetters.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:10.1"], "en": "I do not rejoice in death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:10.2"], "en": "nor do I rejoice in life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:10.3", "PA_thag_11.1:10.4"], "en": "I await my time like a servant longing for his wages;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:11.1"], "en": "I do not rejoice in death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:11.2"], "en": "I do not delight in life;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:11.3"], "en": "I await my time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:11.4"], "en": "fully aware and mindful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:11.5", "PA_thag_11.1:11.6"], "en": "… The Elder Saṅkicca … The Eleventh Chapter is finished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:12.0"], "en": "Herein is the summary verse:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:12.1"], "en": "The Elder Saṅkicca alone,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:12.2"], "en": "having accomplished his task and being free from taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:12.3"], "en": "[is praised] in the Eleventh Chapter.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_thag_11.1:12.4"], "en": "And there are exactly eleven verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
