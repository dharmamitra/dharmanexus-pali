[
{"segs": ["PA_tha-ap_339:0.1", "PA_tha-ap_339:0.2", "PA_tha-ap_339:0.3"], "en": "The Apadāna of the Elder Tiṇakuṭidāyaka, from the Gandhodakavagga of the Therāpadāna, Number Seven.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:1.1"], "en": "“In the city of Bandhumatī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:1.2"], "en": "I was a laborer for others;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:1.3"], "en": "I was engaged in the work of others.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:1.4"], "en": "Without looking back at my meal,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:2.1"], "en": "I went into seclusion and, having sat down,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:2.2"], "en": "I reflected thus at that time:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:2.3"], "en": "The Buddha has appeared in the world,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:2.4"], "en": "yet I have no further duty;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:3.1"], "en": "it is time for me to purify my destiny.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:3.2"], "en": "The opportunity has been granted to me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:3.3", "PA_tha-ap_339:3.4"], "en": "painful indeed is the touch of hell for those beings who have not performed meritorious deeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:4.1"], "en": "Having thought thus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:4.2", "PA_tha-ap_339:4.3"], "en": "I approached the master of the work; having requested the labor for myself alone, I went.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:4.4"], "en": "I entered the forest.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:5.1", "PA_tha-ap_339:5.2"], "en": "Having then gathered grass, wood, and creepers, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:5.3"], "en": "Having set down the three staffs,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:5.4"], "en": "I built a grass hut;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:6.1"], "en": "a small hut for the sake of the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:6.2"], "en": "Having entrusted him to her,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:6.3", "PA_tha-ap_339:6.4"], "en": "I returned that very day and approached the master of the work.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:7.1"], "en": "By that well-performed kamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:7.2"], "en": "I went to the realm of the Thirty-three;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:7.3"], "en": "there, a well-constructed mansion was mine.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:7.4", "PA_tha-ap_339:8.1"], "en": "Well-constructed within the hut was a banner made of green cloth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:8.2"], "en": "possessing a thousand fringes and a hundred tassels.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:8.3", "PA_tha-ap_339:8.4"], "en": "Hundreds of thousands of rays issued forth from my body;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:9.1"], "en": "whomever I was reborn among, [they appeared].", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:9.2"], "en": "Whether it be celestial or human,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:9.3", "PA_tha-ap_339:9.4"], "en": "the palace stands ready before me, having understood my intention.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:10.1"], "en": "Neither fear nor trepidation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:10.2"], "en": "nor even the bristling of my hair, exists;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:10.3"], "en": "I do not know any terror from them.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:10.4"], "en": "This is the fruit of the grass hut:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:11.1"], "en": "lions, tigers, leopards,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:11.2"], "en": "bears, hyenas, and jackals;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:11.3", "PA_tha-ap_339:11.4"], "en": "All avoid me; this is the fruit of this grass hut.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:12.1"], "en": "So too are the reptiles and the spirits.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:12.2"], "en": "The snakes, kumbhaṇḍas, and rakkhasas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:12.3"], "en": "they too avoid me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:12.4"], "en": "this is the fruit of this grass hut.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:13.1", "PA_tha-ap_339:13.2"], "en": "I do not recall seeing even a single bad dream;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:13.3"], "en": "mindfulness was established in me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:13.4"], "en": "This is the fruit of that very grass hut;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:14.1", "PA_tha-ap_339:14.2"], "en": "having experienced prosperity by means of that very grass hut.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:14.3"], "en": "Of the Blessed One Gotama,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:14.4", "PA_tha-ap_339:15.1"], "en": "I realized the Dhamma ninety-one aeons ago.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:15.2"], "en": "Whatever deed I performed then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:15.3"], "en": "I do not know any state of woe;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:15.4"], "en": "this is the fruit of that grass hut.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:16.1", "PA_tha-ap_339:16.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:16.3"], "en": "[and so forth] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:17.1"], "en": "Thus indeed the venerable elder Tiṇakuṭidāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"},
{"segs": ["PA_tha-ap_339:18.1"], "en": "This is the seventh legend of the elder Tiṇakuṭidāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:20Z"}
]
