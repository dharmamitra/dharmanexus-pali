[
{"segs": ["PA_ja_385:0.1"], "en": "The Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:0.2", "PA_ja_385:0.3"], "en": "The Sixth Book, the Chapter on the Unobstructed (Avāriyavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:0.4"], "en": "10. The Nandiya-miga-rāja Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:1.1", "PA_ja_385:1.2"], "en": "“If you go, brahmin, to Sāketa, to the Ajjuna forest;”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:1.3", "PA_ja_385:1.4"], "en": "\"You shall call him our own biological son, Nandiya by name;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:1.5"], "en": "both your mother and father are aged.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:1.6"], "en": "“They desire to see him.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:2.1", "PA_ja_385:2.2"], "en": "“I have eaten the king’s fodder and his food and drink.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:2.3", "PA_ja_385:2.4"], "en": "“I am not able, O Brahmin, to consume that royal alms-food.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:3.1"], "en": "“I shall open my eye; look!”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:3.2"], "en": "Of King Khurappāṇi;", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:3.3"], "en": "then, happy and released,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:3.4"], "en": "I might even see my mother.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:4.1", "PA_ja_385:4.2"], "en": "In former times, I was the king of deer in the dwelling place of Kosala,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:4.3"], "en": "known by the name Nandiya.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:4.4", "PA_ja_385:5.1"], "en": "A handsome four-footed beast came to kill me in the Ajjuṇa forest,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:5.2"], "en": "where I was seeking food.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:5.3", "PA_ja_385:5.4"], "en": "Having made my bow unbreakable and fixed an arrow upon it, O Kosala,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:6.1"], "en": "I placed my sight upon his target.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:6.2"], "en": "Of King Khurappāṇi; then,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:6.3"], "en": "happy and liberated,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:6.4"], "en": "I have come here to see my mother.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:7.1"], "en": "The Nandiyamigarājajātaka, the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:7.2"], "en": "The first chapter, the Avāriyavagga.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:8.1"], "en": "Its summary (uddāna):", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:9.1"], "en": "Then Kujjhara, Rathesabha, Ketuvara,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:9.2"], "en": "Sadārimukha, Neru, and Lata; again,", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:9.3"], "en": "Apananda, Sirī, and Sucittavara.", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"},
{"segs": ["PA_ja_385:9.4"], "en": "Then, Dhammika, by means of the Nandimiga [parable], ten [points were explained].", "model": "mitra-v4", "translated_at": "2026-11-27T12:51:25Z"}
]
