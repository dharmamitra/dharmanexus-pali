[
{"segs": ["PA_ja_264:0.1", "PA_ja_264:0.2", "PA_ja_264:0.3"], "en": "Jātaka Tikanipāta, Padumavagga (The Lotus Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_264:0.4"], "en": "4. The Mahāpanāda Jātaka:", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_264:1.1", "PA_ja_264:1.2"], "en": "“That king was named Panāda, whose sacrificial post was made of gold.”", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_264:1.3"], "en": "It is sixteen spans across,", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_264:1.4"], "en": "they say it is a thousandfold in height;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_264:2.1"], "en": "it has a thousand joints and a hundred knobs.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_264:2.2"], "en": "Dhajālu is filled with greenery;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_264:2.3", "PA_ja_264:2.4"], "en": "there, sixty thousand gandhabbas dance in seven groups.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_264:3.1", "PA_ja_264:3.2"], "en": "\"So it was then, Bhaddaji, just as you say;", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_264:3.3"], "en": "I myself was Sakka at that time.\"", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"},
{"segs": ["PA_ja_264:3.4", "PA_ja_264:4.1"], "en": "“I am your servant. Thus ends the fourth Jātaka, the Mahāpanāda Jātaka.", "model": "mitra-v4", "translated_at": "2026-11-27T12:48:33Z"}
]
