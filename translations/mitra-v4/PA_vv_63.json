[
{"segs": ["PA_vv_63:0.1", "PA_vv_63:0.2"], "en": "Vimānavatthu: The Mansion of the Man,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:0.3"], "en": "Chapter on the Great Chariot (Mahārathavagga)", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:0.4", "PA_vv_63:1.1"], "en": "13. The Story of the Lesser Chariot Mansion “Firm in your resolve,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:1.2"], "en": "you stand leaning upon a bow made of reed.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:1.3"], "en": "“Are you a khattiya, a lord of kings,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:1.4"], "en": "or perhaps a hunter wandering the forest?", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:2.1"], "en": "“I am the sovereign of the Assakas,” he replied.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:2.2"], "en": "\"Venerable sir, my son is a forest-dweller;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:2.3", "PA_vv_63:2.4"], "en": "I tell you, Bhikkhu, my name is Sujāta— so am I known.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:3.1"], "en": "Searching for a deer,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:3.2"], "en": "I plunged into the great forest;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:3.3"], "en": "yet I did not see that very deer.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:3.4"], "en": "\"And having seen him, I stood there.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:4.1"], "en": "\"Welcome to you, O one of great merit;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:4.2"], "en": "indeed, you have come from afar.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:4.3", "PA_vv_63:4.4"], "en": "Taking water from here, wash your feet.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:5.1"], "en": "This water is also cool for drinking.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:5.2"], "en": "“Brought from the interior of the mountain;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:5.3"], "en": "having drunk that, O prince,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:5.4"], "en": "you sat down upon the prepared seat.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:6.1"], "en": "“Truly auspicious is your speech,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:6.2"], "en": "O Great Sage, worthy of being heard;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:6.3"], "en": "it is faultless, meaningful, and beautiful.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:6.4"], "en": "Having understood the matter, you speak.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:7.1", "PA_vv_63:7.2"], "en": "O bull among seer-women, tell me when asked: what is your delight in dwelling in the forest?", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:7.3"], "en": "\"Having listened to the path of your words,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:7.4"], "en": "may we practice the state of things and the Dharma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:8.1"], "en": "\"Non-violence toward all living beings...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:8.2"], "en": "\"O Prince, this is pleasing to us:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:8.3"], "en": "abstention from theft, from sexual misconduct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:8.4"], "en": "and from the drinking of intoxicants.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:9.1"], "en": "Freedom from attachment, even conduct,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:9.2", "PA_vv_63:9.3"], "en": "great learning, and gratitude are praised in this very life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:9.4"], "en": "\"These qualities are to be praised.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:10.1", "PA_vv_63:10.2"], "en": "Death will come upon you within five months.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:10.3"], "en": "“Prince, understand this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:10.4"], "en": "liberate yourself.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:11.1"], "en": "“Which country, then, shall I go to?”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:11.2"], "en": "What deed, what human effort,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:11.3", "PA_vv_63:11.4"], "en": "or by what knowledge might one become free from aging and death?", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:12.1"], "en": "“There is no place found,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:12.2"], "en": "whether by action or by human knowledge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:12.3"], "en": "where a mortal, having gone there, would not come back to existence.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:12.4"], "en": "Princes who are free from old age and death,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:13.1"], "en": "possessing great wealth and vast enjoyments,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:13.2"], "en": "and even Kṣatriyas who rule over kingdoms.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:13.3"], "en": "Though they possessed abundant wealth and grain,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:13.4"], "en": "even they were not free from old age and death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:14.1"], "en": "If you have heard of them— the sons of Andhaka and Veṇhu— then [know this].", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:14.2"], "en": "The brave, the heroic, those who strike with prowess—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:14.3"], "en": "even they, when their lifespan has reached its end,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:14.4"], "en": "are scattered like the eternalist views.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:15.1"], "en": "Khattiyas, brahmins, vessas, suddas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:15.2"], "en": "candālas, and pukkusas—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:15.3"], "en": "these and others by birth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:15.4"], "en": "Even they are not free from aging and death—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:16.1", "PA_vv_63:16.2"], "en": "those who merely recite the sixfold mantra contemplated by Brahmā.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:16.3"], "en": "These and others through their knowledge—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:16.4"], "en": "though they too are not free from old age and death—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:17.1"], "en": "as well as those sages who are peaceful.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:17.2"], "en": "Because of their self-restraint,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:17.3", "PA_vv_63:17.4"], "en": "those ascetics, at the proper time, cast off even their bodies.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:18.1"], "en": "The Arahants, whose minds are cultivated,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:18.2", "PA_vv_63:18.3"], "en": "who have done what was to be done and are free from taints, cast off this body.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:18.4"], "en": "“Through the complete exhaustion of merit and demerit.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:19.1", "PA_vv_63:19.2"], "en": "“Well-spoken and meaningful are these verses of yours, O Great Sage!”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:19.3"], "en": "“I am inwardly composed in the sense of being well-established;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:19.4"], "en": "you, however, become my refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:20.1"], "en": "“Do not go to me for refuge.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:20.2"], "en": "Go for refuge to that very one,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:20.3"], "en": "the Son of the Sakyas, the Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:20.4"], "en": "whom I have gone to for refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:21.1"], "en": "“In which country,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:21.2"], "en": "dear sir, does your teacher dwell?", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:21.3"], "en": "I too shall go to see him.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:21.4"], "en": "“The Victor, the peerless one.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:22.1"], "en": "“In the eastern country,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:22.2"], "en": "born of the Okkāka clan;”", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:22.3"], "en": "\"There stood that noble steed among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:22.4"], "en": "and he has indeed attained final Nibbāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:23.1"], "en": "\"If indeed the Buddha were still present...\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:23.2"], "en": "The Teacher is yours, dear sir;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:23.3", "PA_vv_63:23.4"], "en": "I would travel thousands of yojanas to wait upon him.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:24.1", "PA_vv_63:24.2"], "en": "But since the Teacher has attained final nibbāna, O venerable sir,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:24.3"], "en": "even though the Great Hero has passed into nibbāna—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:24.4"], "en": "I go for refuge;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:25.1"], "en": "I approach the Buddha for refuge,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:25.2"], "en": "and also the unsurpassed Dhamma.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:25.3"], "en": "And the Saṅgha of the god among men,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:25.4"], "en": "I go for refuge.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:26.1"], "en": "I shall quickly abstain from taking life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:26.2"], "en": "In this world, I avoid what is not given;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:26.3"], "en": "I do not drink intoxicants, nor do I speak falsehoods,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:26.4"], "en": "and I am content with my own wife.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:27.1"], "en": "\"Just as the one with a thousand rays is of great splendor,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:27.2"], "en": "and just as he shines through the directions in the sky in succession,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:27.3"], "en": "so too is this great chariot-warrior your benefactor.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:27.4"], "en": "Extending for seven yojanas on all sides,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:28.1", "PA_vv_63:28.2"], "en": "it was draped all over with golden bands and adorned upon its breast with pearls and variegated gems.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:28.3"], "en": "The records of gold and silver shine,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:28.4"], "en": "beautifully fashioned from beryl;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:29.1"], "en": "even this head is fashioned from beryl.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:29.2"], "en": "This yoke is adorned with red figures;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:29.3"], "en": "it is harnessed with gold and silver,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:29.4"], "en": "and these horses, swift as thought, shine forth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:30.1"], "en": "Thus you stand, established upon your golden chariot,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:30.2"], "en": "like the Lord of the Devas with his thousand steeds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:30.3"], "en": "I ask this of you, O illustrious one, who are skilled in wisdom.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:30.4"], "en": "\"How was this sublime [attainment] obtained by you?", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:31.1", "PA_vv_63:31.2"], "en": "\"Venerable sir, formerly I was a prince named Sujāta.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:31.3"], "en": "And you, out of compassion for me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:31.4"], "en": "established me in self-restraint;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:32.1"], "en": "knowing that my life-span was exhausted, [you acted].", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:32.2"], "en": "\"I have given the Teacher's body;", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:32.3"], "en": "worship this, Sujāta,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:32.4"], "en": "and it will be for your benefit.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:33.1", "PA_vv_63:33.2"], "en": "Having diligently honored him with perfumes and garlands,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:33.3"], "en": "and having cast off this human body, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:33.4"], "en": "I have been reborn in the Nandana grove,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:34.1"], "en": "in the delightful Nandana forest,", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:34.2"], "en": "which is filled with various flocks of birds.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:34.3", "PA_vv_63:34.4"], "en": "“I delight in dance and song, honored by the celestial nymphs.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"},
{"segs": ["PA_vv_63:35.1"], "en": "The Thirteenth: The Cūḷaratha-vimāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:29:40Z"}
]
