[
{"segs": ["PA_thig_6.6:0.1", "PA_thig_6.6:0.2"], "en": "Therīgāthā 6.6 Chakkanipāta:", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:0.3"], "en": "The Verses of the Elder Nun Mahāpajāpatī Gotamī", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:1.1"], "en": "“O Buddha, Hero, let there be homage to you,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:1.2"], "en": "the supreme among all beings;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:1.3"], "en": "you who have liberated me from suffering.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:1.4"], "en": "And many other people as well.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:2.1"], "en": "All suffering has been fully understood,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:2.2"], "en": "and craving, its cause, has been dried up.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:2.3"], "en": "The Eightfold Path has been cultivated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:2.4"], "en": "cessation has been realized by me.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:3.1"], "en": "Mother, son, father, brother—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:3.2"], "en": "And formerly I was my mother-in-law;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:3.3"], "en": "not knowing things as they truly are,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:3.4"], "en": "I wandered through saṃsāra without finding satisfaction.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:4.1"], "en": "For I have seen that Blessed One;", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:4.2"], "en": "this is my final physical frame.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:4.3"], "en": "The wandering through births is exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:4.4", "PA_thig_6.6:5.1"], "en": "Now there is no further becoming for one who has aroused energy, who is resolute,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:5.2"], "en": "and who is constantly firm in effort.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:5.3"], "en": "To behold disciples in harmony—", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:5.4"], "en": "this is the homage of the Buddhas.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:6.1"], "en": "Truly, it is for the benefit of many.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:6.2"], "en": "Māyā gave birth to Gotama,", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:6.3", "PA_thig_6.6:6.4"], "en": "who dispelled the mass of suffering for those tormented by disease and death.", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"},
{"segs": ["PA_thig_6.6:7.1"], "en": "… the Elder Nun Mahāpajāpatigotamī …", "model": "mitra-v4", "translated_at": "2026-11-27T13:11:53Z"}
]
