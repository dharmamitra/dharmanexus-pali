[
{"segs": ["PA_tha-ap_544:0.1"], "en": "The Therāpadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:0.2"], "en": "Bhaddiya-vagga 2.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:0.3"], "en": "The Apadāna of the Elder Kaṅkhārevata", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:1.1"], "en": "“The Victor named Padumuttara,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:1.2"], "en": "the eye of all phenomena,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:1.3"], "en": "[lived] one hundred thousand aeons ago from here.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:1.4"], "en": "In that eon, the Leader appeared:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:2.1"], "en": "Sīhahanu, with the voice of Brahmā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:2.2"], "en": "whose sound was like the cry of swans and the beat of drums.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:2.3"], "en": "Moving with the stride of a nāga,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:2.4"], "en": "radiant as the moon, the sun, and other celestial bodies,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:3.1"], "en": "the Great-Witted One, the Great Hero.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:3.2"], "en": "A great meditator, possessed of great power;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:3.3"], "en": "the Lord of Great Compassion,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:3.4"], "en": "who dispels the great darkness.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:4.1"], "en": "On one occasion, the Fully Enlightened One,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:4.2", "PA_tha-ap_544:4.3"], "en": "the Chief of the Three Worlds, taught the Dhamma to many who were ready to be trained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:4.4"], "en": "The Sage, who understands the hundredfold states of being—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:5.1", "PA_tha-ap_544:5.2"], "en": "tranquil, untroubled, a hero delighting in meditation— was absorbed in jhāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:5.3"], "en": "Praising the assembly,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:5.4"], "en": "the Victor gladdened the people.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:6.1"], "en": "At that time, in Haṃsavatī, I—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:6.2"], "en": "A brahmin who had mastered the Vedas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:6.3"], "en": "having heard the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:6.4"], "en": "was delighted and aspired to that state.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:7.1"], "en": "Then the Conqueror,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:7.2"], "en": "the Guide, in the midst of the Saṅgha,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:7.3"], "en": "prophesied: \"Be joyful, O Brahmā!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:7.4"], "en": "You shall attain that heart’s desire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:8.1"], "en": "In a hundred thousand kalpas,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:8.2"], "en": "born into the lineage of Okkāka;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:8.3", "PA_tha-ap_544:8.4"], "en": "One named Gotama by clan will become a teacher in the world;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:9.1"], "en": "he will be an heir to his teachings.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:9.2"], "en": "“Born from the heart, fashioned by the Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:9.3", "PA_tha-ap_544:9.4"], "en": "he shall be a disciple of the Teacher named Revata.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:10.1", "PA_tha-ap_544:10.2"], "en": "By that well-performed kamma and by my intentions and aspirations,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:10.3"], "en": "having abandoned this human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:10.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:11.1"], "en": "And now, in my final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:11.2"], "en": "I was born in the city of the Koliyans.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:11.3"], "en": "When there was one born into a noble Kṣatriya family,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:11.4", "PA_tha-ap_544:12.1"], "en": "prosperous, flourishing, and possessing great wealth, in Kapilavatthu—", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:12.2"], "en": "The Buddha taught the Dhamma; then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:12.3"], "en": "having gained confidence in the Sugata,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:12.4"], "en": "I went forth into the homeless life.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:13.1", "PA_tha-ap_544:13.2"], "en": "I had many doubts here and there regarding what is and is not an eon;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:13.3"], "en": "the Buddha has dispelled them all.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:13.4"], "en": "Having taught the supreme Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:14.1"], "en": "I then crossed over the cycle of existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:14.2"], "en": "always delighting in the bliss of jhāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:14.3"], "en": "Then, as the Buddha was dwelling there,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:14.4"], "en": "seeing me, he said this:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:15.1"], "en": "\"Whatever doubt there may be here or in the world beyond,\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:15.2"], "en": "Whether experienced by oneself or experienced by another,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:15.3", "PA_tha-ap_544:15.4"], "en": "those who meditate, ardent and leading the holy life, abandon them all.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:16.1", "PA_tha-ap_544:16.2"], "en": "The karma performed a hundred thousand eons ago has shown its fruit here to me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:16.3"], "en": "completely liberated like the speed of an arrow, I have reached the end of suffering.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:16.4"], "en": "I burned away my defilements. Then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:17.1"], "en": "seeing me devoted to meditation,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:17.2"], "en": "the Buddha, the Sage who has reached the end of the world, [spoke].", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:17.3"], "en": "Foremost among meditating bhikkhus,", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:17.4"], "en": "the Greatly Wise One makes it known:", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:18.1"], "en": "\"The defilements have been burnt away by me.\"", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:18.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:18.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:19.1"], "en": "Welcome indeed has come to me!", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:19.2", "PA_tha-ap_544:19.3"], "en": "... [and so on] ... the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:20.1"], "en": "The four analytical knowledges (paṭisambhidā) have been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:20.2"], "en": "\"...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:20.3"], "en": "the Buddha's teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:21.1"], "en": "Thus indeed did the elder venerable Kaṅkhārevata speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"},
{"segs": ["PA_tha-ap_544:22.1"], "en": "The legend of the Elder Kaṅkhārevata is the second.", "model": "mitra-v4", "translated_at": "2026-11-27T13:24:12Z"}
]
