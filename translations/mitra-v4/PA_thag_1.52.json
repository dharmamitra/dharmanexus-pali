[
{"segs": ["PA_thag_1.52:0.1", "PA_thag_1.52:0.2", "PA_thag_1.52:0.3"], "en": "Theragāthā 1.52 Ekakanipāta Chaṭṭhavagga (The Sixth Chapter)", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.52:0.4"], "en": "The Verses of the Elder Subāhu:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.52:1.1"], "en": "“The rain-god falls as if to a well-sung song;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.52:1.2"], "en": "my little hut is thatched, pleasant, and sheltered from the wind.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.52:1.3"], "en": "“With my mind well-composed within the body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.52:1.4"], "en": "yet if you still desire it, O Deva, then rain down.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thag_1.52:1.5"], "en": "… [Thus spoke] the Elder Subāhu.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
