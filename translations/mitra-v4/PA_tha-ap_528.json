[
{"segs": ["PA_tha-ap_528:0.1"], "en": "The Therāpadāna:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:0.2"], "en": "Tiṇadāyakavagga 6.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:0.3"], "en": "The Apadāna of the Elder Daṇḍadāyaka", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:1.1", "PA_tha-ap_528:1.2"], "en": "“Having entered the forest grove and cut down a bamboo pole at that time,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:1.3"], "en": "I made it my support.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:1.4"], "en": "I gave much to the Saṅgha.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:2.1"], "en": "With that serene state of mind,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:2.2"], "en": "having paid homage to the virtuous ones;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:2.3"], "en": "Having given him a staff for support,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:2.4"], "en": "I departed facing north.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:3.1"], "en": "Ninety-four aeons ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:3.2"], "en": "Since I did not give that stick back then,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:3.3"], "en": "I have never known an evil rebirth;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:3.4"], "en": "this is the fruit of giving up the stick.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:4.1"], "en": "The defilements have been burnt away by me;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:4.2"], "en": "...pe...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:4.3"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:5.1"], "en": "Welcome indeed has come to me...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:5.2", "PA_tha-ap_528:5.3"], "en": "[and so on] ...the teaching of the Buddha has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:6.1", "PA_tha-ap_528:6.2"], "en": "The four analytical knowledges...", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:6.3"], "en": "[and so on] ...the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:7.1"], "en": "Thus indeed the venerable elder Daṇḍadāyaka spoke these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:8.1"], "en": "This is the sixth legend of the elder Daṇḍadāyaka.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_tha-ap_528:8.2"], "en": "The twenty-third section for recitation.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
