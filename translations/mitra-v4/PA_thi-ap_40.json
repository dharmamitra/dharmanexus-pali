[
{"segs": ["PA_thi-ap_40:0.1"], "en": "Therī-apadāna,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:0.2"], "en": "Khattiyā-vagga 10:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:0.3"], "en": "The Apadāna of the Elder Nun Pesalā", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:1.1"], "en": "“In this auspicious aeon,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:1.2"], "en": "there was one of great renown, a kinsman of Brahmā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:1.3"], "en": "Kassapa by clan.”", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:1.4"], "en": "The best among those who debate was born.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:2.1"], "en": "In the excellent city of Sāvatthī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:2.2"], "en": "I was born into a family of lay devotees.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:2.3", "PA_thi-ap_40:2.4"], "en": "Having seen that Best of Conquerors and heard his teaching,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:3.1"], "en": "and having gone for refuge to that Hero, I gave birth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:3.2"], "en": "And I undertook the precepts;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:3.3"], "en": "once, that Great Hero,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:3.4"], "en": "in the assembly of a great multitude.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:4.1", "PA_thi-ap_40:4.2", "PA_thi-ap_40:4.3"], "en": "The Bull among Men proclaimed his own perfect enlightenment regarding those teachings never heard before.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:4.4"], "en": "And previously, regarding suffering and the other [truths],", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:5.1"], "en": "there was for me vision, knowledge, and wisdom,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:5.2"], "en": "as well as the light of true insight.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:5.3"], "en": "Having heard that and mastered it,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:5.4"], "en": "the bhikkhus questioned him further.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:6.1"], "en": "By virtue of that well-performed deed,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:6.2"], "en": "And through my volition and aspiration,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:6.3"], "en": "having abandoned the human body,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:6.4"], "en": "I went to the realm of the Thirty-three.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:7.1"], "en": "Now, in this final existence,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:7.2"], "en": "born into a distinguished and great family,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:7.3"], "en": "having approached the Buddha and the true Dhamma,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:7.4"], "en": "Having heard that which is connected with truth,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:8.1"], "en": "and having gone forth not long ago,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:8.2"], "en": "one should contemplate the meanings of truth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:8.3"], "en": "Having abandoned all taints,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:8.4"], "en": "I attained arahantship;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:9.1"], "en": "I have mastery over the supernormal powers.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:9.2", "PA_thi-ap_40:9.3"], "en": "With the divine ear-element and the knowledge of penetrating the minds of others,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:9.4"], "en": "I have attained mastery, O Great Sage.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:10.1"], "en": "I know my former births,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:10.2"], "en": "my divine eye is purified,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:10.3"], "en": "and all taints are utterly exhausted.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:10.4"], "en": "Now there is no further becoming.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:11.1"], "en": "Regarding the meanings, the phenomena, the linguistic expressions,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:11.2"], "en": "and likewise regarding inspired eloquence;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:11.3", "PA_thi-ap_40:11.4"], "en": "Through the power of the Best of Buddhas, my knowledge is stainless and pure;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:12.1"], "en": "my defilements have been consumed by fire.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:12.2"], "en": "All states of existence have been utterly eradicated;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:12.3"], "en": "like a serpent that has severed its bonds,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:12.4"], "en": "I dwell free from taints.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:13.1"], "en": "Welcome indeed has come to me,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:13.2"], "en": "being in the presence of the Buddha;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:13.3"], "en": "the threefold knowledge has been attained.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:13.4"], "en": "This is the teaching of the Buddha:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:14.1", "PA_thi-ap_40:14.2"], "en": "the four analytical knowledges and these eight liberations.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:14.3"], "en": "\"The six direct knowledges have been realized;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:14.4"], "en": "the Buddha’s teaching has been accomplished.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:15.1"], "en": "Thus indeed did the virtuous bhikkhunī speak these verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:16.1"], "en": "The legend of Pesalā Therī is the tenth.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:16.2"], "en": "The fourth chapter, the Chapter on the Khattiyās.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:17.1"], "en": "Its summary (uddāna) is as follows:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:18.1"], "en": "The Kṣatriyā and the Brāhmaṇī,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:18.2"], "en": "likewise Uppaladāyikā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:18.3"], "en": "Siṅgālamātā and Sukkā—", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:18.4"], "en": "Abhirūpā, Aḍḍhakāsikā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:19.1", "PA_thi-ap_40:19.2"], "en": "Puṇṇā, Ambapālī, and Pesalā— these ten.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:19.3", "PA_thi-ap_40:19.4"], "en": "There are two hundred and forty-two verses here.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:20.1"], "en": "Now, the summary of the chapters:", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:21.1"], "en": "Sumedhā, Ekūposathā,", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:21.2"], "en": "Kuṇḍalakesī, and the Kṣatriyā;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:21.3"], "en": "one thousand three hundred verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:21.4"], "en": "Forty-seven [chapters] in total;", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:22.1", "PA_thi-ap_40:22.2"], "en": "when counted together with the summary verses by those who possess clear discernment.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:22.3", "PA_thi-ap_40:22.4"], "en": "One thousand three hundred and fifty-five verses.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:23.1"], "en": "Thus concludes the Therikāpadāna.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"},
{"segs": ["PA_thi-ap_40:24.1"], "en": "The Apadāna-pāḷi is completed.", "model": "mitra-v4", "translated_at": "2026-11-27T13:03:48Z"}
]
